      "typeVersion": 3.4
    },
    {
      "id": "wa11a901-0000-4000-8000-000000000012",
      "name": "Find new Wallapop listings",
      "type": "@apify/n8n-nodes-apify.apify",
      "position": [
        460,
        120
      ],
      "parameters": {
        "actorId": {
          "__rl": true,
          "mode": "id",
          "value": "zxeaZX6wkeQ2UPiYp"
        },
        "operation": "Run actor and get dataset",
        "customBody": "={{ (() => {\n  const s = $json;\n  const parts = [['keywords', s.searchKeywords], ['order_by', 'newest'], ['time_filter', 'today']];\n  if (s.minPrice) parts.push(['min_sale_price', s.minPrice]);\n  if (s.maxPrice) parts.push(['max_sale_price', s.maxPrice]);\n  const query = parts.map(p => p[0] + '=' + encodeURIComponent(String(p[1]))).join('&');\n  const built = 'https://' + String(s.countryCode || 'es').trim() + '.wallapop.com/search?' + query;\n  return JSON.stringify({\n    start_urls: [{ url: String(s.searchUrl || '').trim() || built }],\n    max_items: s.maxItems,\n    country: s.country\n  });\n})() }}",
        "actorSource": "store"
      },
      "typeVersion": 1
    },
    {
      "id": "wa11a901-0000-4000-8000-000000000013",
      "name": "Skip items already sent",
      "type": "n8n-nodes-base.removeDuplicates",
      "position": [
        720,
        120
      ],
      "parameters": {
        "options": {},
        "operation": "removeItemsSeenInPreviousExecutions",
        "dedupeValue": "={{ $json.listing_url }}"
      },
      "typeVersion": 2
    },
