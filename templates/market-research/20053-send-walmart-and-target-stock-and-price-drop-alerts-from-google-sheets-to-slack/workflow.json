    {
      "id": "99b0e6cf-6d67-493d-8bfc-9b00b4313372",
      "name": "Check Stock and Price",
      "type": "n8n-nodes-base.code",
      "position": [
        1600,
        608
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const json = $json;\nconst original = $('Read Watchlist').item.json;\nconst isWalmart = json.provider === 'walmart';\nconst title = isWalmart ? json.title : (json.product ? json.product.title : null);\nconst url = isWalmart ? json.url : (json.product ? json.product.url : null);\nconst inStock = isWalmart\n  ? Boolean(json.availability && json.availability.in_stock)\n  : Boolean(json.product && json.product.in_stock);\nconst price = isWalmart\n  ? (json.price ? json.price.current : null)\n  : (json.product && json.product.price ? json.product.price.current : null);\nconst previousInStock = String(original.last_in_stock).toLowerCase() === 'true';\nconst previousPrice = original.last_price !== undefined && original.last_price !== '' ? Number(original.last_price) : null;\nreturn {\n  json: {\n    retailer: original.retailer,\n    product_id: original.product_id,\n    title: title || original.title,\n    url,\n    price,\n    in_stock: inStock,\n    back_in_stock: inStock === true && !previousInStock,\n    price_dropped: price !== null && previousPrice !== null && price < previousPrice,\n    previous_price: previousPrice,\n    checked_at: new Date().toISOString(),\n  },\n};"
      },
      "typeVersion": 2
    },
