    {
      "id": "a4983b66-5d5c-4638-9498-9d15e06f630c",
      "name": "Measure Video File",
      "type": "n8n-nodes-base.code",
      "position": [
        1440,
        -160
      ],
      "parameters": {
        "jsCode": "// Shopify needs the exact byte size of a VIDEO before it issues a staged upload target.\nconst out = [];\nfor (let i = 0; i < $input.all().length; i++) {\n  const buf = await this.helpers.getBinaryDataBuffer(i, 'data');\n  const product = $('Extract Product Data').item.json;\n  out.push({ json: {\n    video_url: $('Check Video Status').item.json.video_url,\n    file_size: String(buf.length),\n    filename: (product.title || 'product').replace(/[^a-z0-9]+/gi, '-').toLowerCase() + '-sisif.mp4',\n  } });\n}\nreturn out;"
      },
      "typeVersion": 2
    },
