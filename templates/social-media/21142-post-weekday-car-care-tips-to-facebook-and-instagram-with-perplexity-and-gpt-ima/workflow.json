              "id": "83bcf23a-4f5e-44d7-a36f-6466f9aa70bf",
              "name": "plan",
              "type": "object",
              "value": "={{ (() => { const t = String($json.output_text || ''); const m = t.match(/\\{[\\s\\S]*\\}/); try { const r = JSON.parse(m ? m[0] : t); return r && typeof r === 'object' ? r : {}; } catch (e) { return {}; } })() }}"
            },
            {
              "id": "857d49b1-60aa-43f3-a412-a2b4a44418c1",
              "name": "sources",
              "type": "string",
              "value": "={{ ($json.citations || []).slice(0, 3).map(c => c.url).join(' ') }}"
            },
            {
              "id": "a2a6e86d-ee61-4202-a5ea-3c7f09501e18",
              "name": "date",
              "type": "string",
              "value": "={{ $now.toFormat('yyyy-MM-dd') }}"
