    {
      "id": "fa86e681-cde5-41e1-81e8-f3061c2d5d35",
      "name": "Prepare ARC Decision",
      "type": "n8n-nodes-base.code",
      "position": [
        272,
        688
      ],
      "parameters": {
        "jsCode": "const body = ($input.first().json.body) || {};\nconst arc_id = String(body.arc_id || '').trim().toUpperCase();\nlet decision = String(body.decision || '').trim().toLowerCase();\nconst VALID = ['approved', 'conditions', 'denied'];\nif (VALID.indexOf(decision) < 0) decision = '';\nconst conditions_note = String(body.conditions_note || '').trim();\nconst decision_date = $now.toFormat('yyyy-MM-dd');\nreturn [{ json: { arc_id: arc_id, decision: decision, conditions_note: conditions_note, decision_date: decision_date } }];"
      },
      "typeVersion": 2
    },
