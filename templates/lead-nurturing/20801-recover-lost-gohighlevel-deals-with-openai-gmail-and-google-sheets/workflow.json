    {
      "id": "a9b8c7d6-1111-4e2f-9a3b-4c5d6e7f8a9b",
      "name": "Lost in Last 24h",
      "type": "n8n-nodes-base.filter",
      "position": [
        -1248,
        288
      ],
      "parameters": {
        "options": {},
        "conditions": {
          "options": {
            "version": 2,
            "leftValue": "",
            "caseSensitive": true,
            "typeValidation": "loose"
          },
          "combinator": "and",
          "conditions": [
            {
              "id": "7c1e2f0a-3b4d-4e5f-8a9b-0c1d2e3f4a5b",
              "operator": {
                "type": "dateTime",
                "operation": "after"
              },
              "leftValue": "={{ $json.lastStatusChangeAt }}",
              "rightValue": "={{ $now.minus({ hours: 24 }).toISO() }}"
            }
          ]
        },
        "looseTypeValidation": true
      },
      "typeVersion": 2.2
    },
    {
      "id": "85f2d0c7-8de0-4985-9cc9-8d6ca0c91065",
      "name": "Signal 1 - Timing",
      "type": "n8n-nodes-base.code",
      "position": [
        -1024,
        96
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const deal = $json;\nconst created = new Date(deal.createdAt);\nconst lastChange = new Date(deal.lastStatusChangeAt || deal.updatedAt);\nconst ageInDays = Math.floor((lastChange - created) / (1000 * 60 * 60 * 24));\n\nlet timingSignal = 'UNKNOWN';\nif (!isNaN(ageInDays)) {\n  if (ageInDays === 0) timingSignal = 'DIED_SAME_DAY';\n  else if (ageInDays <= 2) timingSignal = 'DIED_FAST';\n  else if (ageInDays >= 30) timingSignal = 'DIED_SLOW';\n  else timingSignal = 'NORMAL_CYCLE';\n}\n\nconst contact = deal.contact || {};\nconst fullName = contact.name || '';\n\nreturn {\n  json: {\n    dealId: deal.id,\n    dealName: deal.name || '',\n    contactId: contact.id || deal.contactId || '',\n    contactName: fullName,\n    contactFirstName: fullName.split(' ')[0] || 'there',\n    contactEmail: contact.email || '',\n    ageInDays: isNaN(ageInDays) ? null : ageInDays,\n    timingSignal\n  }\n};"
      },
      "typeVersion": 2
    },
    {
      "id": "6db28b09-64e6-4bae-b3e1-5b196a9fa813",
      "name": "Signal 2 - Engagement",
      "type": "n8n-nodes-base.code",
      "position": [
        -1024,
        288
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const tags = ($json.contact?.tags || []).map(t => String(t).toLowerCase());\n\n// Change these to match the tags your account uses\nconst stillEngaged = tags.includes('email-opened-recently') || tags.includes('site-visit-recent');\nconst optedOut = tags.includes('unsubscribed') || tags.includes('do-not-contact');\n\nlet engagementSignal = 'NO_SIGNAL';\nif (optedOut) engagementSignal = 'OPTED_OUT';\nelse if (stillEngaged) engagementSignal = 'STILL_WARM';\n\nreturn { json: { engagementSignal } };"
      },
      "typeVersion": 2
    },
    {
      "id": "ec89cecf-ba86-498e-96ab-c57f505d2003",
      "name": "Signal 3 - Objection",
      "type": "n8n-nodes-base.code",
      "position": [
        -1024,
        480
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const lostReasonId = $json.lostReasonId || null;\nconst objectionSignal = lostReasonId ? 'REASON_LOGGED' : 'NO_REASON_LOGGED';\n\nreturn { json: { objectionSignal, lostReasonId } };"
      },
      "typeVersion": 2
    },
    {
      "id": "5464aaa5-8c5f-4414-b97a-fe2b969db695",
      "name": "Combine All Signals",
      "type": "n8n-nodes-base.merge",
      "position": [
        -800,
        288
      ],
      "parameters": {
        "mode": "combine",
        "options": {},
        "combineBy": "combineByPosition",
        "numberInputs": 3
      },
      "typeVersion": 3.2
    },
    {
      "id": "a29a293e-e617-47ab-bd9f-6656c5217df4",
      "name": "AI Recovery Strategist",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "position": [
        -576,
        288
      ],
      "parameters": {
        "text": "=Lost deal: {{ $json.dealName }}\nContact first name: {{ $json.contactFirstName }}\nHas email address: {{ $json.contactEmail ? 'yes' : 'no' }}\n\nSignals:\nTiming: {{ $json.timingSignal }} (deal was open {{ $json.ageInDays }} days)\nPost-loss engagement: {{ $json.engagementSignal }}\nObjection tracking: {{ $json.objectionSignal }}\n\nPick the best recovery action for this combination.",
        "options": {
          "systemMessage": "You are a deal recovery strategist. You get three independent signals about a lost deal and choose exactly one recoveryAction:\n\n\"SEND_WINBACK_OFFER\" - recoverable now (e.g. still engaged, died fast with no clear reason)\n\"SCHEDULE_30_DAY_FOLLOWUP\" - not recoverable right now but worth a longer nurture (e.g. died slow, no reason logged, no signal either way)\n\"DO_NOT_CONTACT\" - contact would be unwelcome (opted out, or a clearly logged hard objection)\n\"ESCALATE_TO_MANAGER\" - the signals contradict each other (e.g. still warm AND a reason is logged) and a human should decide\n\nReason from the combination, not one signal in isolation. Two signals pointing the same way should raise your confidence. Contradicting signals should push you toward ESCALATE_TO_MANAGER instead of guessing.\n\nNever pick SEND_WINBACK_OFFER if the contact has no email address.\n\nIf you pick SEND_WINBACK_OFFER, also write the email in emailSubject and emailBody:\n- under 80 words, plain text\n- sounds like a real person checking in, not a marketing email\n- use the contact's first name\n- no discounts, no pressure, no fake urgency\n- end with one simple question\n- no sign-off and no name at the end, that gets added later\n- subject line short and lowercase, like a normal email between people\n\nFor any other action return empty strings for emailSubject and emailBody."
        },
        "promptType": "define",
        "hasOutputParser": true
      },
      "typeVersion": 3.1
    },
    {
      "id": "c0d730dd-fc2f-44e7-a6b9-43eaf9b1e855",
