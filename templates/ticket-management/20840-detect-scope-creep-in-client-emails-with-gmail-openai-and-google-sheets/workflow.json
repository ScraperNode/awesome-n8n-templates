    {
      "id": "d11d053d-d4e8-4773-96de-ebf9d0f350e2",
      "name": "Match client SOW",
      "type": "n8n-nodes-base.code",
      "position": [
        180,
        80
      ],
      "parameters": {
        "jsCode": "// Find the SOW for this sender's domain. Unmapped senders stop the workflow here.\nconst cfg = $('Configure settings').first().json;\nlet map = {};\ntry { map = JSON.parse(cfg.client_sow_map || '{}'); } catch (e) { throw new Error('client_sow_map is not valid JSON'); }\nconst lower = Object.fromEntries(Object.entries(map).map(([k, v]) => [k.toLowerCase().trim(), v]));\n\nconst m = $input.first().json;\nconst fromRaw = (m.from && m.from.value && m.from.value[0] && m.from.value[0].address) || m.From || '';\nconst email = ((String(fromRaw).match(/<([^>]+)>/) || [])[1] || String(fromRaw)).trim().toLowerCase();\nconst domain = email.split('@')[1] || '';\nconst docUrl = lower[domain];\nif (!docUrl) return [];\n\nconst body = String(m.text || m.snippet || '')\n  .split(/\\n(?:On .+wrote:|-{2,} ?Original Message|From: )/)[0]\n  .trim()\n  .slice(0, 4000);\n\nreturn [{ json: {\n  client_domain: domain,\n  from_email: email,\n  from_name: (m.from && m.from.value && m.from.value[0] && m.from.value[0].name) || email,\n  subject: m.subject || m.Subject || '(no subject)',\n  body,\n  threadId: m.threadId,\n  doc_url: docUrl,\n} }];"
      },
      "typeVersion": 2
    },
    {
      "id": "73007d5d-fb71-4448-8e9e-1a3b97c2d086",
      "name": "Get client SOW",
      "type": "n8n-nodes-base.googleDocs",
      "position": [
        520,
