    {
      "id": "c02279a8-c45f-4064-8f13-e95067b3087a",
      "name": "Build Invoice Items",
      "type": "n8n-nodes-base.code",
      "position": [
        2560,
        832
      ],
      "parameters": {
        "jsCode": "const config = $('Configure Workflow Settings').first().json;\nconst trigger = $('When Pipedrive Deal Updated').first().json;\nconst deal = trigger.data;\n\nconst products = $input.all()\n  .map(i => i.json)\n  .filter(p => p && (p.name || p.product_name || p.item_price != null || p.price != null));\n\nconst accountCode = String(config.salesAccountCode || '200');\nconst taxType = String(config.taxType || 'OUTPUT');\n// Xero org only has currencies it is subscribed to (this tenant: INR).\nconst invoiceCurrency = String(config.xeroCurrency || 'INR');\n\nlet lineItems = products.map(p => ({\n  Description: String(p.name || p.product_name || 'Item').slice(0, 4000),\n  Quantity: Number(p.quantity) || 1,\n  UnitAmount: Number(p.item_price ?? p.price ?? 0),\n  AccountCode: accountCode,\n  TaxType: taxType\n}));\n\nif (!lineItems.length) {\n  const amount = Number(deal.value) || 0;\n  lineItems = [{\n    Description: String(deal.title || 'Deal services').slice(0, 4000),\n    Quantity: 1,\n    UnitAmount: amount > 0 ? amount : 1,\n    AccountCode: accountCode,\n    TaxType: taxType\n  }];\n}\n\nif (lineItems.every(li => !Number(li.UnitAmount))) {\n  lineItems[0].UnitAmount = 1;\n}\n\nconst contactId = $('Set Existing Contact ID').isExecuted\n  ? $('Set Existing Contact ID').first().json.contactId\n  : $('Set New Contact ID').first().json.contactId;\n\nif (!contactId) {\n  throw new Error('Missing Xero contactId');\n}\n\nreturn [{\n  json: {\n    contactId,\n    dealId: deal.id,\n    dealTitle: deal.title,\n    dealValue: deal.value,\n    dealCurrency: deal.currency || null,\n    invoiceCurrency,\n    stageId: deal.stage_id,\n    lineItems\n  }\n}];"
      },
      "typeVersion": 2
    },
