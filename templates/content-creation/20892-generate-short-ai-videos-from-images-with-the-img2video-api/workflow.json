      ],
      "parameters": {
        "color": 7,
        "width": 416,
        "height": 320,
        "content": "## Start and configure\n\nManual entry point and setup values for the image-to-video request, including the image URL, model choice, prompt, and API base URL."
      },
      "typeVersion": 1
    },
