    {
      "id": "782cf917-bef5-4f4d-a875-c3546ca9b73f",
      "name": "One row per brand and engine",
      "type": "n8n-nodes-base.code",
      "position": [
        1540,
        100
      ],
      "parameters": {
        "jsCode": "// One row per brand and engine, from the run summary (the OUTPUT record).\nconst report = $input.first().json;\nconst runId = $('Start AI visibility check').first().json.data.id;\nconst date = new Date().toISOString().slice(0, 10);\nconst pct = (x) => (x === null || x === undefined ? '' : Math.round(x * 1000) / 10);\n\nconst rows = [];\nfor (const [engine, brands] of Object.entries(report.byEngine || {})) {\n  for (const b of brands) {\n    rows.push({\n      json: {\n        date,\n        engine,\n        brand: b.brand,\n        yourBrand: b.isTarget ? 'yes' : 'no',\n        answers: b.answers,\n        mentionedIn: b.mentionedIn,\n        mentionRatePct: pct(b.mentionRate),\n        shareOfVoicePct: pct(b.shareOfVoice),\n        avgListRank: b.avgListRank === null ? '' : Math.round(b.avgListRank * 10) / 10,\n        citationRatePct: pct(b.citationRate),\n        runUrl: `https://console.apify.com/view/runs/${runId}`,\n      },\n    });\n  }\n}\nreturn rows;\n"
      },
      "typeVersion": 2
    },
