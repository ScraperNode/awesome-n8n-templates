    {
      "id": "00000000-0000-4000-9e37-79b9905ad199",
      "name": "Shotstack: build the ad",
      "type": "@shotstack/n8n-nodes-shotstack.shotstack",
      "onError": "continueErrorOutput",
      "position": [
        2400,
        0
      ],
      "parameters": {
        "edit": "={\n  \"timeline\": {\n    \"fonts\": [\n      {\n        \"src\": \"https://fonts.gstatic.com/s/montserrat/v31/JTUSjIg1_i6t8kCHKm45xW5rygbi49c.ttf\"\n      }\n    ],\n    \"tracks\": [\n      {\n        \"clips\": [\n          {\n            \"asset\": {\n              \"type\": \"rich-text\",\n              \"text\": \"{{ JSON.stringify(String($('Ad settings').first().json.cta)).slice(1, -1) }}\",\n              \"font\": {\n                \"family\": \"JTUSjIg1_i6t8kCHKm45xW5rygbi49c\",\n                \"size\": 40,\n                \"weight\": \"800\",\n                \"color\": \"#111111\"\n              },\n              \"align\": {\n                \"horizontal\": \"center\",\n                \"vertical\": \"middle\"\n              },\n              \"animation\": {\n                \"preset\": \"ascend\",\n                \"duration\": 0.6,\n                \"direction\": \"up\"\n              },\n              \"background\": {\n                \"color\": \"#FFFFFF\",\n                \"opacity\": 1,\n                \"borderRadius\": 48\n              }\n            },\n            \"start\": 3.5,\n            \"length\": \"end\",\n            \"width\": 360,\n            \"height\": 96,\n            \"position\": \"bottom\",\n            \"offset\": {\n              \"y\": 0.08\n            }\n          }\n        ]\n      },\n      {\n        \"clips\": [\n          {\n            \"asset\": {\n              \"type\": \"rich-text\",\n              \"text\": \"{{ JSON.stringify(String($('Write the ad copy').first().json.price_tag)).slice(1, -1) }}\",\n              \"font\": {\n                \"family\": \"JTUSjIg1_i6t8kCHKm45xW5rygbi49c\",\n                \"size\": 52,\n                \"weight\": \"800\",\n                \"color\": \"#FFFFFF\"\n              },\n              \"align\": {\n                \"horizontal\": \"center\",\n                \"vertical\": \"middle\"\n              },\n              \"animation\": {\n                \"preset\": \"ascend\",\n                \"duration\": 0.6,\n                \"direction\": \"up\"\n              },\n              \"background\": {\n                \"color\": \"#E11D48\",\n                \"opacity\": 1,\n                \"borderRadius\": 52\n              }\n            },\n            \"start\": 1,\n            \"length\": \"end\",\n            \"width\": 320,\n            \"height\": 104,\n            \"position\": \"top\",\n            \"offset\": {\n              \"y\": -0.19\n            }\n          }\n        ]\n      },\n      {\n        \"clips\": [\n          {\n            \"asset\": {\n              \"type\": \"rich-text\",\n              \"text\": \"{{ JSON.stringify(String($('Write the ad copy').first().json.headline)).slice(1, -1) }}\",\n              \"font\": {\n                \"family\": \"JTUSjIg1_i6t8kCHKm45xW5rygbi49c\",\n                \"size\": 60,\n                \"weight\": \"800\",\n                \"color\": \"#FFFFFF\"\n              },\n              \"align\": {\n                \"horizontal\": \"center\",\n                \"vertical\": \"middle\"\n              },\n              \"animation\": {\n                \"preset\": \"ascend\",\n                \"duration\": 0.6,\n                \"direction\": \"up\"\n              },\n              \"shadow\": {\n                \"offsetX\": 0,\n                \"offsetY\": 4,\n                \"blur\": 16,\n                \"color\": \"#000000\",\n                \"opacity\": 0.6\n              }\n            },\n            \"start\": 0.3,\n            \"length\": \"end\",\n            \"width\": 640,\n            \"height\": 180,\n            \"position\": \"top\",\n            \"offset\": {\n              \"y\": -0.05\n            }\n          }\n        ]\n      },\n      {\n        \"clips\": [\n          {\n            \"alias\": \"voiceover\",\n            \"asset\": {\n              \"type\": \"audio\",\n              \"prompt\": \"{{ JSON.stringify(String($('Write the ad copy').first().json.voiceover)).slice(1, -1) }}\",\n              \"model\": \"{{ $('Ad settings').first().json.voice_model }}\"\n            },\n            \"start\": 0.5,\n            \"length\": \"auto\"\n          }\n        ]\n      },\n      {\n        \"clips\": [\n          {\n            \"asset\": {\n              \"type\": \"video\",\n              \"src\": \"{{ $('Animate the product photo').first().json.url }}\"\n            },\n            \"start\": 0,\n            \"length\": \"auto\",\n            \"fit\": \"crop\"\n          }\n        ]\n      }\n    ]\n  },\n  \"output\": {\n    \"format\": \"mp4\",\n    \"resolution\": \"hd\",\n    \"aspectRatio\": \"9:16\"\n  }\n}",
        "resource": "render",
        "operation": "postRender"
      },
      "typeVersion": 1
    },
