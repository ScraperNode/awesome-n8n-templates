      "parameters": {
        "text": "={{ $json['Product Description'] }}",
        "options": {
          "systemMessage": "=You are an expert AI advertising creative director.\n\nCreate exactly 3 unique, cinematic video scene prompts for the following product:\n\n{{ $json['Product Description'] }}\n\nRequirements:\n- Each scene must showcase the product clearly and realistically.\n- Keep the product's identity, shape, colors, materials, branding, and key features consistent across all scenes.\n- Each scene should have a different setting, camera angle, composition, or visual concept.\n- Make the scenes feel like a premium commercial, not generic AI imagery.\n- Include specific details about the environment, lighting, camera movement, framing, and product action.\n- Design each scene so it can later be turned into a short product video.\n- Avoid changing, distorting, duplicating, or inventing important product details.\n- Do not add text, logos, watermarks, or unrelated objects unless they are part of the product.\n- Make each scene visually interesting and suitable for social media advertising.\n\nOutput ONLY a numbered list containing exactly 3 prompts.\nDo not include explanations, headings, or additional text."
        },
        "promptType": "define",
        "hasOutputParser": true
      },
      "typeVersion": 3.1
    },
