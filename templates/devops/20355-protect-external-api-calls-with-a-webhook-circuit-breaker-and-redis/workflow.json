    {
      "id": "67d9362a-331f-40cf-8f32-0ec4acfd6c6d",
      "name": "Redis - Get Breaker State",
      "type": "n8n-nodes-base.redis",
      "position": [
        304,
        880
      ],
      "parameters": {
        "key": "={{ $json.stateKey }}",
        "keyType": "string",
        "options": {},
        "operation": "get",
        "propertyName": "stateRaw"
      },
