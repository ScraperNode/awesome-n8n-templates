    {
      "id": "68c9c8a4-99c9-4577-8aeb-db37a731f3a5",
      "name": "Build cache key",
      "type": "n8n-nodes-base.code",
      "position": [
        5616,
        2944
      ],
      "parameters": {
        "jsCode": "// Builds the cache key from the two ISO 4217 currency codes found in the message,\n// in order of appearance (first = base, second = target), plus today's date.\n// If exactly two codes are not found, the message is simply not cached.\nconst CODES = ['AUD', 'BGN', 'BRL', 'CAD', 'CHF', 'CNY', 'CZK', 'DKK', 'EUR', 'GBP', 'HKD', 'HUF', 'IDR',\n  'ILS', 'INR', 'ISK', 'JPY', 'KRW', 'MXN', 'MYR', 'NOK', 'NZD', 'PHP', 'PLN', 'RON', 'SEK', 'SGD', 'THB',\n  'TRY', 'USD', 'ZAR', 'ARS', 'CLP', 'COP', 'PEN', 'UYU', 'AED', 'SAR', 'EGP', 'NGN', 'KES', 'VND', 'TWD',\n  'UAH', 'ALL', 'TOP', 'MOP', 'CUP', 'SOS', 'MAD', 'BAM', 'LAK'];\n// Codes that are also common words: only accepted when written in UPPERCASE.\nconst COMMON = ['ALL', 'TRY', 'TOP', 'MOP', 'PEN', 'COP', 'CUP', 'SOS', 'MAD', 'BAM', 'LAK', 'RON'];\n\nconst today = $now.toFormat('yyyy-MM-dd');\nconst tokensOf = (s) => String(s || '').split('')\n  .map((c) => (c.toLowerCase() !== c.toUpperCase() ? c : ' ')).join('').split(' ').filter(Boolean);\n\nreturn $input.all().map((item) => {\n  const found = [];\n  tokensOf(item.json.chatInput).forEach((t) => {\n    if (t.length !== 3) return;\n    const up = t.toUpperCase();\n    if (!CODES.includes(up)) return;\n    if (COMMON.includes(up) && t !== up) return;\n    found.push(up);\n  });\n  const distinct = [...new Set(found)];\n  const use_cache = distinct.length === 2;\n  const base = distinct[0] || '';\n  const target = distinct[1] || '';\n  const pair = use_cache ? `${base}|${target}` : '';\n  const cache_key = use_cache ? `${base}|${target}|${today}` : `skip|${Date.now()}`;\n  return { json: { ...item.json, base, target, pair, use_cache, cache_key } };\n});\n"
      },
      "typeVersion": 2
    },
