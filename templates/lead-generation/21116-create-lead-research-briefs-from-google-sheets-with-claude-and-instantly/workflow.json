    {
      "id": "9c2564bf-c30d-4657-93da-0cb66f48e7da",
      "name": "Create Google Doc",
      "type": "n8n-nodes-base.googleDrive",
      "onError": "continueRegularOutput",
      "position": [
        3580,
        480
      ],
      "parameters": {
        "name": "={{ $json.doc_title }}",
        "content": "={{ $json.doc_text }}",
        "driveId": {
          "__rl": true,
          "mode": "list",
          "value": "My Drive"
        },
        "options": {
          "convertToGoogleDocument": true
        },
        "folderId": {
          "__rl": true,
          "mode": "list",
          "value": "root",
          "cachedResultName": "/ (Root folder)"
        },
        "resource": "file",
        "operation": "createFromText"
      },
      "typeVersion": 3,
      "alwaysOutputData": true
    },
    {
      "id": "b6fdb770-57cc-4ee5-b098-b5552d5686f6",
      "name": "Build Result",
      "type": "n8n-nodes-base.code",
      "position": [
        3800,
        480
      ],
      "parameters": {
        "jsCode": "// Turn the Google Drive answer into the final result for this lead.\nconst brief = $('Parse Brief').first().json;\nconst docId = $input.first().json.id;\n\n// The document was not created. Leave the lead as NO so it retries next run.\nif (!docId) {\n  return [{ json: { email: brief.email, document_url: '', processed: 'NO', status: 'error', send_to_instantly: false } }];\n}\n\nconst campaignId = String($('Settings').first().json.instantly_campaign_id || '').trim();\n\nreturn [\n  {\n    json: {\n      email: brief.email,\n      first_name: brief.first_name,\n      company_name: brief.company_name,\n      document_url: `https://docs.google.com/document/d/${docId}/edit`,\n      processed: 'YES',\n      status: 'ok',\n      send_to_instantly: campaignId !== '',\n    },\n  },\n];\n"
      },
      "typeVersion": 2
    },
    {
      "id": "87d8b0fa-97f7-4254-967b-175d065fb84b",
      "name": "Send to Instantly?",
      "type": "n8n-nodes-base.if",
