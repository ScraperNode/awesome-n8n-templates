    {
      "id": "44276cd0-22cd-4f04-8e20-8ccc593c0c4e",
      "name": "Calculate Stats and Spot Anomalies",
      "type": "n8n-nodes-base.code",
      "position": [
        3424,
        1680
      ],
      "parameters": {
        "jsCode": "const client=$('Loop Over Clients').item.json;const rows=$input.all().map(i=>i.json).filter(r=>r&&Object.keys(r).length);\nconst now=new Date(),end=new Date(Date.UTC(now.getUTCFullYear(),now.getUTCMonth(),now.getUTCDate()));const start=new Date(end.getTime()-7*86400000),prior=new Date(end.getTime()-14*86400000);\nconst amount=v=>{const n=Number(String(v??'0').replace(/[^0-9.\\-]/g,''));return Number.isFinite(n)?n:0};\nlet current=0,previous=0,overdue=0;const categories={};\nfor(const r of rows){const d=new Date(r.date??r.Date??r.DATE);if(isNaN(d))continue;const a=amount(r.amount??r.Amount??r.AMOUNT),category=String(r.category??r.Category??'Uncategorized'),status=String(r.status??r.Status??'').toLowerCase();\nif(d>=start&&d<end){if(['overdue','failed','unpaid'].includes(status))overdue++;else {current+=a;categories[category]=(categories[category]||0)+a;}}else if(d>=prior&&d<start&&!['overdue','failed','unpaid'].includes(status))previous+=a;}\nconst pct=previous===0?(current===0?0:null):(current-previous)/previous*100;const sorted=Object.entries(categories).sort((a,b)=>b[1]-a[1]);const threshold=Number(client.threshold_pct)>0?Number(client.threshold_pct):20;const anomalies=[];\nif(pct!==null&&pct<=-threshold)anomalies.push(`Revenue dropped ${Math.abs(pct).toFixed(1)}% versus the prior seven days.`);if(overdue)anomalies.push(`${overdue} overdue, failed, or unpaid transaction(s).`);if(current===0)anomalies.push('No paid revenue recorded in the last seven complete days.');\nreturn [{json:{client_id:client.id,business_name:client.business_name,email:client.email,total_this_period:+current.toFixed(2),total_last_period:+previous.toFixed(2),pct_change:pct===null?null:+pct.toFixed(1),overdue_count:overdue,top_category:sorted[0]?.[0]||'N/A',category_breakdown:sorted.map(([c,v])=>`${c}: ${v.toFixed(2)}`).join(', '),anomalies,anomalies_count:anomalies.length,run_date:end.toISOString().slice(0,10)}}];"
      },
      "typeVersion": 2
    },
    {
      "id": "b7afb01d-1a0b-46fa-a015-50e37a754990",
      "name": "Post to Claude API",
      "type": "n8n-nodes-base.httpRequest",
      "onError": "continueErrorOutput",
      "position": [
        3664,
        1680
      ],
      "parameters": {
        "url": "https://api.anthropic.com/v1/messages",
        "method": "POST",
        "options": {
          "timeout": 30000
        },
        "jsonBody": "={{ {model:'REPLACE_WITH_AVAILABLE_CLAUDE_MODEL',max_tokens:500,messages:[{role:'user',content:`Write a plain-English operations brief under 150 words for ${$json.business_name}. Seven complete days of paid revenue: ${$json.total_this_period}; prior seven days: ${$json.total_last_period}; change: ${$json.pct_change===null?'no prior-period baseline':$json.pct_change+'%'}; unpaid/failed transactions: ${$json.overdue_count}; top category: ${$json.top_category}; category breakdown: ${$json.category_breakdown}; issues: ${$json.anomalies.join(' | ')||'none'}. Include a headline number, urgent issues, a positive highlight if supported by data, and one concrete next action. Do not invent facts.`}]} }}",
        "sendBody": true,
        "sendHeaders": true,
        "specifyBody": "json",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "headerParameters": {
          "parameters": [
            {
              "name": "anthropic-version",
              "value": "2023-06-01"
            },
            {
              "name": "content-type",
              "value": "application/json"
            }
          ]
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "credential-id",
          "name": "Anthropic Auth"
        }
      },
      "typeVersion": 4.2
    },
