      ],
      "parameters": {
        "text": "={{ JSON.stringify({ customer_name: $json.customer_name, rating: $json.rating, review_text: $json.review_text }) }}",
        "options": {
          "systemMessage": "You are a review analysis engine for a local business. Analyze ONLY the review provided. Use only information present in the review text and rating; never invent facts, causes, names or events. Return ONLY valid JSON with exactly these keys: sentiment (positive | neutral | negative), rating (integer 1-5, copy the given rating), topics (array; allowed values only: service, staff, price, quality, delivery, waiting_time, product, communication, cleanliness, support), customer_intent (short phrase, e.g. praise, share feedback, complain, request refund), urgency (low | medium | high), needs_escalation (boolean), reason_for_escalation (string, empty if not escalated). Escalate serious complaints, legal threats, safety concerns, misconduct allegations, refund or compensation requests, or highly emotional language."
        },
        "promptType": "define"
      },
      "retryOnFail": false,
      "typeVersion": 1.7,
      "waitBetweenTries": 2000
    },
    {
      "id": "339e6530-6fca-425e-80de-694a0120479c",
      "name": "Generate AI Response",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "maxTries": 3,
      "position": [
        1552,
        368
      ],
      "parameters": {
        "text": "={{ (() => { const r = $('Loop Over Reviews').first().json; const a = JSON.parse($('Analyze Review with AI').first().json.output); return JSON.stringify({ business_name: r.business_name, customer_name: r.customer_name, rating: r.rating, review_text: r.review_text, sentiment: a.sentiment, topics: a.topics }); })() }}",
        "options": {
          "systemMessage": "You write public replies to customer reviews on behalf of a local business. Return ONLY valid JSON: {\"response\": \"...\"}. Rules: sound human, warm and professional, never robotic. Keep it concise (2-4 sentences). Use the customer's first name. Match the sentiment of the review. Do NOT make false promises, do NOT invent compensation, refunds, discounts or explanations for what happened, do NOT mention AI or internal systems. Only reference details present in the review. Sign off as the business team (e.g. The <business_name> Team), never with a personal name. Positive: thank them and invite them back. Neutral: thank them, acknowledge the mixed feedback and address their specific comments. Negative: acknowledge their experience, apologize where appropriate, do not argue, do not blame staff or the customer, and invite them to contact the business privately."
        },
        "promptType": "define"
      },
      "retryOnFail": false,
      "typeVersion": 1.7,
      "waitBetweenTries": 2000
    },
