    {
      "id": "4861e65c-b8fe-5cf5-be18-64541de55b77",
      "name": "Prepare Access Decision",
      "type": "n8n-nodes-base.code",
      "position": [
        -880,
        -560
      ],
      "parameters": {
        "jsCode": "const messages = {\n  approved: {\n    callbackAnswer: 'Access approved',\n    userMessage: '\u0414\u043e\u0441\u0442\u0443\u043f \u043e\u0434\u043e\u0431\u0440\u0435\u043d. \u041e\u0442\u043f\u0440\u0430\u0432\u044c\u0442\u0435 /start, \u0432\u043e\u043f\u0440\u043e\u0441 \u0442\u0435\u043a\u0441\u0442\u043e\u043c \u0438\u043b\u0438 \u0433\u043e\u043b\u043e\u0441\u043e\u0432\u043e\u0435 \u0441\u043e\u043e\u0431\u0449\u0435\u043d\u0438\u0435.',\n  },\n  denied: {\n    callbackAnswer: 'Access denied',\n    userMessage: '\u0417\u0430\u043f\u0440\u043e\u0441 \u043d\u0430 \u0434\u043e\u0441\u0442\u0443\u043f \u043e\u0442\u043a\u043b\u043e\u043d\u0451\u043d \u0430\u0434\u043c\u0438\u043d\u0438\u0441\u0442\u0440\u0430\u0442\u043e\u0440\u043e\u043c.',\n  },\n  blocked: {\n    callbackAnswer: 'User blocked',\n    userMessage: '\u0414\u043e\u0441\u0442\u0443\u043f \u043a \u0431\u043e\u0442\u0443 \u0437\u0430\u0431\u043b\u043e\u043a\u0438\u0440\u043e\u0432\u0430\u043d \u0430\u0434\u043c\u0438\u043d\u0438\u0441\u0442\u0440\u0430\u0442\u043e\u0440\u043e\u043c.',\n  },\n};\n\nconst selected = messages[$json.decisionStatus];\nif (!selected) {\n  throw new Error('Unsupported access decision');\n}\n\nreturn [{\n  json: {\n    ...$json,\n    ...selected,\n    redisValue: JSON.stringify({\n      status: $json.decisionStatus,\n      userId: $json.targetUserId,\n      chatId: $json.targetChatId,\n      decidedBy: $json.callbackActorId,\n      decidedAt: new Date().toISOString(),\n    }),\n  },\n}];"
      },
      "typeVersion": 2
    },
