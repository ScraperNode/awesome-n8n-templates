              "name": "drafts",
              "type": "object",
              "value": "={{ (() => { const d = JSON.parse(JSON.stringify($('Write a caption for each network').item.json.drafts || {})); for (const n of $('Read the form').item.json.networks) { d[n] = d[n] || {}; if ($json[n]) d[n].text = $json[n]; } if (d.youtube && $json.youtube_title) d.youtube.title = $json.youtube_title; return d; })() }}"
            },
            {
              "id": "1a52247b-82e4-4863-a20d-2c430a8dd764",
