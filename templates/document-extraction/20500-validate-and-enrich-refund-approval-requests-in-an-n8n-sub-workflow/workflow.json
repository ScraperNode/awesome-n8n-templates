    },
    {
      "id": "f0347c83-b8e9-4a49-b994-2907471e484e",
      "name": "Validate Request",
      "type": "n8n-nodes-base.if",
      "position": [
        240,
        300
      ],
      "parameters": {
        "options": {},
        "conditions": {
          "options": {
            "version": 2,
            "leftValue": "",
            "caseSensitive": true,
            "typeValidation": "loose"
          },
          "combinator": "and",
          "conditions": [
            {
              "id": "5ae7e443-5d17-4976-87ac-c106aaec860b",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              },
              "leftValue": "={{ Number.isSafeInteger(($json.body ?? $json).amount) && ($json.body ?? $json).amount > 0 && typeof ($json.body ?? $json).requestId === 'string' && ($json.body ?? $json).requestId.trim() !== '' && typeof ($json.body ?? $json).reason === 'string' && ($json.body ?? $json).reason.trim() !== '' }}",
              "rightValue": true
            }
          ]
        },
        "looseTypeValidation": true
      },
      "typeVersion": 2.2
    },
    {
      "id": "dc04c498-2492-4a8c-9f19-b611d9ce7efa",
      "name": "Reject Request",
      "type": "n8n-nodes-base.stopAndError",
      "position": [
        480,
        520
      ],
      "parameters": {
        "errorMessage": "amount must be a positive integer in USD cents, and requestId and reason are required"
      },
      "typeVersion": 1
    },
    {
      "id": "d81eb00f-4628-44d9-bc25-c097d6e1dcef",
      "name": "Enrich Request",
      "type": "n8n-nodes-base.set",
