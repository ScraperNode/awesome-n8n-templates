    {
      "id": "2c945e6c-8099-4375-a232-68f6727fd4c6",
      "name": "Find Event Posts",
      "type": "@periodix/n8n-nodes-actions.linkedIn",
      "position": [
        480,
        400
      ],
      "webhookId": "bce087d5-7453-4ee8-92b7-b7d6b9758d2b",
      "parameters": {
        "limit": "={{ $(\"Event Config\").first().json.posts_limit }}",
        "options": {},
        "resource": "search",
        "profileId": "<__PLACEHOLDER_VALUE__Pick your connected LinkedIn profile__>",
        "searchUrl": "={{ \"https://www.linkedin.com/search/results/content/?keywords=\" + encodeURIComponent($(\"Event Config\").first().json.event_keywords) }}"
      },
      "credentials": {
        "periodixActionsApi": {
          "id": "A4WEcqEh8UeYtykF",
          "name": "Periodix Actions account"
        }
      },
      "typeVersion": 1.1
    },
    {
      "id": "491e66dd-2ca4-4799-bc35-f3ae24def687",
      "name": "Extract and Filter Authors",
      "type": "n8n-nodes-base.code",
      "position": [
        720,
        400
      ],
      "parameters": {
        "jsCode": "const cfg = $('Event Config').first().json;\nconst kw = String(cfg.icp_keywords || '').toLowerCase().split(',').map(s => s.trim()).filter(Boolean);\nconst seen = new Set();\nconst out = [];\nfor (const i of $input.all()) {\n  const j = i.json;\n  const a = j.author || j;\n  const id = a.provider_id || a.id || a.entity_urn;\n  if (!id || seen.has(id)) continue;\n  seen.add(id);\n  const headline = a.headline || a.occupation || '';\n  const company = a.company || a.company_name || '';\n  const hay = (headline + ' ' + company).toLowerCase();\n  if (kw.length && !kw.some(k => hay.includes(k))) continue;\n  out.push({ json: {\n    name: a.name || [a.first_name, a.last_name].filter(Boolean).join(' ') || '',\n    headline, company,\n    provider_id: id,\n    profile_url: a.profile_url || a.public_url || a.url || '',\n    matched_post: String(j.text || j.commentary || j.summary || '').slice(0, 500),\n    post_url: j.url || j.post_url || ''\n  } });\n}\nreturn out;"
      },
      "typeVersion": 2
    },
    {
