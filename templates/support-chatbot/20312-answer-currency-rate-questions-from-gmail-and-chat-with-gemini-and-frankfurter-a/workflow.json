    {
      "id": "a2385356-deaf-4cda-93a0-a1a2dd3d82f0",
      "name": "Clean agent answer",
      "type": "n8n-nodes-base.code",
      "position": [
        6752,
        2976
      ],
      "parameters": {
        "jsCode": "// Flattens the agent output to plain text.\n// 'ok' is true only if the answer contains at least one digit (a real rate),\n// so questions and error messages are never stored in the cache.\nreturn $input.all().map((item) => {\n  let text = String(item.json.output || item.json.text || '');\n  text = text.split('\\n').join(' ').split('*').join('').split('#').join('');\n  while (text.includes('  ')) text = text.split('  ').join(' ');\n  text = text.trim();\n  const ok = /=\\s*\\d+([.,]\\d+)?/.test(text);\n  if (text.length === 0) text = 'I could not generate an answer. Please try again using two currency codes, for example USD to EUR.';\n  return { json: { response: text, ok } };\n});\n"
      },
      "typeVersion": 2
    },
