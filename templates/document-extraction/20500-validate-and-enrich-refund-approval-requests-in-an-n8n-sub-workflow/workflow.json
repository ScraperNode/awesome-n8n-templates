            {
              "id": "8e8467ad-b323-484e-ab48-64b3125d2a79",
              "name": "priorRefunds12mo",
              "type": "number",
              "value": "={{ ($json.body ?? $json).requestId === 'REQ-2001' ? 0 : 3 }}"
