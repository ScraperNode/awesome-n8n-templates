    {
      "id": "3db9f41e-222a-4904-8bb8-76ef59d0ab85",
      "name": "Find Duplicates - Code",
      "type": "n8n-nodes-base.code",
      "position": [
        1820,
        420
      ],
      "parameters": {
        "jsCode": "const inv = $('Extract Fields - Info Extractor').first().json;\nconst rows = $input.all().map(i => i.json);\nconst dup = rows.some(r => String(r.invoice_number) === String(inv.invoice_number)\n  && String(r.vendor_name).toLowerCase() === String(inv.vendor_name).toLowerCase());\nreturn [{ json: { ...inv, is_duplicate: dup } }];"
      },
      "typeVersion": 2
    },
    {
      "id": "d9f9c2d4-fd8d-4ebd-8b52-74c455919ff5",
      "name": "IF - Duplicate?",
      "type": "n8n-nodes-base.if",
      "position": [
        2080,
        420
      ],
      "parameters": {
        "options": {
          "looseTypeValidation": true
        },
        "conditions": {
          "options": {
            "version": 2,
            "leftValue": "",
