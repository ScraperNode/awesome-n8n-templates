    {
      "id": "356595ac-b8b4-563e-b182-9acd0d0380a6",
      "name": "Parse Access Status",
      "type": "n8n-nodes-base.code",
      "position": [
        -900,
        80
      ],
      "parameters": {
        "jsCode": "const input = $('Normalize Telegram Update').first().json;\n\nconst candidates = [\n  $json.propertyName,\n  $json.value,\n  $json.data,\n  $json.result,\n];\n\nlet raw = candidates.find((value) => value !== undefined && value !== null && value !== '');\nlet record = null;\n\nif (typeof raw === 'string') {\n  try {\n    record = JSON.parse(raw);\n  } catch {\n    record = { status: raw };\n  }\n} else if (raw && typeof raw === 'object') {\n  record = raw;\n}\n\nconst allowed = new Set(['approved', 'pending', 'denied', 'blocked']);\nconst candidateStatus = String(record?.status ?? '').toLowerCase();\nconst accessStatus = allowed.has(candidateStatus) ? candidateStatus : 'unknown';\n\nreturn [{\n  json: {\n    ...input,\n    accessStatus,\n  },\n}];"
      },
      "typeVersion": 2
    },
