    {
      "id": "5b3e1a2c-0014-4d6e-9f70-8a1b2c3d4e5f",
      "name": "Check the translation",
      "type": "n8n-nodes-base.code",
      "position": [
        2320,
        0
      ],
      "parameters": {
        "jsCode": "// Takes the translations out of Claude's reply and lists anything Claude has to fix.\nconst attempt = $json.attempt;\nconst text = String($json.text ?? '');\nconst cues = $('Read the transcript').first().json.cues;\nconst want = String($('Your video').first().json.languages).split(',').map((s) => s.trim()).filter(Boolean);\nconst problems = [];\nlet languages = [];\ntry {\n  languages = JSON.parse(text.slice(text.indexOf('{'), text.lastIndexOf('}') + 1)).languages;\n} catch (e) {\n  problems.push('The reply is not one valid JSON object.');\n}\nif (!Array.isArray(languages)) languages = [];\nif (!problems.length && languages.length < want.length) problems.push('Translate into all ' + want.length + ' languages: ' + want.join(', ') + '.');\nfor (const l of languages) {\n  l.lines = (Array.isArray(l.lines) ? l.lines : []).map((s) => String(s).replace(/\\s+/g, ' ').trim());\n  if (l.lines.length !== cues.length) problems.push(l.name + ': write ' + cues.length + ' lines, one per caption, not ' + l.lines.length + '.');\n  if (!/^[a-z]{2}$/.test(String(l.code))) problems.push(l.name + ': give its two-letter ISO 639-1 code.');\n}\nreturn [{ json: { languages, problems: problems.join(' '), attempt, text } }];"
      },
      "typeVersion": 2
    },
    {
