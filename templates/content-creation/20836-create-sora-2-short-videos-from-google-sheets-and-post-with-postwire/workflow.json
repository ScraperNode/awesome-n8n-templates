        "resource": "text",
        "simplify": true,
        "operation": "response",
        "responses": {
          "values": [
            {
              "role": "system",
              "type": "text",
              "content": "You plan one short vertical (9:16) video made with Sora 2. Return JSON with the keys sora_prompt (one paragraph for a single shot that fits the length: subject, action, setting, camera movement, light and sound; no on-screen text, no logos, no real people or brands), caption_idea (one or two sentences that say what the video shows, to write the captions from) and youtube_title (a searchable title of up to 80 characters ending in #Shorts)."
            },
            {
              "role": "user",
              "type": "text",
              "content": "={{ 'Idea: ' + $('Take the next idea').item.json.idea + '\\nStyle: ' + ($('Take the next idea').item.json.style || $('Channel settings').first().json.style) + '\\nLength: ' + $('Channel settings').first().json.seconds + ' seconds' }}"
