    {
      "id": "6adcc7ed-b1f4-40ab-86dc-223acfc9a38f",
      "name": "Build Image Post",
      "type": "n8n-nodes-base.code",
      "onError": "continueErrorOutput",
      "position": [
        2032,
        144
      ],
      "parameters": {
        "jsCode": "\n// Runs once for all uploaded images and builds the Posts API payload.\nconst p = $('Validate and Normalize Input').first().json;\nconst expected = $('Split Images').all().length;\nconst uploaded = $input.all().length;\nif (uploaded !== expected) {\n  throw new Error('Only ' + uploaded + ' of ' + expected + ' images uploaded, post not created.');\n}\nconst images = $('Register Image Upload').all().map(it => ({ id: it.json.value.image }));\n\n// LinkedIn \"little\" text format: escape reserved characters, keep hashtags.\nconst esc = (t) => String(t || '')\n  .replace(/[\\\\|{}@\\[\\]()<>*_~]/g, (m) => '\\\\' + m)\n  .replace(/#(?![\\p{L}\\p{N}])/gu, '\\\\#');\n\nconst content = images.length > 1\n  ? { multiImage: { images } }\n  : { media: { id: images[0].id } };\n\nreturn [{ json: { payload: {\n  author: p.author_urn,\n  commentary: esc(p.text),\n  visibility: 'PUBLIC',\n  distribution: { feedDistribution: 'MAIN_FEED', targetEntities: [], thirdPartyDistributionChannels: [] },\n  lifecycleState: 'PUBLISHED',\n  isReshareDisabledByAuthor: false,\n  content,\n} } }];\n"
      },
      "typeVersion": 2
    },
    {
      "id": "061c7fce-b337-49e7-8871-5c0fbafc51df",
      "name": "Build Text Post",
      "type": "n8n-nodes-base.code",
      "position": [
        1152,
        336
      ],
      "parameters": {
        "jsCode": "\n// Text-only post for the Posts API.\nconst p = $('Validate and Normalize Input').first().json;\nconst esc = (t) => String(t || '')\n  .replace(/[\\\\|{}@\\[\\]()<>*_~]/g, (m) => '\\\\' + m)\n  .replace(/#(?![\\p{L}\\p{N}])/gu, '\\\\#');\nreturn [{ json: { payload: {\n  author: p.author_urn,\n  commentary: esc(p.text),\n  visibility: 'PUBLIC',\n  distribution: { feedDistribution: 'MAIN_FEED', targetEntities: [], thirdPartyDistributionChannels: [] },\n  lifecycleState: 'PUBLISHED',\n  isReshareDisabledByAuthor: false,\n} } }];\n"
      },
      "typeVersion": 2
    },
