    {
      "id": "f226785d-2412-532f-8e0f-0787ac5069fc",
      "name": "Section 2",
      "type": "n8n-nodes-base.stickyNote",
      "position": [
        440,
        -180
      ],
      "parameters": {
        "color": 7,
        "width": 1060,
        "height": 560,
        "content": "## 2. Create the job and wait\nOne API call transcribes, wraps and burns in the captions. The loop checks the status every 15 seconds until the job finishes or fails."
      },
      "typeVersion": 1
    },
    {
      "id": "f515bf45-c195-5abd-95b8-e2712c4aee37",
      "name": "Create captioning job",
      "type": "n8n-nodes-base.httpRequest",
      "position": [
        540,
        0
      ],
      "parameters": {
        "url": "https://video-subtitle-transcript-api1.p.rapidapi.com/v1/jobs",
        "method": "POST",
        "options": {},
        "jsonBody": "={{ { source_url: $json.video_url, language: $json.language, orientation: $json.orientation, vocabulary: $json.vocabulary, caption_style: { preset: $json.preset }, burn_in: true, outputs: ['srt'] } }}",
        "sendBody": true,
        "sendHeaders": true,
        "specifyBody": "json",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "headerParameters": {
          "parameters": [
            {
              "name": "X-RapidAPI-Host",
              "value": "video-subtitle-transcript-api1.p.rapidapi.com"
            }
          ]
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "",
          "name": "RapidAPI - Video Subtitle API"
        }
      },
      "typeVersion": 4.2
    },
