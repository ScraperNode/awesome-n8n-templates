      ],
      "parameters": {
        "jsCode": "const items = $input.all().map(it => it.json);\nconst pageIds = items.filter(it => it.kind === 'page').map(it => it.id);\nconst postIds = items.filter(it => it.kind === 'post').map(it => it.id);\nreturn [{ json: { pageIds: pageIds.length ? pageIds.join(',') : '0', postIds: postIds.length ? postIds.join(',') : '0' } }];"
