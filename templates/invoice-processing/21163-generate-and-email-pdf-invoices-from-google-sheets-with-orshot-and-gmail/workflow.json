    {
      "id": "70ecd567-6eb6-4522-8438-72251966955e",
      "name": "Mark as sent",
      "type": "n8n-nodes-base.code",
      "position": [
        2620,
        320
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Email and Drive failures come back as { error } because both steps continue on error.\nconst row = $('Get PDF link').item.json;\nconst err = j => (j?.error ? String(j.error.message || j.error) : '');\nconst mailError = err($('Email invoice').item.json) || err($('Download PDF').item.json);\nconst file = $('Save PDF to Google Drive').item.json;\nconst driveError = err(file);\nreturn {\n  json: {\n    ...row,\n    status: mailError ? 'Error' : 'Sent',\n    drive: file?.id && !driveError ? `https://drive.google.com/file/d/${file.id}/view` : '',\n    sent_at: mailError ? '' : $now.toISO(),\n    error: [mailError && `Email: ${mailError}`, driveError && `Drive: ${driveError}`].filter(Boolean).join('. '),\n  },\n};"
      },
      "typeVersion": 2
    },
