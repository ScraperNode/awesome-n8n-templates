      "position": [
        192,
        112
      ],
      "parameters": {
        "color": 5,
        "width": 414,
        "height": 176,
        "content": "## \u2699\ufe0f 1. Trigger & Config\nRuns every night at 22:30 \u2014 edit the Schedule Trigger to change the time.\n\nSets the instance base_url and the excluded_workflow_ids list (comma-separated IDs to never deactivate)."
      },
      "typeVersion": 1
    },
