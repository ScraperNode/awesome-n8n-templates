    {
      "id": "5733d346-f0e1-4e47-9e1a-776108675385",
      "name": "AI Turnover Analysis Agent",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "position": [
        4144,
        -800
      ],
      "parameters": {
        "text": "=Assess this apartment turnover and create the maintenance job.\n\nUNIT SUBMISSION:\nUnit ID: {{ $('Set Submission Details').item.json.unitId }}\nCondition Report: {{ $('Set Submission Details').item.json.report }}\n\nUNIT PROFILE:\n{{ JSON.stringify($('Read Unit Profiles from Sheets').item.json) }}\n\nTURNOVER HISTORY:\n{{ JSON.stringify($('Read Turnover History from Sheets').item.json) }}\n\nClassify the operational priority based on urgency, safety, habitability, move-in impact and the reported condition. Return only the structured output.",
        "options": {
          "systemMessage": "You are an apartment maintenance operations coordinator. Analyze turnover condition reports and convert them into actionable maintenance jobs.\n\nPriority rules:\nCRITICAL = immediate safety/habitability issue or severe issue that can prevent occupancy.\nHIGH = important repair likely to delay turnover or materially affect move-in.\nNORMAL = routine repair that should be completed during normal turnover.\nLOW = cosmetic or non-urgent work.\n\nChoose the most appropriate trade. Create concise actionable tasks. Do not invent facts that are not present in the report, unit profile or history."
        },
        "promptType": "define",
        "hasOutputParser": true
      },
      "typeVersion": 2.2
    },
    {
      "id": "f77184a1-2fc8-4dc1-9e36-997784c2460a",
      "name": "Parse Structured Output",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "position": [
        4432,
        -560
      ],
      "parameters": {
        "jsonSchemaExample": "{\n  \"priority\": \"HIGH\",\n  \"summary\": \"Kitchen sink is leaking and bathroom exhaust fan is not working\",\n  \"trade\": \"PLUMBING\",\n  \"tasks\": [\n    \"Repair kitchen sink leak\",\n    \"Inspect bathroom exhaust fan\",\n    \"Test both after repair\"\n  ],\n  \"estimated_hours\": 3,\n  \"move_in_risk\": true,\n  \"requires_vendor\": false,\n  \"reason\": \"Active repair issues may delay unit turnover\"\n}"
      },
      "typeVersion": 1.3
    },
