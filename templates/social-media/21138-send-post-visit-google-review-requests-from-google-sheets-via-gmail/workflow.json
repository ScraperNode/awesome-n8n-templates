    {
      "id": "5d1d00ab-b868-5ca2-b80b-37293285a274",
      "name": "Match opt-out",
      "type": "n8n-nodes-base.code",
      "position": [
        660,
        760
      ],
      "parameters": {
        "jsCode": "\nconst truthy = v => ['true','yes','y','1','x'].includes(String(v ?? '').trim().toLowerCase());\nconst q = $('Unsubscribe link').first().json.query || {};\nconst v = String(q.v ?? '').trim(), e = String(q.e ?? '').trim().toLowerCase();\nconst rows = $('Read Visits (opt-out)').all().map(i => i.json).filter(r => r && Object.keys(r).length);\nif (!v || !e || !rows.some(r => String(r.visit_id ?? '').trim() === v && String(r.email ?? '').trim().toLowerCase() === e)) return [{ json: { visit_id: '' } }];\nconst upd = rows.filter(r => String(r.email ?? '').trim().toLowerCase() === e && !truthy(r.opt_out))\n           .map(r => ({ json: { visit_id: String(r.visit_id), opt_out: 'TRUE' } }));\nreturn upd.length ? upd : [{ json: { visit_id: '' } }];\n"
      },
      "typeVersion": 2
    },
