            {
              "id": "ec5cd70f-8eb4-4138-8fef-664e2a2d7a09",
              "name": "maxTotalChargeUsd",
              "type": "number",
              "value": 0.1
            },
            {
              "id": "8c32cec8-5612-4a49-a794-c90239e55724",
              "name": "actorInput",
              "type": "object",
              "value": "{\"domains\": [\"nike.com\"], \"region\": \"US\", \"resultType\": \"ads\", \"includeAdContent\": true, \"includeDetails\": false, \"onlyNewAds\": false, \"maxAdsPerTarget\": 20, \"maxItems\": 20}"
            }
          ]
        }
      },
      "typeVersion": 3.4
    },
    {
      "id": "b9cee195-210d-4f25-b03e-dd63bd133672",
      "name": "Validate configuration",
      "type": "n8n-nodes-base.code",
      "position": [
        660,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const c=$input.first().json;\nif (!c.spreadsheetId || c.spreadsheetId.startsWith('REPLACE_'))\n  throw new Error('Set spreadsheetId in Configuration.');\nconst a=c.actorInput;\nif (a.onlyNewAds !== false || a.resultType !== 'ads' || !Number.isInteger(a.maxItems) || a.maxItems<1 || a.maxItems>500)\n  throw new Error('Use ads snapshots, onlyNewAds=false, maxItems from 1 to 500.');\nif (!Array.isArray(a.domains) || a.domains.length!==1 || !/^[a-z0-9.-]+\\.[a-z]{2,}$/.test(a.domains[0]) || (a.queries?.length || a.advertiserIds?.length || a.startUrls?.length))\n  throw new Error('This starter supports one lowercase domain. Use a separate workflow/sheet for each competitor.');\nif (!Number.isFinite(c.maxTotalChargeUsd) || c.maxTotalChargeUsd<=0 || c.maxTotalChargeUsd>1)\n  throw new Error('Set a maximum run charge greater than zero and no more than $1.');\nreturn [{json:c}];"
      },
      "typeVersion": 2
    },
