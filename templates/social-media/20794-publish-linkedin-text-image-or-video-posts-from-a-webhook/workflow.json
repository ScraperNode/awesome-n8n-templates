        "responseBody": "={{ JSON.stringify({ url: $json.url, urn: $json.urn }) }}"
      },
      "typeVersion": 1.1
    },
    {
      "id": "c1ff1399-a1d8-492e-988b-aadbe90dec5c",
      "name": "Build Error Message",
      "type": "n8n-nodes-base.code",
      "position": [
        2688,
        240
      ],
      "parameters": {
        "jsCode": "\n// One error shape for every failure. Two sources:\n//  a) a rejected LinkedIn response (fullResponse): body.message is the reason you want to read.\n//  b) an n8n error output: $json.error is a string (verified), object form handled too.\nconst j = $input.first().json || {};\nconst body = j.body && typeof j.body === 'object' ? j.body : null;\nconst e = j.error;\nlet reason = '';\nif (body && (body.message || body.errorDetails)) {\n  reason = body.message || JSON.stringify(body.errorDetails);\n  if (j.statusCode) reason = 'LinkedIn ' + j.statusCode + ': ' + reason;\n} else if (typeof e === 'string') {\n  reason = e;\n} else if (e && typeof e === 'object') {\n  reason = e.description || e.message || '';\n}\nif (!reason) reason = j.message || 'Unknown error while publishing to LinkedIn.';\nreturn [{ json: { error: String(reason).slice(0, 500) } }];\n"
      },
      "typeVersion": 2
    },
