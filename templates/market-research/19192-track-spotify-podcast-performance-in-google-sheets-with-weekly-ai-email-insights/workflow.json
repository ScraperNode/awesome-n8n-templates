    {
      "id": "c255201c-c226-44c5-a43f-63e5fe699f99",
      "name": "Prepare the analysis",
      "type": "n8n-nodes-base.code",
      "position": [
        6400,
        -256
      ],
      "parameters": {
        "jsCode": "// Send the model a small, ranked briefing rather than every raw row.\nconst rows = $('Compare, score and rank').all().map(i => i.json);\nconst first = rows[0] || {};\n\nconst brief = rows.map(r => ({\n  title: r['Episode Title'],\n  minutes: r['Duration (min)'],\n  plays: r['Plays'],\n  retention: r['Audience Retention (%)'],\n  score: r['Performance Score'],\n  tier: r['Tier'],\n  change: r['Plays Change (%)'],\n}));\n\nreturn [{\n  json: {\n    podcastName: $('Set config').first().json.podcastName,\n    episodeCount: first._episodeCount || rows.length,\n    newThisWeek: first._newThisWeek || 0,\n    avgPlays: first._avgPlays || 0,\n    avgRetention: first._avgRetention || 0,\n    avgHours: first._avgHours || 0,\n    topFive: brief.slice(0, 5),\n    bottomFive: brief.slice(-5).reverse(),\n    analysisInput: JSON.stringify({\n      averages: { plays: first._avgPlays, retention: first._avgRetention },\n      episodes: brief.slice(0, 25),\n    }),\n  }\n}];\n"
      },
      "typeVersion": 2
    },
    {
      "id": "1091095f-1eb6-433c-979d-21eda84e2482",
      "name": "Find what is working",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "position": [
        6672,
        -256
      ],
      "parameters": {
        "text": "={{ $json.analysisInput }}",
        "options": {
          "systemMessage": "You analyse podcast episode performance data and tell the host what to do differently.\n\nYou are given the podcast's average plays and retention, then a list of episodes with their title, length in minutes, plays, retention percentage, performance score and week on week change.\n\nRules:\n- Look for patterns across titles, episode length and retention. Say which kinds of episodes keep people listening.\n- Judge every claim against the averages you were given, not against absolute numbers.\n- Retention matters more than plays. An episode with high plays and low retention is a title that oversold the content.\n- Be specific. Name the episodes you are drawing the pattern from.\n- If the data is too thin to support a pattern, say so instead of inventing one.\n- Suggest three concrete next episode ideas that follow the winning pattern."
        },
        "promptType": "define",
        "hasOutputParser": true
      },
      "typeVersion": 2
    },
