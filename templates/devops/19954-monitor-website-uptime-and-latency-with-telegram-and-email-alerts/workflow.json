    {
      "id": "8d96f522-4bd0-47c2-9ce2-2ae9346eabfd",
      "name": "Start Timer",
      "type": "n8n-nodes-base.code",
      "position": [
        2240,
        -120
      ],
      "parameters": {
        "jsCode": "return $input.all().map((item, index) => ({\n  json: {...item.json, request_started_ms: Date.now(), attempt_count: (item.json.attempt_count || 0) + 1},\n  pairedItem: {item: index}\n}));"
      },
      "notesInFlow": false,
      "typeVersion": 2
    },
    {
      "id": "dd308a00-d5ac-444a-afae-295614bbdf74",
      "name": "Check Website",
      "type": "n8n-nodes-base.httpRequest",
      "onError": "continueRegularOutput",
      "position": [
        2520,
        -120
      ],
      "parameters": {
        "url": "={{ $json.url }}",
        "options": {
          "timeout": "={{ $json.timeout_ms || 30000 }}",
          "response": {
            "response": {
              "neverError": true,
              "fullResponse": true,
              "responseFormat": "text"
            }
          }
        }
      },
      "notesInFlow": false,
      "typeVersion": 4.2
    },
    {
      "id": "626c0f1b-ade4-4e62-8732-13ce06fb520b",
      "name": "Evaluate Status",
      "type": "n8n-nodes-base.code",
      "position": [
        2800,
        -120
      ],
      "parameters": {
        "jsCode": "const source = $('Start Timer').all(0, $runIndex)[0].json;\nconst response = $input.first().json;\nconst statusCode = Number(response.statusCode ?? response.error?.statusCode ?? response.error?.httpCode ?? 0) || 0;\nconst responseMs = Math.max(0, Date.now() - source.request_started_ms);\nconst status = statusCode >= 200 && statusCode < 400\n  ? (responseMs > source.slow_threshold_ms ? 'SLOW' : 'UP') : 'DOWN';\nconst rawError = response.error;\nconst errorMessage = status === 'DOWN'\n  ? String(typeof rawError === 'string' ? rawError : rawError?.message || (statusCode ? `HTTP ${statusCode}` : 'Connection failed')).slice(0, 500)\n  : '';\nreturn [{json: {\n  ...source,\n  check_id: `${$execution.id}-${source.monitor_key}`,\n  status, status_code: statusCode, response_ms: responseMs,\n  checked_at: new Date().toISOString(), error_message: errorMessage,\n  retry_check: status === 'DOWN' && source.attempt_count < 3\n}, pairedItem: {item: 0}}];"
      },
      "notesInFlow": false,
      "typeVersion": 2
    },
    {
      "id": "9994fd9b-1d51-4d2e-bb89-cfc6916e822e",
      "name": "Get Previous State",
      "type": "n8n-nodes-base.dataTable",
      "position": [
        2240,
        400
      ],
      "parameters": {
        "operation": "get",
        "returnAll": true,
        "dataTableId": {
          "__rl": true,
          "mode": "name",
          "value": "uptime_state"
