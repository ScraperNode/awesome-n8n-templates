      "parameters": {
        "schemaType": "manual",
        "inputSchema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"pricing_flexibility_percentage\": {\n      \"type\": \"number\",\n      \"description\": \"The average percentage difference between initial quote and final price.\"\n    },\n    \"primary_concession_tendency\": {\n      \"type\": \"string\",\n      \"description\": \"What they usually give up when pressured (e.g., Net 60 terms, free shipping).\"\n    },\n    \"resistance_triggers\": {\n      \"type\": \"string\",\n      \"description\": \"What causes them to walk away or push back aggressively.\"\n    },\n    \"recommended_tactic\": {\n      \"type\": \"string\",\n      \"description\": \"A one-sentence recommendation for the buyer on how to handle them.\"\n    }\n  },\n  \"required\": [\n    \"pricing_flexibility_percentage\",\n    \"primary_concession_tendency\",\n    \"resistance_triggers\",\n    \"recommended_tactic\"\n  ]\n}"
      },
