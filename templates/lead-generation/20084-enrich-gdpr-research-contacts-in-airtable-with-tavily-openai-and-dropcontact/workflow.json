    {
      "id": "55f3429d-d697-4ee7-b49f-e72c2fb40e21",
      "name": "Filter Confident Results",
      "type": "n8n-nodes-base.code",
      "position": [
        1536,
        384
      ],
      "parameters": {
        "jsCode": "const items = $input.all();\nconst returnData = [];\n\nfor (const item of items) {\n  let results = item.json.results || [];\n  \n  // Filter for high quality\n  const goodResults = results.filter(result => result.score >= 0.7);\n\n  if (goodResults.length > 0) {\n    // SUCCESS: We found good data\n    item.json.results = goodResults;\n    item.json.found_data = true; // Flag for next IF node\n    returnData.push(item);\n  } else {\n    // FAILURE: No good data found\n    item.json.results = []; \n    item.json.found_data = false; // Flag for next IF node\n    returnData.push(item);\n  }\n}\n\nreturn returnData;"
      },
      "typeVersion": 2
    },
