    {
      "id": "f0104d79-dee2-4787-98c9-0cab9799c588",
      "name": "Prepare LLM Request",
      "type": "n8n-nodes-base.code",
      "position": [
        6320,
        1664
      ],
      "parameters": {
        "jsCode": "const s = $input.first().json;\nconst role = s.role || 'primary';\nconst provider = role === 'primary' ? s.primaryProvider : s.fallbackProvider;\nconst model = role === 'primary' ? s.primaryModel : s.fallbackModel;\n\nif (!s.prompt) {\n  throw new Error('No prompt received. Send a chat message, or pass \"prompt\" from the calling workflow.');\n}\nif (!['openai', 'anthropic'].includes(provider)) {\n  throw new Error(`Unsupported provider \"${provider}\". Use \"openai\" or \"anthropic\".`);\n}\n\nlet requestUrl;\nlet requestBody;\nif (provider === 'openai') {\n  const messages = [];\n  if (s.systemPrompt) messages.push({ role: 'system', content: s.systemPrompt });\n  messages.push({ role: 'user', content: s.prompt });\n  requestUrl = 'https://api.openai.com/v1/chat/completions';\n  requestBody = { model, messages, max_completion_tokens: s.maxOutputTokens };\n} else {\n  requestUrl = 'https://api.anthropic.com/v1/messages';\n  requestBody = { model, max_tokens: s.maxOutputTokens, messages: [{ role: 'user', content: s.prompt }] };\n  if (s.systemPrompt) requestBody.system = s.systemPrompt;\n}\n\n// Test mode: the .invalid domain never resolves, so the primary call fails like a real outage\nif (s.simulatePrimaryOutage && role === 'primary') {\n  requestUrl = 'https://simulated-outage.invalid/v1';\n}\n\nreturn [{\n  json: {\n    ...s,\n    role,\n    provider,\n    model,\n    attempt: s.attempt || 1,\n    history: s.history || [],\n    inputTokens: s.inputTokens || 0,\n    outputTokens: s.outputTokens || 0,\n    costUsd: s.costUsd || 0,\n    lastError: s.lastError || '',\n    requestUrl,\n    requestBody,\n    attemptStartedAt: Date.now(),\n  },\n}];\n"
      },
      "typeVersion": 2
    },
