    {
      "id": "e6452263-050a-5659-9825-e99dfcdc6bb9",
      "name": "Download heatmap image",
      "type": "n8n-nodes-base.httpRequest",
      "maxTries": 3,
      "position": [
        1880,
        300
      ],
      "parameters": {
        "url": "=https://api.geogridapi.io/v1/grids/{{ $json.id }}/image?lang=en",
        "method": "GET",
        "options": {
          "response": {
            "response": {
              "responseFormat": "file",
              "outputPropertyName": "data"
            }
          }
        },
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth"
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "geogridapi-key",
