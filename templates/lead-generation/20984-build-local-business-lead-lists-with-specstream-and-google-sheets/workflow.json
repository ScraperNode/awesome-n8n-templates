          }
        },
        "formTitle": "Build a local business lead list",
        "formFields": {
          "values": [
            {
              "fieldLabel": "Business type",
              "placeholder": "HVAC companies",
              "requiredField": true
            },
            {
              "fieldLabel": "City",
              "placeholder": "Columbus, Ohio",
              "requiredField": true
            },
            {
              "fieldLabel": "Anything else every business must meet (optional)",
              "placeholder": "rated 4.5 or better with fewer than 20 Google reviews"
