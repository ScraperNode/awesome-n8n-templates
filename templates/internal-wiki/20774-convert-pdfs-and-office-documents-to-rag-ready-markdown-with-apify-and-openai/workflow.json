              "type": "number",
              "value": 150
            }
          ]
        }
      },
      "typeVersion": 3.4
    },
    {
      "id": "92fb0a59-1144-4f36-9e5c-cd36a0d84cac",
      "name": "Convert to Markdown",
      "type": "n8n-nodes-base.httpRequest",
      "position": [
        440,
        0
      ],
      "parameters": {
        "url": "https://api.apify.com/v2/acts/saliga~document-to-markdown/run-sync-get-dataset-items",
        "method": "POST",
        "options": {
          "timeout": 310000
        },
        "jsonBody": "={{ JSON.stringify({ urls: $json.fileUrls, chunkSize: $json.chunkSize, chunkOverlap: $json.chunkOverlap, extractTables: true, ocr: 'auto' }) }}",
        "sendBody": true,
        "specifyBody": "json",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth"
      },
      "typeVersion": 4.2
    },
    {
      "id": "df9ad53e-55d6-4143-ae1d-a30ffab54778",
      "name": "One item per chunk",
      "type": "n8n-nodes-base.code",
      "position": [
        660,
        0
      ],
      "parameters": {
        "jsCode": "// One item per chunk, with the metadata the agent cites. Files that failed are listed in the run log and skipped.\nconst out = [];\nfor (const doc of $input.all()) {\n  if (doc.json.error) { console.log(`Skipped ${doc.json.url}: ${doc.json.error}`); continue; }\n  const title = doc.json.title || doc.json.fileName || doc.json.url;\n  for (const c of doc.json.chunks ?? []) {\n    out.push({ json: { text: c.text, source: doc.json.url, title, page: c.pageStart ?? '', heading: c.heading ?? '' } });\n  }\n}\nreturn out;"
      },
      "typeVersion": 2
    },
    {
