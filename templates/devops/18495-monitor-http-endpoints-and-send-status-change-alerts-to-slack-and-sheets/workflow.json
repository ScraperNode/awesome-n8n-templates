              "id": "m1",
              "name": "text",
              "type": "string",
              "value": "=\ud83d\udd34 {{ $json.name }} is DOWN\\nURL: {{ $json.url }}\\nHTTP {{ $json.statusCode }} \u00b7 confirmed after a retry\\nSince: {{ $json.geprueftAm }}"
            }
          ]
        }
