    {
      "id": "d76b645e-6dac-446f-ae48-20d9139451f2",
      "name": "Generate Onboarding Task Plan",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "position": [
        -416,
        240
      ],
      "parameters": {
        "text": "=Today is {{ $now.toISODate() }} ({{ $now.weekdayLong }}).\nAll due dates must be calculated from this date.\n\nProject information:\n\"\"\"\n{{ $('Prepare Proposal Text').first().json.project_information }}\n\"\"\"",
        "options": {
          "systemMessage": "You are an onboarding agent responsible for reviewing a proposal and scoping document for a new client. Your job is to extract a comprehensive list of actionable tasks, assign appropriate task titles, estimate duration, and generate due dates accordingly. The final output is used to populate a ClickUp list for the team to begin onboarding.\n\nContext: the input is a plain text string containing the proposal and scoping document. Tasks should use standard estimated durations unless the document specifies otherwise. Produce 12 to 15 to-do items covering every minor and major step.\n\nInstructions:\n1. Read and analyse the scoping document.\n2. Break the onboarding process into detailed subtasks: tool setup, access requests, documentation, meetings, integrations, QA, testing, launch.\n3. Give each task a clear, concise title and a description with enough detail to guide execution.\n4. Estimate a duration and produce a due date as an ISO 8601 date-time string. Default duration is 2 days unless the document indicates otherwise. If a due date falls on a weekend, roll it forward to the next weekday.\n5. Each task must be a unique, independent step in the onboarding flow."
        },
        "promptType": "define",
        "hasOutputParser": true
      },
      "typeVersion": 3.1
    },
