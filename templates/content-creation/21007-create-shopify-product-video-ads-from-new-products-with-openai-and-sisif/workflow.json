        "method": "POST",
        "options": {},
        "jsonBody": "={{ JSON.stringify({ query: 'mutation productUpdate($product: ProductUpdateInput!, $media: [CreateMediaInput!]) { productUpdate(product: $product, media: $media) { product { id media(first: 1, sortKey: POSITION, reverse: true) { nodes { id status mediaContentType } } } userErrors { field message } } }', variables: { product: { id: $('Extract Product Data').item.json.product_gid }, media: [{ originalSource: $('Prepare Staged Upload').item.json.resource_url, mediaContentType: 'VIDEO', alt: $('Extract Product Data').item.json.title + ' product video' }] } }) }}",
