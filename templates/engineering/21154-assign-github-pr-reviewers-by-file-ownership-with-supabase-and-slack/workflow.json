    {
      "id": "3c2e1928-31af-4b7e-9a03-d98971e95835",
      "name": "Identify File Owners",
      "type": "n8n-nodes-base.code",
      "position": [
        1952,
        288
      ],
      "parameters": {
        "jsCode": "const config = $('Set GitHub PR Variables').first().json;\nconst changedFiles = $('Fetch PR Changed Files').all().map(i => i.json.filename);\nconst roster = $('Retrieve Reviewer List').all().map(i => i.json);\nconst prAuthor = config.pr_author;\nconst maxReviewers = Number(config.max_reviewers);\n\nconst reviewerScores = {};\n\nfor (const reviewer of roster) {\n  if (reviewer.github_username === prAuthor) continue;\n\n  const ownedPaths = (reviewer.owned_paths || '').split(',').map(p => p.trim()).filter(Boolean);\n  const matches = changedFiles.filter(f => ownedPaths.some(p => f.startsWith(p)));\n\n  if (matches.length > 0) {\n    if (!reviewerScores[reviewer.github_username]) {\n      reviewerScores[reviewer.github_username] = {\n        github_username: reviewer.github_username,\n        slack_user_id: reviewer.slack_user_id,\n        supabase_id: reviewer.id,\n        matched_files: matches.length,\n        last_assigned_at: reviewer.last_assigned_at || '1970-01-01T00:00:00Z'\n      };\n    }\n  }\n}\n\nconst candidates = Object.values(reviewerScores);\ncandidates.sort((a, b) => new Date(a.last_assigned_at) - new Date(b.last_assigned_at));\nconst selected = candidates.slice(0, maxReviewers);\n\nif (selected.length === 0) {\n  return [{ json: { no_reviewers_found: true, github_usernames: [], selected_reviewers: [] } }];\n}\n\nreturn [{\n  json: {\n    no_reviewers_found: false,\n    github_usernames: selected.map(r => r.github_username),\n    selected_reviewers: selected\n  }\n}];"
      },
      "typeVersion": 2
    },
