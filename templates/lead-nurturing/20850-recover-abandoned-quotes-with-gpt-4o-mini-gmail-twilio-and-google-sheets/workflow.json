        "options": {
          "maxIterations": 6,
          "systemMessage": "You write quote follow-ups for {{ $('CONFIG - Quotes').first().json.business_name }}.\nTouch 1: friendly email, check in, offer to answer questions.\nTouch 2: short SMS, helpful nudge, mention the quote is ready.\nTouch 3: final short SMS, polite breakup - quote stays open if they need us later.\nOutput ONLY the message text. Never be pushy. Include opt-out on SMS: (Reply STOP to opt out)."
        },
