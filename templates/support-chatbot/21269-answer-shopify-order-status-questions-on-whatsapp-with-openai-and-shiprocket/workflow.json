    {
      "id": "b421d25c-c6ea-48a2-bbc8-cb55ced41a86",
      "name": "return_policy",
      "type": "@n8n/n8n-nodes-langchain.toolCode",
      "position": [
        4352,
        368
      ],
      "parameters": {
        "name": "return_policy",
        "jsCode": "return `RETURNS: within 7 days of delivery for unused items with tags. Damaged/wrong items: report within 3 days with photos (free pickup, full refund or exchange). Size exchange: free. Change of mind: store credit or exchange; refunds carry a \u20b999 pickup fee. Non-returnable: final sale, innerwear, personal care. Refunds: 5\u20137 working days after QC to the original payment method; COD refunds via UPI/bank. Start a return: https://REPLACE-STORE/pages/returns`;",
        "description": "Returns the store's official return, exchange and refund policy text."
      },
      "typeVersion": 1.1
    },
    {
      "id": "fd2af746-cb7e-41e0-9f72-93d5915fae0e",
      "name": "Parse Reply Schema",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "position": [
        4560,
        368
      ],
      "parameters": {
        "jsonSchemaExample": "{\n  \"reply\": \"Your order #1042 (Blue Denim Jacket) was shipped with Delhivery (AWB 1234567890). It's out for delivery today \ud83d\ude9a Track: https://shiprocket.co/tracking/1234567890\",\n  \"intent\": \"order_status\",\n  \"order_number\": \"1042\",\n  \"answered_from_data\": true,\n  \"needs_human\": false,\n  \"handoff_reason\": \"\",\n  \"sentiment\": \"neutral\"\n}"
      },
      "typeVersion": 1.2
    },
    {
      "id": "4bf66f06-c2f2-47c0-8b2f-a0c7c3a84810",
      "name": "Guardrails & Fallback",
      "type": "n8n-nodes-base.code",
      "position": [
        4976,
        112
      ],
      "parameters": {
        "jsCode": "const m = $('Decide Bot or Human').first().json;\nconst r = $input.first().json || {};\nlet o = r.output || {};\nif (typeof o === 'string') { try { o = JSON.parse(o); } catch (e) { o = { reply: o }; } }\nconst agentFailed = !!r.error || !o.reply;\nconst wantsHuman = /\\b(human|agent|person|call me|manager|executive|baat karni)\\b/i.test(m.text);\nlet needs = agentFailed || o.needs_human === true || wantsHuman || (o.answered_from_data === false && m.fails >= 1);\nlet reply = agentFailed ? \"Sorry, I'm having trouble fetching your order right now.\" : o.reply;\n// leak guard: never show another order's details if the agent flagged a mismatch\nif (/does not match|doesn't match|verify.*email/i.test(reply)) { reply = reply.replace(/AWB\\s*\\w+/gi, 'AWB \u2022\u2022\u2022\u2022'); }\nif (needs) reply = `${reply ? reply + '\\n\\n' : ''}I've connected you to our support team \ud83d\ude4b. Someone will reply here shortly (10 AM\u20137 PM).`;\nconst hex = n => Array.from({ length: n }, () => Math.floor(Math.random() * 16).toString(16)).join('');\nreturn [{ json: { ...m, reply: reply.slice(0, 1500), intent: o.intent || 'unknown', order_number: o.order_number || m.last_order || '',\n  answered: o.answered_from_data !== false && !agentFailed, needs_human: needs,\n  handoff_reason: o.handoff_reason || (wantsHuman ? 'customer asked for a human' : agentFailed ? 'agent error' : needs ? 'could not answer' : ''),\n  sentiment: o.sentiment || 'neutral', resume_token: hex(16) } }];"
      },
      "typeVersion": 2
    },
    {
