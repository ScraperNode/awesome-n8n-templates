    {
      "id": "8c9025c2-2b8d-482f-9820-f6bff21e48c4",
      "name": "Normalize AI Risk Alert",
      "type": "n8n-nodes-base.code",
      "position": [
        3840,
        368
      ],
      "parameters": {
        "jsCode": "const input = $input.first().json;\n\nconst content =\n  input.message?.content ||\n  input.content ||\n  input.text ||\n  '';\n\nif (!content || typeof content !== 'string') {\n  throw new Error('AI response content is missing or is not a string');\n}\n\nfunction extract(pattern, fallback = '') {\n  const match = content.match(pattern);\n  return match ? match[1].trim() : fallback;\n}\n\nfunction extractNumber(pattern, fallback = null) {\n  const value = extract(pattern, '');\n  if (value === '') {\n    return fallback;\n  }\n\n  const number = Number(value.replace(/[$,%]/g, '').replace(/,/g, ''));\n  return Number.isFinite(number) ? number : fallback;\n}\n\nconst protocol = extract(/Protocol:\\s*(.+)/i);\nconst collateralAsset = extract(/Collateral Asset:\\s*(.+)/i);\nconst collateralAmount = extractNumber(/Collateral Amount:\\s*([\\d,.]+)\\s*ETH/i);\nconst currentPrice = extractNumber(/Current Price:\\s*\\$([\\d,.]+)/i);\nconst collateralValue = extractNumber(/Collateral Value:\\s*\\$([\\d,.]+)/i);\n\nconst debtAsset = extract(/Debt Asset:\\s*(.+)/i);\nconst debtAmount = extractNumber(/Debt Amount:\\s*\\$([\\d,.]+)/i);\nconst debtValue = extractNumber(/Debt Value:\\s*\\$([\\d,.]+)/i);\n\nconst healthFactor = extractNumber(/Health Factor:\\s*([\\d.]+)/i);\nconst liquidationPrice = extractNumber(/Liquidation Price:\\s*\\$([\\d,.]+)/i);\n\nconst liquidationDistanceMatch = content.match(\n  /Distance to Liquidation:\\s*\\$([\\d,.]+)\\s*USD\\s*\\(([\\d.]+)%\\)/i\n);\n\nconst distanceToLiquidationUsd = liquidationDistanceMatch\n  ? Number(liquidationDistanceMatch[1].replace(/,/g, ''))\n  : null;\n\nconst distanceToLiquidationPercent = liquidationDistanceMatch\n  ? Number(liquidationDistanceMatch[2])\n  : null;\n\nconst riskMatch = content.match(\n  /Risk Level:\\s*([A-Z_]+)(?:\\s*\\(([^)]+)\\))?/i\n);\n\nconst riskLevel = riskMatch\n  ? riskMatch[1].toUpperCase()\n  : '';\n\nconst riskContext = riskMatch?.[2]\n  ? riskMatch[2].trim()\n  : '';\n\nconst positionId = extract(/Position ID:\\s*(.+)/i);\n\nconst lines = content.split('\\n').map(line => line.trim());\n\nconst actionMessageIndex = lines.findIndex(line =>\n  /Please verify your position directly/i.test(line)\n);\n\nconst aiRiskSummary =\n  actionMessageIndex >= 0\n    ? lines\n        .slice(actionMessageIndex)\n        .join(' ')\n        .trim()\n    : content;\n\nreturn [\n  {\n    json: {\n      ai_normalized: true,\n      ai_generated_at: new Date().toISOString(),\n\n      protocol,\n      collateral_asset: collateralAsset,\n      collateral_amount: collateralAmount,\n\n      current_price_usd: currentPrice,\n      collateral_value_usd: collateralValue,\n\n      debt_asset: debtAsset,\n      debt_amount_usd: debtAmount,\n      debt_value_usd: debtValue,\n\n      health_factor: healthFactor,\n      liquidation_price_usd: liquidationPrice,\n\n      distance_to_liquidation_usd: distanceToLiquidationUsd,\n      distance_to_liquidation_percent: distanceToLiquidationPercent,\n\n      risk_level: riskLevel,\n      risk_context: riskContext,\n\n      position_id: positionId,\n\n      ai_risk_summary: aiRiskSummary,\n\n      ai_raw_message: content\n    }\n  }\n];"
      },
      "typeVersion": 2
    }
  ],
