    {
      "id": "0e886cb2-2af2-4112-8815-8f5be76b2735",
      "name": "Generate report",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "position": [
        2620,
        560
      ],
      "parameters": {
        "text": "=Your data:\nHunter io results:'{{ $json['Hunter info'] }}',\nPeprlexit search results:'{{ $json['Perplexity Info '] }}',\nLinkedin company description:'{{ $json['LinkedIn company description'] }}',\nLinkedin company tagline:'{{ $json['LinkedIn company tagline'] }}',\nLinkedin compan industr:'{{ $json['LinkedIn company industry'] }}',\nLinkedin company specialites:'{{ $json['LinkedIn company specialities'] }}'.\nLinekdin company silillar ogranization:'{{ $json['LinkedIn company similarOrganizations'] }}',\nWebsite scraper results:'{{ $json.text }}'.\n\n",
        "messages": {
          "messageValues": [
            {
              "message": "=You are a professional B2B research analyst. Your task is to generate a comprehensive,summary and opinion of a prospect based on the user\u2019s prompt and provided data.\n\nYour output must include a full analysis of both the individual and the company.\n\nUse a clear, formal tone. The output will be used for lead qualification, outreach preparation, or client profiling \u2014 it must be accurate, concise, and actionable.\n\nYou will receive a user prompt with variables such as first name, last name, headline, email, job title, top skills, experiences, LinkedIn summaries, company details, and AI research.\n\nYour response must:\n\nBe structured and easy to scan\n\nStart with a summary of the individual (name, role, headline, etc.)\n\nFollow with an overview of their skills and experience\n\nThen analyze the company (description, industry, tagline, specialties, similar companies)\n\nEnd with insights extracted from the AI research field\n\nMention No relevant data for missing or empty fields\n\nNever include the field label if it was not present\n\nNever hallucinate or generate fictional details\n\nKeep it objective, professional, and formatted for B2B use."
            }
          ]
        },
        "promptType": "define"
      },
      "typeVersion": 1.6
    },
