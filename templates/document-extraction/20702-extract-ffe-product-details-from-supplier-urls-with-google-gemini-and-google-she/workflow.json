      "parameters": {
        "text": "={{ $json.pageText }}",
        "options": {},
        "attributes": {
          "attributes": [
            {
              "name": "sku",
              "description": "Manufacturer model number, SKU, item number, or product code for this specific product. If not stated, return an empty string. Never return null, an array, or an object."
            },
            {
              "name": "finishColour",
              "description": "Finish, colour, material finish, or manufacturer colour name for this specific product. If not stated, return an empty string. Never return null, an array, or an object."
            },
            {
              "name": "supplier",
              "description": "Manufacturer, brand, or supplier name for this specific product. If not stated, return an empty string. Never return null, an array, or an object."
            },
            {
              "name": "vendorDescription",
              "description": "A concise factual description of this specific product based only on the supplied webpage text. Return a single plain-text string. If no useful description is available, return an empty string."
            },
            {
              "name": "notes",
              "description": "Important specifications or features for this specific product that would be useful in an FF&E schedule. Return one plain-text string. If none are stated, return an empty string. Never return null, an array, or an object."
            }
          ]
        }
      },
      "retryOnFail": true,
      "typeVersion": 1.2,
      "waitBetweenTries": 1000
    },
