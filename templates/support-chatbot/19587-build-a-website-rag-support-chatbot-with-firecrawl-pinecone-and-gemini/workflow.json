    {
      "id": "30c9cc6a-3592-4ae2-9de6-e80701e79d11",
      "name": "Clean HTML to Text",
      "type": "n8n-nodes-base.code",
      "position": [
        3936,
        816
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const html = $json.html || '';\n\nconst text = html\n  .replace(/<script[\\s\\S]*?<\\/script>/gi, '')\n  .replace(/<style[\\s\\S]*?<\\/style>/gi, '')\n  .replace(/<[^>]+>/g, ' ')\n  .replace(/\\s+/g, ' ')\n  // Strip any lone/broken surrogate pairs (invalid unicode) from bad encoding\n  .replace(/[\\uD800-\\uDFFF]/g, '')\n  .trim();\n\nreturn {\n  url: $json.url,\n  text\n};\n"
      },
      "typeVersion": 2
    },
    {
      "id": "e80bab26-a4ff-490d-8f6b-136029eb20f3",
      "name": "Check Text Length",
      "type": "n8n-nodes-base.if",
      "position": [
        4128,
        816
      ],
      "parameters": {
        "options": {},
        "conditions": {
          "options": {
            "version": 2,
            "leftValue": "",
            "caseSensitive": true,
            "typeValidation": "loose"
          },
          "combinator": "and",
          "conditions": [
            {
              "id": "aa3e5022-2d6d-43f6-bf87-9de112a3345f",
              "operator": {
                "type": "number",
                "operation": "gt"
              },
              "leftValue": "={{ ($json.text || '').length }}",
              "rightValue": 50
            }
          ]
        },
        "looseTypeValidation": true
      },
      "typeVersion": 2.2
    },
    {
      "id": "58152ad8-ab8f-4156-9fc9-a939d953d556",
      "name": "Split Text into Chunks",
      "type": "n8n-nodes-base.code",
      "position": [
        4384,
        800
      ],
      "parameters": {
        "jsCode": "const raw = $json.text || \"\";\nconst text = raw.replace(/\\s+/g, \" \").trim();\nconst chunkSize = 1000;\nconst overlap = 200;\n\n// Split by Unicode code points so we never cut an emoji or special character in half\nconst codePoints = Array.from(text);\n\nconst chunks = [];\nlet i = 0;\n\nwhile (i < codePoints.length) {\n  const chunk = codePoints.slice(i, i + chunkSize).join(\"\").trim();\n\n  if (chunk.length > 50) {\n    chunks.push({\n      content: chunk,\n      url: $json.url\n    });\n  }\n\n  i += chunkSize - overlap;\n}\n\nreturn chunks;\n"
      },
      "typeVersion": 2
    },
