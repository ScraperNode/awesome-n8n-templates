      "id": "e8f912ca-234d-4591-a45d-65d43c76e073",
      "name": "Write the fix in the row",
      "type": "n8n-nodes-base.googleSheets",
      "position": [
        2100,
        672
      ],
      "parameters": {
        "columns": {
          "value": {
            "note": "={{ (() => { const out = []; const why = (n) => { const j = n.json.error; return (j && j.message) || j || 'no file came back'; }; const img = $('Nano Banana UGC photo').first(); if (!img.binary || !img.binary.data) out.push('Nano Banana did not edit the photo: ' + why(img)); const vid = $('Veo 3.1 UGC clip').first(); if (!vid.binary || !vid.binary.data) out.push('Veo did not render the clip: ' + why(vid)); return out.concat([].concat($('Post the UGC photo').all().map(i => i.json.platform ? i.json : { platform: 'photo post', ok: false, error: (i.json.error && i.json.error.message) || i.json.error || 'no result' }), ($('Collect the results').first().json.results || []).map(r => r.platform ? r : { platform: 'video post', ok: false, error: (r.error && r.error.message) || r.error || 'no result' })).filter(r => r.ok !== true && !(r.platform.endsWith(' post') && String(r.error).includes('binary file'))).map(r => r.platform + ': ' + r.error + (r.hint || r.description ? ' ' + (r.hint || r.description) : ''))).join(' | '); })() }}",
