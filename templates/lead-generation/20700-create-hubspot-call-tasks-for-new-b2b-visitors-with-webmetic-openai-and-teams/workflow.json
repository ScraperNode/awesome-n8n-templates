            "typeValidation": "strict"
          },
          "combinator": "and",
          "conditions": [
            {
              "id": "4cea72d5-083b-5a51-b4b9-6eae24b1017e",
              "operator": {
                "type": "number",
                "operation": "gt"
              },
              "leftValue": "={{ Number($json.results[0]?.properties?.hs_num_open_deals || 0) }}",
              "rightValue": 0
            }
          ]
        }
      },
      "typeVersion": 2.3
    },
    {
      "id": "47922ba2-b446-4ee6-b21a-69f8ad13b38a",
      "name": "Post to HubSpot Deal Search",
      "type": "n8n-nodes-base.httpRequest",
      "position": [
        2176,
        160
      ],
      "parameters": {
        "url": "https://api.hubapi.com/crm/v3/objects/deals/search",
        "method": "POST",
        "options": {},
        "jsonBody": "={\n  \"filterGroups\": [{ \"filters\": [\n    { \"propertyName\": \"associations.company\", \"operator\": \"EQ\", \"value\": \"{{ $json.results[0].id }}\" },\n    { \"propertyName\": \"hs_is_closed\", \"operator\": \"EQ\", \"value\": \"false\" }\n  ] }],\n  \"properties\": [\"dealname\", \"dealstage\", \"amount\", \"hubspot_owner_id\"],\n  \"sorts\": [{ \"propertyName\": \"hs_lastmodifieddate\", \"direction\": \"DESCENDING\" }],\n  \"limit\": 1\n}",
        "sendBody": true,
        "specifyBody": "json",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "hubspotAppToken"
      },
      "typeVersion": 4.4
    },
    {
      "id": "96da45ee-385e-4482-8442-e761f189071a",
      "name": "Add Task to HubSpot Deal",
      "type": "n8n-nodes-base.hubspot",
      "position": [
        2400,
        160
      ],
      "parameters": {
        "type": "task",
        "dueDate": "={{ $now.toISO() }}",
        "metadata": {
          "body": "=<p>{{ $('Fetch Webmetic Visits').item.json.company_name }} visited your website. A good moment to get in touch.</p><p>Pages read: {{ ($('Fetch Webmetic Visits').item.json.sessions || []).flatMap(s => s.user_data || []).map(p => p.document_title + ' (' + Math.round(p.time_spent || 0) + 's)').join(' -> ') || 'unknown' }}</p>",
          "status": "NOT_STARTED",
          "subject": "={{ $('Fetch Webmetic Visits').item.json.company_name }} is on your website"
        },
        "resource": "engagement",
        "authentication": "appToken",
        "additionalFields": {
          "associations": {
            "dealIds": "={{ $('Post to HubSpot Deal Search').item.json.results[0].id }}",
            "ownerId": "={{ Number($('Post to HubSpot Deal Search').item.json.results[0].properties.hubspot_owner_id) }}",
            "companyIds": "={{ $('Post to HubSpot Company Search').item.json.results[0].id }}"
          }
        }
      },
      "typeVersion": 2.2
    },
    {
      "id": "a7e2404a-9162-4623-b31d-729a2fb18066",
      "name": "Find Contacts via Webmetic",
      "type": "n8n-nodes-webmetic.webmetic",
      "position": [
        2176,
        512
      ],
      "parameters": {
        "reveal": "both",
        "resource": "contact",
        "companyId": "={{ $('Fetch Webmetic Visits').item.json.company_id }}",
        "requestOptions": {}
      },
      "typeVersion": 2
    },
    {
      "id": "4aa83388-1ac6-4381-a105-579098a9c8c6",
      "name": "Call Script Agent",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "position": [
        2400,
        512
      ],
      "parameters": {
        "text": "=You are an experienced B2B sales coach. Write a short phone call script for our sales rep.\n\nIMPORTANT: Never mention that we know this person or their company visited our website.\n\nOUR COMPANY\n- Name: {{ $('Set Lead Criteria').item.json.yourCompany }}\n- What we sell: {{ $('Set Lead Criteria').item.json.whatYouSell }}\n\nTARGET COMPANY\n- Company: {{ $('Fetch Webmetic Visits').item.json.company_name }}\n- What they do: {{ $('Fetch Webmetic Visits').item.json.short_description_en || 'unknown' }}\n- Size: {{ $('Fetch Webmetic Visits').item.json.employee_count ? $('Fetch Webmetic Visits').item.json.employee_count.join('-') + ' employees' : 'unknown' }}\n- Location: {{ $('Fetch Webmetic Visits').item.json.city || 'unknown' }}\n\nCONTACT PERSON\n- Name: {{ $json.name }}\n- Position: {{ $json.job_title }}\n\nWEBSITE BEHAVIOUR (for your understanding only, never mention it in the call)\n- Pages read: {{ ($('Fetch Webmetic Visits').item.json.sessions || []).flatMap(s => s.user_data || []).map(p => p.document_title + ' (' + Math.round(p.time_spent || 0) + 's)').join(' -> ') || 'unknown' }}\n\nWRITE\n1. Opener (2 sentences)\n2. Three qualifying questions\n3. Pitch (3 sentences)\n4. Top 3 objections with short answers\n5. Close: ask for a 15-minute meeting\n6. Voicemail (2 sentences)\n\nRULES: Write in {{ $('Set Lead Criteria').item.json.scriptLanguage }}. Maximum 300 words, no filler. Output simple HTML using only h3, p, ul and li.",
        "options": {},
        "promptType": "define"
      },
      "typeVersion": 3.1
    },
    {
      "id": "9e99c11e-090b-4ba7-bd66-fabfbf6733d4",
      "name": "OpenAI Chat GPT-5",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "position": [
        2448,
        784
      ],
      "parameters": {
        "model": {
