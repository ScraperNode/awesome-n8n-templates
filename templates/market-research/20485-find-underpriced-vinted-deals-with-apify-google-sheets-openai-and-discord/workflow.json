    {
      "id": "code-median-score",
      "name": "Compute median & deal score",
      "type": "n8n-nodes-base.code",
      "position": [
        2400,
        200
      ],
      "parameters": {
        "jsCode": "const current = $('Log price to history').item.json;\nconst cutoff = DateTime.now().minus({ days: 14 });\n\nconst historyRows = $('Read 14-day price history').all().map(i => i.json)\n  .filter(r => r.searchLabel === current.searchLabel\n    && r.checkedAt\n    && DateTime.fromISO(r.checkedAt).isValid\n    && DateTime.fromISO(r.checkedAt) >= cutoff);\n\nconst prices = historyRows.map(r => Number(r.priceEur)).filter(n => !isNaN(n)).sort((a, b) => a - b);\nconst medianPriceEur = prices.length\n  ? (prices.length % 2 ? prices[(prices.length - 1) / 2]\n      : (prices[prices.length / 2 - 1] + prices[prices.length / 2]) / 2)\n  : Number(current.priceEur);\n\nconst priceEur = Number(current.priceEur) || 0;\nconst pctBelowMedian = medianPriceEur ? Math.round((1 - priceEur / medianPriceEur) * 100) : 0;\n\nconst conditionWeight = {\n  new_with_tags: 10, new: 8, like_new: 6, good: 3, fair: 0, unknown: 0\n}[current.conditionBucket] || 0;\n\nconst sellerWeight = current.sellerRating ? Math.round((Number(current.sellerRating) - 3) * 5) : 0;\n\nconst dealScorePct = pctBelowMedian + conditionWeight + sellerWeight;\n\nreturn {\n  json: {\n    ...current,\n    medianPriceEur: Math.round(medianPriceEur * 100) / 100,\n    pctBelowMedian,\n    dealScorePct,\n    historyCount: prices.length\n  }\n};"
      },
      "typeVersion": 2
    },
