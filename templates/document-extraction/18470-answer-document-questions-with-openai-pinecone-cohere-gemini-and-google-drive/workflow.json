        "responseBody": "={{ JSON.stringify({ answered: false, question: $('Capture Request').first().json.question, sessionId: $('Capture Request').first().json.sessionId, confidence: $json.output.confidence, message: 'The indexed documents do not contain a passage that answers this question directly. Try naming the document or the clause you have in mind.', citations: [], cached: false, latencyMs: $now.toMillis() - $('Capture Request').first().json.startedAt }) }}"
      },
