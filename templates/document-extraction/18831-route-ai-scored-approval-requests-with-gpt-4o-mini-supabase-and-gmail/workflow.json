    {
      "id": "43aa2bcd-2847-46f8-a943-80db5bc2b9ce",
      "name": "Analyze Risk & Priority",
      "type": "@n8n/n8n-nodes-langchain.openAi",
      "position": [
        1264,
        336
      ],
      "parameters": {
        "modelId": {
          "__rl": true,
          "mode": "list",
          "value": "gpt-4o-mini",
          "cachedResultName": "GPT-4O-MINI"
        },
        "options": {},
        "responses": {
          "values": [
            {
              "content": "=You are an enterprise approval assistant.\n\nAnalyze the approval request below and return valid JSON only.\n\nRequest Type: {{ $json.request_type }}\nTitle: {{ $json.request_title }}\nAmount: {{ $json.amount }}\nDepartment: {{ $json.department }}\nJustification: {{ $json.justification }}\n\nRules:\n- Higher amount = higher risk\n- Vague justification = higher risk\n- Sensitive requests = higher priority\n\nReturn this JSON only:\n{\n  \"summary\": \"short summary in 1-2 lines\",\n  \"risk_score\": 1,\n  \"priority\": \"low\",\n  \"suggested_level\": \"manager\",\n  \"reasoning\": \"short reason\",\n  \"amount\": 123\n}"
            }
          ]
        },
        "builtInTools": {}
      },
      "credentials": {
        "openAiApi": {
          "id": "yOfw9W9XwQefVROR",
          "name": "OpenAI (PAID) (AI-ML Team)"
        }
      },
      "typeVersion": 2.1
    },
