    {
      "id": "c841e4bc-3e89-5c35-8125-0018a2d39c5b",
      "name": "Verify Twilio signature",
      "type": "n8n-nodes-base.code",
      "position": [
        360,
        300
      ],
      "parameters": {
        "jsCode": "// Optional security check: only accept requests that really come from Twilio.\n// Leave twilio_auth_token blank in Settings to skip the check.\nconst crypto = require('crypto');\n\nconst settings = $('Settings').first().json;\nconst request = $('WhatsApp message received').first().json;\nconst token = String(settings.twilio_auth_token || '').trim();\n\nif (!token) {\n  return [{ json: { signature_valid: true, signature_check: 'off' } }];\n}\n\n// Twilio signs the exact URL it calls plus every POST field, sorted by name.\nconst headers = request.headers || {};\nconst url = String(settings.public_webhook_url || '').trim()\n  || `https://${headers['x-forwarded-host'] || headers.host}/webhook/whatsapp-order-desk`;\nconst body = request.body || {};\nconst payload = url + Object.keys(body).sort().map((key) => key + body[key]).join('');\nconst expected = crypto.createHmac('sha1', token).update(Buffer.from(payload, 'utf-8')).digest('base64');\nconst received = String(headers['x-twilio-signature'] || '');\n\nconst valid = received.length === expected.length\n  && crypto.timingSafeEqual(Buffer.from(received), Buffer.from(expected));\n\nreturn [{ json: { signature_valid: valid, signature_check: valid ? 'passed' : 'failed' } }];\n"
      },
      "typeVersion": 2
    },
