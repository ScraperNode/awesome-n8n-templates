    {
      "id": "79e85336-5a9f-4646-a03d-7c5f88d90c38",
      "name": "Build Slots",
      "type": "n8n-nodes-base.code",
      "position": [
        176,
        240
      ],
      "parameters": {
        "jsCode": "const p = $('Parse Vapi').first().json;\nconst date = p.args.date;\n// CHANGE ME: clinic hours (24h), slot length in minutes. Closed on Sundays.\n// Times use the workflow timezone (Workflow Settings > Timezone).\nconst OPEN = 9, CLOSE = 17, SLOT = 30;\nconst [y, mo, d] = String(date).split('-').map(Number);\nconst at = (h, mi) => $now.set({ year: y, month: mo, day: d, hour: h, minute: mi, second: 0, millisecond: 0 });\nif (!y || !mo || !d) return [{ json: { toolCallId: p.toolCallId, result: 'Invalid date. Please ask the caller for the date again (format YYYY-MM-DD).' } }];\nif (at(12, 0).weekday === 7) return [{ json: { toolCallId: p.toolCallId, result: 'The clinic is closed on Sundays. Offer another day.' } }];\nconst busy = $input.all().map(i => i.json).filter(e => e.start).map(e => [\n  new Date(e.start.dateTime || e.start.date).getTime(),\n  new Date(e.end.dateTime || e.end.date).getTime()\n]);\nconst free = [];\nfor (let m = OPEN * 60; m + SLOT <= CLOSE * 60; m += SLOT) {\n  const hh = Math.floor(m / 60);\n  const mm = m % 60;\n  const st = at(hh, mm).toMillis();\n  const en = st + SLOT * 60000;\n  if (st < Date.now()) continue;\n  if (busy.some(b => st < b[1] && en > b[0])) continue;\n  free.push(String(hh).padStart(2, '0') + ':' + String(mm).padStart(2, '0'));\n}\nconst result = free.length\n  ? `Free slots on ${date} (24h, clinic local time): ${free.slice(0, 8).join(', ')}. Offer 2-3 of these to the caller.`\n  : `No free slots on ${date}. Offer another date.`;\nreturn [{ json: { toolCallId: p.toolCallId, result } }];\n"
      },
      "typeVersion": 2
    },
    {
      "id": "2295e097-8eb4-4f98-bfc7-d25c1fcc1871",
      "name": "Prep Booking",
      "type": "n8n-nodes-base.code",
      "position": [
        -48,
        560
      ],
      "parameters": {
        "jsCode": "\nconst a = $json.args;\nconst s = new Date(a.start);\nif (isNaN(s)) throw new Error('Invalid start time');\nconst e = new Date(s.getTime() + 30 * 60000);\nconst when = s.toLocaleString('en-GB', { timeZone: $now.zoneName, weekday: 'short', day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit', hour12: true });\nconst urgent = a.urgent === true || a.urgent === 'true';\nreturn [{ json: { ...$json, startISO: s.toISOString(), endISO: e.toISOString(), when,\n  summary: (urgent ? 'URGENT - ' : '') + a.name + ' - ' + a.reason,\n  description: 'Patient: ' + a.name + '\\nPhone: ' + a.phone + '\\nReason: ' + a.reason + '\\nBooked by: AI Receptionist' } }];\n"
      },
      "typeVersion": 2
    },
