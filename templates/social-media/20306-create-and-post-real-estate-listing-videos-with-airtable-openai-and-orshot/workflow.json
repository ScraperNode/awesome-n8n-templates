    {
      "id": "0ad54389-d0a2-4c78-ab02-a89863033eda",
      "name": "Format listing details",
      "type": "n8n-nodes-base.code",
      "position": [
        740,
        320
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Turns the Airtable record into clean values for the caption prompt and the reel template.\nconst f = $json.fields;\nconst photos = (f.Photos || []).map(p => p.url).slice(0, 5);\nwhile (photos.length < 5) photos.push(photos[photos.length - 1]); // repeat the last photo if fewer than 5\n\nconst price = new Intl.NumberFormat('en-US', { style: 'currency', currency: f.Currency || 'USD', maximumFractionDigits: 0 }).format(f.Price);\nconst specs = [\n  f.Bedrooms && `${f.Bedrooms} bd`,\n  f.Bathrooms && `${f.Bathrooms} ba`,\n  f['Square feet'] && `${Number(f['Square feet']).toLocaleString('en-US')} sq ft`,\n].filter(Boolean).join(' \u00b7 ');\n\nreturn {\n  json: {\n    recordId: $json.id,\n    address: f.Address,\n    city: f.City || '',\n    price,\n    specs,\n    status: f['Listing type'] || 'Just Listed',\n    agentName: f['Agent name'] || '',\n    agentEmail: f['Agent email'] || '',\n    listingUrl: f['Listing URL'] || '',\n    notes: f.Highlights || '',\n    postAt: f['Post at'] || '',\n    photos,\n  },\n};"
      },
      "typeVersion": 2
    },
    {
      "id": "2b9637fc-fded-4f9b-b1d5-a8d0321b7d36",
      "name": "Write hook and captions",
      "type": "@n8n/n8n-nodes-langchain.openAi",
      "position": [
        960,
        320
      ],
      "parameters": {
        "modelId": {
          "__rl": true,
          "mode": "list",
          "value": "gpt-4o-mini"
        },
        "options": {
          "temperature": 0.6
        },
        "messages": {
          "values": [
            {
              "role": "system",
              "content": "You write social copy for real estate agents. Be specific to the property, warm and factual. Never invent features, prices or numbers that are not in the listing. Reply with JSON only."
            },
            {
              "content": "=Listing:\nStatus: {{ $json.status }}\nAddress: {{ $json.address }}, {{ $json.city }}\nPrice: {{ $json.price }}\nDetails: {{ $json.specs }}\nHighlights: {{ $json.notes }}\nAgent: {{ $json.agentName }}\nListing link: {{ $json.listingUrl }}\n\nReturn JSON with these keys:\n- hook: max 6 words for the first slide of the video\n- facebook_caption: 3 to 5 short sentences, ends with a line inviting people to book a viewing, then the listing link if there is one\n- instagram_caption: 2 to 3 short sentences, then 5 to 8 local real estate hashtags for the city"
            }
          ]
        },
        "jsonOutput": true
      },
      "typeVersion": 1.8
    },
