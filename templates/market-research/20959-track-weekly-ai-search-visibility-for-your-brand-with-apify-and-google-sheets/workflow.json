    {
      "id": "1b363be8-0797-444a-962b-cad2f232a045",
      "name": "Get report",
      "type": "n8n-nodes-base.httpRequest",
      "position": [
        1320,
        100
      ],
      "parameters": {
        "url": "=https://api.apify.com/v2/key-value-stores/{{ $json.data.defaultKeyValueStoreId }}/records/OUTPUT",
        "method": "GET",
        "options": {},
        "authentication": "genericCredentialType",
