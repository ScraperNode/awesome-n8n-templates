    {
      "id": "f1fa9578-e4a1-4ab4-8bfc-91050867e233",
      "name": "Post to HubSpot Company Search",
      "type": "n8n-nodes-base.httpRequest",
      "position": [
        1744,
        464
      ],
      "parameters": {
        "url": "https://api.hubapi.com/crm/v3/objects/companies/search",
        "method": "POST",
        "options": {},
        "jsonBody": "={\n  \"filterGroups\": [{ \"filters\": [{ \"propertyName\": \"domain\", \"operator\": \"EQ\", \"value\": \"{{ $('Fetch Webmetic Visits').item.json.company_url }}\" }] }],\n  \"properties\": [\"name\", \"hs_num_open_deals\"],\n  \"limit\": 1\n}",
        "sendBody": true,
        "specifyBody": "json",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "hubspotAppToken"
      },
      "typeVersion": 4.4
    },
    {
      "id": "569aace8-4df3-4fba-9af4-807cabcc5e49",
