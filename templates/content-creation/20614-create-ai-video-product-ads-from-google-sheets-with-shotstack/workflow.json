        "length": "={{ $('Ad settings').first().json.clip_seconds }}",
        "prompt": "={{ $('Ad settings').first().json.motion_prompt }}",
        "resource": "generation",
        "assetType": "video",
        "operation": "postGenerate",
        "giveUpAfter": 10,
        "modelOptions": "={\"startSrc\": \"{{ $('Write the ad copy').first().json.image_url }}\", \"aspectRatio\": \"9:16\", \"resolution\": \"720p\", \"generateAudio\": false}",
        "waitForAsset": true
      },
      "typeVersion": 1
