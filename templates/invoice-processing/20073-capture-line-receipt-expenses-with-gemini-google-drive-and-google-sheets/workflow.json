    {
      "id": "204151fd-858c-41fa-9374-0e612c22de06",
      "name": "Convert Image to Base64",
      "type": "n8n-nodes-base.code",
      "position": [
        1280,
        192
      ],
      "parameters": {
        "jsCode": "const item = $input.first();\nconst buffer = await this.helpers.getBinaryDataBuffer(0, 'data');\n\nitem.json.imageBase64 = buffer.toString('base64');\nitem.json.mimeType = item.binary?.data?.mimeType || 'image/jpeg';\n\nreturn [item];"
      },
      "typeVersion": 2
    },
    {
      "id": "e328e5e5-44cf-4dcf-8c13-a42d61764e82",
      "name": "Submit to Gemini for Analysis",
      "type": "n8n-nodes-base.httpRequest",
      "position": [
        1728,
        368
      ],
      "parameters": {
        "url": "https://generativelanguage.googleapis.com/v1beta/models/gemini-3.8-flash:generateContent",
        "method": "POST",
        "options": {},
        "jsonBody": "={{ JSON.stringify({\n  contents: [{\n    parts: [\n      {\n        text: `You are an enterprise expense OCR AI agent.\nAnalyze this image and return only structured JSON.\nFirst determine whether the image is a valid receipt or invoice.\nIf valid, extract receipt_date (YYYY-MM-DD), vendor_name, total_amount (integer JPY), tax_amount (integer JPY), invoice_number (a T followed by 13 digits, or \"None\"), category (Travel, Meals, Supplies, Communication, or Miscellaneous), and description (a brief item summary).\n\nValid receipt format:\n{\n  \"is_receipt\": true,\n  \"receipt_date\": \"YYYY-MM-DD\",\n  \"vendor_name\": \"Store or Company Name\",\n  \"total_amount\": 0,\n  \"tax_amount\": 0,\n  \"invoice_number\": \"T1234567890123\",\n  \"category\": \"Supplies\",\n  \"description\": \"Purchased stationery\"\n}\n\nNon-receipt format:\n{\n  \"is_receipt\": false,\n  \"reason\": \"Image not recognizable as a receipt\"\n}`\n      },\n      {\n        inlineData: {\n          mimeType: $json.mimeType,\n          data: $json.imageBase64\n        }\n      }\n    ]\n  }],\n  generationConfig: {\n    responseMimeType: 'application/json'\n  }\n}) }}",
        "sendBody": true,
        "specifyBody": "json",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth"
      },
      "typeVersion": 4.2
    },
    {
      "id": "8555106a-470f-4589-895b-da2317b31cc5",
      "name": "Extract Receipt Details",
      "type": "n8n-nodes-base.code",
      "position": [
        1952,
        368
      ],
      "parameters": {
        "jsCode": "const r = $input.first().json;\nlet text = r?.candidates?.[0]?.content?.parts?.[0]?.text || '';\ntext = text.trim().replace(/^```json\\s*/i, '').replace(/^```\\s*/i, '').replace(/```$/i, '').trim();\n\nlet parsed;\ntry {\n  parsed = JSON.parse(text);\n} catch (e) {\n  parsed = { is_receipt: false, reason: 'Failed to parse JSON from AI model' };\n}\n\nparsed.is_receipt = parsed.is_receipt === true;\nconst rawInvoice = String(parsed.invoice_number || '');\nconst cleanNum = rawInvoice.replace(/^T/i, '').replace(/[^0-9]/g, '');\nparsed.hasValidTaxFormat = cleanNum.length === 13;\nparsed.cleanTaxNumber = parsed.hasValidTaxFormat ? cleanNum : '';\nparsed.invoice_number = parsed.hasValidTaxFormat ? `T${cleanNum}` : 'None';\n\nreturn [{ json: parsed }];"
      },
      "typeVersion": 2
    },
