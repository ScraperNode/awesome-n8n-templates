{
  "name": "Send appointment reminders to clients on Telegram",
  "nodes": [
    {
      "id": "dc0fe82b-4093-420d-9a11-9974bdb4180a",
      "name": "Schedule Trigger (Every Hour)",
      "type": "n8n-nodes-base.scheduleTrigger",
      "position": [
        240,
        220
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "cronExpression": "0 * * * *"
            }
          ]
        }
      },
      "typeVersion": 1.2
    },
    {
      "id": "f2c2f27e-153f-4b86-bb13-dcf7446d0be5",
      "name": "Set Reminder Config",
      "type": "n8n-nodes-base.set",
      "position": [
        460,
        220
      ],
      "parameters": {
        "mode": "manual",
        "options": {},
        "assignments": {
          "assignments": [
            {
              "id": "15ef6e61-c67a-410d-9568-43caa23c13c1",
              "name": "reminder_message",
              "type": "string",
              "value": "Hi {name}, a friendly reminder about your appointment tomorrow: {start}.\n\nReply YES to confirm or RESCHEDULE if you need to change it. Thanks!"
            }
          ]
        },
        "duplicateItem": false,
        "includeOtherFields": true
      },
      "typeVersion": 3.4
    },
    {
      "id": "2774167c-c3f3-459a-a581-7114a40ff33a",
      "name": "Get Tomorrow's Appointments",
      "type": "n8n-nodes-base.googleCalendar",
      "position": [
        680,
        220
      ],
      "parameters": {
        "options": {
          "orderBy": "startTime",
          "maxResults": 50,
          "singleEvents": true
        },
        "timeMax": "={{ $now.plus({ hours: 25 }).toISO() }}",
        "timeMin": "={{ $now.plus({ hours: 1 }).toISO() }}",
        "calendar": {
          "__rl": true,
          "mode": "list",
          "value": "primary",
          "cachedResultName": "Primary"
        },
        "resource": "event",
        "operation": "getAll"
      },
      "credentials": {
        "googleCalendarOAuth2Api": {
          "id": null,
          "name": "Google Calendar (PLACEHOLDER: connect your Google account)"
        }
      },
      "typeVersion": 1.3
    },
    {
      "id": "3cb71c56-081a-40f9-844e-741f4faf07e2",
      "name": "Extract Client Chat IDs",
      "type": "n8n-nodes-base.code",
      "position": [
        900,
        220
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// The client's Telegram chat id must be in the event description, e.g.: \"ChatID: 123456789\"\n// The reminder text comes from the \"Set Reminder Config\" node: {name} and {start} are replaced automatically.\nconst items = $input.all();\nconst template = items[0]?.json?.reminder_message || \"Hi {name}, a friendly reminder about your appointment tomorrow: {start}.\";\nreturn items.flatMap(item => {\n  const ev = item.json;\n  const start = ev.start?.dateTime || ev.start?.date || '';\n  const m = (ev.description || '').match(/chatid[:\\s]*(\\d+)/i);\n  if (!m) return [];\n  const name = ev.summary || 'customer';\n  return [{ json: {\n    name,\n    start,\n    chat_id: m[1],\n    message: template.split('{name}').join(name).split('{start}').join(start),\n  }}];\n});"
      },
      "typeVersion": 2
    },
    {
      "id": "b7259d8f-5fdd-423d-a315-2a47757fac83",
      "name": "Send Reminder Message",
      "type": "n8n-nodes-base.telegram",
      "position": [
        1120,
        220
      ],
      "parameters": {
        "text": "={{ $json.message }}",
        "chatId": "={{ $json.chat_id }}",
        "resource": "message",
        "operation": "sendMessage",
        "additionalFields": {
          "parse_mode": "HTML"
        }
      },
      "credentials": {
        "telegramApi": {
          "id": null,
          "name": "Telegram (PLACEHOLDER: paste your bot token)"
        }
      },
      "typeVersion": 1.2
    },
    {
      "id": "d754cbf3-1d79-41b5-9d62-64aaf320473e",
      "name": "Telegram Trigger (Customer Replies)",
      "type": "n8n-nodes-base.telegramTrigger",
      "position": [
        240,
        460
      ],
      "parameters": {
        "updates": [
          "message"
        ]
      },
      "credentials": {
        "telegramTriggerApi": {
          "id": null,
          "name": "Telegram (PLACEHOLDER: paste your bot token)"
        }
      },
      "typeVersion": 1.5
    },
    {
      "id": "615303bb-d996-4c61-a9c7-e14d12455617",
      "name": "Detect Reschedule Request",
      "type": "n8n-nodes-base.code",
      "position": [
        680,
        460
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "return $input.all().map(item => {\n  const msg = item.json?.message;\n  const text = msg?.text ?? '';\n  return { json: { text, chat_id: msg?.chat?.id ?? '',\n    owner_chat_id: item.json.owner_chat_id ?? '',\n    wants_reschedule: /reschedule|change|move my appointment/i.test(text) } };\n});"
      },
      "typeVersion": 2
    },
    {
      "id": "ff4656bb-560f-48b7-aabe-e4b62a2fb218",
      "name": "IF Reschedule Requested",
      "type": "n8n-nodes-base.if",
      "position": [
        900,
        460
      ],
      "parameters": {
        "options": {},
        "conditions": {
          "options": {
            "version": 2,
            "leftValue": "",
            "caseSensitive": true,
            "typeValidation": "loose"
          },
          "combinator": "and",
          "conditions": [
            {
              "id": "325c2924-b582-45b8-8546-f46c03bc51df",
              "operator": {
                "type": "boolean",
                "operation": "true"
              },
              "leftValue": "={{ $json.wants_reschedule }}"
            }
          ]
        }
      },
      "typeVersion": 2.2
    },
    {
      "id": "4a256640-e16f-4850-8ac7-1ae074a6a6b4",
      "name": "Notify Owner of Reschedule",
      "type": "n8n-nodes-base.telegram",
      "position": [
        1120,
        460
      ],
      "parameters": {
        "text": "<b>Reschedule requested</b>\n\nThe client (chat {{ $json.chat_id }}) asked to reschedule their appointment.\nMessage: \"{{ $json.text }}\"\n\nPlease follow up soon.",
        "chatId": "={{ $json.owner_chat_id }}",
        "resource": "message",
        "operation": "sendMessage",
        "additionalFields": {
          "parse_mode": "HTML"
        }
      },
      "credentials": {
        "telegramApi": {
          "id": null,
          "name": "Telegram (PLACEHOLDER: paste your bot token)"
        }
      },
      "typeVersion": 1.2
    },
    {
      "id": "ffa7d6cc-ae77-4bd0-b584-8a5af7dd8bab",
      "name": "Set Owner Config",
      "type": "n8n-nodes-base.set",
      "position": [
        460,
        460
      ],
      "parameters": {
        "mode": "manual",
        "options": {},
        "assignments": {
          "assignments": [
            {
              "id": "9dca3b94-2039-4f70-a576-e260664fa2af",
              "name": "owner_chat_id",
              "type": "string",
              "value": ""
            }
          ]
        },
        "duplicateItem": false,
        "includeOtherFields": true
      },
      "typeVersion": 3.4
    },
    {
      "id": "f68140c5-42c0-4889-92c3-266660e23b69",
      "name": "Sticky - Template Description",
      "type": "n8n-nodes-base.stickyNote",
      "position": [
        200,
        -300
      ],
      "parameters": {
        "color": 4,
        "width": 1400,
        "height": 380,
        "content": "## Send appointment reminders to clients on Telegram\n\nCut no-shows on autopilot. This template checks your Google Calendar every hour and sends Telegram reminders to clients with appointments in the next 24 hours - and pings you instantly when a client asks to reschedule.\n\n**Who it's for:** appointment-based small businesses (barbershops, clinics, consultants, studios) whose clients use Telegram.\n\n**How it works:** an hourly schedule reads tomorrow's events from Google Calendar, a Code node extracts each client's chat id from the event description and builds a personalized reminder, and your bot sends it. A second flow listens for client replies and alerts you when someone wants to reschedule.\n\n**Setup:** 1) Create a free Telegram bot with @BotFather and add its token to the Telegram credentials. 2) Connect your Google account in the calendar node (uses your Primary calendar). 3) Edit \"Set Reminder Config\" (message text - {name} and {start} are replaced automatically) and \"Set Owner Config\" (your own Telegram chat id). 4) Write \"ChatID: 123456789\" in each calendar event description with the client's chat id. 5) Activate - done.\n\n**Note:** Telegram bots can only message people who start the conversation (they tap Start). Ideal for reminders and existing customers.\n\nTry 2 free automations (this one + after-hours auto-reply): https://zayco3d.gumroad.com/l/muestra-2-automatizaciones-telegram\nWant 11 more automations like this one? Full 12-automation pack: https://zayco3d.gumroad.com/l/pack-telegram-n8n"
      },
      "typeVersion": 1
    },
    {
      "id": "de39aab3-d51c-4adf-9ef6-ac7bc75675fc",
      "name": "Sticky - Step 1",
      "type": "n8n-nodes-base.stickyNote",
      "position": [
        220,
        60
      ],
      "parameters": {
        "color": 1,
        "width": 220,
        "height": 200,
        "content": "### 1. Schedule Trigger (Every Hour)\nRuns the reminder check once per hour. Edit the cron rule if you want a different frequency."
      },
      "typeVersion": 1
    },
    {
      "id": "7ebd0dfd-4317-4514-9895-433ff79c1163",
      "name": "Sticky - Step 2",
      "type": "n8n-nodes-base.stickyNote",
      "position": [
        440,
        60
      ],
      "parameters": {
        "color": 1,
        "width": 220,
        "height": 200,
        "content": "### 2. Set Reminder Config\nAll settings in one place: your reminder message text. {name} and {start} are replaced automatically. No code needed."
      },
      "typeVersion": 1
    },
    {
      "id": "cc23d1f2-de12-418f-878b-299a92d41b90",
      "name": "Sticky - Step 3",
      "type": "n8n-nodes-base.stickyNote",
      "position": [
        660,
        60
      ],
      "parameters": {
        "color": 1,
        "width": 220,
        "height": 200,
        "content": "### 3. Get Tomorrow's Appointments\nReads events from your Google Calendar in the next 24 hours (from +1h to +25h). Connect your Google account in the node credentials. Uses your Primary calendar."
      },
      "typeVersion": 1
    },
    {
      "id": "50a4afda-daa8-490c-97f3-acbd20e59c13",
      "name": "Sticky - Step 4",
      "type": "n8n-nodes-base.stickyNote",
      "position": [
        880,
        60
      ],
      "parameters": {
        "color": 1,
        "width": 220,
        "height": 200,
        "content": "### 4. Extract Client Chat IDs\nFinds the client's Telegram chat id in each event description (write \"ChatID: 123456789\" in the event description) and builds the personalized reminder message."
      },
      "typeVersion": 1
    },
    {
      "id": "858c67cb-fd44-4445-9725-b2377515c73c",
      "name": "Sticky - Step 5",
      "type": "n8n-nodes-base.stickyNote",
      "position": [
        1100,
        60
      ],
      "parameters": {
        "color": 1,
        "width": 220,
        "height": 200,
        "content": "### 5. Send Reminder Message\nSends the reminder to each client through your Telegram bot. Add your bot token in the node credentials."
      },
      "typeVersion": 1
    },
    {
      "id": "88e30fb1-9e7f-4375-8295-d6880507d5c0",
      "name": "Sticky - Step 6",
      "type": "n8n-nodes-base.stickyNote",
      "position": [
        220,
        620
      ],
      "parameters": {
        "color": 1,
        "width": 220,
        "height": 220,
        "content": "### 6. Telegram Trigger (Customer Replies)\nListens for client replies to your bot (confirmations or reschedule requests). Uses the same bot token as step 5."
      },
      "typeVersion": 1
    },
    {
      "id": "f59d477f-bc4b-4f8e-902e-ce1acb10f4d5",
      "name": "Sticky - Step 7",
      "type": "n8n-nodes-base.stickyNote",
      "position": [
        440,
        620
      ],
      "parameters": {
        "color": 1,
        "width": 220,
        "height": 220,
        "content": "### 7. Set Owner Config\nPaste your own Telegram chat id here (message @userinfobot on Telegram to get it). Reschedule alerts are sent to this chat."
      },
      "typeVersion": 1
    },
    {
      "id": "78ccb0bf-ffe9-406f-803e-73b0ff7bb8a3",
      "name": "Sticky - Step 8",
      "type": "n8n-nodes-base.stickyNote",
      "position": [
        660,
        620
      ],
      "parameters": {
        "color": 1,
        "width": 220,
        "height": 220,
        "content": "### 8. Detect Reschedule Request\nReads each reply and flags messages asking to reschedule (matches \"reschedule\", \"change\", \"move my appointment\")."
      },
      "typeVersion": 1
    },
    {
      "id": "66a7077e-32d9-4c46-af8f-8b02ff3a4e98",
      "name": "Sticky - Step 9",
      "type": "n8n-nodes-base.stickyNote",
      "position": [
        880,
