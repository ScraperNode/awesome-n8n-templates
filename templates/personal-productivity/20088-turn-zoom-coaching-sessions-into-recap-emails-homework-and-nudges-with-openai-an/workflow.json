    {
      "id": "65d6c9c6-5d3f-4ccb-84f9-8512eea48bfe",
      "name": "Clean Transcript Text",
      "type": "n8n-nodes-base.code",
      "position": [
        2224,
        160
      ],
      "parameters": {
        "jsCode": "// Turn Zoom's WebVTT file into plain 'Speaker: text' lines\nconst raw = String($input.first().json.vtt || '');\nconst out = [];\nfor (const line of raw.split(/\\r?\\n/)) {\n  const t = line.trim();\n  if (!t || t === 'WEBVTT' || /^\\d+$/.test(t) || t.includes('-->')) continue;\n  if (out.length && out[out.length - 1] === t) continue;\n  out.push(t);\n}\nreturn [{ json: { transcript: out.join('\\n') } }];"
      },
      "typeVersion": 2
    },
