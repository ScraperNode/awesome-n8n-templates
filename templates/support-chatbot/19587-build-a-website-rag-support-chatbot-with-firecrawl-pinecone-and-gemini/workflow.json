    {
      "id": "e1898a36-d305-4c95-a903-3b196a6c5e49",
      "name": "Map Website URLs",
      "type": "@mendable/n8n-nodes-firecrawl.firecrawl",
      "position": [
        2688,
        816
      ],
      "parameters": {
        "url": "={{ $('Normalize Website URL').item.json.url }}",
