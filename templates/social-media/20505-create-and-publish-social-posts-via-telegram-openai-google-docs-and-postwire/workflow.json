          "assignments": [
            {
              "id": "661f2067-73d1-4016-ae9d-8eb2f5bbb71a",
              "name": "posts",
              "type": "object",
              "value": "={{ (() => { const m = String($json.output || '').match(/\\{[\\s\\S]*\\}/); try { return m ? JSON.parse(m[0]) : {}; } catch (e) { return {}; } })() }}"
            },
            {
              "id": "0b4efba4-3f7d-4776-a8e3-506fba3221da",
              "name": "topic",
              "type": "string",
              "value": "={{ $('Only text topics').item.json.message.text.trim() }}"
            },
            {
              "id": "779974f9-9459-4d10-a61c-057a68157e7d",
              "name": "networks",
              "type": "array",
              "value": "={{ ['linkedin', 'facebook', 'bluesky', 'mastodon'] }}"
