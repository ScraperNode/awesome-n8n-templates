      },
      "typeVersion": 1,
      "continueOnFail": true
    },
    {
      "id": "9bd4e0ca-aef2-4aca-a6e0-f87360689368",
      "name": "JS - Evaluate Probe",
      "type": "n8n-nodes-base.code",
      "position": [
        1424,
        656
      ],
      "parameters": {
        "jsCode": "const ctx = $('IF - Is Half-Open Probe').first().json;\nconst redisResult = $input.first().json || {};\n\nconst nums = Object.values(redisResult).filter(v => typeof v === 'number' || (typeof v === 'string' && v.trim() !== '' && !isNaN(v)));\nconst claimCount = nums.length ? Number(nums[0]) : 1; // Redis error -> fail open, allow the probe\n\nconst probeGranted = claimCount <= 1; // max 1 probe per open cycle\n\nreturn [{\n  json: {\n    ...ctx,\n    probeGranted,\n    reason: probeGranted ? null : 'half_open_probe_in_flight',\n    retryAfterSeconds: probeGranted ? 0 : 5\n  }\n}];"
      },
      "typeVersion": 2
    },
    {
      "id": "1302d35f-c0a7-4588-9626-4b4cb63d8269",
      "name": "IF - Probe Granted",
      "type": "n8n-nodes-base.if",
