    {
      "id": "3d752c1a-a321-4702-9131-9c07df9d555f",
      "name": "Build invoice data",
      "type": "n8n-nodes-base.code",
      "position": [
        640,
        320
      ],
      "parameters": {
        "jsCode": "// Edit these once.\nconst COMPANY_NAME = 'Your Company';\nconst COMPANY_DETAILS = '123 Main Street, City, Country\\user@example.com';\nconst PAYMENT_DETAILS = 'Bank: Your Bank\\nAccount: +1234567890\\nPay online: yourcompany.com/pay';\nconst FOOTER = 'Your Company \u00b7 yourcompany.com';\nconst PAYMENT_DAYS = 14; // used when Due date is empty\nconst MAX_LINES = 8; // rows in the Orshot invoice template\n\nconst blank = v => v === undefined || v === null || String(v).trim() === '';\n// Accepts 1800, '1,800.00' or '$1,800'; anything without a number is NaN.\nconst num = v => {\n  if (typeof v === 'number') return v;\n  const s = String(v ?? '').replace(/[^0-9.\\-]/g, '');\n  return /\\d/.test(s) ? Number(s) : NaN;\n};\nconst qtyOf = l => (blank(l['Quantity']) ? 1 : num(l['Quantity']));\nconst lines = $('Get line items').all().map(i => i.json).filter(l => !blank(l['Invoice number']));\n\nreturn $('Get invoices marked Ready').all().map(({ json: inv }) => {\n  const number = String(inv['Invoice number'] ?? '').trim();\n  const currency = String(inv['Currency'] || 'USD').trim().toUpperCase();\n  const money = n => new Intl.NumberFormat('en-US', { style: 'currency', currency }).format(n);\n  const row = { row_number: inv.row_number, invoice_number: number, client_name: inv['Client name'], email: String(inv['Client email'] ?? '').trim(), company: COMPANY_NAME };\n\n  const items = lines.filter(l => String(l['Invoice number']).trim() === number);\n  const problems = [];\n  if (!number) problems.push('Invoice number is empty');\n  if (!/^\\S+@\\S+\\.\\S+$/.test(row.email)) problems.push('Client email is missing or invalid');\n  if (!items.length) problems.push('No line items found for this invoice number');\n  if (items.length > MAX_LINES) problems.push(`${items.length} line items, the template fits ${MAX_LINES}`);\n  const bad = items.filter(l => isNaN(qtyOf(l)) || isNaN(num(l['Unit price'])));\n  if (bad.length) problems.push('Quantity or Unit price is not a number on ' + bad.map(l => `\"${l['Description']}\"`).join(', '));\n  if (problems.length) return { json: { ...row, ok: false, status: 'Error', error: problems.join('. ') } };\n\n  const subtotal = items.reduce((t, l) => t + qtyOf(l) * num(l['Unit price']), 0);\n  const taxRate = blank(inv['Tax rate %']) ? 0 : num(inv['Tax rate %']);\n  const tax = Math.round(subtotal * taxRate) / 100;\n  const total = subtotal + tax;\n  const today = $now.toFormat('MMM d, yyyy');\n  const due = blank(inv['Due date']) ? $now.plus({ days: PAYMENT_DAYS }).toFormat('MMM d, yyyy') : String(inv['Due date']);\n\n  const mods = {\n    company_name: COMPANY_NAME,\n    company_details: COMPANY_DETAILS,\n    payment_details: PAYMENT_DETAILS,\n    footer_text: FOOTER,\n    invoice_number: number,\n    issue_date: blank(inv['Issue date']) ? today : String(inv['Issue date']),\n    due_date: due,\n    amount_due: money(total),\n    bill_to_name: String(inv['Client name'] || ' '),\n    bill_to_details: [inv['Client address'], row.email].filter(v => !blank(v)).join('\\n') || ' ',\n    subtotal: money(subtotal),\n    tax_label: taxRate ? `Tax (${taxRate}%)` : 'Tax',\n    tax: money(tax),\n    total: money(total),\n    notes: blank(inv['Notes']) ? `Payment is due by ${due}. Please include ${number} with your payment.` : String(inv['Notes']),\n  };\n  // Empty rows get a space so the sample rows in the template are cleared.\n  for (let i = 1; i <= MAX_LINES; i++) {\n    const l = items[i - 1];\n    const qty = l ? qtyOf(l) : 0;\n    mods[`item_${i}_desc`] = l ? String(l['Description'] || ' ') : ' ';\n    mods[`item_${i}_qty`] = l ? String(qty) : ' ';\n    mods[`item_${i}_price`] = l ? money(num(l['Unit price'])) : ' ';\n    mods[`item_${i}_amount`] = l ? money(qty * num(l['Unit price'])) : ' ';\n  }\n\n  return { json: { ...row, ok: true, status: 'Ready', error: '', total: money(total), due_date: due, file_name: `${number}-${String(inv['Client name'] || '')}`.replace(/[^a-z0-9]+/gi, '-').toLowerCase(), mods } };\n});"
      },
      "typeVersion": 2
    },
