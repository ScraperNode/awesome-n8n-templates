      "parameters": {
        "color": 7,
        "width": 820,
        "height": 520,
        "content": "## 2. Check, save and tell you\nEach request gets a reference from email, service, address and day. A repeat that day is usually not saved again; two submits in the same second can both get through. New requests are emailed to `owner_email`."
      },
      "typeVersion": 1
