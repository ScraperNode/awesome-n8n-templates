        "color": 7,
        "width": 1302,
        "height": 482,
        "content": "**1. Fetch & Filter Appointments**\nChecks Calendly every 2 hours for upcoming events, keeps those starting within 24 hours, and pulls each event's invitee details."
      },
      "typeVersion": 1
    },
    {
      "id": "0a235903-d66d-42a7-95c2-63bf17ff5425",
      "name": "Sticky - sticky-sec2",
      "type": "n8n-nodes-base.stickyNote",
