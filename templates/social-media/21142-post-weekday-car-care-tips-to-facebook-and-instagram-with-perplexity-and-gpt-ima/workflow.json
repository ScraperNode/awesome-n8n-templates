    {
      "id": "ef289f6e-9a1f-4340-a62e-ae07bb022f37",
      "name": "Research with Perplexity",
      "type": "n8n-nodes-base.perplexity",
      "position": [
        1200,
        0
      ],
      "parameters": {
        "input": "={{ (() => { const s = $('Shop settings').first().json; const past = ($json.past || []).map(p => p.topic).filter(Boolean); return 'Shop: ' + s.shop + '\\nCity: ' + s.city + '\\nServices: ' + s.services + '\\nOffer: ' + s.offer + '\\nToday: ' + $now.toFormat('cccc d LLLL yyyy') + '\\n\\nTopics already posted (do not repeat):\\n' + (past.length ? past.slice(-60).map(t => '- ' + t).join('\\n') : '- none yet'); })() }}",
        "model": {
          "__rl": true,
          "mode": "id",
          "value": ""
        },
        "preset": "pro-search",
        "options": {
          "instructions": "You write the daily car care tip for the social media of an auto repair shop. Search the web and pick ONE practical tip that fits this week in the city (season, weather, holidays, road trips) and is not in the list of topics already posted. Use only facts your sources support; invent no prices, recalls or promises about the shop. Return only JSON, with no text around it, with the keys topic (a short title), tip (2 sentences), facts (an array of 2 short verified facts), image_prompt (one square photo-style image: a car or a workshop scene that shows the tip; no text, no logos, no faces), facebook (2 or 3 friendly sentences that end with the offer) and instagram (2 sentences and up to 4 hashtags).",
          "maxOutputTokens": 900
        },
        "resource": "agent",
        "simplify": true,
        "operation": "createResponse"
      },
      "typeVersion": 3
    },
    {
      "id": "9b8c7a18-bb7e-4572-a121-28afa14a0211",
      "name": "Read the tip",
      "type": "n8n-nodes-base.set",
