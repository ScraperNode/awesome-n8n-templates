    {
      "id": "1ba8ba3b-d3ca-4c93-b6d3-fbdad3439756",
      "name": "Find Pending - Code",
      "type": "n8n-nodes-base.code",
      "position": [
        2340,
        420
      ],
      "parameters": {
        "jsCode": "// For each stashed request, keep it only if the log shows no review yet.\nconst log = $('Read Review Log - Sheets').all().map(i => i.json);\nconst pending = [];\nfor (const item of $input.all()) {\n  const c = item.json;\n  const done = log.some(r => String(r.mobile) === String(c.mobile)\n    && String(r.review_detected).toLowerCase() === 'yes');\n  if (!done) pending.push({ json: c });\n}\nreturn pending;"
      },
      "typeVersion": 2
    },
