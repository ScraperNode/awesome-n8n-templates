          "lastName": "={{ ($('Find Contacts via Webmetic').item.json.name || '').split(' ').slice(1).join(' ') }}",
          "firstName": "={{ ($('Find Contacts via Webmetic').item.json.name || '').split(' ')[0] }}",
          "websiteUrl": "={{ $('Fetch Webmetic Visits').item.json.company_url }}",
          "companyName": "={{ $('Fetch Webmetic Visits').item.json.company_name }}",
          "linkedinUrl": "={{ $('Find Contacts via Webmetic').item.json.linkedin || '' }}",
          "phoneNumber": "={{ $('Find Contacts via Webmetic').item.json.direct_phone || '' }}",
          "lifeCycleStage": "lead",
          "mobilePhoneNumber": "={{ $('Find Contacts via Webmetic').item.json.mobile_phone || '' }}"
        }
      },
      "typeVersion": 2.2
    },
    {
      "id": "f984f937-248c-4ba6-975a-5225c6e03b2d",
      "name": "Create HubSpot Call Task",
      "type": "n8n-nodes-base.hubspot",
      "position": [
        3008,
