        "start": "={{ $json.start }}",
        "summary": "=Booking: {{ $json.caller_name }} - {{ $json.service }}",
        "calendar": {
          "__rl": true,
          "mode": "id",
          "value": "={{ $('CONFIG - Voice').first().json.calendar_id }}"
        },
        "resource": "event",
        "operation": "create",
        "description": "={{ $json.notes }}\\nPhone: {{ $json.caller_phone }}",
        "additionalFields": {}
      },
      "credentials": {
