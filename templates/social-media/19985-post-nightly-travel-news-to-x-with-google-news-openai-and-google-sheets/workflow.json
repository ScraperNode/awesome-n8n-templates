        "responses": {
          "values": [
            {
              "role": "system",
              "content": "\u3042\u306a\u305f\u306f\u65c5\u884c\u306b\u8a73\u3057\u3044\u7de8\u96c6\u8005\u3067\u3059\u3002\u4e00\u822c\u306e\u65c5\u884c\u8005(\u5c02\u9580\u77e5\u8b58\u306a\u3057)\u5411\u3051\u306b\u3001\u8a71\u984c\u306e\u30cb\u30e5\u30fc\u30b9\u30921\u301c2\u6587\u306e\u65e5\u672c\u8a9e\u3067\u7d39\u4ecb\u3059\u308bX(Twitter)\u6295\u7a3f\u7528\u30b3\u30e1\u30f3\u30c8\u3092\u66f8\u3044\u3066\u304f\u3060\u3055\u3044\u3002\u5143\u8a18\u4e8b\u306e\u6587\u7ae0\u3092\u305d\u306e\u307e\u307e\u30b3\u30d4\u30fc\u305b\u305a\u3001\u81ea\u5206\u306e\u8a00\u8449\u3067\u5206\u304b\u308a\u3084\u3059\u304f\u8981\u7d04\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u300c\u77e5\u3063\u3066\u304a\u304f\u3068\u5f97\u3059\u308b/\u640d\u3057\u306a\u3044\u30dd\u30a4\u30f3\u30c8\u300d\u3068\u3044\u3046\u6d88\u8cbb\u8005\u76ee\u7dda\u306e\u30c8\u30fc\u30f3\u306b\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u7d75\u6587\u5b57\u306f1\u301c2\u500b\u307e\u3067\u3002150\u6587\u5b57\u4ee5\u5185\u3002"
            },
            {
              "content": "=\u8a18\u4e8b\u30bf\u30a4\u30c8\u30eb: {{ $json.title }}\n\u8a18\u4e8b\u6982\u8981: {{ $json.summary }}\n\n\u4e0a\u8a18\u306e\u60c5\u5831\u3060\u3051\u3092\u3082\u3068\u306b\u3001X\u6295\u7a3f\u7528\u306e\u7d39\u4ecb\u30b3\u30e1\u30f3\u30c8\u3092\u66f8\u3044\u3066\u304f\u3060\u3055\u3044\u3002"
            }
