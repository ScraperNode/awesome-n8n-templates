    {
      "id": "e37efbb1-909a-4165-8d0f-59aecf2dc42b",
      "name": "Delete it from the working sheet",
      "type": "n8n-nodes-base.httpRequest",
      "notes": "Only runs after the copy has been made and tidied, so the tab is never removed before the archive exists.",
      "position": [
