    {
      "id": "d3f72c66-07fe-4f80-a203-48f0a25f6a43",
      "name": "Publish the video",
      "type": "n8n-nodes-base.httpRequest",
      "position": [
        300,
        360
      ],
      "parameters": {
        "url": "https://postwire.io/api/post",
        "method": "POST",
        "options": {
          "response": {
            "response": {
              "neverError": true
            }
