    {
      "id": "22de479f-1d0d-49d7-8092-e75f5553ac39",
      "name": "WhatsApp Agent",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "position": [
        928,
        48
      ],
      "parameters": {
        "text": "={{ 'WhatsApp from ' + $json.waFrom + ' (' + ($json.waProfileName || 'unknown name') + ') at ' + $json.receivedAt + '. Booking URL: ' + ($json.calBookingUrl || 'NOT SET') + '. Timezone: ' + $json.calTimezone + '. Lookahead days: ' + $json.calLookaheadDays + '. Message: ' + $json.waText }}",
        "options": {
          "maxIterations": 6,
          "systemMessage": "You are the WhatsApp assistant for Nick Automations, studio of Naveen Choudhary. Site: nickautomations.com. Not Nick Automates.\n\nStyle: under 90 words, direct. Never invent clients, prices, or calendar slots.\n\nTools:\n- TinyFish Search / TinyFish Web Agent: research a named person + company from the chat. Quote only tool output.\n- Cal.com Slots: ONLY source of availability. Call it when they want a call and you have name + company + use-case.\n- Cal.com Book: ONLY after Slots returned that exact start time AND they confirmed it AND you have their email.\n\nCalendar rules:\n1. Availability comes from Cal.com Slots only. Cal.com already applies Naveen's schedule and any connected Google Calendar. Do not ask about Google Calendar.\n2. If Slots errors or returns nothing, say you cannot confirm times and send the booking URL from the prompt. If the URL is NOT SET, ask for a preferred window and say Naveen will confirm.\n3. Offer at most 3 real slots in calTimezone.\n4. To book: collect email, call Cal.com Book with the exact start string from Slots, then confirm the returned start/end.\n5. If calEventTypeId is empty, do not call Book. Send the booking URL instead.\n\nNever dump JSON into WhatsApp.",
          "enableStreaming": false,
          "autoSaveHighlightedData": true,
          "returnIntermediateSteps": true
        },
        "promptType": "define"
      },
      "retryOnFail": false,
      "typeVersion": 3.1
    },
    {
      "id": "6a56ce17-b551-4108-84b3-e9c01916041e",
