    {
      "id": "450e2986-8585-4dce-ae24-08ae283792b9",
      "name": "Write the video prompt",
      "type": "@n8n/n8n-nodes-langchain.minimax",
      "position": [
        1800,
        0
      ],
      "parameters": {
        "modelId": "MiniMax-M3",
        "options": {
          "system": "You plan one short vertical (9:16) video of about 6 seconds for an AI video model. Answer with JSON only, with the keys video_prompt (one paragraph for a single shot: subject, action, setting, camera movement and light; no on-screen text, no logos, no real people or brands), caption_idea (one or two sentences that say what the video shows, to write the captions from) and youtube_title (a searchable title of up to 80 characters ending in #Shorts)."
        },
        "messages": {
          "values": [
            {
              "role": "user",
              "content": "={{ 'Idea: ' + $('Take the next idea').item.json.idea + '\\nStyle: ' + ($('Take the next idea').item.json.style || $('Channel settings').first().json.style) }}"
            }
          ]
        },
        "resource": "text",
        "simplify": true,
        "operation": "message"
      },
      "typeVersion": 1.1
    },
    {
