    {
      "id": "55ece322-e215-443d-b222-cedc6d4201eb",
      "name": "Extract Post URL",
      "type": "n8n-nodes-base.code",
      "position": [
        2688,
        -48
      ],
      "parameters": {
        "jsCode": "\n// LinkedIn returns the new post URN in the x-restli-id response header.\nconst res = $input.first().json || {};\nconst h = res.headers || {};\nconst urn = h['x-restli-id'] || h['X-RestLi-Id'] || '';\nif (!urn) throw new Error('LinkedIn did not return a post ID.');\nreturn [{ json: { url: 'https://www.linkedin.com/feed/update/' + urn, urn } }];\n"
      },
      "typeVersion": 2
    },
    {
      "id": "c5be0115-260e-4372-828e-c7a7909bbbea",
      "name": "Respond with Post URL",
      "type": "n8n-nodes-base.respondToWebhook",
      "position": [
        2912,
        -48
      ],
      "parameters": {
        "options": {},
