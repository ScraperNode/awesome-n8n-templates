      "parameters": {
        "jsCode": "const b=$input.first().json.body||$input.first().json;const business_name=String(b.business_name||'').trim(),email=String(b.email||'').trim(),sheet_url=String(b.sheet_url||'').trim();const sheet_id=sheet_url.match(/^https:\\/\\/docs\\.google\\.com\\/spreadsheets\\/d\\/([A-Za-z0-9_-]+)/)?.[1];const threshold=Number(b.threshold_pct??20);\nif(!business_name||!/^\\S+@\\S+\\.\\S+$/.test(email)||!sheet_id||!Number.isFinite(threshold)||threshold<=0||threshold>100)throw new Error('Valid business_name, email, Google Sheets URL and threshold_pct (1\u2013100) are required');return [{json:{business_name,email,sheet_url,sheet_id,threshold_pct:threshold,status:'active'}}];"
