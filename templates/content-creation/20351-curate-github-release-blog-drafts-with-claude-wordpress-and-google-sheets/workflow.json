    {
      "id": "8589fdee-e4a3-4ad6-b094-8c51494571d2",
      "name": "Claude\u3067\u8a18\u4e8b\u751f\u6210",
      "type": "n8n-nodes-base.httpRequest",
      "position": [
        440,
        0
      ],
      "parameters": {
        "url": "https://api.anthropic.com/v1/messages",
        "method": "POST",
        "options": {},
        "jsonBody": "={{ JSON.stringify({\n  model: \"claude-sonnet-4-6\",\n  max_tokens: 4000,\n  messages: [{ role: \"user\", content: `\u3042\u306a\u305f\u306f\u300e${ $('Config (edit me)').first().json.BLOG_NAME }\u300f\u3068\u3044\u3046\u500b\u4eba\u30d6\u30ed\u30b0\u306e\u904b\u55b6\u8005\u3067\u3059\u3002${ $('Config (edit me)').first().json.PERSONA }\u3067\u3001\u4ee5\u4e0b\u306eGitHub Release\u5185\u5bb9\u3092\u3082\u3068\u306b\u65e5\u672c\u8a9e\u306e\u30d6\u30ed\u30b0\u8a18\u4e8b\u3092\u66f8\u3044\u3066\u304f\u3060\u3055\u3044\u3002\n\n\u3010\u30bf\u30a4\u30c8\u30eb\u6848\u3011${($json.headline_candidates || []).join(' / ')}\n\u3010\u8981\u70b9\u3011${($json.key_points || []).join(' / ')}\n\u3010release\u672c\u6587\u3011\n${($json.body || '').slice(0, 4000)}\n\n\u3010\u8a18\u4e8b\u306e\u30c8\u30fc\u30f3\u3011\n- \u5c02\u9580\u30b3\u30f3\u30b5\u30eb\u7684\u306a\u89e3\u8aac\u3067\u306f\u306a\u304f\u3001\u7d20\u4eba\u304c\u30ea\u30ea\u30fc\u30b9\u30ce\u30fc\u30c8\u3092\u8aad\u3093\u3067\u8abf\u3079\u305f\u76ee\u7dda\u3067\u66f8\u304f\n- \u300c\u82f1\u8a9e\u306e\u30ea\u30ea\u30fc\u30b9\u30ce\u30fc\u30c8\u3060\u3068\u5206\u304b\u308a\u306b\u304f\u304b\u3063\u305f\u70b9\u300d\u300c\u81ea\u5206\u306e\u30ef\u30fc\u30af\u30d5\u30ed\u30fc\u3067\u3053\u3046\u4f7f\u3048\u305d\u3046\u300d\u300c\u6b21\u306b\u8a66\u3057\u3066\u307f\u305f\u3044\u3053\u3068\u300d\u306a\u3069\u3001\u7d20\u4eba\u76ee\u7dda\u306e\u611f\u60f3\u3092\u4e00\u8a00\u4ee5\u4e0a\u542b\u3081\u308b\n- \u5b9f\u969b\u306b\u89e6\u3063\u3066\u8a66\u3057\u305f\u304b\u306e\u3088\u3046\u306a\u4f53\u9a13\u8ac7\u3084\u3001\u52d5\u4f5c\u7d50\u679c\u306e\u63cf\u5199\u306f\u66f8\u304b\u306a\u3044\uff08\u8a66\u3057\u3066\u3044\u306a\u3044\u5185\u5bb9\u3092\u4f53\u9a13\u3068\u3057\u3066\u66f8\u304b\u306a\u3044\uff09\n- \u30ea\u30ea\u30fc\u30b9\u30ce\u30fc\u30c8\u306b\u66f8\u304b\u308c\u3066\u3044\u306a\u3044\u4ed5\u69d8\u30fb\u7d4c\u7def\u30fb\u80cc\u666f\u30fb\u52b9\u679c\u306f\u63a8\u6e2c\u3067\u66f8\u304b\u306a\u