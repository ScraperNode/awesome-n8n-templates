      "id": "a164d382-9458-4c0b-b651-1a352c79ffa8",
      "name": "Read last week's snapshot",
      "type": "n8n-nodes-base.googleSheets",
      "notes": "Reads whatever is already in the tab so this week's numbers can be compared with last week's.\nOn the very first run the tab is empty and every episode is simply marked as new.",
      "onError": "continueRegularOutput",
      "position": [
        5152,
        -256
      ],
      "parameters": {
        "options": {},
        "sheetName": {
