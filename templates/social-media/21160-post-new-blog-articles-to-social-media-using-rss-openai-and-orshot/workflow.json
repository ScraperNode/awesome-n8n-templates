    {
      "id": "5e4bf434-107a-4e88-a64a-f389f5a90cfc",
      "name": "New blog post",
      "type": "n8n-nodes-base.rssFeedReadTrigger",
      "position": [
        0,
        320
      ],
      "parameters": {
        "feedUrl": "https://your-blog.com/feed",
        "pollTimes": {
          "item": [
            {
              "mode": "everyHour"
            }
          ]
        }
      },
      "typeVersion": 1
    },
    {
      "id": "349e3fbc-4702-401e-9e5a-93a8a4c74c31",
      "name": "Map post fields",
      "type": "n8n-nodes-base.code",
      "position": [
        240,
        320
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Edit these values once.\nconst BLOG_HANDLE = '@yourblog';\nconst KICKER = 'new on the blog';\nconst CTA = 'read the full post';\nconst FALLBACK_IMAGE = ''; // empty keeps the photo saved in the Orshot template\n\nconst item = $json;\nconst decode = s => String(s || '')\n  .replace(/<[^>]+>/g, ' ')\n  .replace(/&#(\\d+);/g, (m, c) => String.fromCharCode(c))\n  .replace(/&amp;/g, '&').replace(/&quot;/g, '\"').replace(/&#039;|&apos;/g, \"'\")\n  .replace(/&nbsp;/g, ' ').replace(/\\s+/g, ' ').trim();\n\n// Featured image: the enclosure, a media tag, or the first image in the post body.\n// Podcast and video feeds put audio or video in the enclosure, so only image files count.\nconst isImage = m => m?.url && (String(m.type || m.medium || '').startsWith('image') || /\\.(jpe?g|png|webp|gif|avif)(\\?|$)/i.test(m.url));\nconst html = item['content:encoded'] || item.content || '';\nconst firstImg = (html.match(/<img[^>]+src=[\"']([^\"']+)[\"']/i) || [])[1];\nconst media = item['media:content']?.$;\nconst image = (isImage(item.enclosure) && item.enclosure.url) || (isImage(media) && media.url) || firstImg || FALLBACK_IMAGE;\n\nconst categories = Array.isArray(item.categories) ? item.categories : [];\nconst category = decode(categories[0]?._ || categories[0]) || 'New on the blog';\n\nreturn {\n  json: {\n    title: decode(item.title),\n    link: item.link,\n    summary: decode(item.contentSnippet || html).slice(0, 1200),\n    category,\n    image,\n    handle: BLOG_HANDLE,\n    kicker: KICKER,\n    cta: CTA,\n  },\n};"
      },
      "typeVersion": 2
    },
    {
      "id": "9334a446-ac9e-4f3b-8b73-c69ed6ada458",
      "name": "Write card copy and captions",
      "type": "@n8n/n8n-nodes-langchain.openAi",
      "position": [
        470,
        320
      ],
      "parameters": {
        "modelId": {
          "__rl": true,
          "mode": "list",
          "value": "gpt-4o-mini"
        },
        "options": {
          "temperature": 0.6
        },
        "messages": {
          "values": [
            {
              "role": "system",
              "content": "You write social posts that promote a new blog article. Be specific to the article, plain and useful. No hype words, no emojis in the card text, never invent facts that are not in the article. Reply with JSON only."
            },
            {
              "content": "=Article title: {{ $json.title }}\nCategory: {{ $json.category }}\nLink: {{ $json.link }}\nSummary: {{ $json.summary }}\n\nReturn JSON with these keys:\n- headline: the card headline, max 45 characters. Use the article title if it fits.\n- excerpt: one line for the card, max 70 characters, saying what the reader gets\n- tag: the topic in 1 or 2 words, max 16 characters\n- instagram_caption: 3 to 4 short lines, end with \"Link in bio\" and 3 to 5 hashtags. No URL.\n- linkedin_post: 4 to 6 short lines written for professionals, then the link on its own line\n- x_post: max 240 characters including the link\n- facebook_post: 2 to 3 sentences, then the link"
            }
          ]
        },
        "jsonOutput": true
      },
      "typeVersion": 1.8
    },
