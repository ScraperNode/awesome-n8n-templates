    {
      "id": "364dd3d7-ef83-5a98-9127-7c3051ad5a21",
      "name": "Build digest",
      "type": "n8n-nodes-base.code",
      "position": [
        900,
        120
      ],
      "parameters": {
        "jsCode": "const rows = $('Only new permits').all().map(i => i.json);\nif (!rows.length) return [];\nrows.sort((a, b) => (b.valuationUsd || 0) - (a.valuationUsd || 0));\nconst esc = s => String(s ?? '').replace(/[&<>]/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;' }[c]));\nconst fmt = n => n ? '$' + Math.round(n).toLocaleString('en-US') : '\u2014';\nconst tr = rows.slice(0, 100).map(r => `<tr><td>${esc(r.issuedDate)}</td><td>${esc(r.city)}</td><td>${esc(r.permitType)}</td><td>${esc((r.description || '').slice(0, 140))}</td><td style=\"text-align:right\">${fmt(r.valuationUsd)}</td><td>${esc(r.address)}</td><td><a href=\"${esc(r.sourceUrl)}\">source</a></td></tr>`).join('');\nconst html = `<h2>${rows.length} new building permits</h2><p>Top ${Math.min(rows.length, 100)} by valuation. Full list is in your Google Sheet.</p>\n<table border=\"1\" cellpadding=\"6\" cellspacing=\"0\" style=\"border-collapse:collapse;font-family:Arial;font-size:13px\">\n<tr style=\"background:#f3f3f3\"><th>Issued</th><th>City</th><th>Type</th><th>Description</th><th>Value</th><th>Address</th><th></th></tr>${tr}</table>`;\nreturn [{ json: { count: rows.length, html, to: $('CONFIG').first().json.digestEmail } }];"
      },
      "typeVersion": 2
    },
