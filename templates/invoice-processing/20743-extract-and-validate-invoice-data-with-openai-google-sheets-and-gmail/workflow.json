      "position": [
        2340,
        420
      ],
      "parameters": {
        "sendTo": "={{ $('CONFIG - Invoices').first().json.owner_email }}",
        "message": "Invoice {{ $json.invoice_number }} from {{ $json.vendor_name }} ({{ $json.total_amount }} {{ $json.currency }}) looks like a duplicate already in the log. It was NOT posted.",
        "options": {},
        "subject": "Duplicate invoice blocked: {{ $json.invoice_number }}",
        "resource": "message",
        "emailType": "text",
        "operation": "send"
      },
      "credentials": {
