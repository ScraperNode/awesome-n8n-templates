    {
      "id": "c78788fa-8fef-4156-8925-e0180fda6409",
      "name": "Render Block Kit UI",
      "type": "n8n-nodes-base.httpRequest",
      "position": [
        4160,
        688
      ],
      "parameters": {
        "url": "={{ $('Slack Event Listener').item.json.body.response_url }}",
        "method": "POST",
        "options": {},
        "jsonBody": "={{\n  JSON.stringify({\n    \"response_type\": \"in_channel\",\n    \"text\": ` Intelligence Report for $('Slack Event Listener').item.json.body.text is ready.`,\n    \"blocks\": [\n      {\n        \"type\": \"header\",\n        \"text\": {\n          \"type\": \"plain_text\",\n          \"text\": \" Negotiation Co-Pilot Intelligence Report\",\n          \"emoji\": true\n        }\n      },\n      {\n        \"type\": \"section\",\n        \"text\": {\n          \"type\": \"mrkdwn\",\n          \"text\": `*Supplier:* ${$('Slack Event Listener').item.json.body.text}\\n*Average Discount:* ${$('Set Profile Variables').item.json.pricing_flexibility_percentage}%\\n*Recommended Strategy:* ${$('Set Profile Variables').item.json.recommended_tactic}`\n        }\n      },\n      {\n        \"type\": \"divider\"\n      },\n      {\n        \"type\": \"section\",\n        \"text\": {\n          \"type\": \"mrkdwn\",\n          \"text\": ` *Scenario A: Cooperative*\\n> *If they:* ${$json.cooperative_scenario.supplier_reaction}\\n> *Your Move:* ${$json.cooperative_scenario.buyer_counter_tactic}`\n        }\n      },\n      {\n        \"type\": \"section\",\n        \"text\": {\n          \"type\": \"mrkdwn\",\n          \"text\": ` *Scenario B: Moderate Pushback*\\n> *If they:* ${$json.moderate_pushback_scenario.supplier_reaction}\\n> *Your Move:* ${$json.moderate_pushback_scenario.buyer_counter_tactic}`\n        }\n      },\n      {\n        \"type\": \"section\",\n        \"text\": {\n          \"type\": \"mrkdwn\",\n          \"text\": ` *Scenario C: Aggressive Pushback*\\n> *If they:* ${$json.aggressive_pushback_scenario.supplier_reaction}\\n> *Your Move:* ${$json.aggressive_pushback_scenario.buyer_counter_tactic}`\n        }\n      },\n      {\n        \"type\": \"divider\"\n      },\n      {\n        \"type\": \"actions\",\n        \"elements\": [\n          {\n            \"type\": \"button\",\n            \"text\": {\n              \"type\": \"plain_text\",\n              \"text\": \"Generate Live Counteroffer\",\n              \"emoji\": true\n            },\n            \"style\": \"primary\",\n            \"value\": JSON.stringify({\n  \"supplier_id\": $('Slack Event Listener').item.json.body.text,\n  \"strategy\": $('Set Profile Variables').item.json.recommended_tactic,\n  \"coop\": $json.cooperative_scenario.buyer_counter_tactic,\n  \"mod\": $json.moderate_pushback_scenario.buyer_counter_tactic,\n  \"agg\": $json.aggressive_pushback_scenario.buyer_counter_tactic\n}),\n            \"action_id\": \"button_counteroffer\"\n          }\n        ]\n      }\n    ]\n  })\n}}",
        "sendBody": true,
        "sendHeaders": true,
        "specifyBody": "json",
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json; charset=utf-8"
            }
          ]
        }
      },
      "typeVersion": 4.5
    },
