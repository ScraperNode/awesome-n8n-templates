      "parameters": {
        "color": 7,
        "width": 464,
        "height": 464,
        "content": "## Trigger and stage gate\n\nStarts when a Pipedrive deal is updated and checks whether the update represents entry into the Closed Won stage before allowing the automation to proceed."
      },
      "typeVersion": 1
    },
