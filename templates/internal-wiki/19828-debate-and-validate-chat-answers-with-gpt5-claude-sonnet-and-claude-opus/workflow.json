            }
          ]
        },
        "looseTypeValidation": true
      },
      "typeVersion": 2.2
    },
    {
      "id": "ea19f628-dd44-457a-97a8-5a80bf597665",
      "name": "Add reviewer feedback",
      "type": "n8n-nodes-base.code",
      "position": [
        -160,
        -200
      ],
      "parameters": {
        "jsCode": "const s = $input.first().json;\nconst list = s.objections.length ? s.objections : ['Improve accuracy and completeness.'];\nreturn [{ json: {\n  ...s,\n  round: s.round + 1,\n  feedback: 'Reviewer objections:\\n- ' + list.join('\\n- '),\n} }];"
      },
      "typeVersion": 2
    },
    {
      "id": "78ff2ed5-8ca3-4426-a1fa-16c003e9bd58",
      "name": "Judge",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "position": [
        320,
        64
      ],
      "parameters": {
        "text": "=Question: {{ $json.question }}\n\nDebater answer:\n{{ $json.debaterAnswer }}\n\nReviewer notes:\n{{ $json.reviewerNotes }}\n\nYou are the final judge. Decide with your own knowledge. Do not mention that you have no tools.\n\nReply with exactly one line:\nDECISION: {\"approved\": <true|false>, \"reason\": \"...\", \"final_answer\": \"...\"}\nSet approved=true if the answer is correct and fully answers the question. If you reject it, put your own corrected answer in final_answer. Keep reason short, two sentences at most.",
        "options": {
          "systemMessage": "You are an impartial final judge. Give a short reason for your decision."
        },
        "promptType": "define"
      },
      "typeVersion": 3.1
    },
    {
      "id": "3e49c1d1-29b8-4d38-8e86-9f48a946e7fe",
      "name": "Judge model: Google Gemini",
      "type": "@n8n/n8n-nodes-langchain.lmChatGoogleGemini",
      "position": [
        320,
        288
      ],
      "parameters": {
        "options": {},
        "modelName": "models/gemini-2.5-pro"
      },
      "credentials": {
        "googlePalmApi": {
          "name": "Google Gemini account"
        }
      },
      "typeVersion": 1
    },
    {
      "id": "7e6ada03-fa4c-45a5-9412-76cfc307e409",
      "name": "Parse decision",
      "type": "n8n-nodes-base.code",
      "position": [
        560,
        64
      ],
      "parameters": {
        "jsCode": "// Debate state that went into the judge (from whichever branch reached it)\nconst s = $('Parse verdict').last().json;\nconst out = $input.first().json.output || '';\n\nlet approved = false;\nlet reason = 'Judge decision could not be parsed.';\nlet finalAnswer = '';\nconst m = out.match(/DECISION:\\s*(\\{[\\s\\S]*\\})/);\nif (m) {\n  try {\n    const d = JSON.parse(m[1]);\n    approved = !!d.approved;\n    reason = d.reason || '';\n    finalAnswer = d.final_answer || '';\n  } catch (e) {}\n}\n\nreturn [{ json: { ...s, approved, reason, finalAnswer } }];"
      },
      "typeVersion": 2
    },
    {
      "id": "abb4c4b8-7af9-4ba0-bd40-bb2fcb57820b",
      "name": "Judge approved?",
      "type": "n8n-nodes-base.if",
      "position": [
        780,
        64
      ],
      "parameters": {
        "options": {},
        "conditions": {
          "options": {
            "version": 2,
            "leftValue": "",
            "caseSensitive": true,
            "typeValidation": "loose"
          },
          "combinator": "and",
          "conditions": [
