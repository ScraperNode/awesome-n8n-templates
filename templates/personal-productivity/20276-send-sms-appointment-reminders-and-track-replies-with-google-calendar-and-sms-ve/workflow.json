    {
      "id": "a46ab152-0cf5-4e2b-a4ca-6f78ad557579",
      "name": "Sort appointments",
      "type": "n8n-nodes-base.code",
      "position": [
        660,
        0
      ],
      "parameters": {
        "jsCode": "// Sorts the upcoming appointments: reminder to send, reply to check, or missing mobile number\nconst s = $('Settings').first().json;\nconst now = DateTime.now().setZone(s.timezone);\n\n// Nothing is sent or checked outside the sending hours: the next run catches up\nconst [startH, startM] = String(s.send_from).split(':').map(Number);\nconst [endH, endM] = String(s.send_until).split(':').map(Number);\nconst minutes = now.hour * 60 + now.minute;\nif (minutes < startH * 60 + (startM || 0) || minutes >= endH * 60 + (endM || 0)) return [];\n\n// Appointments already settled are left alone\nconst SETTLED = ['[Confirmed by SMS', '[Cancelled by SMS', '[SMS reminder not delivered'];\n\nfunction plainText(html) {\n  return String(html || '').replace(/<br\\s*\\/?>/gi, '\\n').replace(/<\\/(p|div|li)>/gi, '\\n').replace(/<[^>]+>/g, '').replace(/&nbsp;/g, ' ');\n}\nfunction findLine(text, labels) {\n  const m = text.match(new RegExp('(?:^|\\\\n)\\\\s*(?:' + labels + ')\\\\s*[:=]\\\\s*([^\\\\n]+)', 'i'));\n  return m ? m[1].trim() : '';\n}\nfunction normalizePhone(raw) {\n  let d = String(raw || '').replace(/[^0-9+]/g, '');\n  if (d.startsWith('+')) d = d.slice(1);\n  else if (d.startsWith('00')) d = d.slice(2);\n  else if (d.startsWith('0')) d = String(s.default_country_code) + d.slice(1);\n  return /^[0-9]{10,15}$/.test(d) ? d : '';\n}\n\nconst out = [];\nfor (const item of $input.all()) {\n  const ev = item.json;\n  if (ev.status === 'cancelled' || !ev.start || !ev.start.dateTime) continue; // all-day or cancelled\n  const start = DateTime.fromISO(ev.start.dateTime).setZone(s.timezone).setLocale(s.locale);\n  if (start < now) continue; // already started\n  const description = String(ev.description || '');\n  if (SETTLED.some(tag => description.includes(tag))) continue;\n\n  const text = plainText(description) + '\\n' + String(ev.location || '');\n  const phone = normalizePhone(findLine(text, 'phone|mobile|tel|t\u00e9l\u00e9phone|portable'));\n  const name = findLine(text, 'name|nom|client') || String(ev.summary || '').trim();\n  const appointment = {\n    event_id: ev.id,\n    summary: String(ev.summary || ''),\n    name,\n    phone,\n    when: start.toFormat(s.date_format) + ' ' + start.toFormat('HH:mm'),\n    description_prefix: description ? description + (/<[a-z][^>]*>/i.test(description) ? '<br><br>' : '\\n\\n') : '',\n  };\n\n  // Reminder already sent: look for the client's reply\n  const sent = description.match(/\\[SMS reminder sent [^\\]]*campaign ([\\w-]+)\\]/);\n  if (sent) { out.push({ json: { ...appointment, action: 'check_reply', campaign_id: sent[1] } }); continue; }\n\n  // Failed or flagged: fix the event, then remove the tag to retry\n  if (description.includes('[SMS reminder')) continue;\n\n  if (!phone) { out.push({ json: { ...appointment, action: 'missing_phone' } }); continue; }\n\n  const message = String(s.message_template)\n    .replace(/\\{name\\}/g, name)\n    .replace(/\\{date\\}/g, start.toFormat(s.date_format))\n    .replace(/\\{time\\}/g, start.toFormat('HH:mm'))\n    .replace(/\\{business\\}/g, s.business_name)\n    .replace(/\\p{Extended_Pictographic}|\ufe0f/gu, '') // emojis are not allowed in SMS\n    .replace(/\\s{2,}/g, ' ').trim();\n  out.push({ json: { ...appointment, action: 'send_reminder', message } });\n}\nreturn out;"
      },
      "typeVersion": 2
    },
