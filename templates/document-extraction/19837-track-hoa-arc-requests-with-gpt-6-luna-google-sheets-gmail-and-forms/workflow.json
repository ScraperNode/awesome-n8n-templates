    {
      "id": "68686214-706f-43c7-90ae-6a2610848b5c",
      "name": "Find Near Deadline",
      "type": "n8n-nodes-base.code",
      "position": [
        560,
        1344
      ],
      "parameters": {
        "jsCode": "const rows = $input.all().map(function (i) { return i.json; });\nconst todayStr = $now.toFormat('yyyy-MM-dd');\nconst lines = [];\nlet near = 0; let pending = 0;\nfor (const r of rows) {\n  if (!r || String(r.status || '').trim() !== 'pending') continue;\n  pending++;\n  let daysLeft = null;\n  if (r.deadline_date) {\n    const d = new Date(String(r.deadline_date).slice(0, 10) + 'T23:59:59');\n    if (!isNaN(d.getTime())) daysLeft = Math.floor((d.getTime() - Date.now()) / 86400000);\n  }\n  if (daysLeft !== null && daysLeft <= 5) {\n    near++;\n    lines.push((r.arc_id || '?') + ' | ' + (r.owner_name || '?') + ' | ' + (r.mod_type || '?') + ' | deadline ' + (r.deadline_date || '?') + ' (' + daysLeft + ' day' + (daysLeft === 1 ? '' : 's') + ' left)');\n  }\n}\nreturn [{ json: { today: todayStr, pending: pending, near_count: near, has_near: near > 0,\n  lines: lines.join(String.fromCharCode(10)) || 'none' } }];"
      },
      "typeVersion": 2
    },
