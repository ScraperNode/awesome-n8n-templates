    {
      "id": "a7c0a001-0000-4000-8000-000000000018",
      "name": "Send deals to Telegram",
      "type": "n8n-nodes-base.telegram",
      "position": [
        1660,
        240
      ],
      "webhookId": "a7c0a001w-0000-4000-8000-000000000001",
      "parameters": {
        "text": "={{ (() => { const esc = s => String(s ?? '').replaceAll('&', '&amp;').replaceAll('<', '&lt;').replaceAll('>', '&gt;');\nconst cars = $json.items;\nconst money = n => '$' + Number(n).toLocaleString('en-US');\nconst lines = cars.slice(0, 20).map(c => {\n  const vs = c['Vs market (%)'] !== '' ? ' (' + (Number(c['Vs market (%)']) > 0 ? '+' : '') + c['Vs market (%)'] + '% vs market)' : '';\n  return '\ud83d\ude97 <b><a href=\"' + c.Link + '\">' + esc([c.Year, c.Make, c.Model, String(c.Trim || '').slice(0, 40)].filter(Boolean).join(' ')) + '</a></b>\\n'\n    + money(c['Price (CAD)']) + esc(vs) + ' \u00b7 ' + Number(c['Mileage (km)'] || 0).toLocaleString('en-US') + ' km\\n'\n    + esc([c.City, c.Province].filter(Boolean).join(', ')) + ' \u00b7 ' + esc(c['Seller type']) + (c.Seller ? ': ' + esc(c.Seller) : '');\n});\nreturn '<b>' + cars.length + ' new AutoTrader.ca ' + ($('Set your search').first().json.dealsOnly ? 'deal' : 'car') + (cars.length === 1 ? '' : 's') + '</b>\\n\\n' + lines.join('\\n\\n')\n  + (cars.length > 20 ? '\\n\\n+ ' + (cars.length - 20) + ' more in your Google Sheet' : '');\n})() }}",
        "chatId": "={{ $('Set your search').first().json.telegramChatId }}",
        "additionalFields": {
          "parse_mode": "HTML",
          "appendAttribution": false,
          "disable_web_page_preview": true
        }
      },
      "typeVersion": 1.2
    }
