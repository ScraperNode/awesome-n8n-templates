        "options": {},
        "jsonBody": "={{ (() => {\n  const r = $('Build Valid Record').item.json;\n  return JSON.stringify({\n    replyToken: r.replyToken,\n    messages: [{\n      type: 'text',\n      text: `\ud83e\uddfe \u7d4c\u8cbb\u8a18\u9332\u304c\u5b8c\u4e86\u3057\u307e\u3057\u305f\n\n\u3010\u5229\u7528\u5e97\u8217\u3011${r.vendor_name}\n\u3010\u652f\u6255\u65e5\u3011${r.receipt_date}\n\u3010\u652f\u6255\u91d1\u984d\u3011\u00a5${Number(r.total_amount).toLocaleString()}\uff08\u5185\u6d88\u8cbb\u7a0e: \u00a5${Number(r.tax_amount).toLocaleString()}\uff09\n\u3010\u52d8\u5b9a\u79d1\u76ee\u3011${r.category}\n\u3010\u30a4\u30f3\u30dc\u30a4\u30b9\u756a\u53f7\u3011${r.invoice_number}\n \u2514 \u5224\u5b9a: ${r.invoice_valid}${r.verified_company_name !== 'Unregistered' ? `\uff08${r.verified_company_name}\uff09` : ''}\n\u3010\u6458\u8981\u3011${r.description}\n\n\ud83d\udcc1 Google Drive\u3078\u306e\u4fdd\u5b58\u3068\u30b9\u30d7\u30ec\u30c3\u30c9\u30b7\u30fc\u30c8\u3078\u306e\u8a18\u5e33\u304c\u5b8c\u4e86\u3057\u307e\u3057\u305f\u3002`\n    }]\n  });\n})() }}",
        "sendBody": true,
        "specifyBody": "json",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth"
      },
      "typeVersion": 4.2
    },
