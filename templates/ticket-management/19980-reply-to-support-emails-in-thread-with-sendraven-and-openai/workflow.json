      "name": "Signature valid?",
      "type": "n8n-nodes-base.if",
      "position": [
        280,
        0
      ],
      "parameters": {
        "options": {},
        "conditions": {
          "options": {
            "version": 2,
            "leftValue": "",
            "caseSensitive": true,
            "typeValidation": "loose"
          },
          "combinator": "and",
          "conditions": [
            {
              "id": "bc0b8ef1-7930-53f5-bb12-1fa45d5be263",
              "operator": {
                "type": "string",
                "operation": "equals"
              },
              "leftValue": "={{ ($('SendRaven webhook').item.json.headers['x-cn-signature'] || '').match(/v1=([0-9a-f]+)/)?.[1] ?? '' }}",
              "rightValue": "={{ $json.expected_signature }}"
            },
            {
              "id": "bb81ede4-abba-57da-989c-21727b0b657c",
              "operator": {
                "type": "number",
                "operation": "lt"
              },
              "leftValue": "={{ Math.abs($now.toSeconds() - Number(($('SendRaven webhook').item.json.headers['x-cn-signature'] || '').match(/t=(\\d+)/)?.[1] ?? 0)) }}",
              "rightValue": 300
            }
          ]
        }
      },
      "typeVersion": 2.2
    },
