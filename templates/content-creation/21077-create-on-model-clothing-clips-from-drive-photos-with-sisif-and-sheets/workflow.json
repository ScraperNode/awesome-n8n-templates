              "value": "=data:{{ $('Download Photo').item.binary.data.mimeType || 'image/jpeg' }};base64,{{ $json.image_base64 }}"
            }
          ]
        },
        "genericAuthType": "httpBearerAuth"
      },
      "credentials": {
        "httpBearerAuth": {
          "id": "",
          "name": "Sisif API (Bearer)"
        }
