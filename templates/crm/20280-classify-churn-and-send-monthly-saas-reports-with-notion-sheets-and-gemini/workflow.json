    {
      "id": "3552de14-a4e6-4004-bf84-f11d337b5285",
      "name": "Calculate Monthly Metrics",
      "type": "n8n-nodes-base.code",
      "position": [
        -1568,
        816
      ],
      "parameters": {
        "jsCode": "// Dynamically determine the previous month for reporting\nconst now = new Date();\nconst targetDate = new Date(now.getFullYear(), now.getMonth() - 1, 1);\nconst targetMonth = targetDate.getMonth(); \nconst targetYear = targetDate.getFullYear();\n\nconst monthNames = [\"January\", \"February\", \"March\", \"April\", \"May\", \"June\", \"July\", \"August\", \"September\", \"October\", \"November\", \"December\"];\nconst reportMonthName = `${monthNames[targetMonth]} ${targetYear}`;\n\nlet involuntaryCount = 0;\nlet voluntaryCount = 0;\nlet involuntaryRevenue = 0;\nlet voluntaryRevenue = 0;\n\nfor (const item of $input.all()) {\n  const rowDateStr = item.json['Cancellation Date'];\n  \n  if (!rowDateStr) continue;\n  \n  const rowDate = new Date(rowDateStr);\n  \n  // Only process rows that match the target reporting month and year\n  if (rowDate.getMonth() === targetMonth && rowDate.getFullYear() === targetYear) {\n    const revenue = Number(item.json['Lost Revenue']) || 0;\n    const churnType = item.json['Churn Type'];\n\n    if (churnType === 'Involuntary') {\n      involuntaryCount += 1;\n      involuntaryRevenue += revenue;\n    } else if (churnType === 'Voluntary') {\n      voluntaryCount += 1;\n      voluntaryRevenue += revenue;\n    }\n  }\n}\n\nreturn [\n  {\n    json: {\n      \"Report Month\": reportMonthName,\n      \"Involuntary Churn Count\": involuntaryCount,\n      \"Voluntary Churn Count\": voluntaryCount,\n      \"Involuntary Revenue Lost\": involuntaryRevenue,\n      \"Voluntary Revenue Lost\": voluntaryRevenue,\n      \"Total Revenue Lost\": involuntaryRevenue + voluntaryRevenue\n    }\n  }\n];"
      },
      "typeVersion": 2
    },
