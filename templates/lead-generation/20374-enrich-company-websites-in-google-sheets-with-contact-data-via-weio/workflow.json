    {
      "id": "774b2bd5-e243-41c8-b059-4790ff2f6454",
      "name": "Look up website facts",
      "type": "n8n-nodes-base.httpRequest",
      "onError": "continueRegularOutput",
      "maxTries": 3,
      "position": [
        1660,
        60
      ],
      "parameters": {
        "url": "https://weio.ai/api/site-info",
        "options": {
          "timeout": 90000,
          "response": {
            "response": {
              "neverError": true,
              "fullResponse": true
            }
          }
        },
        "sendQuery": true,
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "queryParameters": {
          "parameters": [
            {
              "name": "d",
              "value": "={{ $json.domain }}"
            }
          ]
        }
      },
      "retryOnFail": true,
      "typeVersion": 4.2,
      "waitBetweenTries": 5000
    },
    {
      "id": "fb75cd2c-6275-425b-87b9-1171e0af48d6",
      "name": "Normalize result",
      "type": "n8n-nodes-base.code",
      "position": [
        1880,
        60
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Turns one Weio site-info answer into the columns written back to the sheet.\n// API fields: ok, reachable, error, title, description, cms, mobile_viewport, role_emails, phones,\n// social {facebook, instagram, linkedin, x, youtube, ...}, contact_page, certificate_error, credits_remaining.\nconst BUY = 'https://weio.ai/services/site-check-api.html';\nconst lead = $('Loop over leads').item.json;\nconst res = $json;\nlet body = res.body;\nif (typeof body === 'string') {\n  try { body = JSON.parse(body); } catch (e) { body = { error: body.slice(0, 200) }; }\n}\nbody = body && typeof body === 'object' ? body : {};\nconst code = Number(res.statusCode) || 0;\nconst out = {\n  website: lead.website, domain: lead.domain, outcome: '', enrich_status: '',\n  enriched_at: new Date().toISOString().replace(/\\.\\d+Z$/, 'Z'),\n  site_title: '', site_description: '', cms: '', mobile_friendly: '',\n  emails: '', phones: '', contact_page: '', linkedin: '', facebook: '', instagram: '', other_socials: '',\n  credits_remaining: typeof body.credits_remaining === 'number' ? body.credits_remaining : null,\n};\n// not charged, try again next run: keep the old date so the row stays due\nconst retry = why => Object.assign(out, { outcome: 'retry', enriched_at: lead.previous_enriched_at || '',\n  enrich_status: 'retry next run: ' + String(why).slice(0, 150) });\n\nif (!code) {   // the request itself failed 3 times (network, DNS, timeout)\n  const e = res.error;\n  retry(!e ? 'no answer from the API' : typeof e === 'string' ? e : e.message || JSON.stringify(e));\n} else if (code === 401 || code === 402 || code === 403) {\n  out.outcome = 'key_problem';\n  out.enrich_status = 'Weio API key problem (HTTP ' + code + '): ' + (body.error || 'key not accepted') +\n    '. Check the \"Weio API key\" Header Auth credential (Authorization: Bearer YOUR_TOKEN_HERE) or get credits at ' + BUY;\n} else if (code === 400) {\n  out.outcome = 'invalid';\n  out.enrich_status = 'not a valid website address (no credit used)';\n} else if (code !== 200 || body.ok !== true) {\n  retry(body.error || 'HTTP ' + code);                                   // 429 rate limit, 503 busy, others\n} else if (!body.reachable) {\n  out.outcome = 'unreachable';\n  out.enrich_status = 'website unreachable' + (body.error ? ' (' + body.error + ')' : '');\n} else {\n  const social = body.social || {};\n  const main = ['linkedin', 'facebook', 'instagram'];\n  for (const k of main) out[k] = social[k] || '';\n  out.other_socials = Object.keys(social).filter(k => !main.includes(k)).map(k => k + ': ' + social[k]).join(', ');\n  out.site_title = body.title || '';\n  out.site_description = body.description || '';\n  out.cms = body.cms || '';\n  out.mobile_friendly = body.mobile_viewport ? 'yes' : 'no';\n  const emails = body.role_emails || [], phones = body.phones || [];\n  out.emails = emails.join(', ');\n  out.phones = phones.join(', ');\n  out.contact_page = body.contact_page || '';\n  const found = [];\n  if (emails.length) found.push(emails.length + (emails.length === 1 ? ' email' : ' emails'));\n  if (phones.length) found.push(phones.length + (phones.length === 1 ? ' phone' : ' phones'));\n  if (out.contact_page) found.push('contact page');\n  if (Object.keys(social).length) found.push(Object.keys(social).length + ' social profile(s)');\n  out.outcome = found.length ? 'contacts' : 'no_contacts';\n  out.enrich_status = found.length ? 'enriched: ' + found.join(', ') : 'no public contact details found';\n  if (body.certificate_error) out.enrich_status += ' (HTTPS certificate problem: browsers show a warning)';\n}\nreturn { json: out };"
      },
      "typeVersion": 2
    },
