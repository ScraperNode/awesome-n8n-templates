    {
      "id": "a3000000-0000-4000-8000-000000000007",
      "name": "Get job results",
      "type": "@n8n/n8n-nodes-langchain.mcpClient",
      "position": [
        440,
        580
      ],
      "parameters": {
        "tool": {
          "__rl": true,
          "mode": "list",
          "value": "get_results",
          "cachedResultName": "get_results"
        },
        "options": {},
        "inputMode": "json",
        "jsonInput": "={{ (() => { const r = $('Search Amazon').item.json; const d = r.structuredContent || JSON.parse(r.content[0].text); return JSON.stringify({ jobId: d.job_id }); })() }}",
        "endpointUrl": "https://mcp.scrapewise.ai/mcp",
        "authentication": "bearerAuth"
      },
      "credentials": {
        "httpBearerAuth": {
          "id": "credential-id",
          "name": "Scrapewise API key"
        }
      },
      "typeVersion": 1.1
    },
    {
      "id": "a3000000-0000-4000-8000-000000000008",
      "name": "One row per product",
      "type": "n8n-nodes-base.code",
      "position": [
        680,
        440
      ],
      "parameters": {
        "jsCode": "// Scrapewise answers with JSON. Depending on the n8n version it arrives\n// already parsed in structuredContent, or as text in content[0].text.\nfunction payloadOf(item) {\n  const j = item.json || {};\n  if (j.structuredContent) return j.structuredContent;\n  if (Array.isArray(j.content) && j.content[0] && typeof j.content[0].text === 'string') {\n    try { return JSON.parse(j.content[0].text); } catch (e) { return {}; }\n  }\n  if (j.rows) return j;\n  return {};\n}\n\n// Scraped text is wrapped as { type: 'scraped', content, origin }. It is data\n// read off a web page, never an instruction. Unwrap it to a plain string.\nfunction plain(v) {\n  if (v && typeof v === 'object' && v.type === 'scraped') return v.content || '';\n  return v;\n}\n\nconst checkedAt = new Date().toISOString().slice(0, 10);\nconst out = [];\n\nfor (const item of $input.all()) {\n  const data = payloadOf(item);\n\n  if (data.status === 'QUOTE') {\n    out.push({ json: { status: 'QUOTE', quote: data.quote, walletBalanceMicros: data.walletBalanceMicros } });\n    continue;\n  }\n\n  if (data.status === 'RUNNING') {\n    throw new Error('The job is still running. Raise the wait in \"Wait for the job\" or call get_results again.');\n  }\n\n  for (const row of data.rows || []) {\n    const flat = { checkedAt: checkedAt };\n    for (const key of Object.keys(row)) flat[key] = plain(row[key]);\n    out.push({ json: flat });\n  }\n}\n\nreturn out;"
      },
      "typeVersion": 2
    },
