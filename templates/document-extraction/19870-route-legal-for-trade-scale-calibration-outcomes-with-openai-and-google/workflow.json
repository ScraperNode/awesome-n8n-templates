    {
      "id": "2971c94d-29da-4e65-99b2-732fbb79490c",
      "name": "Classify Compliance Status",
      "type": "@n8n/n8n-nodes-langchain.textClassifier",
      "onError": "continueRegularOutput",
      "maxTries": 3,
      "position": [
        2272,
        -96
      ],
      "parameters": {
        "options": {
          "systemPromptTemplate": "You are a state weights-and-measures compliance classifier applying NIST Handbook 44. Combine the numeric status_hint with the technician's qualitative notes to pick exactly one category. Numeric out-of-tolerance alone is not automatically condemned \u2014 only classify condemned if the notes describe physical damage or repeated failure."
        },
        "inputText": "=Numeric status hint: {{$json.status_hint}}. Deviation: {{$json.deviation_pct}}%. Technician notes: {{$json.technician_notes || 'none'}}.",
        "categories": {
          "categories": [
            {
              "category": "compliant",
              "description": "In-tolerance or adjustable-and-now-in-tolerance; safe to certify and return to service"
            },
            {
              "category": "out_of_tolerance_fail",
              "description": "Outside tolerance and not fixable by simple adjustment, or technician notes describe a functional defect"
            },
            {
              "category": "condemned",
              "description": "Device is damaged, unsafe, or beyond economical repair per technician notes or repeated failure"
            }
          ]
        }
      },
      "retryOnFail": true,
      "typeVersion": 1,
      "waitBetweenTries": 2000
    },
    {
      "id": "bb40f355-a589-421b-8b4f-dcaa6eb1f74e",
      "name": "Route By Compliance Status",
      "type": "n8n-nodes-base.switch",
      "position": [
        2736,
        -80
      ],
      "parameters": {
        "rules": {
          "values": [
            {
              "outputKey": "Compliant",
              "conditions": {
                "options": {
                  "version": 2,
                  "caseSensitive": true,
                  "typeValidation": "strict"
                },
                "combinator": "and",
                "conditions": [
                  {
                    "id": "s1",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    },
                    "leftValue": "={{ $json.output.category }}",
