      "name": "Prepare messages",
      "type": "n8n-nodes-base.code",
      "position": [
        1100,
        0
      ],
      "parameters": {
        "jsCode": "// Opted-out numbers (STOP replies) returned by the SMS Vert Pro MCP server\nconst blacklist = ($('Get STOP list').first().json.structuredContent?.blacklist || []).map(b => String(b.gsm));\nconst settings = $('Campaign settings').first().json;\n\nreturn $('Only contacts not yet sent').all().map(item => {\n  const phone = String(item.json.phone || '').replace(/[^0-9]/g, '');\n  const firstname = String(item.json.firstname || '').trim();\n  return { json: {\n    row_number: item.json.row_number,\n    phone,\n    message: (settings.message_template.replace(/\\{firstname\\}/g, firstname) + ' ' + (settings.opt_out_mention || '')).trim(),\n    sender: settings.sender,\n    opted_out: blacklist.includes(phone),\n  } };\n});"
      },
      "typeVersion": 2
    },
