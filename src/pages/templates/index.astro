---
import BaseLayout from '../../layouts/BaseLayout.astro';
import HubTable from '../../components/HubTable.astro';
import { formatCount, getCategories, getTotals } from '../../lib/catalog';

const [categories, totals] = await Promise.all([getCategories(), getTotals()]);
const base = import.meta.env.BASE_URL;
---

<BaseLayout
  title="Browse by Category"
  description={`${formatCount(totals.templates)}+ n8n workflow templates organized into ${totals.categories} categories.`}
>
  <h1>📂 Browse by Category</h1>
  <blockquote>
    <p><strong>{formatCount(totals.templates)} templates</strong> across {totals.categories} categories.</p>
  </blockquote>
  <p>
    Every template is filed under the category that best describes what it does. You can also browse by
    <a href={`${base}use-cases/`}>use case</a> or by <a href={`${base}integrations/`}>integration</a>.
  </p>
  <HubTable hubs={categories} section="templates" label="Category" />
</BaseLayout>
