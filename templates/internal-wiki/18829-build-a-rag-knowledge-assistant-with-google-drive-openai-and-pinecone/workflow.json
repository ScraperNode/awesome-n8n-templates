          ]
        }
      },
      "typeVersion": 2.2
    },
    {
      "id": "eb77816e-29c7-4acc-9cc9-0916eb9d8e88",
      "name": "Format RAG Response1",
      "type": "n8n-nodes-base.set",
      "position": [
        1376,
        1376
      ],
      "parameters": {
        "options": {},
        "assignments": {
          "assignments": [
            {
              "id": "440ae6c9-be8b-49a3-92ca-7c2eb4e42bbb",
              "name": "success",
              "type": "boolean",
              "value": true
            },
            {
              "id": "8dee6b4b-57f9-4aa2-b2ef-b3238a1e8ac9",
              "name": "question",
              "type": "string",
              "value": "={{ $('Validate & Normalize Query1').item.json.question }}"
            },
            {
              "id": "5d004692-9d68-41e1-8f81-f5810e695f77",
              "name": "answer",
              "type": "string",
              "value": "={{ $json.output || $json.text || $json.answer || JSON.stringify($json) }}"
