      "parameters": {
        "jsCode": "const n = Number(String($input.first().json.data.decision).replace(/\\D/g, ''));\nconst m = $('Build Slack Message').first().json;\nconst v = m.variants.find(x => x.variant === n);\nif (!v || !v.video_url) throw new Error(`Variant ${n} has no video`);\nreturn [{ json: { video_url: v.video_url, caption: m.caption } }];"
      },
      "typeVersion": 2
    },
