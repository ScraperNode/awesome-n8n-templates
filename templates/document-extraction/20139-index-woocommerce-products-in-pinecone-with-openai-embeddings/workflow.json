    {
      "id": "7e887840-3022-4bd2-8af6-193015b9c018",
      "name": "Format Product Data",
      "type": "n8n-nodes-base.code",
      "position": [
        3072,
        336
      ],
      "parameters": {
        "jsCode": "function stripHtml(html) {\n  if (!html) return '';\n  const cp = (n) => { try { return String.fromCodePoint(n); } catch (e) { return ''; } };\n  return String(html)\n    .replace(/<(script|style)[\\s\\S]*?<\\/\\1>/gi, ' ')\n    .replace(/<br\\s*\\/?>/gi, ' ')\n    .replace(/<\\/?(p|div|li|ul|ol|h[1-6]|tr|td|th|table|blockquote|section|article)(\\s[^>]*)?>/gi, ' ')\n    .replace(/<[^>]+>/g, '')\n    .replace(/&nbsp;/g, ' ')\n    .replace(/&lt;/g, '<')\n    .replace(/&gt;/g, '>')\n    .replace(/&quot;/g, '\"')\n    .replace(/&#(\\d+);/g, (m, n) => cp(Number(n)))\n    .replace(/&#x([0-9a-f]+);/gi, (m, h) => cp(parseInt(h, 16)))\n    .replace(/&amp;/g, '&')\n    .replace(/\\s+/g, ' ')\n    .trim();\n}\n\nconst p = $('Batch Process Products').item.json;\nconst currency = $('Set API Settings').first().json.wooCurrency || '';\n\nlet lines = [];\nlines.push('Name: ' + (p.name || ''));\nif (p.sku) lines.push('SKU: ' + p.sku);\nif (p.categories && p.categories.length) lines.push('Categories: ' + p.categories.map(c => c.name).join(', '));\nconst desc = stripHtml(p.description) || stripHtml(p.short_description);\nif (desc) lines.push('Description: ' + desc);\n\nif (p.type !== 'variable') {\n  if (p.price) lines.push('Price: ' + p.price + ' ' + currency);\n  lines.push('Availability: ' + (p.stock_status === 'instock' ? 'in stock' : (p.stock_status === 'onbackorder' ? 'on backorder' : 'out of stock')) + (p.stock_quantity != null ? ' (' + p.stock_quantity + ' pcs)' : ''));\n}\n\nlet variations = [];\ntry {\n  if ($('Fetch Product Variations').isExecuted) {\n    variations = $('Fetch Product Variations').all().map(it => it.json).filter(v => v && v.id);\n  }\n} catch (e) { variations = []; }\nif (variations.length) {\n  lines.push('--- Variants ---');\n  for (const v of variations) {\n    const attrs = (v.attributes || []).map(a => a.name + ': ' + a.option).join(', ');\n    const stock = v.stock_status === 'instock' ? 'in stock' : (v.stock_status === 'onbackorder' ? 'on backorder' : 'out of stock');\n    const qty = v.stock_quantity != null ? ' (' + v.stock_quantity + ' pcs)' : '';\n    lines.push((attrs || ('Variant ' + v.id)) + ' - Price: ' + (v.price || p.price || '') + ' ' + currency + ' - Availability: ' + stock + qty + (v.sku ? ' - SKU: ' + v.sku : ''));\n  }\n}\n\nlet reviews = [];\ntry {\n  if ($('Fetch Product Reviews').isExecuted) {\n    reviews = $('Fetch Product Reviews').all().map(it => it.json).filter(r => r && r.review);\n  }\n} catch (e) { reviews = []; }\nif (reviews.length) {\n  lines.push('--- Customer reviews (' + (p.average_rating || '?') + '/5, ' + (p.rating_count || reviews.length) + ' reviews) ---');\n  for (const r of reviews.slice(0, 5)) {\n    lines.push('Rating ' + r.rating + '/5: ' + stripHtml(r.review).slice(0, 250));\n  }\n}\n\nconst content = lines.join('\\n');\nreturn [{ json: {\n  content: content,\n  title: p.name || '',\n  source: p.permalink || '',\n  fileId: 'wc_product_' + p.id,\n  objectId: p.id,\n  dateModified: p.date_modified,\n  price: (p.type === 'variable' ? (p.price || '') : (p.price || '')),\n  currency: currency,\n  quantity: p.stock_quantity != null ? p.stock_quantity : (p.stock_status === 'instock' ? 'in stock' : 'out of stock'),\n  productCode: p.sku || '',\n  link: p.permalink || '',\n  image: (p.images && p.images[0]) ? p.images[0].src : '',\n  entity: 'product',\n  docType: ''\n} }];"
      },
      "typeVersion": 2
    },
