    {
      "id": "82cd340a-f8b2-413d-99a6-088eb105d3f6",
      "name": "AI Escalation Check",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "maxTries": 3,
      "position": [
        2352,
        368
      ],
      "parameters": {
        "text": "={{ (() => { const r = $('Loop Over Reviews').first().json; const a = JSON.parse($('Analyze Review with AI').first().json.output); const g = JSON.parse($('Generate AI Response').first().json.output); return JSON.stringify({ rating: r.rating, review_text: r.review_text, sentiment: a.sentiment, topics: a.topics, urgency: a.urgency, drafted_reply: g.response }); })() }}",
        "options": {
          "systemMessage": "You decide whether a customer review needs human attention before a public reply is posted. Escalate for: serious complaint, threat of legal action, safety concern, repeated service failure, highly emotional complaint, refund or compensation request, allegation of misconduct, or if the drafted reply makes promises, admits liability, or invents facts. Use only the information given. Return ONLY valid JSON: {\"needs_human_approval\": boolean, \"priority\": \"low | medium | high\", \"reason\": \"short reason, empty if none\"}."
        },
        "promptType": "define"
      },
      "retryOnFail": false,
      "typeVersion": 1.7,
      "waitBetweenTries": 2000
    },
    {
      "id": "01069607-6dab-4190-a73e-bd86d156f39d",
      "name": "Build Review Record",
      "type": "n8n-nodes-base.code",
      "position": [
        2704,
        368
      ],
      "parameters": {
        "jsCode": "const r = $('Loop Over Reviews').first().json;\nconst parse = (n) => JSON.parse($(n).first().json.output);\nconst a = parse('Analyze Review with AI');\nconst g = parse('Generate AI Response');\nconst e = parse('AI Escalation Check');\n\nconst allowed = ['service','staff','price','quality','delivery','waiting_time','product','communication','cleanliness','support'];\nconst topics = (Array.isArray(a.topics) ? a.topics : []).filter(t => allowed.includes(t));\nconst sentiment = ['positive','neutral','negative'].includes(a.sentiment) ? a.sentiment : 'neutral';\nconst urgency = ['low','medium','high'].includes(a.urgency) ? a.urgency : 'medium';\nconst rating = Number(r.rating);\n\n// Deterministic guardrails on top of the AI decision\nconst risk = /(lawyer|legal action|sue |lawsuit|police|food poisoning|got sick|unsafe|injur|harass|discriminat|scam|fraud|refund|compensat)/i;\nconst reasons = [];\nif (e.needs_human_approval) reasons.push(e.reason || 'Flagged by AI escalation check');\nif (a.needs_escalation) reasons.push(a.reason_for_escalation || 'Flagged during analysis');\nif (rating <= 2) reasons.push('Low rating (' + rating + '/5)');\nif (urgency === 'high') reasons.push('High urgency');\nif (risk.test(r.review_text)) reasons.push('Sensitive keywords detected');\nconst needs_approval = reasons.length > 0;\n\nlet priority = ['low','medium','high'].includes(e.priority) ? e.priority : (needs_approval ? 'medium' : 'low');\nif (urgency === 'high' || rating <= 1 || risk.test(r.review_text)) priority = 'high';\n\nreturn [{ json: {\n  review_id: r.review_id, business_id: r.business_id, business_name: r.business_name,\n  customer_name: r.customer_name, rating, review_text: r.review_text, review_date: r.review_date,\n  sentiment, topics, customer_intent: a.customer_intent || '', urgency, priority,\n  ai_response: g.response || '',\n  needs_approval, escalation_reason: [...new Set(reasons)].join('; '),\n  approval_status: needs_approval ? 'pending' : 'not_required',\n  response_status: 'pending',\n  status: needs_approval ? 'pending_approval' : 'analyzed'\n} }];"
      },
      "typeVersion": 2
    },
