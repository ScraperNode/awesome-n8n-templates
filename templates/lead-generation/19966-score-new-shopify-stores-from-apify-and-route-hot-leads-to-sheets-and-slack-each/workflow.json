      ],
      "parameters": {
        "jsCode": "// Position saved by the last successful run (active workflows only).\nconst saved = $getWorkflowStaticData('global').cursor;\nreturn [{ json: { cursor: String(saved ?? $('Set your settings').first().json.startCursor) } }];"
      },
      "typeVersion": 2
    },
    {
      "id": "4efe1173-1c85-5f33-bfb1-c23471f86450",
      "name": "Get new Shopify stores (Apify)",
      "type": "n8n-nodes-base.httpRequest",
      "position": [
        580,
        300
      ],
      "parameters": {
        "url": "https://api.apify.com/v2/acts/prelaunch-radar~new-shopify-stores-pre-launch-radar/run-sync-get-dataset-items",
        "method": "POST",
        "options": {
          "timeout": 300000
        },
        "jsonBody": "={{ JSON.stringify({ mode: 'feed', cursor: $('Load cursor').first().json.cursor, status: $('Set your settings').first().json.status, countries: $('Set your settings').first().json.fetchCountries.split(',').map(c => c.trim().toUpperCase()).filter(c => c), maxItems: $('Set your settings').first().json.maxItems }) }}",
        "sendBody": true,
        "specifyBody": "json",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth"
      },
      "typeVersion": 4.2,
      "alwaysOutputData": true
    },
    {
