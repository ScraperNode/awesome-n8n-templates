      ],
      "parameters": {
        "jsCode": "const d = $('Prepare the analysis').first().json;\nconst ai = $input.first().json.output || {};\n\nconst arrow = c => c === null || c === undefined ? 'new' : (c > 0 ? '+' + c + '%' : c + '%');\nconst list  = a => (a || []).map(x => '<li>' + x + '</li>').join('');\n\nconst row = e => '<tr>'\n  + '<td style=\"padding:6px 10px;border-bottom:1px solid #eee;\">' + e.title + '</td>'\n  + '<td style=\"padding:6px 10px;border-bottom:1px solid #eee;text-align:right;\">' + e.plays + '</td>'\n  + '<td style=\"padding:6px 10px;border-bottom:1px solid #eee;text-align:right;\">' + e.retention + '%</td>'\n  + '<td style=\"padding:6px 10px;border-bottom:1px solid #eee;text-align:right;\">' + e.score + '</td>'\n  + '<td style=\"padding:6px 10px;border-bottom:1px solid #eee;text-align:right;\">' + arrow(e.change) + '</td>'\n  + '</tr>';\n\nconst head = '<tr style=\"background:#f4f4f5;\">'\n  + ['Episode','Plays','Retention','Score','vs last week']\n      .map((h, i) => '<th style=\"padding:6px 10px;text-align:' + (i ? 'right' : 'left') + ';font-size:12px;\">' + h + '</th>')\n      .join('')\n  + '</tr>';\n\nconst html = ''\n + '<div style=\"font-family:system-ui,Arial,sans-serif;max-width:680px;color:#18181b;\">'\n + '<h2 style=\"margin:0 0 4px;\">' + d.podcastName + ' - weekly analytics</h2>'\n + '<p style=\"margin:0 0 18px;color:#52525b;\">' + (ai.headline || '') + '</p>'\n + '<p style=\"margin:0 0 18px;font-size:14px;\">'\n   + d.episodeCount + ' episodes tracked, ' + d.newThisWeek + ' new this week. '\n   + 'Average ' + d.avgPlays + ' plays and ' + d.avgRetention + '% retention per episode.</p>'\n + '<h3 style=\"font-size:14px;margin:18px 0 6px;\">Top performers</h3>'\n + '<table style=\"border-collapse:collapse;width:100%;font-size:13px;\">' + head + (d.topFive || []).map(row).join('') + '</table>'\n + '<h3 style=\"font-size:14px;margin:18px 0 6px;\">Needs attention</h3>'\n + '<table style=\"border-collapse:collapse;width:100%;font-size:13px;\">' + head + (d.bottomFive || []).map(row).join('') + '</table>'\n + '<h3 style=\"font-size:14px;margin:22px 0 6px;\">What is working</h3><ul style=\"font-size:13px;\">' + list(ai.what_is_working) + '</ul>'\n + '<h3 style=\"font-size:14px;margin:18px 0 6px;\">What to fix</h3><ul style=\"font-size:13px;\">' + list(ai.what_to_fix) + '</ul>'\n + '<p style=\"font-size:13px;\"><b>Length:</b> ' + (ai.length_insight || '') + '<br>'\n + '<b>Titles:</b> ' + (ai.title_insight || '') + '</p>'\n + '<h3 style=\"font-size:14px;margin:18px 0 6px;\">Try next</h3><ul style=\"font-size:13px;\">' + list(ai.next_episode_ideas) + '</ul>'\n + '</div>';\n\nreturn [{ json: { subject: d.podcastName + ' - weekly podcast analytics', html } }];\n"
      },
      "typeVersion": 2
    },
