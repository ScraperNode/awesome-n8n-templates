      "name": "Trigger & Configure",
      "type": "n8n-nodes-base.stickyNote",
      "position": [
        -60,
        153
      ],
      "parameters": {
        "color": 1,
        "width": 720,
        "height": 327,
        "content": "Fires on each new Google Form response. Configure holds every user setting: manager and director emails, company name, and severity levels."
      },
