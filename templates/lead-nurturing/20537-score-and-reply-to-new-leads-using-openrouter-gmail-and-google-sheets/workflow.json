    {
      "id": "629673c6-e6c1-491c-ab5e-c24ef6c88754",
      "name": "Parse Claude JSON Safely",
      "type": "n8n-nodes-base.code",
      "position": [
        1136,
        400
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const source = $('Client Settings + Clean Lead').item.json;\nconst raw = $input.item.json;\nconst candidate = raw.content ?? raw.text ?? raw.response ?? raw.output ?? raw.message?.content ?? JSON.stringify(raw);\nconst cleaned = String(candidate).replace(/^\\s*\\x60\\x60\\x60(?:json)?\\s*/i, '').replace(/\\s*\\x60\\x60\\x60\\s*$/i, '').trim();\nlet ai = {};\ntry { ai = JSON.parse(cleaned); } catch (error) { ai = {}; }\nconst normalizedScore = String(ai.score ?? 'warm').toLowerCase();\nconst leadScore = ['hot', 'warm', 'cold'].includes(normalizedScore) ? normalizedScore : 'warm';\nconst need = String(ai.need ?? source.leadMessage ?? 'New lead enquiry').trim().slice(0, 300);\nconst fallbackReply = 'Thanks for reaching out. We received your message and will get back to you shortly.';\nconst reply = String(ai.reply ?? fallbackReply).trim().slice(0, 450) || fallbackReply;\nreturn { json: { ...source, leadScore, need, reply, aiJsonParsed: Object.keys(ai).length > 0 } };"
      },
      "typeVersion": 2
    },
