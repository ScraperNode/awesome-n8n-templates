    {
      "id": "ec8cc7f4-b8cf-456c-aed2-099608775dcb",
      "name": "Workflow Overview1",
      "type": "n8n-nodes-base.stickyNote",
      "position": [
        5872,
        976
      ],
      "parameters": {
        "color": 4,
        "width": 1088,
        "height": 256,
        "content": "### Workflow overview\nThis workflow lets you create and manage SubmitRax forms just by chatting. GitHub Hosting Config holds your GitHub username/repo in one place. Your message then goes to an AI agent (Claude Sonnet 5) that calls the SubmitRax MCP server as a tool to build the form. Once the form exists, the workflow fetches its public HTML, checks whether that form has already been published to GitHub Pages, then creates or updates the file accordingly, and replies in chat with a summary and the live hosted link.\n\nSee the notes below for an example prompt, MCP setup, and GitHub Pages setup."
      },
      "typeVersion": 1
    },
    {
      "id": "d50da27e-7e17-423b-a9f3-408d157f21f6",
      "name": "Example Prompt1",
      "type": "n8n-nodes-base.stickyNote",
      "position": [
        5872,
        1344
      ],
      "parameters": {
        "color": 6,
        "width": 352,
        "height": 464,
        "content": "### Example of a Prompt:\nCreate a form with a data field called \"Date of birth\", a \"comment\" textarea, and a text field \"Name\". Make it look nice with tailwind CSS."
      },
      "typeVersion": 1
    },
    {
      "id": "2c8fdf23-dd2c-48d4-a759-a639fe81b0a3",
      "name": "SubmitRax Form Agent1",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "position": [
        6608,
        1360
      ],
      "parameters": {
        "options": {
          "systemMessage": "You are a helpful HTML designer.  \n**Download the HTML of the form with the get_public_form_html tool to get it rendered. \nReturn a comment and the HTML of the form."
        },
        "hasOutputParser": true
      },
      "typeVersion": 3.1
    },
