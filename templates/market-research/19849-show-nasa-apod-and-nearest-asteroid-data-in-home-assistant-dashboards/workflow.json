              "value": "={{ $json.total_count }}"
            },
            {
              "name": "friendly_name",
              "value": "Nearest Asteroid"
            }
          ]
        }
      },
      "credentials": {
        "homeAssistantApi": {
          "id": "",
          "name": "Home Assistant account"
        }
      },
      "typeVersion": 1
    },
