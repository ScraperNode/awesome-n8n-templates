      "type": "n8n-nodes-base.set",
      "position": [
        460,
        -110
      ],
      "parameters": {
        "options": {},
        "assignments": {
          "assignments": [
            {
              "id": "a824df54-2502-4eb0-94c1-2cb9160ac3a3",
              "name": "company",
              "type": "string",
              "value": "={{ String($json.company ?? $json.Company ?? '').trim() }}"
            },
            {
              "id": "2fe9b689-505b-42ea-8271-1c670014ef3c",
              "name": "nip",
              "type": "string",
              "value": "={{ String($json.nip ?? $json.NIP ?? '').replace(/\\D/g, '') }}"
            },
            {
              "id": "720b3d1d-40a5-4943-af6c-15fb25ac5a1d",
              "name": "krs",
              "type": "string",
              "value": "={{ String($json.krs ?? $json.KRS ?? '').replace(/\\D/g, '') ? String($json.krs ?? $json.KRS).replace(/\\D/g, '').padStart(10, '0') : '' }}"
            }
          ]
