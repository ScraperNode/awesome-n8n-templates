    {
      "id": "a7f5621f-4c0e-46ec-ade9-8f407b2de073",
      "name": "Write the note",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "position": [
        1380,
        20
      ],
      "parameters": {
        "text": "=The person to invite, as the search returned them (JSON):\n{{ JSON.stringify($json).slice(0, 2000) }}",
        "messages": {
          "messageValues": [
            {
              "message": "=You write the note that goes with a LinkedIn connection invitation. The owner of the account reads it and decides whether it is sent.\n\nAbout the owner: {{ $('Settings').first().json.aboutYou }}\nWhy the owner wants to connect: {{ $('Settings').first().json.whyConnect }}\nHow the owner writes: {{ $('Settings').first().json.yourVoice }}\n\nAt most 190 characters. Start with the person's first name. Say one true thing that ties their headline to why the owner wants to connect. Nothing to sell, no link, no hashtag, no emoji. Never make up a fact about the person: use only what the JSON says. Output the note only."
            }
          ]
        },
        "promptType": "define"
      },
      "typeVersion": 1.5
    },
    {
      "id": "dd86e329-3ec4-465d-bacb-e39616169966",
