    {
      "id": "5e8b7890-4160-4d5f-b036-5393938c0c89",
      "name": "Prepare review row",
      "type": "n8n-nodes-base.code",
      "position": [
        2040,
        260
      ],
      "parameters": {
        "jsCode": "const result = $input.first().json;\nconst original = $('Prepare extraction').item.json;\nif (result.requires_review !== true || !result.fields || !Array.isArray(result.warnings))\n  throw new Error('Unexpected extraction result; message stays unread');\nconst text = value => String(value == null ? '' : value);\nconst row = { source_key: original.source_key };\nfor (const field of ['supplier','invoice_number','invoice_date','due_date','currency','net','tax','total'])\n  row[field] = text(result.fields[field]);\nrow.review_status = 'TO_REVIEW';\nrow.warnings = result.warnings.map(text).join(' | ');\nrow.original_url = original.original_url;\nrow.gmail_url = original.gmail_url;\nreturn [{ json: row }];"
      },
      "typeVersion": 2
    },
