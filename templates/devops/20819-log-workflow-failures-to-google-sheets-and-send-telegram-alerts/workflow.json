        -48,
        -160
      ],
      "parameters": {
        "color": 7,
        "width": 416,
        "height": 320,
        "content": "## Capture and prepare error\n\nStarts the error handling flow and builds a normalized error record with tracking fields before it is logged."
      },
      "typeVersion": 1
    },
