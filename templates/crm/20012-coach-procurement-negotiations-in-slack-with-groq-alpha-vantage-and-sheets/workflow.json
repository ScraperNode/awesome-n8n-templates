        "jsonBody": "={{\n  JSON.stringify({\n    \"trigger_id\": JSON.parse($('Route Slack Payload').item.json.body.payload).trigger_id, \n    \"view\": {\n      \"type\": \"modal\",\n      \"callback_id\": \"counteroffer_modal\",\n      \"private_metadata\": JSON.stringify({\n  \"channel_id\": JSON.parse($('Route Slack Payload').item.json.body.payload).channel.id,\n  \"context\": JSON.parse(JSON.parse($('Route Slack Payload').item.json.body.payload).actions[0].value)\n}),\n      \"title\": {\n        \"type\": \"plain_text\",\n        \"text\": \"Live Counteroffer\",\n        \"emoji\": true\n      },\n      \"submit\": {\n        \"type\": \"plain_text\",\n        \"text\": \"Strategize\",\n        \"emoji\": true\n      },\n      \"close\": {\n        \"type\": \"plain_text\",\n        \"text\": \"Cancel\",\n        \"emoji\": true\n      },\n      \"blocks\": [\n        {\n          \"type\": \"input\",\n          \"block_id\": \"supplier_response_block\",\n          \"element\": {\n            \"type\": \"plain_text_input\",\n            \"action_id\": \"supplier_response_input\",\n            \"multiline\": true,\n            \"placeholder\": {\n              \"type\": \"plain_text\",\n              \"text\": \"e.g., They said they can't do 12% but will offer 10% and free shipping...\"\n            }\n          },\n          \"label\": {\n            \"type\": \"plain_text\",\n            \"text\": \"What did the supplier just say?\",\n            \"emoji\": true\n          }\n        }\n      ]\n    }\n  })\n}}",
