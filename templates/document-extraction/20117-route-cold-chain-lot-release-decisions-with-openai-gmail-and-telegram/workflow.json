    {
      "id": "0c436501-0f6a-476e-b456-8d7df9b08a0b",
      "name": "Compute Thermal Debt Score",
      "type": "n8n-nodes-base.code",
      "position": [
        2064,
        272
      ],
      "parameters": {
        "jsCode": "return items.map(({json})=>{const r=json.readings||[];let debt=0,max=0;for(let i=1;i<r.length;i++){const h=(new Date(r[i].ts)-new Date(r[i-1].ts))/36e5;const d=Math.max(0,r[i].tempC-(json.maxTempC||8));debt+=h*d;max=Math.max(max,d)}const score=Math.min(100,Math.round(debt*8+max*6+(json.integritySealBroken?25:0)));return {json:{...json,thermalDebt:debt,riskScore:score,route:score>=70?'quarantine':score>=35?'qa-review':'conditional-release'}}})"
      },
      "typeVersion": 2
    },
