      ],
      "parameters": {
        "color": 7,
        "width": 1260,
        "height": 140,
        "content": "## 2. Skip what needs no answer\nWebhook retries and auto-replies stop here. Company details for the agent live in *Settings*."
      },
      "typeVersion": 1
    },
    {
      "id": "da89c6f6-2830-53f6-af16-878f7546fdb3",
