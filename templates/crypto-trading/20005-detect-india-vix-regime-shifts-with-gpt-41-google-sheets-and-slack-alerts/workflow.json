    {
      "id": "56e1df6d-ee51-4270-a7ce-390484788802",
      "name": "Classify Current VIX Regime",
      "type": "n8n-nodes-base.code",
      "position": [
        1792,
        352
      ],
      "parameters": {
        "jsCode": "const vixValue = Number($('Normalize VIX Market Data').first().json.vix_value);\nlet regime;\nif (vixValue < 15) regime = 'LOW';\nelse if (vixValue < 20) regime = 'NORMAL';\nelse if (vixValue < 30) regime = 'ELEVATED';\nelse regime = 'CRISIS';\nreturn [{ json: { index_name: 'INDIA_VIX', current_vix: vixValue, current_regime: regime, timestamp: $('Normalize VIX Market Data').first().json.timestamp } }];"
      },
      "typeVersion": 2
    },
    {
      "id": "1cc15b1f-957e-472b-a694-cc717e3af2bb",
      "name": "Compare VIX Regime State",
      "type": "n8n-nodes-base.code",
      "position": [
        2032,
        352
      ],
      "parameters": {
        "jsCode": "const current = $('Classify Current VIX Regime').first().json;\nconst state = $('Read Previous VIX Regime State').first().json || {};\nconst previousRegime = String(state.current_regime || 'UNKNOWN').toUpperCase();\nconst previousValue = Number(state.current_value || 0);\nconst changePercent = previousValue > 0 ? ((current.current_vix - previousValue) / previousValue) * 100 : 0;\nconst changed = previousRegime !== 'UNKNOWN' && previousRegime !== current.current_regime;\nreturn [{ json: { ...current, previous_vix: previousValue, previous_regime: previousRegime, regime_changed: changed, change_percent: Number(changePercent.toFixed(2)), transition: `${previousRegime} -> ${current.current_regime}` } }];"
      },
      "typeVersion": 2
    },
