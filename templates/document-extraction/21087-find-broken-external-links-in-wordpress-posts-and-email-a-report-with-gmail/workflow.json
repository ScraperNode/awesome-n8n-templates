            },
            {
              "id": "3250e0a1-5eb8-50d4-8ed1-76bd9365a229",
              "name": "checked",
              "type": "number",
              "value": "={{ $json.checked }}"
            },
            {
              "id": "97f0a1f6-36de-53ab-8281-9d27c86090c9",
              "name": "brokenCount",
              "type": "number",
              "value": "={{ $json.brokenCount }}"
            },
            {
              "id": "37314a98-fd07-5d6b-9bcd-51efffc13b50",
              "name": "reviewCount",
              "type": "number",
              "value": "={{ $json.reviewCount }}"
            },
            {
              "id": "e490d05d-37d2-5a08-8912-248f1e8b8830",
              "name": "result",
              "type": "string",
              "value": "Email skipped: emailReport is false or no issues were found"
            }
          ]
        }
      },
      "typeVersion": 3.4
    }
  ],
