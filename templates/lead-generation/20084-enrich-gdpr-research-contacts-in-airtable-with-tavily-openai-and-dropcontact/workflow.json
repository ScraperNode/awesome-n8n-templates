      "type": "n8n-nodes-base.stickyNote",
      "position": [
        688,
        256
      ],
      "parameters": {
        "color": 7,
        "width": 512,
        "height": 304,
        "content": "## Scheduled request intake\n\nStarts on a schedule, reads pending Airtable research requests, and iterates through them one at a time."
      },
      "typeVersion": 1
    },
    {
      "id": "45ea0299-827a-49a7-9370-554e98728c6a",
      "name": "Sticky Note3",
      "type": "n8n-nodes-base.stickyNote",
      "position": [
        1248,
        256
      ],
      "parameters": {
        "color": 7,
        "width": 896,
        "height": 512,
        "content": "## Search and qualify\n\nRuns a Tavily deep search, filters results by confidence, and branches based on whether the evidence is usable; weak requests are marked low-confidence in Airtable."
      },
      "typeVersion": 1
    },
    {
      "id": "baa82df0-1a68-4d5c-bafa-ae3529bbb9fa",
      "name": "Sticky Note4",
      "type": "n8n-nodes-base.stickyNote",
      "position": [
        2176,
        224
      ],
      "parameters": {
        "color": 7,
        "width": 560,
        "height": 320,
        "content": "## Extract and tag people\n\nUses OpenAI to extract people from usable search results, splits the extracted list into individual items, and attaches the originating research request ID."
      },
      "typeVersion": 1
    },
    {
