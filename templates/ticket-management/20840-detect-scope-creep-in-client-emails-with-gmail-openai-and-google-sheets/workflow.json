      "parameters": {
        "jsonSchemaExample": "{\n  \"verdict\": \"out_of_scope\",\n  \"request_summary\": \"Add a Spanish version of the landing page\",\n  \"matching_clause\": \"Deliverables: one English landing page with two revision rounds\",\n  \"reasoning\": \"Translation and a second-language page are not listed deliverables\",\n  \"estimated_hours\": 6,\n  \"change_order_reply\": \"Thanks for this, a Spanish version is a great idea...\"\n}"
      },
      "typeVersion": 1.2
