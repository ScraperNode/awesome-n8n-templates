    {
      "id": "04650802-0ece-4ff2-a095-a94e9e810cad",
      "name": "AI Content Generator",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "position": [
        1296,
        720
      ],
      "parameters": {
        "text": "=Input: {{ $('Extract Caption & Photos').item.json.caption }}",
        "options": {
          "systemMessage": "You are an expert Social Media Content Creator and Professional Copywriter. \nYour task is to rewrite, refine, and transform the user's input caption and context into an engaging, high-performing Facebook post based on the attached images/album.\n\n### Guidelines:\n1. **Tone & Style:** Friendly, engaging, natural, and persuasive. Avoid robotic phrasing. Use a modern social media writing style (clear hook, spaced-out paragraphs for readability).\n2. **Hook (First 2 lines):** Start with an attention-grabbing hook that stops users from scrolling.\n3. **Core Message:** Elaborate naturally on the user's original caption (if provided). If the caption is short or empty, infer the context based on the post theme and write a relevant, creative story or description.\n4. **Call to Action (CTA):** Include a subtle, friendly call-to-action at the end (e.g., asking for comments, shares, or opinions).\n5. **Hashtags:** Add 3 to 5 relevant, popular hashtags at the very bottom.\n6. **Language:** Write the final output in the same language as the user's original input caption (default to Vietnamese if unspecified).\n"
        },
        "promptType": "define"
      },
      "typeVersion": 3.1
    },
