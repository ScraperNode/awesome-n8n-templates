    },
    {
      "id": "a1000000-0000-4000-8000-000000000006",
      "name": "Compute Backoff",
      "type": "n8n-nodes-base.code",
      "position": [
        1056,
        480
      ],
      "parameters": {
        "jsCode": "// Compute next attempt and exponential delay with jitter.\n// Only retries on network errors (no statusCode), 408, 429 and 5xx. Other 4xx are permanent: go straight to DLQ.\nconst cfg = $('Config').first().json;\nconst res = $input.first().json;\nconst status = res.statusCode;\nconst retryable = status === undefined || status === 408 || status === 429 || status >= 500;\n// $runIndex counts how many times this node has run in this execution (0-based), so it is the attempt counter.\nconst nextAttempt = $runIndex + 1;\nconst exhausted = !retryable || nextAttempt >= cfg.max_attempts;\nconst jitter = Math.random() * 0.25 * cfg.base_delay_seconds;\nconst delay = Math.min(cfg.base_delay_seconds * Math.pow(2, nextAttempt - 1) + jitter, 300);\nreturn [{ json: {\n  attempt: nextAttempt,\n  exhausted,\n  delay_seconds: Math.round(delay * 100) / 100,\n  last_status: status ?? null,\n  last_error: res.error ? String(res.error.message || res.error) : null,\n  reason: retryable ? 'max_attempts_reached' : 'non_retryable_status'\n} }];"
      },
      "typeVersion": 2
    },
    {
