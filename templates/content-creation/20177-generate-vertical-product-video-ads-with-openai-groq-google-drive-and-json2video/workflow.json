    {
      "id": "c100607e-07c0-415e-8880-3608a0b41897",
      "name": "Split Info",
      "type": "n8n-nodes-base.code",
      "position": [
        3616,
        -32
      ],
      "parameters": {
        "jsCode": "return [{\n  json: {\n    resolution: \"instagram-story\",\n\n    scenes: [\n      {\n        duration: 8,\n        elements: [\n          {\n            type: \"image\",\n            src: $('Upload 1st image').first().json.webContentLink,\n            resize: \"cover\",\n            position: \"center-center\"\n          }\n        ]\n      },\n      {\n        duration: 9,\n        elements: [\n          {\n            type: \"image\",\n            src: $('Upload 2nd image').first().json.webContentLink,\n            resize: \"cover\",\n            position: \"center-center\"\n          }\n        ]\n      },\n      {\n        duration: 9,\n        elements: [\n          {\n            type: \"image\",\n            src: $('Upload 3rd Image').first().json.webContentLink,\n            resize: \"cover\",\n            position: \"center-center\"\n          }\n        ]\n      }\n    ],\n\n    elements: [\n      {\n        type: \"audio\",\n        src: $('Upload Audio').first().json.webContentLink\n      },\n      {\n        type: \"subtitles\",\n        settings: {\n          style: \"classic\",\n          position: \"bottom-center\",\n          \"max-words-per-line\": 4,\n          \"font-size\": 50,\n          \"all-caps\": false\n        }\n      }\n    ]\n  }\n}];"
      },
      "typeVersion": 2
    },
