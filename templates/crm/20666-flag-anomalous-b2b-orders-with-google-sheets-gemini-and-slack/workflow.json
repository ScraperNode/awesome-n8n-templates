    {
      "id": "83e4b272-3181-47fa-acbf-bbf89e8807bd",
      "name": "Parse AI Output",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "position": [
        2496,
        1440
      ],
      "parameters": {
        "schemaType": "manual",
        "inputSchema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"risk_level\": {\n      \"type\": \"string\",\n      \"enum\": [\n        \"NORMAL\",\n        \"REVIEW\",\n        \"HIGH\"\n      ]\n    },\n    \"risk_score\": {\n      \"type\": \"number\"\n    },\n    \"requires_review\": {\n      \"type\": \"boolean\"\n    },\n    \"primary_reason\": {\n      \"type\": \"string\"\n    },\n    \"supporting_factors\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"string\"\n      }\n    },\n    \"recommended_action\": {\n      \"type\": \"string\"\n    },\n    \"confidence\": {\n      \"type\": \"string\",\n      \"enum\": [\n        \"LOW\",\n        \"MEDIUM\",\n        \"HIGH\"\n      ]\n    }\n  },\n  \"required\": [\n    \"risk_level\",\n    \"risk_score\",\n    \"requires_review\",\n    \"primary_reason\",\n    \"supporting_factors\",\n    \"recommended_action\",\n    \"confidence\"\n  ]\n}"
      },
      "typeVersion": 1.3
    },
    {
      "id": "45b30fcc-edce-4373-8497-226b9f552ac9",
      "name": "Determine Next Steps",
      "type": "n8n-nodes-base.set",
      "position": [
        2608,
        1232
      ],
      "parameters": {
        "mode": "raw",
        "options": {},
        "jsonOutput": "={{ (function(){\nconst c = $('Assemble Context Data').first().json;\nconst a = $json.output;\nconst review = a.requires_review === true || a.risk_level !== 'NORMAL';\nreturn {\n  Order_ID: c.order.order_id,\n  Customer_ID: c.customer.customer_id,\n  Company: c.customer.company,\n  Sales_Rep: c.customer.sales_rep,\n  Order_Value: c.order.order_value,\n  Projected_Utilization_Pct: c.credit.projected_utilization_pct_with_this_order,\n  Status: review ? 'Under Review' : 'Approved',\n  Risk_Score: a.risk_score,\n  Risk_Level: a.risk_level,\n  Risk_Reason: a.primary_reason,\n  Supporting_Factors: (a.supporting_factors || []).join(' | '),\n  Recommended_Action: a.recommended_action,\n  Confidence: a.confidence,\n  requires_review: review\n};\n})() }}"
      },
      "typeVersion": 3.4
    },
