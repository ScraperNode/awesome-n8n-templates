    {
      "id": "c2bf79ae-2d8d-4e56-a931-0e2db5921892",
      "name": "Calculate Overdue Days and Tier",
      "type": "n8n-nodes-base.code",
      "position": [
        2144,
        768
      ],
      "parameters": {
        "jsCode": "const cfg = $('Set Reminder Configurations').first().json;\nconst todayMs = Date.now();\nconst results = [];\n\nfunction parseXeroDate(inv) {\n  const raw = inv.DueDateString || inv.dueDateString || inv.DueDate || inv.dueDate;\n  if (raw == null) return null;\n  if (typeof raw === 'string') {\n    const m = raw.match(/\\/Date\\((-?\\d+)(?:[+-]\\d+)?\\)\\//);\n    if (m) return new Date(Number(m[1]));\n    const d = new Date(raw);\n    return isNaN(d.getTime()) ? null : d;\n  }\n  if (typeof raw === 'number') return new Date(raw);\n  return null;\n}\n\nfor (const item of $input.all()) {\n  const inv = item.json;\n  const dueDate = parseXeroDate(inv);\n  if (!dueDate) continue;\n\n  const daysOverdue = Math.floor((todayMs - dueDate.getTime()) / 86400000);\n  if (daysOverdue < cfg.tier1Days) continue;\n\n  let tier = null;\n  if (daysOverdue >= cfg.tier3Days) tier = 30;\n  else if (daysOverdue >= cfg.tier2Days) tier = 14;\n  else if (daysOverdue >= cfg.tier1Days) tier = 7;\n  if (!tier) continue;\n\n  // Use ?? so AmountDue = 0 is kept (|| was dropping it)\n  const amountDue = Number(inv.AmountDue ?? inv.amountDue ?? 0);\n  const amountPaid = Number(inv.AmountPaid ?? inv.amountPaid ?? 0);\n  const total = Number(inv.Total ?? inv.total ?? amountDue);\n  const currencyCode = inv.CurrencyCode || inv.currencyCode || '';\n  const amountDueFormatted = currencyCode\n    ? `${currencyCode} ${amountDue.toFixed(2)}`\n    : amountDue.toFixed(2);\n\n  const invoiceId = inv.InvoiceID || inv.invoiceID;\n\n  results.push({\n    json: {\n      invoiceId,\n      invoiceNumber: inv.InvoiceNumber || inv.invoiceNumber,\n      contactName: inv.Contact ? inv.Contact.Name : inv.contactName,\n      contactEmail: inv.Contact && inv.Contact.EmailAddress ? inv.Contact.EmailAddress : null,\n      amountDue,\n      amountPaid,\n      total,\n      currencyCode,\n      amountDueFormatted,\n      dueDate: dueDate.toISOString().slice(0, 10),\n      daysOverdue,\n      tier,\n      status: inv.Status || inv.status,\n      invoiceId_tier: `${invoiceId}_${tier}`\n    }\n  });\n}\n\nreturn results;"
      },
      "typeVersion": 2
    },
