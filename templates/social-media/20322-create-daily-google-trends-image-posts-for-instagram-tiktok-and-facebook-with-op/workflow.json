    {
      "id": "609d59ee-3146-4e05-a160-a4db6dba96d1",
      "name": "Pick a trend with OpenAI",
      "type": "@n8n/n8n-nodes-langchain.openAi",
      "position": [
        1800,
        0
      ],
      "parameters": {
        "modelId": {
          "__rl": true,
          "mode": "id",
          "value": "gpt-5-mini"
        },
        "options": {
          "textFormat": {
            "textOptions": {
              "type": "json_object"
            }
          }
        },
        "resource": "text",
        "simplify": true,
        "operation": "response",
        "responses": {
          "values": [
            {
              "role": "system",
              "type": "text",
              "content": "You run social media for the brand. From today's trending searches, pick the ONE the brand can post about naturally. Never pick deaths, crimes, accidents, disasters, politics, elections, lawsuits or private people. If no trend fits, return JSON {\"relevant\": false}. Otherwise return JSON with the keys relevant (true), trend (the trend exactly as written), angle (one sentence on how the brand connects to it), image_prompt (one square image for the post: scene, light, mood; no text, no logos, no real people), instagram (2 or 3 sentences and up to 5 hashtags), tiktok (a hook of up to 150 characters with 3 hashtags) and facebook (1 or 2 conversational sentences). Invent no facts about the brand."
            },
            {
              "role": "user",
              "type": "text",
              "content": "={{ 'Brand: ' + $('Set your brand and niche').item.json.brand + '\\nNiche: ' + $('Set your brand and niche').item.json.niche + '\\nNetworks: ' + $('Set your brand and niche').item.json.networks.join(', ') + '\\n\\nToday\\'s trending searches:\\n' + $json.trends.map(t => '- ' + t.title + ' (' + (t['ht:approx_traffic'] || '?') + ' searches)').join('\\n') }}"
            }
          ]
        }
      },
      "typeVersion": 2.3
    },
