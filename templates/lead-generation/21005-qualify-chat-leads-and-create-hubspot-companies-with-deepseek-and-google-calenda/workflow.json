    {
      "id": "441e2989-b994-487c-8f11-e4f1cc413d55",
      "name": "Code in JavaScript",
      "type": "n8n-nodes-base.code",
      "position": [
        272,
        0
      ],
      "parameters": {
        "jsCode": "// Loop over input items, parse the embedded JSON inside output markdown\nfor (const item of $input.all()) {\n  const markdownText = item.json.output;\n\n  // \u6b63\u5219\u63d0\u53d6 ```json ... ``` \u5757\u91cc\u7684\u5185\u5bb9\n  const jsonMatch = markdownText.match(/```json\\s*([\\s\\S]*?)\\s*```/);\n  if (jsonMatch && jsonMatch[1]) {\n    try {\n      const parsed = JSON.parse(jsonMatch[1]);\n      // \u628a\u89e3\u6790\u51fa\u6765\u7684 company \u5bf9\u8c61\u6302\u5230 item.json.company\n      item.json.company = parsed.company;\n    } catch (err) {\n      item.json.company = null;\n      item.json.parseError = err.message;\n    }\n  } else {\n    item.json.company = null;\n    item.json.parseError = \"No json code block found in output\";\n  }\n}\n\nreturn $input.all();\n"
      },
      "typeVersion": 2
    },
