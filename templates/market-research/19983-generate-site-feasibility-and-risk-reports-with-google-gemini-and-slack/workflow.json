            }
          ]
        }
      },
      "notesInFlow": true,
      "typeVersion": 4.2
    },
    {
      "id": "e253f933-7f46-42c6-853e-d66844cf62d5",
      "name": "Compile Site Assessment Data",
      "type": "n8n-nodes-base.code",
      "position": [
        2976,
        640
      ],
      "parameters": {
        "jsCode": "const config = $('Set Site Parameters').item.json;\nconst water = $('Fetch Water Location Status').item.json;\nconst elevationRes = $('Fetch Topo Elevation Data').item.json.results || [];\nconst elevation = elevationRes[0] || null;\nconst gbif = $('Fetch GBIF Biodiversity Data').item.json;\nconst geoResult = $('Geocode Census Boundaries').item.json.result.geographies['Census Block Groups'] || [];\nconst geo = geoResult[0] || {};\nconst acs = $('Fetch Census Demographics').item.json;\n\nconst medianIncome = acs && acs[1] ? acs[1][0] : null;\nconst population = acs && acs[1] ? acs[1][1] : null;\nconst landAreaSqM = geo.AREALAND || null;\nconst popDensityPerSqKm = (landAreaSqM && population)\n  ? Math.round((Number(population) / (landAreaSqM / 1000000)) * 100) / 100\n  : null;\n\nconst protectedSpecies = (gbif.results || [])\n  .filter(o => o.iucnRedListCategory)\n  .map(o => ({ species: o.species || o.scientificName, category: o.iucnRedListCategory }));\n\nconst uniqueSpecies = Array.from(\n  new Map(protectedSpecies.map(s => [s.species, s])).values()\n);\n\nreturn [{\n  json: {\n    site_name: config.site_name,\n    latitude: config.latitude,\n    longitude: config.longitude,\n    radius_km: config.radius_km,\n    is_land: water.water === false,\n    elevation_m: elevation ? elevation.elevation : null,\n    flood_risk_flag: elevation ? elevation.elevation < 10 : null,\n    protected_species_count: uniqueSpecies.length,\n    protected_species: uniqueSpecies.slice(0, 20),\n    median_household_income_usd: medianIncome,\n    population: population,\n    population_density_per_sqkm: popDensityPerSqKm,\n    state_fips: geo.STATE || null,\n    county_fips: geo.COUNTY || null,\n    tract: geo.TRACT || null,\n    block_group: geo.BLKGRP || null,\n    slack_channel: config.slack_channel\n  }\n}];"
      },
      "typeVersion": 2
    },
