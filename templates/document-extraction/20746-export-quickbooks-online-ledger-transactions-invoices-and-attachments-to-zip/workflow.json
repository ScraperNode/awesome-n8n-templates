                    "name": "query",
                    "value": "=select * from {{ $json.entity }} where TxnDate >= '{{ $('Config').first().json.startDate }}' and TxnDate <= '{{ $('Config').first().json.endDate }}' startposition {{ $pageCount * 1000 + 1 }} maxresults 1000"
                  }
                ]
              },
              "requestInterval": 200,
              "completeExpression": "={{ Object.values($response.body.QueryResponse ?? {}).filter(v => Array.isArray(v)).flat().length < 1000 }}",
              "paginationCompleteWhen": "other"
            }
          }
