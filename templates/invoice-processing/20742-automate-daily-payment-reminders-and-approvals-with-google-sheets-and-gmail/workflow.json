    {
      "id": "8665921b-fba5-48b5-a52a-cde7df15065c",
      "name": "Compile Daily Finance Summary",
      "type": "n8n-nodes-base.code",
      "position": [
        960,
        1664
      ],
      "parameters": {
        "jsCode": "const rows=$input.all().map(i=>i.json), today=new Date().toISOString().slice(0,10); const audit=rows.filter(r=>r.Timestamp); const todays=audit.filter(r=>String(r.Timestamp).slice(0,10)===today); const sent=todays.filter(r=>String(r.Email_Outcome||'').toLowerCase()==='sent').length; const failures=todays.filter(r=>['failed','error'].includes(String(r.Email_Outcome||'').toLowerCase())).length; const notApproved=todays.filter(r=>/not approved|rejected/i.test(String(r.Action||''))).length; const pending=rows.filter(r=>String(r.Approval_Status||'').toLowerCase()==='pending').length; return [{json:{summaryDate:today,totalAuditRowsToday:todays.length,emailsSentToday:sent,failuresToday:failures,approvalsNotGrantedToday:notApproved,approvalsPending:pending,summaryText:`Finance summary for ${today}\\n\\nEmails sent today: ${sent}\\nWorkflow failures today: ${failures}\\nApprovals not granted today: ${notApproved}\\nApprovals pending: ${pending}`}}];"
      },
      "typeVersion": 2
    },
