    {
      "id": "d3d5a4e3-3f6d-4e11-a3cb-dc78aef0135e",
      "name": "Compute Item Expiry & Pass Fail",
      "type": "n8n-nodes-base.code",
      "position": [
        1420,
        300
      ],
      "parameters": {
        "jsCode": "// Deterministic per-item expiry logic - different equipment classes\n// expire on different cycles (real policy, not AI).\nconst item = $input.first().json;\nconst cycles = {\n  helmet: 5 * 365,       // SA-rated helmets: 5-year cycle\n  harness: 2 * 365,      // FIA/SFI harness: 2-year cycle\n  rollcage: 5 * 365,     // roll cage cert: 5-year cycle\n  firesuit: 5 * 365,     // fire suit: 5-year cycle\n};\nconst cls = String(item.equipmentClass || '').toLowerCase();\nconst cycleDays = cycles[cls] || 365;\nconst issueDate = new Date(item.issueOrCertDate);\nconst now = new Date();\nconst ageDays = Math.round((now - issueDate) / 86400000);\nconst daysToExpiry = cycleDays - ageDays;\nconst itemPass = daysToExpiry > 0;\n\nreturn [{\n  json: {\n    ...item,\n    cycleDays,\n    daysToExpiry,\n    itemPass,\n  },\n}];",
        "language": "javaScript"
      },
      "typeVersion": 2
    },
