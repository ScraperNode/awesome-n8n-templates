              "value": "=\ud83d\udea7 *New Site Incident*\n\n*Property:* {{ $('Prepare Incident Details').item.json.property }}\n*Incident:* {{ $('Prepare Incident Details').item.json.incident_id }}\n\n*Issue:* {{ $json.output.summary }}\n\n*Category:* {{ $json.output.category }}\n*Risk:* {{ $json.risk_emoji }} {{ $json.output.severity }}   *Urgency:* {{ $json.output.urgency }}\n*Image:* {{ $json.auth_emoji }}\n\n*Action:* {{ $json.output.action }}"
