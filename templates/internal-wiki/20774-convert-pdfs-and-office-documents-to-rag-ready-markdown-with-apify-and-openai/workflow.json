{
  "name": "Chat with your PDF and Office files with page citations using Apify and OpenAI",
  "nodes": [
    {
      "id": "d58a2ffb-a9b6-4fe1-8131-47df4d8c25ec",
      "name": "Add documents",
      "type": "n8n-nodes-base.formTrigger",
      "position": [
        0,
        0
      ],
      "webhookId": "cc0fa7a7-04e9-41aa-a6fb-8ae1f3699108",
      "parameters": {
        "options": {
          "respondWithOptions": {
            "values": {
              "formSubmittedText": "Converting your files. This takes about a minute; then ask about them in the chat."
            }
          }
        },
        "formTitle": "Add documents to the knowledge base",
        "formFields": {
          "values": [
            {
              "fieldType": "textarea",
              "fieldLabel": "File URLs",
              "placeholder": "https://example.com/handbook.pdf",
              "requiredField": true
            }
          ]
        },
        "formDescription": "Paste links to PDF, Word, PowerPoint, Excel, HTML, EPUB or image files, one per line. Public links or pre-signed S3/GCS/Drive download links work."
      },
      "typeVersion": 2.2
    },
    {
      "id": "dbc48f5c-af01-4bd3-9f31-6709f60c0991",
      "name": "Configure",
      "type": "n8n-nodes-base.set",
      "position": [
        220,
        0
      ],
      "parameters": {
        "options": {},
        "assignments": {
          "assignments": [
            {
              "id": "13852ab3-85ed-4628-9db7-f91ddec94676",
              "name": "fileUrls",
              "type": "array",
              "value": "={{ $json['File URLs'].split(/\\s+/).filter(u => u.startsWith('http')) }}"
            },
            {
              "id": "894ed6e7-2242-4d10-b5a9-e8bfb1257df5",
              "name": "chunkSize",
              "type": "number",
              "value": 800
            },
            {
              "id": "c8c6e0e8-47e1-437b-b8dc-4be522a12dba",
