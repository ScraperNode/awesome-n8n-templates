    {
      "id": "3a3e8d5f-f44b-42dd-9e1d-aa1772abdd3b",
      "name": "Check request against SOW",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "position": [
        840,
        80
      ],
      "parameters": {
        "text": "=STATEMENT OF WORK for {{ $('Match client SOW').item.json.client_domain }}:\n{{ String($json.content || '').slice(0, 12000) }}\n\nCLIENT EMAIL\nFrom: {{ $('Match client SOW').item.json.from_name }}\nSubject: {{ $('Match client SOW').item.json.subject }}\n\n{{ $('Match client SOW').item.json.body }}",
        "messages": {
          "messageValues": [
            {
              "message": "You protect a service business from scope creep. Compare the client's email with the statement of work. verdict must be one of: in_scope (covered by the SOW), out_of_scope (new deliverable, extra revisions beyond the limit, new channel or feature, or work after the end date), unclear (the SOW is silent or ambiguous), or not_a_request (no work is being asked for). request_summary is under 15 words. matching_clause is the most relevant SOW sentence, quoted briefly, or empty if none. estimated_hours is a realistic effort estimate for out_of_scope or unclear requests, otherwise 0. change_order_reply is a short, warm email body that thanks the client, confirms the request, explains it falls outside the current scope and offers to send a quote or change order. Never refuse the work, never invent SOW terms and never include a signature."
            }
          ]
        },
        "promptType": "define",
        "hasOutputParser": true
      },
      "typeVersion": 1.5
    },
