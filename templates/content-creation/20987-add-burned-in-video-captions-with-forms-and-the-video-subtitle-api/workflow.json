            {
              "id": "b3d19187-142a-5dbc-b4a0-a555b995154a",
              "name": "vocabulary",
              "type": "array",
              "value": "={{ ($json['Keywords'] || '').split(',').map(s => s.trim()).filter(s => s) }}"
            }
          ]
        }
      },
      "typeVersion": 3.4
