    {
      "id": "053c65a6-6572-44f4-9a3a-a1ce7d3299c9",
      "name": "Guard Reply",
      "type": "n8n-nodes-base.code",
      "notes": "Never send an empty WhatsApp body. Cap length. Keep a stable replyText field.",
      "position": [
        1600,
        48
      ],
      "parameters": {
        "jsCode": "const item = items[0] || { json: {} };\nconst raw = item.json.output ?? item.json.text ?? item.json.response ?? '';\nlet text = String(raw).replace(/\\s+/g, ' ').trim();\nif (!text) {\n  text = \"Got it. I hit a snag on my side. Send your name, company, and a preferred day/time and I will get you a call slot.\";\n}\nif (text.length > 3500) text = text.slice(0, 3490) + '\\u2026';\nreturn [{ json: { ...item.json, output: text, replyText: text, guardedAt: new Date().toISOString() } }];"
      },
      "typeVersion": 2,
      "alwaysOutputData": true
    },
