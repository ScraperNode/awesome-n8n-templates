    {
      "id": "36255fd3-89cb-463f-b14d-70aa8f689558",
      "name": "Debater",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "position": [
        -680,
        64
      ],
      "parameters": {
        "text": "=Question: {{ $json.question }}\n\n{{ $json.feedback ? 'Address this feedback in your new answer:\\n' + $json.feedback + '\\n\\n' : '' }}You have no search tool. Rely on your own knowledge. If you are not sure about something, say so clearly. Do not invent sources.",
        "options": {
          "systemMessage": "=You are an expert in {{ $json.domain }}. Write only the answer to the question. Do not comment on the process, rounds or earlier feedback."
        },
        "promptType": "define"
      },
      "typeVersion": 3.1
    },
    {
      "id": "b8aca97e-c62e-4d5c-ae7f-9311c17464a0",
      "name": "Debater model: OpenAI",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "position": [
        -680,
        288
      ],
      "parameters": {
        "model": {
          "__rl": true,
          "mode": "list",
          "value": "gpt-5-mini",
          "cachedResultName": "gpt-5-mini"
        },
        "options": {}
      },
      "credentials": {
        "openAiApi": {
          "name": "OpenAI account"
        }
      },
      "typeVersion": 1.2
    },
    {
      "id": "3ab91b8b-7278-4654-88d2-fc70b05b44f0",
      "name": "Reviewer",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "position": [
        -400,
        64
      ],
      "parameters": {
        "text": "=Question: {{ $('Start round').last().json.question }}\n\nAnswer from another expert:\n{{ $json.output }}\n\nReview it critically. If it is correct and complete, agree. If not, object with concrete reasons. You have no search tool. Do not invent sources.\n\nThe LAST line of your reply must be exactly:\nVERDICT: {\"agree\": <true|false>, \"objections\": [\"...\"]}",
        "options": {
          "systemMessage": "You are a strict expert reviewer."
        },
        "promptType": "define"
      },
      "typeVersion": 3.1
    },
    {
      "id": "fdd871e0-f6c6-4ee0-95c0-173c006ec1e5",
      "name": "Reviewer model: Anthropic",
      "type": "@n8n/n8n-nodes-langchain.lmChatAnthropic",
      "position": [
        -400,
        288
      ],
      "parameters": {
        "model": {
          "__rl": true,
          "mode": "list",
          "value": "claude-sonnet-5",
          "cachedResultName": "Claude Sonnet 5"
        },
        "options": {}
      },
      "credentials": {
        "anthropicApi": {
          "name": "Anthropic account"
        }
      },
      "typeVersion": 1.3
    },
    {
      "id": "a365d2b9-9f2c-4e49-8606-e2869d9b9636",
      "name": "Parse verdict",
      "type": "n8n-nodes-base.code",
      "position": [
        -160,
        64
      ],
      "parameters": {
        "jsCode": "// State of the current round (latest run of 'Start round')\nconst s = $('Start round').last().json;\nconst debaterAnswer = $('Debater').last().json.output || '';\nconst review = $input.first().json.output || '';\n\nlet agree = false;\nlet objections = [];\nconst m = review.match(/VERDICT:\\s*(\\{[\\s\\S]*\\})/);\nif (m) {\n  try {\n    const v = JSON.parse(m[1]);\n    agree = !!v.agree;\n    objections = Array.isArray(v.objections) ? v.objections : [];\n  } catch (e) {\n    objections = ['Reviewer verdict could not be parsed. Re-check the answer for accuracy and completeness.'];\n  }\n} else {\n  objections = ['Reviewer verdict was missing. Re-check the answer for accuracy and completeness.'];\n}\n\nreturn [{ json: {\n  ...s,\n  agree,\n  objections,\n  debaterAnswer,\n  reviewerNotes: review.replace(/VERDICT:[\\s\\S]*$/, '').trim(),\n} }];"
      },
      "typeVersion": 2
    },
    {
      "id": "b175e661-b631-43df-b470-19f9f2398e0e",
      "name": "Reviewer agrees?",
      "type": "n8n-nodes-base.if",
      "position": [
        60,
        64
      ],
      "parameters": {
        "options": {},
        "conditions": {
          "options": {
            "version": 2,
            "leftValue": "",
            "caseSensitive": true,
            "typeValidation": "loose"
          },
          "combinator": "and",
          "conditions": [
            {
              "id": "c1",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              },
              "leftValue": "={{ $json.agree }}",
              "rightValue": ""
            }
          ]
        },
        "looseTypeValidation": true
      },
      "typeVersion": 2.2
    },
    {
      "id": "2c115fea-6905-4b44-b4f7-7258c3678fe6",
      "name": "Rounds left?",
      "type": "n8n-nodes-base.if",
      "position": [
        60,
        -200
      ],
      "parameters": {
        "options": {},
        "conditions": {
          "options": {
            "version": 2,
            "leftValue": "",
            "caseSensitive": true,
            "typeValidation": "loose"
          },
