        },
        "combineBy": "combineByPosition"
      },
      "typeVersion": 3
    },
    {
      "id": "0f3ca81a-c53a-4138-8d49-8c0e601618db",
      "name": "LLM Candidate Scoring",
      "type": "@n8n/n8n-nodes-langchain.openAi",
      "position": [
        2416,
        544
      ],
      "parameters": {
        "modelId": {
          "__rl": true,
          "mode": "list",
          "value": "gpt-4o-mini"
        },
        "options": {
          "temperature": 0.2
        },
        "messages": {
          "values": [
            {
              "role": "system",
              "content": "You are a hiring screener. Score candidates strictly on experience, skills, and demonstrated ability to do the job described. You MUST ignore and never mention the candidate's name, age, gender, nationality, ethnicity, or any photo \u2014 base the score only on years_experience, current_role, skills, education, and notable_projects. Return ONLY valid JSON, no prose, no markdown fences."
            },
            {
              "content": "=JOB DESCRIPTION:\n{{ $json.job_description || $json['Job Description'] || '' }}\n\nCANDIDATE (structured, PII already stripped of protected attributes):\nyears_experience: {{ $json.years_experience }}\ncurrent_role: {{ $json.current_role }}\nskills: {{ JSON.stringify($json.skills || []) }}\neducation: {{ JSON.stringify($json.education || []) }}\nnotable_projects: {{ JSON.stringify($json.notable_projects || []) }}\n\nReturn JSON with keys: score (0-100 integer), strengths (array of strings), gaps (array of strings), recommendation (one of: \"shortlist\", \"maybe\", \"reject\"), screening_questions (array of 3-5 strings)."
            }
          ]
        },
        "jsonOutput": true
      },
      "typeVersion": 1.5
    },
    {
      "id": "5f8652bc-ff15-40d8-b958-59f78eb0fa0b",
      "name": "Normalize Candidate Score",
      "type": "n8n-nodes-base.code",
      "position": [
        2768,
        544
      ],
      "parameters": {
        "jsCode": "const raw = $input.item.json.message?.content ?? $input.item.json.content ?? $input.item.json;\nconst scoreObj = typeof raw === 'string' ? JSON.parse(raw) : raw;\nconst cv = $('Normalize CV Data').item.json;\nconst merged = $('Merge CV with Job Config').item.json;\nconst asArray = (v) => Array.isArray(v) ? v : (v == null || v === '' ? [] : [String(v)]);\nconst recommendation = String(scoreObj.recommendation || 'maybe').toLowerCase().trim();\nconst allowed = new Set(['shortlist', 'maybe', 'reject']);\nreturn {\n  json: {\n    ...cv,\n    score: Number(scoreObj.score) || 0,\n    strengths: asArray(scoreObj.strengths),\n    gaps: asArray(scoreObj.gaps),\n    recommendation: allowed.has(recommendation) ? recommendation : 'maybe',\n    screening_questions: asArray(scoreObj.screening_questions),\n    booking_link: merged.booking_link || merged['Booking Link'] || '',\n    job_description: merged.job_description || merged['Job Description'] || '',\n    cv_file_url: cv.cv_file_url || merged.cv_file_url || '',\n  },\n};"
      },
      "typeVersion": 2
    },
