    {
      "id": "68bf8323-09a9-4d34-b140-97ea3b4131fe",
      "name": "shape the filtered articles",
      "type": "n8n-nodes-base.code",
      "position": [
        1120,
        0
      ],
      "parameters": {
        "jsCode": "let results = [];\n\nfor (const value of $(\"Filter the news\").all()) {\n  const items = value.json.output.items.flatMap(item => {\n    const findRSS = $(\"combine the feeds\").all().find(f => f?.json?.guid === item?.guid)?.json || null;\n\n    if (!findRSS) return [];\n    \n    return {\n      ...item,\n      ...findRSS,\n    }\n  });\n\n  results = [\n    ...results,\n    ...items,\n  ]\n}\n\nreturn results;"
      },
      "typeVersion": 2
    },
