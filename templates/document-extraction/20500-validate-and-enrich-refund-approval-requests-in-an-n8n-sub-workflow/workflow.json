          ]
        },
        "includeOtherFields": false
      },
      "typeVersion": 3.4
    },
    {
      "id": "50fc6e8d-e83f-4081-9e01-df843d6d06ca",
      "name": "Template Notes",
      "type": "n8n-nodes-base.stickyNote",
      "position": [
        -620,
        100
      ],
      "parameters": {
        "width": 560,
        "height": 640,
        "content": "## Validate and enrich refund approval requests in an n8n sub-workflow\n\n### Quick overview\nThis sub-workflow validates a refund approval request and adds simulated customer context before an AI agent drafts a proposal. It is called by the Exercise 5 parent workflow from the n8n Production AI Playbook post on Audit & Trace, where its spans appear nested under the parent trace. Customer data is synthetic.\n\n### How it works\n1. When Executed by Another Workflow receives the request from the parent workflow.\n2. Validate Request (If) checks for a non-empty requestId and reason and a positive whole-number amount in cents.\n3. Invalid requests stop at Reject Request (Stop and Error).\n4. Enrich Request (Edit Fields) returns the request with a simulated customer tier and prior refund count.\n\n### Setup\n1. Import this workflow, save it, and publish it.\n2. Import the Exercise 5 parent workflow (Trace a human approval across a wait) and select this workflow in its Enrich Request Sub-workflow node.\n3. No credentials are needed for this sub-workflow."
      },
      "typeVersion": 1
    }
  ],
  "settings": {
    "executionOrder": "v1",
    "saveManualExecutions": true,
    "saveDataErrorExecution": "all",
    "saveDataSuccessExecution": "all"
  },
  "connections": {
    "Validate Request": {
      "main": [
        [
          {
            "node": "Enrich Request",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Reject Request",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "When Executed by Another Workflow": {
      "main": [
        [
          {
            "node": "Validate Request",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}