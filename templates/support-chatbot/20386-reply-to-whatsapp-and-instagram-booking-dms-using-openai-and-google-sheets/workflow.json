    {
      "id": "6b0d2fa5-47a3-42a2-a33c-4a0e6f044121",
      "name": "Parse AI Response",
      "type": "n8n-nodes-base.code",
      "position": [
        2224,
        1360
      ],
      "parameters": {
        "jsCode": "let parsed;\ntry {\n  const raw = $json.output?.[0]?.content?.[0]?.text\n    || $json.message?.content\n    || $json.text\n    || $json.content\n    || '';\n  parsed = JSON.parse(raw);\n} catch (e) {\n  parsed = { intent: 'human_handoff', reply_text: \"Thanks for your message! Let me connect you with our team.\", lead_name: '', lead_contact: '', lead_group_size: '', lead_date: '', lead_purpose: '' };\n}\nreturn [{ json: parsed }];"
      },
      "typeVersion": 2
    },
