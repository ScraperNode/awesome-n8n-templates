      "parameters": {
        "options": {},
        "conditions": {
          "options": {
            "leftValue": "",
            "caseSensitive": true,
            "typeValidation": "loose"
          },
          "combinator": "and",
          "conditions": [
            {
              "id": "e+1234567890-+1234567890",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              },
              "leftValue": "={{ $('Workflow Configuration').first().json.dryRun }}",
              "rightValue": ""
            }
          ]
        }
      },
      "typeVersion": 2.2
    },
    {
      "id": "d0000002-0000-4000-8000-000000000012",
      "name": "Save Excerpt to WordPress",
      "type": "n8n-nodes-base.httpRequest",
      "onError": "continueRegularOutput",
      "position": [
        2400,
        400
      ],
      "parameters": {
        "url": "={{ $('Workflow Configuration').first().json.siteUrl.replace(/\\/$/, '') }}/wp-json/wp/v2/posts/{{ $json.postId }}",
        "method": "POST",
        "options": {},
        "jsonBody": "={{ JSON.stringify({ excerpt: $json.excerpt }) }}",
        "sendBody": true,
        "specifyBody": "json",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "wordpressApi"
      },
      "credentials": {
        "wordpressApi": {
          "id": "credential-id",
          "name": "WordPress account"
        }
      },
      "typeVersion": 4.2
    },
    {
      "id": "d0000002-0000-4000-8000-000000000013",
      "name": "Preview Only - No Changes Saved",
      "type": "n8n-nodes-base.noOp",
      "position": [
        2400,
        220
      ],
      "parameters": {},
      "typeVersion": 1
    },
    {
      "id": "d0000002-0000-4000-8000-000000000014",
