    {
      "id": "a161ef3b-199b-4f16-8e0c-e039eb7fa5d2",
      "name": "Extract Image",
      "type": "n8n-nodes-base.code",
      "position": [
        896,
        384
      ],
      "parameters": {
        "jsCode": "const latest = (name) => { let out = null; for (let i = 0; i < 20; i++) { try { const items = $(name).all(0, i); if (!items.length) break; out = items[0].json; } catch (e) { break; } } return out; };\nconst res = $input.first().json;\nlet b64 = (res.result && res.result.image) || res.image || null;\nlet mime = 'image/jpeg';\nif (!b64) {\n  const parts = (res.candidates && res.candidates[0] && res.candidates[0].content && res.candidates[0].content.parts) || [];\n  const img = parts.find(p => p.inlineData || p.inline_data);\n  if (img) { const d = img.inlineData || img.inline_data; b64 = d.data; mime = d.mimeType || d.mime_type || 'image/png'; }\n}\nif (!b64) { throw new Error('No image in response: ' + JSON.stringify(res).slice(0, 400)); }\nconst buf = await this.helpers.prepareBinaryData(Buffer.from(b64, 'base64'), mime === 'image/png' ? 'image.png' : 'image.jpg', mime);\nconst draft = latest('Load Latest Draft');\nreturn [{ json: { caption: draft.caption, chat_id: draft.chat_id, image_prompt: draft.image_prompt }, binary: { data: buf }, pairedItem: { item: 0 } }];"
      },
      "typeVersion": 2
