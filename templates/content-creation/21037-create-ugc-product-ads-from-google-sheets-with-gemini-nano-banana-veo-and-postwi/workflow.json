    {
      "id": "bb6bc20c-9886-4723-a78d-5a89917b4054",
      "name": "Write the ad with Gemini",
      "type": "@n8n/n8n-nodes-langchain.googleGemini",
      "position": [
        1800,
        0
      ],
      "parameters": {
        "text": "={{ (() => { const p = $('Take the next product').item.json; const s = $('Ad settings').first().json; return 'This is the photo of a product for a UGC-style ad.\\nProduct: ' + p.product + '\\nBenefit: ' + (p.benefit || '') + '\\nAudience: ' + (p.audience || '') + '\\nCreator: ' + s.creator + '\\nSetting: ' + s.setting + '\\n\\nUse only facts from the row and the photo; invent no numbers or claims. Return only JSON with the keys photo_edit (an instruction to edit this photo into a casual smartphone selfie of the creator holding the product; keep the product exactly as it looks), veo_prompt (one paragraph for an 8-second vertical selfie video: the creator, the product described exactly as in the photo, one action, and one short spoken line in quotes; no on-screen text), tiktok (a hook of up to 150 characters with 3 hashtags), instagram_reel (2 sentences and up to 4 hashtags), instagram_photo (2 sentences and up to 4 hashtags), facebook (1 or 2 sentences) and youtube_title (up to 80 characters, ending with #Shorts).'; })() }}",
        "modelId": {
          "__rl": true,
          "mode": "id",
          "value": "models/gemini-2.5-flash"
        },
        "options": {
          "maxOutputTokens": 1200
        },
        "resource": "image",
        "imageUrls": "={{ String($('Take the next product').item.json.photo_url).trim() }}",
        "inputType": "url",
        "operation": "analyze"
      },
      "typeVersion": 1.2
