          "__rl": true,
          "mode": "list",
          "value": "REPLACE_SHEET"
        },
        "documentId": {
          "__rl": true,
          "mode": "list",
          "value": "REPLACE_SPREADSHEET_ID"
        }
      },
      "typeVersion": 1
