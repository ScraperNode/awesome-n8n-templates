    {
      "id": "69205e9b-cbb1-4e0a-878e-3fd930e6412f",
      "name": "Resolve Final Response",
      "type": "n8n-nodes-base.code",
      "position": [
        3824,
        368
      ],
      "parameters": {
        "jsCode": "const rec = $('Build Review Record').first().json;\nlet decision = 'auto';\nif (rec.needs_approval) {\n  const q = $input.first().json.query || {};\n  decision = String(q.decision || 'timeout').toLowerCase();   // no click within the wait limit => timeout\n}\nlet approval_status, publish, unpublished_status = null;\nif (decision === 'auto')         { approval_status = 'not_required'; publish = true; }\nelse if (decision === 'approve') { approval_status = 'approved';     publish = true; }\nelse if (decision === 'reject')  { approval_status = 'rejected';     publish = false; unpublished_status = 'rejected'; }\nelse                             { approval_status = 'timed_out';    publish = false; unpublished_status = 'escalated'; }\nreturn [{ json: { ...rec, approval_status, decision, publish, unpublished_status, final_response: publish ? rec.ai_response : null } }];"
      },
      "typeVersion": 2
    },
