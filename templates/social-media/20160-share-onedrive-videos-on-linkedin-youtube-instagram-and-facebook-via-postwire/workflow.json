    {
      "id": "6c2f7e55-f424-4ece-a5ff-cc3ce8aed334",
      "name": "Did a network fail?",
      "type": "n8n-nodes-base.if",
      "position": [
        600,
        360
      ],
      "parameters": {
        "options": {},
        "conditions": {
          "options": {
            "version": 2,
