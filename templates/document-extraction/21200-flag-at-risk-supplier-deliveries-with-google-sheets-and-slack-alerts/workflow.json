    {
      "id": "19c2a505-b04f-4dd7-b5f6-05244c9e9a4f",
      "name": "Create Slack Alert Message",
      "type": "n8n-nodes-base.code",
      "position": [
        2272,
        304
      ],
      "parameters": {
        "jsCode": "const rows = $input.all().map(i=>i.json); const cfg = $('Set Configuration Options').first().json; const critical = rows.filter(r=>['CRITICAL','HIGH'].includes(r.risk_level)); return [{json:{channel:cfg.slackChannel,text:`Supplier Early Warning: ${rows.length} at-risk purchase order(s) detected. High/Critical: ${critical.length}.\\n`+rows.slice(0,15).map(r=>`${r.risk_level} | PO ${r.po_id} | ${r.supplier_name} | Customer ${r.customer_order_id||'N/A'} | ${r.risk_reason}`).join('\\n')}}];"
      },
      "typeVersion": 2
    },
