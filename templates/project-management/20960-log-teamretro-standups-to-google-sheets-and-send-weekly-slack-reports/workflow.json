    {
      "id": "tr1800-0000-0000-0000-000000000023",
      "name": "Build the Weekly Report",
      "type": "n8n-nodes-base.code",
      "position": [
        1240,
        820
      ],
      "parameters": {
        "jsCode": "const { days } = $('Report Settings').first().json;\nconst rows = $input.all().map((item) => item.json).filter((row) => row['Date']);\nif (!rows.length) return [];\n\n// The window ends yesterday: today's standup closes after the report runs, so it waits for\n// next week's. A manual run anchors the window to the newest logged day, so the pinned sample replays.\nconst newest = rows.map((row) => String(row['Date']).slice(0, 10)).sort().at(-1);\nconst end = $execution.mode === 'production' ? DateTime.now().minus({ days: 1 }) : DateTime.fromISO(newest);\nconst from = end.minus({ days: days - 1 }).toISODate();\nconst to = end.toISODate();\nconst inWindow = rows.filter((row) => { const d = String(row['Date']).slice(0, 10); return d >= from && d <= to; });\n\nconst byTeam = {};\nfor (const row of inWindow) (byTeam[row['Team']] ??= []).push(row);\n\nreturn Object.entries(byTeam).map(([team, teamRows]) => {\n  const standups = new Set(teamRows.map((r) => r['Date'])).size;\n  const people = {};\n  for (const r of teamRows) (people[r['Person']] ??= new Set()).add(r['Date']);\n  const blockers = teamRows.filter((r) => r['Blocker'] === 'yes');\n  const fresh = blockers.filter((r) => Number(r['Carried over']) === 0).length;\n  const longest = blockers.sort((a, b) => Number(b['Carried over']) - Number(a['Carried over']))[0];\n  const longestOpen = longest ? Number(longest['Carried over']) + 1 : 0;\n\n  const attendance = Object.entries(people)\n    .sort(([a], [b]) => a.localeCompare(b))\n    .map(([name, dates]) => `\u2022 ${name}: ${dates.size} of ${standups}${dates.size === standups ? ' :white_check_mark:' : ''}`);\n  const message = [\n    `:bar_chart: *${team}: standups ${from} to ${to}*`,\n    `${standups} standups \u00b7 ${Object.keys(people).length} people posted \u00b7 ${fresh} new ${fresh === 1 ? 'blocker' : 'blockers'}`,\n    `*Who posted*\\n${attendance.join('\\n')}`,\n    longest ? `*Longest-running blocker*\\n\u2022 ${longest['Person']}: ${longest['Update']} _(open for ${longestOpen} standups)_` : null,\n  ].filter(Boolean).join('\\n\\n');\n\n  return { json: {\n    message,\n    'Week ending': to, 'Team': team, 'Standups': standups, 'People posting': Object.keys(people).length,\n    'Updates': teamRows.length, 'New blockers': fresh, 'Longest blocker (standups)': longestOpen,\n  } };\n});"
      },
      "typeVersion": 2
    },
