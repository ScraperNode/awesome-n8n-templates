    {
      "id": "code-bump-streak",
      "name": "Bump failure streak",
      "type": "n8n-nodes-base.code",
      "position": [
        1620,
        640
      ],
      "parameters": {
        "jsCode": "const prevFailCount = Number($json.failCount || 0);\nconst newFailCount = prevFailCount + 1;\nconst needsAlert = newFailCount >= 3;\nreturn {\n  json: {\n    ...$json,\n    newFailCount,\n    needsAlert,\n    status: needsAlert ? 'needs attention' : `quiet/failed run ${newFailCount}`\n  }\n};"
      },
      "typeVersion": 2
    },
