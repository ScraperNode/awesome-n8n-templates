    {
      "id": "wa11a901-0000-4000-8000-000000000018",
      "name": "Send finds to Telegram",
      "type": "n8n-nodes-base.telegram",
      "position": [
        1660,
        240
      ],
      "webhookId": "wa11a901w-0000-4000-8000-000000000001",
      "parameters": {
        "text": "={{ (() => { const esc = s => String(s ?? '').replaceAll('&', '&amp;').replaceAll('<', '&lt;').replaceAll('>', '&gt;');\nconst items = $json.items;\nconst lines = items.slice(0, 20).map(i => {\n  const price = Number(i.Price).toLocaleString('en-US') + ' ' + (i.Currency || 'EUR');\n  return '\ud83d\udecd <b><a href=\"' + i.Link + '\">' + esc(String(i.Title).slice(0, 60)) + '</a></b>\\n'\n    + price + (i.Condition ? ' \u00b7 ' + esc(i.Condition) : '') + (i.Shipping === 'Yes' ? ' \u00b7 ships' : '') + '\\n'\n    + esc([i.City, i.Listed].filter(Boolean).join(' \u00b7 '));\n});\nreturn '<b>' + items.length + ' new Wallapop find' + (items.length === 1 ? '' : 's') + '</b>\\n\\n' + lines.join('\\n\\n')\n  + (items.length > 20 ? '\\n\\n+ ' + (items.length - 20) + ' more in your Google Sheet' : '');\n})() }}",
        "chatId": "={{ $('Set your search').first().json.telegramChatId }}",
        "additionalFields": {
          "parse_mode": "HTML",
          "appendAttribution": false,
          "disable_web_page_preview": true
        }
      },
      "typeVersion": 1.2
    }
  ],
