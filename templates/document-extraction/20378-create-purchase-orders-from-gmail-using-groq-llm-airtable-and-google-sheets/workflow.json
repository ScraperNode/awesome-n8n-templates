    {
      "id": "0b321e78-8c20-44e9-9c07-4c14d24382dc",
      "name": "Code: Match & Price Logic",
      "type": "n8n-nodes-base.code",
      "position": [
        3184,
        1728
      ],
      "parameters": {
        "jsCode": "// 1. Pull the structured AI payload and the Airtable catalog from your specific nodes\nconst aiPayload = $items(\"Set: Extract AI Output\")[0].json; \nconst requestedItems = aiPayload.items || [];\nconst isUrgent = aiPayload.is_urgent; \n\nconst catalog = $items(\"Airtable: Fetch Catalog\").map(item => item.json);\n\nconst matchedPO = [];\nconst unmatchedItems = [];\nlet poTotalCost = 0;\n\n// 2. Token overlap function \nfunction getMatchScore(query, targetKeywords) {\n  const safeQuery = String(query || '');\n  const safeTarget = String(targetKeywords || '');\n  \n  const qWords = safeQuery.toLowerCase().replace(/[^a-z0-9\\s]/g, '').split(/\\s+/).filter(w => w.length > 1);\n  const tWords = safeTarget.toLowerCase().split(/\\s+/);\n  \n  let matches = 0;\n  for (const w of qWords) {\n    if (tWords.includes(w)) matches++;\n  }\n  return qWords.length > 0 ? (matches / qWords.length) : 0;\n}\n\n// 3. Score every requested item against the catalog\nfor (const req of requestedItems) {\n  let bestMatch = null;\n  let highestScore = 0;\n\n  const searchString = `${req.item_category} ${req.item_name} ${req.target_device_or_spec || ''}`;\n\n  for (const item of catalog) {\n    // Safely target the 'fields' object where Airtable stores column data\n    const fields = item.fields || item; \n    \n    // Fallbacks to handle case-sensitivity for column names\n    const targetText = fields['Search Keywords'] || fields['search keywords'] || fields['Item Name'] || fields['item name'] || '';\n    \n    const baseScore = getMatchScore(searchString, targetText);\n    \n    // Apply preferred-vendor rank bonus (Rank 1 gives a 15% boost, Rank 2 gives 5%)\n    const prefRank = fields['Preferred Rank'] || fields['preferred rank'] || 99;\n    const rankBonus = prefRank === 1 ? 0.15 : (prefRank === 2 ? 0.05 : 0);\n    const finalScore = baseScore + rankBonus;\n    \n    if (finalScore > highestScore) {\n      highestScore = finalScore;\n      \n      // Contract pricing lookup: check for contract price first, fall back to standard price\n      const rawContractPrice = fields['Contract Price'] !== undefined ? fields['Contract Price'] : fields['contract price'];\n      const rawPrice = fields['Price'] || fields['price'] || 0;\n      const unitPrice = (rawContractPrice !== undefined && rawContractPrice !== null && rawContractPrice !== '') \n        ? Number(rawContractPrice) \n        : Number(rawPrice);\n\n      bestMatch = {\n        request_details: req,\n        matched_sku: fields['SKU'] || fields['sku'],\n        vendor: fields['Vendor ID'] || fields['vendor id'] || fields['Vendor'] || fields['vendor'],\n        unit_price: unitPrice,\n        total_cost: unitPrice * req.quantity,\n        contract_applied: (rawContractPrice !== undefined && rawContractPrice !== null && rawContractPrice !== '') ? true : false,\n        confidence_score: (Math.min(finalScore, 1.0) * 100).toFixed(0) + '%'\n      };\n    }\n  }\n\n  // 4. Threshold routing (maintaining your 0.3 threshold with preferred vendor adjustments)\n  if (highestScore >= 0.3 && bestMatch) {\n    matchedPO.push(bestMatch);\n    poTotalCost += bestMatch.total_cost;\n  } else {\n    unmatchedItems.push(req);\n  }\n}\n\n// 5. Output structured payload for downstream nodes\nreturn {\n  json: {\n    is_urgent: isUrgent,\n    ready_for_po: matchedPO,\n    requires_human_triage: unmatchedItems,\n    po_total_cost: poTotalCost\n  }\n};"
      },
      "typeVersion": 2
    },
