    {
      "id": "be1e9d28-9d2b-4f18-99c1-5394f8cc9fdc",
      "name": "Build Actor input",
      "type": "n8n-nodes-base.code",
      "position": [
        660,
        300
      ],
      "parameters": {
        "jsCode": "// Builds the Actor input from the sheet rows and the Settings node.\nconst s = $('Settings').first().json;\nconst rows = $input.all().map(i => i.json).filter(r => r.name && r.email);\nconst year = new Date().getFullYear();\nconst records = rows.map((r, i) => ({\n  ...r,\n  certificateId: r.certificateId || `${s.certificateIdPrefix}${year}-${String(i + 1).padStart(4, '0')}`,\n}));\n\nreturn [{\n  json: {\n    records,\n    actorInput: {\n      records,\n      template: s.design,\n      title: s.title,\n      subtitle: s.subtitle,\n      body: s.text,\n      date: s.date,\n      issuer: s.issuer,\n      signature1Name: s.signatureName,\n      signature1Title: s.signatureTitle,\n      accentColor: s.accentColor,\n      outputZip: false,\n    },\n  },\n}];"
      },
      "typeVersion": 2
    },
    {
      "id": "30c314d8-ee7b-4f69-8b66-3bb6b680fd2f",
      "name": "Generate PDFs on Apify",
      "type": "n8n-nodes-base.httpRequest",
      "position": [
        880,
        300
      ],
      "parameters": {
        "url": "https://api.apify.com/v2/acts/egra_van~bulk-certificate-pdf-generator/run-sync-get-dataset-items",
        "method": "POST",
        "options": {
          "timeout": 300000
        },
        "jsonBody": "={{ JSON.stringify($json.actorInput) }}",
        "sendBody": true,
        "specifyBody": "json",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth"
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "",
          "name": "Apify API token"
        }
      },
      "typeVersion": 4.2
    },
    {
      "id": "e61f27b2-ee6c-4d0e-b974-dafa8c8b1711",
      "name": "Match emails",
      "type": "n8n-nodes-base.code",
      "position": [
        1100,
        300
      ],
      "parameters": {
        "jsCode": "// Adds each person's email back to the generated certificate.\nconst records = $('Build Actor input').first().json.records;\nconst byId = Object.fromEntries(records.map(r => [r.certificateId, r]));\nreturn $input.all()\n  .map(item => {\n    const person = byId[item.json.certificateId] || {};\n    return { json: { ...item.json, email: person.email, course: person.course || '' } };\n  })\n  .filter(item => item.json.email && item.json.pdfUrl);"
      },
      "typeVersion": 2
    },
    {
      "id": "e95eed12-0ac9-491c-9287-dc02bb968e26",
      "name": "Download PDF",
      "type": "n8n-nodes-base.httpRequest",
      "position": [
        1320,
