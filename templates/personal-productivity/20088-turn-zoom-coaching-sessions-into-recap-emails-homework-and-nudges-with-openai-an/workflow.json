    {
      "id": "efd10c05-cd7e-4683-af85-bed513560a59",
      "name": "Expand Nudged Tasks",
      "type": "n8n-nodes-base.code",
      "position": [
        1360,
        992
      ],
      "parameters": {
        "jsCode": "// Expand each sent nudge back into one update per task\nconst today = new Date().toISOString().slice(0, 10);\nreturn $input.all().flatMap((item, i) => {\n  const c = $('Pick Clients to Nudge').itemMatching(i).json;\n  return c.tasks.map(t => ({\n    json: { 'Task ID': t.taskId, 'Nudge Count': t.nudgeCount + 1, 'Last Nudge Date': today },\n    pairedItem: { item: i },\n  }));\n});"
      },
      "typeVersion": 2
    },
