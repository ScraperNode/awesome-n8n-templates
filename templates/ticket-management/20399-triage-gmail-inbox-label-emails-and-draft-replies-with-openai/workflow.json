          "threadId": "={{ $('When New Email Received').item.json.threadId }}"
        },
        "subject": "=Re: {{ $('When New Email Received').item.json.subject }}",
        "resource": "draft",
        "emailType": "text",
        "operation": "create"
      },
      "credentials": {
        "gmailOAuth2": {
          "id": "GMAIL",
          "name": "Gmail account"
        }
      },
      "typeVersion": 2.1
    },
    {
