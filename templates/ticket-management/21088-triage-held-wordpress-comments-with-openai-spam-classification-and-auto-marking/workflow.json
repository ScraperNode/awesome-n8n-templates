              "type": "string",
              "value": "gpt-4o-mini"
            },
            {
              "id": "00b25e3a-bba6-50c3-95c4-b0c2fdbb6d13",
              "name": "spamConfidenceThreshold",
              "type": "number",
              "value": 0.85
            },
