    {
      "id": "43316e26-5c39-4c8d-bb2d-3e3d3df54ec3",
      "name": "Select Batch for Processing",
      "type": "n8n-nodes-base.code",
      "position": [
        1552,
        736
      ],
      "parameters": {
        "jsCode": "const products = $('Fetch All Products').all().map(it => it.json).filter(p => p && p.id != null);\nconst tableRows = $input.all().map(it => it.json);\nconst indexMap = {};\nfor (const r of tableRows) { if (r.productId) { indexMap[String(r.productId)] = r.dateModified; } }\n\nconst batchSize = Number($('Set API Settings').first().json.productBatchSize) || 30;\nconst pending = [];\nfor (const p of products) {\n  const known = indexMap[String(p.id)];\n  if (!known || known !== p.date_modified) { pending.push(p); }\n}\n\nconst batch = pending.slice(0, batchSize);\nreturn batch.map(p => ({ json: p }));"
      },
      "typeVersion": 2
    },
    {
      "id": "086754e4-856a-442c-a00e-13515fc5e006",
      "name": "Identify Deleted Products",
      "type": "n8n-nodes-base.code",
      "position": [
        1552,
        1536
      ],
      "parameters": {
        "jsCode": "// Safety guard: only real products (with an id) count. If the product list is empty or the\n// WooCommerce request failed, delete NOTHING - otherwise a temporary API outage would wipe the knowledge base.\nconst products = $('Fetch All Products').all().map(it => it.json).filter(p => p && p.id != null);\nif (!products.length) { return []; }\nconst productIds = new Set(products.map(p => String(p.id)));\nconst tableRows = $input.all().map(it => it.json);\nconst orphans = tableRows.filter(r => r.productId && !productIds.has(String(r.productId)));\nreturn orphans.map(o => ({ json: { productId: o.productId } }));"
      },
      "typeVersion": 2
    },
