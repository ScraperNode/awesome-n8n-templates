    {
      "id": "293d568f-38d6-44ac-ae20-a9cb64ddc398",
      "name": "JS - Evaluate Breaker State",
      "type": "n8n-nodes-base.code",
      "position": [
        528,
        880
      ],
      "parameters": {
        "jsCode": "const ctx = $('IF - Service Registered').first().json;\nconst raw = $input.first().json?.stateRaw;\n\nlet stored = null;\nif (raw) {\n  try { stored = typeof raw === 'string' ? JSON.parse(raw) : raw; } catch (e) { stored = null; }\n}\n\nconst now = Date.now();\nlet breakerState = 'CLOSED';\nlet decision = 'allow';\nlet retryAfterSeconds = 0;\nlet openedAt = null;\n\nif (stored && stored.state === 'OPEN') {\n  openedAt = Number(stored.openedAt) || now;\n  const reopenAt = openedAt + Number(ctx.openDurationSeconds) * 1000;\n  if (now < reopenAt) {\n    breakerState = 'OPEN';\n    decision = 'reject';\n    retryAfterSeconds = Math.ceil((reopenAt - now) / 1000);\n  } else {\n    breakerState = 'HALF_OPEN';\n    decision = 'probe';\n  }\n}\n\nreturn [{\n  json: {\n    ...ctx,\n    breakerState,\n    decision,\n    openedAt,\n    retryAfterSeconds,\n    reason: decision === 'reject' ? 'circuit_open' : null\n  }\n}];"
      },
      "typeVersion": 2
    },
    {
