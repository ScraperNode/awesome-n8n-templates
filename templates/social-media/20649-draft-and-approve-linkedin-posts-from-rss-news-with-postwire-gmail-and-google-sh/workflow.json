        "sendTo": "={{ $('Your feed and angle').first().json.email }}",
        "message": "={{ $json.drafts.linkedin.text + '\\n\\n---\\nSource: ' + $('Newest story').item.json.link }}",
        "options": {
          "appendAttribution": false
        },
        "subject": "={{ 'LinkedIn post ready: ' + $('Newest story').item.json.title.slice(0, 80) }}",
        "operation": "sendAndWait",
        "responseType": "approval",
        "approvalOptions": {
          "values": {
            "approvalType": "double",
            "approveLabel": "Post it",
            "disapproveLabel": "Skip"
          }
        }
      },
      "typeVersion": 2.1
