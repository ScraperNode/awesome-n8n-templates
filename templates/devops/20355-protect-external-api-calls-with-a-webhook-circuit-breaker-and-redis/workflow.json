              "value": "={{ { \"payments-api\": { \"baseUrl\": \"https://api.payments-provider.example.com\", \"failureThreshold\": 3, \"openDurationSeconds\": 60 }, \"email-provider\": { \"baseUrl\": \"https://api.email-provider.example.com\" }, \"geocoding-api\": { \"baseUrl\": \"https://api.geocoding.example.com\", \"failureThreshold\": 10, \"openDurationSeconds\": 20 } } }}"
