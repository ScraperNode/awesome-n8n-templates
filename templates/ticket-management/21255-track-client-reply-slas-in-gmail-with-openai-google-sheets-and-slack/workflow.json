    {
      "id": "52245b6f-299d-4044-a269-c162cd42894b",
      "name": "Compare with Reply Log",
      "type": "n8n-nodes-base.code",
      "position": [
        1100,
        80
      ],
      "parameters": {
        "jsCode": "// The sheet is the memory: raise once, escalate once, close with the real response time.\nconst cfg = $('Configure settings').first().json;\nconst target = Number(cfg.reply_target_hours) || 4;\nconst logged = {};\nfor (const { json: r } of $input.all()) if (r.inbound_message_id) logged[String(r.inbound_message_id)] = r;\n\nconst out = [];\nfor (const { json: t } of $('Find threads waiting on you').all()) {\n  const row = logged[String(t.inbound_message_id)];\n  const base = { ...t, slack_channel: cfg.slack_channel,\n                 link: `https://mail.google.com/mail/u/0/#all/${t.thread_id}` };\n  if (!row) {\n    if (!t.replied_at && t.hours_waiting >= target) {\n      out.push({ json: { ...base, change: 'new', stage: t.hours_waiting >= target * 2 ? 'overdue' : 'due' } });\n    }\n  } else if (row.status === 'open') {\n    if (t.replied_at) out.push({ json: { ...base, change: 'replied' } });\n    else if (row.stage === 'due' && t.hours_waiting >= target * 2) {\n      out.push({ json: { ...base, change: 'escalated', stage: 'overdue', summary: row.summary, priority: row.priority } });\n    }\n  }\n}\nreturn out;"
      },
      "typeVersion": 2
    },
