  "nodes": [
    {
      "id": "f9c66f3d-0b93-4446-a2b8-e04f5931a963",
      "name": "Sticky \u2014 START HERE \u2014 Free: RSS \u2192 Content Drafts",
      "type": "n8n-nodes-base.stickyNote",
      "position": [
        -720,
        80
      ],
      "parameters": {
        "color": 4,
        "width": 400,
        "height": 240,
        "content": "## START HERE \u2014 Free: RSS \u2192 Content Drafts\nRuns daily at 8am. Replace the RSS URL with a feed for YOUR trade.\nDrafts land in a Google Sheet \u2014 starting points for Google Business Profile / social posts, not finished posts."
      },
      "typeVersion": 1
    },
    {
      "id": "4c8567e8-dbfb-4859-889f-c3d9e29dc2da",
      "name": "Sticky \u2014 Your CRM-style draft sheet",
      "type": "n8n-nodes-base.stickyNote",
      "position": [
        80,
        80
      ],
      "parameters": {
        "color": 4,
        "width": 380,
        "height": 240,
        "content": "## Your CRM-style draft sheet\nCreate a sheet named 'Content Drafts' with headers:\nDate | Headline | Source | Link | Suggested Angle | Status\nThen connect your Google account in the Sheets node."
      },
      "typeVersion": 1
    },
    {
      "id": "b24259d0-c379-41a3-9073-35240e9a2fb5",
      "name": "Schedule \u2014 Daily 8am",
      "type": "n8n-nodes-base.scheduleTrigger",
      "position": [
        -640,
        420
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "days",
              "daysInterval": 1,
              "triggerAtHour": 8,
              "triggerAtMinute": 0
            }
          ]
        }
      },
      "typeVersion": 1.2
    },
    {
      "id": "75dd1a16-7944-40ee-ab68-da7c67f837cd",
      "name": "RSS \u2014 Industry Feed",
      "type": "n8n-nodes-base.rssFeedRead",
      "notes": "Replace with a real feed: industry association, supplier blog, or local news. Duplicate this node to watch a second feed.",
      "position": [
        -400,
        420
      ],
      "parameters": {
        "url": "https://REPLACE-WITH-AN-INDUSTRY-FEED.example/rss.xml",
        "options": {}
      },
      "typeVersion": 1.1
    },
    {
      "id": "6fc48ca1-fd1b-46a1-a9b2-4b52b5895078",
      "name": "Set \u2014 Make Content Draft",
      "type": "n8n-nodes-base.set",
      "position": [
        -160,
        420
      ],
      "parameters": {
        "options": {},
        "assignments": {
          "assignments": [
            {
              "id": "255039fb-95c4-449b-b043-7d03c14460c4",
              "name": "date",
              "type": "string",
              "value": "={{ $now.toISO().slice(0,10) }}"
            },
            {
              "id": "68810c22-69f5-4ee9-a6db-7a5068e529a6",
              "name": "headline",
              "type": "string",
              "value": "={{ $json.title }}"
            },
            {
              "id": "c7e48f9a-99b8-4cc3-9408-a975d93c7482",
              "name": "source",
              "type": "string",
              "value": "={{ $json.creator || 'Industry feed' }}"
            },
            {
              "id": "9d4b5ea6-7c26-435b-8c02-59926fd64e62",
              "name": "link",
              "type": "string",
              "value": "={{ $json.link }}"
            },
            {
              "id": "a2e9aec4-5afa-4344-bf6f-c74519cfc64b",
              "name": "suggestedAngle",
              "type": "string",
              "value": "=What this means for our customers locally \u2014 2-3 sentences in your own words, one practical tip, and a soft call to action (call/book link). Source: {{ $json.link }}"
            },
            {
              "id": "608cce1c-4e28-465e-b5b9-e3dab145de66",
              "name": "status",
              "type": "string",
              "value": "Draft"
            }
          ]
        }
      },
      "typeVersion": 3.4
    },
    {
      "id": "18aea6b7-0e29-49ab-8775-d1fce1f89d71",
      "name": "Sheets \u2014 Save Draft",
      "type": "n8n-nodes-base.googleSheets",
