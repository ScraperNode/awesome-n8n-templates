    {
      "id": "833fd7b6-6a8a-4fe0-8e08-e2b4faeb9ed1",
      "name": "Compute Tolerance Deviation",
      "type": "n8n-nodes-base.code",
      "position": [
        1552,
        -96
      ],
      "parameters": {
        "jsCode": "const j = $json;\nconst testLoad = Number(j.test_load);\nconst measured = Number(j.measured_reading);\nconst deviceClass = j.device_class || 'III';\nconst validData = Number.isFinite(testLoad) && testLoad > 0 && Number.isFinite(measured) && !!j.device_id;\nlet deviationPct = null, tolerancePct = null, statusHint = null;\nif (validData) {\n  deviationPct = Math.abs(measured - testLoad) / testLoad * 100;\n  // Simplified NIST Handbook 44 maintenance-tolerance bands by device class\n  tolerancePct = deviceClass === 'III' ? 0.10 : deviceClass === 'IIII' ? 0.20 : 0.05;\n  if (deviationPct <= tolerancePct) statusHint = 'in_tolerance';\n  else if (deviationPct <= tolerancePct * 3) statusHint = 'adjustable';\n  else statusHint = 'condemned_candidate';\n}\nreturn [{ json: { ...j, valid_data: validData, deviation_pct: deviationPct, tolerance_pct: tolerancePct, status_hint: statusHint } }];"
      },
      "typeVersion": 2
    },
