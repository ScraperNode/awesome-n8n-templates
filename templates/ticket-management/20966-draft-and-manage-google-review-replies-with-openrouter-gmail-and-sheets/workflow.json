      "parameters": {
        "sendTo": "={{ $('Workflow Settings').first().json.ownerEmail }}",
        "message": "=A step in the Google review workflow failed.\n\nNode: {{ $('Prepare Error Log').item.json.Node }}\nError: {{ $('Prepare Error Log').item.json.Error }}\nExecution ID: {{ $('Prepare Error Log').item.json['Execution ID'] }}",
        "options": {
