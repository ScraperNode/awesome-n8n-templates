    {
      "id": "fbe60bf8-5f63-465e-ae90-d97a729861b1",
      "name": "Reconcile and Score Risk",
      "type": "n8n-nodes-base.code",
      "position": [
        944,
        304
      ],
      "parameters": {
        "jsCode": "const now=new Date(), date=v=>{const d=new Date(v);return isNaN(d)?null:d}, key=v=>String(v??'').trim(); const inv=$('Read Invoice Register').all().map(i=>i.json), pay=$('Recheck Latest Payment Data').all().map(i=>i.json), paid={}; for(const p of pay){const id=key(p.Invoice_ID);paid[id]=(paid[id]||0)+Number(p.Amount_Paid||0)} const out=[]; for(const r of inv){const id=key(r.Invoice_ID), due=date(r.Due_Date), email=key(r.Email), amount=Number(r.Amount||0), balance=Math.max(0,amount-(paid[id]??Number(r.Amount_Paid||0))), status=key(r.Payment_Status).toLowerCase(), approvalStatus=key(r.Approval_Status).toLowerCase(); if(!id||!email||!due||balance<=0||['paid','settled','cancelled','disputed'].includes(status)||['pending','approved','not_approved','rejected'].includes(approvalStatus)||key(r.Dispute_Status).toLowerCase()==='yes')continue; const days=Math.max(0,Math.floor((now-due)/86400000)), last=date(r.Last_Reminder_Date), quiet=last?Math.floor((now-last)/86400000):999; if(quiet<3)continue; const stage=days<=0?'first':days<=7?'second':'final', count=Number(r.Reminder_Count||0)+1, risk=Math.round(balance/1000+days*2+(stage==='final'?15:0)), approval=stage==='final'||risk>=100; out.push({json:{...r,Invoice_ID:id,Customer_Name:r.Customer_Name||'Customer',Email:email,Amount:amount,Amount_Paid:paid[id]??Number(r.Amount_Paid||0),Balance:balance,Days_Overdue:days,Risk_Score:risk,Risk_Band:risk>=100?'high':risk>=50?'medium':'low',Dunning_Stage:stage,Approval_Required:approval,Reminder_Count:count,Reminder_Date:now.toISOString().slice(0,10),Next_Follow_Up:stage==='final'?'':new Date(now.getTime()+3*86400000).toISOString().slice(0,10)}})} return out;"
      },
      "typeVersion": 2
    },
