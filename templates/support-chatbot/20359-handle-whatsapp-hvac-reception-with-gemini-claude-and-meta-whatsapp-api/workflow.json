    {
      "id": "62c1e998-8dda-495a-af94-ee7bb4128bb6",
      "name": "Merge Messages",
      "type": "n8n-nodes-base.code",
      "position": [
        3072,
        384
      ],
      "parameters": {
        "jsCode": "// Every line this customer sent during the wait, oldest first, as one message\nconst lines = $input.all()\n  .map(item => item.json)\n  .sort((a, b) => a.id - b.id)\n  .map(row => row.text)\n  .filter(Boolean);\n\nreturn [{ json: { text: lines.join('\\n') } }];"
      },
      "typeVersion": 2
    },
