    {
      "id": "dc4f3eef-dd25-45c6-ad10-247baa9de1d0",
      "name": "Get replies",
      "type": "@n8n/n8n-nodes-langchain.mcpClient",
      "onError": "continueRegularOutput",
      "position": [
        1460,
        200
      ],
      "parameters": {
        "tool": {
          "__rl": true,
          "mode": "id",
          "value": "get_responses"
        },
        "options": {},
        "inputMode": "json",
        "jsonInput": "={{ JSON.stringify({ campaign_id: $('Sort appointments').item.json.campaign_id }) }}",
