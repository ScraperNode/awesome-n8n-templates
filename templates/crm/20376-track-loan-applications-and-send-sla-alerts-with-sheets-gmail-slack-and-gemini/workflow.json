    {
      "id": "3060b9b2-4d45-4eb1-9dc7-9e4b41416b22",
      "name": "Detect Changes + SLA + High Value",
      "type": "n8n-nodes-base.code",
      "position": [
        480,
        736
      ],
      "parameters": {
        "jsCode": "const rows = items.map(i => i.json);\nconst now = new Date();\n\n// Detect status changes\nconst changed = rows.filter(row => {\n  if (!row.current_status) return false;\n  return row.current_status !== row.last_notified_status;\n});\n\n// SLA breach: under_review > 3 days\nconst slaBreached = rows.filter(row => {\n  if (row.current_status !== 'under_review') return false;\n  const updated = new Date(row.last_updated);\n  return (now - updated) > 3 * 24 * 60 * 60 * 1000;\n});\n\n// High value: loan > 2000000\nconst slaIds = new Set(slaBreached.map(r => r.application_id));\n\nreturn changed.map(r => ({\n  json: {\n    ...r,\n    sla_breached: slaIds.has(r.application_id),\n    sla_alert_due: slaIds.has(r.application_id) && (!r.last_sla_alert_sent || (now - new Date(r.last_sla_alert_sent)) > 24 * 60 * 60 * 1000),\n    is_high_value: parseFloat(String(r.loan_amount).replace(/[^0-9.]/g, '')) > 2000000,\n    retry_count: 0\n  }\n}));"
      },
      "typeVersion": 2
    },
