    {
      "id": "4eadbb0c-b227-4f54-8af2-1aa53a264095",
      "name": "Fetch Trustpilot Reviews",
      "type": "n8n-nodes-scrapio.scrapio",
      "position": [
        1296,
        608
      ],
      "parameters": {
        "domain": "={{ $json.domain }}",
        "resource": "trustpilot",
        "operation": "reviews",
        "additionalFields": {
          "limit": 20
        }
      },
