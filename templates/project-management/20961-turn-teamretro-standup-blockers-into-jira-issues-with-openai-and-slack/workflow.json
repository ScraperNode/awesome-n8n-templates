    {
      "id": "tr1900-0000-0000-0000-000000000012",
      "name": "Sort the Blockers",
      "type": "n8n-nodes-base.code",
      "position": [
        1460,
        300
      ],
      "parameters": {
        "jsCode": "const { blockerTopic, staleAfter } = $('Settings').first().json;\nconst standup = $('When Standup Closes').first().json.data.standup;\n// Open issues are keyed on the series. Without its id, one standup's issues would match another's.\nif (!standup.meetingSeriesId) throw new Error('This standup has no meetingSeriesId. Update TeamRetro, or check the standup belongs to a series.');\nconst isBlocker = (title) => title.toLowerCase().includes(String(blockerTopic).toLowerCase());\n// A blank or 0 staleAfter nudges at every standup instead of never.\nconst nudgeEvery = Math.max(1, Number(staleAfter) || 1);\nconst meta = { team: standup.team.name, meetingSeriesId: standup.meetingSeriesId, date: standup.date };\n\n// This standup series' open issues, one Data Table row each.\nconst open = $input.all().map((item) => item.json).filter((row) => row.updateId);\nconst byUpdateId = new Map(open.map((row) => [row.updateId, row]));\nconst matched = new Set();\n// Who answered today, by TeamRetro id: names change, and anonymous ones all read the same.\nconst posted = new Map();\nconst items = [];\nfor (const { participant, topics } of standup.updates || []) {\n  const personId = participant?.id;\n  const person = participant?.name || 'A team member';\n  if (personId && topics.some(({ updates }) => updates.length)) posted.set(personId, person);\n  for (const { topic, updates } of topics) {\n    if (!isBlocker(topic.title)) continue;\n    for (const update of updates) {\n      // Already handled: this standup was delivered before.\n      if (byUpdateId.has(update.id)) {\n        matched.add(update.id);\n        continue;\n      }\n      const standupsOpen = update.carriedForwardCount + 1;\n      const blocker = { ...meta, kind: 'new', updateId: update.id, standupsOpen, personId, person, text: update.text };\n      if (!update.carriedFromStandupUpdateId) {\n        items.push(blocker);\n        continue;\n      }\n      // Matched on the update it was carried from, or on person and text when a standup in between never reached this workflow.\n      const row = byUpdateId.get(update.carriedFromStandupUpdateId)\n        ?? open.find((r) => !matched.has(r.updateId) && personId && r.personId === personId && r.text === update.text);\n      // No row: it was never ticketed.\n      if (!row) continue;\n      matched.add(row.updateId);\n      items.push({ ...blocker, kind: 'carried', rowUpdateId: row.updateId, issueKey: row.issueKey, dueNudge: standupsOpen % nudgeEvery === 0 });\n    }\n  }\n}\n// Its owner answered today without carrying it, so it has cleared. Someone who did not answer may still carry theirs next time.\nfor (const row of open) {\n  if (matched.has(row.updateId) || !posted.has(row.personId)) continue;\n  items.push({ ...meta, kind: 'cleared', rowUpdateId: row.updateId, issueKey: row.issueKey, person: posted.get(row.personId) });\n}\n// n8n runs the next node's branches top to bottom on the canvas. Carried over and cleared sit above\n// new, so a failed triage, ticket or Slack post never stops an open issue being followed.\nreturn items.map((json) => ({ json, pairedItem: { item: 0 } }));"
      },
      "typeVersion": 2
    },
