    {
      "id": "aecb2c66-b6a0-54e4-b8d9-f4d240496a86",
      "name": "List what to send",
      "type": "n8n-nodes-base.code",
      "position": [
        3520,
        40
      ],
      "parameters": {
        "jsCode": "// One item per file to send back. Telegram bots upload up to 50 MB;\n// bigger edits go as Renderster's 720p copy (light_url) or as a link.\nconst r = $input.first().json.result || {};\nconst MAX = 49 * 1024 * 1024;\nconst items = [];\n// message is the text sent instead of the file (too big, or Telegram refused it).\n// Both go in HTML parse mode, so titles, hashtags and URLs are escaped.\nconst esc = s => String(s || '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\nconst add = (url, size, caption, link = url) => {\n  const sendable = !!url && size > 0 && size <= MAX;\n  const message = (caption || '') + (link ? '\\n' + link : '');\n  items.push({ json: { url, sendable, caption: esc((caption || '').slice(0, 1000)), message: esc(message.slice(0, 4000)) } });\n};\nif (r.edited) {\n  const e = r.edited, title = e.title || 'Your edited video';\n  if (e.size <= MAX) add(e.url, e.size, title, e.url);\n  else if (e.light_url) add(e.light_url, 15 * 1024 * 1024, title + '\\nFull quality: ' + e.url, '');\n  else add('', 0, title, e.url);\n}\nconst language = code => { try { return new Intl.DisplayNames(['en'], { type: 'language' }).of(code) || code; } catch (e) { return code; } };\nif (r.dubbed) add(r.dubbed.url, r.dubbed.size, 'Dubbed into ' + language(r.dubbed.language) + (r.dubbed.subtitles_url ? '\\nSubtitles: ' + r.dubbed.subtitles_url : ''), r.dubbed.url);\nfor (const c of r.clips || []) add(c.url, c.size, [c.title, (c.hashtags || []).join(' ')].filter(Boolean).join('\\n'), c.url);\nif (!items.length && r.transcript) {\n  const tr = r.transcript;\n  add('', 0, 'Transcript (' + (tr.language || '?') + ')\\nSRT: ' + (tr.srt_url || '') + '\\n\\n' + (tr.text || '').slice(0, 3000), '');\n}\nif (!items.length) add('', 0, 'The job finished with nothing to send. ' + (r.warnings || []).join(' '), '');\nreturn items;"
      },
      "typeVersion": 2
    },
