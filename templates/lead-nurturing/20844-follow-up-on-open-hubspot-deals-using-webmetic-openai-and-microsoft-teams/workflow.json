        860,
        100
      ],
      "parameters": {
        "color": 7,
        "width": 620,
        "height": 340,
        "content": "## 2. Open deal in HubSpot?\nOnly companies with an open deal go on"
      },
      "typeVersion": 1
    },
    {
      "id": "24ecb6f3-22dc-5fbd-a42d-8cd1814d2278",
      "name": "Section: follow-up",
      "type": "n8n-nodes-base.stickyNote",
      "position": [
        1500,
        100
      ],
      "parameters": {
        "color": 7,
        "width": 820,
        "height": 560,
        "content": "## 3. Follow-up for the deal owner\nAI suggestion, task in the deal, Teams alert"
      },
      "typeVersion": 1
    },
    {
      "id": "c51a2379-5f5a-5b40-9be0-c4ee5c9ae69e",
      "name": "Every hour",
      "type": "n8n-nodes-base.scheduleTrigger",
      "position": [
        0,
        240
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "hoursInterval": 1
            }
          ]
        }
      },
      "typeVersion": 1.3
    },
    {
      "id": "bb0d68c5-fcac-53fe-8754-2f55aa80c7ce",
      "name": "Settings",
      "type": "n8n-nodes-base.set",
      "position": [
        220,
        240
      ],
      "parameters": {
        "options": {},
        "assignments": {
          "assignments": [
            {
              "id": "52c59728-57a9-5032-960b-c2cc6986a0f3",
              "name": "domain",
              "type": "string",
              "value": "example.com"
            },
            {
              "id": "ea2b41c6-cb94-5768-bd2f-38583200421a",
              "name": "yourCompany",
              "type": "string",
              "value": "Acme GmbH"
            },
            {
              "id": "8f0b2e79-6609-5969-ad18-540c0600f815",
              "name": "whatYouSell",
              "type": "string",
              "value": "One sentence about what you sell and for whom"
            },
            {
              "id": "d9d459c4-03a6-5227-abde-19ac98f2ebb9",
              "name": "language",
              "type": "string",
              "value": "English"
            }
          ]
        }
      },
      "typeVersion": 3.4
    },
    {
      "id": "8cdbc0cf-d553-5f73-aee4-cb10d95f9392",
      "name": "Get returning visits",
      "type": "n8n-nodes-webmetic.webmetic",
      "position": [
        440,
        240
      ],
      "parameters": {
        "domain": "={{ $json.domain }}",
        "resource": "returningVisits",
        "operation": "get",
        "additionalFields": {
          "to_date": "now",
          "from_date": "-7 days"
        }
      },
      "typeVersion": 2
    },
    {
      "id": "cf432e23-361c-5188-aa34-c729749b3816",
      "name": "Once per company per day",
      "type": "n8n-nodes-base.removeDuplicates",
      "position": [
        660,
        240
      ],
      "parameters": {
        "options": {},
        "operation": "removeItemsSeenInPreviousExecutions",
        "dedupeValue": "={{ $json.company_id }}-{{ $json.sessions.map(s => s.timestamp).sort().at(-1).slice(0, 10) }}"
      },
      "typeVersion": 2
    },
    {
      "id": "390edee6-0326-5485-a8b7-0b05475ad70a",
      "name": "Find company in HubSpot",
      "type": "n8n-nodes-base.httpRequest",
      "position": [
        920,
        240
      ],
      "parameters": {
        "url": "https://api.hubapi.com/crm/v3/objects/companies/search",
        "method": "POST",
        "options": {},
        "jsonBody": "={\n  \"filterGroups\": [{ \"filters\": [{ \"propertyName\": \"domain\", \"operator\": \"EQ\", \"value\": \"{{ $('Get returning visits').item.json.company_url }}\" }] }],\n  \"properties\": [\"name\", \"hs_num_open_deals\"],\n  \"limit\": 1\n}",
        "sendBody": true,
        "specifyBody": "json",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "hubspotAppToken"
      },
      "typeVersion": 4.4
    },
    {
      "id": "250a79da-24c7-5504-ba06-e77761c982d0",
      "name": "Open deal in HubSpot?",
      "type": "n8n-nodes-base.if",
      "position": [
        1120,
        240
      ],
      "parameters": {
        "options": {},
        "conditions": {
          "options": {
            "version": 3,
            "leftValue": "",
            "caseSensitive": true,
            "typeValidation": "strict"
          },
          "combinator": "and",
          "conditions": [
            {
              "id": "8052bc1f-4ef3-52b2-94b3-1648f5c0a981",
              "operator": {
                "type": "number",
                "operation": "gt"
              },
              "leftValue": "={{ Number($json.results[0]?.properties?.hs_num_open_deals || 0) }}",
              "rightValue": 0
            }
          ]
        }
      },
      "typeVersion": 2.3
    },
    {
      "id": "d7bc6565-8520-5365-a814-21ff95057601",
      "name": "Find open deal",
      "type": "n8n-nodes-base.httpRequest",
      "position": [
        1320,
        240
      ],
      "parameters": {
        "url": "https://api.hubapi.com/crm/v3/objects/deals/search",
        "method": "POST",
        "options": {},
        "jsonBody": "={\n  \"filterGroups\": [{ \"filters\": [\n    { \"propertyName\": \"associations.company\", \"operator\": \"EQ\", \"value\": \"{{ $json.results[0].id }}\" },\n    { \"propertyName\": \"hs_is_closed\", \"operator\": \"EQ\", \"value\": \"false\" }\n  ] }],\n  \"properties\": [\"dealname\", \"dealstage\", \"amount\", \"hubspot_owner_id\"],\n  \"sorts\": [{ \"propertyName\": \"hs_lastmodifieddate\", \"direction\": \"DESCENDING\" }],\n  \"limit\": 1\n}",
        "sendBody": true,
        "specifyBody": "json",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "hubspotAppToken"
      },
      "typeVersion": 4.4
    },
    {
      "id": "25af8107-c3b0-5226-89d1-2e9e85176967",
      "name": "Suggest next step",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "position": [
        1580,
        240
      ],
      "parameters": {
        "text": "=You are an experienced B2B account manager. A company with an open deal is back on our website. Suggest the best follow-up for the deal owner.\n\nOUR COMPANY\n- Name: {{ $('Settings').item.json.yourCompany }}\n- What we sell: {{ $('Settings').item.json.whatYouSell }}\n\nTHE DEAL\n- Deal: {{ $json.results[0].properties.dealname }}\n- Stage: {{ $json.results[0].properties.dealstage }}\n- Amount: {{ $json.results[0].properties.amount || 'unknown' }}\n\nTHE COMPANY\n- Company: {{ $('Get returning visits').item.json.company_name }}\n- Visits in the last 7 days: {{ $('Get returning visits').item.json.sessions_total }}\n- Pages read: {{ ($('Get returning visits').item.json.sessions || []).flatMap(s => s.user_data || []).map(p => p.document_title + ' (' + Math.round(p.time_spent || 0) + 's)').join(' -> ') || 'unknown' }}\n\nWRITE\n1. What their reading suggests (2 sentences)\n2. The follow-up: channel, timing and the first sentence to say or write\n3. One piece of content worth sending\n\nRULES: Write in {{ $('Settings').item.json.language }}. Maximum 150 words. Never say that you saw their website visit. Output simple HTML using only h3, p, ul and li.",
        "options": {},
        "promptType": "define"
      },
      "typeVersion": 3.1
    },
    {
      "id": "6e91e207-c315-58b5-9e21-c8d023e99c49",
      "name": "OpenAI Chat Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "position": [
        1600,
        460
      ],
      "parameters": {
        "model": {
          "__rl": true,
          "mode": "list",
          "value": "gpt-5-mini"
        },
        "options": {}
      },
      "typeVersion": 1.3
    },
    {
      "id": "fc82e72f-3982-58cf-956f-e23b270a64b1",
      "name": "Create follow-up task",
      "type": "n8n-nodes-base.hubspot",
      "position": [
        1920,
        240
      ],
      "parameters": {
        "type": "task",
        "dueDate": "={{ $now.toISO() }}",
        "metadata": {
          "body": "={{ $json.output }}",
          "status": "NOT_STARTED",
          "subject": "=Follow up: {{ $('Get returning visits').item.json.company_name }} is back on your website"
        },
        "resource": "engagement",
        "authentication": "appToken",
        "additionalFields": {
          "associations": {
            "dealIds": "={{ $('Find open deal').item.json.results[0].id }}",
            "ownerId": "={{ Number($('Find open deal').item.json.results[0].properties.hubspot_owner_id) }}",
            "companyIds": "={{ $('Find company in HubSpot').item.json.results[0].id }}"
          }
        }
      },
      "typeVersion": 2.2
    },
    {
      "id": "32c5daed-91df-5d81-bd39-127a867145c1",
      "name": "Notify account manager in Teams",
      "type": "n8n-nodes-base.microsoftTeams",
      "position": [
        2140,
        240
      ],
      "parameters": {
        "teamId": {
          "__rl": true,
          "mode": "list",
          "value": ""
        },
        "message": "=<b>Open deal back on the website:</b> {{ $('Find open deal').item.json.results[0].properties.dealname }} ({{ $('Get returning visits').item.json.company_name }})<br>{{ $('Get returning visits').item.json.sessions_total }} visits in the last 7 days.<br>The deal owner has a follow-up task with a suggestion in HubSpot.",
        "options": {
          "includeLinkToWorkflow": false
        },
        "resource": "channelMessage",
        "channelId": {
          "__rl": true,
          "mode": "list",
          "value": ""
        },
        "operation": "create",
        "contentType": "html"
      },
      "typeVersion": 2
    }
  ],
