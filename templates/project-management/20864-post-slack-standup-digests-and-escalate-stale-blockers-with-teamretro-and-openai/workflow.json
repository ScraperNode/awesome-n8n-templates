    {
      "id": "tr1600-0000-0000-0000-000000000013",
      "name": "Prepare the Standup",
      "type": "n8n-nodes-base.code",
      "position": [
        1460,
        300
      ],
      "parameters": {
        "jsCode": "// TeamRetro sends each update as plain text with inline Markdown. Slack mrkdwn needs\n// &, < and > escaped, and strikes through with one ~ where TeamRetro uses two.\nconst toMrkdwn = (text) => text\n  .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')\n  .replace(/~~(.+?)~~/g, '~$1~');\n\nconst { blockerTopic, staleAfter } = $('Settings').first().json;\nconst standup = $('When Standup Closes').first().json.data.standup;\nconst isBlocker = (title) => title.toLowerCase().includes(String(blockerTopic).toLowerCase());\n// A blank or 0 staleAfter escalates at every standup instead of never.\nconst escalateEvery = Math.max(1, Number(staleAfter) || 1);\n\nconst blockers = [];\nconst details = [];\nconst transcript = [];\nfor (const { participant, topics } of standup.updates) {\n  const name = participant.name || 'Anonymous';\n  const lines = [`*${name}*`];\n  for (const { topic, updates } of topics) {\n    if (!updates.length) continue;\n    for (const update of updates) {\n      transcript.push(`${name} [${topic.title}]: ${update.text}`);\n      if (isBlocker(topic.title)) {\n        blockers.push({ name, text: toMrkdwn(update.text), standupsOpen: update.carriedForwardCount + 1 });\n      }\n    }\n    // Blockers are listed once, in the main message.\n    if (!isBlocker(topic.title)) lines.push(`_${topic.title}_`, ...updates.map((u) => `\u2022 ${toMrkdwn(u.text)}`));\n  }\n  details.push(lines.join('\\n'));\n}\n\nreturn [{ json: {\n  team: standup.team.name,\n  title: standup.title || 'Standup',\n  date: standup.date,\n  people: standup.updates.length,\n  transcript: transcript.join('\\n'),\n  details: details.join('\\n\\n'),\n  blockers,\n  staleBlockers: blockers.filter((b) => b.standupsOpen % escalateEvery === 0),\n} }];"
      },
      "typeVersion": 2
    },
    {
      "id": "tr1600-0000-0000-0000-000000000014",
      "name": "Summarise the Standup",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "position": [
        1680,
        300
      ],
      "parameters": {
        "text": "=Team: {{ $json.team }}. {{ $json.title }} on {{ $json.date }}, {{ $json.people }} people posted.\n\n{{ $json.transcript }}",
        "messages": {
          "messageValues": [
            {
              "type": "SystemMessagePromptTemplate",
              "message": "You summarise a team's daily standup for its Slack channel. Return: headline, one sentence under 20 words on the day's overall state; highlights, at most 3 short items of notable progress; watchouts, at most 3 short items naming risks or dependencies that are not already in the 'blocking' answers (an empty list if there are none). Use only what the updates say: never invent work, owners or dates."
            }
          ]
        },
        "promptType": "define",
        "hasOutputParser": true
      },
      "typeVersion": 1.5
    },
