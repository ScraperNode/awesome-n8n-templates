            },
            {
              "key": "headline",
              "value": "={{ $json.message.content.headline }}"
            },
            {
              "key": "subtitle",
              "value": "={{ $json.message.content.excerpt }}"
            },
            {
              "key": "brand_handle",
              "value": "={{ $('Map post fields').item.json.handle }}"
            },
            {
              "key": "swipe_label",
              "value": "={{ $('Map post fields').item.json.cta }}"
            }
          ]
