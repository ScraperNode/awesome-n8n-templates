    {
      "id": "db471a6d-8423-4f25-b3f0-b67517ffe81f",
      "name": "Build report data",
      "type": "n8n-nodes-base.code",
      "position": [
        1120,
        320
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Edit these once.\nconst AGENCY_NAME = 'Your Agency';\nconst FOOTER = 'Prepared by Your Agency \u00b7 user@example.com';\n\nconst client = $('Active clients only').item.json;\nconst thisWeek = $('This week by campaign').item.json;\nconst lastWeek = $json;\nconst currency = String(client['Currency'] || 'USD').trim().toUpperCase();\nconst resultType = String(client['Result type'] || 'purchase').trim().toLowerCase();\n\nconst from = $now.minus({ days: 7 });\nconst to = $now.minus({ days: 1 });\nconst period = `${from.toFormat('MMM d')} \u2013 ${to.toFormat('MMM d, yyyy')}`;\nconst row = { client: client['Client name'], email: client['Email'], period, spend: '', results: '', cost_per_result: '', roas: '', pdf: '' };\n\n// A failed Meta call comes back as { message } instead of { data: [...] }.\nconst apiError = r => (Array.isArray(r.data) ? '' : String(r.message || r.error?.message || 'no data returned'));\nconst failed = apiError(thisWeek) || apiError(lastWeek);\nif (failed) return { json: { ...row, ok: false, status: 'Failed', error: `Meta API: ${failed}` } };\n\n// Meta reports each conversion under several action types; count the first one present.\nconst TYPES = {\n  purchase: ['omni_purchase', 'purchase', 'offsite_conversion.fb_pixel_purchase'],\n  lead: ['lead', 'onsite_conversion.lead_grouped', 'offsite_conversion.fb_pixel_lead'],\n  complete_registration: ['omni_complete_registration', 'complete_registration', 'offsite_conversion.fb_pixel_complete_registration'],\n};\nconst types = TYPES[resultType] || [resultType];\nconst pick = list => {\n  for (const t of types) {\n    const hit = (list || []).find(a => a.action_type === t);\n    if (hit) return Number(hit.value) || 0;\n  }\n  return 0;\n};\nconst total = rows => rows.reduce((t, r) => ({\n  spend: t.spend + Number(r.spend || 0),\n  impressions: t.impressions + Number(r.impressions || 0),\n  clicks: t.clicks + Number(r.inline_link_clicks || 0),\n  results: t.results + pick(r.actions),\n  value: t.value + pick(r.action_values),\n}), { spend: 0, impressions: 0, clicks: 0, results: 0, value: 0 });\n\nconst now = total(thisWeek.data);\nconst before = total(lastWeek.data);\nif (!now.spend) return { json: { ...row, ok: false, status: 'Skipped', error: 'No ad spend this week' } };\n\nconst ctr = t => (t.impressions ? (t.clicks / t.impressions) * 100 : 0);\nconst cpr = t => (t.results ? t.spend / t.results : 0);\n// Spend is shown in whole units, costs per result with cents.\nconst money = (n, cents = false) => new Intl.NumberFormat('en-US', { style: 'currency', currency, minimumFractionDigits: cents ? 2 : 0, maximumFractionDigits: cents ? 2 : 0 }).format(n);\nconst int = n => Math.round(n).toLocaleString('en-US');\n\nconst GOOD = '#0CA678', BAD = '#E03131', FLAT = '#64748B';\nconst change = (a, b, better = 'up') => {\n  if (!b) return { text: 'New this week', color: FLAT };\n  const pct = ((a - b) / b) * 100;\n  if (Math.abs(pct) < 0.5) return { text: 'Same as last week', color: FLAT };\n  const up = pct > 0;\n  const color = better === 'none' ? FLAT : (better === 'up') === up ? GOOD : BAD;\n  return { text: `${up ? '\u25b2' : '\u25bc'} ${Math.abs(pct).toFixed(0)}% vs last week`, color };\n};\nconst ctrDiff = ctr(now) - ctr(before);\nconst ctrChange = !before.impressions\n  ? { text: 'New this week', color: FLAT }\n  : { text: `${ctrDiff >= 0 ? '\u25b2' : '\u25bc'} ${Math.abs(ctrDiff).toFixed(2)} pts`, color: ctrDiff >= 0 ? GOOD : BAD };\n\nconst LABELS = { purchase: ['Purchases', 'purchase'], lead: ['Leads', 'lead'], complete_registration: ['Sign-ups', 'sign-up'] };\nconst [resultsLabel, singular] = LABELS[resultType] || ['Results', 'result'];\n\nconst kpis = {\n  // Spend sits on the dark cover, so its neutral change color is lighter.\n  spend: [money(now.spend), { ...change(now.spend, before.spend, 'none'), color: '#A3ADC2' }],\n  impressions: [int(now.impressions), change(now.impressions, before.impressions)],\n  clicks: [int(now.clicks), change(now.clicks, before.clicks)],\n  ctr: [`${ctr(now).toFixed(2)}%`, ctrChange],\n  results: [int(now.results), change(now.results, before.results)],\n  cpr: [now.results ? money(cpr(now), true) : '\u2013', now.results && before.results ? change(cpr(now), cpr(before), 'down') : { text: ' ', color: FLAT }],\n};\n\nconst mods = {\n  'page1@agency_name': AGENCY_NAME,\n  'page1@client_name': row.client,\n  'page1@report_period': period,\n  'page1@results_label': resultsLabel,\n  'page1@cpr_label': `Cost per ${singular}`,\n  'page1@footer_note': FOOTER,\n  'page2@client_name': row.client,\n  'page2@report_period': period,\n  'page2@footer_note': FOOTER,\n};\nfor (const [key, [value, delta]] of Object.entries(kpis)) {\n  mods[`page1@kpi_${key}`] = value;\n  mods[`page1@kpi_${key}_change`] = delta.text;\n  mods[`page1@kpi_${key}_change.color`] = delta.color;\n}\n\n// Top 5 campaigns by spend. Empty rows get a space so the sample rows in the template are cleared.\nconst top = [...thisWeek.data].sort((a, b) => Number(b.spend) - Number(a.spend)).slice(0, 5);\nfor (let i = 1; i <= 5; i++) {\n  const c = top[i - 1];\n  const spend = Number(c?.spend || 0), results = pick(c?.actions), value = pick(c?.action_values);\n  mods[`page2@c${i}_rank`] = c ? `0${i}` : ' ';\n  mods[`page2@c${i}_name`] = c ? c.campaign_name : ' ';\n  mods[`page2@c${i}_spend`] = c ? money(spend) : ' ';\n  mods[`page2@c${i}_results`] = c ? int(results) : ' ';\n  mods[`page2@c${i}_cpr`] = c ? (results ? money(spend / results, true) : '\u2013') : ' ';\n  mods[`page2@c${i}_roas`] = c ? (value ? `${(value / spend).toFixed(1)}x` : '\u2013') : ' ';\n}\n// Rows 2 and 4 are striped; drop the stripe when the row is empty.\nmods['page2@row_bg_2'] = top[1] ? '#F4F6FB' : '#FFFFFF';\nmods['page2@row_bg_4'] = top[3] ? '#F4F6FB' : '#FFFFFF';\n\nconst forAi = {\n  result_type: resultsLabel,\n  this_week: { spend: now.spend, impressions: now.impressions, link_clicks: now.clicks, ctr_pct: +ctr(now).toFixed(2), results: now.results, cost_per_result: +cpr(now).toFixed(2), roas: now.value ? +(now.value / now.spend).toFixed(2) : null },\n  last_week: { spend: before.spend, impressions: before.impressions, link_clicks: before.clicks, ctr_pct: +ctr(before).toFixed(2), results: before.results, cost_per_result: +cpr(before).toFixed(2) },\n  campaigns: top.map(c => ({ name: c.campaign_name, spend: Number(c.spend), results: pick(c.actions), roas: pick(c.action_values) ? +(pick(c.action_values) / Number(c.spend)).toFixed(2) : null })),\n};\n\nreturn {\n  json: {\n    ...row,\n    spend: kpis.spend[0],\n    results: kpis.results[0],\n    cost_per_result: kpis.cpr[0],\n    roas: now.value ? `${(now.value / now.spend).toFixed(1)}x` : '',\n    ok: true,\n    status: 'Ready',\n    error: '',\n    file_name: `${row.client} ads report ${to.toFormat('yyyy-MM-dd')}`.replace(/[^a-z0-9]+/gi, '-').toLowerCase(),\n    currency,\n    mods,\n    for_ai: forAi,\n  },\n};"
      },
      "typeVersion": 2
    },
