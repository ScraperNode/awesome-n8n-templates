    {
      "id": "b91a8db9-2aa5-4bd9-baae-3966f6a92cc6",
      "name": "Combine Full Batch Data",
      "type": "n8n-nodes-base.code",
      "position": [
        1664,
        4608
      ],
      "parameters": {
        "jsCode": "function decodeEntities(str) {\n  if (!str) return '';\n  return String(str)\n    .replace(/&amp;/g, '&').replace(/&lt;/g, '<').replace(/&gt;/g, '>')\n    .replace(/&quot;/g, '\"').replace(/&#8217;/g, \"'\").replace(/&#8211;/g, '-')\n    .replace(/&nbsp;/g, ' ');\n}\nfunction flattenItems(nodeName) {\n  const items = $(nodeName).all().map(it => it.json);\n  let flat = [];\n  for (const it of items) {\n    if (Array.isArray(it)) { flat = flat.concat(it); }\n    else if (it && typeof it === 'object' && it.id != null) { flat.push(it); }\n  }\n  return flat;\n}\nconst pagesArr = flattenItems('Fetch Full Batch Pages');\nconst postsArr = flattenItems('Fetch Full Batch Posts');\nconst out = [];\nfor (const p of pagesArr) { out.push({ json: { kind: 'page', id: p.id, title: decodeEntities(p.title && p.title.rendered), content: p.content && p.content.rendered, link: p.link, modified: p.modified } }); }\nfor (const p of postsArr) { out.push({ json: { kind: 'post', id: p.id, title: decodeEntities(p.title && p.title.rendered), content: p.content && p.content.rendered, link: p.link, modified: p.modified } }); }\nreturn out;"
      },
      "typeVersion": 2
    },
    {
      "id": "7990877c-035b-45db-9328-e4e66867728f",
      "name": "Scheduled Static Content Sync",
      "type": "n8n-nodes-base.scheduleTrigger",
      "position": [
        -576,
        4576
      ],
      "parameters": {
        "rule": {
          "interval": [
