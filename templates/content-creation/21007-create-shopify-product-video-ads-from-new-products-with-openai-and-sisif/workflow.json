      "parameters": {
        "text": "=You write prompts for an image-to-video model that animates a single product photo into a 5-second portrait ad clip.\n\nProduct: {{ $json.title }}\nType: {{ $json.product_type }}\nDescription: {{ $json.description }}\n\nWrite ONE prompt under 60 words describing subtle camera motion (slow push-in, orbit, parallax), lighting and ambient movement that makes the product look premium. Keep the product unchanged and centered. No text overlays, no people unless already in the photo. Return only the prompt.",
        "promptType": "define"
      },
      "typeVersion": 1.5
    },
