      "name": "Get upcoming appointments",
      "type": "n8n-nodes-base.googleCalendar",
      "position": [
        440,
        0
      ],
      "parameters": {
        "options": {
          "recurringEventHandling": "expand"
        },
        "timeMax": "={{ $now.plus({ hours: $json.hours_ahead }) }}",
        "timeMin": "={{ $now }}",
        "calendar": {
