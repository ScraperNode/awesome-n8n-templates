    {
      "id": "8bed1c9f-190e-4b70-860a-ed527e7c22e7",
      "name": "Aggregate Daily Stats",
      "type": "n8n-nodes-base.code",
      "position": [
        544,
        1504
      ],
      "parameters": {
        "jsCode": "const rows = items.map(i => i.json);\nconst now = new Date();\n\nconst counts = {\n  submitted: 0, docs_verified: 0,\n  under_review: 0, approved: 0, declined: 0\n};\n\nlet sla_breaches = [];\n\nrows.forEach(row => {\n  if (counts[row.current_status] !== undefined) counts[row.current_status]++;\n  if (row.current_status === 'under_review') {\n    const updated = new Date(row.last_updated);\n    if ((now - updated) > 3 * 24 * 60 * 60 * 1000) {\n      sla_breaches.push(row.application_id);\n    }\n  }\n});\n\nreturn [{ json: {\n  total: rows.length,\n  counts,\n  sla_breaches,\n  sla_count: sla_breaches.length,\n  report_date: now.toISOString().split('T')[0]\n}}];"
      },
      "typeVersion": 2
    },
