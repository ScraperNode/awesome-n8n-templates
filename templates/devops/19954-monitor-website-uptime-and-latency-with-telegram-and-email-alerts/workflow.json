    {
      "id": "7d69b766-5b3d-4654-a851-ee85c3b6151e",
      "name": "Configure Website List",
      "type": "n8n-nodes-base.set",
      "notes": "START HERE: Parameters > websites > Value. Enter domains/URLs separated by newlines or commas, for example example.com, https://example.org/health. No browser form or Basic Auth is needed.",
      "position": [
        280,
        80
      ],
      "parameters": {
        "mode": "manual",
        "options": {},
        "assignments": {
          "assignments": [
            {
              "id": "27604775-714a-4d1e-a962-008b8e62e486",
              "name": "websites",
              "type": "string",
              "value": ""
            }
          ]
        }
      },
      "notesInFlow": false,
      "typeVersion": 3.4
    },
    {
      "id": "e6f50566-540e-4dbe-a7a2-2dbf5f050bda",
      "name": "Validate Website List",
      "type": "n8n-nodes-base.code",
      "position": [
        560,
        80
      ],
      "parameters": {
        "jsCode": "const raw = typeof $json.websites === 'string' ? $json.websites.trim() : '';\nconst fail = message => { throw new Error('Configure Website List: ' + message); };\nif (!raw) return fail('Enter at least one URL or domain. Edit the websites field in the node Parameters.');\nif (raw.length > 50000) return fail('The list is too large. Use at most 50,000 characters. Edit the websites field in the node Parameters.');\nconst lines = raw.split(/[\\r\\n,]+/).map(s => s.trim()).filter(Boolean);\nif (!lines.length) return fail('Enter at least one URL or domain, not only separators.');\nif (lines.length > 100) return fail('Use at most 100 entries. Shorten the websites field in the node Parameters.');\nconst monitors = [];\nconst seen = new Set();\nfor (let i = 0; i < lines.length; i++) {\n  const input = lines[i];\n  const value = /^[a-z][a-z0-9+.-]*:\\/\\//i.test(input) ? input : `https://${input}`;\n  const match = /^(https?):\\/\\/([^/?#]+)([^#]*)(?:#.*)?$/i.exec(value);\n  const invalid = () => fail(`Entry ${i + 1} is invalid. Use an HTTP(S) URL or domain, without spaces or embedded credentials. Edit the websites field in the node Parameters.`);\n  if (value.length > 2048 || /%(?![0-9a-f]{2})/i.test(value) || !match || /[\\s\\\\<>\"\\x00-\\x1f\\x7f]/.test(value)) return invalid();\n  const authority = /^([a-z0-9.-]+)(?::([0-9]{1,5}))?$/i.exec(match[2]);\n  if (!authority) return invalid();\n  const host = authority[1].toLowerCase().replace(/\\.$/, '');\n  const labels = host.split('.');\n  if (host.length > 253 || labels.length < 2 || labels.some(s => !/^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$/.test(s))) return invalid();\n  if (/^[\\d.]+$/.test(host) && (labels.length !== 4 || labels.some(s => Number(s) > 255))) return invalid();\n  const protocol = match[1].toLowerCase();\n  const port = authority[2] ? Number(authority[2]) : null;\n  if (port !== null && (port < 1 || port > 65535)) return invalid();\n  const portText = port && port !== (protocol === 'https' ? 443 : 80) ? `:${port}` : '';\n  const suffix = match[3] || '/';\n  const url = `${protocol}://${host}${portText}${suffix.startsWith('?') ? '/' : ''}${suffix}`;\n  if (seen.has(url)) continue;\n  seen.add(url);\n  monitors.push({monitor_key: url, name: host, url, slow_threshold_ms: 2000, timeout_ms: 30000});\n}\nreturn [{json: {valid: true, config_key: 'default', monitors_json: JSON.stringify(monitors), count: monitors.length}}];"
      },
      "notesInFlow": false,
      "typeVersion": 2
    },
    {
      "id": "ee026105-530e-46b0-b02e-8621933fb60b",
      "name": "Authorize Telegram Destination",
      "type": "n8n-nodes-base.code",
      "position": [
        3080,
        640
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const settings = $('Monitor Settings').first().json;\nconst chatId = String($json.telegram_chat_id ?? '').trim();\nconst allowed = settings.telegram_allowed_chat_ids;\nif (!/^-?[1-9]\\d*$/.test(chatId) || !Array.isArray(allowed) ||\n    !allowed.some(id => typeof id === 'string' && id.trim() === chatId)) {\n  throw new Error('Telegram destination blocked. Set a numeric telegram_chat_id and add it as a string to telegram_allowed_chat_ids in Monitor Settings.');\n}\nreturn {json: {...$json, telegram_chat_id: chatId}};"
      },
      "notesInFlow": false,
      "typeVersion": 2
    },
