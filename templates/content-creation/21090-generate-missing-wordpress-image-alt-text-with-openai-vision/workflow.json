              "name": "altTextLanguage",
              "type": "string",
              "value": "English"
            },
            {
              "id": "2b5cab36-0af9-5db3-97fc-ae43d51b3e5c",
              "name": "maxAltLength",
              "type": "number",
              "value": 125
            },
