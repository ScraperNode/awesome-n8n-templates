        "jsonBody": "={{ JSON.stringify({ platforms: $('Describe the video').item.json.networks, text: $('Describe the video').item.json.idea, video_url: $('Get the video link').item.json.media_url, per_platform: Object.fromEntries(Object.entries($json.drafts || {}).filter(([k, d]) => d && d.text)), idempotency_key: 'onedrive-' + $('Only video files').item.json.id }) }}",
        "sendBody": true,
        "specifyBody": "json",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth"
      },
      "typeVersion": 4.2
