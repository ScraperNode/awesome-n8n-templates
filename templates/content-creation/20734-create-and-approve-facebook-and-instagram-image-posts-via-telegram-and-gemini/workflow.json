      "parameters": {
        "url": "https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash-lite:generateContent",
        "method": "POST",
        "options": {},
        "jsonBody": "={{ JSON.stringify({ contents: [{ parts: [{ text: `You write social media content for a business. Business: ${$json.brand_name}. Context: ${$json.brand_context}. Request: ${$json.raw_prompt}. ${$json.revision_note ? 'Revision requested: ' + $json.revision_note : ''} Return ONLY valid JSON with two keys: image_prompt (a detailed, vivid prompt for an AI image generator, 1:1 aspect ratio, photorealistic) and caption (a short social media caption matching the business tone).` }] }] }) }}",
        "sendBody": true,
        "sendHeaders": true,
        "specifyBody": "json",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
