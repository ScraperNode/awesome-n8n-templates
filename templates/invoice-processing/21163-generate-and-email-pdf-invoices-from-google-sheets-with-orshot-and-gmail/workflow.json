    {
      "id": "f062991f-a7c7-42c4-b611-ee2eb0fc7e75",
      "name": "Get PDF link",
      "type": "n8n-nodes-base.code",
      "position": [
        1420,
        320
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// The Orshot node returns the API response under data, and the API wraps the render in data again.\n// A failed render comes back as { error } because the step continues on error.\nconst res = $json.data?.data ?? $json.data;\nconst page = Array.isArray(res) ? res[0] : res;\nconst pdf = page?.content || '';\nconst { mods, ...row } = $('Build invoice data').item.json;\nreturn { json: { ...row, pdf, status: pdf ? 'Rendered' : 'Error', error: pdf ? '' : `Render: ${$json.error || 'Orshot returned no PDF link'}` } };"
      },
      "typeVersion": 2
    },
