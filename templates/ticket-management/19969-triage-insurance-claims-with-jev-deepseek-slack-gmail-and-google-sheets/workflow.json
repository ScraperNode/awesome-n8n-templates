    {
      "id": "e5785858-6f4d-4a2d-8b32-63ab238be11e",
      "name": "Calculate Claim History Count",
      "type": "n8n-nodes-base.code",
      "position": [
        1392,
        800
      ],
      "parameters": {
        "jsCode": "const historyRows = $input.all();\nconst original = $('Prepare Claim Data').first().json;\nconst priorCount = historyRows.length;\nconst historyNote = priorCount > 0 ? ` This claimant has ${priorCount} prior claim(s) on file.` : '';\nreturn [{\n  json: {\n    ...original,\n    prior_claim_count: priorCount,\n    claim_text: original.claim_text + historyNote\n  }\n}];"
      },
      "typeVersion": 2
    },
