      "name": "Apparel Prompt Config",
      "type": "n8n-nodes-base.set",
      "position": [
        -40,
        0
      ],
      "parameters": {
        "options": {},
        "assignments": {
          "assignments": [
            {
              "id": "14529f76-3191-4e02-ac99-fe286bc9e044",
              "name": "apparel_prompt",
              "type": "string",
              "value": "A professional fashion model wearing exactly this garment, same color, fabric, pattern and details, standing in a bright minimal studio. The model turns slightly and takes a relaxed step toward the camera while the fabric moves naturally. Slow camera push-in, soft even lighting, e-commerce lookbook style."
            },
            {
              "id": "3f77dbc7-8db7-4196-892e-5598199e5e90",
              "name": "image_base64",
              "type": "string",
              "value": "={{ $json.image_base64 }}"
            }
          ]
        }
      },
      "typeVersion": 3.4
    },
