    {
      "id": "0195ba63-720c-45fc-8fd7-dc64fe13a34a",
      "name": "AI Draft Follow-Up",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "position": [
        6096,
        960
      ],
      "parameters": {
        "text": "=Create a follow-up for:\n\nCustomer name: {{ $('Format Appointment Details').item.json.clientName }}\nAppointment: {{ $('Format Appointment Details').item.json.service }}\nAppointment time: {{ $('Format Appointment Details').item.json.appointmentTime }}\nCustomer email: {{ $('Format Appointment Details').item.json.email }}",
        "options": {
          "systemMessage": "You are a professional business follow-up assistant.\n\nWrite a short, polite follow-up email for a customer who has not responded to an appointment reminder.\n\nDo not sound pushy.\nDo not mention that the customer was \"ignored\" or \"didn't reply\".\nKeep it professional and friendly.\nInclude the appointment name and scheduled time when available.\nEnd with a simple option to confirm or reschedule.\n\nReturn only the email body."
        },
        "promptType": "define"
      },
      "typeVersion": 3.1
    },
    {
      "id": "d273a6f0-1589-4594-9aa0-37dccf5e4b08",
