    {
      "id": "841851ce-0ba6-47ef-86ce-90173079b131",
      "name": "Write icebreaker",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "position": [
        1760,
        0
      ],
      "parameters": {
        "text": "=Write a cold email icebreaker for this lead.\n\nWhat we sell:\n{{ $('Set your offer and channel').first().json.yourOffer }}\n\nLead:\n- Name: {{ $('Lead record').item.json.lead['Full Name'] }}\n- Job title: {{ $('Lead record').item.json.lead['Current Job'] }}\n- Headline: {{ $('Lead record').item.json.lead['Profile Headline'] }}\n- Location: {{ $('Lead record').item.json.lead['Location'] }}\n- Company: {{ $('Lead record').item.json.lead['Company Name'] }}\n- Industry: {{ $('Lead record').item.json.lead['Company Industry'] }}\n- Employees: {{ $('Lead record').item.json.lead['Company Employee Range'] }}\n- Company description: {{ $('Lead record').item.json.lead['Company Description'] }}\n\nWrite one friendly sentence of at most 25 words that references the lead's role or company and connects it to what we sell. Use only facts from the lead data. No greeting, no sign-off, no emojis.",
        "promptType": "define",
        "hasOutputParser": true
      },
      "typeVersion": 1.5
    },
    {
      "id": "2e544cc5-c671-42e4-a1ce-1e6824ee290f",
      "name": "OpenAI model",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "position": [
        1700,
        220
      ],
      "parameters": {
        "model": {
          "__rl": true,
          "mode": "list",
          "value": "gpt-4.1-mini"
        },
        "options": {
          "temperature": 0.4
        }
      },
      "credentials": {
        "openAiApi": {
          "id": "",
          "name": "OpenAI account"
        }
      },
      "typeVersion": 1.2
    },
    {
      "id": "4a756f48-bdae-47ee-b65b-7938d640e13e",
      "name": "Icebreaker format",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "position": [
        1880,
        220
      ],
      "parameters": {
        "jsonSchemaExample": "{\n  \"icebreaker\": \"Saw Acme just opened a Paris office, which usually means a new outbound team to ramp up fast.\"\n}"
      },
      "typeVersion": 1.2
    },
    {
      "id": "0eb0b017-cb70-49d0-bced-aa21aca53864",
      "name": "Add lead to lemlist campaign",
      "type": "n8n-nodes-base.lemlist",
      "position": [
        2100,
        0
      ],
      "parameters": {
        "email": "={{ $('Lead record').item.json.lead['Email'] }}",
        "resource": "lead",
        "operation": "create",
        "campaignId": "",
        "additionalFields": {
          "jobTitle": "={{ $('Lead record').item.json.lead['Current Job'] }}",
          "lastName": "={{ $('Lead record').item.json.lead['Last Name'] }}",
          "firstName": "={{ $('Lead record').item.json.lead['First Name'] }}",
          "icebreaker": "={{ $json.output.icebreaker }}",
          "companyName": "={{ $('Lead record').item.json.lead['Company Name'] }}",
          "deduplicate": true,
          "linkedinUrl": "={{ $('Lead record').item.json.lead['Linkedin URL Public'] }}",
          "companyDomain": "={{ $('Lead record').item.json.lead['Company Domain'] }}"
        }
      },
      "credentials": {
        "lemlistApi": {
          "id": "",
          "name": "lemlist account"
        }
      },
      "typeVersion": 2
    },
    {
      "id": "1b602f49-0186-45d3-969d-fd63fc556464",
      "name": "Confirm in Slack",
      "type": "n8n-nodes-base.slack",
      "position": [
        2380,
        0
      ],
      "parameters": {
        "text": "=:white_check_mark: {{ $('Lead record').item.json.lead['First Name'] }} {{ $('Lead record').item.json.lead['Last Name'] }} ({{ $('Lead record').item.json.lead['Current Job'] }} at {{ $('Lead record').item.json.lead['Company Name'] }}) joined lemlist.\nIcebreaker: {{ $('Write icebreaker').item.json.output.icebreaker }}",
        "select": "channel",
        "channelId": {
          "__rl": true,
          "mode": "name",
          "value": "={{ $('Set your offer and channel').first().json.slackChannel }}"
        },
        "otherOptions": {}
      },
      "credentials": {
        "slackApi": {
          "id": "",
          "name": "Slack account"
        }
      },
      "typeVersion": 2.3
    },
