    {
      "id": "ca5992b1-2713-4c36-a64a-1710fa583ec0",
      "name": "Generate HTML Report",
      "type": "n8n-nodes-base.html",
      "position": [
        3200,
        1792
      ],
      "parameters": {
        "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n\n<title>Competitive Analysis Report - {{ $json.competitorName }}</title>\n\n<style>\n\nbody{\nfont-family:-apple-system,BlinkMacSystemFont,\"Segoe UI\",Roboto,Arial,sans-serif;\nbackground:#f5f7fa;\nmargin:0;\npadding:40px;\ncolor:#333;\nline-height:1.7;\n}\n\n.container{\nmax-width:1100px;\nmargin:auto;\nbackground:#fff;\npadding:40px;\nborder-radius:12px;\nbox-shadow:0 8px 25px rgba(0,0,0,.08);\n}\n\nh1{\nfont-size:34px;\ncolor:#0f172a;\nmargin-bottom:15px;\n}\n\nh2{\nmargin-top:35px;\npadding-bottom:8px;\nborder-bottom:2px solid #2563eb;\ncolor:#2563eb;\n}\n\n.meta{\nbackground:#eef6ff;\npadding:20px;\nborder-left:5px solid #2563eb;\nborder-radius:8px;\nmargin-bottom:35px;\n}\n\n.meta p{\nmargin:8px 0;\n}\n\n.section{\nmargin-top:25px;\n}\n\n.footer{\nmargin-top:50px;\npadding-top:20px;\nborder-top:1px solid #ddd;\ntext-align:center;\nfont-size:13px;\ncolor:#777;\n}\n\n</style>\n\n</head>\n\n<body>\n\n<div class=\"container\">\n\n<h1>\ud83d\udd0d Competitive Analysis Report</h1>\n\n<div class=\"meta\">\n\n<p><strong>Competitor:</strong> {{ $json.competitorName }}</p>\n\n<p><strong>Website:</strong> {{ $json.url }}</p>\n\n<p><strong>Date:</strong> {{ $now.toFormat(\"dd LLLL yyyy\") }}</p>\n\n<p><strong>Generated:</strong> {{ $now.toFormat(\"hh:mm a\") }}</p>\n\n</div>\n\n<div class=\"section\">\n<h2>Executive Summary</h2>\n<p>{{ $json.executiveSummary }}</p>\n</div>\n\n<div class=\"section\">\n<h2>Company Positioning</h2>\n<p>{{ $json.positioning }}</p>\n</div>\n\n<div class=\"section\">\n<h2>Main Messaging</h2>\n<p>{{ $json.mainMessaging }}</p>\n</div>\n\n<div class=\"section\">\n<h2>Primary Value Proposition</h2>\n<p>{{ $json.valueProposition }}</p>\n</div>\n\n<div class=\"section\">\n<h2>Products & Services</h2>\n<p>{{ $json.productsServices }}</p>\n</div>\n\n<div class=\"section\">\n<h2>Target Audience</h2>\n<p>{{ $json.targetAudience }}</p>\n</div>\n\n<div class=\"section\">\n<h2>Calls To Action</h2>\n<p>{{ $json.callsToAction }}</p>\n</div>\n\n<div class=\"section\">\n<h2>Trust Signals</h2>\n<p>{{ $json.trustSignals }}</p>\n</div>\n\n<div class=\"section\">\n<h2>Marketing Tone</h2>\n<p>{{ $json.marketingTone }}</p>\n</div>\n\n<div class=\"section\">\n<h2>SEO Observations</h2>\n<p>{{ $json.seoObservations }}</p>\n</div>\n\n<div class=\"section\">\n<h2>Conversion Opportunities</h2>\n<p>{{ $json.conversionOpportunities }}</p>\n</div>\n\n<div class=\"section\">\n<h2>New Features Identified</h2>\n<p>{{ $json.newFeatures }}</p>\n</div>\n\n<div class=\"section\">\n<h2>Potential Weaknesses</h2>\n<p>{{ $json.potentialWeaknesses }}</p>\n</div>\n\n<div class=\"section\">\n<h2>Business Insights</h2>\n<p>{{ $json.businessInsights }}</p>\n</div>\n\n<div class=\"section\">\n<h2>Recommended Actions</h2>\n<p>{{ $json.recommendedActions }}</p>\n</div>\n\n<div class=\"footer\">\n\nGenerated by <strong>AI Competitor Change Tracker</strong><br>\nPowered by n8n + OpenAI + Firecrawl\n\n</div>\n\n</div>\n\n</body>\n</html>"
      },
      "typeVersion": 1.2
    },
