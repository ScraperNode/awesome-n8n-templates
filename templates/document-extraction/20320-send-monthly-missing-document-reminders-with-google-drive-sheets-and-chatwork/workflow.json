      "parameters": {
        "color": 7,
        "width": 624,
        "height": 320,
        "content": "## Locate required folders\n\nFor each client, finds the appropriate monthly Google Drive folder, lists its subfolders, and filters them down to the required document folders."
      },
      "typeVersion": 1
