    {
      "id": "0c65bc27-7f3c-4603-bbe2-fb372ed9515f",
      "name": "Section: AI Classification",
      "type": "n8n-nodes-base.stickyNote",
      "position": [
        -80,
        200
      ],
      "parameters": {
        "color": 3,
        "width": 720,
        "height": 300,
        "content": "### 3 | AI classification\nOpenAI compares the email against your scope and returns strict JSON: classification, confidence, quoted clause, hours, reasoning."
      },
      "typeVersion": 1
    },
    {
      "id": "6d981f4f-343e-43eb-ae16-ce9934c6fe43",
      "name": "Classify Request vs SOW",
      "type": "n8n-nodes-base.openAi",
      "position": [
        0,
        400
      ],
      "parameters": {
        "prompt": {
          "messages": [
            {
              "role": "system",
              "content": "You are a contracts analyst for freelancers. Compare a client email against the agreed scope of work. Respond with STRICT JSON only, no markdown fences, no commentary. Schema: {\"classification\": \"in_scope | out_of_scope | ambiguous\", \"confidence\": 0-100, \"sowClause\": \"the exact scope clause that applies, or empty string\", \"estimatedHours\": number, \"reasoning\": \"one sentence\"}. out_of_scope = the request asks for work clearly outside the scope. in_scope = clearly covered by the scope. ambiguous = you cannot decide from the scope text alone. Be strict: extra revisions beyond the agreed rounds, new deliverables, and new workstreams are out_of_scope."
            },
            {
              "role": "user",
              "content": "={{ 'SCOPE OF WORK:\\n' + $('Workflow Configuration').first().json.scopeOfWork + '\\n\\nCLIENT EMAIL SUBJECT: ' + $('Client Email Trigger').first().json.subject + '\\n\\nCLIENT EMAIL BODY:\\n' + $('Client Email Trigger').first().json.text }}"
            }
          ]
        },
        "options": {},
        "resource": "chat",
        "chatModel": "gpt-4o-mini",
        "operation": "complete",
        "simplifyOutput": false
      },
      "credentials": {},
      "typeVersion": 1.1
    },
    {
      "id": "ca430ebd-a6e8-436f-ba2a-663cbd7f9b6f",
      "name": "Parse AI Classification",
      "type": "n8n-nodes-base.code",
      "position": [
        300,
        400
      ],
      "parameters": {
        "jsCode": "// Parse the strict-JSON classification and attach cost math + email context.\nvar cfg = $('Workflow Configuration').first().json;\nvar inJson = $input.first().json;\nvar content = '';\nif (inJson.message && inJson.message.content) { content = inJson.message.content; }\nelse if (typeof inJson.text === 'string') { content = inJson.text; }\nelse { content = JSON.stringify(inJson); }\nvar fence = String.fromCharCode(96) + String.fromCharCode(96) + String.fromCharCode(96);\ncontent = content.split(fence).join('').trim();\nvar parsed;\ntry { parsed = JSON.parse(content); }\ncatch (e) {\n  parsed = { classification: 'ambiguous', confidence: 0, sowClause: '', estimatedHours: 0,\n             reasoning: 'Could not parse AI output, flagged for human review.' };\n}\nvar email = $('Client Email Trigger').first().json;\nvar hours = Number(parsed.estimatedHours) || 0;\nvar rate = Number(cfg.hourlyRate) || 0;\nreturn [{ json: {\n  classification: parsed.classification || 'ambiguous',\n  confidence: parsed.confidence || 0,\n  sowClause: parsed.sowClause || '',\n  estimatedHours: hours,\n  estimatedCost: Math.round(hours * rate * 100) / 100,\n  currency: cfg.currency || 'USD',\n  reasoning: parsed.reasoning || '',\n  clientEmail: email.from || '',\n  subject: email.subject || '',\n  bodySnippet: String(email.text || '').substring(0, 500),\n  timestamp: new Date().toISOString()\n}}];\n"
      },
      "typeVersion": 2
    },
    {
      "id": "d092fc2a-b0e9-44eb-a7ac-ea5eed91ad63",
      "name": "Section: Routing",
      "type": "n8n-nodes-base.stickyNote",
      "position": [
        620,
        200
      ],
      "parameters": {
        "color": 3,
        "width": 440,
        "height": 300,
        "content": "### 4 | Routing\nOut-of-scope requests go to drafting. Ambiguous ones go to human review. In-scope ones skip straight to the ledger."
      },
      "typeVersion": 1
    },
    {
      "id": "57168cd0-bb7c-489e-a58d-19b5b170566f",
      "name": "Is Out of Scope?",
      "type": "n8n-nodes-base.if",
      "position": [
        680,
        400
      ],
      "parameters": {
        "options": {},
        "conditions": {
          "options": {
            "leftValue": "",
            "caseSensitive": true,
            "typeValidation": "loose"
          },
          "combinator": "and",
          "conditions": [
            {
              "id": "c1",
              "operator": {
                "type": "string",
                "operation": "equals"
              },
              "leftValue": "={{ $json.classification }}",
              "rightValue": "out_of_scope"
            }
          ]
        }
      },
      "typeVersion": 2.2
    },
    {
      "id": "6ce3d679-c528-42a5-943c-8405492e2223",
