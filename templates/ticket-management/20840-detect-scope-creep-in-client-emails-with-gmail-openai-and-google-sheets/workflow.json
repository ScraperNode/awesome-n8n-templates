    {
      "id": "ad342caf-4b37-4b29-b63d-b703d897b5db",
      "name": "Prepare scope record",
      "type": "n8n-nodes-base.code",
      "position": [
        1400,
        80
      ],
      "parameters": {
        "jsCode": "const cfg = $('Configure settings').first().json;\nconst e = $('Match client SOW').first().json;\nconst ai = $input.first().json.output || {};\nconst hours = Number(ai.estimated_hours) || 0;\nconst value = Math.round(hours * Number(cfg.hourly_rate || 0));\nconst label = ai.verdict === 'out_of_scope' ? ':triangular_flag_on_post: *Out-of-scope request*' : ':grey_question: *Possibly out of scope*';\n\nreturn [{ json: {\n  checked_at: new Date().toISOString(),\n  client_domain: e.client_domain,\n  from_email: e.from_email,\n  subject: e.subject,\n  request_summary: ai.request_summary || '',\n  verdict: ai.verdict,\n  matching_clause: ai.matching_clause || '',\n  estimated_hours: hours,\n  estimated_value: value,\n  thread_link: `https://mail.google.com/mail/u/0/#all/${e.threadId}`,\n  slack_channel: cfg.slack_channel,\n  slack_text: `${label} from *${e.from_name}* (${e.client_domain})\\n` +\n    `*Request:* ${ai.request_summary}\\n` +\n    `*SOW says:* ${ai.matching_clause ? '_' + ai.matching_clause + '_' : 'nothing specific'}\\n` +\n    `*Why:* ${ai.reasoning}\\n` +\n    `*Estimate:* ${hours}h \u2248 ${value.toLocaleString('en-US')} ${cfg.currency}\\n` +\n    `:memo: A change-order reply is waiting in Gmail drafts.`,\n  draft_to: e.from_email,\n  draft_subject: /^re:/i.test(e.subject) ? e.subject : `Re: ${e.subject}`,\n  draft_body: `${ai.change_order_reply}\\n\\n${cfg.sign_off_name}`,\n  threadId: e.threadId,\n} }];"
      },
      "typeVersion": 2
    },
