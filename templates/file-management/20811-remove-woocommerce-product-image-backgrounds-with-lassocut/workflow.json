    {
      "id": "de5f8ced-3a41-5fe1-b500-b64530156a9c",
      "name": "Build run summary",
      "type": "n8n-nodes-base.code",
      "position": [
        1200,
        700
      ],
      "parameters": {
        "jsCode": "// One item per product comes back from the loop\nconst results = $input.all().map(item => item.json);\nconst processed = results.filter(r => r.status === 'processed');\nconst failed = results.filter(r => r.status === 'failed');\nconst creditsUsed = processed.reduce((sum, r) => sum + (Number(r.credits_charged) || 0), 0);\nconst outOfCredits = failed.some(r => /credit/i.test(r.error || ''));\n\nconst lines = [\n  `LassoCut run: ${processed.length} product image(s) replaced, ${failed.length} failed, ${creditsUsed} credit(s) used.`,\n  ...failed.map(r => `- ${r.product} (#${r.product_id}) failed at \"${r.step}\": ${r.error}`),\n];\nif (outOfCredits) {\n  lines.push('Out of credits: buy a pack at https://www.lassocut.com/pricing/ (credits never expire). Failed products are retried on the next run.');\n}\n\nreturn [{\n  json: {\n    processed: processed.length,\n    failed: failed.length,\n    credits_used: creditsUsed,\n    out_of_credits: outOfCredits,\n    failures: failed,\n    message: lines.join('\\n'),\n  },\n}];"
      },
      "typeVersion": 2
    }
  ],
