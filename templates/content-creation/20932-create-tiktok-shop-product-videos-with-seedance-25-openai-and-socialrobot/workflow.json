    {
      "id": "d70b5e64-79d8-4309-a55e-3184cb882a13",
      "name": "Prepare Product Photos",
      "type": "n8n-nodes-base.code",
      "position": [
        944,
        400
      ],
      "parameters": {
        "jsCode": "// One item per product photo. The form stores each upload in its own binary field.\nconst s = $('Set Video Settings').first().json;\nconst form = $('Product Video Form').first();\nconst photos = Object.values(form.binary || {}).filter(b => String(b.mimeType || '').startsWith('image/'));\nconst max = Number(s.max_photos) || 4;\nreturn photos.slice(0, max).map((photo, i) => ({\n  json: { photo_number: i + 1, file_name: photo.fileName },\n  binary: { photo },\n}));"
      },
      "typeVersion": 2
    },
    {
      "id": "04658fad-c3d6-4d04-9c3c-2e80097c63ae",
      "name": "Upload Photo to Replicate",
      "type": "n8n-nodes-base.httpRequest",
      "maxTries": 3,
      "position": [
        1136,
        400
      ],
      "parameters": {
        "url": "https://api.replicate.com/v1/files",
        "method": "POST",
        "options": {},
        "sendBody": true,
        "contentType": "multipart-form-data",
        "authentication": "genericCredentialType",
        "bodyParameters": {
          "parameters": [
            {
              "name": "content",
              "parameterType": "formBinaryData",
              "inputDataFieldName": "photo"
            }
          ]
        },
        "genericAuthType": "httpBearerAuth"
      },
      "retryOnFail": true,
      "typeVersion": 4.2,
      "waitBetweenTries": 3000
    },
    {
      "id": "4bb433ef-3966-4c27-a208-787b936430e3",
      "name": "Collect Photo URLs",
      "type": "n8n-nodes-base.code",
      "position": [
        1328,
        400
      ],
      "parameters": {
        "jsCode": "// Replicate returns one file URL per photo. Seedance reads them as [Image1], [Image2], ...\n// Runs with zero photos too: 'Has Product Photos?' skips the upload branch, so the upload node may not have run.\nlet uploads = [];\ntry {\n  if ($('Upload Photo to Replicate').isExecuted) uploads = $('Upload Photo to Replicate').all();\n} catch (e) {\n  uploads = [];\n}\nconst urls = uploads.map(item => item.json?.urls?.get).filter(Boolean);\nreturn [{ json: { photo_urls: urls, photo_count: urls.length } }];"
      },
      "typeVersion": 2
    },
    {
      "id": "b76e6f86-1a3f-4c6a-97f6-919daea50279",
      "name": "Write Script and Prompt",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "position": [
        1584,
        400
      ],
      "parameters": {
        "text": "=You plan short, honest TikTok Shop product videos that an AI video model (Seedance 2.5) renders in one take.\n\nProduct: {{ $('Product Video Form').first().json['Product Name'] }}\nSelling points (the only facts you may use):\n{{ $('Product Video Form').first().json['Selling Points'] }}\nOffer or call to action: {{ $('Product Video Form').first().json['Offer or Call to Action'] || 'none given, use a soft call to action' }}\nLanguage for speech and caption: {{ $('Product Video Form').first().json['Video Language'] }}\nVoice: {{ $('Set Video Settings').first().json.brand_voice }}\nReference photos: {{ $('Collect Photo URLs').first().json.photo_count > 0 ? ($('Collect Photo URLs').first().json.photo_count + ' product photo(s), called [Image1] to [Image' + $('Collect Photo URLs').first().json.photo_count + ']') : 'no reference photos; generate visuals from the brief only' }}.\nLength: {{ $('Set Video Settings').first().json.duration_seconds }} seconds, vertical {{ $('Set Video Settings').first().json.aspect_ratio }}.\n\nReturn:\n- seedance_prompt: a production brief in English with timed beats: 0-3 s scroll-stopping hook, 3-11 s demo of the selling points, 11-15 s call to action. Describe setting, camera moves, lighting and sound. Say the product must look exactly like the reference photos. Include one short spoken line in the video language inside double quotes.\n- hook: the first spoken line.\n- voiceover: every spoken line, in the video language.\n- caption: TikTok caption in the video language, under 300 characters, ending with 3-5 hashtags including {{ $('Set Video Settings').first().json.extra_hashtags }}.\n\nRules: no claims beyond the selling points, no prices unless given, no fake reviews or customer testimonials, no real or famous people, no medical or before-and-after claims, no on-screen text, and only show logos or icons that appear in the reference photos; never invent brand logos. If no photos are provided, avoid showing any specific brand logos or trademarks.",
        "promptType": "define",
        "hasOutputParser": true
      },
      "typeVersion": 1.7
    },
    {
      "id": "d9355abc-852f-4264-9c6c-bc684ba53203",
      "name": "OpenAI GPT-6 Luna",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "position": [
        1584,
        624
      ],
      "parameters": {
        "model": {
          "__rl": true,
          "mode": "id",
          "value": "gpt-6-luna"
        },
        "options": {}
      },
      "typeVersion": 1.2
    },
    {
      "id": "b8ad9ee4-7c2d-40cb-b5c4-022e3d6011a7",
      "name": "Script Format",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "position": [
        1744,
        624
      ],
      "parameters": {
        "jsonSchemaExample": "{\n  \"seedance_prompt\": \"9:16 vertical product video, one continuous take ...\",\n  \"hook\": \"First spoken line\",\n  \"voiceover\": \"All spoken lines\",\n  \"caption\": \"Caption with #hashtags\"\n}"
      },
      "typeVersion": 1.3
    },
    {
      "id": "d65d2b3f-2804-42a4-a1da-602112a12f18",
      "name": "Build Seedance Request",
      "type": "n8n-nodes-base.code",
      "position": [
        1904,
        400
      ],
      "parameters": {
        "jsCode": "// Replicate input for Seedance 2.5. Other models may use different field names: check the model's API tab.\nconst s = $('Set Video Settings').first().json;\nconst script = $json.output;\nconst urls = ($('Collect Photo URLs').first().json.photo_urls) || [];\nconst input = {\n  prompt: script.seedance_prompt,\n  duration: Number(s.duration_seconds),\n  resolution: s.resolution,\n  aspect_ratio: s.aspect_ratio,\n  generate_audio: s.generate_audio === true || s.generate_audio === 'true',\n  watermark: false,\n};\nif (Array.isArray(urls) && urls.length) {\n  input.reference_images = urls;\n}\nreturn [{ json: { model: s.model, body: { input } } }];"
      },
      "typeVersion": 2
    },
    {
      "id": "5ab48ab9-ea50-4a56-a355-b8e781371d5f",
      "name": "Submit Seedance Job",
      "type": "n8n-nodes-base.httpRequest",
      "position": [
        2160,
        400
      ],
      "parameters": {
        "url": "=https://api.replicate.com/v1/models/{{ $json.model }}/predictions",
        "method": "POST",
        "options": {},
        "jsonBody": "={{ JSON.stringify($json.body) }}",
        "sendBody": true,
        "specifyBody": "json",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpBearerAuth"
      },
      "typeVersion": 4.2
    },
    {
      "id": "2c72313b-2291-4c36-a10b-3cf84765e33a",
      "name": "Wait Between Checks",
      "type": "n8n-nodes-base.wait",
      "position": [
        2352,
        400
      ],
      "webhookId": "0a0b4993-077a-44e1-bd5a-6faf3f49fb2f",
      "parameters": {
        "unit": "seconds",
        "amount": "={{ $('Set Video Settings').first().json.poll_every_seconds }}"
      },
      "typeVersion": 1.1
    },
    {
      "id": "e9548aae-e602-4f3b-8c84-9ab3278a9044",
      "name": "Check Seedance Job",
      "type": "n8n-nodes-base.httpRequest",
      "maxTries": 3,
      "position": [
        2544,
        400
      ],
      "parameters": {
        "url": "=https://api.replicate.com/v1/predictions/{{ $json.id }}",
        "options": {},
        "authentication": "genericCredentialType",
        "genericAuthType": "httpBearerAuth"
      },
      "retryOnFail": true,
      "typeVersion": 4.2,
      "waitBetweenTries": 5000
    },
    {
      "id": "29c9ddf3-6bb0-44eb-bd4e-a1d3799b2164",
      "name": "Route by Job Status",
      "type": "n8n-nodes-base.switch",
      "position": [
        2736,
        400
      ],
      "parameters": {
        "rules": {
          "values": [
            {
              "outputKey": "Succeeded",
              "conditions": {
                "options": {
                  "version": 2,
                  "leftValue": "",
                  "caseSensitive": true,
                  "typeValidation": "strict"
                },
                "combinator": "and",
                "conditions": [
                  {
                    "id": "d2a4c451-427d-4503-a569-66991115d504",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    },
                    "leftValue": "={{ $json.status }}",
                    "rightValue": "succeeded"
                  }
                ]
              },
              "renameOutput": true
            },
            {
              "outputKey": "Failed",
              "conditions": {
                "options": {
                  "version": 2,
                  "leftValue": "",
                  "caseSensitive": true,
                  "typeValidation": "strict"
                },
                "combinator": "and",
                "conditions": [
                  {
                    "id": "686b74f6-47cd-4d6f-8a9f-d2037a1c0d0a",
                    "operator": {
                      "type": "boolean",
                      "operation": "true",
                      "singleValue": true
                    },
                    "leftValue": "={{ ['failed', 'canceled', 'aborted'].includes($json.status) }}",
                    "rightValue": ""
                  }
                ]
              },
              "renameOutput": true
            },
            {
              "outputKey": "Timed Out",
              "conditions": {
                "options": {
                  "version": 2,
                  "leftValue": "",
                  "caseSensitive": true,
                  "typeValidation": "strict"
                },
                "combinator": "and",
                "conditions": [
                  {
                    "id": "aeabc935-a00f-4748-a722-98c19c0c7778",
                    "operator": {
                      "type": "boolean",
                      "operation": "true",
                      "singleValue": true
                    },
                    "leftValue": "={{ (Date.now() - new Date($json.created_at).getTime()) / 60000 > Number($('Set Video Settings').first().json.timeout_minutes) }}",
                    "rightValue": ""
                  }
                ]
              },
              "renameOutput": true
            }
          ]
        },
        "options": {
          "fallbackOutput": "extra",
          "renameFallbackOutput": "Still Running"
        }
      },
      "typeVersion": 3.2
    },
    {
      "id": "546ff6d0-e0ec-430b-b8c7-e2ad7c7f0811",
      "name": "Download Video",
      "type": "n8n-nodes-base.httpRequest",
      "maxTries": 3,
      "position": [
        3008,
        400
      ],
      "parameters": {
        "url": "={{ Array.isArray($json.output) ? $json.output[0] : $json.output }}",
        "options": {
          "response": {
            "response": {
              "responseFormat": "file",
              "outputPropertyName": "data"
            }
          }
        }
      },
      "retryOnFail": true,
      "typeVersion": 4.2,
      "waitBetweenTries": 3000
    },
    {
      "id": "44921ad9-ae07-40c6-9865-0d1d1b5eb346",
      "name": "Check Size and Duration",
      "type": "n8n-nodes-base.code",
      "position": [
        3200,
        400
      ],
      "parameters": {
        "jsCode": "// Checks the file before it goes to SocialRobot. Duration comes from the MP4/MOV header (mvhd box).\nconst s = $('Set Video Settings').first().json;\nconst item = $input.first();\nconst video = item.binary && item.binary.data;\nconst problems = [];\nlet sizeMb = 0;\nlet seconds = null;\nif (!video) {\n  problems.push('No video file was downloaded.');\n} else {\n  const buf = await this.helpers.getBinaryDataBuffer(0, 'data');\n  sizeMb = buf.length / 1048576;\n  const i = buf.indexOf('mvhd');\n  if (i > 3) {\n    const v1 = buf[i + 4] === 1;\n    const scale = buf.readUInt32BE(i + (v1 ? 24 : 16));\n    const units = v1 ? Number(buf.readBigUInt64BE(i + 28)) : buf.readUInt32BE(i + 20);\n    if (scale) seconds = Math.round((units / scale) * 10) / 10;\n  }\n  const type = String(video.mimeType || '');\n  if (!/video\\/(mp4|quicktime|webm)/.test(type) && !/\\.(mp4|mov|webm)$/i.test(video.fileName || '')) problems.push(`Unexpected file type ${type || 'unknown'}.`);\n  if (sizeMb > Number(s.max_file_mb)) problems.push(`File is ${sizeMb.toFixed(1)} MB, above the ${s.max_file_mb} MB limit.`);\n  if (seconds === null) problems.push('Could not read the video duration.');\n  else if (seconds < Number(s.min_seconds) || seconds > Number(s.max_seconds)) problems.push(`Video is ${seconds} s; allowed is ${s.min_seconds}-${s.max_seconds} s.`);\n}\nreturn [{\n  json: { ok: problems.length === 0, problems, size_mb: Math.round(sizeMb * 100) / 100, duration_seconds: seconds },\n  binary: item.binary,\n}];"
      },
      "typeVersion": 2
    },
