    {
      "id": "091bb10a-48b6-4dd4-ab2e-d280418875d0",
      "name": "Extract Emails from HTML",
      "type": "n8n-nodes-base.code",
      "position": [
        4400,
        -368
      ],
      "parameters": {
        "jsCode": "const item = $input.first();\nconst textContent = item.json.data.html;\nconst result = { website: $('Batch Website Enrichment Process').first().json.website, emails: \"None\", linkedin: \"None\", facebook: \"None\", instagram: \"None\", twitter: \"None\" };\nconst emailRegex = /\\b[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\.[A-Z|a-z]{2,}\\b/gi;\nconst emails = textContent.match(emailRegex);\nif (emails && emails.length > 0) {\n  const uniqueEmails = [...new Set(emails)].filter(email => {\n    const lowerEmail = email.toLowerCase();\n    return !lowerEmail.includes(\"example.com\") && !lowerEmail.includes(\"test@\") && !lowerEmail.includes(\"noreply@\") && !lowerEmail.includes(\"no-reply@\") && lowerEmail.length > 5;\n  });\n  if (uniqueEmails.length > 0) {\n    result.emails = uniqueEmails.length === 1 ? uniqueEmails[0] : uniqueEmails.join(\", \");\n  }\n}\nreturn result;"
      },
      "typeVersion": 2
    },
