    {
      "id": "e6ffbe0d-6398-4816-a885-f13255490d44",
      "name": "Write the posts with Gemini",
      "type": "@n8n/n8n-nodes-langchain.googleGemini",
      "position": [
        1800,
        0
      ],
      "parameters": {
        "modelId": {
          "__rl": true,
          "mode": "id",
          "value": "models/gemini-2.5-flash"
        },
        "options": {
          "systemMessage": "You write social media posts for a business from one topic. Use only the facts in the notes and invent no numbers. Return JSON with the keys linkedin (a hook line, then 3 or 4 short paragraphs separated by blank lines and a closing question, up to 1300 characters, no hashtags), facebook (1 or 2 conversational sentences), bluesky (up to 280 characters) and image_prompt (one paragraph that describes a single image illustrating the idea in the given image style, with no text in the image)."
        },
        "messages": {
          "values": [
            {
              "content": "={{ 'Topic: ' + $('Take the next topic').item.json.topic + '\\nNotes and facts: ' + ($('Take the next topic').item.json.notes || 'none') + '\\nVoice: ' + $('Post settings').first().json.voice + '\\nImage style: ' + $('Post settings').first().json.image_style }}"
            }
          ]
        },
        "resource": "text",
        "operation": "message",
        "jsonOutput": true
