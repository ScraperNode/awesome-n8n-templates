    {
      "id": "e123ceb9-2a2c-4dea-adc2-4fe4351aab5f",
      "name": "When Formdall Lead Received",
      "type": "n8n-nodes-base.webhook",
      "position": [
        0,
        0
      ],
      "parameters": {
        "path": "formdall-leads",
        "options": {
          "rawBody": true
        },
        "httpMethod": "POST",
        "authentication": "headerAuth"
      },
      "typeVersion": 2.1
    },
    {
      "id": "b3002ad8-b187-42ac-ae3c-37acaa967c5d",
      "name": "Verify Signature Authenticity",
      "type": "n8n-nodes-base.code",
      "disabled": true,
      "position": [
        240,
        0
      ],
      "parameters": {
        "jsCode": "// Formdall signs the raw body with the action's secret. Compare in constant\n// time, and against the raw bytes - a re-serialised JSON object will not match.\nconst crypto = require('crypto');\nconst secret = $env.FORMDALL_SIGNING_SECRET;\nconst item = $input.first();\nconst raw = Buffer.from(item.binary.data.data, 'base64');\nconst header = item.json.headers['x-formdall-signature'] ?? '';\nconst expected = 'sha256=' + crypto.createHmac('sha256', secret).update(raw).digest('hex');\nconst ok =\n  expected.length === header.length &&\n  crypto.timingSafeEqual(Buffer.from(expected), Buffer.from(header));\nif (!ok) throw new Error('Invalid Formdall signature');\n// Keep the webhook's item shape, so the agent's $json.body.data paths work\n// whether this node is enabled or not. Only the body is swapped for the\n// verified bytes.\nreturn [{ json: { ...item.json, body: JSON.parse(raw.toString('utf8')) } }];\n"
      },
      "typeVersion": 2
    },
    {
      "id": "d32ba025-1791-44a6-87ef-9c436eaf89e4",
      "name": "Lead Analysis Agent",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "position": [
        512,
        0
      ],
      "parameters": {
        "text": "=New inquiry from the contact form on our website.\n\nName: {{ $json.body.data.name }}\nEmail: {{ $json.body.data.email }}\nCompany: {{ $json.body.data.company }}\nMessage:\n{{ $json.body.data.message }}",
        "options": {
          "systemMessage": "You triage inbound inquiries for a small web agency that builds websites and web apps for businesses.\n\nClassify the inquiry into exactly one score:\n- \"hot\": a concrete project or budget, a deadline, or a direct request for a quote or call.\n- \"warm\": a genuine prospect who is still vague, exploring, or asking general questions.\n- \"junk\": not a prospect. This includes vendor and agency pitches (SEO, marketing, lead lists, outsourcing), partnership or link-building offers, job applications, and requests unrelated to our services.\n\nAlso return:\n- category: a 1-3 word label for what the inquiry is about.\n- summary: one sentence a salesperson can read in two seconds.\n- reply_draft: for \"warm\" only, a short, friendly reply in the language of the inquiry that answers what can be answered and asks one question to move forward. Empty string otherwise.\n\nNever invent facts about our prices or availability."
        },
        "promptType": "define",
        "hasOutputParser": true
      },
      "typeVersion": 3.1
    },
    {
      "id": "cb5a248a-0e43-483a-8993-07dbf88487bc",
      "name": "Mistral AI Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatMistralCloud",
      "position": [
        496,
        240
      ],
      "parameters": {
        "model": "ministral-14b-latest",
        "options": {}
      },
      "typeVersion": 1
    },
    {
      "id": "c728d2e5-67c6-4d03-8e04-ede97876f53a",
      "name": "Parse Lead Structure",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "position": [
        704,
        240
      ],
      "parameters": {
        "schemaType": "manual",
        "inputSchema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"score\": { \"type\": \"string\", \"enum\": [\"hot\", \"warm\", \"junk\"] },\n    \"category\": { \"type\": \"string\" },\n    \"summary\": { \"type\": \"string\" },\n    \"reply_draft\": { \"type\": \"string\" }\n  },\n  \"required\": [\"score\", \"category\", \"summary\", \"reply_draft\"]\n}"
      },
      "typeVersion": 1.3
    },
