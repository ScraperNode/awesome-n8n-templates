    {
      "id": "e350fdf4-c7b6-40e9-a890-571d9118706a",
      "name": "Format AI Response",
      "type": "n8n-nodes-base.code",
      "position": [
        2272,
        208
      ],
      "parameters": {
        "jsCode": "let txt = $('Response Generation Agent').first().json.output || '';\n\n// Telegram markdown'\u0131 destekler ama temizlemek istersen:\n// txt = txt.replace(/[*_~`]+/g, '');\n\n// Markdown link format\u0131n\u0131 d\u00fcz metne \u00e7evir\ntxt = txt.replace(/\\[([^\\]]+)\\]\\((https?:\\/\\/[^\\s)]+)\\)/g, '$1 $2');\n\n// 3+ bo\u015f sat\u0131r\u0131 2'ye indir\ntxt = txt.replace(/\\n{3,}/g, '\\n\\n').trim();\n\n// Belge referans\u0131 kal\u0131plar\u0131n\u0131 temizle\ntxt = txt.replace(/^.*?based on the document you provided[,:]?\\s*/i, '');\n\nreturn [{ json: { answer: txt } }];"
      },
      "typeVersion": 2
    },
