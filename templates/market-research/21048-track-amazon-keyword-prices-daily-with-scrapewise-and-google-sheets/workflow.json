        "jsonInput": "={\n  \"body\": {\n    \"queries\": {{ JSON.stringify($json.queries) }},\n    \"marketplace\": \"{{ $json.marketplace }}\",\n    \"pages\": {{ $json.pages }},\n    \"quote_only\": {{ $json.quote_only }}\n  }\n}",
