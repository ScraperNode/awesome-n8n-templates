      "parameters": {
        "jsCode": "\n// Validate the request and build one clean object for all routes.\nconst cfg = $input.first().json;\nconst b = cfg.body || {};\nconst text = String(b.text || '').trim();\nconst author = String(b.author_id || cfg.author_id || '').trim();\nconst images = (Array.isArray(b.image_urls) ? b.image_urls : []).filter(Boolean).map(String);\nconst video = String(b.video_url || '').trim();\n\nif (!text) throw new Error('Field \"text\" is required.');\nif (!author || author === 'YOUR_LINKEDIN_PERSON_ID') {\n  throw new Error('Set your LinkedIn person ID in \"Set LinkedIn Settings\" or send \"author_id\".');\n}\nif (images.length > 20) throw new Error('A post takes at most 20 images, got ' + images.length + '.');\nif (video && images.length) throw new Error('Send either \"image_urls\" or \"video_url\", not both.');\n\nreturn [{ json: {\n  text,\n  author_urn: 'urn:li:person:' + author,\n  image_urls: images,\n  video_url: video,\n  api_version: String(cfg.linkedin_version || '202608'),\n} }];\n"
      },
      "typeVersion": 2
    },
