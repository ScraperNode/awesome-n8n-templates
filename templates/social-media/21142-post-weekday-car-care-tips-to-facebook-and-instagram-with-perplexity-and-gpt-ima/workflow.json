              "leftValue": "={{ (() => { const t = String($json.plan.topic || '').trim().toLowerCase(); const past = ($('Collect past topics').first().json.past || []).map(p => String(p.topic || '').trim().toLowerCase()); return t.length > 0 && !past.includes(t); })() }}",
