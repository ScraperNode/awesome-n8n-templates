    {
      "id": "8fb6483a-af48-4e09-9928-a80cb846f0be",
      "name": "Filter Unprocessed Reviews",
      "type": "n8n-nodes-base.code",
      "position": [
        752,
        592
      ],
      "parameters": {
        "jsCode": "// Drop reviews already stored in Supabase (and duplicates inside this batch)\nconst existing = new Set($('Check Existing Review').all().map(i => i.json.review_id).filter(Boolean));\nconst seen = new Set();\nconst out = [];\nfor (const item of $('Get New Reviews').all()) {\n  const id = item.json.review_id;\n  if (!id || existing.has(id) || seen.has(id)) continue;\n  seen.add(id);\n  out.push({ json: item.json });\n}\nreturn out;"
      },
      "typeVersion": 2
    },
