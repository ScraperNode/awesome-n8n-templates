              "id": "e+1234567890-+1234567890",
              "operator": {
                "type": "number",
                "operation": "gte"
              },
              "leftValue": "={{ $('Parse AI Score').item.json.score }}",
              "rightValue": "={{ $('Workflow Configuration').item.json.hotLeadThreshold }}"
            }
          ]
        }
      },
      "typeVersion": 2.2
    },
    {
