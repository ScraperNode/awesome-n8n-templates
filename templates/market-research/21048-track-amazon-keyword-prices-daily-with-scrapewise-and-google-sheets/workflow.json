      "name": "Answered straight away?",
      "type": "n8n-nodes-base.if",
      "position": [
        220,
        360
      ],
      "parameters": {
        "options": {},
        "conditions": {
          "options": {
            "version": 2,
            "caseSensitive": true,
            "typeValidation": "loose"
          },
          "combinator": "and",
