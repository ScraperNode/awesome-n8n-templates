      "type": "n8n-nodes-base.code",
      "position": [
        2496,
        16
      ],
      "parameters": {
        "jsCode": "// Get input items\nconst items = $input.all();\n\n// VITAL: This accesses the URL of the *upcoming* Wait node.\n// n8n automatically resolves this value at runtime.\nconst webhookUrl = $execution.resumeUrl; \n\n// Format for Dropcontact\nconst formattedData = items.map(item => ({\n    full_name: item.json.name,\n    company: item.json.organization\n}));\n\n// Return the payload with the dynamic URL\nreturn [{\n    json: {\n        data: formattedData,\n        siren: true,\n        language: \"en\",\n        // Pass the dynamic URL to Dropcontact\n        custom_callback_url: webhookUrl \n    }\n}];"
      },
