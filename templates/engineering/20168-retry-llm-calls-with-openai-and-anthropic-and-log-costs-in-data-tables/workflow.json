    {
      "id": "9f3b1c87-dfe4-4699-afcb-a7c6482a3884",
      "name": "Compile Final Result",
      "type": "n8n-nodes-base.code",
      "position": [
        7680,
        1664
      ],
      "parameters": {
        "jsCode": "const s = $input.first().json;\nconst success = s.next === 'success';\n\nlet status = 'failed';\nif (success) status = s.role === 'fallback' ? 'answered_by_fallback' : 'answered_by_primary';\n\nreturn [{\n  json: {\n    output: success ? s.answer : 'Sorry, the AI service is unavailable right now. Please try again in a few minutes.',\n    success,\n    status,\n    provider: success ? s.provider : '',\n    model: success ? s.model : '',\n    attempts: s.history.length,\n    latencyMs: Date.now() - s.startedAt,\n    inputTokens: s.inputTokens,\n    outputTokens: s.outputTokens,\n    estimatedCostUsd: Number(s.costUsd.toFixed(6)),\n    lastError: s.lastError,\n    attemptLog: JSON.stringify(s.history),\n    executionId: $execution.id,\n    workflowName: $workflow.name,\n    loggedAt: new Date().toISOString(),\n  },\n}];\n"
      },
      "typeVersion": 2
    },
