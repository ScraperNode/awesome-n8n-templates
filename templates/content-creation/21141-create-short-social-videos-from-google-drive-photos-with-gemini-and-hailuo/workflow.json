      "id": "73028772-6859-4de8-ad87-e78e5bd76b76",
      "name": "Write the captions with Gemini",
      "type": "@n8n/n8n-nodes-langchain.googleGemini",
      "position": [
        300,
        383.99999999999994
      ],
      "parameters": {
        "text": "={{ 'This photo will be animated into a 6-second video by an image-to-video model.\\nFile name: ' + $('Take the next photo').item.json.name + '\\nCamera style: ' + $('Video settings').first().json.style + '\\n\\nDescribe only what is in the photo; invent no prices, offers or claims. Return only JSON with the keys motion_prompt (one paragraph: the camera move and the natural motion of what is already in the photo), tiktok (a hook of up to 150 characters with 3 hashtags), instagram (2 sentences and up to 4 hashtags), youtube (one sentence for the description) and youtube_title (up to 80 characters, ending with #Shorts).' }}",
        "modelId": {
          "__rl": true,
          "mode": "id",
          "value": "models/gemini-2.5-flash"
        },
        "options": {
          "maxOutputTokens": 1000
        },
        "resource": "image",
        "inputType": "binary",
        "operation": "analyze",
        "binaryPropertyName": "data"
      },
      "typeVersion": 1.2
    },
