        },
        "operation": "Run actor and get dataset",
        "customBody": "={\n    \"delay\": 1,\n    \"fetchDetail\": false,\n    \"maxProducts\": 20,\n    \"mode\": \"url\",\n    \"sort\": \"sales\",\n    \"url\": \"{{ $json.shopeeUrl }}\"\n}"
      },
