{
  "name": "Monitor multiple endpoints with HTTP Request and alert on Slack only when status changes",
  "nodes": [
    {
      "id": "b0000000-0000-4000-8000-000000000001",
      "name": "Every 5 minutes",
      "type": "n8n-nodes-base.scheduleTrigger",
      "position": [
        -380,
        0
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 5
            }
          ]
        }
      },
      "typeVersion": 1.2
    },
    {
      "id": "b0000000-0000-4000-8000-000000000002",
      "name": "Run once now",
      "type": "n8n-nodes-base.manualTrigger",
      "position": [
        -380,
        200
      ],
      "parameters": {},
      "typeVersion": 1
    },
    {
      "id": "b0000000-0000-4000-8000-000000000003",
      "name": "Endpoints to watch",
      "type": "n8n-nodes-base.code",
      "position": [
        -160,
        100
      ],
      "parameters": {
        "jsCode": "// The list of things you want to know about. Keep it here, or replace this node\n// with Google Sheets / Airtable / a database if the list lives somewhere else \u2014\n// everything downstream only needs name, url and the field that proves health.\nreturn [\n  { json: { name: 'Public API',      url: 'https://example.com/health',        expect: 'ok' } },\n  { json: { name: 'Internal worker', url: 'https://worker.example.com/health', expect: 'ok' } },\n  { json: { name: 'Website',         url: 'https://example.com/',              expect: null } },\n];"
      },
      "typeVersion": 2
    },
    {
      "id": "b0000000-0000-4000-8000-000000000004",
      "name": "Split endpoints",
      "type": "n8n-nodes-base.splitInBatches",
      "position": [
        60,
        100
      ],
      "parameters": {
        "options": {},
        "batchSize": 1
      },
      "typeVersion": 3
    },
    {
      "id": "b0000000-0000-4000-8000-000000000005",
      "name": "Ping endpoint",
      "type": "n8n-nodes-base.httpRequest",
      "position": [
        280,
        200
      ],
      "parameters": {
        "url": "={{ $json.url }}",
        "options": {
          "timeout": 15000,
          "response": {
            "response": {
              "neverError": true,
              "fullResponse": true
            }
          }
        }
      },
      "typeVersion": 4.2
    },
    {
      "id": "b0000000-0000-4000-8000-000000000006",
      "name": "Judge response",
      "type": "n8n-nodes-base.code",
      "position": [
        500,
        200
      ],
      "parameters": {
        "jsCode": "// Decide for ourselves what healthy means.\n//\n// The HTTP node runs with Never Error, so a 500, a timeout or an HTML error page\n// all arrive here as ordinary items. Without this check every one of them would\n// count as a success and the workflow would stay green while the service is down.\nconst ziel = $('Split endpoints').item.json;\nconst res  = $json ?? {};\nconst code = Number(res.statusCode ?? 0);\nconst body = res.body ?? res;\n\nlet gesund = code >= 200 && code < 400;\nif (gesund && ziel.expect) {\n  const b = (typeof body === 'string') ? safeParse(body) : body;\n  gesund = !!(b && typeof b === 'object' && b[ziel.expect] === true);\n}\nfunction safeParse(s) { try { return JSON.parse(s); } catch { return null; } }\n\nreturn [{ json: { ...ziel, gesund, statusCode: code, geprueftAm: new Date().toISOString() } }];"
      },
      "typeVersion": 2
    },
    {
      "id": "b0000000-0000-4000-8000-000000000007",
      "name": "Healthy?",
      "type": "n8n-nodes-base.if",
      "position": [
        720,
        200
      ],
      "parameters": {
        "options": {},
        "conditions": {
          "options": {
            "version": 2,
            "caseSensitive": true
          },
          "combinator": "and",
          "conditions": [
            {
              "id": "c1",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              },
              "leftValue": "={{ $json.gesund }}",
              "rightValue": ""
            }
          ]
        }
      },
      "typeVersion": 2.2
    },
    {
      "id": "b0000000-0000-4000-8000-000000000008",
      "name": "Wait 30 seconds",
      "type": "n8n-nodes-base.wait",
      "position": [
        940,
        320
      ],
      "parameters": {
        "unit": "seconds",
        "amount": 30
      },
      "typeVersion": 1.1
    },
    {
      "id": "b0000000-0000-4000-8000-000000000009",
      "name": "Second attempt",
      "type": "n8n-nodes-base.httpRequest",
      "position": [
        1160,
        320
      ],
      "parameters": {
        "url": "={{ $json.url }}",
        "options": {
          "timeout": 15000,
          "response": {
            "response": {
              "neverError": true,
              "fullResponse": true
            }
          }
        }
      },
      "typeVersion": 4.2
    },
    {
      "id": "b0000000-0000-4000-8000-000000000010",
      "name": "Confirm outage",
      "type": "n8n-nodes-base.code",
      "position": [
        1380,
        320
      ],
      "parameters": {
        "jsCode": "// One failed request is not an outage \u2014 it is a bad second. Only a second failure\n// counts. This single step removes most of the noise that makes people mute alerts.\nconst ziel = $('Judge response').item.json;\nconst res  = $json ?? {};\nconst code = Number(res.statusCode ?? 0);\nconst body = res.body ?? res;\n\nlet gesund = code >= 200 && code < 400;\nif (gesund && ziel.expect) {\n  const b = (typeof body === 'string') ? (() => { try { return JSON.parse(body); } catch { return null; } })() : body;\n  gesund = !!(b && typeof b === 'object' && b[ziel.expect] === true);\n}\nreturn [{ json: { ...ziel, gesund, statusCode: code, bestaetigt: true } }];"
      },
      "typeVersion": 2
    },
    {
      "id": "b0000000-0000-4000-8000-000000000011",
      "name": "Track state change",
      "type": "n8n-nodes-base.code",
      "position": [
        1600,
        200
      ],
      "parameters": {
        "jsCode": "// Speak only when the verdict changes, and remember how long it has been broken.\n// Without this you send the same message every five minutes until someone mutes\n// the channel \u2014 and a muted monitor is not a monitor.\nconst j = $json;\nconst store = $getWorkflowStaticData('global');\nstore.hosts ??= {};\nconst s = store.hosts[j.name] ??= { healthy: true, since: null, misses: 0 };\n\nconst vorher = s.healthy;\ns.healthy = j.gesund;\ns.misses  = j.gesund ? 0 : (s.misses + 1);\nif (vorher !== j.gesund) s.since = new Date().toISOString();\n\nconst minutenUnten = s.since && !j.gesund\n  ? Math.round((Date.now() - new Date(s.since).getTime()) / 60000) : 0;\n\nlet ereignis = 'unchanged';\nif (vorher && !j.gesund) ereignis = 'down';\nelse if (!vorher && j.gesund) ereignis = 'recovered';\n\nreturn [{ json: { ...j, ereignis, minutenUnten, fehlversuche: s.misses } }];"
      },
      "typeVersion": 2
    },
    {
      "id": "b0000000-0000-4000-8000-000000000012",
      "name": "What happened?",
      "type": "n8n-nodes-base.switch",
      "position": [
        1820,
        200
      ],
      "parameters": {
        "rules": {
          "values": [
            {
              "outputKey": "down",
              "conditions": {
                "options": {
                  "version": 2,
                  "caseSensitive": true
                },
                "combinator": "and",
                "conditions": [
                  {
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    },
                    "leftValue": "={{ $json.ereignis }}",
                    "rightValue": "down"
                  }
                ]
              },
              "renameOutput": true
            },
            {
              "outputKey": "recovered",
              "conditions": {
                "options": {
                  "version": 2,
                  "caseSensitive": true
                },
                "combinator": "and",
                "conditions": [
                  {
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    },
                    "leftValue": "={{ $json.ereignis }}",
                    "rightValue": "recovered"
                  }
                ]
              },
              "renameOutput": true
            },
            {
              "outputKey": "unchanged",
              "conditions": {
                "options": {
                  "version": 2,
                  "caseSensitive": true
                },
                "combinator": "and",
                "conditions": [
                  {
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    },
                    "leftValue": "={{ $json.ereignis }}",
                    "rightValue": "unchanged"
                  }
                ]
              },
              "renameOutput": true
            }
          ]
        },
        "options": {}
      },
      "typeVersion": 3.2
    },
    {
      "id": "b0000000-0000-4000-8000-000000000013",
      "name": "Compose down message",
      "type": "n8n-nodes-base.set",
      "position": [
        2060,
        60
      ],
      "parameters": {
        "options": {},
        "assignments": {
          "assignments": [
