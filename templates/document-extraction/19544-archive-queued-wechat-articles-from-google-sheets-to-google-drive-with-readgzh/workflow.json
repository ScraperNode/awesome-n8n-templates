    {
      "id": "validate-article",
      "name": "Validate article",
      "type": "n8n-nodes-base.code",
      "position": [
        1980,
        320
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "function article(response, queue) {\n  const base={...queue,ok:false,status:'error',output_url:'',error:''};\n  if (response.error) return {...base,error:'Network/request failure; inspect the execution before retrying.'};\n  const code=Number(response.statusCode);\n  if (code!==200) return {...base,error:code===429?'ReadGZH quota/rate limit. Wait or configure your own credential before resetting to pending.':'ReadGZH HTTP '+(code || 'unknown')};\n  const md=String(response.body || '').trim();\n  if (!md || /^[<{\\[]/.test(md) || !/^#\\s+\\S/m.test(md)) return {...base,error:'Response is not recognizable article Markdown.'};\n  if (/next[_ ]part|[?&]part=2|\u7ee7\u7eed.{0,8}\u4e0b\u4e00\u90e8\u5206/i.test(md)) return {...base,error:'Possible multi-part response; inspect and retrieve all parts before archiving.'};\n  const title=(md.match(/^#\\s+(.+)$/m)||[])[1] || 'article';\n  const safe=title.replace(/[<>:\"/\\\\|?*\\x00-\\x1f]/g,'-').replace(/[. ]+$/g,'').slice(0,80)||'article';\n  return {...base,ok:true,status:'processing',markdown:md+'\\n',fileName:queue.queue_id+'-'+safe+'.md'};\n}\nreturn {json:article($json, $('Process one row').item.json)};"
      },
      "typeVersion": 2
