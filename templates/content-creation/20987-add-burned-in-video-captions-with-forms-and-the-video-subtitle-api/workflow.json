              "id": "ac2b8fa9-30f9-5b55-8412-bd948efc0dfd",
              "name": "video_url",
              "type": "string",
              "value": "={{ $json['Video URL'] || 'https://caption.yosuga.dev/samples/video/demo-streamer.mp4' }}"
            },
            {
              "id": "93ceacd4-49ea-50de-9437-451554e74cd8",
