      "position": [
        540,
        300
      ],
      "parameters": {
        "options": {},
        "assignments": {
          "assignments": [
            {
              "id": "d4d4d4d4-0301-4+1234567890",
              "name": "chatId",
              "type": "string",
              "value": "={{ String($json.message.chat.id) }}"
            },
            {
              "id": "d4d4d4d4-0302-4+1234567890",
              "name": "name",
              "type": "string",
              "value": "={{ [$json.message.from?.first_name, $json.message.from?.last_name].filter(Boolean).join(' ') }}"
            },
            {
              "id": "d4d4d4d4-0303-4+1234567890",
              "name": "username",
              "type": "string",
              "value": "={{ $json.message.from?.username ? '@' + $json.message.from.username : '' }}"
            },
            {
              "id": "d4d4d4d4-0304-4+1234567890",
              "name": "command",
              "type": "string",
              "value": "={{ String($json.message.text ?? '').trim().split(/\\s+/)[0].split('@')[0].toLowerCase() }}"
            },
            {
              "id": "d4d4d4d4-0305-4+1234567890",
              "name": "welcomeText",
              "type": "string",
              "value": "You're subscribed! Our updates will arrive here. Send /stop at any time to unsubscribe."
            },
            {
              "id": "d4d4d4d4-0306-4+1234567890",
              "name": "goodbyeText",
              "type": "string",
              "value": "You're unsubscribed and won't get any more broadcasts. Send /start to subscribe again."
            },
            {
              "id": "d4d4d4d4-0307-4+1234567890",
              "name": "helpText",
              "type": "string",
              "value": "Send /start to get our updates, or /stop to unsubscribe."
            }
          ]
        }
      },
      "typeVersion": 3.4
    },
    {
