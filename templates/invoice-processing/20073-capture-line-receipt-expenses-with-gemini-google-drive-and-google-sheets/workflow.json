      "parameters": {
        "url": "=https://web-api.invoice-kohyo.nta.go.jp/1/valid?id=YOUR_NTA_APP_ID&number=T{{ $json.cleanTaxNumber }}&day={{ $json.receipt_date || $now.setZone('Asia/Tokyo').toFormat('yyyy-MM-dd') }}&type=21",
