    {
      "id": "code-build-input",
      "name": "Build Apify input",
      "type": "n8n-nodes-base.code",
      "position": [
        780,
        200
      ],
      "parameters": {
        "jsCode": "const row = $input.item.json;\nconst conditions = (row.conditions || '').split(',').map(s => s.trim()).filter(Boolean);\nconst brands = (row.brands || '').split(',').map(s => s.trim()).filter(Boolean);\nconst searchLabel = `${row.searchInput} | ${row.country || 'fr'}`.trim();\n\nconst apifyInput = {\n  searches: [row.searchInput],\n  countries: [row.country || 'fr'],\n  deltaMode: true,\n  deltaName: searchLabel,\n  alertOnNew: true,\n  alertOnPriceDrop: true,\n  alertOnGone: false,\n  quietRunOutput: 'summary',\n  maxResults: 20,\n  onlyFound: true\n};\nif (row.maxPrice) apifyInput.maxPrice = Number(row.maxPrice);\nif (conditions.length) apifyInput.conditions = conditions;\nif (brands.length) apifyInput.brands = brands;\n\nreturn { json: { ...row, searchLabel, apifyInput } };"
      },
      "typeVersion": 2
    },
