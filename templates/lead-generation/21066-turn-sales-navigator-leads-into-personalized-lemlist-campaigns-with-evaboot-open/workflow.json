        "evabootApi": {
          "id": "",
          "name": "Evaboot account"
        }
      },
      "typeVersion": 1
    },
    {
      "id": "b2376fa2-3632-4493-a54d-bc39aa883f4e",
      "name": "Extraction finished?",
      "type": "n8n-nodes-base.if",
      "position": [
        1160,
