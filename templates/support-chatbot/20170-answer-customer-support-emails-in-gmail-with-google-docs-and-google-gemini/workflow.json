    {
      "name": "Write Final Reply",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "maxTries": 3,
      "position": [
        1632,
        784
      ],
      "parameters": {
        "text": "=KNOWLEDGE BASE\n{{ $('When Escalated').item.json.knowledge_base }}\n\nCUSTOMER EMAIL\nFrom: {{ $('When Escalated').item.json.email.from_name }} <{{ $('When Escalated').item.json.email.from_email }}>\nSubject: {{ $('When Escalated').item.json.email.subject }}\n\n{{ $('When Escalated').item.json.email.body }}\n\nOWNER'S ANSWER\n{{ $json.data.text }}",
        "batching": {},
        "messages": {
          "messageValues": [
            {
              "message": "You write the reply to a customer email for the business described in the knowledge base. The owner of the business has just told you the answer in their own words. Turn it into a proper email.\n\n# RULES\n- The owner's answer is the source of truth. Use its facts exactly: do not add promises, prices, dates or conditions that are not in the owner's answer or the knowledge base.\n- Reply in the language the customer wrote in.\n- Follow the TONE of the knowledge base. Use the customer's first name when you know it.\n- End with the EMAIL SIGNATURE from the knowledge base, exactly as written.\n- Plain text only: no Markdown, no asterisks, no subject line.\n- Never mention the owner's note, the knowledge base or AI.\n\n# FIELDS\n- reply: the full email body for the customer.\n- knowledge_base_entry: if the owner's answer is general information other customers could need, write it as a new entry for the knowledge base, in this format:\nQ: <the question, written generally>\nA: <the answer, written generally, without this customer's personal details>\nIf the answer only applies to this one customer (an order, a refund, a personal situation), write \"\"."
            }
          ]
        },
        "promptType": "define",
        "hasOutputParser": true
      },
      "retryOnFail": true,
      "typeVersion": 1.9,
      "waitBetweenTries": 10000
    },
