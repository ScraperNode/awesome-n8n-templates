        340
      ],
      "parameters": {},
      "typeVersion": 2.3
    },
    {
      "id": "b0000000-0000-4000-8000-000000000019",
      "name": "Append to outage log",
      "type": "n8n-nodes-base.googleSheets",
      "position": [
        2280,
        480
      ],
      "parameters": {},
      "typeVersion": 4.5
    },
    {
      "id": "b0000000-0000-4000-8000-000000000020",
      "name": "Every morning at 08:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "position": [
        -380,
        700
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 8 * * *"
            }
          ]
        }
      },
      "typeVersion": 1.2
    },
    {
      "id": "b0000000-0000-4000-8000-000000000021",
      "name": "Read what happened",
      "type": "n8n-nodes-base.code",
      "position": [
        -160,
        700
      ],
      "parameters": {
        "jsCode": "// Read the memory the check loop keeps, and turn it into something a human wants\n// to read at breakfast: what is broken now, what broke and came back yesterday.\nconst store = $getWorkflowStaticData('global');\nconst hosts = store.hosts ?? {};\nconst jetztUnten = Object.entries(hosts).filter(([, s]) => !s.healthy)\n  .map(([name, s]) => ({ name, seit: s.since }));\nreturn [{ json: { gesamt: Object.keys(hosts).length, unten: jetztUnten } }];"
      },
      "typeVersion": 2
    },
    {
      "id": "b0000000-0000-4000-8000-000000000022",
      "name": "Build digest",
      "type": "n8n-nodes-base.code",
      "position": [
        60,
        700
      ],
      "parameters": {
        "jsCode": "const d = $json;\nconst zeilen = d.unten.length\n  ? d.unten.map(h => `\u2022 ${h.name} \u2014 down since ${h.since}`).join('\\n')\n  : 'Everything responded as expected.';\nreturn [{ json: { text: `Daily check \u2014 ${d.gesamt} endpoints watched\\n\\n${zeilen}` , hatAusfaelle: d.unten.length > 0 } }];"
      },
      "typeVersion": 2
    },
    {
      "id": "b0000000-0000-4000-8000-000000000023",
      "name": "Anything worth sending?",
      "type": "n8n-nodes-base.if",
      "position": [
        280,
        700
      ],
      "parameters": {
        "options": {},
        "conditions": {
          "options": {
            "version": 2,
