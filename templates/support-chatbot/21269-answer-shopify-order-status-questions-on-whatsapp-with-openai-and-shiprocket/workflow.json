    {
      "id": "b51fb0ae-3f61-469d-8903-245d80ebd9d4",
      "name": "Decide Bot or Human",
      "type": "n8n-nodes-base.code",
      "position": [
        2560,
        112
      ],
      "parameters": {
        "jsCode": "const m = $('Parse WhatsApp Message').first().json;\nconst s = $input.first()?.json || {};\nconst human = String(s.human_mode || '').toLowerCase() === 'yes' && s.human_until && new Date(s.human_until) > new Date();\nreturn [{ json: { ...m, route: human ? 'human' : (m.supported ? 'bot' : 'unsupported'), fails: Number(s.consecutive_fails || 0),\n  last_order: s.last_order || '', human_until: s.human_until || '' } }];"
      },
      "typeVersion": 2
    },
