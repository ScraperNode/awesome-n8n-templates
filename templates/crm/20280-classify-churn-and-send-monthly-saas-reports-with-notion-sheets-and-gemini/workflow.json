    {
      "id": "29d2f77f-7b47-4b3c-913f-99d9135fd193",
      "name": "Validate Dunning Window",
      "type": "n8n-nodes-base.code",
      "position": [
        -1296,
        352
      ],
      "parameters": {
        "jsCode": "// Target the accurately named 'Edit Fields1' node and parse strings into Date objects\nconst cancelDateStr = $('Format Cancellation Data').first().json['Cancellation Date'];\nconst dunningDateStr = $input.first().json['Dunning Start Date'];\n\nconst cancelDate = new Date(cancelDateStr);\nconst dunningDate = new Date(dunningDateStr);\n\n// Calculate the difference\nconst diffTime = Math.abs(cancelDate - dunningDate);\nconst diffDays = Math.ceil(diffTime / (1000 * 60 * 60 * 24)); \n\n// Check if dunning was before cancellation and within 60 days\nconst isValid = (dunningDate <= cancelDate && diffDays <= 60);\n\nreturn { \n  json: { \n    isValidDunning: isValid, \n    dunningDate: dunningDateStr \n  } \n};"
      },
      "typeVersion": 2
    },
