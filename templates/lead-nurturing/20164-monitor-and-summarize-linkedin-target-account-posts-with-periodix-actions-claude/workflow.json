    {
      "id": "f02f8656-d9b3-4463-8f92-9f8c94f6b612",
      "name": "Prepare Accounts",
      "type": "n8n-nodes-base.code",
      "position": [
        896,
        336
      ],
      "parameters": {
        "jsCode": "const out = [];\nfor (const r of $('Read Accounts').all()) {\n  const url = String(r.json.linkedin_url || '').trim();\n  if (!url) continue;\n  const company = /linkedin\\.com\\/company\\//i.test(url);\n  const m = url.match(/linkedin\\.com\\/(?:in|company)\\/([^/?#]+)/i);\n  out.push({ json: {\n    account_name: r.json.account_name || '',\n    linkedin_url: url,\n    slug: m ? m[1] : url,\n    is_company: company,\n    author_id: String(r.json.author_id || '').trim()\n  } });\n}\nreturn out;"
      },
      "typeVersion": 2
    },
