    {
      "id": "c14ccc1e-9a65-447a-a7a6-38ca6363d9eb",
      "name": "Get video link",
      "type": "n8n-nodes-base.code",
      "position": [
        1560,
        320
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// The Orshot node returns the API response under data, and the API wraps the render in data again.\n// A failed render comes back as { error } because the step continues on error.\nconst res = $json.data?.data ?? $json.data;\nconst page = Array.isArray(res) ? res[0] : res;\nconst video = page?.content || '';\nreturn { json: { video, error: video ? '' : String($json.error || 'Orshot returned no video link') } };"
      },
      "typeVersion": 2
    },
