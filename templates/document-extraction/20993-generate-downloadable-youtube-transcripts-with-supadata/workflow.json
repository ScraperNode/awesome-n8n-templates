    {
      "id": "8cd14dd6-3ab6-4667-80dd-715c3e7eda1d",
      "name": "Format Transcript",
      "type": "n8n-nodes-base.code",
      "position": [
        288,
        32
      ],
      "parameters": {
        "jsCode": "const url = $('YouTube URL Form').first().json['YouTube URL'] || '';\nconst m = url.match(/(?:v=|youtu\\.be\\/|shorts\\/|embed\\/|live\\/)([A-Za-z0-9_-]{11})/);\nconst videoId = m ? m[1] : 'video';\nlet content = $json.content;\nif (Array.isArray(content)) content = content.map(c => c.text).join(' ');\nif (!content) throw new Error('No transcript found for this video.');\nconst header = `YouTube Transcript\\nVideo: ${url}\\nLanguage: ${$json.lang || 'unknown'}\\nGenerated: ${new Date().toISOString()}\\n\\n`;\nreturn [{ json: { transcript: header + content, fileName: `transcript_${videoId}.txt` } }];"
      },
      "typeVersion": 2
    },
    {
      "id": "47e4d64f-47a6-4318-99c3-6c66e44ef0ca",
      "name": "Create .txt File",
