    {
      "id": "29843531-e424-4790-912a-a7a22ad5384d",
      "name": "Assemble Context Data",
      "type": "n8n-nodes-base.set",
      "position": [
        2000,
        1232
      ],
      "parameters": {
        "mode": "raw",
        "options": {},
        "jsonOutput": "={{ (function(){\nconst o = $('Read Pending Orders from Sheets').first().json;\nconst c = $('Fetch Customer Data').first().json;\nconst p = $('Fetch Product Information').first().json;\nconst cr = $('Retrieve Customer Credit').first().json;\nconst r = $('Fetch Customer Returns').first().json;\nconst h = $('Summarize Order Data').first().json;\nconst histCount = $('Retrieve Order History').all().filter(i => i.json.Order_ID).length;\nconst qty = Number(o.Quantity), val = Number(o.Order_Value);\nconst limit = Number(cr.Credit_Limit || c.Credit_Limit || 0);\nconst out = Number(cr.Outstanding_Balance || 0);\nconst avgQ = Number(h.average_Quantity || 0), avgV = Number(h.average_Order_Value || 0);\nconst pct = n => limit > 0 ? Math.round(n / limit * 1000) / 10 : null;\nreturn {\n  order: { order_id: o.Order_ID, order_date: o.Order_Date, sku: o.SKU, quantity: qty, order_value: val },\n  customer: { customer_id: o.Customer_ID, company: c.Company || null, sales_rep: c.Sales_Rep || null, payment_terms: c.Payment_Terms || null, account_status: c.Account_Status || null },\n  product: { name: p.Product_Name || null, category: p.Category || null, normal_pack_size: p.Normal_Pack_Size || null },\n  history: { order_count: histCount, avg_quantity: avgQ || null, max_quantity: Number(h.max_Quantity || 0) || null, avg_order_value: avgV || null, max_order_value: Number(h.max_Order_Value || 0) || null,\n             quantity_vs_avg_ratio: avgQ > 0 ? Math.round(qty / avgQ * 10) / 10 : null, value_vs_avg_ratio: avgV > 0 ? Math.round(val / avgV * 10) / 10 : null },\n  credit: { credit_limit: limit, outstanding_balance: out, overdue_amount: Number(cr.Overdue_Amount || 0), current_utilization_pct: pct(out), projected_utilization_pct_with_this_order: pct(out + val), remaining_credit_after_order: limit - out - val },\n  returns: { return_count_90d: Number(r.Return_Count_90D || 0), return_value_90d: Number(r.Return_Value_90D || 0), last_return_date: r.Last_Return_Date || null }\n};\n})() }}"
      },
      "typeVersion": 3.4
    },
    {
      "id": "be3f8140-ca3f-4148-a095-62c90c50e82f",
      "name": "Order Risk Analysis Agent",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "position": [
        2256,
        1232
      ],
      "parameters": {
        "text": "=Analyze this new order and return your decision.\n\n{{ JSON.stringify($json, null, 2) }}",
        "options": {
          "systemMessage": "You are a B2B order anomaly analyst for a distributor.\n\nEvaluate the NEW ORDER against the customer's historical purchasing behavior, credit position, product patterns and recent returns. All numbers in the input (averages, ratios, credit utilization) are precomputed and exact: trust them, do not recalculate them.\n\nDo NOT automatically reject an order. Decide only whether it needs human verification. An order can be large and still be legitimate.\n\nConsider:\n1. Quantity anomaly (quantity_vs_avg_ratio, max_quantity)\n2. Order value anomaly (value_vs_avg_ratio, max_order_value)\n3. Unusual product or product category for this customer\n4. Quantity far from the product's normal pack size\n5. Projected credit utilization and remaining credit\n6. Overdue balance and account status\n7. Recent return behavior\n8. If history.order_count is 0 or ratios are null, treat the customer as new or unknown and say so.\n\nDecision rules:\n- risk_level NORMAL -> requires_review = false\n- risk_level REVIEW or HIGH -> requires_review = true\n- risk_score is 0-100 and must be consistent with risk_level (NORMAL <40, REVIEW 40-74, HIGH 75+).\n\nKeep reasons short and factual, quoting the actual numbers. recommended_action is a short instruction for the sales representative."
        },
        "promptType": "define",
        "hasOutputParser": true
      },
      "typeVersion": 2.2
    },
    {
      "id": "f32015ac-d9f7-46e1-85f8-730383d56cad",
