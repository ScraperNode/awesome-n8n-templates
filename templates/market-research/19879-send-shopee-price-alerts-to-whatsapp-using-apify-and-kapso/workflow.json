    {
      "id": "966a1382-91a4-48ff-964d-d114361b01a6",
      "name": "Config",
      "type": "n8n-nodes-base.code",
      "position": [
        -256,
        816
      ],
      "parameters": {
        "jsCode": "const KAPSO_API_KEY = 'PUT YOUR KEY HERE';\nconst KAPSO_PHONE_NUMBER_ID = 'PUT KAPSO PHONE ID HERE'\n\nreturn {\n  KAPSO_API_KEY,\n  KAPSO_PHONE_NUMBER_ID\n}"
      },
      "typeVersion": 2
