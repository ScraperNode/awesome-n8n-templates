    {
      "id": "cf56ce9e-daee-4556-a033-745ee169bf7f",
      "name": "Needs Escalation?",
      "type": "n8n-nodes-base.if",
      "position": [
        1960,
        400
      ],
      "parameters": {
        "options": {},
        "conditions": {
          "options": {
            "leftValue": "",
            "caseSensitive": true,
            "typeValidation": "loose"
          },
          "combinator": "and",
          "conditions": [
            {
              "id": "c1",
              "operator": {
                "type": "number",
                "operation": "largerEqual"
              },
              "leftValue": "={{ $json.amount }}",
              "rightValue": "={{ $('Workflow Configuration').first().json.minDealValueForEscalation }}"
            },
            {
              "id": "c2",
              "operator": {
                "type": "number",
                "operation": "largerEqual"
              },
              "leftValue": "={{ $json.daysStalled }}",
              "rightValue": "={{ $json.thresholdDays * $('Workflow Configuration').first().json.escalationMultiplier }}"
            }
          ]
        }
      },
      "typeVersion": 2.2
    },
    {
      "id": "b379f69d-e844-4d37-98b0-29cea22fb3a4",
