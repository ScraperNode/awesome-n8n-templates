    {
      "id": "a8cced5f-7432-41eb-980e-02faf7724b69",
      "name": "Attach Form Image Binary",
      "type": "n8n-nodes-base.code",
      "position": [
        4000,
        1776
      ],
      "parameters": {
        "jsCode": "const formBinary = $('When Incident Form Submitted').first().binary;\nconst binaryData = formBinary?.data;\nif (!binaryData) {\n  throw new Error(\"No binary data found under the field 'data' from the form trigger.\");\n}\nreturn [{ json: { ...$json }, binary: { data: binaryData } }];"
      },
      "typeVersion": 2
