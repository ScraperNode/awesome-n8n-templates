    {
      "id": "ed419e1b-5ae2-409e-b8b6-1a1ee5f2492f",
      "name": "Pick Clients to Nudge",
      "type": "n8n-nodes-base.code",
      "position": [
        512,
        976
      ],
      "parameters": {
        "jsCode": "// Find open tasks that need a nudge and group them per client\nconst cfg = $('Set Nudge Rules').first().json;\nconst rows = $input.all().map(i => i.json);\nconst DAY = 86400000;\nconst today = new Date();\ntoday.setHours(0, 0, 0, 0);\nconst parse = v => {\n  if (!v) return null;\n  const d = new Date(v);\n  if (isNaN(d)) return null;\n  d.setHours(0, 0, 0, 0);\n  return d;\n};\nconst iso = d => `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;\nconst DONE = ['done', 'complete', 'completed', 'skipped', 'dropped'];\n\nconst clients = {};\nfor (const r of rows) {\n  const key = String(r['Client Email'] || '').trim().toLowerCase();\n  if (!key) continue;\n  const c = clients[key] || (clients[key] = {\n    clientId: r['Client ID'], clientName: r['Client Name'], clientEmail: r['Client Email'],\n    total: 0, done: 0, tasks: [],\n  });\n  c.total++;\n  const status = String(r['Status'] || '').toLowerCase().trim();\n  if (DONE.includes(status)) { c.done++; continue; }\n\n  const due = parse(r['Due Date']);\n  if (!due) continue;\n  const daysLeft = Math.round((due - today) / DAY);\n  if (daysLeft > cfg.nudgeWindowDays || daysLeft < -cfg.stopAfterDaysOverdue) continue;\n\n  const count = Number(r['Nudge Count'] || 0);\n  if (count >= cfg.maxNudgesPerTask) continue;\n  const last = parse(r['Last Nudge Date']);\n  if (last && (today - last) / DAY < cfg.minDaysBetweenNudges) continue;\n\n  c.tasks.push({ taskId: r['Task ID'], task: r['Task'], dueDate: iso(due), daysLeft, nudgeCount: count });\n}\n\nconst when = d => d < 0 ? `${-d} day(s) overdue` : d === 0 ? 'due today' : `due in ${d} day(s)`;\nreturn Object.values(clients)\n  .filter(c => c.tasks.length)\n  .map(c => ({\n    json: {\n      ...c,\n      completionPct: c.total ? Math.round((c.done / c.total) * 100) : 0,\n      taskList: c.tasks.map(t => `- ${t.task} (${when(t.daysLeft)})`).join('\\n'),\n    },\n  }));"
      },
      "typeVersion": 2
    },
    {
      "id": "03b5f8e6-6792-4b82-b6b7-5dff146a1238",
      "name": "Draft Nudge Message",
      "type": "@n8n/n8n-nodes-langchain.openAi",
      "position": [
        816,
        992
      ],
      "parameters": {
        "modelId": {
          "__rl": true,
          "mode": "list",
          "value": "gpt-4o-mini",
          "cachedResultName": "GPT-4O-MINI"
        },
        "options": {
          "temperature": 0.6
        },
        "messages": {
          "values": [
            {
              "role": "system",
              "content": "You write short check-in emails from a coach to their client between sessions. Tone: encouraging, human, no guilt or pressure, not corporate. Mention one or two of the open tasks by name, acknowledge progress if the completion rate is above zero, and ask for a quick reply with an update or anything blocking them. Under 90 words, plain text, no bracketed placeholders, sign off with the coach's first name. Return only JSON: {\"subject\": \"...\", \"body\": \"...\"}"
            },
            {
              "content": "=Client: {{ $json.clientName }}\nCoach: {{ $('Set Nudge Rules').first().json.coachName }}\nHomework completed so far: {{ $json.done }} of {{ $json.total }} ({{ $json.completionPct }}%)\nOpen tasks:\n{{ $json.taskList }}"
            }
          ]
        },
        "jsonOutput": true
      },
      "typeVersion": 1.8
    },
    {
      "id": "910d7c3a-1186-4d3c-9fd8-3c136b5b98ca",
