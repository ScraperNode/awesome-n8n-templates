    {
      "id": "3713ed72-b8f1-50fb-8730-852382bf2a1e",
      "name": "Score each store",
      "type": "n8n-nodes-base.code",
      "position": [
        1060,
        300
      ],
      "parameters": {
        "jsCode": "// Points per signal: edit freely. Max 10.\nconst s = $('Set your settings').first().json;\nconst list = v => String(v || '').split(',').map(x => x.trim().toLowerCase()).filter(Boolean);\nconst niches = list(s.targetNiches);\nconst countries = list(s.targetCountries);\n\nreturn $input.all().map(({ json: st }) => {\n  let score = 0;\n  const why = [];\n  const add = (pts, reason) => { score += pts; why.push(reason); };\n\n  if (st.status === 'pre-launch') add(3, 'still behind its password page');\n  if (niches.includes(String(st.niche || '').toLowerCase())) add(2, `target niche (${st.niche})`);\n  if (countries.includes(String(st.country || '').toLowerCase())) add(2, `target country (${st.country})`);\n  const products = Number(st.products) || 0;\n  if (products >= 1 && products <= 50) add(1, `small catalog (${products} products)`);\n  if (Number(st.ships_to) > 1) add(1, `ships to ${st.ships_to} countries`);\n  const ageDays = st.domain_registered\n    ? (Date.now() - Date.parse(st.domain_registered)) / 86400000 : Infinity;\n  if (ageDays <= 30) add(1, 'domain under 30 days old');\n\n  return { json: {\n    store_domain: st.store_domain,\n    store_url: `https://${st.store_domain}`,\n    store_name: st.store_name || st.store_domain,\n    status: st.status,\n    niche: st.niche,\n    country: st.country,\n    products,\n    domain_registered: st.domain_registered,\n    first_detected: st.first_detected,\n    status_checked_at: st.status_checked_at,\n    cursor: st.cursor,\n    score,\n    why: why.join(', ') || 'no target signal',\n    scored_on: $now.toISODate(),\n  } };\n});"
      },
      "typeVersion": 2
    },
