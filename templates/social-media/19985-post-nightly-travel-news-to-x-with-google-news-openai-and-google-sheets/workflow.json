  "nodes": [
    {
      "id": "sticky-buzzbot-main",
      "name": "\u30bb\u30c3\u30c8\u30a2\u30c3\u30d7\u624b\u9806",
      "type": "n8n-nodes-base.stickyNote",
      "position": [
        0,
