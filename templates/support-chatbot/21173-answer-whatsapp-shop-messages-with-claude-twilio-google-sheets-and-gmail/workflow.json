    {
      "id": "eab08db3-7cd8-5f6b-9606-794ad78ff332",
      "name": "Classify message intent",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "position": [
        1040,
        300
      ],
      "parameters": {
        "text": "=Message from {{ $json.name }} ({{ $json.from }}):\n\"{{ $json.message }}\"",
        "options": {
          "systemMessage": "=You are a message classifier for {{ $('Settings').first().json.shop_name }}, {{ $('Settings').first().json.shop_description }}. Customers message the shop on WhatsApp.\n\nClassify the incoming message as exactly ONE of these five categories:\n\n- order        - customer wants to buy, reorder, or confirm an order\n- question     - customer asks about products, prices, stock, delivery, opening hours, payment or returns\n- complaint    - customer is unhappy: wrong, missing, damaged or late item, or asks for a refund\n- social       - friendly chatter, greeting, emoji-only message, or a compliment with no question\n- other        - spam, gibberish, wrong number, or anything that doesn't fit\n\nReturn ONLY the single lowercase category word. No punctuation, no explanation, no quotes."
        },
        "promptType": "define"
      },
      "typeVersion": 1.7
    },
