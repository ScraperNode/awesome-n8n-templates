        "options": {},
        "jsonBody": "={{ JSON.stringify({\n  images: [{ id: $json.id, alt: $('Loop over products').item.json.images[0].alt || $('Loop over products').item.json.name }]\n    .concat(($('Settings').first().json.keepOriginalInGallery ? $('Loop over products').item.json.images : $('Loop over products').item.json.images.slice(1)).map(i => ({ id: i.id }))),\n  meta_data: [\n    { key: $('Settings').first().json.markerKey, value: $now.toISO() },\n    { key: 'lassocut_original_image_id', value: String($('Loop over products').item.json.images[0].id) }\n  ]\n}) }}",
        "sendBody": true,
        "specifyBody": "json",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "wooCommerceApi"
      },
      "typeVersion": 4.2
    },
