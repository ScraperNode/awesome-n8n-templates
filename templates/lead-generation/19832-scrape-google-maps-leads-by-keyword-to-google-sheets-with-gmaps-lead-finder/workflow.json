      "parameters": {
        "jsCode": "const payload = $('Fetch review results').first().json;\nconst rows = Array.isArray(payload.rows)\n  ? payload.rows\n  : (Array.isArray(payload.data) ? payload.data : (Array.isArray(payload) ? payload : []));\nif (!rows.length) {\n  return [{ json: { _empty: true, note: 'No rows returned. Check job status and export preferences.' } }];\n}\nreturn rows.map((row) => ({ json: row }));\n"
