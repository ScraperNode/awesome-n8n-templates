        464,
        400
      ],
      "parameters": {
        "color": 7,
        "width": 416,
        "content": "## Start and configure\n\nProvides the manual and scheduled entry points, then centralizes WooCommerce, currency, and Pinecone settings used throughout the workflow."
      },
      "typeVersion": 1
    },
    {
