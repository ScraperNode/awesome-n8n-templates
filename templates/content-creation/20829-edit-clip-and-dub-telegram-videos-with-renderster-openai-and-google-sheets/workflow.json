    {
      "id": "af8e7fc4-3c82-5f97-99c4-bd7ce1c8349a",
      "name": "Build the job",
      "type": "n8n-nodes-base.code",
      "position": [
        1140,
        140
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Turns the AI's reading of the message into a Renderster /media request.\nconst s = $('Settings').item.json;\nconst ai = $json.output;\nconst type = ai.action;\nconst options = {};\nif (type === 'auto_edit') {\n  options.edit_style = ai.edit_style || s.default_edit_style;\n  options.orientation = ai.orientation || 'vertical';\n  options.caption_style = s.caption_style;\n  if (options.edit_style !== 'hardcopy') options.music = s.music; // hardcopy brings its own score\n} else if (type === 'clips') {\n  options.clip_count = Math.min(Math.max(ai.clip_count || s.default_clip_count, 1), 10);\n  options.orientation = ai.orientation || 'vertical';\n  options.captions = true;\n  options.caption_style = s.caption_style;\n  options.hook_title = true;\n} else if (type === 'dub') {\n  options.dub_language = ai.dub_language || s.default_dub_language;\n}\nreturn { json: { chat_id: s.chat_id, file_id: s.file_id, link: s.link, type, options, options_json: JSON.stringify(options), reply: ai.reply } };"
      },
      "typeVersion": 2
    },
