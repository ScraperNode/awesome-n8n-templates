    {
      "id": "45e9d71b-e21e-4403-a1ad-b7c176df0a4a",
      "name": "Write the hooks with Gemini",
      "type": "@n8n/n8n-nodes-langchain.googleGemini",
      "position": [
        300,
        0
      ],
      "parameters": {
        "modelId": {
          "__rl": true,
          "mode": "id",
          "value": "models/gemini-2.5-flash"
        },
        "options": {
          "systemMessage": "You plan an A/B test of opening hooks for one 8-second vertical (9:16) Instagram Reel. Return JSON with the key variants: an array with exactly the requested number of variants. Every variant shows the same idea but opens in a different way (for example a question, a bold claim, a visual surprise). Each variant has hook (the opening line, up to 10 words), angle (2 or 3 words that name the approach), veo_prompt (one paragraph for Veo that starts with what happens in the first second, then subject, action, camera movement, lighting and ambient sound; no on-screen text, no logos, no real people) and caption (the hook as the first line, then 1 sentence and up to 5 hashtags). Invent no facts."
        },
        "messages": {
          "values": [
            {
              "content": "={{ 'Video idea: ' + $json['Video idea'] + '\\nAudience: ' + ($json.Audience || 'a general audience') + '\\nVariants: ' + $json.Variants }}"
            }
          ]
        },
        "resource": "text",
        "operation": "message",
        "jsonOutput": true
      },
      "typeVersion": 1.2
    },
