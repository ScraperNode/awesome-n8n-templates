              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              },
              "leftValue": "={{ $json.hasIssues }}",
              "rightValue": ""
            },
            {
              "id": "1d4f3c43-eba8-5730-a73f-29a92d9b9562",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              },
