        "conditions": {
          "options": {
            "version": 2,
            "leftValue": "",
            "caseSensitive": true,
            "typeValidation": "loose"
          },
          "combinator": "and",
          "conditions": [
            {
              "id": "332562fd-aab0-4163-879b-060f9e502006",
              "operator": {
                "type": "number",
                "operation": "equals"
              },
              "leftValue": "={{ ($json.krs || $json.nip).length }}",
              "rightValue": 10
            }
          ]
        }
      },
      "typeVersion": 2.2
    },
    {
      "id": "42489d40-b5f7-43a1-8097-e662a5ac02f9",
      "name": "KRZ: debtor register search",
      "type": "@apify/n8n-nodes-apify.apify",
      "onError": "continueRegularOutput",
      "position": [
        1000,
        -240
      ],
      "parameters": {
        "memory": 1024,
        "actorId": "regdata~krz-debtor-scraper",
        "resource": "Actors",
        "operation": "Run actor and get dataset",
        "customBody": "={{ JSON.stringify({ searchMode: 'entity', identifier: $json.krs || $json.nip, maxResults: 20 }) }}",
        "maxTotalChargeUsd": 0.25
      },
      "typeVersion": 1
    },
    {
      "id": "22f887ce-24c3-4e32-b9bd-15b12ebcf89c",
      "name": "MSiG: court gazette notices",
      "type": "@apify/n8n-nodes-apify.apify",
      "onError": "continueRegularOutput",
      "position": [
        1000,
        20
      ],
      "parameters": {
        "memory": 4096,
        "actorId": "regdata~msig-scraper",
        "resource": "Actors",
        "operation": "Run actor and get dataset",
        "customBody": "={{ JSON.stringify(Object.assign({ searchType: 'A', dateFrom: $now.minus({ days: 8 }).toFormat('yyyy-MM-dd'), dateTo: $now.toFormat('yyyy-MM-dd'), fetchDetails: true, maxResults: 20 }, $json.krs ? { krs: $json.krs } : { nip: $json.nip })) }}",
        "maxTotalChargeUsd": 0.25
      },
      "typeVersion": 1
    },
    {
      "id": "c288d643-cd68-4dc7-b9ab-975d7c461d5d",
      "name": "Shape KRZ findings",
      "type": "n8n-nodes-base.code",
      "position": [
        1280,
        -240
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const src = $('Only valid identifiers').item.json;\nconst id = src.krs || src.nip;\nif ($json.error) {\n  // The registry did not answer. Report it - a failed check must never look like \"no findings\".\n  return { json: { company: src.company, identifier: id, source: 'KRZ', what: 'Check could not be completed - re-run', status: String($json.error).slice(0, 200), reference: '', date: $now.toFormat('yyyy-MM-dd'), link: '', proceedingId: '', dedupeKey: 'KRZ-ERROR|' + id + '|' + $execution.id } };\n}\nreturn { json: {\n  company: src.company || $json.entityName,\n  identifier: id,\n  source: 'KRZ',\n  what: 'Proceeding',\n  status: '',\n  reference: '',\n  date: '',\n  link: 'https://krz.ms.gov.pl/',\n  proceedingId: $json.proceedingId || '',\n  dedupeKey: ['KRZ', id, $json.proceedingId || $json.caseSignature || $json.entityName].join('|'),\n} };"
      },
      "typeVersion": 2
    },
    {
      "id": "dcf7eb00-d0d4-4e5e-a6b0-7b6753b43b23",
      "name": "New KRZ entries only",
      "type": "n8n-nodes-base.removeDuplicates",
      "position": [
        1480,
        -240
      ],
      "parameters": {
        "options": {
          "historySize": 10000
        },
        "operation": "removeItemsSeenInPreviousExecutions",
        "dedupeValue": "={{ $json.dedupeKey }}"
      },
      "typeVersion": 2
    },
    {
      "id": "eed48bf3-8288-4bef-b79b-73994e375da4",
      "name": "Has proceeding id?",
      "type": "n8n-nodes-base.if",
      "position": [
        1680,
        -240
      ],
      "parameters": {
        "options": {},
        "conditions": {
          "options": {
            "version": 2,
            "leftValue": "",
            "caseSensitive": true,
            "typeValidation": "loose"
          },
          "combinator": "and",
          "conditions": [
            {
              "id": "287d2756-385b-4fdc-97d1-e618043ed127",
              "operator": {
                "type": "string",
                "operation": "notEmpty",
                "singleValue": true
              },
              "leftValue": "={{ $json.proceedingId }}",
              "rightValue": ""
            }
          ]
        }
      },
      "typeVersion": 2.2
    },
    {
      "id": "484927b3-6109-47c1-9a27-f0fb32792bd3",
      "name": "KRZ: proceeding details",
      "type": "@apify/n8n-nodes-apify.apify",
      "onError": "continueRegularOutput",
      "position": [
        1880,
        -330
      ],
      "parameters": {
        "memory": 1024,
        "actorId": "regdata~krz-debtor-scraper",
        "resource": "Actors",
        "operation": "Run actor and get dataset",
        "customBody": "={{ JSON.stringify({ searchMode: 'proceedingDetails', proceedingId: $json.proceedingId }) }}",
        "maxTotalChargeUsd": 0.25
      },
      "typeVersion": 1
    },
    {
      "id": "007e6a05-b9cb-4153-b261-2088c2094bed",
      "name": "Add proceeding details",
      "type": "n8n-nodes-base.code",
      "position": [
        2080,
        -330
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const f = { ...$('Has proceeding id?').item.json };\nconst d = $json.details || {};\nif ($json.error || !$json.details) {\n  f.what = 'New proceeding (details could not be loaded - open KRZ)';\n  return { json: f };\n}\nf.what = d.rodzajPostepowania?.tytul || 'Proceeding';\nf.status = d.stanPostepowaniaRejestr?.tytul || '';\nf.reference = d.sygnaturaAkt || '';\nf.date = d.dataRozpoczecia || '';\nreturn { json: f };"
      },
      "typeVersion": 2
    },
    {
      "id": "09a2584f-313d-46d9-b2bd-ff3f83cd05d1",
      "name": "Shape MSiG notices",
      "type": "n8n-nodes-base.code",
      "position": [
        1280,
        20
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const src = $('Only valid identifiers').item.json;\nconst id = src.krs || src.nip;\nif ($json.error) {\n  return { json: { company: src.company, identifier: id, source: 'MSiG', what: 'Check could not be completed - re-run', status: String($json.error).slice(0, 200), reference: '', date: $now.toFormat('yyyy-MM-dd'), link: '', dedupeKey: 'MSIG-ERROR|' + id + '|' + $execution.id } };\n}\nreturn { json: {\n  company: src.company || $json.entityName,\n  identifier: id,\n  source: 'MSiG',\n  what: String($json.chapterName || 'Court gazette notice').replace(/\\s+/g, ' ').slice(0, 140),\n  status: String($json.textInBody || $json.textInPosition || '').replace(/\\s+/g, ' ').slice(0, 300),\n  reference: 'MSiG ' + ($json.monitorNumber || '') + (($json.numberOfNotice) ? ', item ' + $json.numberOfNotice : ''),\n  date: String($json.dateOfPublication || '').slice(0, 10),\n  link: $json.issuePdfUrl || 'https://wyszukiwarka-msig.ms.gov.pl/',\n  dedupeKey: 'MSIG|' + ($json.id || $json.monitorNumber + '/' + $json.numberOfNotice),\n} };"
      },
      "typeVersion": 2
    },
    {
      "id": "8be997cc-0dc7-4534-bd54-a2089ce445c5",
      "name": "New MSiG notices only",
      "type": "n8n-nodes-base.removeDuplicates",
      "position": [
        1480,
        20
      ],
      "parameters": {
        "options": {
