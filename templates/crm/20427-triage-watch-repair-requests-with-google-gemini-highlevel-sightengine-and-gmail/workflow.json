    {
      "id": "5fd80950-f224-44e6-b835-d7fa4c2be9a3",
      "name": "Rebuild Photo Binary Data",
      "type": "n8n-nodes-base.code",
      "position": [
        736,
        -416
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Rebuild the item: form fields + GHL contact id + the watch photo as binary 'data'\nconst form = $('When Form Submitted').item;\nconst bin = form.binary || {};\nconst key = Object.keys(bin)[0];\nconst base = $('Set Customer Info Fields').item.json;\nconst contact = $json.contact || $json;\nconst out = { json: { ...base, ghl_contact_id: contact.id || null }, binary: {} };\nif (key) out.binary.data = bin[key];\nreturn out;"
      },
      "typeVersion": 2
    },
