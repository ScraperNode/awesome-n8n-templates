    {
      "id": "93c8d13c-744e-423b-b499-f69ef9db685d",
      "name": "Retrieve Email Content",
      "type": "n8n-nodes-base.gmail",
      "maxTries": 4,
      "position": [
        700,
        440
      ],
      "parameters": {
        "simple": false,
        "options": {},
        "messageId": "={{ $json.id }}",
        "operation": "get"
      },
      "retryOnFail": true,
      "typeVersion": 2.1,
      "waitBetweenTries": 3000
    },
    {
      "id": "82494aa6-85c2-4d60-8d40-ee1d6893050d",
      "name": "Process Email Content",
      "type": "n8n-nodes-base.code",
      "position": [
        1000,
        440
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const m = $json;\nconst from = m.from?.value?.[0] ?? {};\nconst body = String(m.text || (m.html || '').replace(/<[^>]+>/g, ' ')).replace(/\\s+\\n/g, '\\n').replace(/[ \\t]+/g, ' ').trim().slice(0, 6000);\nconst prompt = `From: {from}\nSubject: {subject}\nDate: {date}\n\n{body}`.replace('{from}', (from.name ? from.name + ' <' + from.address + '>' : from.address) || '').replace('{subject}', m.subject || '').replace('{date}', m.date || '').replace('{body}', body);\nreturn { json: { id: m.id, threadId: m.threadId, sender_email: from.address || '', sender_name: from.name || from.address || '', subject: m.subject || '', date: m.date || new Date().toISOString(), prompt } };"
      },
      "typeVersion": 2
    },
    {
      "id": "fcfa1bfd-fbf7-4b7e-ae01-cda92d631f2e",
      "name": "Classify Email with Gemini",
      "type": "@n8n/n8n-nodes-langchain.googleGemini",
      "onError": "continueErrorOutput",
      "maxTries": 4,
      "position": [
        1400,
        440
      ],
      "parameters": {
        "modelId": {
          "__rl": true,
          "mode": "id",
          "value": "models/gemini-flash-lite-latest"
        },
        "options": {
          "temperature": 0.2,
          "systemMessage": "=You are the email assistant of {{ $('Set Email Parameters').first().json.your_name }} ({{ $('Set Email Parameters').first().json.business }}). You read an email they received and return ONLY a JSON object with these keys:\n- \"category\": one of client (a client or someone who wants to hire them), quote (a quote is requested or sent), invoice (an invoice or receipt to pay or keep), supplier (a supplier), admin (banks, tax office, social security, accountant, insurance, paperwork), newsletter (newsletters, promotions, automatic notifications), other.\n- \"urgent\": true only if something must be done TODAY (a deadline, a payment due, a client waiting for something urgent).\n- \"summary\": one sentence in English saying what they want and what has to be done.\n- \"needs_reply\": true only if a person wrote it and expects an answer. Never for newsletters, automatic notifications, receipts or \"no-reply\" emails.\n- \"reply\": if needs_reply is true, a reply draft in the language of the email, {{ $('Set Email Parameters').first().json.tone }} tone, short, signed as {{ $('Set Email Parameters').first().json.your_name }}. NEVER make up prices, dates, availability or commitments: if something is missing, leave it in [brackets] for {{ $('Set Email Parameters').first().json.your_name }} to fill in. If needs_reply is false, \"\".\n- \"invoice\": if category is invoice, an object with issuer, number, date (YYYY-MM-DD), net, vat, total (numbers, no symbol) and currency (EUR, USD\u2026); use null for anything missing. If it is not an invoice, null."
        },
        "messages": {
          "values": [
            {
              "content": "={{ $('Process Email Content').item.json.prompt }}"
            }
          ]
        },
        "resource": "text",
        "simplify": true,
        "operation": "message",
        "jsonOutput": true
      },
      "retryOnFail": true,
      "typeVersion": 1,
      "waitBetweenTries": 3000
    },
    {
      "id": "a415e666-d66f-4c1c-9297-fd0b353a5279",
      "name": "Backup Classify with Gemini",
      "type": "@n8n/n8n-nodes-langchain.googleGemini",
      "onError": "continueRegularOutput",
      "maxTries": 4,
      "position": [
        1400,
        690
      ],
      "parameters": {
        "modelId": {
          "__rl": true,
          "mode": "id",
          "value": "models/gemini-flash-latest"
        },
        "options": {
          "temperature": 0.2,
          "systemMessage": "=You are the email assistant of {{ $('Set Email Parameters').first().json.your_name }} ({{ $('Set Email Parameters').first().json.business }}). You read an email they received and return ONLY a JSON object with these keys:\n- \"category\": one of client (a client or someone who wants to hire them), quote (a quote is requested or sent), invoice (an invoice or receipt to pay or keep), supplier (a supplier), admin (banks, tax office, social security, accountant, insurance, paperwork), newsletter (newsletters, promotions, automatic notifications), other.\n- \"urgent\": true only if something must be done TODAY (a deadline, a payment due, a client waiting for something urgent).\n- \"summary\": one sentence in English saying what they want and what has to be done.\n- \"needs_reply\": true only if a person wrote it and expects an answer. Never for newsletters, automatic notifications, receipts or \"no-reply\" emails.\n- \"reply\": if needs_reply is true, a reply draft in the language of the email, {{ $('Set Email Parameters').first().json.tone }} tone, short, signed as {{ $('Set Email Parameters').first().json.your_name }}. NEVER make up prices, dates, availability or commitments: if something is missing, leave it in [brackets] for {{ $('Set Email Parameters').first().json.your_name }} to fill in. If needs_reply is false, \"\".\n- \"invoice\": if category is invoice, an object with issuer, number, date (YYYY-MM-DD), net, vat, total (numbers, no symbol) and currency (EUR, USD\u2026); use null for anything missing. If it is not an invoice, null."
        },
        "messages": {
          "values": [
            {
              "content": "={{ $('Process Email Content').item.json.prompt }}"
            }
          ]
        },
        "resource": "text",
        "simplify": true,
        "operation": "message",
        "jsonOutput": true
      },
      "retryOnFail": true,
      "typeVersion": 1,
      "waitBetweenTries": 3000
    },
    {
      "id": "af019568-5c7d-4a8c-bedd-5e59ff942923",
      "name": "Analyze Classification Result",
      "type": "n8n-nodes-base.code",
      "position": [
        1750,
        440
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const CATEGORIES = [\"client\",\"quote\",\"invoice\",\"supplier\",\"admin\",\"newsletter\",\"other\"];\nconst LABELS = {\"client\":\"Clients\",\"quote\":\"Quotes\",\"invoice\":\"Invoices\",\"supplier\":\"Suppliers\",\"admin\":\"Admin\",\"newsletter\":\"Newsletters\",\"other\":\"Other\"};\nconst email = $('Process Email Content').item.json;\nconst s = $json;\nlet raw = s.content?.parts?.[0]?.text ?? s.text ?? s.message?.content ?? (typeof s.content === 'string' ? s.content : '') ?? '';\nif (typeof raw !== 'string') raw = JSON.stringify(raw);\nlet a = {};\ntry { a = JSON.parse(raw.replace(/^```(?:json)?|```$/gm, '').trim()); } catch (e) { a = {}; }\nif (Array.isArray(a)) a = a[0] ?? {};\nconst category = CATEGORIES.includes(a.category) ? a.category : 'other';\nconst needsReply = a.needs_reply === true && typeof a.reply === 'string' && a.reply.trim().length > 0;\nconst inv = category === 'invoice' && a.invoice && typeof a.invoice === 'object' ? a.invoice : null;\nreturn { json: { ...email, category, label: 'AI/' + LABELS[category], urgent: a.urgent === true, summary: String(a.summary || email.subject || '').slice(0, 300),\n  needs_reply: needsReply, reply: needsReply ? a.reply.trim() : '', invoice: inv, understood: Object.keys(a).length > 0 } };"
      },
      "typeVersion": 2
    },
    {
      "id": "9707bb1d-46ce-4103-b919-c84af45adb9a",
      "name": "Select Appropriate Label",
      "type": "n8n-nodes-base.code",
      "position": [
        2150,
        0
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const labels = $('Fetch Gmail Labels').all().map(i => i.json);\nconst found = labels.find(x => x.name === $json.label);\nreturn { json: { label: $json.label, label_id: found?.id ?? '' } };"
      },
      "typeVersion": 2
    },
