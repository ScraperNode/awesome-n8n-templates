    {
      "id": "c7c2e917-74de-40e8-920c-c761ada305a4",
      "name": "Run summary",
      "type": "n8n-nodes-base.code",
      "position": [
        4840,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const d=$('Prepare delivery').first().json;return [{json:{runId:d.runId,observedRows:d.observedRows,savedRows:d.rows.length,baseline:d.baseline,newIds:d.newIds,coverage:d.coverage,deliveryMode:'sheets-only',note:'No notification sent. First-seen IDs do not establish publication time.'}}];"
      },
