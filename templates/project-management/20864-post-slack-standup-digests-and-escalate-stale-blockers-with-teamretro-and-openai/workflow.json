    },
    {
      "id": "tr1600-0000-0000-0000-000000000016",
      "name": "Parse the Result",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "position": [
        1860,
        520
      ],
      "parameters": {
        "schemaType": "manual",
        "inputSchema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"headline\": {\n      \"type\": \"string\"\n    },\n    \"highlights\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"string\"\n      }\n    },\n    \"watchouts\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"string\"\n      }\n    }\n  },\n  \"required\": [\n    \"headline\",\n    \"highlights\",\n    \"watchouts\"\n  ]\n}"
      },
      "typeVersion": 1.2
    },
    {
      "id": "tr1600-0000-0000-0000-000000000017",
      "name": "Compose the Messages",
      "type": "n8n-nodes-base.code",
      "position": [
        2200,
        300
      ],
      "parameters": {
        "jsCode": "const esc = (text) => String(text).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\nconst s = $('Prepare the Standup').first().json;\nconst { headline, highlights = [], watchouts = [] } = $input.first().json.output;\nconst day = DateTime.fromISO(s.date).toFormat('cccc d LLLL');\nconst bullet = (items) => items.map((item) => `\u2022 ${esc(item)}`).join('\\n');\nconst open = (b) => (b.standupsOpen > 1 ? ` _(open for ${b.standupsOpen} standups)_` : '');\n\nconst summary = [\n  `:clipboard: *${s.title} \u2014 ${s.team}* \u00b7 ${day} \u00b7 ${s.people} posted`,\n  esc(headline),\n  highlights.length ? `*Highlights*\\n${bullet(highlights)}` : null,\n  `*Blockers*\\n${s.blockers.length ? s.blockers.map((b) => `\u2022 *${b.name}:* ${b.text}${open(b)}`).join('\\n') : '\u2022 None today'}`,\n  watchouts.length ? `*Watch out for*\\n${bullet(watchouts)}` : null,\n  \"_Everyone's updates are in the thread._\",\n].filter(Boolean).join('\\n\\n');\n\nconst alert = s.staleBlockers.length\n  ? [`:rotating_light: *Blockers still open at the ${s.team} standup* \u00b7 ${day}`,\n     ...s.staleBlockers.map((b) => `\u2022 *${b.name}:* ${b.text} _(open for ${b.standupsOpen} standups)_`)].join('\\n')\n  : '';\n\nreturn [{ json: { summary, details: s.details, alert } }];"
      },
      "typeVersion": 2
    },
