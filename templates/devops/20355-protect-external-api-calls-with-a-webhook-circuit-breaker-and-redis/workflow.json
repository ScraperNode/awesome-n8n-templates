    {
      "id": "e5ec7afd-0e70-40d7-8fd9-1926a0e2e80a",
      "name": "JS - Resolve Service",
      "type": "n8n-nodes-base.code",
      "position": [
        -160,
        992
      ],
      "parameters": {
        "jsCode": "const cfg = $input.first().json;\nconst registry = cfg.serviceRegistry || {};\nconst name = String(cfg.serviceName || '');\nconst svc = Object.prototype.hasOwnProperty.call(registry, name) ? registry[name] : null;\n\nconst rawPath = String(cfg.requestPath || '');\nconst pathOk = rawPath === '' || (rawPath.startsWith('/') && !rawPath.startsWith('//') && !rawPath.includes('..') && !rawPath.includes('://'));\n\nconst serviceKnown = !!svc && pathOk;\nconst safeName = name.replace(/[^a-zA-Z0-9_-]/g, '');\n\nreturn [{\n  json: {\n    ...cfg,\n    serviceKnown,\n    unknownReason: !svc ? 'unknown_service' : (!pathOk ? 'invalid_path' : null),\n    targetUrl: svc ? String(svc.baseUrl).replace(/\\/$/, '') + rawPath : null,\n    failureThreshold: svc?.failureThreshold ?? cfg.failureThreshold,\n    openDurationSeconds: svc?.openDurationSeconds ?? cfg.openDurationSeconds,\n    stateKey: `cb:${safeName}:state`,\n    failuresKey: `cb:${safeName}:failures`\n  }\n}];"
      },
      "typeVersion": 2
    },
