      "webhookId": "af83f558-af9a-4344-8bde-a3513f7866a9",
      "parameters": {
        "sendTo": "={{ $('Match Client to Meeting').item.json.clientEmail }}",
        "message": "={{ $json.html }}",
        "options": {
          "ccList": "={{ $('Match Client to Meeting').item.json.coachEmail }}",
          "appendAttribution": false
        },
        "subject": "={{ $json.subject }}"
      },
      "typeVersion": 2.1
    },
    {
      "id": "2d93ba68-776c-43a3-a6ae-585e49698266",
