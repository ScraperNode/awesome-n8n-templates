        "message": "={{ (() => { const e = s => String(s ?? '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;'); return '<p><strong>New lead notification</strong></p><p><strong>Name:</strong> ' + e($json.leadName) + '<br/><strong>Email:</strong> ' + e($json.leadEmail) + '<br/><strong>Company:</strong> ' + e($json.leadCompany) + '<br/><strong>Service:</strong> ' + e($json.leadService) + '</p><p><strong>Message:</strong><br/>' + e($json.leadMessage) + '</p><p style=\"color:#888;font-size:12px\">Lead ID: ' + e($json.leadId) + ' \u00b7 Execution ID: ' + e($json.executionId) + '</p>'; })() }}",
