      "parameters": {
        "color": 7,
        "width": 640,
        "height": 560,
        "content": "## 3. Reply to the customer\nMissing details: the customer gets a list of what to send. Complete: a confirmation.\nReplies land in your Gmail inbox. The workflow does not read them: update the row yourself."
      },
      "typeVersion": 1
    },
