    {
      "id": "d7064b7f-7941-448e-a6fa-54eabc517b86",
      "name": "Write the posts with an AI agent",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "position": [
        900,
        0
      ],
      "parameters": {
        "text": "={{ 'Topic: ' + $('Only text topics').item.json.message.text.trim() + '\\n\\nBrand rules:\\n' + ($json.content || 'No brand rules yet: write in a clear, friendly, professional voice.') }}",
        "options": {
          "maxIterations": 6,
          "systemMessage": "You are the social media writer of a brand. Follow the brand rules in the message exactly: voice, audience, words to avoid.\nWhen the topic needs current facts, search Google once or twice and use only what you find. Never invent facts, numbers, quotes or links.\nAnswer with one JSON object and nothing else, with these keys:\n- linkedin: 3 short paragraphs, professional, no hashtags.\n- facebook: 1 or 2 conversational sentences.\n- bluesky: up to 280 characters, no hashtags.\n- mastodon: up to 450 characters with 2 hashtags.\n- sources: an array with the URLs you used (empty when you did not search)."
        },
        "promptType": "define"
      },
      "typeVersion": 3.1
    },
