    {
      "id": "ed51d066-9300-4dc9-b6dd-acf915dcfb69",
      "name": "Get card URL",
      "type": "n8n-nodes-base.code",
      "position": [
        1060,
        320
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// The Orshot node returns the API response under data, and the API wraps the render in data again.\n// A failed render comes back as { error } because the step continues on error.\nconst res = $json.data?.data ?? $json.data;\nconst page = Array.isArray(res) ? res[0] : res;\nconst image = page?.content || '';\nreturn { json: { image, error: image ? '' : String($json.error || 'Orshot returned no image URL') } };"
      },
      "typeVersion": 2
    },
