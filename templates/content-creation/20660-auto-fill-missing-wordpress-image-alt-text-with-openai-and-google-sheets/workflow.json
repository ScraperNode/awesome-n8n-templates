    {
      "id": "b8c0c008-0000-4000-8000-000000000002",
      "name": "ChainLlm: Generate Alt Text",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "position": [
        3500,
        200
      ],
      "parameters": {
        "text": "=Write alt text for the attached image from a WordPress media library.\n\nOutput language: {{ $('Set Config Parameters').first().json.alt_language }}\nMedia title: {{ $('Set Media Item Fields').item.json.media_title || '(none)' }}\nFile name: {{ $('Set Media Item Fields').item.json.filename }}\nPost/page where the image is used: {{ $('Build Context Data').item.json.parent_title || '(not attached to any post)' }}\nPost excerpt: {{ $('Build Context Data').item.json.parent_excerpt || '(none)' }}\n\nRules:\n- Describe what the image shows AND what it means in the context of the post, not just a generic list of objects.\n- Maximum {{ $('Set Config Parameters').first().json.max_alt_length }} characters.\n- Do not start with \"Image of\", \"Photo of\", \"Picture of\" or the equivalent in the output language.\n- Do not invent names, places, products or brands that are neither visible in the image nor stated in the context.\n- If the image contains meaningful text (headline, label, chart title), include it.\n- If the image is purely decorative (divider, background texture, spacer, abstract pattern), set is_decorative to true and alt_text to an empty string.\n- confidence: 0 to 1, how sure you are that the alt text is accurate.",
        "messages": {
          "messageValues": [
            {
              "message": "You are an accessibility and SEO specialist who writes concise, accurate alt text that follows WCAG guidance."
            },
            {
              "type": "HumanMessagePromptTemplate",
              "imageDetail": "low",
              "messageType": "imageBinary",
              "binaryImageDataKey": "data"
            }
          ]
        },
        "promptType": "define",
        "hasOutputParser": true
      },
      "typeVersion": 1.5
    },
    {
      "id": "b8c0c008-0000-4000-8000-000000000003",
      "name": "OpenAI Chat Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "position": [
        3440,
        420
      ],
      "parameters": {
        "model": {
          "__rl": true,
          "mode": "list",
          "value": "gpt-4o-mini",
          "cachedResultName": "gpt-4o-mini"
        },
        "options": {
          "temperature": 0.2
        }
