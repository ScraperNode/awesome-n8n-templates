    {
      "id": "b5e32b1e-7971-4b61-b19f-959f0b21ff0a",
      "name": "Build Event Times - Code",
      "type": "n8n-nodes-base.code",
      "position": [
        1040,
        940
      ],
      "parameters": {
        "jsCode": "// Turn the AI's preferred_time into a 1-hour calendar slot.\nconst d = $input.first().json;\nlet start = new Date(d.preferred_time);\nif (isNaN(start)) start = new Date(Date.now() + 24 * 3600 * 1000); // fallback: tomorrow\nconst end = new Date(start.getTime() + 3600 * 1000);\nreturn [{ json: { ...d, start: start.toISOString(), end: end.toISOString() } }];"
      },
      "typeVersion": 2
    },
