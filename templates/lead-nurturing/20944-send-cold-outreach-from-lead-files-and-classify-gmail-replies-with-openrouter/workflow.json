        "jsCode": "const messages = []\n\nfor (const item of $input.all().reverse()) {\n  messages.push({\n    sender: item.json.inbox_type === 'received' ? 'User' : 'System',\n    title: item.json.title,\n    content: item.json.content\n  })\n}\n\nreturn {\n  messages,\n};"
