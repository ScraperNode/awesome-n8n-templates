    {
      "id": "a203eb6d-2b2a-4f0c-b496-8db202b3eb56",
      "name": "Verify Files on Google Drive",
      "type": "n8n-nodes-base.httpRequest",
      "position": [
        3232,
        400
      ],
      "parameters": {
        "url": "https://www.googleapis.com/drive/v3/files",
        "options": {},
        "sendQuery": true,
        "authentication": "predefinedCredentialType",
        "queryParameters": {
          "parameters": [
            {
              "name": "q",
              "value": "={{ \"'\" + $json.id + \"' in parents and trashed = false and mimeType != 'application/vnd.google-apps.folder'\" }}"
            },
            {
              "name": "pageSize",
              "value": "1"
            },
            {
              "name": "fields",
              "value": "files(id,name)"
            }
          ]
        },
        "nodeCredentialType": "googleDriveOAuth2Api"
      },
      "typeVersion": 4.5
    },
    {
      "id": "d0b656e2-4989-4863-ad21-d67f13cf283a",
      "name": "Assess Folder Submission",
      "type": "n8n-nodes-base.code",
      "position": [
        3472,
        400
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const folder = $('Select Client Folders').item.json;\n\nconst files = Array.isArray($json.files)\n  ? $json.files\n  : [];\n\nconst hasFile = files.length > 0;\n\nreturn {\n  json: {\n    folder_id: folder.id,\n    folder_name: folder.name,\n    submitted: hasFile,\n    client_name: folder.client_name,\n    chatwork_room_id: folder.chatwork_room_id\n  }\n};"
      },
      "typeVersion": 2
    },
    {
      "id": "8de1695b-4087-44b7-8131-74d80cee45d7",
      "name": "Compile Missing Documents",
      "type": "n8n-nodes-base.code",
      "position": [
        3680,
        400
      ],
      "parameters": {
        "jsCode": "const missingFolders = items\n  .filter(item => item.json.submitted === false)\n  .map(item => item.json.folder_name);\n\n// \u4eca\u51e6\u7406\u3057\u3066\u3044\u308b\u9867\u5ba2\u60c5\u5831\u3092\u3001\n// Check Submission Status \u306e\u7d50\u679c\u304b\u3089\u53d6\u5f97\nconst clientName = items[0].json.client_name;\nconst chatworkRoomId = items[0].json.chatwork_room_id;\n\nconst targetMonth =\n  $('Compute Last Month').first().json.target_month_prefix;\n\nreturn [\n  {\n    json: {\n      client_name: clientName,\n      chatwork_room_id: chatworkRoomId,\n      target_month: targetMonth,\n      missing_folders: missingFolders,\n      missing_count: missingFolders.length,\n      all_submitted: missingFolders.length === 0\n    }\n  }\n];"
      },
      "typeVersion": 2
    },
    {
      "id": "6198a19e-7703-4dc2-8fa5-7b2e5465bcfe",
      "name": "Check Missing Documents",
      "type": "n8n-nodes-base.if",
      "position": [
        3920,
        400
      ],
      "parameters": {
        "options": {},
        "conditions": {
          "options": {
            "version": 3,
            "leftValue": "",
            "caseSensitive": true,
            "typeValidation": "strict"
          },
          "combinator": "and",
          "conditions": [
            {
              "id": "2b4f9d59-553b-471b-8496-597138224520",
              "operator": {
                "type": "number",
                "operation": "gt"
              },
              "leftValue": "={{ $json.missing_count }}",
              "rightValue": 0
            }
          ]
        }
      },
      "typeVersion": 2.3
    },
    {
      "id": "9ff3fc62-9a29-4b32-9627-df3cbeb7a221",
