    {
      "id": "9e02113f-f904-4bfc-8e1a-88ada332ab26",
      "name": "Verify HubSpot signature",
      "type": "n8n-nodes-base.code",
      "position": [
        640,
        512
      ],
      "parameters": {
        "jsCode": "const crypto = require('crypto');\n\n// 1\ufe0f\u20e3 HubSpot app client secret (set in the \"Set configuration\" node)\nconst clientSecret = $json.hubspotClientSecret;\n\n// 2\ufe0f\u20e3 Get raw body\nconst rawBody = $json.body\n  ? JSON.stringify($json.body)\n  : '';\n\n// 3\ufe0f\u20e3 Create SHA256 hash of clientSecret + body\nconst signature = crypto\n  .createHash('sha256')\n  .update(clientSecret + rawBody)\n  .digest('hex');\n\n// 4\ufe0f\u20e3 Get HubSpot header signature\nconst hubspotSignature = $json.headers['x-hubspot-signature'];\n\n// 5\ufe0f\u20e3 Compare\nreturn [\n  {\n    calculatedSignature: signature,\n    hubspotSignature,\n    isValid: signature === hubspotSignature\n  }\n];"
      },
      "typeVersion": 2
    },
