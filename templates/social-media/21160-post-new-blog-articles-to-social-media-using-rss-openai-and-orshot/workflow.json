    {
      "id": "8cf4fcb9-bf7a-4188-b033-b2ec327d9a9a",
      "name": "Collect post links",
      "type": "n8n-nodes-base.code",
      "position": [
        2200,
        265
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Reads each publish result. Any post that failed marks the row as Failed with the reason.\nconst steps = {\n  Instagram: 'Post to Instagram',\n  LinkedIn: 'Post to LinkedIn',\n  X: 'Post to X',\n  Facebook: 'Post to Facebook Page',\n};\n\n// A publish step returns { status, platforms: [{ platform, status, url, error }] }, or { error }.\n// status is published, processing (Instagram and TikTok finish a moment later), drafted, scheduled, partial or failed.\nconst read = node => {\n  let r;\n  try { r = $(node).item.json; } catch (e) { return null; } // step deleted or not run\n  if (!r) return null;\n  if (r.error) return { error: r.error.message || r.error };\n  const p = (r.platforms || [])[0] || {};\n  return { status: r.status || p.status, url: p.url, error: p.error };\n};\nconst ok = e => ['published', 'processing', 'drafted', 'scheduled'].includes(String(e.status || '').toLowerCase());\n\nconst links = {};\nconst errors = [];\nconst statuses = new Set();\nfor (const [label, node] of Object.entries(steps)) {\n  const e = read(node);\n  if (!e) continue;\n  links[label] = e.url || '';\n  statuses.add(String(e.status || '').toLowerCase());\n  if (!ok(e)) errors.push(`${label}: ${e.error || 'not published'}`);\n}\nconst held = statuses.size > 0 && [...statuses].every(s => s === 'drafted');\n\nconst post = $('Map post fields').item.json;\nconst card = $('Get card URL').item.json;\nreturn {\n  json: {\n    title: post.title,\n    link: post.link,\n    image: card.image,\n    ...links,\n    status: errors.length ? 'Failed' : held ? 'Saved as draft' : 'Posted',\n    error: errors.join(' | '),\n  },\n};"
      },
      "typeVersion": 2
    },
