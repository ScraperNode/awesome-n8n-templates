    {
      "id": "54521483-39bb-43a8-8177-e15d556405a8",
      "name": "Filter Due - Code",
      "type": "n8n-nodes-base.code",
      "position": [
        780,
        420
      ],
      "parameters": {
        "jsCode": "// Quote rows: { quote_id, name, phone, email, amount, sent_date, touch_count, status, opted_out }\n// Touch schedule: 0 -> +2 days (email), 1 -> +7 days (SMS), 2 -> +14 days (final SMS)\nconst now = new Date();\nconst DAY = 86400000;\nconst SCHEDULE = [2, 7, 14];\nconst due = [];\nfor (const item of $input.all()) {\n  const q = item.json;\n  if (String(q.status).toLowerCase() !== 'open') continue;\n  if (String(q.opted_out).toLowerCase() === 'yes') continue;\n  const t = Number(q.touch_count || 0);\n  if (t >= 3) continue;\n  const sent = new Date(q.sent_date || 0);\n  if ((now - sent) / DAY >= SCHEDULE[t]) due.push({ json: { ...q, touch: t } });\n}\nreturn due;"
      },
      "typeVersion": 2
    },
