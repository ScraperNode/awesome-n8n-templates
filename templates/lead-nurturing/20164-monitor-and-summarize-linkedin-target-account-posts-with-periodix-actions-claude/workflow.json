    {
      "id": "57440e03-3e3a-40bb-a7a0-1267252e4bc2",
      "name": "Keep New Posts",
      "type": "n8n-nodes-base.code",
      "position": [
        2944,
        352
      ],
      "parameters": {
        "jsCode": "const acc = $('Current Account').first().json;\nconst cfg = $('Monitor Config').first().json;\nconst seen = new Set($('Read Seen Posts').all().map(r => String(r.json.post_id || '')).filter(Boolean));\nconst cutoff = Date.now() - (Number(cfg.max_age_days) || 3) * 86400000;\nconst out = [];\nfor (const it of $input.all()) {\n  const p = it.json || {};\n  const id = String(p.id || p.social_id || '');\n  if (!id || seen.has(id)) continue;\n  if (p.is_repost && !cfg.include_reposts) continue;\n  const when = Date.parse(p.parsed_datetime || '');\n  if (when && when < cutoff) continue;\n  out.push({ json: {\n    post_id: id,\n    social_id: p.social_id || '',\n    account_name: acc.account_name || (p.author && p.author.name) || '',\n    linkedin_url: acc.linkedin_url,\n    post_url: p.share_url || '',\n    posted_at: p.parsed_datetime || '',\n    text: String(p.text || '').slice(0, 3000),\n    reactions: p.reaction_counter || 0,\n    comments: p.comment_counter || 0,\n    reposts: p.repost_counter || 0\n  } });\n}\nif (!out.length) return [{ json: { post_id: '' } }];\nreturn out;"
      },
      "typeVersion": 2
    },
