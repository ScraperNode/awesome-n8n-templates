    {
      "id": "556f08ad-004d-4aee-8978-900e60cd2618",
      "name": "Record STOP/START and classify reply",
      "type": "n8n-nodes-base.code",
      "position": [
        440,
        400
      ],
      "parameters": {
        "jsCode": "const b = $('Twilio incoming SMS webhook').first().json.body || {};\nconst from = b.From || ''; const text = String(b.Body || '').trim().toUpperCase();\nconst sd = $getWorkflowStaticData('global'); sd.optOut = sd.optOut || [];\nlet action = 'reply';\nif (['STOP','STOPALL','UNSUBSCRIBE','CANCEL','END','QUIT','ARRET','ARR\u00caT'].includes(text)) { if (!sd.optOut.includes(from)) sd.optOut.push(from); action = 'stop'; }\nelse if (['START','UNSTOP'].includes(text)) { sd.optOut = sd.optOut.filter(x => x !== from); action = 'start'; }\nreturn [{ json: { from, body: b.Body || '', action, isReply: action === 'reply' } }];"
      },
      "typeVersion": 2
    },
