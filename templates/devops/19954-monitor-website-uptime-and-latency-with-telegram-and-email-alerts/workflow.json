      "parameters": {
        "jsCode": "const notification = $input.first().json;\nif (notification.enable_telegram) {\n  const id = notification.telegram_chat_id;\n  if (typeof id !== 'string' || !/^-?[1-9]\\d*$/.test(id) ||\n      !Array.isArray(notification.telegram_allowed_chat_ids) || !notification.telegram_allowed_chat_ids.includes(id)) {\n    throw new Error('Telegram configuration invalid: use a numeric chat ID string and include it in telegram_allowed_chat_ids.');\n  }\n}\nif (notification.enable_email &&\n    (![notification.email_from, notification.email_to].every(value =>\n      typeof value === 'string' && /^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(value)))) {\n  throw new Error('Email configuration invalid: provide one valid sender and recipient address.');\n}\n\nconst monitors = JSON.parse($('Validate Website List').first().json.monitors_json || '[]');\nif (!Array.isArray(monitors)) throw new Error('Invalid saved monitor list. Check Configure Website List parameters.');\nreturn monitors.map(m => ({json: {...m, ...notification}}));"
      },
