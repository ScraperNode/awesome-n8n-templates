        336,
        336
      ],
      "parameters": {
        "color": 7,
        "width": 528,
        "height": 384,
        "content": "## Start organisation loop\n\nStarts the scheduled run, reads organisations from Airtable, and begins iterating through them one at a time."
      },
      "typeVersion": 1
    },
