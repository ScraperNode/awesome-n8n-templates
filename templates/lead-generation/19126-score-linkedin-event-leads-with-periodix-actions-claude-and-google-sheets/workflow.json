    {
      "id": "49544ba1-8eaf-44b5-974a-2b3c7b7f43d7",
      "name": "Parse Note",
      "type": "n8n-nodes-base.code",
      "position": [
        2640,
        272
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const person = $('Parse Score').item.json;\nlet note = '';\ntry {\n  let raw = $json.content?.[0]?.text || '{}';\n  raw = raw.trim().replace(/^```(?:json)?\\s*/i, '').replace(/```\\s*$/i, '').trim();\n  note = JSON.parse(raw).note || '';\n} catch (e) {}\nreturn { json: { ...person, connection_note: note } };"
      },
      "typeVersion": 2
    },
