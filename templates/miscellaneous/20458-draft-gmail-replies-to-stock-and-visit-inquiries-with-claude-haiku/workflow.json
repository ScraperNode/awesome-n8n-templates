      "webhookId": "8f67c930-8bdc-4773-8c6f-0cc663827e87",
      "parameters": {
        "message": "={{ $json.text }}",
        "options": {
          "sendTo": "={{ $(\"Loop over emails\").first().json.from.value[0].address }}",
