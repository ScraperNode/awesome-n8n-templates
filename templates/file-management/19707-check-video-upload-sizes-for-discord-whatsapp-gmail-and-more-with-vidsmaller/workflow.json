    {
      "id": "173b1160-7f8e-47d5-af58-946e87cdbe6e",
      "name": "Get file size (HEAD)",
      "type": "n8n-nodes-base.httpRequest",
      "onError": "continueRegularOutput",
      "position": [
        -400,
        240
      ],
      "parameters": {
        "url": "={{ $json.url }}",
        "method": "HEAD",
        "options": {
          "timeout": 20000,
          "redirect": {
            "redirect": {
              "followRedirects": true
            }
          },
          "response": {
            "response": {
              "neverError": true,
              "fullResponse": true
            }
          }
        }
      },
      "typeVersion": 4.2
    },
    {
      "id": "89f62eda-569f-44e3-945e-65900ace01cd",
      "name": "Read Content-Length",
      "type": "n8n-nodes-base.code",
      "position": [
        -180,
        240
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Read the size out of the HEAD response, without ever downloading the file.\n//\n// A HEAD request asks the server for the headers it would send for a GET and\n// then stops, so this costs a few hundred bytes per video instead of hundreds\n// of megabytes. Content-Length is the file size in bytes.\n//\n// Not every server sends one: chunked responses, some CDNs and most\n// redirect-to-signed-URL setups answer without it. That is a real outcome, not\n// an error, so it is reported rather than thrown - the workflow routes those\n// videos to their own branch instead of failing the whole batch.\n\nconst source = $('Split out videos').item.json;\nconst response = $input.item.json;\n\nconst headers = response.headers || {};\nconst status = Number(response.statusCode) || 0;\nconst contentLength = headers['content-length'] ?? headers['Content-Length'];\nconst sizeBytes = Number(contentLength);\n\nconst ok = status >= 200 && status < 400;\nconst readable = ok && Number.isFinite(sizeBytes) && sizeBytes > 0;\n\nlet reason = null;\nif (!ok) {\n  reason = `The server answered ${status || 'nothing'} for a HEAD request.`;\n} else if (!readable) {\n  reason = 'The server sent no Content-Length header, so the size is unknown.';\n}\n\nreturn {\n  json: {\n    label: source.label || source.url,\n    url: source.url,\n    platform: source.platform || 'discord',\n    durationSeconds: source.durationSeconds ?? null,\n    contentType: headers['content-type'] ?? null,\n    httpStatus: status,\n    sizeBytes: readable ? sizeBytes : null,\n    sizeMb: readable ? Math.round((sizeBytes / 1048576) * 10) / 10 : null,\n    sizeReadable: readable,\n    reason,\n  },\n};"
      },
      "typeVersion": 2
    },
    {
