    {
      "id": "9444999a-a970-4ea3-a3e1-32939c217d2e",
      "name": "Parse Photo Analysis JSON",
      "type": "n8n-nodes-base.code",
      "position": [
        2416,
        464
      ],
      "parameters": {
        "jsCode": "const text = $input.first().json.content.parts[0].text;\n\nconst data = JSON.parse(text);\n\nif (\n  data.date === \"+1234567890\" ||\n  data.date === 0 ||\n  data.date === \"0\"\n) {\n  data.date = null;\n}\n\nreturn [{ json: data }];"
      },
      "typeVersion": 2
    },
