      "parameters": {
        "actorId": {
          "__rl": true,
          "mode": "id",
          "value": "bBoEDhBBfWHh82dce"
        },
        "operation": "Run actor and get dataset",
        "customBody": "={{ JSON.stringify(Object.fromEntries(Object.entries({\n  start_urls: [],\n  vehicle_type: 'cars',\n  makes: $json.makes.split(',').map(s => s.trim()).filter(Boolean),\n  models: $json.models.split(',').map(s => s.trim()).filter(Boolean),\n  price_to: $json.priceTo || null,\n  mileage_to_km: $json.mileageToKm || null,\n  model_year_from: $json.modelYearFrom || null,\n  postal_code: $json.postalCode.trim() || null,\n  radius_km: $json.postalCode.trim() && $json.radiusKm ? String($json.radiusKm) : null,\n  seller_type: $json.sellerType.trim() ? [$json.sellerType.trim().toLowerCase()] : [],\n  listed_within_days: $json.listedWithinDays || 1,\n  sort_by: 'age',\n  max_items: $json.maxCars\n}).filter(([k, v]) => v !== null && (k === 'start_urls' || !Array.isArray(v) || v.length > 0)))) }}",
        "actorSource": "store"
      },
      "typeVersion": 1
    },
