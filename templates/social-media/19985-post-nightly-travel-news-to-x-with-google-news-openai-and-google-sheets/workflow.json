    {
      "id": "db42f173-a490-492e-b1f4-911cf12d2bdc",
      "name": "\u76f4\u8fd112h\u30d5\u30a3\u30eb\u30bf+\u30b9\u30b3\u30a2\u30ea\u30f3\u30b0",
      "type": "n8n-nodes-base.code",
      "position": [
        672,
        0
      ],
      "parameters": {
        "jsCode": "// \u76f4\u8fd112\u6642\u9593\u4ee5\u5185\u306e\u8a18\u4e8b\u306b\u7d5e\u308a\u3001\u4e00\u822c\u5c64\u5411\u3051\u306e\u30b9\u30b3\u30a2\u30ea\u30f3\u30b0\u3092\u884c\u3046\nconst now = Date.now();\nconst TWELVE_HOURS = 12 * 60 * 60 * 1000;\n\n// \u62fe\u3044\u305f\u3044\u30ad\u30fc\u30ef\u30fc\u30c9(\u512a\u5148\u5ea6\u3092\u4ed8\u3051\u308b)\nconst boostKeywords = ['\u304a\u5f97', '\u30bb\u30fc\u30eb', '\u30ad\u30e3\u30f3\u30da\u30fc\u30f3', '\u5272\u5f15', '\u6df7\u96d1', '\u904b\u4f11', '\u8b66\u5831', '\u9045\u5ef6', '\u898f\u5236', '\u904e\u53bb\u6700\u591a', '\u30d6\u30fc\u30e0', '\u4eba\u6c17', '\u6700\u9ad8\u5024', '\u5024\u4e0a\u3052', '\u7121\u6599'];\n// \u696d\u754c\u30c7\u30fc\u30bf\u7cfb\u30fb\u5c02\u9580\u7684\u3059\u304e\u308b\u3082\u306e\u306f\u9664\u5916\nconst excludeKeywords = ['\u53d6\u6271\u984d', '\u4e2d\u671f\u7d4c\u55b6\u8a08\u753b', 'IR', '\u6c7a\u7b97', '\u8abf\u67fb\u7d50\u679c', '\u5e02\u5834\u898f\u6a21', '\u63d0\u643a'];\n\nreturn items\n  .filter(item => {\n    const pub = new Date(item.json.isoDate || item.json.pubDate).getTime();\n    return now - pub <= TWELVE_HOURS;\n  })\n  .filter(item => {\n    const title = item.json.title || '';\n    return !excludeKeywords.some(k => title.includes(k));\n  })\n  .map(item => {\n    const title = item.json.title || '';\n    const score = boostKeywords.reduce((acc, k) => acc + (title.includes(k) ? 1 : 0), 0);\n    return { json: { ...item.json, score } };\n  })\n  .sort((a, b) => b.json.score - a.json.score);"
      },
      "typeVersion": 2
    },
    {
      "id": "d31d8d2f-aeab-4e1d-bfc2-a35b19c3afa2",
      "name": "\u65b0\u7740\u306e\u307f\u30d5\u30a3\u30eb\u30bf(Sheets\u57fa\u6e96\u30fb\u591c)",
      "type": "n8n-nodes-base.code",
      "position": [
        880,
        0
      ],
      "parameters": {
        "jsCode": "// \u300c\u76f4\u8fd112h\u30d5\u30a3\u30eb\u30bf+\u30b9\u30b3\u30a2\u30ea\u30f3\u30b0\u300d\u306e\u7d50\u679c\u3068\u3001Sheets\u306e\u6295\u7a3f\u6e08\u307f\u30ea\u30b9\u30c8\u3092\u76f4\u63a5\u53c2\u7167\u3057\u3066\u91cd\u8907\u9664\u53bb\nconst rssItems = $('\u76f4\u8fd112h\u30d5\u30a3\u30eb\u30bf+\u30b9\u30b3\u30a2\u30ea\u30f3\u30b0').all();\nconst postedRows = $('\u6295\u7a3f\u6e08\u307f\u4e00\u89a7\u3092\u53d6\u5f97(\u591c)').all();\n\nconst postedGuids = new Set(postedRows.map(row => row.json.guid).filter(Boolean));\nconst postedTitles = new Set(\n  postedRows.map(row => (row.json.title || '').replace(/[\\s\u3000]/g, '').toLowerCase()).filter(Boolean)\n);\n\nreturn rssItems.filter(item => {\n  const guid = item.json.guid || item.json.link;\n  const normTitle = (item.json.title || '').replace(/[\\s\u3000]/g, '').toLowerCase();\n  return !postedGuids.has(guid) && !postedTitles.has(normTitle);\n});"
      },
      "typeVersion": 2
    },
    {
      "id": "22863bb0-b581-4c6b-a752-6270a5b53f5c",
      "name": "\u4e0a\u4f4d2\u4ef6\u306b\u7d5e\u308b(\u591c)",
      "type": "n8n-nodes-base.code",
      "position": [
        1104,
        0
      ],
      "parameters": {
        "jsCode": "// \u591c\u306e\u6295\u7a3f\u306f\u6700\u59272\u4ef6\u3001\u30b9\u30b3\u30a2\u9806\u3067\u4e0a\u4f4d\u3092\u63a1\u7528\nreturn items.slice(0, 2).map(item => {\n  const content = item.json.contentSnippet || item.json.content || '';\n  const summary = content.replace(/<[^>]*>/g, '').slice(0, 400);\n  const guid = item.json.guid || item.json.link;\n  return {\n    json: {\n      title: item.json.title,\n      link: item.json.link,\n      guid,\n      summary\n    }\n  };\n});"
      },
      "typeVersion": 2
    },
    {
