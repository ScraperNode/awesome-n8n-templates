        "jsonOutput": "{\n  \"videos\": [\n    {\n      \"label\": \"Big Buck Bunny 1080p (30 MB)\",\n      \"url\": \"https://test-videos.co.uk/vids/bigbuckbunny/mp4/h264/1080/Big_Buck_Bunny_1080_10s_30MB.mp4\",\n      \"platform\": \"discord\",\n      \"durationSeconds\": 10\n    },\n    {\n      \"label\": \"Big Buck Bunny 720p (1 MB)\",\n      \"url\": \"https://test-videos.co.uk/vids/bigbuckbunny/mp4/h264/720/Big_Buck_Bunny_720_10s_1MB.mp4\",\n      \"platform\": \"discord\",\n      \"durationSeconds\": 10\n    },\n    {\n      \"label\": \"Jellyfish 1080p (30 MB), emailed\",\n      \"url\": \"https://test-videos.co.uk/vids/jellyfish/mp4/h264/1080/Jellyfish_1080_10s_30MB.mp4\",\n      \"platform\": \"email\",\n      \"durationSeconds\": 10\n    },\n    {\n      \"label\": \"VidSmaller sample clip\",\n      \"url\": \"https://vidsmaller.com/sample/sample-video.mp4\",\n      \"platform\": \"whatsapp\",\n      \"durationSeconds\": 6\n    }\n  ]\n}"
