      "name": "Build report",
      "type": "n8n-nodes-base.code",
      "position": [
        1160,
        240
      ],
      "parameters": {
        "jsCode": "// One item in, one summary out: counts, a human-readable report and the raw\n// per-video rows for whatever comes next (Slack, email, a database, a table).\n\nconst videos = $input.all().map((item) => item.json);\nconst count = (status) => videos.filter((v) => v.status === status).length;\n\nconst lines = videos.map((v) => {\n  if (v.status === 'ready') {\n    return `OK      ${v.label} - ${v.sizeMb} MB, inside the ${v.targetMb} MB target for ${v.platform}. Upload as it is.`;\n  }\n  if (v.status === 'compress') {\n    const quality =\n      v.qualityVerdict === 'rough' || v.qualityVerdict === 'impossible'\n        ? `  Heads up: ${v.targetMb} MB over ${v.durationSeconds || '?'}s is tight - expect visible quality loss.`\n        : '';\n    return `TOO BIG ${v.label} - ${v.sizeMb} MB vs the ${v.targetMb} MB target for ${v.platform}. Compress to about ${v.estimatedOutputMb} MB (-${v.savedPercent}%).${quality}`;\n  }\n  return `UNKNOWN ${v.label} - ${v.reason}`;\n});\n\nreturn [\n  {\n    json: {\n      checkedAt: new Date().toISOString(),\n      total: videos.length,\n      readyToUpload: count('ready'),\n      needCompression: count('compress'),\n      sizeUnknown: count('unknown'),\n      report: lines.join('\\n'),\n      videos,\n      limitsSource: 'https://vidsmaller.com/api-docs',\n    },\n  },\n];"
      },
      "typeVersion": 2
    },
