    {
      "id": "2c510919-e8f6-4df0-9c58-17f33fe8da5a",
      "name": "Validate File Type - Code",
      "type": "n8n-nodes-base.code",
      "position": [
        520,
        420
      ],
      "parameters": {
        "jsCode": "const out = [];\nfor (const item of $input.all()) {\n  const bin = item.binary && item.binary.data;\n  const mime = (bin && bin.mimeType) || '';\n  const ok = /pdf|jpeg|png|tiff/.test(mime);\n  out.push({ json: { valid: ok, mime, reason: ok ? '' : 'Unsupported file type: ' + mime },\n             binary: item.binary, pairedItem: item.pairedItem });\n}\nreturn out;"
      },
      "typeVersion": 2
    },
