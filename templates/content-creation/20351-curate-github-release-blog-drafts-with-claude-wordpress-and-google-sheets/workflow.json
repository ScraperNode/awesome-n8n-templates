      "parameters": {
        "jsCode": "// Claude\u306e\u5fdc\u7b54\u30c6\u30ad\u30b9\u30c8\u304b\u3089JSON\u3092\u62bd\u51fa\u3057\u3066\u30d1\u30fc\u30b9\u3059\u308b\nconst source = $('\u5224\u5b9a\u7d50\u679c\u30d1\u30fc\u30b9').item.json;\nconst raw = $json.content?.[0]?.text || '';\n\nlet parsed;\ntry {\n  const match = raw.match(/\\{[\\s\\S]*\\}/);\n  parsed = JSON.parse(match ? match[0] : raw);\n} catch (e) {\n  parsed = { title: source.headline_candidates?.[0] || source.tag_name, content_html: '' };\n}\n\nif (!parsed.content_html) {\n  throw new Error('\u8a18\u4e8b\u672c\u6587\u306e\u751f\u6210\u306b\u5931\u6557\u3057\u307e\u3057\u305f: ' + source.tag_name);\n}\n\nreturn [{\n  json: {\n    tag_name: source.tag_name,\n    html_url: source.html_url,\n    title: parsed.title,\n    content_html: parsed.content_html\n  }\n}];"
