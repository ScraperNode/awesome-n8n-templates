      "parameters": {
        "numberInputs": 3
      },
      "typeVersion": 3.1
    },
    {
      "id": "97782678-7b01-45a6-89d6-b340a36508a1",
      "name": "Build alert",
      "type": "n8n-nodes-base.code",
      "position": [
        2420,
        -110
      ],
      "parameters": {
        "jsCode": "const rows = $input.all().map(i => i.json);\nconst esc = s => String(s ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\nconst subject = 'Counterparty watchlist: ' + rows.length + ' new registry ' + (rows.length === 1 ? 'entry' : 'entries');\nconst html = '<p>' + esc(subject) + ' (' + $now.toFormat('yyyy-MM-dd') + ')</p>'\n  + '<table border=\"1\" cellpadding=\"4\" cellspacing=\"0\"><tr><th>Company</th><th>NIP/KRS</th><th>Source</th><th>What</th><th>Status / summary</th><th>Reference</th><th>Date</th></tr>'\n  + rows.map(r => '<tr><td>' + esc(r.company) + '</td><td>' + esc(r.identifier) + '</td><td>' + esc(r.source) + '</td><td>' + esc(r.what) + '</td><td>' + esc(r.status) + '</td><td>' + (r.link ? '<a href=\"' + esc(r.link) + '\">' + esc(r.reference || 'link') + '</a>' : esc(r.reference)) + '</td><td>' + esc(r.date) + '</td></tr>').join('')\n  + '</table>';\nconst text = '*' + subject + '*\\n' + rows.map(r => '- ' + r.company + ' (' + r.identifier + ') - ' + r.source + ': ' + r.what + (r.status ? ' - ' + r.status : '') + (r.reference ? ' [' + r.reference + ']' : '')).join('\\n');\nreturn [{ json: { subject, html, text, count: rows.length, findings: rows } }];"
      },
      "typeVersion": 2
    },
    {
      "id": "3bac1d5a-92d8-4a22-8a11-5dc68a60fa79",
      "name": "Send alert e-mail",
      "type": "n8n-nodes-base.gmail",
      "position": [
