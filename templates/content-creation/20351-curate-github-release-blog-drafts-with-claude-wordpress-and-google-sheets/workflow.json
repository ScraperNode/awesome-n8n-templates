    {
      "id": "fd84bf53-b7e5-4edf-8015-2b597768909b",
      "name": "\u5224\u5b9a\u7d50\u679c\u30d1\u30fc\u30b9",
      "type": "n8n-nodes-base.code",
      "position": [
        -120,
        0
      ],
      "parameters": {
        "jsCode": "// Claude\u306e\u5fdc\u7b54\u30c6\u30ad\u30b9\u30c8\u304b\u3089JSON\u3092\u62bd\u51fa\u3057\u3066\u30d1\u30fc\u30b9\u3059\u308b\nconst source = $('\u4e0a\u4f4d3\u4ef6\u306b\u7d5e\u308b').item.json;\nconst raw = $json.content?.[0]?.text || '';\n\nlet parsed;\ntry {\n  const match = raw.match(/\\{[\\s\\S]*\\}/);\n  parsed = JSON.parse(match ? match[0] : raw);\n} catch (e) {\n  parsed = { worth_article: false, reason: 'JSON parse error', headline_candidates: [], key_points: [] };\n}\n\nreturn [{\n  json: {\n    tag_name: source.tag_name,\n    html_url: source.html_url,\n    body: source.body,\n    worth_article: !!parsed.worth_article,\n    reason: parsed.reason || '',\n    headline_candidates: parsed.headline_candidates || [],\n    key_points: parsed.key_points || []\n  }\n}];"
      },
      "typeVersion": 2
    },
