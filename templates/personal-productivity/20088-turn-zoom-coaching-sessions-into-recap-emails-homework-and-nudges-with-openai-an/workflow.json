    {
      "id": "33a529e3-10f6-4dee-9b68-f5cfaf347738",
      "name": "Generate Action Plan",
      "type": "@n8n/n8n-nodes-langchain.openAi",
      "position": [
        2704,
        288
      ],
      "parameters": {
        "modelId": {
          "__rl": true,
          "mode": "list",
          "value": "gpt-4o-mini",
          "cachedResultName": "GPT-4O-MINI"
        },
        "options": {
          "temperature": 0.3
        },
        "messages": {
          "values": [
            {
              "role": "system",
              "content": "You assist a professional coach. From the session transcript, build an action plan for the client.\n- summary: 4-6 sentences written directly to the client (use 'you'), warm and specific, referencing what they actually said.\n- wins: up to 3 concrete wins or breakthroughs from the session.\n- insights: up to 3 key realisations worth remembering.\n- homework: 2-5 concrete tasks the client agreed to or that clearly follow from the conversation. Each has task, why (one short line), dueInDays (integer, before the next session). Never invent commitments that were not discussed.\n- progressScore: integer 1-10 for movement toward their goals, based only on evidence in the session. progressNote: one sentence explaining it.\n- nextSessionFocus: one sentence.\n- subject: a short, human email subject line.\nReturn only JSON with keys: subject, summary, wins, insights, homework, progressScore, progressNote, nextSessionFocus."
            },
            {
              "content": "=Client: {{ $('Match Client to Meeting').item.json.clientName }}\nClient goals: {{ $('Match Client to Meeting').item.json.goals }}\nSession date: {{ $('Match Client to Meeting').item.json.sessionDate }}\nMeeting topic: {{ $('Match Client to Meeting').item.json.topic }}\n\nTranscript:\n{{ $json.transcript }}"
            }
          ]
        },
        "jsonOutput": true
      },
      "typeVersion": 1.8
    },
    {
      "id": "96d1d440-f424-4bba-a64c-c3edd5409f78",
      "name": "Build Recap & Homework Rows",
      "type": "n8n-nodes-base.code",
      "position": [
        3024,
        288
      ],
      "parameters": {
        "jsCode": "// Build the recap email and the homework rows from the AI plan\nconst plan = $input.first().json.message.content || {};\nconst c = $('Match Client to Meeting').first().json;\nconst esc = s => String(s ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\nconst addDays = (d, n) => {\n  const x = new Date(d);\n  x.setDate(x.getDate() + (Number(n) || 7));\n  return x.toISOString().slice(0, 10);\n};\n\nconst homework = (plan.homework || []).map((h, i) => ({\n  taskId: `${c.clientId}-${c.sessionDate.replace(/-/g, '')}-${i + 1}`,\n  task: h.task,\n  why: h.why || '',\n  dueDate: addDays(c.sessionDate, h.dueInDays),\n}));\n\nconst list = arr => (arr || []).map(x => `<li style=\"margin-bottom:6px\">${esc(x)}</li>`).join('');\nconst rows = homework.map(h => `\n  <tr>\n    <td style=\"padding:8px 10px;border-bottom:1px solid #eee\">${esc(h.task)}<br>\n      <span style=\"color:#777;font-size:13px\">${esc(h.why)}</span></td>\n    <td style=\"padding:8px 10px;border-bottom:1px solid #eee;white-space:nowrap\">${h.dueDate}</td>\n  </tr>`).join('');\n\nconst html = `\n<div style=\"font-family:Arial,sans-serif;max-width:620px;color:#222;line-height:1.5\">\n  <p>Hi ${esc(c.clientName)},</p>\n  <p>${esc(plan.summary)}</p>\n  ${plan.wins && plan.wins.length ? `<h3 style=\"margin-bottom:4px\">Wins worth noting</h3><ul>${list(plan.wins)}</ul>` : ''}\n  ${plan.insights && plan.insights.length ? `<h3 style=\"margin-bottom:4px\">Key insights</h3><ul>${list(plan.insights)}</ul>` : ''}\n  <h3 style=\"margin-bottom:4px\">Your homework</h3>\n  <table style=\"border-collapse:collapse;width:100%\">\n    <tr><th align=\"left\" style=\"padding:8px 10px;background:#f5f5f5\">Task</th>\n        <th align=\"left\" style=\"padding:8px 10px;background:#f5f5f5\">Due</th></tr>\n    ${rows}\n  </table>\n  <p style=\"margin-top:16px\"><b>Progress check:</b> ${esc(plan.progressScore)}/10 - ${esc(plan.progressNote)}</p>\n  <p><b>Next time we'll focus on:</b> ${esc(plan.nextSessionFocus)}</p>\n  <p>Reply any time if something gets in the way.</p>\n</div>`;\n\nreturn [{\n  json: {\n    sessionId: c.meetingUuid,\n    sessionDate: c.sessionDate,\n    subject: plan.subject || `Your session recap - ${c.sessionDate}`,\n    html,\n    summary: plan.summary || '',\n    homework,\n    homeworkCount: homework.length,\n    progressScore: plan.progressScore ?? '',\n    progressNote: plan.progressNote || '',\n    nextSessionFocus: plan.nextSessionFocus || '',\n  },\n}];"
      },
      "typeVersion": 2
    },
    {
      "id": "47f7a437-0755-44b0-b426-c531c4b550ff",
      "name": "Email Recap to Client",
      "type": "n8n-nodes-base.gmail",
      "position": [
