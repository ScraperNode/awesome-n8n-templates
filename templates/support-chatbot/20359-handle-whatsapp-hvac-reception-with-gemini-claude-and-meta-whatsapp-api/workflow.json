    },
    {
      "id": "01cc827c-ff8c-4245-b621-4521a0fa762b",
      "name": "Split Reply into Bubbles",
      "type": "n8n-nodes-base.code",
      "position": [
        4080,
        384
      ],
      "parameters": {
        "jsCode": "// Short answers go out as one message. Longer ones are split at sentence ends into\n// bubbles of about 3 phone lines each, never more than 3 bubbles.\nconst MAX_CHARS = 120; // about 3 lines on a phone screen\nconst MAX_BUBBLES = 3;\n\nconst sentences = String($input.first().json.output || '')\n  .split(/\\n\\s*\\n/)\n  .flatMap(paragraph => paragraph.trim().split(/(?<=[.!?])\\s+/))\n  .map(sentence => sentence.trim())\n  .filter(Boolean);\n\n// fill each bubble with whole sentences until the next one would push it past MAX_CHARS\nconst bubbles = [];\nfor (const sentence of sentences) {\n  const current = bubbles[bubbles.length - 1];\n  if (current && (current + ' ' + sentence).length <= MAX_CHARS) {\n    bubbles[bubbles.length - 1] = current + ' ' + sentence;\n  } else {\n    bubbles.push(sentence);\n  }\n}\n\n// anything past the 3rd bubble joins the 3rd\nconst final = bubbles.length > MAX_BUBBLES\n  ? [...bubbles.slice(0, MAX_BUBBLES - 1), bubbles.slice(MAX_BUBBLES - 1).join(' ')]\n  : bubbles;\n\nreturn final.map(text => ({ json: { text } }));"
      },
      "typeVersion": 2
    },
    {
      "id": "e88a4fb4-692e-4681-8771-96b2e7ca9441",
      "name": "Mark Read and Show Typing",
