    {
      "id": "fda5e274-a1b4-4b4a-962d-64c661d83de4",
      "name": "Sticky Note1",
      "type": "n8n-nodes-base.stickyNote",
      "position": [
        1712,
        368
      ],
      "parameters": {
        "color": 4,
        "width": 784,
        "height": 576,
        "content": "## Compliance Logic & Routing\nComputes true financial leakage by comparing actuals against contract baselines, then routes transactions into compliant logs or violation processing branches accordingly."
      },
      "typeVersion": 1
    },
    {
      "id": "6fd88cbd-b2f9-447b-8a09-12474a40729e",
      "name": "Compare Terms vs Actuals",
      "type": "n8n-nodes-base.code",
      "position": [
        1792,
        592
      ],
      "parameters": {
        "jsCode": "// Get transactions and contracts\nconst transactions = $input.all().map(item => item.json);\n// IMPORTANT: Verify \"Fetch Contract Data\" matches your Notion node name\nconst contracts = $(\"Fetch Active Contracts\").all().map(item => item.json);\n\nconst results = [];\n\nfor (const txn of transactions) {\n  const contract = contracts.find(c => c.property_item_sku === txn[\"Item SKU\"]);\n  \n  let is_violation = false;\n  let violations = [];\n  let transaction_leakage = 0; // New structured variable\n\n  if (contract) {\n    // 1. Check for Pricing Violation & Calculate Exact Leakage\n    if (txn[\"Unit Price Paid\"] > contract.property_agreed_price) {\n      is_violation = true;\n      const priceVariance = txn[\"Unit Price Paid\"] - contract.property_agreed_price;\n      transaction_leakage = priceVariance * txn[\"Quantity Purchased\"]; // (Paid - Agreed) * Qty\n      \n      violations.push(`Price Overcharge: Paid $${txn[\"Unit Price Paid\"]}, Agreed $${contract.property_agreed_price} (Leakage: $${transaction_leakage})`);\n    }\n    \n    // 2. Check for SLA Violation\n    if (txn[\"Actual Delivery Days\"] > contract.property_sla_days) {\n      is_violation = true;\n      violations.push(`SLA Breach: Took ${txn[\"Actual Delivery Days\"]} days, Max allowed ${contract.property_sla_days} days`);\n    }\n\n    // 3. Check for Volume Limit Violation\n    if (txn[\"Quantity Purchased\"] > contract.property_volume_threshold) {\n      is_violation = true;\n      violations.push(`Volume Threshold Exceeded: Ordered ${txn[\"Quantity Purchased\"]}, Limit ${contract.property_volume_threshold}`);\n    }\n  } else {\n     is_violation = true;\n     violations.push(\"No active contract found for this SKU.\");\n  }\n\n  results.push({\n    json: {\n      transaction_id: txn[\"Transaction ID\"],\n      date: txn[\"Date\"],\n      vendor: txn[\"Vendor\"],\n      sku: txn[\"Item SKU\"],\n      quantity: txn[\"Quantity Purchased\"], // Passing structured data\n      unit_price_paid: txn[\"Unit Price Paid\"],\n      agreed_price: contract ? contract.property_agreed_price : null,\n      transaction_leakage: transaction_leakage, // Passing exact calculated leakage\n      is_violation: is_violation,\n      violation_details: violations,\n      contract_id: contract ? contract.property_contract_id : \"N/A\"\n    }\n  });\n}\n\nreturn results;"
      },
      "typeVersion": 2
    },
