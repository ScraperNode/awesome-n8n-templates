    {
      "id": "a78d46cc-2044-4f38-b7cb-9187475b9971",
      "name": "Route by Recommendation",
      "type": "n8n-nodes-base.switch",
      "notes": "Configure 3 rule outputs named exactly: shortlist, maybe, reject (matches recommendation string from the LLM).",
      "position": [
        3200,
        512
      ],
      "parameters": {
        "rules": {
          "values": [
            {
              "outputKey": "shortlist",
              "conditions": {
                "options": {
                  "version": 1,
                  "leftValue": "",
                  "caseSensitive": true,
                  "typeValidation": "strict"
                },
                "combinator": "and",
                "conditions": [
                  {
                    "id": "rec-shortlist",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    },
                    "leftValue": "={{ $json.fields?.Recommendation || $json.Recommendation || $json.recommendation }}",
                    "rightValue": "shortlist"
                  }
                ]
              },
              "renameOutput": true
            },
            {
              "outputKey": "maybe",
              "conditions": {
                "options": {
                  "version": 1,
                  "leftValue": "",
                  "caseSensitive": true,
                  "typeValidation": "strict"
                },
                "combinator": "and",
                "conditions": [
                  {
                    "id": "rec-maybe",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    },
                    "leftValue": "={{ $json.fields?.Recommendation || $json.Recommendation || $json.recommendation }}",
                    "rightValue": "maybe"
                  }
                ]
              },
              "renameOutput": true
            },
            {
              "outputKey": "reject",
              "conditions": {
                "options": {
                  "version": 1,
                  "leftValue": "",
                  "caseSensitive": true,
                  "typeValidation": "strict"
                },
                "combinator": "and",
                "conditions": [
