    {
      "id": "6d661fa0-01e9-4e85-a4c4-f63d990d5b19",
      "name": "Filter Content for Processing",
      "type": "n8n-nodes-base.code",
      "position": [
        768,
        4480
      ],
      "parameters": {
        "jsCode": "const items = $('Combine Pages and Posts').all().map(it => it.json);\nconst tableRows = $input.all().map(it => it.json);\nconst indexMap = {};\nfor (const r of tableRows) { if (r.productId) { indexMap[String(r.productId)] = r.dateModified; } }\n\nconst batchSize = Number($('Set Static Content Settings').first().json.staticBatchSize) || 10;\nconst pending = [];\nfor (const it of items) {\n  const fileId = 'wc_' + it.kind + '_' + it.id;\n  const known = indexMap[fileId];\n  if (!known || known !== it.modified) { pending.push(it); }\n}\n\nconst batch = pending.slice(0, batchSize);\nreturn batch.map(it => ({ json: it }));"
      },
      "typeVersion": 2
    },
