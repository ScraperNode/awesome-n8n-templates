        "jsonBody": "={{ (() => { const p = $('Read the posts').item.json; const nets = p.networks.filter(n => p.posts[n]); return JSON.stringify({ platforms: nets, text: p.topic, per_platform: Object.fromEntries(nets.map(n => [n, { text: p.posts[n] }])), idempotency_key: 'factory-' + p.chat_id + '-' + p.message_id }); })() }}",
        "sendBody": true,
        "specifyBody": "json",
        "authentication": "genericCredentialType",
