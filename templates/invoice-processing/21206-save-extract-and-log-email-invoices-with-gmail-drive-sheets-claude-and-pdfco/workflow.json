    {
      "id": "44dd51e8-0d2c-4caf-a2d1-283430daa452",
      "name": "Collect invoice files",
      "type": "n8n-nodes-base.code",
      "position": [
        2464,
        304
      ],
      "parameters": {
        "jsCode": "const folderId = $input.first().json.id;\nconst email = $('Loop over emails').first();\nconst date = email.json.receivedAt.slice(0, 10);\nconst safeSender = (email.json.senderName || 'invoice').replace(/[\\\\/:*?\"<>|]/g, '').trim();\n\nconst out = [];\n\n// 1. PDF attachments\nfor (const bin of Object.values(email.binary ?? {})) {\n  const name = bin.fileName ?? 'invoice.pdf';\n  if (bin.mimeType !== 'application/pdf' && !/\\.pdf$/i.test(name)) continue;\n  out.push({\n    json: { folderId, messageId: email.json.messageId, fileName: `${date} - ${name}` },\n    binary: { data: bin },\n  });\n}\n\n// 2. No attachment: follow the invoice link in the email (Paddle, Stripe, ...)\nlet reason = out.length ? null : 'no PDF attachment and no invoice link found';\nif (out.length === 0 && email.json.invoiceUrl) {\n  const allowList = String(email.json.renderLinkDomains || '')\n    .split(',')\n    .map((s) => s.trim().toLowerCase())\n    .filter(Boolean);\n  let host = '';\n  try { host = new URL(email.json.invoiceUrl).hostname.toLowerCase(); } catch (e) {}\n  const allowed = allowList.length === 0 || allowList.some((dom) => host === dom || host.endsWith('.' + dom));\n\n  try {\n    const res = await this.helpers.httpRequest({\n      url: email.json.invoiceUrl,\n      encoding: 'arraybuffer',\n      returnFullResponse: true,\n    });\n    const type = String(res.headers['content-type'] || '');\n    const body = Buffer.from(res.body);\n    const pdfName = `${date} - ${safeSender} invoice.pdf`;\n\n    if (type.includes('pdf')) {\n      // 2a. The link returns a PDF: upload it directly\n      out.push({\n        json: { folderId, messageId: email.json.messageId, fileName: pdfName, source: email.json.invoiceUrl },\n        binary: { data: { data: body.toString('base64'), mimeType: 'application/pdf', fileName: pdfName, fileExtension: 'pdf' } },\n      });\n    } else if (type.includes('html')) {\n      // 2b. The link opens an invoice web page: render it as a PDF, like right-click > Print\n      const looksLikeLogin = /type=[\"']password[\"']/i.test(body.toString('utf8'));\n      if (!allowed) reason = `link domain ${host} is not in renderLinkDomains`;\n      else if (looksLikeLogin) reason = 'invoice link opens a login page';\n      else out.push({ json: { folderId, messageId: email.json.messageId, pdfName, renderUrl: email.json.invoiceUrl } });\n    } else {\n      reason = `invoice link returned ${type || 'an unknown file type'}`;\n    }\n  } catch (e) {\n    reason = `could not open invoice link: ${e.message}`;\n  }\n}\n\n// 3. Nothing to upload: still pass one item on so the email is labelled and the loop continues\nif (out.length === 0) {\n  out.push({ json: { folderId, messageId: email.json.messageId, noFile: true, reason, invoiceUrl: email.json.invoiceUrl } });\n}\n\nreturn out;"
      },
      "typeVersion": 2
    },
