      "name": "Code: Get Last Run Time",
      "type": "n8n-nodes-base.code",
      "position": [
        1072,
        1936
      ],
      "parameters": {
        "jsCode": "// Access the workflow's persistent memory\nconst staticData = $getWorkflowStaticData('global');\n\n// Get current time in Unix seconds \nconst now = Math.floor(new Date().getTime() / 1000);\n\n// Retrieve the last run timestamp, or default to 5 minutes ago\nconst lastRun = staticData.lastSlackPull || (now - 300);\n\n// Save the current timestamp for the NEXT execution\nstaticData.lastSlackPull = now;\n\n// Append .000000 to force Slack's required string format\nreturn {\n  last_pull_timestamp: lastRun.toString() + \".000000\"\n};"
      },
      "typeVersion": 2
    },
