    {
      "id": "9222c76e-6db5-523f-896f-13a6b68d4f75",
      "name": "Sample leads",
      "type": "n8n-nodes-base.code",
      "position": [
        120,
        0
      ],
      "parameters": {
        "jsCode": "// Three sample leads so you can run the workflow straight away.\n// Replace this node with your own source (Google Sheets, Airtable, HubSpot, a webhook)\n// and match its columns in \"Map lead fields\".\n// address_source says where the address came from:\n// published (their website or a directory), bought, scraped, given or unknown.\nconst leads = [\n  { email: 'user@example.com', first_name: 'Jane', company: 'Example Ltd', address_source: 'published' },\n  { email: 'user@example.com', first_name: '', company: 'Example Org', address_source: 'scraped' },\n  { email: 'user@example.com', first_name: 'Sam', company: 'Example Net', address_source: 'bought' },\n];\nreturn leads.map((lead) => ({ json: lead }));"
      },
      "typeVersion": 2
    },
