        "jsCode": "const ctx = $('JS - Evaluate Trip').first().json;\n\nreturn [{\n  json: {\n    success: false,\n    error: 'upstream_failure',\n    service: ctx.serviceName,\n    circuitState: ctx.shouldTrip ? 'OPEN' : 'CLOSED',\n    tripped: ctx.shouldTrip,\n    failureCount: ctx.failureCount,\n    failureThreshold: ctx.failureThreshold,\n    upstreamStatus: ctx.upstreamStatus,\n    message: ctx.errorMessage,\n    retryAfterSeconds: ctx.shouldTrip ? ctx.openDurationSeconds : 0\n  }\n}];"
