    {
      "id": "0fef99c2-a354-4c2c-a95d-5114a86e10d4",
      "name": "Parse ARC Review",
      "type": "n8n-nodes-base.code",
      "position": [
        1280,
        0
      ],
      "parameters": {
        "jsCode": "function grab(raw) {\n  const s = String(raw || '');\n  const a = s.indexOf('{'); const b = s.lastIndexOf('}');\n  if (a < 0 || b < 0) return {};\n  try { return JSON.parse(s.slice(a, b + 1)); } catch (e) { return {}; }\n}\nconst src = $input.first().json;\nconst orig = $('Normalize ARC Request').first().json || {};\nconst ai = grab(src.output);\nconst flags = Array.isArray(ai.flags) ? ai.flags.join('; ') : (ai.flags ? String(ai.flags) : '');\nreturn [{ json: { ...orig, ...src, ...ai, ai_flags: flags, ai_summary: ai.summary || '', status: 'pending' } }];"
      },
      "typeVersion": 2
    },
