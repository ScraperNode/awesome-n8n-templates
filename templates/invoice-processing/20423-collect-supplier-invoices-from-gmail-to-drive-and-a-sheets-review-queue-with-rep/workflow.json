      "name": "Gmail invoices",
      "type": "n8n-nodes-base.gmailTrigger",
      "position": [
        -1000,
        120
      ],
      "parameters": {
        "simple": false,
        "filters": {
          "q": "label:Repondea-Factures has:attachment",
          "readStatus": "unread"
        },
        "options": {
          "downloadAttachments": true,
          "dataPropertyAttachmentsPrefixName": "attachment_"
        },
        "pollTimes": {
          "item": [
            {
              "mode": "everyMinute"
            }
          ]
        },
        "maxResults": 1
      },
      "typeVersion": 1.4
    },
    {
      "id": "0685f667-f949-4087-8320-23395c8f2012",
      "name": "Split invoice attachments",
      "type": "n8n-nodes-base.code",
      "position": [
        -760,
        120
      ],
      "parameters": {
        "jsCode": "const out = [];\nfor (const [i, item] of $input.all().entries()) {\n  const id = String(item.json.id || '');\n  if (!/^[a-zA-Z0-9_-]+$/.test(id)) throw new Error('Missing Gmail message id');\n  for (const [key, binary] of Object.entries(item.binary || {})) {\n    if (!/^attachment_\\d+$/.test(key)) continue;\n    const name = String(binary.fileName || '');\n    if (!/\\.(pdf|png|jpe?g)$/i.test(name)) continue;\n    const source_key = id + '_' + key;\n    out.push({ json: { source_key, message_id: id, original_filename: name,\n      archive_name: source_key, gmail_url: 'https://mail.google.com/mail/u/0/#all/' + id },\n      binary: { invoice: binary }, pairedItem: { item: i } });\n  }\n}\nif (!out.length) throw new Error('No PDF, PNG or JPEG attachment; message stays unread');\nreturn out;"
      },
      "typeVersion": 2
    },
