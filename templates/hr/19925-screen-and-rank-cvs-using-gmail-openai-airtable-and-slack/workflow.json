    {
      "id": "fd472b22-4ea2-4578-82bc-bdded17c0aec",
      "name": "Calculate Digest Statistics",
      "type": "n8n-nodes-base.code",
      "position": [
        1248,
        1376
      ],
      "parameters": {
        "jsCode": "const items = $input.all().map(i => i.json);\nconst field = (row, ...keys) => {\n  for (const k of keys) {\n    if (row?.fields && row.fields[k] != null && row.fields[k] !== '') return row.fields[k];\n    if (row?.[k] != null && row[k] !== '') return row[k];\n  }\n  return undefined;\n};\nconst total = items.length;\nconst rec = (i) => String(field(i, 'Recommendation', 'recommendation') || '').toLowerCase();\nconst shortlisted = items.filter(i => rec(i) === 'shortlist').length;\nconst maybe = items.filter(i => rec(i) === 'maybe').length;\nconst rejected = items.filter(i => rec(i) === 'reject').length;\nconst avgScore = total\n  ? (items.reduce((s, i) => s + (Number(field(i, 'Score', 'score')) || 0), 0) / total).toFixed(1)\n  : '0';\nreturn [{ json: { total, shortlisted, maybe, rejected, avgScore } }];"
      },
      "typeVersion": 2
    }
