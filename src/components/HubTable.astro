---
import { formatCount, type Hub } from '../lib/catalog';

interface Props {
  hubs: Hub[];
  /** Path under the site base, e.g. "templates" or "use-cases" */
  section: string;
  label: string;
}

const { hubs, section, label } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<table>
  <thead>
    <tr>
      <th>{label}</th>
      <th>Templates</th>
      <th>Description</th>
    </tr>
  </thead>
  <tbody>
    {hubs.map((hub) => (
      <tr>
        <td>{hub.emoji} <a href={`${base}${section}/${hub.slug}/`}>{hub.title}</a></td>
        <td>{formatCount(hub.count)}</td>
        <td>{hub.description}</td>
      </tr>
    ))}
  </tbody>
</table>
