        "sendTo": "user@example.com",
        "message": "=<div style=\"font-family: Arial, sans-serif; max-width: 600px; border: 1px solid #ddd; border-radius: 8px; padding: 20px;\">   <h2 style=\"color: #d9534f; margin-top: 0;\">New Maintenance Request \ud83d\udee0\ufe0f</h2>      <p><strong>Reporter:</strong> {{ $('Form: Submit Maintenance Request').item.json[\"Reporter Name\"] }}</p>   <p><strong>Location:</strong> {{ $('Form: Submit Maintenance Request').item.json[\"Apartment / Room Number\"] }}</p>   <p><strong>Description:</strong><br>   {{ $('Form: Submit Maintenance Request').item.json[\"Describe the Issue\"] }}</p>      <hr style=\"border: 0; border-top: 1px solid #eee; margin: 20px 0;\">      <p><strong>Damage Photo:</strong></p>   <!-- The Upload to URL link is injected here so it shows up natively in the email -->   <img src=\"{{ $('Create Public Photo Link').item.json.url }}\" alt=\"Damage Photo\" style=\"max-width: 100%; border-radius: 5px; border: 1px solid #ccc;\">      <p style=\"text-align: center; margin-top: 20px;\">     <a href=\"https://docs.google.com/spreadsheets/d/YOUR_SHEET_ID_HERE\" style=\"background-color: #0275d8; color: white; padding: 10px 20px; text-decoration: none; border-radius: 5px;\">View Ticket Tracker</a>   </p> </div>",
