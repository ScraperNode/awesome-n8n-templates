    {
      "id": "442761d2-531c-4ba5-8239-a1f3d7f0d2e1",
      "name": "Score lead against ICP",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "position": [
        1560,
        0
      ],
      "parameters": {
        "text": "=Score this lead against our ideal customer profile.\n\nIdeal customer profile:\n{{ $('Set your search and ICP').first().json.idealCustomerProfile }}\n\nLead:\n- Name: {{ $json['Full Name'] }}\n- Job title: {{ $json['Current Job'] }}\n- Headline: {{ $json['Profile Headline'] }}\n- Location: {{ $json['Location'] }}\n- Company: {{ $json['Company Name'] }}\n- Industry: {{ $json['Company Industry'] }}\n- Employees: {{ $json['Company Employee Range'] }}\n- Company description: {{ $json['Company Description'] }}\n\nReturn a score from 0 (no fit) to 100 (perfect fit), one sentence explaining the score, and a friendly one-sentence cold email icebreaker that references the lead's role or company. Do not invent facts that are not in the lead data.",
        "promptType": "define",
        "hasOutputParser": true
      },
      "typeVersion": 1.5
    },
    {
      "id": "73f03770-9dd8-43f1-9947-ee60d2e18963",
