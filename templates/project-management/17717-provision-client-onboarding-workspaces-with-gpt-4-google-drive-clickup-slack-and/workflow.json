        "message": "=Hi {{ $('On Form Submission').item.json['Client Full Name'] }},\n\nWelcome aboard. Your shared Google Drive folder is ready:\n{{ $('Prepare Drive Folder Details').first().json.drive_folder_url }}\n\nYou can use that folder to upload project documents and assets. Our delivery team has also prepared the internal project plan; your project manager will separately confirm any Slack or ClickUp access your engagement requires.{{ String($('Configure Onboarding Workspace').first().json.scheduling_url ?? '').trim() ? '\\n\\nNext step: schedule your onboarding call at ' + String($('Configure Onboarding Workspace').first().json.scheduling_url).trim() + '.' : '' }}\n\nIf you have questions, reply to this email.\n\nLooking forward to working together,\n{{ $('Configure Onboarding Workspace').first().json.account_manager_name }}\n{{ $('Configure Onboarding Workspace').first().json.agency_name }}",
        "options": {
          "appendAttribution": false
        },
