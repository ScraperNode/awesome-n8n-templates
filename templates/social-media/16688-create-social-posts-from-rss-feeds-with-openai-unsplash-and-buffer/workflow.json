        "color": 7,
        "width": 972,
        "height": 536,
        "content": "## Publish across channels\n\nCreates Buffer posts in sequence for X, LinkedIn, and Instagram using the generated copy and fetched media asset."
      },
      "typeVersion": 1
    },
