    {
      "id": "fd5d32cb-fab2-456d-a283-c6dfcc981d2c",
      "name": "Normalize AI Risk Context",
      "type": "n8n-nodes-base.code",
      "position": [
        3072,
        336
      ],
      "parameters": {
        "jsCode": "const base = $('Compare VIX Regime State').first().json;\nconst source = $json;\nlet parsed = null;\nif (typeof source.output === 'object' && source.output !== null) parsed = source.output;\nelse if (typeof source.output === 'string') { try { parsed = JSON.parse(source.output); } catch (e) {} }\nif (!parsed && typeof source.text === 'string') { try { parsed = JSON.parse(source.text); } catch (e) {} }\nif (!parsed && source.message?.content) { try { parsed = typeof source.message.content === 'string' ? JSON.parse(source.message.content) : source.message.content; } catch (e) { parsed = { regime_summary: String(source.message.content) }; } }\nparsed = parsed || source;\nreturn [{ json: { ...base, regime_summary: parsed.regime_summary || '', risk_guidance: parsed.risk_guidance || '', position_sizing_context: parsed.position_sizing_context || '', disclaimer: parsed.disclaimer || 'This information is general educational context and is not personalized financial advice.' } }];"
      },
      "typeVersion": 2
    },
