              "instructions": "Which type of insurance claim is this?",
              "choiceCriteria": {
                "option": [
                  {
                    "name": "auto",
                    "description": "Vehicle accident or auto damage"
                  },
                  {
                    "name": "health",
                    "description": "Medical or health-related claim"
                  },
                  {
                    "name": "property",
                    "description": "Home or property damage"
                  },
                  {
                    "name": "liability",
                    "description": "Liability or third-party claim"
                  }
                ]
              }
            },
            {
              "type": "score",
              "questionId": "severity",
              "scoreLevels": {
                "level": [
                  {
                    "label": "Minor"
                  },
                  {
                    "label": "Moderate"
                  },
                  {
                    "label": "Major"
                  }
                ]
              },
              "instructions": "How severe is this claim, based on the description and the amount claimed?"
            },
            {
              "type": "noul",
              "questionId": "fraud_risk",
              "instructions": "Does this claim show signs of inconsistency or fraud risk, such as damage that does not match the described incident, or an amount that seems unusually high for what is described?"
            },
            {
              "type": "noul",
              "questionId": "customer_tone",
              "instructions": "Does the claimant sound distressed, upset, or emotionally affected in how they describe the claim?"
            }
          ]
        }
