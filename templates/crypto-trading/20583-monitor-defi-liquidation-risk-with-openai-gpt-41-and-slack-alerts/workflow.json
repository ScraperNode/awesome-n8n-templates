    {
      "id": "ffa710b5-55d2-4849-87e5-3dc43c06275d",
      "name": "Calculate Risk Metrics",
      "type": "n8n-nodes-base.code",
      "position": [
        2352,
        384
      ],
      "parameters": {
        "jsCode": "const position = $('Fetch Lending Position').item.json;\nconst priceData = $('Fetch Live Asset Price').item.json;\n\nconst price = Number(priceData.price_usd);\nconst collateralAmount = Number(position.collateral_amount);\nconst debtAmount = Number(position.debt_amount);\nconst liquidationThreshold = Number(position.liquidation_threshold);\n\nconst collateralValue = collateralAmount * price;\nconst debtValue = debtAmount;\nconst healthFactor = debtValue > 0 ? (collateralValue * liquidationThreshold) / debtValue : 0;\nconst liquidationPrice = collateralAmount > 0 ? debtValue / (collateralAmount * liquidationThreshold) : 0;\nconst distanceUsd = price - liquidationPrice;\nconst distancePercent = price > 0 ? (distanceUsd / price) * 100 : 0;\n\nreturn [{\n  json: {\n    timestamp: new Date().toISOString(),\n    position_id: position.position_id,\n    wallet_address: position.wallet_address,\n    protocol: position.protocol,\n    chain: position.chain,\n    collateral_asset: position.collateral_asset,\n    collateral_amount: collateralAmount,\n    collateral_price_usd: price,\n    collateral_value_usd: Number(collateralValue.toFixed(2)),\n    debt_asset: position.debt_asset,\n    debt_amount: debtAmount,\n    debt_value_usd: Number(debtValue.toFixed(2)),\n    liquidation_threshold: liquidationThreshold,\n    health_factor: Number(healthFactor.toFixed(4)),\n    liquidation_price_usd: Number(liquidationPrice.toFixed(2)),\n    distance_to_liquidation_usd: Number(distanceUsd.toFixed(2)),\n    distance_to_liquidation_percent: Number(distancePercent.toFixed(2)),\n    price_source: priceData.source || 'dummy_market_data',\n    position_source: position.source || 'dummy_lending_protocol'\n  }\n}];"
      },
      "typeVersion": 2
    },
    {
      "id": "cd1f709a-3421-458d-86f1-5e9cb5f788cb",
      "name": "Classify Liquidation Risk",
      "type": "n8n-nodes-base.code",
      "position": [
        2640,
        384
      ],
      "parameters": {
        "jsCode": "const data = $input.first().json;\nconst state = $getWorkflowStaticData('global');\nconst previousRisk = state.lastRiskLevel || 'UNKNOWN';\nconst healthFactor = Number(data.health_factor);\n\nlet riskLevel = 'SAFE';\n\nif (healthFactor <= 1) {\n  riskLevel = 'LIQUIDATION_BREACHED';\n} else if (healthFactor < 1.1) {\n  riskLevel = 'URGENT';\n} else if (healthFactor < 1.2) {\n  riskLevel = 'CRITICAL';\n} else if (healthFactor <= 1.5) {\n  riskLevel = 'WARNING';\n}\n\nconst severity = {\n  SAFE: 0,\n  WARNING: 1,\n  CRITICAL: 2,\n  URGENT: 3,\n  LIQUIDATION_BREACHED: 4\n};\n\nconst previousSeverity = severity[previousRisk] === undefined ? -1 : severity[previousRisk];\nconst currentSeverity = severity[riskLevel];\nconst stateChanged = previousRisk !== riskLevel;\nconst escalated = currentSeverity > previousSeverity;\nconst alertRequired = riskLevel !== 'SAFE' && (stateChanged || escalated);\n\nstate.lastRiskLevel = riskLevel;\nstate.lastHealthFactor = data.health_factor;\nstate.lastCheckedAt = data.timestamp;\n\nreturn [{\n  json: {\n    ...data,\n    previous_risk_level: previousRisk,\n    risk_level: riskLevel,\n    risk_state_changed: stateChanged,\n    risk_escalated: escalated,\n    alert_required: alertRequired\n  }\n}];"
      },
      "typeVersion": 2
    },
