    {
      "id": "acd324c3-dc0d-46eb-99ff-0b250f459e5c",
      "name": "Formatlama",
      "type": "n8n-nodes-base.code",
      "position": [
        4368,
        240
      ],
      "parameters": {
        "jsCode": "// Bu node'un INPUT'u: \"G\u00f6rseli Al\" node'u (Nano Banana Pro sonucu)\n\n// 0) Ortak text temizleyici\nconst cleanText = (value) =>\n  String(value ?? '')\n    .replace(/\"/g, \"'\")          // \u00e7ift t\u0131rnaklar\u0131 tek t\u0131rna\u011fa \u00e7evir\n    .replace(/[\\r\\n\\t]+/g, ' ')  // newline / tab -> bo\u015fluk\n    .replace(/\\s+/g, ' ')        // birden fazla bo\u015fluk -> tek bo\u015fluk\n    .trim();\n\n// 1) Form'dan s\u00fcre ve aspect_ratio'yu al\nconst formData = $items('Form Bilgisi Topla')[0]?.json?.data ?? {};\n\nconst totalSeconds = Number(formData['Videonun uzunlu\u011funu se\u00e7iniz.']) || 15;\nconst aspectRatio = String(\n  formData['Video yatay m\u0131 yoksa dikey mi olsun?'] || 'portrait'\n)\n  .toLowerCase()\n  .trim();\n\n// 2) Shots Builder \u00e7\u0131kt\u0131s\u0131ndan sahneleri al\nlet shotsFromBuilder = $node['Shots Builder'].json.shots;\nif (!Array.isArray(shotsFromBuilder)) shotsFromBuilder = [];\n\nconst shots = shotsFromBuilder.map((s) => ({\n  Scene: cleanText(s.Scene ?? s.scene ?? s.prompt ?? ''),\n  duration: Number(s.duration ?? s.Duration ?? 1) || 1,\n}));\n\n// 3) \"G\u00f6rseli Al\" node'undan ilk sahne g\u00f6rsel URL'ini \u00e7ek\nconst g = items[0]?.json ?? {};\nlet rawResult =\n  g.data?.resultJson ??\n  g.data?.result_json ??\n  g.resultJson ??\n  g.result_json;\n\nlet resultObj = rawResult;\n\n// resultJson genelde string, \u00f6nce parse etmeyi dene\nif (typeof rawResult === 'string') {\n  try {\n    resultObj = JSON.parse(rawResult);\n  } catch (e) {\n    // \u00c7ift encode ihtimali i\u00e7in ikinci kez parse denemesi\n    try {\n      resultObj = JSON.parse(JSON.parse(rawResult));\n    } catch (e2) {}\n  }\n}\n\nlet firstImageUrl;\n\nif (\n  resultObj &&\n  Array.isArray(resultObj.resultUrls) &&\n  resultObj.resultUrls.length > 0\n) {\n  firstImageUrl = resultObj.resultUrls[0];\n}\n\n// H\u00e2l\u00e2 yoksa, t\u00fcm JSON i\u00e7inde bir URL yakalamaya \u00e7al\u0131\u015f (failsafe)\nif (!firstImageUrl) {\n  const haystack = JSON.stringify(g);\n  const match = haystack.match(/https?:\\/\\/[^\\s\"'\\\\]+/);\n  if (match) firstImageUrl = match[0];\n}\n\n// 4) Kie AI Sora 2 Pro Storyboard i\u00e7in final payload'\u0131 haz\u0131rla\nconst payload = {\n  model: 'sora-2-pro-storyboard',\n  input: {\n    n_frames: String(totalSeconds),\n    image_urls: firstImageUrl ? [firstImageUrl] : [],\n    aspect_ratio: aspectRatio,\n    shots,\n  },\n};\n\n// 5) n8n \u00e7\u0131kt\u0131s\u0131\nreturn [\n  {\n    json: payload,\n  },\n];\n"
      },
      "typeVersion": 2
    },
