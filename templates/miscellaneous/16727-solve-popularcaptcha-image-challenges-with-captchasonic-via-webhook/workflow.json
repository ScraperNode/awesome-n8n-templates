      "type": "n8n-nodes-captchasonic.captchaSonic",
      "onError": "continueRegularOutput",
      "position": [
        720,
        112
      ],
      "parameters": {
        "body": "={{ $json.body.extraFields || \"{}\" }}",
        "image": "={{ $json.body.image || '' }}",
