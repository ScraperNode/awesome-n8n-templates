        "jsCode": "function uploaded(result, queue) {\n  const id=String(result.id || '');\n  if (result.error || !/^[A-Za-z0-9_-]+$/.test(id)) return {...queue,status:'needs_review',output_url:'',error:'Drive upload result uncertain. Inspect target folder before retrying; do not blindly reset to pending.'};\n  return {...queue,status:'done',output_url:'https://drive.google.com/file/d/'+id+'/view',error:''};\n}\nreturn {json:uploaded($json, $('Process one row').item.json)};"
