    {
      "id": "bf0dfaec-95cc-467d-b1c2-510a27c61571",
      "name": "Build Valid Record",
      "type": "n8n-nodes-base.code",
      "position": [
        3040,
        480
      ],
      "parameters": {
        "jsCode": "const receipt = $('Merge Receipt Data').first().json;\nconst nta = $input.first()?.json || {};\nconst line = $('Set LINE Message Data').first().json;\n\nconst count = Number(nta?.count || 0);\nconst announcement = nta?.announcement?.[0] || {};\nconst wasChecked = receipt.hasValidTaxFormat === true;\nconst isValid = wasChecked && count > 0;\nconst driveUrl = receipt.webViewLink || (receipt.id ? `https://drive.google.com/file/d/${receipt.id}/view` : 'Archived');\n\nreturn [{\n  json: {\n    timestamp: $now.setZone('Asia/Tokyo').toFormat('yyyy-MM-dd HH:mm:ss'),\n    receipt_date: receipt.receipt_date || $now.setZone('Asia/Tokyo').toFormat('yyyy-MM-dd'),\n    vendor_name: receipt.vendor_name || 'Unknown Vendor',\n    total_amount: Number(receipt.total_amount) || 0,\n    tax_amount: Number(receipt.tax_amount) || 0,\n    invoice_number: receipt.invoice_number || 'None',\n    invoice_valid: isValid ? 'Valid on receipt date (NTA)' : (wasChecked ? 'Not valid on receipt date' : 'N/A'),\n    verified_company_name: isValid ? (announcement.name || 'Registered issuer') : 'Unregistered',\n    category: receipt.category || 'Miscellaneous',\n    description: receipt.description || '',\n    drive_url: driveUrl,\n    userId: line.userId,\n    replyToken: line.replyToken\n  }\n}];"
      },
      "typeVersion": 2
    },
