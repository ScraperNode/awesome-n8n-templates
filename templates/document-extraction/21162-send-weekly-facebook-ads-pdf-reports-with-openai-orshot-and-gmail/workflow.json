    {
      "id": "eaa598a9-5516-4b1f-af79-5db9b0f502e2",
      "name": "Get PDF link",
      "type": "n8n-nodes-base.code",
      "position": [
        2160,
        320
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// The Orshot node returns the API response under data, and the API wraps the render in data again.\n// A failed render comes back as { error } because the step continues on error.\nconst res = $json.data?.data ?? $json.data;\nconst page = Array.isArray(res) ? res[0] : res;\nconst pdf = page?.content || '';\nconst { mods, for_ai, ...row } = $('Build report data').item.json;\nreturn { json: { ...row, pdf, ok: !!pdf, status: pdf ? 'Rendered' : 'Failed', error: pdf ? '' : `Render: ${$json.error || 'Orshot returned no PDF link'}` } };"
      },
      "typeVersion": 2
    },
