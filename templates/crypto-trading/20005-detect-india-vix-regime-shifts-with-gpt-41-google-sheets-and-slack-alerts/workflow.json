      "parameters": {
        "color": 7,
        "width": 880,
        "height": 448,
        "content": "## State Storage and Alerting\nThis section stores the newly detected regime and maintains a historical record of the transition. After the state is updated, the workflow prepares a consolidated Slack notification containing the VIX value, previous and current regimes, percentage change, and AI-generated educational context before sending the alert."
      },
      "typeVersion": 1
