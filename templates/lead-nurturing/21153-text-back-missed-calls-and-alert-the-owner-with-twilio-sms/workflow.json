          "conditions": [
            {
              "id": "8ce059ba-3c12-42c8-90dd-b145fe3e66f9",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              },
              "leftValue": "={{ $json.missed && $json.allowed }}",
              "rightValue": ""
            }
