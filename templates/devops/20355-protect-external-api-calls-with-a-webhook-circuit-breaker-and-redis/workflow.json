    {
      "id": "4887e7cd-79e5-4f64-91e5-25db37d34f77",
      "name": "JS - Evaluate Trip",
      "type": "n8n-nodes-base.code",
      "position": [
        2800,
        1184
      ],
      "parameters": {
        "jsCode": "const ctx = $('JS - Classify Outcome').first().json;\nconst redisResult = $input.first().json || {};\n\nconst nums = Object.values(redisResult).filter(v => typeof v === 'number' || (typeof v === 'string' && v.trim() !== '' && !isNaN(v)));\nconst failureCount = nums.length ? Number(nums[0]) : 0; // Redis error -> never trip on bad data\n\nconst shouldTrip = ctx.wasProbe || failureCount >= Number(ctx.failureThreshold);\nconst now = Date.now();\n\nreturn [{\n  json: {\n    ...ctx,\n    failureCount,\n    shouldTrip,\n    stateValue: JSON.stringify({\n      state: 'OPEN',\n      openedAt: now,\n      service: ctx.serviceName,\n      reason: ctx.errorMessage,\n      failureCount\n    })\n  }\n}];"
      },
      "typeVersion": 2
    },
