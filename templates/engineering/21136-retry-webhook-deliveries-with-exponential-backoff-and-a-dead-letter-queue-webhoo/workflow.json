    {
      "id": "a1000000-0000-4000-8000-000000000005",
      "name": "Succeeded?",
      "type": "n8n-nodes-base.if",
      "position": [
        1216,
        128
      ],
      "parameters": {
        "options": {},
        "conditions": {
          "options": {
            "leftValue": "",
            "caseSensitive": true,
            "typeValidation": "loose"
          },
          "combinator": "and",
          "conditions": [
            {
              "id": "ok1",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              },
              "leftValue": "={{ $json.statusCode >= 200 && $json.statusCode < 300 }}",
