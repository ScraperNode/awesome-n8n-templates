    {
      "id": "d24a894d-8c06-40ca-8daa-ce52ec3fc6b8",
      "name": "Find New Reviews",
      "type": "n8n-nodes-base.code",
      "position": [
        1600,
        608
      ],
      "parameters": {
        "jsCode": "const items = $input.all();\nconst original = $('Split Out Businesses').item.json;\nconst response = items[0].json;\nconst seenIds = new Set(\n  (original.data || [])\n    .filter((row) => row.domain === original.domain)\n    .map((row) => row.review_id)\n);\nconst business = response.business || {};\nconst output = [];\nfor (const review of response.reviews || []) {\n  if (!review.id || seenIds.has(review.id)) continue;\n  output.push({\n    json: {\n      domain: original.domain,\n      review_id: review.id,\n      business_name: business.name,\n      business_website: business.website,\n      trust_score: business.trust_score,\n      rating: review.rating,\n      title: review.title,\n      text: review.text,\n      consumer_name: review.consumer ? review.consumer.display_name : null,\n      consumer_country: review.consumer ? review.consumer.country_code : null,\n      is_verified: review.is_verified,\n      published_date: review.published_date,\n      logged_at: new Date().toISOString(),\n    },\n  });\n}\nreturn output;"
      },
      "typeVersion": 2
    },
