    {
      "id": "b7027dc1-c071-488d-833d-776a1e3f8bea",
      "name": "Prepare Updates for Asana Task",
      "type": "n8n-nodes-base.code",
      "position": [
        304,
        992
      ],
      "parameters": {
        "jsCode": "const cfg = $('Set configuration').first().json;\nconst users = $('Get Asana users for task update').first().json.data;\nconst event = $('Set Event Data').first().json;\n\nconst stripHtml = (html) => {\n  if (!html) return null;\n  return html.replace(/<[^>]*>/g, '').trim();\n};\n\nconst organiserGID = users.find(u => u.email === event.Organiser)?.gid ?? 'me';\nconst attendeeGIDs = (event.CompanyAttendees ?? [])\n  .map(email => users.find(u => u.email === email)?.gid)\n  .filter(gid => gid != null);\n\nconst attendeeList = (event.Attendees ?? []).map(a => a.email).join(', ') || 'N/A';\nconst description = stripHtml(event.Description);\nconst startTime = new Date(event.StartTime).toLocaleString('en-GB', {dateStyle: 'medium', timeStyle: 'short', timeZone: cfg.timezone});\nconst endTime = new Date(event.EndTime).toLocaleString('en-GB', {dateStyle: 'medium', timeStyle: 'short', timeZone: cfg.timezone});\n\nconst htmlNotes = `<body><strong>This task is automatically updated from Google Calendar.</strong>\\n\\n<strong>Event:</strong> ${event.Title}\\n<strong>Description:</strong> ${description ?? 'N/A'}\\n<strong>Organiser:</strong> ${event.Organiser}\\n<strong>Attendees:</strong> ${attendeeList}\\n<strong>Start Time:</strong> ${startTime}\\n<strong>End Time:</strong> ${endTime}\\n<strong>Calendar Link:</strong> <a href=\"${event.Link}\">${event.Link}</a></body>`;\n\nreturn [{\n  json: {\n    ...event,\n    OrganiserGID: organiserGID,\n    AttendeeGIDs: attendeeGIDs,\n    Description: description,\n    HtmlNotes: htmlNotes\n  }\n}];"
      },
      "typeVersion": 2
    },
    {
      "id": "2e4fd9a5-8df1-429f-a4a7-45c522a336e0",
      "name": "Prepare Asana Task Data",
      "type": "n8n-nodes-base.code",
      "position": [
        320,
        704
      ],
      "parameters": {
        "jsCode": "const cfg = $('Set configuration').first().json;\nconst users = $('Get Asana users for new task').first().json.data;\nconst event = $('Set Event Data').first().json;\n\nconst stripHtml = (html) => {\n  if (!html) return null;\n  return html.replace(/<[^>]*>/g, '').trim();\n};\n\nconst organiserGID = users.find(u => u.email === event.Organiser)?.gid ?? 'me';\nconst attendeeGIDs = (event.CompanyAttendees ?? [])\n  .map(email => users.find(u => u.email === email)?.gid)\n  .filter(gid => gid != null);\n\nconst attendeeList = (event.Attendees ?? []).map(a => a.email).join(', ') || 'N/A';\nconst description = stripHtml(event.Description);\nconst startTime = new Date(event.StartTime).toLocaleString('en-GB', {dateStyle: 'medium', timeStyle: 'short', timeZone: cfg.timezone});\nconst endTime = new Date(event.EndTime).toLocaleString('en-GB', {dateStyle: 'medium', timeStyle: 'short', timeZone: cfg.timezone});\n\nconst htmlNotes = `<body><strong>This task is automatically created from Google Calendar.</strong>\\n\\n<strong>Event:</strong> ${event.Title}\\n<strong>Description:</strong> ${description ?? 'N/A'}\\n<strong>Organiser:</strong> ${event.Organiser}\\n<strong>Attendees:</strong> ${attendeeList}\\n<strong>Start Time:</strong> ${startTime}\\n<strong>End Time:</strong> ${endTime}\\n<strong>Calendar Link:</strong> <a href=\"${event.Link}\">${event.Link}</a></body>`;\n\nreturn [{\n  json: {\n    ...event,\n    OrganiserGID: organiserGID,\n    AttendeeGIDs: attendeeGIDs,\n    Description: description,\n    HtmlNotes: htmlNotes\n  }\n}];"
      },
      "typeVersion": 2
    },
