    {
      "id": "56f0a6ce-a574-4d44-a5d4-50e0d1c9c55b",
      "name": "Research with Perplexity",
      "type": "n8n-nodes-base.perplexity",
      "position": [
        1800,
        0
      ],
      "parameters": {
        "input": "={{ 'Brand: ' + $('Set your brand and niche').item.json.brand + '\\nNiche: ' + $('Set your brand and niche').item.json.niche + '\\nCountry: ' + $('Set your brand and niche').item.json.country + '\\n\\nToday\\'s trending searches:\\n' + $json.trends.map(t => '- ' + t.title + ' (' + (t['ht:approx_traffic'] || '?') + ' searches)').join('\\n') }}",
        "model": {
          "__rl": true,
          "mode": "id",
          "value": ""
        },
        "preset": "pro-search",
        "options": {
          "instructions": "You research trends for the social media of the brand. From the trending searches, pick the ONE the brand can post about naturally and search the web to find out why it is trending today. Never pick deaths, crimes, accidents, disasters, politics, elections, lawsuits or private people. Return only JSON, with no text around it. If no trend fits, return {\"relevant\": false}. Otherwise return the keys relevant (true), trend (the trend exactly as written), why_trending (one or two sentences, only what your sources say), facts (an array of 2 short verified facts) and angle (one sentence on how the brand connects to it). Invent no facts about the brand.",
          "maxOutputTokens": 700
        },
        "resource": "agent",
        "simplify": true,
        "operation": "createResponse"
      },
      "typeVersion": 3
    },
    {
      "id": "788c9f80-d803-4813-a307-b2f7498f6932",
      "name": "Read the research",
      "type": "n8n-nodes-base.set",
      "position": [
        2100,
        0
      ],
      "parameters": {
        "options": {},
        "assignments": {
          "assignments": [
            {
              "id": "eb7333fb-b00e-4f9d-a4b2-2270d12b36b9",
              "name": "plan",
              "type": "object",
              "value": "={{ (() => { const t = String($json.output_text || ''); const m = t.match(/\\{[\\s\\S]*\\}/); try { return JSON.parse(m ? m[0] : t); } catch (e) { return { relevant: false }; } })() }}"
            },
            {
              "id": "d8dba3d2-37c6-491b-a275-ff7c782b67f1",
              "name": "sources",
              "type": "string",
              "value": "={{ ($json.citations || []).slice(0, 3).map(c => c.url).join(' ') }}"
            },
            {
              "id": "f8c4a455-71d5-4a69-a673-df6a68450db7",
              "name": "date",
              "type": "string",
              "value": "={{ $now.toFormat('yyyy-MM-dd') }}"
            }
          ]
        }
      },
      "typeVersion": 3.4
    },
    {
      "id": "47474b9f-8959-4e8e-aff5-cdbdb2128ee1",
      "name": "On brand?",
      "type": "n8n-nodes-base.if",
      "position": [
        0,
        552
      ],
      "parameters": {
        "options": {},
        "conditions": {
          "options": {
            "version": 2,
            "leftValue": "",
            "caseSensitive": true,
            "typeValidation": "loose"
          },
          "combinator": "and",
          "conditions": [
            {
              "id": "e7338063-198b-4962-ab74-e943f1cf67cf",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              },
              "leftValue": "={{ $json.plan.relevant === true && !!$json.plan.trend }}",
              "rightValue": ""
            }
          ]
        }
      },
      "typeVersion": 2.2
    },
    {
      "id": "1967f30d-10c4-4668-a3ed-c965e24b95ca",
      "name": "Post to LinkedIn, Facebook, Bluesky",
      "type": "n8n-nodes-postwire.postWire",
      "onError": "continueRegularOutput",
      "position": [
        300,
        552
      ],
      "parameters": {
        "prompt": "={{ (() => { const p = $json.plan; const s = $('Set your brand and niche').item.json; return 'Write as ' + s.brand + ' (' + s.niche + '). Trending today: ' + p.trend + '. ' + (p.why_trending || '') + ' ' + (p.facts || []).join(' ') + ' Our angle: ' + (p.angle || '') + ' Use only these facts.'; })() }}",
        "options": {
          "idempotencyKey": "={{ ('trend-' + $json.date + '-' + $json.plan.trend).slice(0, 200) }}"
        },
        "resource": "post",
        "operation": "publish",
        "platforms": [
          "linkedin",
          "facebook",
          "bluesky"
        ],
        "contentMode": "smart",
        "mediaSource": "none"
      },
      "typeVersion": 2
    },
