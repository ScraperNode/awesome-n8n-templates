      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const previous=$json||{};\nconst state=$getWorkflowStaticData('global');\nconst pending=state._splunkPending||{};\nconst fingerprint=String(previous.fingerprint||'');\n\n// A Data Table match contains fingerprint. If no row was found, recover the only\n// pending alert for this execution. This keeps the workflow independent of node names.\nlet current = fingerprint ? pending[fingerprint] : null;\nif (!current) {\n  const keys=Object.keys(pending);\n  current=keys.length ? pending[keys[keys.length-1]] : {};\n}\n\nconst previousEpoch=Number(previous.received_epoch||0);\nconst cooldownMinutes=15;\nconst isDuplicate=previousEpoch>0 &&\n  (Number(current.received_epoch||Date.now())-previousEpoch)<cooldownMinutes*60*1000;\n\nif (current.fingerprint) delete pending[current.fingerprint];\n\nreturn {\n  json:{\n    ...current,\n    is_duplicate:isDuplicate,\n    previous_received_at:previous.received_at||'',\n    dedup_cooldown_minutes:cooldownMinutes\n  }\n};"
