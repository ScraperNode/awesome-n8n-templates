              "fieldType": "number",
              "fieldLabel": "How many businesses",
              "placeholder": "100",
              "requiredField": true
            },
            {
              "fieldType": "number",
              "fieldLabel": "Maximum price in USD",
              "placeholder": "10",
              "requiredField": true
            }
          ]
        },
        "formDescription": "Name the trade and the city. You get every match in your Google Sheet, with phone, website and the page each row came from."
      },
      "typeVersion": 2.2
    },
