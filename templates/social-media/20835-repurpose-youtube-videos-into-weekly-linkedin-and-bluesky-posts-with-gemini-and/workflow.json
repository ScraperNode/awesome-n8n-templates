    {
      "id": "06c1e16c-c976-496e-a6d8-cf821c668f43",
      "name": "Plan a week of posts",
      "type": "n8n-nodes-postwire.postWire",
      "onError": "continueRegularOutput",
      "position": [
        300,
        552
      ],
      "parameters": {
        "topic": "={{ (() => { const b = $json; const a = $('Read the link').item.json.angle; return 'A series of posts sharing what I learned from the video \"' + b.notes.title + '\" (' + b.video_url + ').\\nWhat the video says: ' + b.notes.summary + '\\nOne takeaway per day, in this order:\\n' + b.notes.takeaways.map((t, i) => (i + 1) + '. ' + t).join('\\n') + (b.notes.quote ? '\\nA line said in the video: \"' + b.notes.quote + '\"' : '') + (a ? '\\nAngle: ' + a : '') + '\\nUse only these facts. Put the video link in the last post.'; })() }}",
        "options": {
          "days": "={{ $json.notes.takeaways.length }}",
          "hour": "={{ $('Your voice and email').item.json.hour }}",
          "brandVoice": "={{ $('Your voice and email').item.json.voice }}"
        },
        "resource": "post",
        "operation": "planWeek",
        "platforms": [
          "linkedin",
          "bluesky"
        ]
      },
      "typeVersion": 2
    },
