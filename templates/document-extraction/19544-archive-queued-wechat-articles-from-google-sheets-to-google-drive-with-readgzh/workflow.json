    {
      "id": "select-pending-rows",
      "name": "Select pending rows",
      "type": "n8n-nodes-base.code",
      "position": [
        880,
        320
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "function canonical(raw) {\n  const s = String(raw || '').trim();\n  const short = s.match(/^https:\\/\\/mp\\.weixin\\.qq\\.com\\/s\\/([A-Za-z0-9_-]+)(?:[?#].*)?$/);\n  if (short) return {url: 'https://mp.weixin.qq.com/s/' + short[1], parameterName: 'url', parameterValue: 'https://mp.weixin.qq.com/s/' + short[1]};\n  const share = s.match(/^https:\\/\\/readgzh\\.site\\/s\\/([A-Za-z0-9_-]+)\\/?$/);\n  if (share) return {url: 'https://readgzh.site/s/' + share[1], parameterName: 's', parameterValue: share[1]};\n  if (/^https:\\/\\/mp\\.weixin\\.qq\\.com\\/s\\?[^\\s#]+$/.test(s)) return {url: s, parameterName:'url', parameterValue:s};\n  throw new Error('Use a public WeChat /s/ URL or ReadGZH /s/ share URL.');\n}\nfunction prepare(rows, maxBatch) {\n  if (!Number.isInteger(maxBatch) || maxBatch < 1 || maxBatch > 20) throw new Error('maxBatch must be an integer from 1 to 20');\n  const ids = new Set();\n  for (const row of rows) {\n    const id = String(row.queue_id || '').trim();\n    if (!/^[A-Za-z0-9_-]{1,64}$/.test(id) || ids.has(id)) throw new Error('Every row needs a unique queue_id (letters, digits, underscore or hyphen, max 64).');\n    ids.add(id);\n  }\n  const reserved = new Set();\n  for (const r of rows) if (['done','processing','needs_review'].includes(String(r.status).trim())) {\n    try { reserved.add(canonical(r.article_url).url); } catch {}\n  }\n  const out = [];\n  for (let i=0; i<rows.length && out.length<maxBatch; i++) {\n    const r=rows[i];\n    if (String(r.status).trim() !== 'pending') continue;\n    const base={queue_id:String(r.queue_id).trim(), article_url:String(r.article_url || '').trim(), valid:false, status:'error', output_url:'', error:''};\n    try {\n      if (r.output_url) throw new Error('Existing output_url: inspect the archived file before resetting this row.');\n      const parsed=canonical(r.article_url);\n      if (reserved.has(parsed.url)) {base.status='duplicate'; base.error='URL already queued or archived; inspect the original row.';}\n      else { Object.assign(base,parsed,{valid:true,status:'processing'}); reserved.add(parsed.url); }\n    } catch(e) {base.error=e.message;}\n    out.push({json:base,pairedItem:{item:i}});\n  }\n  return out;\n}\nreturn prepare($input.all().map(i=>i.json), Number($('Queue settings').first().json.maxBatch));"
      },
      "typeVersion": 2
    },
