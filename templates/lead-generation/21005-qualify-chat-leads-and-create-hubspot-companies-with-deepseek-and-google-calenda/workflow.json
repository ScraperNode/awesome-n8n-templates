      "position": [
        -544,
        -128
      ],
      "parameters": {
        "color": 7,
        "width": 576,
        "height": 512,
        "content": "## Chat-driven HubSpot agent\n\nA compact cluster where an incoming chat message is handled by an AI Agent, supported by DeepSeek, conversation memory, and a HubSpot tool for creating company records."
      },
      "typeVersion": 1
    },
    {
      "id": "42aae674-e589-48cb-9cdc-921511fbeca2",
