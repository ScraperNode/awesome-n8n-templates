    {
      "id": "26faeb3d-b762-424d-9f4a-1744355d8e50",
      "name": "Prepare delivery",
      "type": "n8n-nodes-base.code",
      "position": [
        2860,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const c=$('Configuration').first().json, a=c.actorInput;\nconst run=$('Check run status').first().json;\nconst health=$('Get HEALTH').first().json;\nconst targets=$('Get TARGETS').first().json.body;\nconst ads=$input.first().json.body;\nif (!Array.isArray(ads) || !Array.isArray(targets) || !targets.length)\n  throw new Error('Missing dataset or TARGETS; no delivery state changed.');\nif (health.chargeLimitReached || health.malformedAdsSkipped>0 || health.adsWithTextOrDetailErrors>0 || targets.some(t=>!['ok','no_ads'].includes(t.status)))\n  throw new Error('Incomplete or unreliable source response. Inspect HEALTH and TARGETS before retrying.');\nif (health.rows!==ads.length || ads.length>a.maxItems || run.stats?.restartCount>0)\n  throw new Error('Dataset count mismatch or restarted run; inspect source before delivery.');\nconst scope=JSON.stringify({domain:a.domains[0],region:a.region||'US',platforms:[...(a.platforms||[])].sort(),\n  format:a.adFormat||'',from:a.startDate||'',until:a.endDate||''});\nconst existing=$('Read saved ads').all().map(i=>i.json).filter(r=>r.scope===scope && r.key);\nconst old=new Map();\nfor (const r of existing) {\n  if (old.has(r.key)) throw new Error('Duplicate saved key: fix sheet before retrying.');\n  if (!['baseline','logged'].includes(r.deliveryStatus)) throw new Error('Invalid deliveryStatus in saved sheet.');\n  old.set(r.key,r);\n}\nconst baseline=existing.length===0 && c.baselineOnEmptyScope;\nconst now=new Date().toISOString(), rows=new Map(old);\nfor (const ad of ads) {\n  if (!/^CR\\d+$/.test(ad.adId||'') || !/^AR\\d+$/.test(ad.advertiserId||''))\n    throw new Error('Missing or invalid ad identifier; no delivery state changed.');\n  const key=scope+'|'+ad.advertiserId+'|'+ad.adId;\n  const previous=old.get(key);\n  const plain=v=>String(v??'');\n  rows.set(key,{key,scope,adId:ad.adId,advertiserId:ad.advertiserId,\n    advertiserName:plain(ad.advertiserName),domain:plain(ad.domain),region:plain(ad.region),format:plain(ad.format),\n    headline:plain(ad.headline||ad.productTitle),description:plain(ad.description),\n    adUrl:`https://adstransparency.google.com/advertiser/${ad.advertiserId}/creative/${ad.adId}`,\n    firstShown:plain(ad.firstShown),lastShown:plain(ad.lastShown),firstSeenAt:previous?.firstSeenAt||now,\n    lastSeenAt:now,runId:run.id,deliveryStatus:previous?.deliveryStatus||(baseline?'baseline':'logged')});\n}\n// Keep pending rows even if a later snapshot does not contain them.\nconst newIds=[...rows.values()].filter(r=>!old.has(r.key)).map(r=>r.adId);\nconst pending=[...rows.values()].filter(r=>r.deliveryStatus==='pending');\nconst escape=s=>String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');\nconst preview=pending.slice(0,5).map(r=>`\u2022 ${escape((r.headline||r.advertiserName||r.adId).slice(0,100))} \u2014 ${r.adUrl}`).join('\\n');\nconst slackText=`${pending.length} first-seen Google ad(s) for ${escape(a.domains[0])}.\\nPreviously unseen in this saved scope; publication time is not verified.\\n${preview}\\nAll records: https://docs.google.com/spreadsheets/d/${encodeURIComponent(c.spreadsheetId)}/edit\\nSnapshot limit: ${a.maxItems}. Source coverage is not guaranteed. Run: ${run.id}`;\nreturn [{json:{rows:[...rows.values()],pending,baseline,newIds,runId:run.id,\n  observedRows:ads.length,coverage:ads.length>=Math.min(a.maxItems,a.maxAdsPerTarget)?'at-row-limit':'below-row-limit-not-proof-of-completeness'}}];"
      },
      "typeVersion": 2
    },
