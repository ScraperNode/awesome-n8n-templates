              "role": "system",
              "content": "You are a contact extraction assistant.\n\nYou receive Tavily search results for a research prompt.\n\nExtract all people mentioned and provide:\n\n- name\n- organization\n- role (Policy Maker, Academic, Journalist, Member Organisation)\n- interests (Migration, Climate, Security, Economy, Enlargement)\n\nReturn only JSON:\n\n{\n  \"contacts\": [\n    {\n      \"name\": \"\",\n      \"organization\": \"\",\n      \"role\": \"\",\n      \"interests\": []\n    }\n  ]\n}\n"
            },
            {
              "content": "={{ JSON.stringify($json, null, 2) }}\n"
            }
          ]
        },
        "builtInTools": {}
      },
      "retryOnFail": true,
      "typeVersion": 2,
      "waitBetweenTries": 2500
    },
