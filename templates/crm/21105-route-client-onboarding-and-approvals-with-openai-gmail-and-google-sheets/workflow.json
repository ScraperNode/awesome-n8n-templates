    {
      "id": "85086c17-0469-45a3-99de-acbd5cf42bf7",
      "name": "01 \u2014 Client Intake Webhook",
      "type": "n8n-nodes-base.webhook",
      "position": [
        240,
        192
      ],
      "webhookId": "98d40801-4d0c-43d2-b874-68ab29d53303",
      "parameters": {
        "path": "client-onboarding-intake",
        "options": {},
        "httpMethod": "POST",
        "responseMode": "lastNode"
      },
      "typeVersion": 2.1
    },
    {
      "id": "a78e4390-7200-4064-8695-7359c88eec6b",
      "name": "02 \u2014 Normalize and Validate Intake",
      "type": "n8n-nodes-base.code",
      "position": [
        464,
        192
      ],
      "parameters": {
        "jsCode": "const p = $json.body ?? $json;\nconst required = ['clientId','companyName','contactName','contactEmail','serviceType','requirements'];\nconst missingFields = required.filter(k => !p[k]);\nreturn [{json:{...p, intakeStatus:missingFields.length?'invalid':'ready_for_analysis', missingFields, idempotencyKey:`onboarding:${p.clientId??'missing'}:${p.targetDate??'unscheduled'}`, receivedAt:new Date().toISOString()}}];"
      },
      "typeVersion": 2
    },
    {
      "id": "a3f1868b-6ed2-4b5a-9a99-e0b678a71dab",
      "name": "03 \u2014 AI Scope and Risk Analysis",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "position": [
        688,
        80
      ],
      "parameters": {
        "text": "=Analyze scope, ambiguity, deadline risk, assumptions and delivery feasibility. Return JSON with scopeSummary, complexity, riskScore, recommendedStage, deliverables, assumptions and redFlags. Client: {{ $json.companyName }}; Service: {{ $json.serviceType }}; Requirements: {{ $json.requirements }}",
        "options": {
          "systemMessage": "You are a delivery operations analyst. Assess scope ambiguity, deadline risk, assumptions, commercial risk and feasibility. Return structured JSON only. Never approve or provision work; recommend a risk stage for human review."
        },
        "promptType": "define"
      },
      "typeVersion": 3.1
    },
    {
      "id": "6053827c-1cd1-4356-aa22-9796f7fe7354",
      "name": "04 \u2014 High Risk or Approval Required?",
      "type": "n8n-nodes-base.if",
      "position": [
        1040,
        192
      ],
      "parameters": {
        "options": {},
        "conditions": {
          "options": {
            "version": 1,
            "leftValue": "",
            "caseSensitive": true,
            "typeValidation": "strict"
          },
          "combinator": "and",
          "conditions": [
            {
              "operator": {
                "type": "number",
                "operation": "largerEqual"
              },
              "leftValue": "={{ $json.riskScore }}",
              "rightValue": 40
            }
          ]
        }
      },
      "typeVersion": 2.2
    },
    {
      "id": "62644eca-cbed-4cb4-b66c-6966b13501e4",
      "name": "05A \u2014 Build Project Provisioning Plan",
      "type": "n8n-nodes-base.code",
      "position": [
        1264,
        96
      ],
      "parameters": {
        "jsCode": "return [{json:{...$json, projectStatus:'provisioning_ready', projectKey:`PROJECT-${$json.clientId}`, folderName:`${$json.companyName} \u2014 Delivery Workspace`, taskTemplate:($json.deliverables??[]).map((title,index)=>({title,order:index+1,status:'not_started'}))}}];"
      },
      "typeVersion": 2
    },
    {
      "id": "2a3fd528-ea36-4df9-a771-f56d4c6dd539",
      "name": "07 \u2014 Append Audit Record",
      "type": "n8n-nodes-base.googleSheets",
      "position": [
        1488,
        384
      ],
      "parameters": {
        "columns": {
          "value": {
            "event": "={{ $json.projectStatus ?? $json.recommendedStage ?? \"received\" }}",
            "clientId": "={{ $json.clientId ?? \"\" }}",
            "riskScore": "={{ $json.riskScore ?? 0 }}",
            "approvalId": "={{ $json.approvalId ?? \"\" }}",
            "occurredAt": "={{ $now.toISO() }}",
            "executionId": "={{ $execution.id }}"
          },
          "mappingMode": "defineBelow"
        },
        "options": {},
        "operation": "append",
        "sheetName": "={{ $env.CONTROL_TOWER_AUDIT_SHEET_NAME ?? 'AuditLog' }}",
        "documentId": "={{ $env.CONTROL_TOWER_AUDIT_SHEET_ID }}"
      },
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "4IBzQOIXVNDVKClv",
          "name": "Google Sheets account"
        }
      },
      "typeVersion": 4.5
    },
    {
      "id": "62db32bf-062a-4020-85e6-98fd2fa4ff93",
