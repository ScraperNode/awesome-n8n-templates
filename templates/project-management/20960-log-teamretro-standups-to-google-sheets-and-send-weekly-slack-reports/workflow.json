    {
      "id": "tr1800-0000-0000-0000-000000000012",
      "name": "One Row per Update",
      "type": "n8n-nodes-base.code",
      "position": [
        1240,
        300
      ],
      "parameters": {
        "jsCode": "const { includeCarriedOver, blockerTopic } = $('Settings').first().json;\nconst standup = $('When Standup Closes').first().json.data.standup;\nconst rows = [];\nfor (const { participant, topics } of standup.updates || []) {\n  for (const { topic, updates } of topics) {\n    for (const update of updates) {\n      if (update.carriedFromStandupUpdateId && !includeCarriedOver) continue;\n      rows.push({ json: {\n        'Date': standup.date,\n        'Team': standup.team.name,\n        'Standup': standup.title || 'Standup',\n        'Person': participant.name || 'Anonymous',\n        'Question': topic.title,\n        'Blocker': topic.title.toLowerCase().includes(String(blockerTopic).toLowerCase()) ? 'yes' : 'no',\n        'Update': update.text,\n        'Carried over': update.carriedForwardCount,\n        'Update ID': update.id,\n      } });\n    }\n  }\n}\nreturn rows;"
      },
      "typeVersion": 2
    },
