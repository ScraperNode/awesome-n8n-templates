              "type": "number",
              "value": "={{ $json.data.length }}"
            },
            {
              "id": "59a36f86-81ec-4d2b-b0ee-dc1b304d2641",
              "name": "improved",
              "type": "number",
              "value": "={{ $json.data.filter(item => item.position_change > 0).length }}"
            },
            {
              "id": "cc33ec29-bfbf-4fa0-bb68-647070222205",
              "name": "declined",
              "type": "number",
              "value": "={{ $json.data.filter(item => item.position_change < 0).length }}"
            },
            {
              "id": "a0ef65f0-7851-44e3-8bba-fb24c41e49f2",
              "name": "biggestDrop",
              "type": "string",
              "value": "={{ (() => { const d = $json.data.filter(item => item.position_change < 0).sort((a,b) => a.position_change - b.position_change)[0]; return d ? d.keyword + ' (' + d.position_change + ')' : 'None'; })() }}"
            },
            {
              "id": "f5bbf038-854d-4c55-b29e-8b1340c660fa",
              "name": "biggestGain",
              "type": "string",
              "value": "={{ (() => { const g = $json.data.filter(item => item.position_change > 0).sort((a,b) => b.position_change - a.position_change)[0]; return g ? g.keyword + ' (+' + g.position_change + ')' : 'None'; })() }}"
            }
          ]
        }
      },
      "typeVersion": 3.4
    },
