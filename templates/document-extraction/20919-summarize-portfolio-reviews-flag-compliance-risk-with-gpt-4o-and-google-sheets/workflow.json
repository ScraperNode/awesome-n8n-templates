    {
      "id": "efa91cb1-95ff-4220-8803-ce4acc2551b9",
      "name": "AI Agent - Summarize & Flag Compliance Risk",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "onError": "continueRegularOutput",
      "position": [
        912,
        1168
      ],
      "parameters": {
        "text": "=Client: {{ $json.clientName }}\nAdvisor: {{ $json.advisorName }}\nRisk tolerance on file: {{ $json.riskToleranceOnFile }}\nRaw meeting notes:\n{{ $json.meetingNotes }}\n\nSummarize and flag compliance risk per the schema.",
        "options": {
          "systemMessage": "You are a compliance-aware review assistant for a registered investment advisory firm. You do NOT give investment advice or recommendations. Objectively summarize the advisor's raw meeting notes, then flag ONLY factual mismatches worth a human compliance officer's attention: risk-tolerance-on-file vs. discussed changes, concentration in a single position/sector, or any language suggesting an unsuitable recommendation. Classify complianceRisk as high, medium, or low. If nothing is flagged, say so plainly \u2014 do not invent risk."
        },
        "promptType": "define",
        "hasOutputParser": true
      },
      "typeVersion": 1.9
    },
