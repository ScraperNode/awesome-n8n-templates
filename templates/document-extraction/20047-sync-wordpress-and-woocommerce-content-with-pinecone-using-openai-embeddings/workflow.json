    },
    {
      "id": "1745891b-9c45-4a6a-a184-5e56d4bba549",
      "name": "Identify Deleted Entries",
      "type": "n8n-nodes-base.code",
      "position": [
        544,
        4288
      ],
      "parameters": {
        "jsCode": "// Safety guard: only real pages/posts (with an id) count. If the list is empty (e.g. a WordPress API outage),\n// delete NOTHING - otherwise an outage could wipe the blog part of the knowledge base.\n// The requests fetch at most 100 pages and 100 posts - if the limit was reached the list may have been truncated,\n// so nothing of that type is deleted either (older items are not treated as removed).\nconst items = $('Combine Pages and Posts').all().map(it => it.json).filter(it => it && it.id != null);\nif (!items.length) { return []; }\nconst skipPages = items.filter(it => it.kind === 'page').length >= 100;\nconst skipPosts = items.filter(it => it.kind === 'post').length >= 100;\nconst liveFileIds = new Set(items.map(it => 'wc_' + it.kind + '_' + it.id));\nconst tableRows = $input.all().map(it => it.json);\nconst orphans = tableRows.filter(r => {\n  const id = String(r.productId || '');\n  if (!id) { return false; }\n  if (skipPages && id.indexOf('wc_page_') === 0) { return false; }\n  if (skipPosts && id.indexOf('wc_post_') === 0) { return false; }\n  return !liveFileIds.has(id);\n});\nreturn orphans.map(o => ({ json: { fileId: o.productId } }));"
      },
      "typeVersion": 2
    },
