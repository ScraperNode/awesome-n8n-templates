    {
      "id": "e2ee69f2-6002-40b6-8231-7b3411e83130",
      "name": "Work out last month",
      "type": "n8n-nodes-base.code",
      "position": [
        1840,
        352
      ],
      "parameters": {
        "jsCode": "// Every later node needs the same three strings. Work them out once here\n// instead of repeating the same date maths inside several expressions.\nconst cfg = $('Set config').first().json;\nconst now = new Date();\nconst d = new Date(now.getFullYear(), now.getMonth() - 1, 1);\n\nconst monthLabel = d.toLocaleDateString('en-US', { month: 'long', year: 'numeric' }); // March 2026\nconst folderName = d.getFullYear() + '-' + String(d.getMonth() + 1).padStart(2, '0'); // 2026-03\n\nreturn [{\n  json: {\n    monthLabel,\n    folderName,\n    archiveName: monthLabel + ' - ' + cfg.archiveSuffix,\n    ranAt: now.toISOString().slice(0, 16).replace('T', ' '),\n  }\n}];\n"
      },
      "typeVersion": 2
    },
    {
