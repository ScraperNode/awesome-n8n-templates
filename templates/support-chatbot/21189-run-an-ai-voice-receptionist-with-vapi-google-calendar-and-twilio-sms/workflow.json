      "name": "Missed Call Check",
      "type": "n8n-nodes-base.code",
      "position": [
        -880,
        2000
      ],
      "parameters": {
        "jsCode": "\nconst body = $input.first().json.body || {};\nconst m = body.message || {};\nif (m.type !== 'end-of-call-report') return [{ json: { missed: false, reason: 'not an end-of-call-report' } }];\nconst call = m.call || {};\nconst to = call.customer && call.customer.number;\nconst isPhoneCall = call.type === 'inboundPhoneCall';\nconst msgs = (m.artifact && m.artifact.messages) || m.messages || [];\nconst userSpoke = msgs.some(x => x.role === 'user' && String(x.message || x.content || '').trim().length > 0);\nconst from = (call.phoneNumber && call.phoneNumber.number) || 'YOUR_TWILIO_PHONE_NUMBER';\nconst missed = Boolean(isPhoneCall && to && !userSpoke);\nreturn [{ json: { missed, to, from, reason: missed ? 'caller hung up without speaking' : 'caller spoke or not a phone call' } }];\n"
      },
      "typeVersion": 2
    },
