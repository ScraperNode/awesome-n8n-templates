        "jsonBody": "={{ JSON.stringify({ model: 'claude-haiku-4-5-20251001', max_tokens: 200, messages: [{ role: 'user', content: 'Write a LinkedIn connection note. Person headline: ' + $json.headline + '. Company: ' + $json.company + '. Their post about attending the event: ' + $json.matched_post + '. Our offer: ' + $(\"Event Config\").first().json.offer + '. Rules: under 300 characters, reference their specific reason or excitement for attending from their own post, mention meeting up at the event if it reads naturally, warm tone, first person, no hard pitch. Return raw JSON only with key: note string.' }] }) }}",
