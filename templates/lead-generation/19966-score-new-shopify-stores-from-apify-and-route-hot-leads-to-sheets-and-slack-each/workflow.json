    {
      "id": "eafc8bb8-8ff4-50c0-bae6-a53d373c1f12",
      "name": "Save cursor",
      "type": "n8n-nodes-base.code",
      "position": [
        1720,
        180
      ],
      "parameters": {
        "jsCode": "// Runs after the Sheets write: the cursor moves only once stores are safely logged.\nconst seen = $('Score each store').all().map(i => Number(i.json.cursor)).filter(Number.isFinite);\nif (seen.length) {\n  const data = $getWorkflowStaticData('global');\n  data.cursor = String(Math.max(Number(data.cursor) || 0, ...seen));\n}\nreturn [{ json: { cursor: $getWorkflowStaticData('global').cursor ?? null, stores: seen.length } }];"
      },
      "typeVersion": 2
    },
