{
  "name": "Monitor competitor pricing pages nightly and alert only on real changes",
  "nodes": [
    {
      "id": "a1000000-0000-4000-8000-000000000001",
      "name": "Nightly at 2 AM",
      "type": "n8n-nodes-base.scheduleTrigger",
      "position": [
        0,
        300
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 2 * * *"
            }
          ]
        }
      },
      "typeVersion": 1.2
    },
    {
      "id": "a1000000-0000-4000-8000-000000000002",
      "name": "Pages to watch",
      "type": "n8n-nodes-base.set",
      "position": [
        220,
        300
      ],
      "parameters": {
        "options": {},
        "assignments": {
          "assignments": [
            {
              "id": "b1+12345678900-+1234567890",
              "name": "urls",
              "type": "array",
              "value": "=[\"https://www.pinecone.io/pricing/\", \"https://www.g2.com/products/notion/pricing\"]"
            }
          ]
        }
      },
      "typeVersion": 3.4
    },
    {
      "id": "a1000000-0000-4000-8000-000000000003",
      "name": "One item per page",
      "type": "n8n-nodes-base.splitOut",
      "position": [
        440,
        300
      ],
      "parameters": {
        "options": {
          "destinationFieldName": "url"
        },
        "fieldToSplitOut": "urls"
      },
      "typeVersion": 1
    },
    {
      "id": "a1000000-0000-4000-8000-000000000004",
      "name": "Read page (EnConvert)",
      "type": "@enconvert/n8n-nodes-enconvert.enconvert",
      "onError": "continueRegularOutput",
      "position": [
        660,
        300
      ],
      "parameters": {
        "url": "={{ $json.url }}",
        "options": {
          "onlyMainContent": true
        },
        "outputs": [
          "markdown"
        ],
        "resource": "webPage",
        "operation": "scrape"
      },
      "credentials": {
        "enconvertApi": {
          "id": "credential-id",
          "name": "EnConvert account"
        }
      },
      "typeVersion": 1
    },
    {
      "id": "a1000000-0000-4000-8000-000000000005",
      "name": "Page readable? (quality gate)",
      "type": "n8n-nodes-base.if",
      "position": [
        880,
        300
      ],
      "parameters": {
        "options": {},
        "conditions": {
          "options": {
            "version": 2,
            "leftValue": "",
            "caseSensitive": true,
            "typeValidation": "loose"
          },
          "combinator": "and",
          "conditions": [
            {
              "id": "c1+12345678900-+1234567890",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              },
              "leftValue": "={{ $json.renderQuality >= 0.4 && !$json.isBlocked && !$json.error }}",
              "rightValue": ""
            }
          ]
        }
      },
      "typeVersion": 2.2
    },
    {
      "id": "a1000000-0000-4000-8000-000000000006",
      "name": "Fingerprint content",
      "type": "n8n-nodes-base.crypto",
      "position": [
        1220,
        200
      ],
      "parameters": {
        "type": "SHA256",
        "value": "={{ $json.markdown }}",
        "dataPropertyName": "contentHash"
      },
      "typeVersion": 2
    },
    {
      "id": "a1000000-0000-4000-8000-000000000008",
      "name": "Changed since last run?",
      "type": "n8n-nodes-base.if",
      "position": [
        1440,
        200
      ],
      "parameters": {
        "options": {},
        "conditions": {
          "options": {
            "version": 2,
            "leftValue": "",
            "caseSensitive": true,
            "typeValidation": "loose"
          },
          "combinator": "and",
          "conditions": [
            {
              "id": "c1+12345678900-+1234567890",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              },
              "leftValue": "={{ $('All snapshots').all().some(r => r.json.url === $json.url && !!r.json.content_hash && r.json.content_hash !== $json.contentHash) }}",
              "rightValue": ""
            }
          ]
        }
      },
      "typeVersion": 2.2
    },
    {
      "id": "a1000000-0000-4000-8000-000000000009",
      "name": "Alert: page changed",
      "type": "n8n-nodes-base.dataTable",
      "position": [
        1660,
        80
      ],
      "parameters": {
        "columns": {
          "value": {
            "url": "={{ $json.url }}",
            "event": "changed",
            "detail": "=Content changed since {{ $('All snapshots').all().find(r => r.json.url === $json.url)?.json.checked_at }}. New text starts: {{ ($json.markdown || '').slice(0, 300) }}",
            "render_quality": "={{ $json.renderQuality }}"
          },
          "schema": [
            {
              "id": "url",
              "type": "string",
              "display": true,
              "required": false,
              "displayName": "url",
              "defaultMatch": false,
              "canBeUsedToMatch": true
            },
            {
              "id": "event",
              "type": "string",
              "display": true,
              "required": false,
              "displayName": "event",
              "defaultMatch": false,
              "canBeUsedToMatch": true
            },
            {
              "id": "render_quality",
              "type": "number",
              "display": true,
              "required": false,
              "displayName": "render_quality",
              "defaultMatch": false,
              "canBeUsedToMatch": true
            },
            {
              "id": "detail",
              "type": "string",
              "display": true,
              "required": false,
              "displayName": "detail",
              "defaultMatch": false,
              "canBeUsedToMatch": true
            }
          ],
          "mappingMode": "defineBelow",
          "matchingColumns": []
        },
        "options": {},
        "resource": "row",
        "operation": "insert",
        "dataTableId": {
          "__rl": true,
          "mode": "name",
          "value": "enconvert_alerts"
        }
      },
      "typeVersion": 1.1
    },
    {
      "id": "a1000000-0000-4000-8000-000000000010",
      "name": "Save snapshot",
      "type": "n8n-nodes-base.dataTable",
      "position": [
        1880,
        200
      ],
      "parameters": {
        "columns": {
          "value": {
            "url": "={{ $('Fingerprint content').item.json.url }}",
            "checked_at": "={{ $now.toISO() }}",
            "content_hash": "={{ $('Fingerprint content').item.json.contentHash }}",
            "render_quality": "={{ $('Fingerprint content').item.json.renderQuality }}"
          },
          "schema": [
            {
              "id": "url",
              "type": "string",
              "display": true,
              "required": false,
              "displayName": "url",
              "defaultMatch": false,
              "canBeUsedToMatch": true
            },
            {
              "id": "content_hash",
              "type": "string",
              "display": true,
              "required": false,
              "displayName": "content_hash",
              "defaultMatch": false,
              "canBeUsedToMatch": true
            },
            {
              "id": "render_quality",
              "type": "number",
              "display": true,
              "required": false,
              "displayName": "render_quality",
              "defaultMatch": false,
              "canBeUsedToMatch": true
            },
            {
              "id": "checked_at",
              "type": "string",
              "display": true,
              "required": false,
              "displayName": "checked_at",
              "defaultMatch": false,
              "canBeUsedToMatch": true
            }
          ],
          "mappingMode": "defineBelow",
          "matchingColumns": []
        },
        "filters": {
          "conditions": [
            {
              "keyName": "url",
              "keyValue": "={{ $('Fingerprint content').item.json.url }}",
              "condition": "eq"
            }
          ]
        },
        "options": {},
        "resource": "row",
        "matchType": "allConditions",
        "operation": "upsert",
        "dataTableId": {
          "__rl": true,
          "mode": "name",
          "value": "enconvert_snapshots"
        }
      },
      "typeVersion": 1.1
    },
    {
      "id": "a1000000-0000-4000-8000-000000000011",
      "name": "Alert: skipped, page blocked",
      "type": "n8n-nodes-base.dataTable",
      "position": [
        1220,
        440
      ],
      "parameters": {
        "columns": {
          "value": {
            "url": "={{ $json.url || $('One item per page').item.json.url }}",
            "event": "skipped_blocked",
            "detail": "=Skipped, page not readable (render_quality {{ $json.renderQuality ?? 'n/a' }}{{ $json.isBlocked ? ', blocked' : '' }}). {{ $json.error || ($json.warnings || []).join('; ') }}",
            "render_quality": "={{ $json.renderQuality ?? 0 }}"
          },
          "schema": [
            {
              "id": "url",
              "type": "string",
              "display": true,
              "required": false,
              "displayName": "url",
              "defaultMatch": false,
              "canBeUsedToMatch": true
            },
            {
              "id": "event",
              "type": "string",
              "display": true,
              "required": false,
              "displayName": "event",
              "defaultMatch": false,
              "canBeUsedToMatch": true
            },
            {
              "id": "render_quality",
              "type": "number",
              "display": true,
              "required": false,
              "displayName": "render_quality",
              "defaultMatch": false,
              "canBeUsedToMatch": true
            },
            {
              "id": "detail",
              "type": "string",
              "display": true,
              "required": false,
              "displayName": "detail",
              "defaultMatch": false,
              "canBeUsedToMatch": true
            }
          ],
          "mappingMode": "defineBelow",
          "matchingColumns": []
        },
        "options": {},
        "resource": "row",
        "operation": "insert",
        "dataTableId": {
          "__rl": true,
          "mode": "name",
          "value": "enconvert_alerts"
        }
      },
      "typeVersion": 1.1
    },
    {
      "id": "a1000000-0000-4000-8000-000000000007",
      "name": "All snapshots",
      "type": "n8n-nodes-base.dataTable",
      "position": [
        440,
        120
      ],
      "parameters": {
        "resource": "row",
        "operation": "get",
        "returnAll": true,
        "dataTableId": {
          "__rl": true,
          "mode": "name",
          "value": "enconvert_snapshots"
        }
      },
      "executeOnce": true,
      "typeVersion": 1.1,
      "alwaysOutputData": true
    },
    {
      "id": "a1000000-0000-4000-8000-000000000012",
      "name": "Sticky Note",
      "type": "n8n-nodes-base.stickyNote",
      "position": [
        -620,
        -40
      ],
      "parameters": {
        "width": 520,
        "height": 440,
        "content": "## Monitor competitor pricing pages\n\nEvery night EnConvert reads each page and scores it: `renderQuality` (0 to 1) and `isBlocked`.\n\nThe quality gate keeps Cloudflare challenges, login walls and error pages out of the comparison, so you never get a false \"price changed\" alert at 2 a.m.\n\n### Setup\n1. Add an **EnConvert API** credential with your private `sk_live_...` key.\n2. Create two Data Tables:\n   - `enconvert_snapshots`: url, content_hash, checked_at (string), render_quality (number)\n   - `enconvert_alerts`: url, event, detail (string), render_quality (number)\n3. List your pages in **Pages to watch**.\n4. Optional: swap the two Alert nodes for Slack or Email.\n\nThe first run saves a baseline and sends no alert."
      },
      "typeVersion": 1
    },
    {
      "id": "a1000000-0000-4000-8000-000000000013",
      "name": "Sticky Note1",
      "type": "n8n-nodes-base.stickyNote",
      "position": [
        -60,
        -40
      ],
      "parameters": {
        "color": 7,
        "width": 1120,
        "height": 680,
        "content": "### 1. Read and score each page\nEnConvert returns the page as clean markdown. Pages scoring under 0.4, or flagged as blocked, go to the skipped log."
      },
      "typeVersion": 1
    },
    {
      "id": "a1000000-0000-4000-8000-000000000014",
      "name": "Sticky Note2",
      "type": "n8n-nodes-base.stickyNote",
      "position": [
        1100,
        -40
      ],
      "parameters": {
        "color": 7,
        "width": 940,
        "height": 680,
        "content": "### 2. Compare and log\nA SHA256 fingerprint of the page is compared with last night's. A different fingerprint logs a change; every readable page updates its snapshot."
      },
      "typeVersion": 1
    }
  ],
  "pinData": {},
  "settings": {
    "executionOrder": "v1"
  },
  "connections": {
    "Pages to watch": {
      "main": [
        [
          {
            "node": "All snapshots",
            "type": "main",
            "index": 0
          },
          {
            "node": "One item per page",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Nightly at 2 AM": {
      "main": [
        [
          {
            "node": "Pages to watch",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "One item per page": {
      "main": [
        [
          {
            "node": "Read page (EnConvert)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Alert: page changed": {
      "main": [
        [
          {
            "node": "Save snapshot",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fingerprint content": {
      "main": [
        [
          {
            "node": "Changed since last run?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Read page (EnConvert)": {
      "main": [
        [
          {
            "node": "Page readable? (quality gate)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Changed since last run?": {
      "main": [
        [
          {
            "node": "Alert: page changed",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Save snapshot",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Page readable? (quality gate)": {
      "main": [
        [
          {
            "node": "Fingerprint content",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Alert: skipped, page blocked",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}