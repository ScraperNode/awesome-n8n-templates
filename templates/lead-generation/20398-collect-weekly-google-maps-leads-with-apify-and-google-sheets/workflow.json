{
  "name": "Weekly Google Maps leads filtered by AI \u2192 Google Sheets",
  "nodes": [
    {
      "name": "Notes",
      "type": "n8n-nodes-base.stickyNote",
      "position": [
        0,
        -20
      ],
      "parameters": {
        "width": 480,
        "height": 300,
        "content": "## Weekly local leads, filtered by AI\n\n1. Edit the **Config** node: business type, location and a plain-words description of your ideal client.\n2. In **Run Apify actor**, add a Header Auth credential: name `Authorization`, value `Bearer YOUR_APIFY_TOKEN`.\n3. In **Add to Google Sheets**, pick your spreadsheet and sheet.\n\nOnly businesses matching your description are returned, each with a checked email. You pay per lead delivered. Free Apify accounts: 10 leads per run.\n\nActor: https://apify.com/scoutforge/google-maps-leads"
      },
      "typeVersion": 1
    },
    {
      "name": "Every Monday",
      "type": "n8n-nodes-base.scheduleTrigger",
      "position": [
        560,
        120
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "weeks",
              "triggerAtDay": [
                1
              ],
              "triggerAtHour": 8
            }
          ]
        }
      },
      "typeVersion": 1.2
    },
    {
      "name": "Config",
      "type": "n8n-nodes-base.set",
      "position": [
        780,
        120
      ],
      "parameters": {
        "options": {},
        "assignments": {
          "assignments": [
            {
              "id": "1",
              "name": "searchQuery",
              "type": "string",
              "value": "heating engineer"
            },
            {
              "id": "2",
              "name": "location",
              "type": "string",
              "value": "Annecy, France"
            },
            {
              "id": "3",
              "name": "targetDescription",
              "type": "string",
              "value": "Independent heating engineers and plumbers, not large chains or shops"
            },
            {
              "id": "4",
              "name": "maxLeads",
              "type": "number",
              "value": 25
            }
          ]
        }
      },
      "typeVersion": 3.4
    },
    {
      "name": "Run Apify actor",
      "type": "n8n-nodes-base.httpRequest",
      "position": [
        1000,
        120
      ],
      "parameters": {
        "url": "https://api.apify.com/v2/acts/scoutforge~google-maps-leads/run-sync-get-dataset-items",
        "method": "POST",
        "options": {
          "timeout": 300000
        },
        "jsonBody": "={{ JSON.stringify({ searchQueries: [$json.searchQuery], location: $json.location, targetDescription: $json.targetDescription, maxLeads: $json.maxLeads, onlyNew: true, projectName: 'n8n-weekly' }) }}",
        "sendBody": true,
        "specifyBody": "json",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth"
      },
      "typeVersion": 4.2
    },
    {
      "name": "Add to Google Sheets",
      "type": "n8n-nodes-base.googleSheets",
      "position": [
        1220,
        120
      ],
      "parameters": {
        "columns": {
          "value": {},
          "schema": [],
          "mappingMode": "autoMapInputData",
          "matchingColumns": []
        },
        "options": {},
        "operation": "append",
        "sheetName": {
          "__rl": true,
          "mode": "list",
          "value": ""
        },
        "documentId": {
          "__rl": true,
          "mode": "list",
          "value": ""
        }
      },
      "typeVersion": 4.5
    }
  ],
  "settings": {
    "executionOrder": "v1"
  },
  "connections": {
    "Config": {
      "main": [
        [
          {
            "node": "Run Apify actor",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Every Monday": {
      "main": [
        [
          {
            "node": "Config",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Run Apify actor": {
      "main": [
        [
          {
            "node": "Add to Google Sheets",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}