      "parameters": {
        "schemaType": "manual",
        "inputSchema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"category\": { \"type\": \"string\", \"enum\": [\"Academic\", \"Discipline_Pastoral\", \"Transport\", \"Accounts_Billing\", \"Campus_Safety_Health\", \"Executive_Legal\"] },\n    \"sub_category\": { \"type\": \"string\" },\n    \"severity\": { \"type\": \"string\", \"enum\": [\"P0\", \"P1\", \"P2\", \"P3\"] },\n    \"is_regulatory_risk\": { \"type\": \"boolean\" },\n    \"vent_summary\": { \"type\": \"string\" },\n    \"attachment_relevant_findings\": { \"type\": \"string\" },\n    \"reasoning\": { \"type\": \"string\" }\n  },\n  \"required\": [\"category\", \"sub_category\", \"severity\", \"is_regulatory_risk\", \"vent_summary\", \"attachment_relevant_findings\", \"reasoning\"]\n}"
      },
      "typeVersion": 1.2
    },
    {
      "id": "3a0437bb-4726-4c4f-899c-cebd730750a6",
      "name": "Classify Complaint with Gemini",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "position": [
        2256,
        272
      ],
      "parameters": {
        "text": "=You are the triage classifier and first reader for a school's Parent Grievance system. A parent has written freely about what happened - read the whole thing, don't just skim the first sentence.\n\nSeverity matrix:\nP0 (Critical): student safety, harassment (POCSO/Title IX), severe bullying, physical injury, severe transport accidents, legal threats.\nP1 (High): staff misconduct, grading manipulation, systemic transport delays, discriminatory remarks, food safety/health.\nP2 (Medium): disputed fee penalties, report card errors, missing homework feedback, facility breakdowns (e.g. HVAC).\nP3 (Low): portal access issues, uniform sizing, non-urgent scheduling.\n\nCategories: Academic, Discipline_Pastoral, Transport, Accounts_Billing, Campus_Safety_Health, Executive_Legal.\n\nParent's account, verbatim:{{ $json['Parent Name'] }}\n\nParent Written Issue:\n{{ $json['Tell us what happened'] }}\n\nStudent Name: {{ $json.student_name }}\nStudent ID: {{ $json.studentid }}\n\nAttachment provided: {{ $json.has_attachment }}\n{{ $json.has_attachment ? 'An image is attached below - actually look at it and factor what you see into your classification and findings.' : 'No usable attachment was provided (either nothing was uploaded, or the file was rejected: ' + ($json.attachment_rejected_reason || 'n/a') + '). The image below is a blank placeholder - ignore it.' }}\n\nReturn category, sub_category, severity, is_regulatory_risk, vent_summary (1-2 neutral sentences for a human reviewer skimming quickly), attachment_relevant_findings (what you actually saw in the image, or 'No attachment provided'), and reasoning (one sentence).",
        "messages": {
          "messageValues": [
            {
              "type": "HumanMessagePromptTemplate",
              "messageType": "imageBinary",
              "binaryImageDataKey": "VisionInput"
            }
          ]
        },
        "promptType": "define",
        "hasOutputParser": true
      },
      "typeVersion": 1.5
    },
