    {
      "id": "934b43e1-03b4-4528-8a3c-c175d09a7bda",
      "name": "Prepare Jev request",
      "type": "n8n-nodes-base.code",
      "position": [
        -2992,
        240
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const message = $json;\nconst headers = message.payload?.headers || [];\nconst header = name => headers.find(h => h.name?.toLowerCase() === name)?.value || '';\nfunction decode(data) {\n  try { return Buffer.from(data.replace(/-/g, '+').replace(/_/g, '/'), 'base64').toString('utf8'); }\n  catch { return ''; }\n}\nfunction findPart(part, mimeType) {\n  if (!part) return '';\n  if (part.mimeType === mimeType && part.body?.data) return decode(part.body.data);\n  for (const child of part.parts || []) {\n    const content = findPart(child, mimeType);\n    if (content) return content;\n  }\n  return '';\n}\nlet body = findPart(message.payload, 'text/plain') ||\n  findPart(message.payload, 'text/html').replace(/<[^>]*>/g, ' ') || message.snippet || '';\nbody = body.replace(/\\s+/g, ' ').trim().slice(0, 12000);\nconst sender = header('from') || message.from || '';\nconst subject = header('subject') || message.subject || '';\nconst questions = {\n  project: {type: 'choice', instructions: 'Which of Davide\u2019s activities does this email concern? Choose other if uncertain.', criteria: {\n    your_title: 'Your description',\n    administration: 'Invoices, payments, contracts, bookkeeping, and suppliers.',\n    personal: 'Private, non-work matters.',\n    other: 'None of the other project categories clearly applies.'\n  }},\n  type: {type: 'choice', instructions: 'What is the main purpose of this email?', criteria: {\n    request: 'A question or request that may need an answer.',\n    proposal: 'A business proposal or new opportunity.',\n    support: 'A problem report or support request.',\n    administrative: 'A payment, invoice, contract, or administrative document.',\n    notification: 'An informational update or automated notification.',\n    promotion: 'A newsletter, advertisement, or promotion.',\n    other: 'Another type of message.'\n  }},\n  priority: {type: 'choice', instructions: 'Assess urgency only from explicit content. Do not invent deadlines.', criteria: {\n    high: 'An operational blocker, a stated imminent deadline, or a concrete urgent request.',\n    medium: 'An actionable request with no imminent deadline.',\n    low: 'Informational or promotional content with no near-term action required.'\n  }},\n  needsReply: {type: 'noul', instructions: 'Does the sender plausibly expect a personal reply from Davide?', criteria: {\n    true: 'A question, request, proposal, or problem calls for a reply.',\n    false: 'A newsletter, automated alert, simple confirmation, or informational update.'\n  }}\n};\nreturn {json: {\n  messageId: message.id,\n  threadId: message.threadId,\n  sender,\n  subject,\n  date: new Date(Number(message.internalDate) || Date.now()).toISOString(),\n  body,\n  jevRequest: {model: 'typesafe/jev-1.13', state: {sender, subject, body}, questions}\n}};"
      },
      "typeVersion": 2
    },
