    {
      "id": "d4d3a0c6-4297-481c-b67c-85df8f70dc3c",
      "name": "Determine file chunks",
      "type": "n8n-nodes-base.code",
      "position": [
        240,
        656
      ],
      "parameters": {
        "jsCode": "const items = $input.all();\n\nreturn items.map(item => {\n  const CHUNK_SIZE = 20;\n\n  const totalPages = \n    item.json.pageCount ||\n    item.json.PageCount ||\n    item.json.page_count ||\n    item.json.total_pages ||\n    item.json.pages ||\n    item.json.TotalPages;\n  \n  const pdfUrl = item.json.url || '';\n  const sourceName = item.json.name;\n\n  const allKeys = Object.keys(item.json);\n  const allValues = {};\n  allKeys.forEach(k => { allValues[k] = item.json[k]; });\n\n  \n  \n  if (totalPages === 0) {\n    return {\n      json: {\n        debug_all_fields: allValues,\n        error: 'Page count not found in any field',\n        url: pdfUrl,\n        source_name: sourceName,\n        pages_string: '1-20',\n        total_chunks: 1\n      }\n    };\n  }\n\n  const chunks = [];\n  for (let start = 1; start <= totalPages; start += CHUNK_SIZE) {\n    const end = Math.min(start + CHUNK_SIZE - 1, totalPages);\n    chunks.push(start + '-' + end);\n  }\n\n  return {\n    json: {\n      url: pdfUrl,\n      source_name: sourceName,\n      pages_string: chunks.join(','),\n      total_chunks: chunks.length,\n      total_pages: totalPages\n    }\n  };\n});"
      },
      "typeVersion": 2
    },
