    {
      "id": "1f7eca50-0297-5c2d-8c9a-cee261c3a43d",
      "name": "Select visits to ask",
      "type": "n8n-nodes-base.code",
      "position": [
        660,
        300
      ],
      "parameters": {
        "jsCode": "\nconst cfg = $('Config').first().json;\nconst truthy = v => ['true','yes','y','1','x'].includes(String(v ?? '').trim().toLowerCase());\nconst esc = s => String(s ?? '').replace(/[&<>\"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;',\"'\":'&#39;'}[c]));\nconst now = cfg.now ? DateTime.fromISO(String(cfg.now), { setZone: true }) : DateTime.now();\nfunction parseDT(v, zone) {\n  if (v === undefined || v === null || String(v).trim() === '') return DateTime.invalid('empty');\n  const s = String(v).trim();\n  if (/[zZ]$|[+-]\\d\\d:?\\d\\d$/.test(s)) return DateTime.fromISO(s, { setZone: true });\n  let d = DateTime.fromISO(s.replace(' ', 'T'), { zone });\n  if (!d.isValid) d = DateTime.fromFormat(s, 'yyyy-MM-dd HH:mm', { zone });\n  return d;\n}\nconst rowsOf = node => $(node).all().map(i => i.json).filter(r => r && Object.keys(r).length);\n\nconst out = [];\nconst delay = Number(cfg.delay_hours) || 0, maxAge = Number(cfg.max_age_days) || 14;\nconst localNow = now.setZone(cfg.timezone || 'UTC');\nconst qs = Number(cfg.quiet_hours_start), qe = Number(cfg.quiet_hours_end);\nconst quiet = qs > qe ? (localNow.hour >= qs || localNow.hour < qe) : (localNow.hour >= qs && localNow.hour < qe);\nif (quiet) return [];\nconst optedOut = new Set(rowsOf('Read Visits').filter(r => truthy(r.opt_out)).map(r => String(r.email ?? '').trim().toLowerCase()).filter(Boolean));\nconst seen = new Set(rowsOf('Read Visits').filter(r => String(r.review_requested_at ?? '').trim()).map(r => String(r.email ?? '').trim().toLowerCase()).filter(Boolean));\nfor (const row of rowsOf('Read Visits')) {\n  const id = String(row.visit_id ?? '').trim();\n  if (!id) continue;\n  if (String(row.status ?? '').trim().toLowerCase() !== 'completed') continue;\n  if (String(row.review_requested_at ?? '').trim()) continue;\n  const em = String(row.email ?? '').trim().toLowerCase();\n  if (!/^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$/.test(em)) continue;\n  if (truthy(row.opt_out) || optedOut.has(em) || seen.has(em)) continue;\n  const end = parseDT(row.visit_end, String(row.timezone || cfg.timezone || 'UTC'));\n  if (!end.isValid) continue;\n  const age = now.diff(end, 'hours').hours;\n  if (age < delay || age > maxAge * 24) continue;\n  seen.add(em);\n  const name = String(row.client_name || 'there').trim();\n  const optout = `${cfg.optout_url}?v=${encodeURIComponent(id)}&e=${encodeURIComponent(em)}`;\n  out.push({ json: { visit_id: id, to_email: em, subject: `How was your visit to ${cfg.business_name}?`,\n    html: `<p>Hi ${esc(name)},</p><p>Thank you for visiting <b>${esc(cfg.business_name)}</b>. Would you take 30 seconds to leave us a review? It really helps a small business like ours.</p><p><a href=\"${esc(cfg.review_link)}\">Leave a review</a></p><p style=\"font-size:12px;color:#888\">Don't want these emails? <a href=\"${esc(optout)}\">Unsubscribe</a>.</p>`,\n    review_requested_at: now.toUTC().toISO() } });\n}\nreturn out;\n"
      },
      "typeVersion": 2
    },
