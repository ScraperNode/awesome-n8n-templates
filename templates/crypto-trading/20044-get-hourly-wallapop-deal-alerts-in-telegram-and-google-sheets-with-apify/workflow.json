              "value": "={{ $json.price }}"
            },
            {
              "id": "wa11a901f-+123456789003",
              "name": "Currency",
              "type": "string",
              "value": "={{ $json.currency || 'EUR' }}"
            },
            {
              "id": "wa11a901f-+123456789004",
              "name": "Brand",
