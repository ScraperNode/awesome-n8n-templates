    {
      "id": "d51c5f4a-56ff-5359-8a88-076612df1f76",
      "name": "Write the email",
      "type": "n8n-nodes-base.code",
      "position": [
        2100,
        300
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const grid = $json;\nconst { summary, previous, points_total: total } = grid;\n\n// Names come from Google Maps: escape them before putting them in HTML or Slack markup.\nconst escape = (text) => String(text ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\nconst ahead = (grid.competitors || [])\n  .filter((c) => c.ahead_points > 0)\n  .sort((a, b) => b.ahead_points - a.ahead_points)\n  .slice(0, 3)\n  .map((c) => `${escape(c.name)} (${c.ahead_points} points)`)\n  .join(', ') || 'nobody';\n\nconst average = summary.average_rank === null ? 'not in the top 20' : `${summary.average_rank} where it appears`;\nlet change = '';\nif (previous && previous.changes.average_rank !== null) {\n  const delta = previous.changes.average_rank;\n  change = delta === 0 ? ' (unchanged since the last grid)' : ` (${delta > 0 ? '+' : ''}${delta} since the last grid)`;\n}\n\nconst html = `<p><b>${escape(grid.place.name)}</b> on Google Maps for \u201c${escape(grid.keyword)}\u201d: ${grid.size} x ${grid.size} grid, ${grid.radius_km} km around the listing.</p>\n<ul>\n<li>Average rank: <b>${average}</b>${change}</li>\n<li>In the top 3 on <b>${summary.top3_points}</b> of ${total} points</li>\n<li>In the top 20 on <b>${summary.found_points}</b> of ${total} points</li>\n<li>Ranking ahead most often: ${ahead}</li>\n</ul>\n<p>The heatmap is attached. Ranks are Google Maps positions: lower is better, so a negative change means the listing moved up. Measured with GeoGridAPI.</p>`;\nconst subject = `Google Maps ranking for \u201c${grid.keyword}\u201d: top 3 on ${summary.top3_points} of ${total} points`;\n\n// Keep the PNG downloaded by the previous node.\nreturn { json: { ...grid, subject, html }, binary: $input.item.binary };"
      },
      "typeVersion": 2
    },
    {
      "id": "2e14a34f-2833-5d60-8445-bfdf71cc8a4e",
      "name": "Email the report",
      "type": "n8n-nodes-base.gmail",
      "position": [
        2320,
        300
      ],
      "parameters": {
        "sendTo": "={{ $('Settings').first().json.sendTo }}",
        "message": "={{ $json.html }}",
        "options": {
          "attachmentsUi": {
            "attachmentsBinary": [
              {
                "property": "data"
              }
            ]
          }
        },
        "subject": "={{ $json.subject }}",
        "emailType": "html"
      },
      "credentials": {
        "gmailOAuth2": {
          "id": "gmail-account",
          "name": "Gmail account"
        }
      },
      "typeVersion": 2.1
    }
  ],
