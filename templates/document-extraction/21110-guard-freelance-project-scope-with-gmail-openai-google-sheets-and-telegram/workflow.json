    {
      "id": "bf13ccf4-81dc-4fe7-8d21-470ac3df1041",
      "name": "Section: Change Order",
      "type": "n8n-nodes-base.stickyNote",
      "position": [
        1180,
        20
      ],
      "parameters": {
        "color": 3,
        "width": 620,
        "height": 300,
        "content": "### 5 | Change-order draft\nAI writes a warm-but-firm email quoting your scope clause, hours, and cost. It goes to YOU for review, never straight to the client."
      },
      "typeVersion": 1
    },
    {
      "id": "06c9f416-215a-45c4-9e82-bf6c9bd33bcb",
      "name": "Draft Change-Order Email",
      "type": "n8n-nodes-base.openAi",
      "position": [
        1240,
        200
      ],
      "parameters": {
        "prompt": {
          "messages": [
            {
              "role": "system",
              "content": "You are a warm but firm freelance business coach. Draft a short change-order email the freelancer will review before sending. Tone: friendly, professional, no guilt, no over-apologizing. Structure: thank them, quote the relevant scope clause, name the extra work with hours, state the additional cost, ask for written approval to proceed. Plain text only, no placeholders like [NAME]."
            },
            {
              "role": "user",
              "content": "={{ 'Client: ' + $json.clientEmail + '\\nOriginal subject: ' + $json.subject + '\\nRequest summary: ' + $json.bodySnippet + '\\nScope clause: ' + $json.sowClause + '\\nExtra hours: ' + $json.estimatedHours + '\\nExtra cost: ' + $json.currency + ' ' + $json.estimatedCost + '\\nFreelancer name: ' + $('Workflow Configuration').first().json.freelancerName }}"
            }
          ]
        },
        "options": {},
        "resource": "chat",
        "chatModel": "gpt-4o-mini",
        "operation": "complete",
        "simplifyOutput": false
      },
      "credentials": {},
      "typeVersion": 1.1
    },
    {
      "id": "faea47d2-cc3b-47d8-933a-7917f30d5c72",
      "name": "Send Draft to Freelancer",
      "type": "n8n-nodes-base.gmail",
      "position": [
        1520,
        200
      ],
      "parameters": {
        "message": "={{ 'Hi,\\n\\nThe scope guard flagged this client request as OUT OF SCOPE. Review the draft below, edit as needed, then send it to the client yourself.\\n\\n--- DRAFT ---\\n' + $('Draft Change-Order Email').first().json.message.content + '\\n--- END DRAFT ---\\n\\nClassification confidence: ' + $('Parse AI Classification').first().json.confidence + '%\\nEstimated extra cost: ' + $('Parse AI Classification').first().json.currency + ' ' + $('Parse AI Classification').first().json.estimatedCost }}",
        "options": {
          "sendTo": "={{ $('Workflow Configuration').first().json.freelancerEmail }}"
        },
        "subject": "={{ '[REVIEW] Change-order draft: ' + $('Parse AI Classification').first().json.subject }}",
        "resource": "message",
        "emailType": "text",
        "operation": "send"
      },
      "credentials": {},
      "typeVersion": 2.1
    },
    {
