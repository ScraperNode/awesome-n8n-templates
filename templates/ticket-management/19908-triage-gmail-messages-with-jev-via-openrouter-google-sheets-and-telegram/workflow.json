        }
      },
      "typeVersion": 4.2
    },
    {
      "id": "5dfbee7f-6ce1-4893-b462-d2c0065224ea",
      "name": "Prepare result",
      "type": "n8n-nodes-base.code",
      "position": [
        -2544,
        240
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const source = $('Prepare Jev request').item.json;\nconst answers = $json.answers;\nif (!answers?.project?.choice || !answers?.type?.choice || !answers?.priority?.choice ||\n    typeof answers?.needsReply?.noul !== 'number') {\n  throw new Error('Incomplete Jev response');\n}\nconst needsReview = Math.min(\n  answers.project.confidence ?? 0,\n  answers.type.confidence ?? 0,\n  answers.priority.confidence ?? 0\n) < 0.6 || (answers.needsReply.noul > 0.35 && answers.needsReply.noul < 0.65);\nconst category = needsReview ? 'needs_review' : answers.project.choice;\n// Replace these values with existing Gmail label IDs before enabling the workflow.\nconst labelMap = {\n  your_title: 'REPLACE_WITH_YOUR_TITLE_LABEL_ID',\n  administration: 'REPLACE_WITH_ADMINISTRATION_LABEL_ID',\n  personal: 'REPLACE_WITH_PERSONAL_LABEL_ID',\n  other: 'REPLACE_WITH_OTHER_LABEL_ID',\n  needs_review: 'REPLACE_WITH_NEEDS_REVIEW_LABEL_ID'\n};\nconst projectNames = {your_title: 'Your Title',\n  administration: 'Administration', personal: 'Personal', other: 'Other'};\nconst typeNames = {request: 'Request', proposal: 'Proposal', support: 'Support',\n  administrative: 'Administrative', notification: 'Notification',\n  promotion: 'Promotion', other: 'Other'};\nconst priorityNames = {high: 'High', medium: 'Medium', low: 'Low'};\nconst safe = value => /^[=+@\\-\\t\\r]/.test(String(value)) ? \"'\" + value : String(value);\nconst gmailLink = 'https://mail.google.com/mail/u/0/#all/' + source.threadId;\nreturn {json: {\n  'Date': source.date,\n  'Sender': safe(source.sender.value[0].address),\n  'Subject': safe(source.subject),\n  'Project': projectNames[answers.project.choice] || 'Other',\n  'Type': typeNames[answers.type.choice] || 'Other',\n  'Priority': priorityNames[answers.priority.choice] || 'Low',\n  'Needs reply': answers.needsReply.noul >= 0.65 ? 'Yes' :\n    answers.needsReply.noul <= 0.35 ? 'No' : 'Review',\n  'Project confidence': answers.project.confidence ?? 0,\n  'Reply probability': answers.needsReply.noul,\n  'Needs review': needsReview ? 'Yes' : 'No',\n  'Gmail link': gmailLink,\n  'Message ID': source.messageId,\n  'Cost USD': $json.usage?.cost ?? 0,\n  'Status': 'To do',\n  labelId: labelMap[category],\n  alert: !needsReview && answers.priority.choice === 'high',\n  telegramText: '\ud83d\udce9 Urgent email \u00b7 ' + (projectNames[answers.project.choice] || 'Other') +\n    '\\n' + source.subject + '\\nFrom: ' + source.sender + '\\n' + gmailLink\n}};"
      },
      "typeVersion": 2
    },
