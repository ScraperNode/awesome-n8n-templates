      "alwaysOutputData": true
    },
    {
      "id": "b7d2084f-c306-404c-9bdb-4c1ed2499162",
      "name": "Decide Alert",
      "type": "n8n-nodes-base.code",
      "position": [
        2520,
        400
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const previousByKey = new Map();\nfor (const item of $input.all()) {\n  const row = item.json;\n  if (!row.monitor_key) continue;\n  const existing = previousByKey.get(row.monitor_key);\n  if (!existing || String(row.checked_at || '') > String(existing.checked_at || '')) {\n    previousByKey.set(row.monitor_key, row);\n  }\n}\nreturn $('Collect Check Results').all().map(item => {\nconst current = item.json;\nconst previous = previousByKey.get(current.monitor_key) ?? {};\n\nconst previousStatus = previous.status || \"\";\nconst currentStatus = current.status;\n\nconst previousWasIncident = previousStatus === \"DOWN\" || previousStatus === \"SLOW\";\nconst currentIsIncident = currentStatus === \"DOWN\" || currentStatus === \"SLOW\";\n\nlet incidentStartedAt = \"\";\n\nif (currentIsIncident) {\n  if (previousWasIncident && previous.incident_started_at) {\n    incidentStartedAt = previous.incident_started_at;\n  } else {\n    incidentStartedAt = current.checked_at;\n  }\n}\n\nlet shouldAlert = false;\nlet alertKind = \"\";\nlet incidentDurationSeconds = 0;\n\n// First ever check: only alert if unhealthy.\nif (!previousStatus) {\n  if (currentIsIncident) {\n    shouldAlert = true;\n    alertKind = currentStatus;\n  }\n} else if (previousStatus !== currentStatus) {\n  shouldAlert = true;\n\n  if (currentStatus === \"UP\" && previousWasIncident) {\n    alertKind = \"RECOVERED\";\n    const started = previous.incident_started_at\n      ? Date.parse(previous.incident_started_at)\n      : NaN;\n\n    if (!Number.isNaN(started)) {\n      incidentDurationSeconds = Math.max(\n        0,\n        Math.round((Date.parse(current.checked_at) - started) / 1000)\n      );\n    }\n  } else {\n    alertKind = currentStatus;\n  }\n}\n\nfunction humanDuration(totalSeconds) {\n  const h = Math.floor(totalSeconds / 3600);\n  const m = Math.floor((totalSeconds % 3600) / 60);\n  const s = totalSeconds % 60;\n  const parts = [];\n  if (h) parts.push(`${h}h`);\n  if (m) parts.push(`${m}m`);\n  if (s) parts.push(`${s}s`);\n  return parts.join(\" \");\n}\n\nlet icon = \"i\ufe0f\";\nlet title = currentStatus;\n\nif (alertKind === \"DOWN\") {\n  icon = \"\ud83d\udd34\";\n  title = \"WEBSITE DOWN\";\n} else if (alertKind === \"SLOW\") {\n  icon = \"\ud83d\udfe1\";\n  title = \"WEBSITE SLOW\";\n} else if (alertKind === \"RECOVERED\") {\n  icon = \"\ud83d\udfe2\";\n  title = \"WEBSITE RECOVERED\";\n}\n\nconst durationText = incidentDurationSeconds\n  ? `\nIncident duration: ${humanDuration(incidentDurationSeconds)}`\n  : \"\";\n\nconst errorText = current.error_message\n  ? `\nError: ${current.error_message}`\n  : \"\";\n\nconst alertMessage =\n`${icon} ${title}\n\nWebsite: ${current.name}\nURL: ${current.url}\nStatus: ${current.status}\nHTTP: ${current.status_code || \"Connection failed\"}\nResponse: ${current.response_ms} ms\nChecked: ${current.checked_at}${durationText}${errorText}`;\n\nreturn {\n  json: {\n    ...current,\n    previous_status: previousStatus,\n    incident_started_at: incidentStartedAt,\n    should_alert: shouldAlert,\n    alert_kind: alertKind,\n    incident_duration_seconds: incidentDurationSeconds,\n    alert_message: alertMessage.slice(0, 3500)\n  }\n};\n});\n"
      },
      "notesInFlow": false,
      "typeVersion": 2
    },
