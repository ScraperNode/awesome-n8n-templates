        "method": "POST",
        "options": {},
        "jsonBody": "={\n  \"requests\": [\n    {\n      \"updateFormInfo\": {\n        \"info\": {\n          \"title\": \"Order form for {{ $('Set Form Parameters').item.json.custname }}\",\n          \"description\": \"This is an individual offer for {{ $('Set Form Parameters').item.json.custname }}\"\n        },\n        \"updateMask\": \"title,description\"\n      }\n    },\n    {\n      \"updateItem\": {\n        \"item\": {\n          \"itemId\": \"{{ $json.items[0].itemId }}\",\n          \"questionItem\": {\n            \"question\": {\n              \"choiceQuestion\": {\n                \"type\": \"RADIO\",\n                \"options\": [\n                  { \"value\": \"Pack essentials $20\" },\n                  { \"value\": \"Pack advanced $25\" },\n                  { \"value\": \"Pack ultimate $50\" }\n                ]\n              }\n            }\n          }\n        },\n        \"location\": { \"index\": 0 },\n        \"updateMask\": \"questionItem.question.choiceQuestion\"\n      }\n    }\n  ]\n}",
        "sendBody": true,
        "specifyBody": "json",
        "authentication": "genericCredentialType",
        "genericAuthType": "oAuth2Api"
