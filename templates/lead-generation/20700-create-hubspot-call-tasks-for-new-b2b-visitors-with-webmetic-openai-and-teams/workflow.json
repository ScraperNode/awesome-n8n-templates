          "body": "={{ $('Call Script Agent').item.json.output }}",
          "status": "NOT_STARTED",
          "subject": "=Call {{ $('Find Contacts via Webmetic').item.json.name }} at {{ $('Fetch Webmetic Visits').item.json.company_name }}",
          "forObjectType": "CONTACT"
        },
        "resource": "engagement",
        "authentication": "appToken",
        "additionalFields": {
          "associations": {
            "contactIds": "={{ $json.vid }}"
          }
        }
      },
      "typeVersion": 2.2
    },
