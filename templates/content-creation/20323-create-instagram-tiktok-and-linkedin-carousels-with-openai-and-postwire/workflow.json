    {
      "id": "04f0f5b3-b663-47af-aa1f-a08919005f03",
      "name": "Plan the carousel with OpenAI",
      "type": "@n8n/n8n-nodes-langchain.openAi",
      "position": [
        300,
        0
      ],
      "parameters": {
        "modelId": {
          "__rl": true,
          "mode": "id",
          "value": "gpt-5-mini"
        },
        "options": {
          "textFormat": {
            "textOptions": {
              "type": "json_object"
            }
          }
        },
        "resource": "text",
        "simplify": true,
        "operation": "response",
        "responses": {
          "values": [
            {
              "role": "system",
              "type": "text",
              "content": "You plan a social media carousel. Return JSON with the keys slides (an array with exactly the requested number of slides; each has headline (up to 8 words, the text printed on the slide), image_prompt (a square slide for the carousel: one flat illustration in a consistent style across all slides, a clean background and the headline printed large in a bold sans-serif font, no logos, no real people) and alt (alt text of up to 120 characters)), instagram (a caption of 2 or 3 sentences that invites people to swipe, and up to 5 hashtags), tiktok (a hook of up to 150 characters with 3 hashtags) and linkedin (3 short paragraphs, professional, no hashtags). The first slide is the hook and the last one the takeaway. Invent no statistics."
            },
            {
              "role": "user",
              "type": "text",
              "content": "={{ 'Topic: ' + $json.Topic + '\\nAudience: ' + ($json.Audience || 'a general audience') + '\\nSlides: ' + $json.Slides + '\\nNetworks: ' + [].concat($json.Networks).join(', ') }}"
            }
          ]
        }
      },
      "typeVersion": 2.3
    },
    {
      "id": "83a5c3e6-7ed2-4124-a4b9-ff8d8ee2f75e",
      "name": "Read the plan",
      "type": "n8n-nodes-base.set",
      "position": [
        600,
        0
      ],
      "parameters": {
        "options": {},
        "assignments": {
          "assignments": [
            {
              "id": "9c532574-2c85-4dfe-ac99-caf7d4efad2f",
              "name": "slides",
              "type": "array",
              "value": "={{ (() => { const p = (() => { const t = $('Plan the carousel with OpenAI').item.json.output.find(o => o.type === 'message').content.find(c => c.type === 'output_text').text; return typeof t === 'string' ? JSON.parse(t) : t; })(); return (p.slides || []).map((s, i) => ({ ...s, n: i + 1 })); })() }}"
            },
            {
              "id": "093c7d52-2ec4-4ef0-a45a-4910bf66d40b",
              "name": "captions",
              "type": "object",
              "value": "={{ (() => { const t = $('Plan the carousel with OpenAI').item.json.output.find(o => o.type === 'message').content.find(c => c.type === 'output_text').text; return typeof t === 'string' ? JSON.parse(t) : t; })() }}"
            },
            {
              "id": "a7a6d7a8-2f70-48cd-a1f0-6c42ed5ad419",
              "name": "networks",
              "type": "array",
              "value": "={{ [].concat($('Carousel brief').item.json.Networks) }}"
