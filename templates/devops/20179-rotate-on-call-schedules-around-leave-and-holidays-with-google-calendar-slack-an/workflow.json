    {
      "id": "79146417-13a1-5cc6-ac73-bfdc553bc993",
      "name": "Decide The On-Call Week",
      "type": "n8n-nodes-base.code",
      "position": [
        1760,
        320
      ],
      "parameters": {
        "jsCode": "\n// Pick next week's on-call person, or judge an edit someone made to an on-call week. Everything comes from\n// the two calendars, the public holiday list and Rota Rules; nothing is guessed.\n// One decision per incoming item: the weekly pick, or each edited event (a poll can return several).\nconst rules = $('Rota Rules').first().json;\nconst items = $('Rota Rules').all().map((i) => i.json);\nconst MARK = 'on-call rota: ';\nconst clean = (v) => (v === null || v === undefined ? '' : String(v).trim());\nconst low = (s) => clean(s).toLowerCase();\n// Not trimmed: the space after \"On call:\" is part of the title.\nconst prefix = (rules.event_title_prefix === undefined || rules.event_title_prefix === null || String(rules.event_title_prefix).trim() === '') ? 'On call: ' : String(rules.event_title_prefix);\nconst team = clean(rules.team).split('\\n').map((l) => l.split(';').map(clean)).filter((p) => p[0])\n  .map((p) => ({ name: p[0], region: clean(p[1]).toUpperCase(), slack: clean(p[2]) }));\nconst rows = (n) => $(n).all().map((i) => i.json);\nconst events = (n) => rows(n).filter((e) => e && e.id && e.status !== 'cancelled');\nconst dayOf = (e, k) => clean(e && e[k] && (e[k].date || clean(e[k].dateTime).slice(0, 10)));\nconst addDays = (iso, n) => { const d = new Date(iso + 'T00:00:00Z'); d.setUTCDate(d.getUTCDate() + n); return d.toISOString().slice(0, 10); };\nconst mondayOf = (iso) => addDays(iso, -((new Date(iso + 'T00:00:00Z').getUTCDay() + 6) % 7));\nconst weekday = (iso) => { const w = new Date(iso + 'T00:00:00Z').getUTCDay(); return w >= 1 && w <= 5; };\nconst today = (typeof $now !== 'undefined' && $now && $now.toISODate) ? $now.toISODate() : new Date().toISOString().slice(0, 10);\nconst nameIn = (title) => (low(title).startsWith(low(prefix)) ? clean(clean(title).slice(prefix.length)) : '');\nconst markerName = (desc) => { const i = clean(desc).indexOf(MARK); return i < 0 ? null : clean(clean(desc).slice(i + MARK.length).split('|')[0]); };\nconst mentions = (text, name) => new RegExp('(^|[^a-z])' + low(name).replace(/[^a-z0-9 ]/g, '.') + '([^a-z]|$)').test(low(text));\n\nconst one = (item) => {\nconst edit = !!(item.id && item.start && item.kind === 'calendar#event');\nconst weekStart = edit ? mondayOf(dayOf(item, 'start')) : mondayOf(addDays(today, 7));\nconst weekEnd = addDays(weekStart, 7);\nconst lookback = Math.max(1, Number(rules.fairness_weeks || 12));\nconst rest = Math.max(0, Number(rules.rest_weeks === undefined ? 1 : rules.rest_weeks));\n\n// The rota's own history: one on-call event per week.\nconst booked = events('Read Past On-Call Weeks').map((e) => ({ id: e.id, name: nameIn(e.summary), week: mondayOf(dayOf(e, 'start')) }))\n  .filter((b) => b.name && b.week);\nconst whoOn = (week) => (booked.find((b) => b.week === week) || {}).name || '';\nconst leave = events('Read The Leave Calendar').filter((e) => dayOf(e, 'start') < weekEnd && (dayOf(e, 'end') || dayOf(e, 'start')) > weekStart);\nconst holidays = rows('Read Public Holidays').filter((h) => h && h.date && h.date >= weekStart && h.date < weekEnd && weekday(h.date));\nconst holidayRead = rows('Read Public Holidays').some((h) => h && h.date);\n\nconst blockers = (p) => {\n  const why = [];\n  const l = leave.find((e) => mentions(e.summary, p.name));\n  if (l) why.push(p.name + ' is on leave (' + clean(l.summary) + ')');\n  const h = holidays.find((x) => x.global || (p.region && (x.counties || []).includes(p.region)));\n  if (h) why.push(p.name + ' has a public holiday on ' + h.date + ' (' + clean(h.name) + ')');\n  for (let k = 1; k <= rest; k++) {\n    if (low(whoOn(addDays(weekStart, -7 * k))) === low(p.name)) why.push(p.name + ' was on call ' + (k === 1 ? 'the week before' : k + ' weeks before'));\n    if (low(whoOn(addDays(weekStart, 7 * k))) === low(p.name)) why.push(p.name + ' is on call ' + (k === 1 ? 'the week after' : k + ' weeks after'));\n  }\n  return why;\n};\nconst count = (p) => booked.filter((b) => low(b.name) === low(p.name) && b.week < weekStart && b.week >= addDays(weekStart, -7 * lookback)).length;\nconst last = (p) => booked.filter((b) => low(b.name) === low(p.name) && b.week < weekStart).map((b) => b.week).sort().pop() || '';\n\nlet action = 'nothing';\nlet person = null;\nlet previous = '';\nconst why = [];\nconst blocked = [];\nif (!team.length) {\n  action = 'escalate';\n  why.push('Rota Rules has no team, so nobody can be picked.');\n} else if (!holidayRead) {\n  action = 'escalate';\n  why.push('The public holiday list could not be read, so nobody was booked. Check the Nager.Date call or holiday_country.');\n} else if (!edit) {\n  const existing = booked.find((b) => b.week === weekStart);\n  if (existing) {\n    why.push('The week of ' + weekStart + ' is already booked for ' + existing.name + '.');\n  } else {\n    const free = [];\n    for (const p of team) { const b = blockers(p); if (b.length) blocked.push(b.join('; ')); else free.push(p); }\n    if (!free.length) {\n      action = 'escalate';\n      why.push('Nobody on the team is free for the week of ' + weekStart + '.');\n    } else {\n      free.sort((a, b) => count(a) - count(b) || (last(a) < last(b) ? -1 : last(a) > last(b) ? 1 : 0) || team.indexOf(a) - team.indexOf(b));\n      person = free[0];\n      action = 'book';\n      why.push(person.name + ' has had the fewest on-call weeks in the last ' + lookback + ' (' + count(person) + ')' + (last(person) ? ', last on ' + last(person) : ', never on call yet') + '.');\n    }\n  }\n} else {\n  previous = markerName(item.description);\n  const now = nameIn(item.summary);\n  if (previous === null) why.push('This event was not booked by the rota, so it is left alone.');\n  else if (weekEnd <= today) why.push('The week of ' + weekStart + ' is over, so the edit is left alone.');\n  else if (low(now) === low(previous)) why.push('The title still names ' + previous + ', so there is nothing to check.');\n  else {\n    person = team.find((p) => low(p.name) === low(now)) || null;\n    const b = person ? blockers(person) : [(now || 'The new title') + ' is not on the team list in Rota Rules'];\n    if (person && !person.slack) b.push(person.name + ' has no Slack member ID in Rota Rules, so they cannot be asked');\n    if (b.length) { action = 'revert'; why.push('The swap from ' + previous + ' to ' + (now || 'nobody') + ' breaks the rota: ' + b.join('; ') + '.'); }\n    else { action = 'ask'; why.push(previous + ' handed the week of ' + weekStart + ' to ' + person.name + '.'); }\n  }\n}\n\nconst who = person ? person.name : '';\nconst lead = clean(rules.lead_slack_id) ? '<@' + clean(rules.lead_slack_id) + '> ' : '';\nconst tag = (p) => (p && p.slack ? '<@' + p.slack + '>' : (p ? p.name : ''));\nreturn {\n  mode: edit ? 'edit' : 'weekly', action, week_start: weekStart, week_end: weekEnd, person: who, person_slack: person ? person.slack : '',\n  previous: previous || '', event_id: edit ? clean(item.id) : '', why, blocked,\n  title: prefix + who, marker: MARK + who + ' | ' + weekStart,\n  title_back: prefix + (previous || ''), marker_back: MARK + (previous || '') + ' | ' + weekStart,\n  handover_at: weekStart + 'T' + (clean(rules.handover_time) || '09:00') + ':00',\n  topic: 'On call this week: ' + who,\n  announce_text: tag(person) + ' is on call for the week of ' + weekStart + '. ' + why.join(' ') + ' Swap by editing the event in the on-call calendar.',\n  escalate_text: lead + 'Nobody is booked for on-call in the week of ' + weekStart + '. ' + why.join(' ') + (blocked.length ? ' ' + blocked.join('. ') + '.' : ''),\n  ask_text: 'Hi ' + who + ', ' + (previous || 'someone') + ' has handed you on-call for the week of ' + weekStart + '. Do you take it?',\n  confirm_text: who + ' confirmed: they are on call for the week of ' + weekStart + ' instead of ' + (previous || 'the person before') + '.',\n  revert_text: 'The on-call week of ' + weekStart + ' was put back to ' + (previous || 'its booked person') + '. ' + why.join(' '),\n  declined_text: 'The on-call week of ' + weekStart + ' was put back to ' + (previous || 'its booked person') + ', because ' + who + ' did not confirm the swap in time.',\n};\n};\nreturn items.map((it) => ({ json: one(it) }));\n"
      },
      "typeVersion": 2
    },
    {
      "id": "561c4721-0f7c-5090-b05c-440680b3f225",
      "name": "What Now For The Week?",
      "type": "n8n-nodes-base.switch",
      "position": [
