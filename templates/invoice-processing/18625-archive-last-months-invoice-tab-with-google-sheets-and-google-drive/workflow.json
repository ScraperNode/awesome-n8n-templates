    {
      "id": "9de0f9a5-bc3c-4852-80f3-c74ae07116a2",
      "name": "Get every tab in the sheet",
      "type": "n8n-nodes-base.httpRequest",
      "position": [
        4336,
        496
      ],
      "parameters": {
        "url": "=https://sheets.googleapis.com/v4/spreadsheets/{{ $('Set config').first().json.sourceSpreadsheetId }}?fields=sheets.properties",
        "options": {},
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "googleOAuth2Api"
      },
      "typeVersion": 4.2
    },
    {
      "id": "80f2681b-b092-42a7-b2b3-f2a316de93e7",
      "name": "Find last month's tab",
      "type": "n8n-nodes-base.code",
      "position": [
        4608,
        496
      ],
      "parameters": {
        "jsCode": "// Flatten the nested response and pick out the one tab we want.\n// Returning a found flag lets the next node decide instead of the branch dying silently.\nconst wanted = $('Work out last month').first().json.monthLabel;\nconst tabs = [];\n\nfor (const item of $input.all()) {\n  for (const s of (item.json.sheets || [])) {\n    const p = s.properties;\n    tabs.push({ sheetId: p.sheetId, title: p.title, rowCount: p.gridProperties?.rowCount || 0 });\n  }\n}\n\nconst match = tabs.find(t => t.title === wanted);\n\nreturn [{\n  json: {\n    found: !!match,\n    sourceSheetId: match ? match.sheetId : null,\n    sourceTitle: match ? match.title : null,\n    sourceRowCount: match ? match.rowCount : 0,\n    availableTabs: tabs.map(t => t.title).join(', '),\n  }\n}];\n"
      },
      "typeVersion": 2
    },
    {
      "id": "254c44bc-8024-45bc-9ff8-79202fd0a4e7",
