        1120
      ],
      "parameters": {
        "jsCode": "const { caption, photos } = $json;\n\nreturn photos.map(p => ({\n  json: {\n    file_id: p.file_id,\n    caption // gi\u1eef caption \u0111\u1ec3 d\u00f9ng sau\n  }\n}));\n"
      },
      "typeVersion": 2
