{
  "name": "Shopify Low Stock Alert",
  "nodes": [
    {
      "id": "a1b2c3d4-0001-4000-8000-000000000101",
      "name": "Note \u2013 Schedule & Config",
      "type": "n8n-nodes-base.stickyNote",
      "position": [
        -20,
        40
      ],
      "parameters": {
        "color": 4,
        "width": 460,
        "height": 260,
        "content": "## Schedule & Config\nAdjust the run frequency in the Schedule node and the alert threshold / recipient email in the Config node. No other nodes need to be touched to change these settings."
      },
      "typeVersion": 1
    },
    {
      "id": "a1b2c3d4-0001-4000-8000-000000000102",
      "name": "Note \u2013 Fetch & Transform Shopify Data",
      "type": "n8n-nodes-base.stickyNote",
      "position": [
        460,
        40
      ],
      "parameters": {
        "color": 5,
        "width": 460,
        "height": 260,
        "content": "## Fetch & Transform Shopify Data\nPulls the full product catalog (with automatic pagination via \"Return All\") and flattens it into one row per SKU/variant with its current inventory quantity."
      },
      "typeVersion": 1
    },
    {
      "id": "a1b2c3d4-0001-4000-8000-000000000103",
      "name": "Note \u2013 Filter & Decision Logic",
      "type": "n8n-nodes-base.stickyNote",
      "position": [
        940,
        40
      ],
      "parameters": {
        "color": 6,
        "width": 460,
        "height": 260,
        "content": "## Filter & Decision\nKeeps only variants below the configured threshold, aggregates them into one summary item, then branches: if none are low, the workflow ends quietly."
      },
      "typeVersion": 1
    },
    {
      "id": "a1b2c3d4-0001-4000-8000-000000000104",
      "name": "Note \u2013 Email Notification",
      "type": "n8n-nodes-base.stickyNote",
      "position": [
        1420,
        40
      ],
      "parameters": {
        "color": 3,
        "width": 460,
        "height": 260,
        "content": "## Email Notification\nBuilds an HTML summary table and sends it via SMTP to the configured recipient. Only runs when low-stock items exist."
      },
      "typeVersion": 1
    },
    {
      "id": "a1b2c3d4-0001-4000-8000-000000000001",
      "name": "Schedule \u2013 Daily Inventory Check",
      "type": "n8n-nodes-base.scheduleTrigger",
      "position": [
        0,
        300
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "hoursInterval": 12
            }
          ]
        }
      },
      "typeVersion": 1.2
    },
    {
      "id": "a1b2c3d4-0001-4000-8000-000000000002",
      "name": "Config \u2013 Threshold & Settings",
      "type": "n8n-nodes-base.set",
      "position": [
        240,
        300
      ],
      "parameters": {
        "options": {},
        "assignments": {
          "assignments": [
            {
              "id": "b1+1234567890-+1234567890",
              "name": "lowStockThreshold",
              "type": "number",
              "value": 10
            },
            {
              "id": "b1+1234567890-+1234567890",
              "name": "notificationEmail",
              "type": "string",
              "value": "user@example.com"
            },
            {
              "id": "b1+1234567890-+1234567890",
              "name": "storeName",
              "type": "string",
              "value": "My Shopify Store"
            }
          ]
        }
      },
      "typeVersion": 3.4
    },
    {
      "id": "a1b2c3d4-0001-4000-8000-000000000003",
      "name": "Shopify \u2013 Get All Products",
      "type": "n8n-nodes-base.shopify",
      "position": [
        480,
        300
      ],
      "parameters": {
        "filters": {},
        "resource": "product",
        "operation": "getAll",
        "returnAll": true
      },
      "credentials": {
        "shopifyApi": {
          "id": "credential-id",
          "name": "Shopify account"
        }
      },
      "typeVersion": 1
    },
    {
      "id": "a1b2c3d4-0001-4000-8000-000000000004",
      "name": "Code \u2013 Flatten Product Variants",
      "type": "n8n-nodes-base.code",
      "position": [
        720,
        300
      ],
      "parameters": {
        "jsCode": "const flattened = [];\nfor (const item of $input.all()) {\n  const product = item.json;\n  const variants = product.variants || [];\n  for (const variant of variants) {\n    flattened.push({\n      json: {\n        productTitle: product.title,\n        variantTitle: variant.title,\n        sku: variant.sku || '',\n        inventoryQuantity: variant.inventory_quantity,\n        productId: product.id,\n        variantId: variant.id\n      }\n    });\n  }\n}\nreturn flattened;"
      },
      "typeVersion": 2
    },
    {
      "id": "a1b2c3d4-0001-4000-8000-000000000005",
      "name": "Filter \u2013 Low Stock Items",
      "type": "n8n-nodes-base.filter",
      "position": [
        960,
        300
      ],
      "parameters": {
        "options": {},
        "conditions": {
          "options": {
            "leftValue": "",
            "caseSensitive": true,
            "typeValidation": "strict"
          },
          "combinator": "and",
          "conditions": [
            {
              "id": "c1+1234567890-+1234567890",
              "operator": {
                "type": "number",
                "operation": "lt"
              },
              "leftValue": "={{ $json.inventoryQuantity }}",
              "rightValue": "={{ $('Config \u2013 Threshold & Settings').first().json.lowStockThreshold }}"
            }
          ]
        }
      },
      "typeVersion": 2.2
    },
    {
      "id": "a1b2c3d4-0001-4000-8000-000000000006",
      "name": "Code \u2013 Aggregate Low Stock Items",
      "type": "n8n-nodes-base.code",
      "position": [
        1200,
        300
      ],
      "parameters": {
        "jsCode": "const items = $input.all().map(i => i.json);\nreturn [{\n  json: {\n    lowStockItems: items,\n    count: items.length\n  }\n}];"
      },
      "typeVersion": 2
    },
    {
      "id": "a1b2c3d4-0001-4000-8000-000000000007",
      "name": "If \u2013 Low Stock Items Exist",
      "type": "n8n-nodes-base.if",
      "position": [
        1440,
        300
      ],
      "parameters": {
        "options": {},
        "conditions": {
          "options": {
            "leftValue": "",
            "caseSensitive": true,
            "typeValidation": "strict"
          },
          "combinator": "and",
          "conditions": [
            {
              "id": "d1+1234567890-+1234567890",
              "operator": {
                "type": "number",
                "operation": "gt"
              },
              "leftValue": "={{ $json.count }}",
              "rightValue": 0
            }
          ]
        }
      },
      "typeVersion": 2.2
    },
    {
      "id": "a1b2c3d4-0001-4000-8000-000000000008",
      "name": "Format \u2013 Build Alert Summary",
      "type": "n8n-nodes-base.code",
      "position": [
        1680,
        180
      ],
      "parameters": {
        "jsCode": "const items = $json.lowStockItems;\nconst threshold = $('Config \u2013 Threshold & Settings').first().json.lowStockThreshold;\nconst now = new Date().toISOString();\n\nlet rows = '';\nfor (const item of items) {\n  rows += '<tr><td>' + item.productTitle + '</td><td>' + (item.variantTitle || '') + '</td><td>' + (item.sku || 'N/A') + '</td><td>' + item.inventoryQuantity + '</td></tr>';\n}\n\nconst html = '<h2>Low Stock Alert</h2>' +\n  '<p>The following ' + items.length + ' item(s) are below the minimum stock threshold of ' + threshold + ' units.</p>' +\n  '<table border=\"1\" cellpadding=\"6\" cellspacing=\"0\" style=\"border-collapse:collapse;\">' +\n  '<tr style=\"background:#f2f2f2;\"><th>Product</th><th>Variant</th><th>SKU</th><th>Qty Remaining</th></tr>' +\n  rows +\n  '</table>' +\n  '<p>Check performed at: ' + now + '</p>';\n\nreturn [{\n  json: {\n    emailHtml: html,\n    emailSubject: 'Low Stock Alert \u2013 Action Required',\n    checkTimestamp: now,\n    itemCount: items.length\n  }\n}];"
      },
      "typeVersion": 2
    },
    {
      "id": "a1b2c3d4-0001-4000-8000-000000000009",
      "name": "Send Email \u2013 Low Stock Alert",
      "type": "n8n-nodes-base.emailSend",
      "position": [
        1920,
        180
      ],
      "parameters": {
        "html": "={{ $json.emailHtml }}",
        "options": {},
        "subject": "={{ $json.emailSubject }}",
        "toEmail": "={{ $('Config \u2013 Threshold & Settings').first().json.notificationEmail }}",
        "fromEmail": "user@example.com",
        "emailFormat": "html"
      },
      "credentials": {
        "smtp": {
          "id": "credential-id",
          "name": "SMTP account"
        }
      },
      "typeVersion": 2.1
    },
    {
      "id": "a1b2c3d4-0001-4000-8000-000000000010",
      "name": "No Action \u2013 Stock Levels OK",
      "type": "n8n-nodes-base.noOp",
      "position": [
        1680,
        420
      ],
      "parameters": {},
      "typeVersion": 1
    }
  ],
  "active": false,
  "pinData": {},
  "settings": {
    "executionOrder": "v1"
  },
