    {
      "id": "35b8027b-ace1-4dc7-a806-aadc1a37a4ad",
      "name": "Claude\u3067\u4fa1\u5024\u5224\u5b9a",
      "type": "n8n-nodes-base.httpRequest",
      "position": [
        -400,
        0
      ],
      "parameters": {
        "url": "https://api.anthropic.com/v1/messages",
        "method": "POST",
        "options": {},
        "jsonBody": "={{ JSON.stringify({\n  model: \"claude-sonnet-4-6\",\n  max_tokens: 500,\n  messages: [{ role: \"user\", content: `\u4ee5\u4e0b\u306fn8n(n8n-io/n8n)\u306eGitHub Release\u30ce\u30fc\u30c8\u304b\u3089\u65b0\u6a5f\u80fd(Features)\u90e8\u5206\u3092\u629c\u304d\u51fa\u3057\u305f\u3082\u306e\u3067\u3059\u3002\u3053\u306e\u5185\u5bb9\u3092\u65e5\u672c\u8a9e\u8a18\u4e8b\u3068\u3057\u3066\u300e\u6d77\u5916\u60c5\u5831\u300f\u30ab\u30c6\u30b4\u30ea\u30fc\u3067\u7d39\u4ecb\u3059\u308b\u4fa1\u5024\u304c\u3042\u308b\u304b\u5224\u5b9a\u3057\u3066\u304f\u3060\u3055\u3044\u3002\n\n\u3010release_notes\u3011\n${($json.body || '').slice(0, 4000)}\n\n\u3010\u5224\u5b9a\u57fa\u6e96\u3011\n- \u4fa1\u5024\u3042\u308a: \u65b0\u6a5f\u80fd(feat)\u3001\u65b0\u3057\u3044\u30ce\u30fc\u30c9\u8ffd\u52a0\u3001\u65e2\u5b58\u30ce\u30fc\u30c9\u3078\u306e\u6a5f\u80fd\u8ffd\u52a0\u3001UI/UX\u306e\u5927\u304d\u306a\u5909\u66f4\u3001\u65e2\u5b58\u6a5f\u80fd\u306e\u91cd\u8981\u306a\u4ed5\u69d8\u5909\u66f4\n- \u4fa1\u5024\u306a\u3057: \u5185\u90e8\u7684\u30fb\u904b\u7528\u7ba1\u7406\u8005\u5411\u3051\u306e\u5909\u66f4\u306e\u307f\u3001\u4f9d\u5b58\u95a2\u4fc2\u306e\u66f4\u65b0\u3001\u30de\u30a4\u30ca\u30fc\u306a\u6539\u5584\u306e\u307f\n\n\u3010\u6ce8\u610f\u4e8b\u9805\u3011\n- \u5224\u65ad\u6750\u6599\u306frelease_notes\u306b\u66f8\u304b\u308c\u3066\u3044\u308b\u5185\u5bb9\u306e\u307f\u3068\u3059\u308b\u3053\u3068\n- reason\u30fbheadline_candidates\u30fbkey_points\u306b\u306f\u3001release_notes\u306b\u66f8\u304b\u308c\u3066\u3044\u306a\u3044\u4ed5\u69d8\u30fb\u7d4c\u7def\u30fb\u80cc\u666f\u30fb\u52b9\u679c\u3092\u63a8\u6e2c\u3067\u542b\u3081\u306a\u3044\u3053\u3068\n- \u300c\uff08beta\u7248\uff09\u300d\u3068\u8a18\u8f09\u304c\u3042\u308b\u5834\u5408\u306f\u3001headline_candidates\u3068key_points\u306bbeta\u7248\u3067\u3042\u308b\u3053\u3068\u3092\u660e\u8a18\u3059\u308b\u3053\u3068\n\n\u3010\u51fa\u529b\u5f62\u5f0f\u3011\n\u4ee5\u4e0b\u306eJSON\u5f62\u5f0f\u306e\u307f\u3067\u51fa\u529b\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u30b3\u30fc\u30c9\u30d6\u30ed\u30c3\u30af(\\`\\`\\`)\u3082\u542b\u3081\u3001\u4ed6\u306e\u6587\u7ae0\u306f\u4e00\u5207\u542b\u3081\u306a\u3044\u3053\u3068\u3002\n{\n  \"worth_article\": true \u307e\u305f\u306f false,\n  \"reason\": \"\u5224\u5b9a\u7406\u7531\u30921\u6587\u3067\",\n  \"headline_candidates\": [\"\u8a18\u4e8b\u5316\u3059\u308b\u5834\u5408\u306e\u30bf\u30a4\u30c8\u30eb\u6848\u30922\u3064\"],\n  \"key_points\": [\"release_notes\u306b\u66f8\u304b\u308c\u3066\u3044\u308b\u4e8b\u5b9f\u306e\u307f\u3067\u8981\u70b9\u30923\u3064\u307e\u3067\"]\n}` }]\n}) }}",
        "sendBody": true,
        "sendHeaders": true,
        "specifyBody": "json",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "headerParameters": {
          "parameters": [
            {
              "name": "anthropic-version",
              "value": "2023-06-01"
            },
            {
              "name": "content-type",
              "value": "application/json"
            }
          ]
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "REPLACE_WITH_YOUR_CREDENTIAL_ID",
          "name": "Anthropic API Key (Header Auth)"
        }
      },
