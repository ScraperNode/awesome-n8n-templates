    },
    {
      "id": "66aa8f1f-6b48-47b6-8da7-249858b95314",
      "name": "Validate Input",
      "type": "n8n-nodes-base.code",
      "position": [
        272,
        400
      ],
      "parameters": {
        "jsCode": "// Normalise and validate the incoming webhook payload\nconst body = $input.first().json.body || {};\nconst str = v => (typeof v === 'string' ? v.trim() : '');\n\nconst topic = str(body.topic);\nconst context = str(body.context);\nconst errors = [];\nlet provider = (str(body.provider) || 'claude').toLowerCase();\nif (['chatgpt', 'gpt'].includes(provider)) provider = 'openai';\nif (!['claude', 'gemini', 'openai'].includes(provider)) errors.push('\"provider\" must be \"claude\", \"gemini\" or \"openai\"');\nif (!topic) errors.push('\"topic\" is required');\nif (!context) errors.push('\"context\" is required');\nif (topic.length > 300) errors.push('\"topic\" must be 300 characters or fewer');\nif (context.length > 8000) errors.push('\"context\" must be 8000 characters or fewer');\nconst image_generation_enabled = $input.first().json.image_generation_enabled !== false; // master switch from Settings\nconst generate_image = image_generation_enabled && (body.generate_image === undefined ? true : !(body.generate_image === false || String(body.generate_image).toLowerCase() === 'false'));\nconst image_size = str(body.image_size) || '1024x1024';\nif (!['1024x1024', '1024x1536', '1536x1024'].includes(image_size)) errors.push('\"image_size\" must be 1024x1024, 1024x1536 or 1536x1024');\nconst image_provider = (str(body.image_provider) || (provider === 'openai' ? 'openai' : 'gemini')).toLowerCase().replace(/^(chatgpt|gpt)$/, 'openai');\nif (!['openai', 'gemini'].includes(image_provider)) errors.push('\"image_provider\" must be \"openai\" or \"gemini\"');\n\nreturn [{\n  json: {\n    valid: errors.length === 0,\n    errors,\n    provider,\n    topic,\n    context,\n    tone: str(body.tone) || 'professional, insightful and approachable',\n    audience: str(body.audience) || 'business professionals and decision makers',\n    brand: str(body.brand) || 'not specified',\n    cta: str(body.cta) || 'none',\n    language: str(body.language) || 'English',\n    image_generation_enabled,\n    generate_image,\n    image_size,\n    image_provider,\n    image_style: str(body.image_style) || 'clean, modern, professional editorial photography style',\n  }\n}];"
      },
      "typeVersion": 2
    },
