    {
      "id": "32ffc0b5-84b7-4963-88a9-e2e640732cad",
      "name": "Post to TikTok Scraper API",
      "type": "n8n-nodes-base.httpRequest",
      "position": [
        360,
        100
      ],
      "parameters": {
        "url": "https://api.apify.com/v2/acts/Scrape-Lads~tiktok-profile-scraper/run-sync-get-dataset-items",
        "method": "POST",
        "options": {
          "timeout": 300000
        },
        "jsonBody": "={{ JSON.stringify({ searchKeywords: $json.searchKeywords, minFollowers: $json.minFollowers, maxFollowers: $json.maxFollowers, maxResults: $json.maxResults, onlyWithEmail: $json.onlyWithEmail, enrichBioLinks: true }) }}",
        "sendBody": true,
        "specifyBody": "json",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth"
      },
      "typeVersion": 4.2
    },
    {
      "id": "785bf4d4-c3a4-460f-8539-3eb119daf11a",
      "name": "Select Lead Columns",
      "type": "n8n-nodes-base.code",
      "position": [
        580,
        100
      ],
      "parameters": {
        "jsCode": "return $input.all()\n  .filter(i => i.json.resultType === 'profile' || i.json.username)\n  .map(i => {\n    const p = i.json;\n    return { json: {\n      username: p.username,\n      name: p.displayName,\n      followers: p.followers,\n      avgLikesPerPost: p.avgLikesPerPost,\n      email: p.contactEmail || (p.bioEmails || [])[0] || '',\n      instagram: p.instagramUrl || '',\n      youtube: p.youtubeUrl || '',\n      bio: (p.bio || '').replace(/\\n/g, ' '),\n      profileUrl: p.profileUrl,\n      foundVia: p.searchKeyword || p.sourceInput || '',\n      scrapedAt: p.scrapedAt,\n    } };\n  });"
      },
      "typeVersion": 2
    },
