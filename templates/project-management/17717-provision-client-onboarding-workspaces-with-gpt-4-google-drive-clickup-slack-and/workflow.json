      "id": "e4dd18e3-8bc9-4763-8a77-c9ec5b8b9c0e",
      "name": "OpenAI Task Planning Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "position": [
        -448,
        432
      ],
      "parameters": {
        "model": {
          "__rl": true,
          "mode": "list",
          "value": "gpt-4o",
          "cachedResultName": "gpt-4o"
        },
        "options": {
          "timeout": 120000
        },
        "builtInTools": {}
      },
      "credentials": {
        "openAiApi": {
          "name": "OpenAi account"
        }
      },
      "typeVersion": 1.3
    },
    {
      "id": "8ad5017f-5d20-492c-89b5-9bd5c01676af",
