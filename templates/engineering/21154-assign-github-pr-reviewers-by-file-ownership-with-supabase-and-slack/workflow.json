        560,
        80
      ],
      "parameters": {
        "color": 7,
        "width": 608,
        "height": 320,
        "content": "## Receive and filter PR\n\nStarts from the GitHub pull request webhook, applies static repository and assignment configuration, and checks whether the incoming PR should continue through the workflow."
      },
      "typeVersion": 1
    },
