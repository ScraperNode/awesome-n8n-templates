        0,
        0
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "days",
              "triggerAtHour": 7
            }
          ]
        }
      },
      "typeVersion": 1.2
    },
    {
      "id": "9e944dc4-ce0d-5503-89ea-da3252e6ef77",
      "name": "CONFIG",
      "type": "n8n-nodes-base.set",
      "position": [
        220,
        0
      ],
      "parameters": {
        "mode": "raw",
        "options": {},
        "jsonOutput": "{\n  \"actorInput\": {\n    \"cities\": [\n      \"austin\",\n      \"seattle\",\n      \"los-angeles\",\n      \"san-francisco\",\n      \"chicago\"\n    ],\n    \"daysBack\": 3,\n    \"keywords\": [\n      \"solar\",\n      \"roof\",\n      \"pool\",\n      \"adu\",\n      \"remodel\"\n    ],\n    \"minValuation\": 10000,\n    \"maxResultsPerCity\": 300\n  },\n  \"digestEmail\": \"you@example.com\"\n}"
      },
      "typeVersion": 3.4
    },
    {
