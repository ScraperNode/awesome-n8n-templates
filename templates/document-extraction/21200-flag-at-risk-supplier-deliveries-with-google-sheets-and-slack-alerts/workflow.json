    {
      "id": "23b55deb-acec-4af8-a2bb-cd6347c1e57e",
      "name": "Analyze Risk Data",
      "type": "n8n-nodes-base.code",
      "position": [
        1376,
        400
      ],
      "parameters": {
        "jsCode": "const pos = $('Read Purchase Orders from Sheets').all().map(x => x.json);\nconst suppliers = $('Read Supplier History from Sheets').all().map(x => x.json);\nconst commitments = $('Read Customer Commitments Sheets').all().map(x => x.json);\nconst tracking = $('Read Carrier Tracking from Sheets').all().map(x => x.json);\nconst cfg = $('Set Configuration Options').first().json;\nconst now = new Date();\nconst day = d => { if (!d) return null; const x = new Date(String(d).slice(0,10)+'T00:00:00Z'); return Number.isNaN(x.getTime()) ? null : x; };\nconst daysBetween = (a,b) => Math.floor((a.getTime()-b.getTime())/86400000);\nconst by = (arr,key,val) => arr.find(r => String(r[key] ?? '').trim() === String(val ?? '').trim());\nconst out = [];\nfor (const po of pos) {\n  if (!po.po_id || ['Delivered','Cancelled','Closed'].includes(String(po.po_status||'').trim())) continue;\n  const supplier = by(suppliers,'supplier_id',po.supplier_id) || {};\n  const commitment = by(commitments,'customer_order_id',po.customer_order_id) || {};\n  const carrier = by(tracking,'po_id',po.po_id) || by(tracking,'tracking_number',po.tracking_number) || {};\n  const expected = day(carrier.estimated_delivery_date) || day(po.expected_delivery_date);\n  const committed = day(commitment.committed_delivery_date);\n  const today = new Date(Date.UTC(now.getUTCFullYear(),now.getUTCMonth(),now.getUTCDate()));\n  const delayDays = expected ? Math.max(0,daysBetween(today,expected)) : 0;\n  const supplierLateRate = Number(supplier.orders_last_12m) > 0 ? Number(supplier.late_deliveries_last_12m||0)/Number(supplier.orders_last_12m) : 0;\n  const forecastGap = expected && committed ? Math.max(0,daysBetween(expected,committed)) : 0;\n  const isLate = String(po.po_status||'').toLowerCase().includes('delay') || (expected && daysBetween(today,expected) > Number(cfg.lateGraceDays||0));\n  const likelyLate = String(carrier.carrier_status||'').toLowerCase().includes('exception') || supplierLateRate >= 0.25 || (expected && committed && expected > committed);\n  if (!isLate && !likelyLate) continue;\n  const orderValue = Number(commitment.order_value||0);\n  const penalty = Number(commitment.penalty_per_day||0);\n  const impactScore = Math.min(100, (orderValue >= Number(cfg.highImpactOrderValue||10000) ? 35 : 15) + (String(commitment.priority||'').toLowerCase()==='critical' ? 35 : String(commitment.priority||'').toLowerCase()==='high' ? 20 : 0) + Math.min(30, forecastGap*10) + (penalty>0 ? 10 : 0));\n  const supplierScore = Math.min(100, Math.round(supplierLateRate*60 + Number(supplier.avg_delay_days||0)*5 + (String(carrier.carrier_status||'').toLowerCase().includes('exception') ? 25 : 0)));\n  const riskLevel = impactScore >= 70 || supplierScore >= 70 ? 'CRITICAL' : impactScore >= 45 || supplierScore >= 45 ? 'HIGH' : 'MEDIUM';\n  const reason = [isLate?'Expected delivery is late':'',likelyLate?'Supplier/carrier signals indicate possible delay':'',forecastGap>0?`Estimated delivery is ${forecastGap} day(s) after customer commitment`: '',supplierLateRate>=0.25?`Supplier late rate is ${Math.round(supplierLateRate*100)}%`: '',carrier.carrier_status?`Carrier status: ${carrier.carrier_status}`:''].filter(Boolean).join('; ');\n  const draft = `Subject: Urgent delivery status required - PO ${po.po_id}\\\\n\\\\nHello ${supplier.supplier_name||po.supplier_name||'Supplier'} team,\\\\n\\\\nWe are checking on purchase order ${po.po_id} for ${po.item_description||po.item_sku||'the ordered items'}. Our current expected delivery date is ${po.expected_delivery_date||'not available'} and the carrier estimate is ${carrier.estimated_delivery_date||'not available'}. This may affect customer order ${commitment.customer_order_id||po.customer_order_id||'N/A'} with a commitment date of ${commitment.committed_delivery_date||'not available'}.\\\\n\\\\nPlease confirm the current shipment location, the most reliable delivery date, the reason for any delay, and the recovery plan. If the original date cannot be met, please provide the earliest partial-shipment option.\\\\n\\\\nRegards,\\\\nSupply Chain Operations`;\n  out.push({json:{risk_id:`${po.po_id}-${today.toISOString().slice(0,10)}`,run_timestamp:now.toISOString(),po_id:po.po_id,supplier_id:po.supplier_id,supplier_name:supplier.supplier_name||po.supplier_name||'',customer_order_id:commitment.customer_order_id||po.customer_order_id||'',customer_name:commitment.customer_name||'',expected_delivery_date:po.expected_delivery_date||'',committed_delivery_date:commitment.committed_delivery_date||'',estimated_delivery_date:carrier.estimated_delivery_date||'',delay_days:expected?Math.max(0,daysBetween(today,expected)):0,supplier_risk_score:supplierScore,customer_impact_score:impactScore,risk_level:riskLevel,risk_reason:reason,recommended_action:riskLevel==='CRITICAL'?'Escalate to supplier immediately; confirm recovery plan and customer contingency':riskLevel==='HIGH'?'Request confirmed ETA and assess alternate supply':'Monitor shipment and request status confirmation',supplier_escalation_draft:draft,status:'OPEN',owner:'',last_notified_at:''}});\n}\nreturn out.length ? out : [{json:{_noRisk:true,run_timestamp:now.toISOString()}}];"
      },
      "typeVersion": 2
    },
