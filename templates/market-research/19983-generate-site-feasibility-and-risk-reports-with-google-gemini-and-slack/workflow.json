      "name": "Fetch Census Demographics",
      "type": "n8n-nodes-base.httpRequest",
      "notes": "Census API key is optional for low request volume. Remove the 'key' param entirely if you don't have one, or replace with your key from api.census.gov/data/key_signup.html",
      "position": [
        2752,
        640
      ],
      "parameters": {
        "url": "=https://api.census.gov/data/{{ $('Set Site Parameters').item.json.census_year }}/acs/acs5",
        "options": {},
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "get",
              "value": "B19013_001E,B01003_001E"
            },
            {
              "name": "for",
              "value": "=block group:{{ $json.result.geographies['Census Block Groups'][0].BLKGRP }}"
            },
            {
              "name": "in",
              "value": "=state:{{ $json.result.geographies['Census Block Groups'][0].STATE }} county:{{ $json.result.geographies['Census Block Groups'][0].COUNTY }} tract:{{ $json.result.geographies['Census Block Groups'][0].TRACT }}"
