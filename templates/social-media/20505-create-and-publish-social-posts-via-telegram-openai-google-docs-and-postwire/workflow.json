    {
      "id": "2245c844-fa13-4a68-acaf-7f7508132bb3",
      "name": "Send the drafts",
      "type": "n8n-nodes-base.telegram",
      "position": [
        0,
        672
      ],
      "parameters": {
        "text": "={{ (() => { const p = $json; const drafts = p.networks.filter(n => p.posts[n]).map(n => '<b>' + n.toUpperCase() + '</b>\\n' + String(p.posts[n]).replace(/&/g, '&amp;').replace(/</g, '&lt;')).join('\\n\\n'); return (drafts || 'The agent returned no posts. Decline and send the topic again.').slice(0, 3900); })() }}",
        "chatId": "={{ $json.chat_id }}",
        "resource": "message",
        "operation": "sendMessage",
        "additionalFields": {
          "parse_mode": "HTML",
          "appendAttribution": false
        }
      },
      "typeVersion": 1.2
    },
