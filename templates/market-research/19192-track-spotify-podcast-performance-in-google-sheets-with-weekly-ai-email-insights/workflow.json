    {
      "id": "846fb798-474d-4117-b87f-0813cd95983e",
      "name": "Compare, score and rank",
      "type": "n8n-nodes-base.code",
      "position": [
        5440,
        -256
      ],
      "parameters": {
        "jsCode": "// This is where the raw numbers become something you can act on.\n// Three things happen here: week-on-week deltas, podcast-wide benchmarks,\n// and a single performance score so episodes can be ranked against each other.\n\nconst current  = $('Build the metrics row').all().map(i => i.json);\nconst previous = $input.all().map(i => i.json).filter(r => r && r['Episode ID']);\n\n// Last week's row for each episode, keyed by ID\nconst prevById = {};\nfor (const row of previous) prevById[row['Episode ID']] = row;\n\nconst num = v => Number(String(v ?? 0).replace(/[^0-9.\\-]/g, '')) || 0;\nconst pct = (now, before) => before > 0 ? Math.round(((now - before) / before) * 1000) / 10 : null;\n\n// Podcast-wide averages, used as the benchmark each episode is measured against\nconst avg = key => current.length\n  ? Math.round((current.reduce((s, e) => s + num(e[key]), 0) / current.length) * 10) / 10\n  : 0;\nconst avgPlays     = avg('Plays');\nconst avgRetention = avg('Audience Retention (%)');\nconst avgHours     = avg('Consumption Hours');\n\nconst rows = current.map(e => {\n  const before = prevById[e['Episode ID']];\n  const isNew  = !before;\n\n  const playsNow    = num(e['Plays']);\n  const playsBefore = num(before?.['Plays']);\n  const playsDelta  = isNew ? null : playsNow - playsBefore;\n  const playsPct    = isNew ? null : pct(playsNow, playsBefore);\n\n  // Score blends reach against retention so a short viral episode does not\n  // automatically beat a long one people actually finish.\n  const reachScore     = avgPlays     > 0 ? (playsNow / avgPlays) * 50 : 0;\n  const retentionScore = avgRetention > 0 ? (num(e['Audience Retention (%)']) / avgRetention) * 50 : 0;\n  const score = Math.round(Math.min(reachScore + retentionScore, 200));\n\n  let tier = 'Average';\n  if (score >= 130) tier = 'Top performer';\n  else if (score <= 70) tier = 'Underperforming';\n\n  return {\n    json: {\n      ...e,\n      'Plays Change': playsDelta,\n      'Plays Change (%)': playsPct,\n      'Performance Score': score,\n      'Tier': tier,\n      'Status': isNew ? 'New this week' : (playsPct > 0 ? 'Growing' : 'Flat or declining'),\n      'Updated At': new Date().toISOString().slice(0, 16).replace('T', ' '),\n    }\n  };\n});\n\n// Best and worst first so the email and the sheet both read usefully\nrows.sort((a, b) => b.json['Performance Score'] - a.json['Performance Score']);\n\n// Carry the benchmarks on every row so later nodes do not recalculate them\nfor (const r of rows) {\n  r.json._avgPlays = avgPlays;\n  r.json._avgRetention = avgRetention;\n  r.json._avgHours = avgHours;\n  r.json._episodeCount = rows.length;\n  r.json._newThisWeek = rows.filter(x => x.json['Status'] === 'New this week').length;\n}\n\nreturn rows;\n"
      },
      "typeVersion": 2
    },
