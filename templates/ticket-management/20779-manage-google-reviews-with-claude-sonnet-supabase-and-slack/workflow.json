      "name": "Get New Reviews",
      "type": "n8n-nodes-base.code",
      "position": [
        304,
        592
      ],
      "parameters": {
        "jsCode": "// DEMO SOURCE: replace this Code node with an HTTP Request to the Google Business Profile reviews API\n// (GET https://mybusiness.googleapis.com/v4/accounts/{accountId}/locations/{locationId}/reviews, OAuth2)\n// and map the response to the same fields below.\nconst now = new Date().toISOString();\nconst reviews = [\n  { review_id: 'rev_1001', customer_name: 'Priya', rating: 5, review_text: 'Absolutely loved the service. The staff was friendly and everything was handled quickly. Will definitely come back.' },\n  { review_id: 'rev_1002', customer_name: 'Arjun', rating: 3, review_text: 'The product was good, but the delivery took longer than expected.' },\n  { review_id: 'rev_1003', customer_name: 'Rahul', rating: 1, review_text: 'I waited almost an hour for my order. Very disappointing experience and nobody explained the delay.' },\n];\nreturn reviews.map(r => ({ json: { ...r, review_date: now, business_id: 'biz_001', business_name: 'Demo Bistro' } }));"
      },
      "typeVersion": 2
    },
