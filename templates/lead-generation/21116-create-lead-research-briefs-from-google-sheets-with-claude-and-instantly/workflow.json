    {
      "id": "e2a76fb7-71ce-4267-a4a1-97c873b8454a",
      "name": "Add Lead to Instantly",
      "type": "n8n-nodes-base.httpRequest",
      "onError": "continueRegularOutput",
      "position": [
        4260,
        700
      ],
      "parameters": {
        "url": "https://api.instantly.ai/api/v2/leads",
        "method": "POST",
        "options": {
          "timeout": 30000
        },
        "jsonBody": "={{ { \"campaign\": $('Settings').first().json.instantly_campaign_id, \"email\": $json.email, \"first_name\": $json.first_name, \"company_name\": $json.company_name, \"personalization\": $json.document_url } }}",
        "sendBody": true,
        "specifyBody": "json",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth"
      },
      "typeVersion": 4.2,
      "alwaysOutputData": true
    },
    {
      "id": "ff708159-facc-45e2-97a4-6c0065bda426",
      "name": "Restore Result",
      "type": "n8n-nodes-base.code",
      "position": [
        4480,
        700
      ],
      "parameters": {
        "jsCode": "// Instantly's answer replaces our data, so bring our result back and record how Instantly went.\nconst result = $('Build Result').first().json;\nconst response = $input.first().json;\nconst added = Boolean(response.id) && !response.error;\n\n// DOC ONLY means the document exists but the lead was not added to Instantly.\nreturn [{ json: { ...result, processed: added ? 'YES' : 'DOC ONLY' } }];\n"
      },
      "typeVersion": 2
    },
    {
      "id": "42c36192-bb60-4c01-8444-729e7658f8eb",
      "name": "Mark Lead as Failed",
      "type": "n8n-nodes-base.code",
      "position": [
        4780,
        700
      ],
      "parameters": {
        "jsCode": "// Something failed for this lead. Keep Processed as NO so it retries on the next run.\nconst lead = $input.first().json;\nreturn [{ json: { email: lead.email, document_url: '', processed: 'NO', status: 'error' } }];\n"
      },
      "typeVersion": 2
    },
    {
