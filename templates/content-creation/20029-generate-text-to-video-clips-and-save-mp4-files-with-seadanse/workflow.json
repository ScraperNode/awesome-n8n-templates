{
  "id": "SeadanseTextV1",
  "name": "Seadanse text to video and save MP4",
  "nodes": [
    {
      "id": "start",
      "name": "Start",
      "type": "n8n-nodes-base.manualTrigger",
      "position": [
        0,
        300
      ],
      "parameters": {},
      "typeVersion": 1
    },
    {
      "id": "configure",
      "name": "Configure",
      "type": "n8n-nodes-base.code",
      "position": [
        240,
        300
      ],
      "parameters": {
        "jsCode": "return [{ json: {\n  prompt: 'A quiet mountain sunrise, slow camera movement',\n  model: 'seedance-2.0-mini', durationSeconds: 4, resolution: '480p',\n  aspectRatio: '16:9', maxCredits: 24,\n  // Change only for a NEW intended generation. Keep it for retries.\n  requestId: 'replace-with-your-unique-job-id',\n  imagePath: '/files/input.png', outputDirectory: '/files',\n  startedAt: Date.now(), timeoutMinutes: 30\n} }];"
      },
      "typeVersion": 2
    },
    {
      "id": "validate-configuration",
      "name": "Validate configuration",
      "type": "n8n-nodes-base.code",
      "position": [
        480,
        300
      ],
      "parameters": {
        "jsCode": "const c = $json;\nif (c.requestId === 'replace-with-your-unique-job-id' || !/^[A-Za-z0-9._:-]{8,128}$/.test(c.requestId)) throw new Error('Set a unique requestId; retain it when retrying this same job.');\nif (!c.prompt || c.prompt.length > 4000) throw new Error('Prompt must contain 1\u20134000 characters.');\nif (!Number.isFinite(c.maxCredits) || c.maxCredits < 0) throw new Error('Set maxCredits to your approved spending limit.');\nreturn $input.all();"
      },
      "typeVersion": 2
    },
    {
      "id": "build-generation",
      "name": "Build generation",
      "type": "n8n-nodes-base.code",
      "position": [
        720,
        300
      ],
      "parameters": {
        "jsCode": "const c = $('Configure').first().json;\nreturn [{json: {model: c.model, prompt: c.prompt, durationSeconds: c.durationSeconds,\nresolution: c.resolution, aspectRatio: c.aspectRatio, maxCredits: c.maxCredits}}];"
      },
      "typeVersion": 2
    },
    {
      "id": "generate-video",
      "name": "Generate video",
      "type": "n8n-nodes-base.httpRequest",
      "position": [
        960,
        300
      ],
      "parameters": {
        "url": "https://seadanse.com/api/v1/generations",
        "method": "POST",
        "options": {
          "timeout": 120000
        },
        "jsonBody": "={{ $json }}",
        "sendBody": true,
        "sendHeaders": true,
        "specifyBody": "json",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "headerParameters": {
          "parameters": [
            {
              "name": "Idempotency-Key",
              "value": "={{ $('Configure').first().json.requestId }}"
            }
          ]
        }
      },
      "typeVersion": 4.2
    },
    {
      "id": "keep-receipt",
      "name": "Keep receipt",
      "type": "n8n-nodes-base.code",
      "position": [
        1200,
        300
      ],
      "parameters": {
        "jsCode": "if (!$json.success || !$json.data?.runId) throw new Error('Missing generation receipt.');\nreturn [{json: $json.data}];"
      },
      "typeVersion": 2
    },
    {
      "id": "wait-10-seconds",
      "name": "Wait 10 seconds",
      "type": "n8n-nodes-base.wait",
      "position": [
        1440,
        300
      ],
      "parameters": {
        "unit": "seconds",
        "amount": 10
      },
      "typeVersion": 1.1
    },
    {
      "id": "get-generation",
      "name": "Get generation",
      "type": "n8n-nodes-base.httpRequest",
      "position": [
        1680,
        300
      ],
      "parameters": {
        "url": "={{ 'https://seadanse.com/api/v1/generations/' + $('Keep receipt').first().json.runId }}",
        "options": {
          "timeout": 30000
        },
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth"
      },
      "typeVersion": 4.2
    },
    {
      "id": "check-status",
      "name": "Check status",
      "type": "n8n-nodes-base.code",
      "position": [
        1920,
        300
      ],
      "parameters": {
        "jsCode": "const d = $json.data;\nif (!$json.success || !d || !['queued','processing','succeeded','failed'].includes(d.status)) throw new Error('Invalid generation response.');\nif (d.status === 'failed') throw new Error('Generation failed. Run ID: ' + d.runId);\nconst c = $('Configure').first().json;\nif (d.status !== 'succeeded' && Date.now() - c.startedAt > c.timeoutMinutes * 60000) throw new Error('Wait timed out; query existing run ' + d.runId + ' before creating another generation.');\nreturn [{json: d}];"
      },
      "typeVersion": 2
    },
    {
      "id": "finished",
      "name": "Finished",
      "type": "n8n-nodes-base.if",
      "position": [
        2160,
        300
      ],
      "parameters": {
        "options": {},
        "conditions": {
          "options": {
            "version": 2,
            "leftValue": "",
            "caseSensitive": true,
            "typeValidation": "strict"
          },
          "combinator": "and",
          "conditions": [
            {
              "id": "Finished-condition",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              },
              "leftValue": "={{ $json.status === 'succeeded' }}",
              "rightValue": true
            }
          ]
        }
      },
      "typeVersion": 2.2
    },
    {
      "id": "select-files",
      "name": "Select files",
      "type": "n8n-nodes-base.code",
      "position": [
        2400,
        300
      ],
      "parameters": {
        "jsCode": "if (!$json.files?.length) throw new Error('Success response has no files.');\nreturn $json.files.map(file => {\n  const expected = '/api/v1/generations/' + $json.runId + '/files/';\n  if (!file.downloadUrl?.startsWith(expected)) throw new Error('Invalid file endpoint.');\n  return {json: {runId: $json.runId, fileId: file.id, downloadUrl: file.downloadUrl}};\n});"
      },
      "typeVersion": 2
    },
    {
      "id": "get-download-grant",
      "name": "Get download grant",
      "type": "n8n-nodes-base.httpRequest",
      "position": [
        2640,
        300
      ],
      "parameters": {
        "url": "={{ 'https://seadanse.com' + $json.downloadUrl }}",
        "options": {
          "timeout": 30000,
          "redirect": {
            "redirect": {
              "followRedirects": false
            }
          },
          "response": {
            "response": {
              "neverError": true,
              "fullResponse": true,
              "responseFormat": "text"
            }
          }
        },
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth"
      },
      "typeVersion": 4.2
    },
    {
      "id": "validate-grant",
      "name": "Validate grant",
      "type": "n8n-nodes-base.code",
      "position": [
        2880,
        300
      ],
      "parameters": {
        "jsCode": "return $input.all().map((item, index) => {\n  const r = item.json;\n  if (r.statusCode !== 307 || !r.headers?.location?.startsWith('https://')) throw new Error('Download grant request failed; status ' + r.statusCode);\n  return {json: {grantUrl: r.headers.location}, pairedItem: {item: index}};\n});"
      },
      "typeVersion": 2
    },
    {
      "id": "download-mp4",
      "name": "Download MP4",
      "type": "n8n-nodes-base.httpRequest",
      "position": [
        3120,
        300
      ],
      "parameters": {
        "url": "={{ $json.grantUrl }}",
        "options": {
          "timeout": 120000,
          "response": {
            "response": {
              "responseFormat": "file",
              "outputPropertyName": "data"
            }
          }
        }
      },
      "typeVersion": 4.2
    },
    {
      "id": "save-mp4",
      "name": "Save MP4",
      "type": "n8n-nodes-base.readWriteFile",
      "position": [
        3360,
        300
      ],
      "parameters": {
        "options": {},
        "fileName": "={{ $('Configure').first().json.outputDirectory + '/seadanse-' + $('Select files').item.json.runId + '-' + $('Select files').item.json.fileId + '.mp4' }}",
        "operation": "write"
      },
      "typeVersion": 1
    },
    {
      "id": "setup-notes",
      "name": "Setup notes",
      "type": "n8n-nodes-base.stickyNote",
      "position": [
        -840,
        -180
      ],
      "parameters": {
        "color": 1,
        "width": 760,
        "height": 900,
        "content": "## Generate text-to-video clips with Seadanse\n\n### How it works\nFor content creators using self-hosted n8n, this workflow turns a text prompt into a video and saves an MP4 locally. It submits once, checks progress every ten seconds for up to thirty minutes, then obtains a temporary download grant. The media download does not receive your API key. Output filenames include the run and file IDs.\n\n### Setup\n1. Use a paid-eligible [Seadanse](https://seadanse.com) account with sufficient credits. Create an API key with generation read/write scopes. Generation consumes credits; this template is free.\n2. Create an n8n Header Auth credential: Authorization = Bearer YOUR_KEY. Select it on Generate video, Get generation, Get download grant. Never add it to Download MP4.\n3. Mount a writable /files directory and allow n8n file access. Edit Configure: prompt, unique requestId, maxCredits and outputDirectory.\n4. Check [current pricing and model options](https://seadanse.com/developers/api-guide.md), then execute. Mini, four seconds and 480p are sample settings.\n\n### Customization\nChange model settings and budget in Configure. Retry uncertain submissions with the same requestId and exact body. A timeout does not cancel the job. Recover by querying its run ID; download or save failures do not require another generation. Cloud storage adaptation is not included in this tested self-hosted export."
      },
      "typeVersion": 1
    },
    {
      "id": "1.-configure-inputs-and-credentials",
      "name": "1. Configure inputs and credentials",
      "type": "n8n-nodes-base.stickyNote",
      "position": [
        -40,
        180
      ],
      "parameters": {
        "color": 7,
        "width": 700,
        "height": 340,
        "content": "## 1. Configure inputs and credentials"
      },
      "typeVersion": 1
    },
    {
      "id": "submit-once-and-retain-the-receipt",
      "name": "Submit once and retain the receipt",
      "type": "n8n-nodes-base.stickyNote",
      "position": [
        680,
        180
      ],
      "parameters": {
        "color": 7,
        "width": 700,
        "height": 340,
        "content": "## Submit once and retain the receipt"
      },
      "typeVersion": 1
    },
    {
      "id": "wait-and-check-the-existing-run",
      "name": "Wait and check the existing run",
      "type": "n8n-nodes-base.stickyNote",
      "position": [
        1400,
        180
      ],
      "parameters": {
        "color": 7,
        "width": 940,
        "height": 340,
        "content": "## Wait and check the existing run"
      },
      "typeVersion": 1
    },
    {
      "id": "download-privately-and-save-the-mp4",
      "name": "Download privately and save the MP4",
      "type": "n8n-nodes-base.stickyNote",
      "position": [
        2360,
        180
      ],
      "parameters": {
        "color": 7,
        "width": 1180,
        "height": 340,
        "content": "## Download privately and save the MP4"
      },
      "typeVersion": 1
    }
  ],
  "active": false,
  "pinData": {},
  "settings": {
    "executionOrder": "v1",
    "executionTimeout": 2400,
    "saveManualExecutions": false,
    "saveDataErrorExecution": "none",
    "saveDataSuccessExecution": "none"
  },
  "connections": {
    "Start": {
      "main": [
        [
          {
            "node": "Configure",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Finished": {
      "main": [
        [
          {
            "node": "Select files",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Wait 10 seconds",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Configure": {
      "main": [
        [
          {
            "node": "Validate configuration",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Check status": {
      "main": [
        [
          {
            "node": "Finished",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Download MP4": {
      "main": [
        [
          {
            "node": "Save MP4",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Keep receipt": {
      "main": [
        [
          {
            "node": "Wait 10 seconds",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Select files": {
      "main": [
        [
          {
            "node": "Get download grant",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Generate video": {
      "main": [
        [
          {
            "node": "Keep receipt",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Get generation": {
      "main": [
        [
          {
            "node": "Check status",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Validate grant": {
      "main": [
        [
          {
            "node": "Download MP4",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Wait 10 seconds": {
      "main": [
        [
          {
            "node": "Get generation",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Build generation": {
      "main": [
        [
          {
            "node": "Generate video",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Get download grant": {
      "main": [
        [
          {
            "node": "Validate grant",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Validate configuration": {
      "main": [
        [
          {
