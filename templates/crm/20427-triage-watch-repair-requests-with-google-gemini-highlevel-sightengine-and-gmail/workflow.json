    {
      "id": "25dd2b22-f911-4ce4-8c28-154c909e3f70",
      "name": "Create AI Agent Context",
      "type": "n8n-nodes-base.code",
      "position": [
        1856,
        -416
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const base = $('Rebuild Photo Binary Data').item.json;\nconst t = $('Prepare Ticket Data').item.json;\nconst a = $input.item.json;\n\nreturn {\n  json: {\n    ...base,\n    ticket_id: t.ticket_id,\n    submitted_at: t.submitted_at,\n    photo_format: t.photo_format,\n    photo_dimensions: t.photo_dimensions,\n    ai_generated_score: a.ai_generated_score,\n    authenticity_status: a.authenticity_status\n  },\n  binary: $('Rebuild Photo Binary Data').item.binary // Added binary passthrough\n};"
      },
      "typeVersion": 2
    },
    {
      "id": "412fe79e-ba41-4cf6-bc2b-f01db75e54b0",
      "name": "Quotation AI Agent",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "position": [
        2080,
        -416
      ],
      "parameters": {
        "text": "=Ticket: {{ $json.ticket_id }}\nShop name: {{ $json.shop_name }}\nCustomer: {{ $json.customer_name }}\nWatch: {{ $json.watch_brand }} {{ $json.watch_model }} ({{ $json.movement_type }})\nService preference: {{ $json.service_preference }}\nIssue description: {{ $json.issue_description }}\nPhoto authenticity: {{ $json.authenticity_status }} (AI-generated score: {{ $json.ai_generated_score }})",
        "options": {
          "systemMessage": "You are the intake triage assistant for a watch repair shop. You receive a customer's repair request plus the result of a photo-authenticity check. Classify the issue, estimate cost and turnaround, decide whether a human must review it, and draft a short, warm, professional email reply to the customer.\n\nPRICE GUIDE (USD - edit to match the shop):\n- Battery replacement: 15-40\n- Quartz movement service: 60-150\n- Mechanical/automatic full service: 180-450\n- Crystal/glass replacement: 40-200\n- Crown/stem replacement: 50-180\n- Water damage assessment + repair: 120-400\n- Strap/bracelet resize or replace: 15-120\n- Case polish/refinish: 50-200\n- Smartwatch: only battery/screen work, 80-250, otherwise needs manual review\n- Luxury or vintage pieces: widen the range upward and always set needs_manual_review to true\n\nTURNAROUND: battery/strap 1-2 days; quartz 3-7; mechanical 14-28; water damage 7-14; add 7-14 days if parts must be ordered.\n\nRULES:\n- Never promise a fixed price. Give a range and say the final quote follows an in-shop inspection.\n- If authenticity_status is SUSPICIOUS, the photo may be AI-generated or a stock image: set fraud_flag and needs_manual_review to true, and keep the customer email neutral (never accuse). If UNVERIFIED or REVIEW, set needs_manual_review to true only if the description is also vague.\n- If the description is vague, ask at most two clarifying questions in the email.\n- urgency = high if the customer mentions a deadline, gift, event or heirloom; otherwise medium or low.\n- Email: plain text, under 140 words, no markdown, include the ticket ID, sign off as the shop team named in the request.\n- Return only the structured output.",
          "passthroughBinaryPdfs": true,
          "passthroughBinaryImages": true
        },
        "promptType": "define",
        "hasOutputParser": true
      },
      "typeVersion": 3.1
    },
    {
