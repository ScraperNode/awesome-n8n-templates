      ],
      "parameters": {
        "color": 1,
        "width": 220,
        "height": 220,
        "content": "### 9. IF Reschedule Requested\nRoutes the flow: reschedule requests continue to the owner alert; anything else stops here."
      },
      "typeVersion": 1
    },
    {
      "id": "bcf3195d-b38d-44ce-869a-3b4aa099b9d3",
      "name": "Sticky - Step 10",
      "type": "n8n-nodes-base.stickyNote",
      "position": [
        1100,
