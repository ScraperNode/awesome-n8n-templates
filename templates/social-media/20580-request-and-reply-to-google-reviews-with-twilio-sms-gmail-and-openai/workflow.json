    {
      "id": "d30bd695-a145-4825-9252-b33e0c800987",
      "name": "Filter Eligible - Code",
      "type": "n8n-nodes-base.code",
      "position": [
        780,
        420
      ],
      "parameters": {
        "jsCode": "// Keep customers with a mobile number who were not asked in the last 90 days.\nconst now = new Date();\nconst out = [];\nfor (const item of $input.all()) {\n  const r = item.json;\n  const mobile = String(r.mobile || r.phone || '').trim();\n  if (!mobile) continue;\n  const last = r.last_review_request ? new Date(r.last_review_request) : null;\n  if (!last || (now - last) / 86400000 > 90) out.push({ json: { ...r, mobile } });\n}\nreturn out;"
      },
      "typeVersion": 2
    },
    {
      "id": "a07e472b-3787-4e42-b20c-cb8b043f7c7f",
      "name": "Send Review SMS - Twilio",
      "type": "n8n-nodes-base.twilio",
      "position": [
        1040,
        420
      ],
      "parameters": {
        "to": "={{ $json.mobile }}",
        "from": "={{ $('CONFIG - Reviews (Jobs)').first().json.twilio_number }}",
        "message": "Hi {{ $json.first_name }}! Thanks for choosing {{ $('CONFIG - Reviews (Jobs)').first().json.business_name }}. If you had a great experience, a quick Google review would mean the world to us: {{ $('CONFIG - Reviews (Jobs)').first().json.review_link }} (Reply STOP to opt out)",
        "resource": "sms",
        "operation": "send"
      },
      "credentials": {
        "twilioApi": {
          "id": "credential-id",
          "name": "YOUR Twilio account"
        }
      },
      "typeVersion": 1
    },
