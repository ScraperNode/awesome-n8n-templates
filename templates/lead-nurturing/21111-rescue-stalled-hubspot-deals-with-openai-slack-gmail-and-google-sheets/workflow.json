    {
      "id": "605a6f67-f0a5-4de7-a6bb-7f732a35bf94",
      "name": "Section: Detect Stalled",
      "type": "n8n-nodes-base.stickyNote",
      "position": [
        560,
        200
      ],
      "parameters": {
        "color": 3,
        "width": 600,
        "height": 300,
        "content": "### 4 | Detect stalled deals\nCode computes days since last activity per deal and keeps only the quiet ones past your threshold."
      },
      "typeVersion": 1
    },
    {
      "id": "c3599e0c-0dba-4016-b6b3-667ad5f2446a",
      "name": "Detect Stalled Deals",
      "type": "n8n-nodes-base.code",
      "position": [
        640,
        400
      ],
      "parameters": {
        "jsCode": "// Find open deals with no recent activity.\nvar cfg = $('Workflow Configuration').first().json;\nvar thresholdDays = Number(cfg.stalledDaysThreshold) || 14;\nvar now = Date.now();\nvar stalled = [];\nfor (var i = 0; i < $input.all().length; i++) {\n  var d = $input.all()[i].json;\n  var props = d.properties || d;\n  var stage = String(props.dealstage || '');\n  if (stage.indexOf('closed') === 0) continue;\n  var lastMod = props.hs_lastmodifieddate ? Date.parse(props.hs_lastmodifieddate)\n              : (props.createdate ? Date.parse(props.createdate) : now);\n  var daysStalled = Math.floor((now - lastMod) / 86400000);\n  if (daysStalled < thresholdDays) continue;\n  stalled.push({ json: {\n    dealId: String(d.id || ''),\n    dealName: String(props.dealname || 'Untitled deal'),\n    amount: Number(props.amount) || 0,\n    currency: cfg.currency || 'USD',\n    stage: stage,\n    daysStalled: daysStalled,\n    lastActivity: props.hs_lastmodifieddate || '',\n    thresholdDays: thresholdDays,\n    timestamp: new Date().toISOString()\n  }});\n}\nreturn stalled;\n"
      },
      "typeVersion": 2
    },
    {
      "id": "e3a96649-475b-44cb-982d-5200f16b6602",
      "name": "Section: AI Draft",
      "type": "n8n-nodes-base.stickyNote",
      "position": [
        1220,
        200
      ],
      "parameters": {
        "color": 3,
        "width": 620,
        "height": 300,
        "content": "### 5 | AI drafts re-engagement\nOne personal email per stalled deal, grounded in deal name, value, stage, and days quiet. Under 120 words, one clear CTA."
      },
      "typeVersion": 1
    },
    {
      "id": "5aa7aa2e-c001-49b9-8dba-daf6f6c0adb0",
      "name": "Draft Re-engagement Email",
      "type": "n8n-nodes-base.openAi",
      "position": [
        1300,
        400
      ],
      "parameters": {
        "prompt": {
          "messages": [
            {
              "role": "system",
              "content": "You are a senior SDR coach. Write a short, human re-engagement email for a stalled sales deal. Rules: under 120 words, reference the specific deal context given, one clear low-friction call to action (a 15-minute call), no buzzwords, no phrase like just checking in or touching base, no fake familiarity. Output the email body only, plain text."
            },
            {
              "role": "user",
              "content": "={{ 'Deal: ' + $json.dealName + '\\nValue: ' + $json.currency + ' ' + $json.amount + '\\nStage: ' + $json.stage + '\\nDays without activity: ' + $json.daysStalled + '\\nSender name: ' + $('Workflow Configuration').first().json.senderName }}"
            }
          ]
        },
        "options": {},
        "resource": "chat",
        "chatModel": "gpt-4o-mini",
        "operation": "complete",
        "simplifyOutput": false
      },
      "credentials": {},
      "typeVersion": 1.1
    },
    {
      "id": "a1200dcb-681f-4f7c-9e05-55b6079cb193",
      "name": "Section: Routing",
      "type": "n8n-nodes-base.stickyNote",
      "position": [
        1900,
        200
