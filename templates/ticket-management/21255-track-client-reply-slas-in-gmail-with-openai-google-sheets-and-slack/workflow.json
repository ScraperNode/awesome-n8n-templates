    {
      "id": "aa88e3c9-6ddd-4fee-9c2b-666d9ab89645",
      "name": "Build log record",
      "type": "n8n-nodes-base.code",
      "position": [
        1960,
        -260
      ],
      "parameters": {
        "jsCode": "return $input.all().map((item, i) => {\n  const t = $('Route by change').itemMatching(i).json;\n  const ai = item.json.output || {};\n  const needs = ai.needs_reply !== false;\n  return { json: {\n    ...t,\n    summary: ai.summary || t.snippet.slice(0, 120),\n    priority: needs ? (ai.priority || 'normal') : 'none',\n    status: needs ? 'open' : 'no_reply_needed',\n    flagged_at: new Date().toISOString(),\n    needs_reply: needs,\n  } };\n});"
      },
      "typeVersion": 2
    },
