    },
    {
      "id": "1b2f7d91-585b-4d49-8ee0-8446d45d0dc7",
      "name": "Copy the tab across",
      "type": "n8n-nodes-base.httpRequest",
      "position": [
        6128,
        416
      ],
      "parameters": {
        "url": "=https://sheets.googleapis.com/v4/spreadsheets/{{ $('Set config').first().json.sourceSpreadsheetId }}/sheets/{{ $('Find last month\\'s tab').first().json.sourceSheetId }}:copyTo",
        "method": "POST",
        "options": {},
        "jsonBody": "={\n  \"destinationSpreadsheetId\": \"{{ $('Create the archive spreadsheet').first().json.spreadsheetId }}\"\n}",
        "sendBody": true,
        "specifyBody": "json",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "googleOAuth2Api"
      },
      "typeVersion": 4.2
    },
    {
      "id": "895f9700-516f-4e76-9684-20b444d60103",
      "name": "Tidy up the archive",
      "type": "n8n-nodes-base.httpRequest",
      "notes": "One batch call does four things: rename the copied tab, freeze and bold the header row, size the columns to fit, and delete the empty Sheet1 that every new spreadsheet starts with.",
      "position": [
        6416,
        416
      ],
      "parameters": {
        "url": "=https://sheets.googleapis.com/v4/spreadsheets/{{ $('Create the archive spreadsheet').first().json.spreadsheetId }}:batchUpdate",
        "method": "POST",
        "options": {},
        "jsonBody": "={\n  \"requests\": [\n    {\n      \"updateSheetProperties\": {\n        \"properties\": {\n          \"sheetId\": {{ $json.sheetId }},\n          \"title\": \"{{ $('Work out last month').first().json.archiveName }}\",\n          \"gridProperties\": { \"frozenRowCount\": 1 }\n        },\n        \"fields\": \"title,gridProperties.frozenRowCount\"\n      }\n    },\n    {\n      \"repeatCell\": {\n        \"range\": { \"sheetId\": {{ $json.sheetId }}, \"startRowIndex\": 0, \"endRowIndex\": 1 },\n        \"cell\": { \"userEnteredFormat\": { \"textFormat\": { \"bold\": true } } },\n        \"fields\": \"userEnteredFormat.textFormat.bold\"\n      }\n    },\n    {\n      \"autoResizeDimensions\": {\n        \"dimensions\": { \"sheetId\": {{ $json.sheetId }}, \"dimension\": \"COLUMNS\", \"startIndex\": 0, \"endIndex\": 20 }\n      }\n    },\n    {\n      \"deleteSheet\": {\n        \"sheetId\": {{ $('Create the archive spreadsheet').first().json.sheets[0].properties.sheetId }}\n      }\n    }\n  ]\n}",
        "sendBody": true,
        "specifyBody": "json",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "googleOAuth2Api"
      },
      "typeVersion": 4.2
    },
