    {
      "id": "b043e569-6ea1-40ae-92f1-5a140f211543",
      "name": "Email Staff (Human Handoff)",
      "type": "n8n-nodes-base.emailSend",
      "position": [
        3104,
        1712
      ],
      "webhookId": "2b06950c-51cf-4f64-8a47-6df7b96a7b62",
      "parameters": {
        "html": "=<p>A customer needs human assistance.</p>\n<p><b>Platform:</b> {{ $('Normalize Message').item.json.platform }}<br>\n<b>Sender:</b> {{ $('Normalize Message').item.json.senderId }}<br>\n<b>Message:</b> {{ $('Normalize Message').item.json.messageText }}</p>\n<p>Bot will stay silent for this contact for 4 hours or until you reset their status to 'active' in the Contacts sheet.</p>",
