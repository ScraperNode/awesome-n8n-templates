    {
      "id": "6d899182-b889-4a82-a3d1-88da10110af0",
      "name": "Look at the product photo",
      "type": "@n8n/n8n-nodes-langchain.googleGemini",
      "position": [
        1200,
        0
      ],
      "parameters": {
        "text": "={{ 'This is the photo of a product that was just added to an online store.\\nName: ' + $('New product in Shopify').item.json.title + '\\nDescription: ' + String($('New product in Shopify').item.json.body_html || '').replace(/<[^>]+>/g, ' ').replace(/\\s+/g, ' ').slice(0, 600) + '\\nVisual style: ' + $('Store settings').item.json.style + '\\n\\nReturn only JSON with two keys. veo_prompt: one paragraph for an 8-second vertical product video made with Veo: describe the product exactly as it looks in the photo (shape, colour, material), where it sits, one simple action or camera move, the light and the ambient sound; no on-screen text, no logos, no people. selling_point: one sentence a shopper would care about, using only facts from the name, the description and the photo.' }}",
        "modelId": {
          "__rl": true,
          "mode": "id",
          "value": "models/gemini-2.5-flash"
        },
        "options": {
          "maxOutputTokens": 700
        },
        "resource": "image",
        "imageUrls": "={{ $('New product in Shopify').item.json.image.src }}",
        "inputType": "url",
        "operation": "analyze"
      },
      "typeVersion": 1.2
    },
    {
      "id": "093332a3-4368-496a-a772-fabfc8870e42",
      "name": "Build the brief",
      "type": "n8n-nodes-base.set",
      "position": [
        1500,
        0
      ],
      "parameters": {
        "options": {},
        "assignments": {
          "assignments": [
            {
              "id": "dbd947ff-07e6-4f0f-a735-628d4e5d9ecb",
              "name": "plan",
              "type": "object",
              "value": "={{ (() => { const t = ($json.content?.parts || []).map(p => p.text || '').join(''); const m = t.match(/\\{[\\s\\S]*\\}/); try { return JSON.parse(m ? m[0] : t); } catch (e) { return { veo_prompt: t, selling_point: '' }; } })() }}"
            },
            {
              "id": "7ec8ae12-08a8-4602-a94b-69d8b3996575",
              "name": "product",
              "type": "string",
              "value": "={{ $('New product in Shopify').item.json.title }}"
            },
            {
              "id": "6da258be-2a2f-4a60-ab59-48d49756c489",
              "name": "price",
              "type": "string",
              "value": "={{ $('New product in Shopify').item.json.variants?.[0]?.price || '' }}"
            },
            {
              "id": "e9751589-32ca-47b8-a295-bd7dfaa5b12c",
              "name": "product_url",
              "type": "string",
              "value": "={{ $('Store settings').item.json.store_url.replace(/\\/$/, '') + '/products/' + $('New product in Shopify').item.json.handle }}"
            },
            {
              "id": "e393dc09-25fe-4375-a5cc-451d88faa605",
              "name": "product_id",
              "type": "string",
              "value": "={{ $('New product in Shopify').item.json.id }}"
            }
          ]
        }
      },
      "typeVersion": 3.4
    },
    {
      "id": "8de64bf3-b3c1-4be8-a0f2-9bf11ab16601",
      "name": "Veo 3.1 render",
      "type": "@n8n/n8n-nodes-langchain.googleGemini",
      "position": [
        0,
        552
      ],
      "parameters": {
        "prompt": "={{ $json.plan.veo_prompt }}",
        "modelId": {
          "__rl": true,
          "mode": "id",
          "value": "models/veo-3.1-fast-generate-preview"
        },
        "options": {
          "aspectRatio": "9:16",
          "durationSeconds": 8
