      "position": [
        384,
        96
      ],
      "parameters": {
        "jsCode": "const raw = $input.first().json.candidates[0].content.parts[0].text;\nconst cleaned = raw.replace(/```json|```/g, '').trim();\nconst parsed = JSON.parse(cleaned);\nreturn [{ json: { ...$('Set Brand Context').first().json, image_prompt: parsed.image_prompt, caption: parsed.caption } }];"
      },
      "typeVersion": 2
    },
