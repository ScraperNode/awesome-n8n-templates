    {
      "id": "0cb9326b-3999-4dd9-80b1-01357faf67ce",
      "name": "\u65b0\u7740\u306e\u307f\u30d5\u30a3\u30eb\u30bf(Sheets\u57fa\u6e96)",
      "type": "n8n-nodes-base.code",
      "position": [
        -960,
        0
      ],
      "parameters": {
        "jsCode": "// \u65b0\u7740\u30ea\u30ea\u30fc\u30b9\u304b\u3089\u300c### Features\u300d\u90e8\u5206\u3060\u3051\u3092\u629c\u304d\u51fa\u3057\u3066\u5f8c\u7d9a\u306b\u6e21\u3059\nconst releases = $('GitHub Releases\u53d6\u5f97').all();\nconst postedRows = $('\u51e6\u7406\u6e08\u307ftag_name\u4e00\u89a7\u3092\u53d6\u5f97').all();\n\nconst postedTags = new Set(\n  postedRows.map(row => row.json.tag_name).filter(Boolean)\n);\n\n// Features \u30bb\u30af\u30b7\u30e7\u30f3\u3060\u3051\u62bd\u51fa\u3057\u3001issue/commit\u30ea\u30f3\u30af\u3092\u524a\u3063\u3066\u77ed\u304f\u3059\u308b\nconst extractFeatures = body => {\n  const text = (body || '').split('<!-- This is an auto-generated')[0];\n  const m = text.match(/### Features\\n([\\s\\S]*?)(?=\\n### |$)/);\n  if (!m) return '';\n  return m[1]\n    .replace(/\\s*\\(\\[#\\d+\\]\\([^)]*\\)\\)/g, '')\n    .replace(/\\s*\\(\\[[0-9a-f]{7,}\\]\\([^)]*\\)\\)/g, '')\n    .trim();\n};\n\nreturn releases\n  .filter(item => {\n    const r = item.json;\n    if (!r.tag_name) return false;\n    // stable / beta \u306a\u3069\u306e\u4f7f\u3044\u56de\u3057\u30bf\u30b0\u306f\u9664\u5916\u3057\u3001n8n@x.y.z \u5f62\u5f0f\u306e\u307f\u5bfe\u8c61\n    if (!/^n8n@\\d+\\.\\d+\\.\\d+$/.test(r.tag_name)) return false;\n    if (postedTags.has(r.tag_name)) return false;\n    if (r.draft) return false; // prerelease(beta)\u306f\u5bfe\u8c61\u306b\u542b\u3081\u308b\n    return true;\n  })\n  .map(item => {\n    const r = item.json;\n    const features = extractFeatures(r.body);\n    return {\n      json: {\n        tag_name: r.tag_name,\n        html_url: r.html_url,\n        is_beta: r.prerelease,\n        body: `${r.tag_name}${r.prerelease ? '\uff08beta\u7248\uff09' : ''}\\n\\n### Features\\n${features}`,\n        has_features: features.length > 0\n      }\n    };\n  })\n  // \u65b0\u6a5f\u80fd\u304c\u306a\u3044\u30ea\u30ea\u30fc\u30b9\u306fClaude\u306b\u6e21\u3055\u306a\u3044(\u30b3\u30b9\u30c8\u524a\u6e1b)\n  .filter(item => item.json.has_features);"
      },
      "typeVersion": 2
    },
