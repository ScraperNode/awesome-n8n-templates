    {
      "id": "91a818c5-b9cb-4f7c-ba4b-8add413ed589",
      "name": "Extract Recording Details",
      "type": "n8n-nodes-base.code",
      "position": [
        800,
        288
      ],
      "parameters": {
        "jsCode": "// Pull the fields we need from Zoom's recording payload\nconst body = $('Zoom Recording Webhook').first().json.body || {};\nconst obj = (body.payload && body.payload.object) || {};\nconst files = obj.recording_files || [];\n\nconst transcript = files.find(f => f.file_type === 'TRANSCRIPT' || f.recording_type === 'audio_transcript');\nconst audio = files.find(f => f.file_type === 'M4A') || files.find(f => f.file_type === 'MP4');\nif (!transcript && !audio) return [];\n\nreturn [{\n  json: {\n    meetingId: String(obj.id || ''),\n    meetingUuid: obj.uuid || String(obj.id || '') + '-' + (obj.start_time || ''),\n    topic: obj.topic || '',\n    startTime: obj.start_time || new Date().toISOString(),\n    durationMin: obj.duration || '',\n    downloadToken: body.download_token || '',\n    hasTranscript: !!transcript,\n    transcriptUrl: transcript ? transcript.download_url : '',\n    audioUrl: audio ? audio.download_url : '',\n  },\n}];"
      },
      "typeVersion": 2
    },
