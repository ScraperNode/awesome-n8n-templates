    {
      "id": "05dbe99b-12be-4e44-ab0f-9157ef9f779a",
      "name": "Email the team the fix",
      "type": "n8n-nodes-base.microsoftOutlook",
      "position": [
        900,
        360
      ],
      "parameters": {
        "subject": "={{ $('Only video files').item.json.name }} was not published everywhere",
        "resource": "message",
        "operation": "send",
        "bodyContent": "={{ ($json.results || []).map(r => (r.ok ? 'Published  ' : 'NOT published  ') + r.platform + (r.url ? '  ' + r.url : '') + (r.ok ? '' : '\\n    ' + (r.fix || r.error))).join('\\n') || $json.error }}",
        "toRecipients": "user@example.com",
        "additionalFields": {}
      },
      "typeVersion": 2
    }
