    {
      "id": "294dfcb1-cf9d-497a-a891-f8704bef3b99",
      "name": "Analyze API Response",
      "type": "n8n-nodes-base.code",
      "position": [
        7120,
        1664
      ],
      "parameters": {
        "jsCode": "const s = $('Prepare LLM Request').last().json;\nconst r = $input.first().json;\n\nconst RETRYABLE_STATUS = [408, 409, 425, 429, 500, 502, 503, 504, 529];\nconst status = typeof r.statusCode === 'number' ? r.statusCode : null;\nconst body = r.body && typeof r.body === 'object' ? r.body : {};\n\nlet text = '';\nlet inputTokens = 0;\nlet outputTokens = 0;\nlet errorType = '';\nlet errorMessage = '';\nlet retryable = false;\nlet retryAfterSeconds = null;\n\nif (status === null) {\n  // No HTTP status: DNS failure, connection reset or timeout\n  errorType = 'request_failed';\n  errorMessage = typeof r.error === 'string' ? r.error : (r.error?.message || JSON.stringify(r.error || r));\n  retryable = true;\n} else if (status >= 200 && status < 300) {\n  if (s.provider === 'openai') {\n    const choice = body.choices?.[0];\n    text = choice?.message?.content || '';\n    inputTokens = body.usage?.prompt_tokens || 0;\n    outputTokens = body.usage?.completion_tokens || 0;\n    if (!text.trim()) errorMessage = `Empty answer (finish_reason: ${choice?.finish_reason})`;\n  } else {\n    text = (body.content || []).filter((b) => b.type === 'text').map((b) => b.text).join('');\n    inputTokens = body.usage?.input_tokens || 0;\n    outputTokens = body.usage?.output_tokens || 0;\n    if (!text.trim()) errorMessage = `Empty answer (stop_reason: ${body.stop_reason})`;\n  }\n  if (errorMessage) errorType = 'empty_response';\n} else {\n  const apiError = body.error || {};\n  errorType = `http_${status}`;\n  errorMessage = apiError.message || r.statusMessage || `HTTP ${status}`;\n  retryable = RETRYABLE_STATUS.includes(status) || status >= 500;\n  // OpenAI returns 429 for an empty balance too; waiting will not fix that\n  if (apiError.code === 'insufficient_quota') retryable = false;\n  const retryAfter = Number(r.headers?.['retry-after']);\n  if (Number.isFinite(retryAfter) && retryAfter >= 0) retryAfterSeconds = retryAfter;\n}\n\nconst isPrimary = s.role === 'primary';\nconst priceIn = isPrimary ? s.primaryInputPricePer1M : s.fallbackInputPricePer1M;\nconst priceOut = isPrimary ? s.primaryOutputPricePer1M : s.fallbackOutputPricePer1M;\nconst callCost = (inputTokens * priceIn + outputTokens * priceOut) / 1e6;\n\nconst history = [...s.history, {\n  provider: s.provider,\n  model: s.model,\n  attempt: s.attempt,\n  result: errorType || 'ok',\n  ms: Date.now() - s.attemptStartedAt,\n  ...(errorMessage ? { error: String(errorMessage).slice(0, 300) } : {}),\n}];\n\nconst canFallBack = isPrimary && Boolean(s.fallbackProvider);\nlet next;\nlet delaySeconds = 0;\n\nif (text.trim()) {\n  next = 'success';\n} else if (retryable && s.attempt < s.maxAttemptsPerProvider) {\n  const backoff = Math.min(s.maxDelaySeconds, s.baseDelaySeconds * 2 ** (s.attempt - 1));\n  delaySeconds = backoff / 2 + Math.random() * (backoff / 2);\n  if (retryAfterSeconds !== null) delaySeconds = Math.max(delaySeconds, retryAfterSeconds);\n  delaySeconds = Math.round(delaySeconds * 100) / 100;\n  if (delaySeconds > s.maxDelaySeconds) {\n    next = canFallBack ? 'fallback' : 'give_up';\n    delaySeconds = 0;\n  } else {\n    next = 'retry';\n  }\n} else {\n  next = canFallBack ? 'fallback' : 'give_up';\n}\n\nconst out = {\n  ...s,\n  history,\n  inputTokens: s.inputTokens + inputTokens,\n  outputTokens: s.outputTokens + outputTokens,\n  costUsd: s.costUsd + callCost,\n  answer: text,\n  lastError: errorMessage ? `${s.provider} ${errorType}: ${errorMessage}` : s.lastError,\n  next,\n  delaySeconds,\n};\ndelete out.requestUrl;\ndelete out.requestBody;\n\nif (next === 'retry') out.attempt = s.attempt + 1;\nif (next === 'fallback') {\n  out.role = 'fallback';\n  out.attempt = 1;\n}\n\nreturn [{ json: out }];\n"
      },
      "typeVersion": 2
    },
