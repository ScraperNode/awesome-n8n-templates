    {
      "id": "8c731e5b-55a8-4e9e-ac1c-71bc10c30b98",
      "name": "Booking Result",
      "type": "n8n-nodes-base.code",
      "position": [
        624,
        560
      ],
      "parameters": {
        "jsCode": "\nconst prep = $('Prep Booking').first().json;\nconst sms = $input.first().json;\nconst smsOk = !sms.error && sms.sid;\nreturn [{ json: { toolCallId: prep.toolCallId, result: `Appointment booked for ${prep.when}. ` + (smsOk ? 'Confirmation SMS sent.' : 'SMS could not be sent, but booking is saved.') } }];\n"
      },
      "typeVersion": 2
    },
    {
      "id": "f9bb0d3c-6891-4fe6-88a9-508d47186225",
      "name": "Find Events",
      "type": "n8n-nodes-base.googleCalendar",
      "position": [
        -48,
        880
      ],
      "parameters": {
        "options": {
          "query": "={{ $json.args.phone }}"
        },
        "timeMin": "={{ $now.toISO() }}",
        "calendar": {
          "__rl": true,
          "mode": "list",
          "value": "YOUR_GOOGLE_CALENDAR_ID",
          "cachedResultName": "YOUR_GOOGLE_CALENDAR_ID"
        },
        "operation": "getAll",
        "returnAll": true
      },
      "credentials": {
        "googleCalendarOAuth2Api": {
          "id": "ZsEfonrSHKjveQ9n",
