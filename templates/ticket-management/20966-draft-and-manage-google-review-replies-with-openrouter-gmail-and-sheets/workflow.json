    {
      "id": "22c9ba72-194d-47ef-9c41-5d00160d3e68",
      "name": "Keep Only New Reviews",
      "type": "n8n-nodes-base.code",
      "position": [
        960,
        304
      ],
      "parameters": {
        "jsCode": "const stars = { ONE: 1, TWO: 2, THREE: 3, FOUR: 4, FIVE: 5 };\nconst logged = new Set($('Read Already-Logged Reviews').all().map(i => String(i.json['Review ID'] || '')).filter(Boolean));\nconst reviews = $('Fetch Latest Google Reviews').first().json.reviews || [];\nreturn reviews\n  .filter(r => r.reviewId && !logged.has(String(r.reviewId)) && !r.reviewReply)\n  .map(r => ({ json: {\n    reviewId: r.reviewId,\n    reviewName: r.name,\n    reviewer: (r.reviewer && r.reviewer.displayName) || 'Customer',\n    rating: stars[r.starRating] || 0,\n    comment: r.comment || '(no written comment)',\n    createdAt: r.createTime || $now.toISO()\n  } }));"
      },
      "typeVersion": 2
    },
    {
      "id": "830bd9d0-226c-4839-aa0f-0d7faed48c21",
      "name": "OpenRouter \u2014 Classify + Draft Reply",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "position": [
        1168,
        304
      ],
      "parameters": {
        "text": "=You write public replies to Google reviews for {{ $('Workflow Settings').first().json.businessName }}.\nBrand voice: {{ $('Workflow Settings').first().json.brandVoice }}\n\nReviewer: {{ $json.reviewer }}\nRating: {{ $json.rating }} out of 5\nReview: {{ $json.comment }}\n\nReturn ONLY valid JSON with these keys:\n{\"sentiment\": \"positive\" | \"neutral\" | \"negative\", \"urgency\": \"high\" | \"medium\" | \"low\", \"summary\": \"one short sentence\", \"reply\": \"public reply under 90 words, no promises of refunds, no personal data\"}",
        "batching": {},
        "promptType": "define"
      },
      "typeVersion": 1.7
    },
    {
      "id": "1506a4dd-8470-4bbd-9e8d-209642827395",
      "name": "OpenRouter Chat Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenRouter",
      "position": [
        1200,
        528
      ],
      "parameters": {
        "model": "openrouter/free",
        "options": {}
      },
      "credentials": {
        "openRouterApi": {
          "id": "credential-id",
          "name": "OpenRouter account"
        }
      },
      "typeVersion": 1
    },
    {
      "id": "74b52fe1-3c9c-4470-b68e-24f3207ad647",
      "name": "Validate AI Draft Safely",
      "type": "n8n-nodes-base.code",
      "position": [
        1440,
        304
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const review = $('Keep Only New Reviews').item.json;\nconst raw = String($json.text || '');\nlet ai = {};\ntry { const m = raw.match(/\\{[\\s\\S]*\\}/); ai = JSON.parse(m ? m[0] : raw); } catch (e) { ai = {}; }\nconst pick = (v, allowed, d) => allowed.includes(String(v).toLowerCase()) ? String(v).toLowerCase() : d;\nconst fallbackSentiment = review.rating >= 4 ? 'positive' : review.rating === 3 ? 'neutral' : 'negative';\nconst reply = typeof ai.reply === 'string' && ai.reply.trim().length > 10 ? ai.reply.trim() : 'Hi ' + review.reviewer + ', thank you for taking the time to share your feedback. We appreciate it and will be in touch if there is anything more we can do.';\nconst urgent = review.rating > 0 && review.rating <= 3;\nreturn { json: { ...review,\n  sentiment: pick(ai.sentiment, ['positive','neutral','negative'], fallbackSentiment),\n  urgency: urgent ? 'high' : pick(ai.urgency, ['high','medium','low'], 'low'),\n  summary: typeof ai.summary === 'string' ? ai.summary : '',\n  reply, urgent, aiParsed: Object.keys(ai).length > 0 } };"
      },
      "typeVersion": 2
    },
    {
      "id": "e03dee5c-3e23-46a0-b6e8-85a16340af2f",
      "name": "Log Review and Draft in Sheets",
      "type": "n8n-nodes-base.googleSheets",
      "position": [
        1680,
        304
      ],
      "parameters": {
        "columns": {
          "value": {
            "Date": "={{ $json.createdAt }}",
            "Rating": "={{ $json.rating }}",
            "Status": "={{ $('Workflow Settings').first().json.autoPostReplies ? 'Auto-posted' : 'Awaiting approval' }}",
            "Comment": "={{ $json.comment }}",
            "Urgency": "={{ $json.urgency }}",
            "Reviewer": "={{ $json.reviewer }}",
            "Review ID": "={{ $json.reviewId }}",
            "Sentiment": "={{ $json.sentiment }}",
            "Draft Reply": "={{ $json.reply }}"
          },
          "schema": [],
          "mappingMode": "defineBelow",
          "matchingColumns": []
        },
        "options": {},
        "operation": "append",
        "sheetName": {
          "__rl": true,
          "mode": "name",
          "value": "Reviews"
        },
        "documentId": {
          "__rl": true,
          "mode": "id",
          "value": "={{ $('Workflow Settings').first().json.sheetId }}"
        }
      },
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "credential-id",
          "name": "Google Sheets account"
        }
      },
      "typeVersion": 4.6
    },
    {
      "id": "6bc6be15-c10b-4715-8587-7747aeb22360",
      "name": "Email Owner the Draft for Approval",
      "type": "n8n-nodes-base.gmail",
      "onError": "continueErrorOutput",
      "position": [
        1920,
        304
      ],
      "webhookId": "3a4e3cb1-3cc9-4513-9fe8-756071b5a88d",
      "parameters": {
        "sendTo": "={{ $('Workflow Settings').first().json.ownerEmail }}",
        "message": "=New Google review ({{ $('Validate AI Draft Safely').item.json.rating }}/5) from {{ $('Validate AI Draft Safely').item.json.reviewer }}\nSentiment: {{ $('Validate AI Draft Safely').item.json.sentiment }} | Urgency: {{ $('Validate AI Draft Safely').item.json.urgency }}\n\nReview:\n{{ $('Validate AI Draft Safely').item.json.comment }}\n\nSuggested reply:\n{{ $('Validate AI Draft Safely').item.json.reply }}\n\nApprove by copying this reply into Google Business Profile, or edit it first.",
        "options": {
          "appendAttribution": false
        },
        "subject": "={{ $('Validate AI Draft Safely').item.json.urgent ? 'URGENT: ' : '' }}{{ $('Validate AI Draft Safely').item.json.rating }}-star Google review from {{ $('Validate AI Draft Safely').item.json.reviewer }}",
        "emailType": "text"
      },
      "credentials": {
        "gmailOAuth2": {
          "id": "credential-id",
          "name": "Gmail account"
        }
      },
      "typeVersion": 2.1
    },
    {
      "id": "9e767346-eed9-442d-9ab9-e5ad5548f59e",
      "name": "Is Auto-Posting Turned On?",
