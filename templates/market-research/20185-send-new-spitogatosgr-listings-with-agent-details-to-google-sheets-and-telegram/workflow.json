        }
      },
      "typeVersion": 4.7
    },
    {
      "id": "5b170a01-0000-4000-8000-000000000016",
      "name": "Keep matching deals",
      "type": "n8n-nodes-base.filter",
      "position": [
        1240,
        240
      ],
      "parameters": {
        "options": {},
        "conditions": {
          "options": {
            "version": 2,
            "leftValue": "",
            "caseSensitive": true,
            "typeValidation": "loose"
          },
          "combinator": "and",
          "conditions": [
            {
              "id": "5b170a01c-+123456789001",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              },
              "leftValue": "={{ (() => { const s = $('Set your search').first().json; const cap = Number(s.maxPricePerM2) || 0; if (!cap) return true; return $json['EUR per m2'] <= cap || (s.alertOnPriceCuts && $json['Price cut (%)'] !== ''); })() }}",
              "rightValue": ""
            }
          ]
        },
        "looseTypeValidation": true
      },
      "typeVersion": 2.2
    },
    {
      "id": "5b170a01-0000-4000-8000-000000000017",
      "name": "Combine into one message",
      "type": "n8n-nodes-base.aggregate",
      "position": [
        1460,
        240
      ],
      "parameters": {
        "options": {},
        "aggregate": "aggregateAllItemData",
        "destinationFieldName": "items"
      },
      "typeVersion": 1
    },
    {
      "id": "5b170a01-0000-4000-8000-000000000018",
      "name": "Send listings to Telegram",
      "type": "n8n-nodes-base.telegram",
      "position": [
        1660,
        240
      ],
      "webhookId": "5b170a01w-0000-4000-8000-000000000001",
      "parameters": {
        "text": "={{ (() => { const esc = s => String(s ?? '').replaceAll('&', '&amp;').replaceAll('<', '&lt;').replaceAll('>', '&gt;');\nconst homes = $json.items;\nconst lines = homes.slice(0, 20).map(h => {\n  const cut = h['Price cut (%)'] !== '' ? ' \u00b7 \u2193' + h['Price cut (%)'] + '%' : '';\n  return '\ud83c\udfe0 <b><a href=\"' + h.Link + '\">\u20ac' + Number(h['Price (EUR)']).toLocaleString('en-US') + ' \u00b7 ' + h['Area (m2)'] + ' m\u00b2</a></b> (\u20ac'\n    + Number(h['EUR per m2']).toLocaleString('en-US') + '/m\u00b2)' + cut + '\\n'\n    + esc([h.Rooms ? h.Rooms + ' rooms' : '', h.Floor, h.Built ? 'built ' + h.Built : ''].filter(Boolean).join(' \u00b7 ')) + '\\n'\n    + esc(h.Neighbourhood) + '\\n'\n    + esc(h.Agency || h.Contact) + (h.Phone ? ' \u00b7 \u260e ' + esc(h.Phone) : '');\n});\nreturn '<b>' + homes.length + ' new Spitogatos listing' + (homes.length === 1 ? '' : 's') + '</b>\\n\\n' + lines.join('\\n\\n')\n  + (homes.length > 20 ? '\\n\\n+ ' + (homes.length - 20) + ' more in your Google Sheet' : '');\n})() }}",
        "chatId": "={{ $('Set your search').first().json.telegramChatId }}",
        "additionalFields": {
          "parse_mode": "HTML",
          "appendAttribution": false,
          "disable_web_page_preview": true
        }
      },
      "typeVersion": 1.2
    }
  ],
