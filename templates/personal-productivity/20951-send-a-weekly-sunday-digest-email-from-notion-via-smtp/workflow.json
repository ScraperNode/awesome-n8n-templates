    },
    {
      "id": "cont",
      "name": "Get content plan from Notion",
      "type": "n8n-nodes-base.notion",
      "position": [
        2260,
        540
      ],
      "parameters": {
        "simple": false,
        "options": {},
        "resource": "databasePage",
        "operation": "getAll",
        "returnAll": true,
        "databaseId": {
          "__rl": true,
          "mode": "id",
          "value": "={{ $('Set your settings').first().json.CONTENT_DB_ID }}"
        }
      },
      "executeOnce": true,
      "typeVersion": 2.2,
      "alwaysOutputData": true
    },
    {
      "id": "agg",
      "name": "Build Sunday digest text",
      "type": "n8n-nodes-base.code",
      "position": [
        2660,
        540
      ],
      "parameters": {
        "jsCode": "const real = nm => $(nm).all().filter(i => i.json && i.json.id);\nconst title = (i, prop) => (i.json.properties?.[prop]?.title || []).map(t => t.plain_text).join('') || 'item';\nconst cfg = $('Set your settings').first().json;\nconst overdue = real('Get overdue invoices from Notion').map(i => `${title(i,'Name')} (${i.json.properties?.Amount?.number ?? '?'})`);\nconst projects = real('Get active projects from Notion').map(i => title(i,'Name'));\nconst cutoff = Date.now() - Number(cfg.COLD_AFTER_DAYS || 7) * 86400000;\nconst cold = real('Get sales pipeline from Notion').filter(i => {\n  const p = i.json.properties || {};\n  if (!['Contacted','Proposal','Negotiation'].includes(p.Stage?.select?.name)) return false;\n  const t = p['Last touched']?.date?.start;\n  return !t || Date.parse(t) < cutoff;\n}).map(i => title(i,'Deal name'));\nconst content = real('Get content plan from Notion').filter(i => ['Draft','Scheduled'].includes(i.json.properties?.Status?.select?.name)).map(i => title(i,'Title'));\nconst sec = (h, a) => [`${h} (${a.length}):`, ...(a.length ? a.map(x => '  - ' + x) : ['  (none)']), ''];\nconst body = ['SUNDAY PREP DIGEST', '', ...sec('Overdue invoices', overdue), ...sec('Active projects', projects),\n  ...sec('Cold pipeline', cold), ...sec('Content Draft/Scheduled', content),\n  'Open your Sunday Review in Notion: clients, cash, content, focus.'].join('\\n');\nreturn [{ json: { subject: 'Your Sunday prep digest', body } }];"
      },
      "typeVersion": 2
    },
    {
      "id": "email",
      "name": "Send Sunday digest email",
      "type": "n8n-nodes-base.emailSend",
      "position": [
        3060,
        540
      ],
      "parameters": {
        "text": "={{ $json.body }}",
        "options": {
          "appendAttribution": false
        },
        "subject": "={{ $json.subject }}",
        "toEmail": "={{ $('Set your settings').first().json.NOTIFY_EMAIL }}",
        "fromEmail": "={{ $('Set your settings').first().json.NOTIFY_EMAIL }}",
        "emailFormat": "text"
      },
      "typeVersion": 2.1
    }
  ],
