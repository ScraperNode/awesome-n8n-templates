    {
      "id": "5b3e1a2c-0024-4d6e-9f70-8a1b2c3d4e5f",
      "name": "Build the dub",
      "type": "n8n-nodes-base.code",
      "position": [
        4060,
        0
      ],
      "parameters": {
        "jsCode": "const FONT = \"https://fonts.gstatic.com/s/inter/v20/UcCo3FwrK3iLTfvlaQc78lA2.ttf\", FAM = \"UcCo3FwrK3iLTfvlaQc78lA2\";\n\n// One dubbed copy: the original video muted, each translated line said at the time the original was, and\n// the line as a caption. ponytail: a line that runs longer than the original overlaps the next one; Claude is told\n// to keep lines short, so this is rare.\nconst lang = $input.first().json;\nconst src = $('Read the transcript').first().json;\nconst video = $('Your video').first().json;\nconst k = Math.min(1, 1920 / Math.max(src.width, src.height));\nconst even = (n) => Math.round((n * k) / 2) * 2;\nconst w = even(src.width), h = even(src.height);\nconst size = Math.round(Math.min(w, h) * 0.055);\nconst voice = [], captions = [];\nsrc.cues.forEach((c, i) => {\n  const line = lang.lines[i];\n  if (!line) return;\n  voice.push({ asset: { type: 'audio', model: 'elevenlabs-multilingual-v2', prompt: line,\n    options: { voice: video.voice, language: lang.code } }, start: c.start, length: 'auto' });\n  captions.push({ asset: { type: 'rich-text', text: line, font: { family: FAM, size, weight: 800, color: '#FFFFFF' },\n    stroke: { width: Math.max(2, Math.round(size / 12)), color: '#000000', opacity: 1 },\n    align: { horizontal: 'center', vertical: 'middle' } },\n    start: c.start, length: Math.max(0.5, c.end - c.start), width: Math.round(w * 0.9), height: Math.round(h * 0.2),\n    position: 'bottom', offset: { y: 0.06 } });\n});\nconst edit = {\n  timeline: { fonts: [{ src: FONT }], tracks: [\n    { clips: captions },\n    { clips: voice },\n    { clips: [{ asset: { type: 'video', src: src.video, volume: Number(video.originalVolume) }, start: 0, length: src.duration }] },\n  ] },\n  output: { format: 'mp4', size: { width: w, height: h } },\n};\nreturn [{ json: { edit, language: lang.name } }];"
      },
      "typeVersion": 2
    },
