      ],
      "parameters": {
        "url": "=https://sheets.googleapis.com/v4/spreadsheets/{{ $('Set config').first().json.sourceSpreadsheetId }}:batchUpdate",
        "method": "POST",
        "options": {},
        "jsonBody": "={\n  \"requests\": [\n    { \"deleteSheet\": { \"sheetId\": {{ $('Find last month\\'s tab').first().json.sourceSheetId }} } }\n  ]\n}",
        "sendBody": true,
        "specifyBody": "json",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "googleOAuth2Api"
      },
      "typeVersion": 4.2
    },
    {
      "id": "e5eea8fe-41b6-4a42-bc1d-d1795c9ed730",
      "name": "Build the summary",
      "type": "n8n-nodes-base.code",
      "position": [
        7376,
        416
      ],
      "parameters": {
        "jsCode": "const cfg = $('Set config').first().json;\nconst m   = $('Work out last month').first().json;\nconst tab = $('Find last month\\'s tab').first().json;\nconst archiveId = $('Create the archive spreadsheet').first().json.spreadsheetId;\nconst removed = cfg.removeTabAfterArchiving === true || cfg.removeTabAfterArchiving === 'true';\n\nconst url = 'https://docs.google.com/spreadsheets/d/' + archiveId;\n\nconst html = ''\n + '<div style=\"font-family:system-ui,Arial,sans-serif;max-width:620px;color:#18181b;\">'\n + '<h2 style=\"margin:0 0 6px;\">' + m.archiveName + ' archived</h2>'\n + '<p style=\"margin:0 0 16px;color:#52525b;\">Filed into the ' + m.folderName + ' folder on ' + m.ranAt + '.</p>'\n + '<table style=\"border-collapse:collapse;font-size:14px;\">'\n +   '<tr><td style=\"padding:4px 12px 4px 0;color:#71717a;\">Source tab</td><td>' + tab.sourceTitle + '</td></tr>'\n +   '<tr><td style=\"padding:4px 12px 4px 0;color:#71717a;\">Rows</td><td>' + tab.sourceRowCount + '</td></tr>'\n +   '<tr><td style=\"padding:4px 12px 4px 0;color:#71717a;\">Working sheet</td><td>'\n +     (removed ? 'tab removed after archiving' : 'tab left in place') + '</td></tr>'\n + '</table>'\n + '<p style=\"margin:18px 0 0;\"><a href=\"' + url + '\" style=\"background:#18181b;color:#fff;padding:9px 16px;'\n + 'border-radius:6px;text-decoration:none;font-size:14px;\">Open the archive</a></p>'\n + '</div>';\n\nreturn [{ json: { subject: m.archiveName + ' archived', html, url } }];\n"
      },
      "typeVersion": 2
    },
