    {
      "id": "fc457039-1990-4b84-aba5-8f6060d3f42d",
      "name": "Read the link",
      "type": "n8n-nodes-base.set",
      "position": [
        600,
        0
      ],
      "parameters": {
        "options": {},
        "assignments": {
          "assignments": [
            {
              "id": "efdce568-fdc5-4d79-ae94-c20b396405c1",
              "name": "video_id",
              "type": "string",
              "value": "={{ ((String($('Paste a YouTube link').item.json['YouTube link'] || '').match(/(?:youtu\\.be\\/|[?&]v=|\\/shorts\\/|\\/live\\/|\\/embed\\/)([A-Za-z0-9_-]{11})/) || [])[1]) || '' }}"
            },
            {
              "id": "2960cda0-4c69-4483-a8d1-309337cc9184",
              "name": "angle",
              "type": "string",
              "value": "={{ String($('Paste a YouTube link').item.json.Angle || '').trim() }}"
            },
            {
              "id": "99b75534-587b-4ad7-af0a-5b52bb572777",
              "name": "days",
              "type": "number",
              "value": "={{ Number($('Paste a YouTube link').item.json.Days) || 5 }}"
            }
          ]
        }
      },
      "typeVersion": 3.4
    },
    {
      "id": "129a57c7-f690-4ee1-a5af-c86c2fc92db1",
      "name": "Is a YouTube link",
      "type": "n8n-nodes-base.filter",
      "position": [
        900,
        0
      ],
      "parameters": {
        "options": {},
        "conditions": {
          "options": {
            "version": 2,
            "leftValue": "",
            "caseSensitive": true,
            "typeValidation": "loose"
          },
          "combinator": "and",
          "conditions": [
            {
              "id": "463b7b2d-c924-4db4-a039-2da834c5575c",
              "operator": {
                "type": "string",
                "operation": "notEmpty",
                "singleValue": true
              },
              "leftValue": "={{ $json.video_id }}",
              "rightValue": ""
            }
          ]
        }
      },
      "typeVersion": 2.2
    },
    {
      "id": "ed33db6f-11d1-4650-a290-0c6736dc2fdd",
      "name": "Watch the video with Gemini",
      "type": "n8n-nodes-base.httpRequest",
      "position": [
        1200,
        0
      ],
      "parameters": {
        "url": "https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash:generateContent",
        "method": "POST",
        "options": {
          "timeout": 300000,
          "response": {
            "response": {
              "neverError": true
            }
          }
        },
        "jsonBody": "={{ JSON.stringify({ contents: [ { parts: [ { file_data: { file_uri: 'https://www.youtube.com/watch?v=' + $json.video_id } }, { text: 'Watch this video for someone who will write social media posts about it. Return only JSON with these keys. title: the title of the video, or a faithful one. summary: two or three sentences on what the video says. takeaways: an array with exactly ' + $json.days + ' items; each one is a specific point made in the video, in one or two sentences, with the numbers, names and examples that are said in it. quote: one short sentence said in the video, word for word, or an empty string. Use only what is said or shown in the video.' + ($json.angle ? ' Pick the takeaways that best serve this angle: ' + $json.angle : '') } ] } ], generationConfig: { responseMimeType: 'application/json', maxOutputTokens: 2000 } }) }}",
        "sendBody": true,
        "specifyBody": "json",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "googlePalmApi"
      },
      "typeVersion": 4.2
    },
    {
      "id": "aa17d1de-f250-42d4-a38c-ebc59e47b6e9",
      "name": "Build the brief",
      "type": "n8n-nodes-base.set",
      "position": [
        1500,
        0
      ],
      "parameters": {
        "options": {},
        "assignments": {
          "assignments": [
            {
              "id": "863c6769-2568-4f06-ac6f-38547d1a9c4d",
              "name": "notes",
              "type": "object",
              "value": "={{ (() => { const t = ($json.candidates?.[0]?.content?.parts || []).map(p => p.text || '').join(''); const m = t.match(/\\{[\\s\\S]*\\}/); let n = { }; try { n = JSON.parse(m ? m[0] : t); } catch (e) { n = { }; } return { title: String(n.title || ''), summary: String(n.summary || ''), takeaways: (Array.isArray(n.takeaways) ? n.takeaways : []).map(x => String(x).trim()).filter(Boolean), quote: String(n.quote || '') }; })() }}"
            },
            {
              "id": "e6cd4fcf-2d96-4f97-a6cf-d621a2081e2d",
              "name": "problem",
              "type": "string",
              "value": "={{ $json.error ? 'Gemini: ' + ($json.error.message || JSON.stringify($json.error)) : (($json.candidates?.[0]?.content?.parts || []).some(p => p.text) ? '' : 'Gemini returned no text for this video. Check that it is public and not age-restricted.') }}"
            },
            {
              "id": "36204475-b5e3-4166-ab9b-5a720f0c9813",
              "name": "video_url",
              "type": "string",
              "value": "={{ 'https://www.youtube.com/watch?v=' + $('Read the link').item.json.video_id }}"
            }
          ]
        }
      },
      "typeVersion": 3.4
    },
    {
