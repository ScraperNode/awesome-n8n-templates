    {
      "id": "4e61e463-e2f0-4738-8f85-fc30590d041e",
      "name": "Validate Totals - Code",
      "type": "n8n-nodes-base.code",
      "position": [
        2600,
        420
      ],
      "parameters": {
        "jsCode": "const d = $input.first().json;\nconst items = d.line_items || [];\nconst sum = items.reduce((a, li) => a + Number(li.quantity || 0) * Number(li.unit_price || 0), 0);\nconst total = Number(d.total_amount || 0);\nconst mismatch = items.length > 0 && Math.abs(sum - total) > 0.05;\nconst lowConfidence = /uncertain|unclear|illegible/i.test(d.confidence_notes || '');\nreturn [{ json: { ...d,\n  needs_review: mismatch || lowConfidence,\n  review_reason: mismatch ? 'Line items do not add up to the total'\n    : (lowConfidence ? 'Low extraction confidence' : '') } }];"
      },
      "typeVersion": 2
    },
    {
      "id": "df30da75-082b-4678-a981-5d30e6513e80",
