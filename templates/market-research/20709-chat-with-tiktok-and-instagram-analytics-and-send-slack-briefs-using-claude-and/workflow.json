    {
      "id": "040e0b53-f668-462b-914e-0eb1686c994d",
      "name": "Briefing request",
      "type": "n8n-nodes-base.set",
      "position": [
        260,
        200
      ],
      "parameters": {
        "options": {},
        "assignments": {
          "assignments": [
            {
              "id": "a987af10-543e-441b-ad59-5893ee551912",
              "name": "chatInput",
              "type": "string",
              "value": "Weekly briefing: summarise the last 7 days across every connected account. Include the best post on each account with its link, the biggest week-over-week change, any failed or missed posts from the weekly digest, and one concrete suggestion for next week based on the brand brief."
            },
            {
              "id": "40ba9eef-391d-4dc8-9b5c-0da5d0c7ba26",
              "name": "sessionId",
              "type": "string",
              "value": "=weekly-briefing-{{ $now.toFormat('kkkk-WW') }}"
            }
          ]
        }
      },
      "typeVersion": 3.5
    },
    {
      "id": "4480fac6-c763-494c-92d9-658d8fcbfc91",
      "name": "Social media analyst",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "position": [
        720,
        -60
      ],
      "parameters": {
        "options": {
          "systemMessage": "You are a social media analyst for this Postdom workspace. Answer only from Postdom data, using the tools. Never guess.\n- Call \"List connected accounts\" first when you need an account ID. Use providerAccountId as the account ID.\n- Use \"Best posts\" to rank posts, \"Account performance\" for totals and week-over-week change, \"Post performance\" for one post's metrics, and \"Weekly digest\" for what was published or failed.\n- Use \"Brand brief\" when the question is about voice, audience or what to post next.\n- Use the Think tool to compare numbers or plan several tool calls before answering.\n- Metrics can be missing or delayed on some platforms. Say so plainly; never treat a missing value as zero.\n- Quote every number with the period it covers. Keep answers short: a few sentences or a short list.\n- You can only read. If asked to post or change something, explain that it happens in Postdom.\n- For a weekly briefing request, reply in Slack-friendly text: a one-line headline, then up to 5 bullets (best post per account with its link, biggest change, any failed posts, one suggestion for next week)."
        }
      },
      "typeVersion": 3.1
    },
