    {
      "id": "5eb8a630-323b-4609-9985-ab51ce9418f1",
      "name": "Verify LINE Signature",
      "type": "n8n-nodes-base.code",
      "position": [
        220,
        300
      ],
      "parameters": {
        "jsCode": "// Verifies the x-line-signature header (HMAC-SHA256 of the raw body, keyed with your Channel secret).\n// Set CHANNEL_SECRET below, or leave it empty to skip the check while testing.\n// Requires the Webhook option \"Raw Body\" (already enabled in this template).\nconst crypto = require('crypto');\nconst CHANNEL_SECRET = ''; // <-- paste your LINE Channel secret here (Basic settings tab)\n\nconst item = $input.first();\nconst headers = item.json.headers || {};\nconst signature = headers['x-line-signature'] || '';\nlet raw;\ntry {\n  raw = await this.helpers.getBinaryDataBuffer(0, 'data');\n} catch (e) {\n  raw = Buffer.from(JSON.stringify(item.json.body || {}));\n}\nlet valid = true;\nif (CHANNEL_SECRET) {\n  const expected = crypto.createHmac('sha256', CHANNEL_SECRET).update(raw).digest('base64');\n  const a = Buffer.from(expected), b = Buffer.from(signature);\n  valid = a.length === b.length && crypto.timingSafeEqual(a, b);\n}\nconst body = item.json.body && Object.keys(item.json.body).length ? item.json.body : JSON.parse(raw.toString('utf8'));\nreturn [{ json: { valid, events: body.events || [] } }];"
      },
      "typeVersion": 2
    },
