      "parameters": {
        "jsCode": "const src = $('Prepare Text').all();\nreturn $input.all().map((i, k) => { const ai = JSON.parse(i.json.choices[0].message.content); return { json: { customer: src[k]?.json.customer, text: src[k]?.json.text, ...ai, topics: (ai.topics || []).join(', ') } }; });"
      },
      "typeVersion": 2
