          ]
        }
      },
      "typeVersion": 1.2
    },
    {
      "id": "8c16534e-8e47-472d-b38f-3af3fe895814",
      "name": "Get Today's Jobs - Sheets",
      "type": "n8n-nodes-base.googleSheets",
      "position": [
        520,
        420
      ],
      "parameters": {
        "options": {},
        "resource": "sheet",
        "operation": "read",
        "sheetName": {
          "__rl": true,
          "mode": "name",
          "value": "Jobs"
        },
        "documentId": {
          "__rl": true,
          "mode": "id",
          "value": "={{ $('CONFIG - Reviews (Jobs)').first().json.tracker_sheet_id }}"
        }
      },
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "credential-id",
          "name": "YOUR Google Sheets OAuth2"
        }
      },
      "typeVersion": 4.2
