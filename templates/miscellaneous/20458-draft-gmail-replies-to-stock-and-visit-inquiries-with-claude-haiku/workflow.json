    {
      "id": "83b8fdda-6f33-4182-974f-0c4944828e45",
      "name": "Write visit reply",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "position": [
        2044,
        304
      ],
      "parameters": {
        "text": "=Customer's email\nSubject: {{ $(\"Loop over emails\").first().json.subject }}\nBody:\n{{ $(\"Loop over emails\").first().json.text }}\n\nRequest: {{ JSON.stringify($(\"Extract visit request\").first().json.output) }}\n\nOpen times on that day: {{ JSON.stringify(($json.slots || []).filter(s => s.slot_time && s.booked < s.capacity).map(s => s.slot_time)) }}\nAll slots on that day (JSON):\n{{ JSON.stringify($json.slots) }}",
        "messages": {
          "messageValues": [
            {
              "type": "SystemMessagePromptTemplate",
              "message": "=You are a staff member at a furniture store. Write a reply to a customer who wants to visit the store. Use the open times list as the answer for which times are available; do not work it out yourself. If the open times list is empty and there are no slots that day, the store does not take visits that day. If the list is empty but there are slots, that day is fully booked. If slots are open, suggest the open times and ask the customer to reply with their preferred time to confirm. The visit is not booked by this email. If the customer also asks about something else, such as stock or prices, do not answer it; say a staff member will reply about it.\n\nRules:\n- Only write what the results say. Do not promise anything that is not in them, such as delivery, lead times, discounts, or holding items.\n- Never offer to contact the customer later or to tell them when an item comes back in stock or arrives.\n- If the customer asks about something the results do not cover, such as delivery dates, say that a staff member will reply about that point.\n- Plain text only. No Markdown such as ** or #.\n- Write as the store speaking to the customer. Never mention search results, data, systems, SKUs, or product codes.\n- Write in the same language as the customer's email.\n- Address the customer by the name in their signature, if there is one, and start by thanking them for their inquiry.\n- End with this signature: {{ $('Config').first().json.signature }}\n\nOutput only the email body."
            }
          ]
        },
        "promptType": "define"
      },
      "typeVersion": 1.9
    },
