      "parameters": {
        "text": "={{ $('Filter for n8n').item.json.job_title }}\n{{ $('Split Jobs1').item.json.employer_name }}\n{{ $('Split Jobs1').item.json.employer_website }}\n{{ $('Split Jobs1').item.json.job_employment_type }}\n{{ $('Split Jobs1').item.json.job_apply_link }}\n{{ $('Fetch Remote Jobs').item.json.data[0].job_description }}\n{{ $('Fetch Remote Jobs').item.json.data[0].job_posted_at }}\n{{ $('Fetch Remote Jobs').item.json.data[0].job_highlights.Qualifications }}\n{{ $('Fetch Remote Jobs').item.json.data[0].job_highlights.Responsibilities }}\n{{ $('Fetch Remote Jobs').item.json.data[0].job_location }}",
        "options": {
          "systemMessage": "Analyze the job description and extract the following details. Provide the output in a concise, bulleted format.\n\nJob Heading: [Job Title]\nCompany: [Company Name]\nType: [Remote/Hybrid/On-site]\nTech Stack: [Primary tools only]\nn8n/Automation Experience: [Years or specific tools required]\nBenefits: [Salary/Perks/Work culture]\nApply Link: [Insert Link]\n\nNow, take this base resume: {{ $json.base_resume_text }} and rewrite the summary, bullet points, and skills to highlight the exact n8n and AI automation requirements mentioned in the job post. Output only the final tailored resume text.\n\nKeep descriptions under 10 words per point. No fluff."
        },
        "promptType": "define"
      },
      "typeVersion": 3.1
