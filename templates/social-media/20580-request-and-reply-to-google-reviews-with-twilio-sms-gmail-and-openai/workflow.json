      "id": "e9f15963-a5c4-409a-aada-1bd90cb54151",
      "name": "Fetch New Reviews - HTTP",
      "type": "n8n-nodes-base.httpRequest",
      "position": [
        780,
        1000
      ],
      "parameters": {
        "url": "https://mybusiness.googleapis.com/v4/YOUR_REVIEWS_ENDPOINT  (replace with your Google Business Profile reviews endpoint)",
        "method": "GET",
        "options": {
          "timeout": 15000
        },
        "authentication": "none"
      },
      "typeVersion": 4.2
    },
    {
      "id": "c6ff02b9-18f9-4ff9-9919-e57cc61c21a7",
      "name": "Filter New - Code",
      "type": "n8n-nodes-base.code",
      "position": [
        1040,
        1000
      ],
      "parameters": {
        "jsCode": "const data = $input.first().json;\nconst reviews = data.reviews || data.items || [];\nconst lastCheck = new Date($('Get Last Check - Code').first().json.last_check);\nreturn reviews\n  .filter(r => new Date(r.createTime || r.updateTime || 0) > lastCheck)\n  .map(r => ({ json: r }));"
      },
      "typeVersion": 2
    },
    {
