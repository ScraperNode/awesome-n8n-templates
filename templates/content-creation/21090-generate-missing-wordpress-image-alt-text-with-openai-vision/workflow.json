    {
      "id": "cd91fb3f-7a3d-5e5b-a8c2-1cdef82734a8",
      "name": "Get media library images",
      "type": "n8n-nodes-base.httpRequest",
      "position": [
        280,
        540
      ],
      "parameters": {
        "url": "={{ $('Config').first().json.siteUrl }}/wp-json/wp/v2/media",
        "method": "GET",
        "options": {},
        "sendQuery": true,
        "authentication": "genericCredentialType",
        "genericAuthType": "httpBasicAuth",
        "queryParameters": {
          "parameters": [
            {
              "name": "media_type",
              "value": "image"
            },
            {
              "name": "per_page",
              "value": "={{ $('Config').first().json.imagesToScan }}"
            },
            {
              "name": "orderby",
              "value": "date"
            },
            {
              "name": "order",
              "value": "desc"
            },
            {
              "name": "_fields",
              "value": "id,alt_text,mime_type,source_url,title,media_details"
            }
          ]
        }
      },
      "typeVersion": 4.2
    },
    {
      "id": "38ef3912-675d-5c53-9987-bee10fa27171",
      "name": "Select images missing alt text",
      "type": "n8n-nodes-base.code",
      "position": [
        520,
        540
      ],
      "parameters": {
        "jsCode": "const cfg = $('Config').first().json;\nconst allowed = ['image/jpeg', 'image/png', 'image/webp'];\nconst out = [];\nfor (const item of $input.all()) {\n  const m = item.json;\n  if (!m || !m.id) continue;\n  if (m.alt_text && String(m.alt_text).trim() !== '') continue;\n  if (!allowed.includes(m.mime_type)) continue;\n  const sizes = (m.media_details && m.media_details.sizes) || {};\n  const imageUrl =\n    (sizes.large && sizes.large.source_url) ||\n    (sizes.medium_large && sizes.medium_large.source_url) ||\n    m.source_url;\n  if (!imageUrl) continue;\n  const title = m.title && m.title.rendered ? m.title.rendered : '';\n  out.push({ json: { id: m.id, imageUrl, title } });\n  if (out.length >= Number(cfg.maxImagesPerRun)) break;\n}\nreturn out;\n"
      },
      "typeVersion": 2
    },
    {
      "id": "8bfa28f8-3fa7-5705-b4d4-c97d22da9387",
      "name": "Generate alt text with OpenAI",
      "type": "n8n-nodes-base.httpRequest",
      "onError": "continueRegularOutput",
      "maxTries": 2,
      "position": [
        760,
        540
      ],
      "parameters": {
        "url": "https://api.openai.com/v1/chat/completions",
        "method": "POST",
        "options": {
          "timeout": 60000,
          "batching": {
            "batch": {
              "batchSize": 1,
              "batchInterval": 1000
            }
          }
        },
        "jsonBody": "={{ JSON.stringify({ model: $('Config').first().json.openAiModel, response_format: { type: 'json_object' }, max_tokens: 200, messages: [ { role: 'system', content: 'You write concise, factual image alt text for website accessibility and SEO. Reply only with JSON in this shape: {\"alt_text\": \"...\"}.' }, { role: 'user', content: [ { type: 'text', text: 'Write alt text in ' + $('Config').first().json.altTextLanguage + ', at most ' + $('Config').first().json.maxAltLength + ' characters. Describe what is visible. Do not start with Image of or Picture of. Image title for context: ' + $json.title }, { type: 'image_url', image_url: { url: $json.imageUrl } } ] } ] }) }}",
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "openAiApi"
      },
      "retryOnFail": true,
      "typeVersion": 4.2,
      "waitBetweenTries": 2000
    },
    {
      "id": "e6e189bb-26ee-5b8a-88ad-39d7cf4a068b",
      "name": "Validate alt text",
      "type": "n8n-nodes-base.code",
      "position": [
        1000,
        540
      ],
      "parameters": {
        "jsCode": "const cfg = $('Config').first().json;\nconst maxLen = Number(cfg.maxAltLength);\nconst source = $('Select images missing alt text').all();\nreturn $input.all().map((item, i) => {\n  const src = source[i].json;\n  let altText = '';\n  let reason = '';\n  try {\n    const content = item.json.choices[0].message.content;\n    altText = String(JSON.parse(content).alt_text || '').trim();\n  } catch (e) {\n    reason = 'OpenAI response could not be read';\n  }\n  altText = altText.replace(/^(an?\\s+)?(image|picture|photo|photograph)\\s+(of|showing)\\s+/i, '');\n  if (altText) altText = altText.charAt(0).toUpperCase() + altText.slice(1);\n  if (!reason && !altText) reason = 'Empty alt text';\n  if (!reason && altText.length > maxLen) reason = 'Longer than maxAltLength';\n  return {\n    json: {\n      id: src.id,\n      imageUrl: src.imageUrl,\n      altText,\n      status: reason ? 'skipped' : 'ready',\n      reason,\n    },\n  };\n});\n"
      },
      "typeVersion": 2
    },
