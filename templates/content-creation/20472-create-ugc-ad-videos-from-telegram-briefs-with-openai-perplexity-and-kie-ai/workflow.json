  "nodes": [
    {
      "id": "52198e9b-c1fa-4f56-ab2b-102b2f36613e",
      "name": "AI Agent",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "position": [
        2576,
        240
      ],
      "parameters": {
        "text": "=Sana verdi\u011fim video konusu ve istedi\u011fim sahne say\u0131s\u0131: \n\nMarka: {{ $('Form Bilgisi Topla').item.json.data['Markan\u0131z\u0131n ismi nedir?'] }}\n\n\u00dcr\u00fcn hakk\u0131nda bilgi: {{ $('Form Bilgisi Topla').item.json.data['\u00dcr\u00fcnden k\u0131saca bahsediniz.'] }}\n\nReklam konsepti: {{ $('Form Bilgisi Topla').item.json.data['L\u00fctfen video konusunu (prompt) yaz\u0131n\u0131z.'] }}\n\n\u00dcr\u00fcn foto\u011fraf\u0131 hakk\u0131nda bilgi: {{ $('\u00dcr\u00fcn G\u00f6rselini \u0130ncele').item.json['0'].content[0].text }}\n\nVideo uzunlu\u011fu: {{ $('Form Bilgisi Topla').item.json.data['Videonun uzunlu\u011funu se\u00e7iniz.'] }} saniye\n\nToplam sahne say\u0131s\u0131: {{ $('Form Bilgisi Topla').item.json.data['Toplam sahne say\u0131s\u0131n\u0131 se\u00e7iniz.'] }}\n\nVideonun konu\u015fma dili: {{ $('Form Bilgisi Topla').item.json.data['L\u00fctfen konu\u015fma dilini belirtiniz.'] }}\n\n\u00dcr\u00fcn hakk\u0131nda yap\u0131lan ara\u015ft\u0131rma: {{ $json.message }}",
        "options": {
          "systemMessage": "=Senin g\u00f6revin Sora 2 Storyboard \u00f6zelli\u011fini kullanarak UGC video prompt'u yazmak.\n\n\u0130ki tane kavram\u0131 bilmen gerekiyor. Birincisi sahne, ikincisi video. B\u00fct\u00fcn sahneler birle\u015ftirildi\u011finde video elde edilir. Bir videonun uzunlu\u011fu {{ $('Form Bilgisi Topla').item.json.data['Videonun uzunlu\u011funu se\u00e7iniz.'] }} saniyedir.\n\n\u00d6rne\u011fin e\u011fer ben senden 5 tane sahne talep edersem 3, 3, 3, 3, 3, 3 olmak \u00fczere toplamda 15 saniyelik bir video \u00fcretebilirsin. Veya 5, 5, 2, 2, 1 saniyelik yine 15 saniye uzunlu\u011funda ba\u015fka bir video \u00fcretmeyi tercih edebilirsin.\n\nAyn\u0131 zamanda her sahnenin teker teker promptlar\u0131n\u0131 yazmakla y\u00fck\u00fcml\u00fcs\u00fcn. Bu promptlar Text to Video promptlar\u0131 olacak. Prompt dili \u0130ngilizcedir. Fakat videodaki konu\u015fma dili: {{ $('Form Bilgisi Topla').item.json.data['L\u00fctfen konu\u015fma dilini belirtiniz.'] }}\n\nSon olarak birinci sahnenin g\u00f6rselini \u00fcretmek i\u00e7in Text to Image promptu olu\u015fturman gerekiyor. Yani first_scene_img_prompt yazacaks\u0131n, bu sahne prompt'unu yazd\u0131\u011f\u0131n shot 1 text-to-video promptunu baz alacak \u015fekilde yaz \u00e7\u00fcnk\u00fc bu image ile sahne ba\u015flayacak. Bu promptun i\u00e7erisinde insan y\u00fcz\u00fc ge\u00e7medi\u011finden emin olun. UGC i\u00e7erik tarz\u0131nda olsun."
        },
        "promptType": "define",
        "hasOutputParser": true
      },
      "typeVersion": 2.2
    },
