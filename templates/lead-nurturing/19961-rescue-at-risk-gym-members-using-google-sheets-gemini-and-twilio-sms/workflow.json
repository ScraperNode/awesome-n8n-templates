    {
      "id": "15549246-8b6d-418b-9180-d66eec0c0819",
      "name": "Calculate Churn Risk Score",
      "type": "n8n-nodes-base.code",
      "position": [
        -992,
        816
      ],
      "parameters": {
        "jsCode": "// Access all active members from the members node\nconst activeMembers = $('Read Members in Sheets').all().map(i => i.json);\n\n// Access all retrieved attendance records\nconst allVisits = $('Read Attendance in Sheets').all().map(i => i.json);\n\nconst now = DateTime.now();\nconst day30Ago = now.minus({ days: 30 });\nconst day60Ago = now.minus({ days: 60 });\n\nconst results = activeMembers.map(member => {\n  const memberVisits = allVisits.filter(v => String(v.member_id) === String(member.member_id));\n\n  const last30 = memberVisits.filter(v => {\n    const d = DateTime.fromISO(v.visit_date);\n    return d.isValid && d > day30Ago;\n  });\n\n  const prev30 = memberVisits.filter(v => {\n    const d = DateTime.fromISO(v.visit_date);\n    return d.isValid && d <= day30Ago && d > day60Ago;\n  });\n\n  const visitsLast30 = last30.length;\n  const visitsPrev30 = prev30.length;\n\n  let dropPct = 0;\n  if (visitsPrev30 > 0) {\n    dropPct = Math.max(0, Math.round(((visitsPrev30 - visitsLast30) / visitsPrev30) * 100));\n  }\n\n  // Find most recent visit\n  let daysSinceLastVisit = 999;\n  if (memberVisits.length > 0) {\n    const timestamps = memberVisits\n      .map(v => DateTime.fromISO(v.visit_date).toMillis())\n      .filter(t => !isNaN(t));\n\n    if (timestamps.length > 0) {\n      const maxTime = Math.max(...timestamps);\n      daysSinceLastVisit = Math.floor(now.diff(DateTime.fromMillis(maxTime), 'days').days);\n    }\n  }\n\n  // Tenure in days, used to avoid unfairly penalizing brand-new members\n  // who haven't had a chance to build up attendance history yet\n  const joinDate = DateTime.fromISO(member.join_date);\n  const tenureDays = joinDate.isValid ? now.diff(joinDate, 'days').days : 999;\n\n  // Scoring\n  let riskScore = 0;\n  if (daysSinceLastVisit >= 21) riskScore += 40;\n  else if (daysSinceLastVisit >= 14) riskScore += 25;\n  else if (daysSinceLastVisit >= 7) riskScore += 10;\n\n  if (dropPct >= 50) riskScore += 35;\n  else if (dropPct >= 25) riskScore += 20;\n\n  // Flag zero recent visits as long as the member has been around\n  // for more than 30 days (so it also catches long-lapsed members,\n  // not just ones who dropped off after a recent visit)\n  if (visitsLast30 === 0 && tenureDays > 30) riskScore += 25;\n\n  return {\n    json: {\n      ...member,\n      visits_last_30: visitsLast30,\n      visits_prev_30: visitsPrev30,\n      drop_pct: dropPct,\n      days_since_last_visit: daysSinceLastVisit,\n      risk_score: Math.min(riskScore, 100),\n      has_churn_signal: daysSinceLastVisit >= 7 || dropPct >= 25\n    }\n  };\n});\n\nreturn results;"
      },
      "typeVersion": 2
    },
