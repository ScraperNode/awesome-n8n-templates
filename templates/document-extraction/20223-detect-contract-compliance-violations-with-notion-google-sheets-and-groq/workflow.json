    {
      "id": "f4d89e94-c60d-42ce-835a-8a42e39154ca",
      "name": "Analyze Trends & Leakage",
      "type": "n8n-nodes-base.code",
      "position": [
        2880,
        576
      ],
      "parameters": {
        "jsCode": "// 1. Get current violations from the True branch of the IF node\nconst currentTransactions = $(\"Violation Detected Router\").all(0, 0).map(item => item.json);\n\n// 2. Get the historical logs from the Google Sheets node\nconst historyLogs = $input.all().map(item => item.json);\n\nconst results = [];\n\nfor (const txn of currentTransactions) {\n  const vendorHistory = historyLogs.filter(log => log[\"Vendor\"] === txn.vendor);\n  \n  let historicalLeakageSum = 0;\n  let skuViolationCount = 0;\n  \n  for (const pastLog of vendorHistory) {\n     if (pastLog[\"Item SKU\"] === txn.sku) {\n         skuViolationCount++;\n     }\n     \n     // Safely parse the exact leakage stored in the historical log\n     const pastLeakage = parseFloat(pastLog[\"Transaction Leakage\"] || 0);\n     historicalLeakageSum += pastLeakage;\n  }\n  \n  // Calculate total impact (Historical + Current)\n  const total_financial_impact = historicalLeakageSum + (txn.transaction_leakage || 0);\n  \n  txn.trend_analysis = {\n      historical_violations_for_vendor: vendorHistory.length,\n      historical_violations_for_sku: skuViolationCount,\n      historical_leakage_usd: historicalLeakageSum,\n      total_impact_usd: total_financial_impact, // New powerful metric for the AI\n      is_recurring_offender: vendorHistory.length > 0 \n  };\n  \n  results.push({ json: txn });\n}\n\nreturn results;"
      },
      "typeVersion": 2
    },
