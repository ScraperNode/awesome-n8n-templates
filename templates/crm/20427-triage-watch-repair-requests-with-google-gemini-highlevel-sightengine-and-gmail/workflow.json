      "parameters": {
        "schemaType": "manual",
        "inputSchema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"issue_category\": {\n      \"type\": \"string\",\n      \"enum\": [\n        \"battery\",\n        \"movement\",\n        \"crystal_glass\",\n        \"crown_stem\",\n        \"strap_bracelet\",\n        \"water_damage\",\n        \"case_refinish\",\n        \"smartwatch\",\n        \"other\"\n      ]\n    },\n    \"urgency\": {\n      \"type\": \"string\",\n      \"enum\": [\n        \"low\",\n        \"medium\",\n        \"high\"\n      ]\n    },\n    \"service_type\": {\n      \"type\": \"string\"\n    },\n    \"estimate_min\": {\n      \"type\": \"number\"\n    },\n    \"estimate_max\": {\n      \"type\": \"number\"\n    },\n    \"turnaround_days\": {\n      \"type\": \"string\"\n    },\n    \"needs_manual_review\": {\n      \"type\": \"boolean\"\n    },\n    \"manual_review_reason\": {\n      \"type\": \"string\"\n    },\n    \"fraud_flag\": {\n      \"type\": \"boolean\"\n    },\n    \"shop_summary\": {\n      \"type\": \"string\"\n    },\n    \"customer_email_subject\": {\n      \"type\": \"string\"\n    },\n    \"customer_email_body\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"issue_category\",\n    \"urgency\",\n    \"service_type\",\n    \"estimate_min\",\n    \"estimate_max\",\n    \"turnaround_days\",\n    \"needs_manual_review\",\n    \"manual_review_reason\",\n    \"fraud_flag\",\n    \"shop_summary\",\n    \"customer_email_subject\",\n    \"customer_email_body\"\n  ]\n}"
      },
      "typeVersion": 1.3
    },
