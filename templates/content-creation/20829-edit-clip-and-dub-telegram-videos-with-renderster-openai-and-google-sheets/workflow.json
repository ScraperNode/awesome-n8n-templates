    {
      "id": "004145e5-935a-5fdf-9e28-aee764b649d3",
      "name": "Request format",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "position": [
        760,
        240
      ],
      "parameters": {
        "schemaType": "manual",
        "inputSchema": "{\n  \"type\": \"object\",\n  \"required\": [\n    \"action\",\n    \"reply\"\n  ],\n  \"properties\": {\n    \"action\": {\n      \"type\": \"string\",\n      \"enum\": [\n        \"auto_edit\",\n        \"clips\",\n        \"dub\",\n        \"transcript\",\n        \"help\"\n      ]\n    },\n    \"edit_style\": {\n      \"type\": \"string\",\n      \"enum\": [\n        \"best-youtube\",\n        \"hyper\",\n        \"clean\",\n        \"hardcopy\"\n      ]\n    },\n    \"orientation\": {\n      \"type\": \"string\",\n      \"enum\": [\n        \"vertical\",\n        \"horizontal\"\n      ]\n    },\n    \"clip_count\": {\n      \"type\": \"integer\",\n      \"minimum\": 1,\n      \"maximum\": 10\n    },\n    \"dub_language\": {\n      \"type\": \"string\",\n      \"enum\": [\n        \"en\",\n        \"pt\",\n        \"es\",\n        \"fr\",\n        \"de\",\n        \"it\",\n        \"nl\",\n        \"tr\",\n        \"ja\",\n        \"ko\",\n        \"zh\",\n        \"hi\",\n        \"ru\",\n        \"ar\",\n        \"id\",\n        \"pl\"\n      ]\n    },\n    \"reply\": {\n      \"type\": \"string\"\n    }\n  }\n}"
      },
      "typeVersion": 1.3
    },
