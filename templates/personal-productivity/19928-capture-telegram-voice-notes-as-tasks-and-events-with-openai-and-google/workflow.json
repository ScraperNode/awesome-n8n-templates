    {
      "id": "de26379b-d295-4da6-9920-c33acced6493",
      "name": "Pull out tasks and events",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "position": [
        3568,
        272
      ],
      "parameters": {
        "text": "={{ $json.captureText }}",
        "options": {
          "systemMessage": "You turn a rough spoken or typed note into structured tasks and calendar events.\n\nToday is {{ $now.setZone($('Set config').first().json.timezone).toFormat('yyyy-MM-dd') }} and the current time is {{ $now.setZone($('Set config').first().json.timezone).toFormat('HH:mm') }} in {{ $('Set config').first().json.timezone }}.\n\nRules:\n- A task is something to do with no fixed time. An event is something that happens at a specific time.\n- Resolve relative dates yourself. Tomorrow, next Tuesday and in two weeks must all become real dates.\n- If a task has no deadline, leave due_date empty rather than inventing one.\n- If an event has no end time, leave end empty and a default length will be applied later.\n- Set priority to High only when the note says it is urgent or has a hard deadline within two days.\n- Never invent tasks or events that were not mentioned. An empty list is a valid answer.\n- Write the summary as one short sentence describing what was captured."
        },
        "promptType": "define",
        "hasOutputParser": true
      },
      "typeVersion": 2
    },
    {
      "id": "5c809bdc-7b0a-4678-9e2e-7c59d6ddfa13",
      "name": "Chat model",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "position": [
        3568,
        528
      ],
      "parameters": {
        "model": {
          "__rl": true,
          "mode": "list",
          "value": "gpt-4o-mini"
        },
        "options": {}
      },
      "credentials": {
