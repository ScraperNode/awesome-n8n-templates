    {
      "id": "132f54a9-4571-477b-8c49-7c38b1beeec3",
      "name": "Extract Caption & Photos",
      "type": "n8n-nodes-base.code",
      "position": [
        768,
        720
      ],
      "parameters": {
        "jsCode": "const items = $input.all();\n\n// t\u00ecm caption \u0111\u1ea7u ti\u00ean kh\u00e1c null\nconst captionItem = items.find(\n  i => i.json.caption && i.json.caption.trim() !== ''\n);\n\nconst caption = captionItem ? captionItem.json.caption : '';\n\nreturn [\n  {\n    json: {\n      caption,\n      photos: items.map(i => ({\n        file_id: i.json.file_id\n      }))\n    }\n  }\n];\n"
      },
      "typeVersion": 2
    },
    {
      "id": "94399dde-e287-414e-b5c4-2e84d8a135bf",
      "name": "Prepare Loop Items",
      "type": "n8n-nodes-base.code",
      "position": [
