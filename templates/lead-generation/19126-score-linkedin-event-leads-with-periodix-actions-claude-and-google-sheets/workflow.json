    {
      "id": "3c46d2dc-a716-4198-9a22-a60a7251c957",
      "name": "Quick Score with AI",
      "type": "n8n-nodes-base.httpRequest",
      "onError": "continueRegularOutput",
      "position": [
        1200,
        288
      ],
      "parameters": {
        "url": "https://api.anthropic.com/v1/messages",
        "method": "POST",
        "options": {
          "batching": {
            "batch": {
              "batchSize": 1,
              "batchInterval": 1500
            }
          }
        },
        "jsonBody": "={{ JSON.stringify({ model: 'claude-haiku-4-5-20251001', max_tokens: 200, messages: [{ role: 'user', content: 'Read this LinkedIn post and headline. First decide if the post itself expresses the author personal intent to attend this event (for example: I am attending, I will be at, excited to be at, looking forward to, thinking of going) rather than a promotional, sponsor, organizer, or third-party post that just mentions the event name. Second, if they do show personal attendance intent, score them 1 to 10 against our ICP. Headline: ' + $json.headline + '. Company: ' + $json.company + '. Their post: ' + $json.matched_post + '. Our ICP: ' + $(\"Event Config\").first().json.icp_description + '. Our offer: ' + $(\"Event Config\").first().json.offer + '. Rules: if the post does not show the author personal intent to attend, score 2 or lower regardless of ICP fit. Return raw JSON only with keys: score number 1 to 10, reason string max 50 words.' }] }) }}",
        "sendBody": true,
        "sendHeaders": true,
        "specifyBody": "json",
        "authentication": "predefinedCredentialType",
        "headerParameters": {
          "parameters": [
            {
              "name": "anthropic-version",
              "value": "2023-06-01"
            },
            {
              "name": "content-type",
              "value": "application/json"
            }
          ]
        },
        "nodeCredentialType": "anthropicApi"
      },
      "retryOnFail": true,
      "typeVersion": 4.4
    },
    {
      "id": "e04eb627-f66a-4ea4-902e-a40d45fb2813",
      "name": "Parse Score",
      "type": "n8n-nodes-base.code",
      "position": [
        1440,
        288
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const person = $('Process Each Person').item.json;\nlet parsed = { score: 0, reason: 'parse error' };\ntry {\n  let raw = $json.content?.[0]?.text || '{}';\n  raw = raw.trim().replace(/^```(?:json)?\\s*/i, '').replace(/```\\s*$/i, '').trim();\n  parsed = JSON.parse(raw);\n} catch (e) {}\nreturn { json: { ...person, score: parsed.score || 0, reason: parsed.reason || '' } };"
      },
      "typeVersion": 2
    },
    {
      "id": "fdd469be-d827-40d2-b26e-40bb9d3ca3a8",
      "name": "Hot or Cold?",
      "type": "n8n-nodes-base.if",
      "position": [
        1664,
        288
      ],
      "parameters": {
        "options": {},
        "conditions": {
          "options": {
            "version": 1,
            "leftValue": "",
