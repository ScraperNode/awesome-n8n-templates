        "message": "=<div style=\"font-family: Arial, sans-serif; line-height: 1.6; color: #333333; max-width: 600px; padding: 20px; border: 1px solid #e0e0e0; border-radius: 8px;\">\n  \n  <h2 style=\"color: #ff6d5a; margin-top: 0;\">Your QR Code is Ready! \ud83d\udd32</h2>\n  \n  <p>Hi there,</p>\n  \n  <p>Your file for <strong>{{ $('Form: Upload Any File').item.json[\"Project Name\"] }}</strong> has been successfully processed.</p>\n  \n  <p>\ud83d\udcce <strong>Your ready-to-print QR code is attached to this email.</strong> Anyone who scans it with their phone camera will instantly be taken to your file.</p>\n  \n  <hr style=\"border: 0; border-top: 1px solid #e0e0e0; margin: 25px 0;\">\n  \n  <p><strong>Need the direct link?</strong><br>\n  If you want to share the file directly on social media or in a chat without using the QR code, you can use this clickable link:</p>\n  \n  <p><a href=\"{{ $('Create Public File Link').item.json.url }}\" style=\"color: #007bff; text-decoration: none; font-weight: bold;\">{{ $('Create Public File Link').item.json.url }}</a></p>\n\n</div>",
