      ],
      "parameters": {
        "color": 1,
        "width": 220,
        "height": 220,
        "content": "### 10. Notify Owner of Reschedule\nSends you an instant Telegram alert with the client's chat id and message so you can follow up quickly."
      },
      "typeVersion": 1
    }
