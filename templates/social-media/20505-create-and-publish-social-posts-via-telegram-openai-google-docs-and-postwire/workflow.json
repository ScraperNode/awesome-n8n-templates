            {
              "id": "c5504453-8a90-47ea-aa54-14d538366362",
              "name": "chat_id",
              "type": "string",
              "value": "={{ String($('Only text topics').item.json.message.chat.id) }}"
            },
            {
              "id": "2dfe1c9d-c83e-4cf8-abde-63715e89dcd0",
              "name": "message_id",
              "type": "string",
              "value": "={{ String($('Only text topics').item.json.message.message_id) }}"
