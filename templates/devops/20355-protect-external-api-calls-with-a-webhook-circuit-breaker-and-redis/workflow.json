    {
      "id": "d57b0482-2aed-4ba8-af32-3b3967c039b7",
      "name": "JS - Classify Outcome",
      "type": "n8n-nodes-base.code",
      "position": [
        2096,
        768
      ],
      "parameters": {
        "jsCode": "const ctx = $('JS - Evaluate Breaker State').first().json;\nconst res = $input.first().json || {};\n\nconst hasError = !!res.error;\nconst statusCode = Number(res.statusCode ?? 0);\n\n// Failure = network error / timeout, HTTP 5xx or 408. Other 4xx are client errors, not service health issues.\nconst isFailure = hasError || statusCode === 0 || statusCode >= 500 || statusCode === 408;\n\nlet errorMessage = null;\nif (hasError) {\n  errorMessage = typeof res.error === 'string' ? res.error : (res.error.message || JSON.stringify(res.error));\n} else if (isFailure) {\n  errorMessage = `HTTP ${statusCode}`;\n}\n\nreturn [{\n  json: {\n    ...ctx,\n    callSucceeded: !isFailure,\n    upstreamStatus: statusCode,\n    upstreamBody: res.body ?? null,\n    errorMessage,\n    wasProbe: ctx.decision === 'probe'\n  }\n}];"
      },
      "typeVersion": 2
    },
    {
