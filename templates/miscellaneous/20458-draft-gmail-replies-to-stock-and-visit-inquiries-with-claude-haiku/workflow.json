    {
      "id": "1a50a5f2-8699-4e3e-bda8-a1c895bf5afb",
      "name": "Write stock reply",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "position": [
        2044,
        112
      ],
      "parameters": {
        "text": "=Customer's email\nSubject: {{ $(\"Loop over emails\").first().json.subject }}\nBody:\n{{ $(\"Loop over emails\").first().json.text }}\n\nPrices are in {{ $('Config').first().json.currency }}.\n\n{{ ($json.products || []).filter(p => p.sku).length === 0 ? 'There are no matching products. The store does not carry this item.' : 'Matching products (JSON):\\n' + JSON.stringify(($json.products || []).filter(p => p.sku)) }}",
        "messages": {
          "messageValues": [
            {
              "type": "SystemMessagePromptTemplate",
              "message": "=You are a staff member at a furniture store. Write a reply to the customer's email. Base stock, price, and restock information only on the search results. If the results are empty or do not include what the customer asked for, say clearly that the store does not carry it. If stock is 0, say it is out of stock, and mention the note if it has restock information.\n\nRules:\n- Only write what the results say. Do not promise anything that is not in them, such as delivery, lead times, discounts, or holding items.\n- Never offer to contact the customer later or to tell them when an item comes back in stock or arrives.\n- If the customer asks about something the results do not cover, such as delivery dates, say that a staff member will reply about that point.\n- Plain text only. No Markdown such as ** or #.\n- Write as the store speaking to the customer. Never mention search results, data, systems, SKUs, or product codes.\n- Write in the same language as the customer's email.\n- Address the customer by the name in their signature, if there is one, and start by thanking them for their inquiry.\n- End with this signature: {{ $('Config').first().json.signature }}\n\nOutput only the email body."
            }
          ]
        },
        "promptType": "define"
      },
      "typeVersion": 1.9
    },
    {
