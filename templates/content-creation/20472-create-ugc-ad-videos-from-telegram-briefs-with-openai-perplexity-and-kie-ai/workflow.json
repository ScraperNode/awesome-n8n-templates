    {
      "id": "97a3f735-0298-4b14-9b7d-3e76473bce46",
      "name": "\u00dcr\u00fcn\u00fc Ara\u015ft\u0131r",
      "type": "n8n-nodes-base.perplexity",
      "position": [
        2352,
        240
      ],
      "parameters": {
        "options": {},
        "messages": {
          "message": [
            {
              "content": "=Kullan\u0131c\u0131 bir \u00fcr\u00fcn hakk\u0131nda bilgiler (marka ad\u0131, \u00fcr\u00fcn hakk\u0131nda bilgi ve foto\u011fraf) g\u00f6nderdi ve bu \u00fcr\u00fcn\u00fc reklam videosuna d\u00f6n\u00fc\u015ft\u00fcrmek i\u00e7in bize bir konsept ve bilgiler verdi.\n\nMarka: {{ $('Form Bilgisi Topla').item.json.data['Markan\u0131z\u0131n ismi nedir?'] }}\n\n\u00dcr\u00fcn hakk\u0131nda bilgi: {{ $('Form Bilgisi Topla').item.json.data['\u00dcr\u00fcnden k\u0131saca bahsediniz.'] }}\n\nReklam konsepti: {{ $('Form Bilgisi Topla').item.json.data['L\u00fctfen video konusunu (prompt) yaz\u0131n\u0131z.'] }}\n\n\u00dcr\u00fcn foto\u011fraf\u0131 hakk\u0131nda bilgi: {{ $json['0'].content[0].text }}\n\nSenin g\u00f6revin \u00fcr\u00fcn hakk\u0131nda ara\u015ft\u0131rma yapmak ve bu ara\u015ft\u0131rmay\u0131 sunmak. Bu ara\u015ft\u0131rma \u00fcr\u00fcn\u00fcn hedef kitlesini analiz etmeli. B\u00f6ylece reklam senaristimiz senin verdi\u011fin ara\u015ft\u0131rmay\u0131 kullanarak daha kapsaml\u0131 bir reklam senaryosu \u00fcretecektir.\n\nBug\u00fcn\u00fcn tarihi: {{ $now }}"
            }
          ]
        },
        "simplify": true,
        "requestOptions": {}
      },
      "typeVersion": 1
    },
    {
      "id": "c7de550c-8757-4a05-901c-fd1a5a789076",
      "name": "Shots Builder",
      "type": "n8n-nodes-base.code",
      "position": [
        2896,
        240
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Shots Builder \u2014 per item\nconst j = $json || {};\n\n// --- 1) first_scene_img_prompt temizli\u011fi ---\nconst output = j.output ?? {};\nconst rawPrompt = String(output.first_scene_img_prompt ?? '');\n\n// LLM'den gelen prompt'u JSON i\u00e7in g\u00fcvenli ve okunabilir hale getir\nconst safePrompt = rawPrompt\n  .replace(/\"/g, \"'\")          // \u00e7ift t\u0131rnaklar\u0131 tek t\u0131rna\u011fa \u00e7evir\n  .replace(/[\\r\\n\\t]+/g, ' ')  // newline / tab -> bo\u015fluk\n  .replace(/\\s+/g, ' ')        // birden fazla bo\u015fluk -> tek bo\u015fluk\n  .trim();\n\n// --- 2) shots kayna\u011f\u0131n\u0131 bul ---\nconst candidates = [ output.shots, j.shots, j.kiePayload?.input?.shots ]\n  .filter(a => Array.isArray(a) && a.length > 0);\nconst src = candidates[0] || [];\n\n// --- 3) shots normalize et ---\nconst shots = src.map((s, index) => {\n  // Scene metni\n  const rawScene = s.Scene ?? s.scene ?? s.prompt ?? s.description ?? '';\n  const Scene = String(rawScene)\n    .replace(/[\\r\\n\\t]+/g, ' ')\n    .replace(/\\s+/g, ' ')\n    .trim();\n\n  // duration: say\u0131 de\u011filse veya 0'dan k\u00fc\u00e7\u00fckse varsay\u0131lan 3 sn\n  let duration = Number(s.duration ?? s.Duration ?? 3);\n  if (!Number.isFinite(duration) || duration <= 0) {\n    duration = 3;\n  }\n\n  return {\n    index,\n    Scene,\n    duration,\n  };\n});\n\n// --- 4) Sonucu d\u00f6nd\u00fcr ---\nreturn {\n  json: {\n    ...j,\n    output: {\n      ...output,\n      // orijinali koru\n      first_scene_img_prompt: rawPrompt,\n      // temizlenmi\u015f versiyonu ekle\n      first_scene_img_prompt_safe: safePrompt,\n    },\n    // top-level alias\n    first_scene_img_prompt_safe: safePrompt,\n    shots,\n  },\n};\n"
      },
      "typeVersion": 2
    },
