{
  "name": "Answer HR policy questions in Telegram with RAG (Groq, Gemini embeddings, Google Drive)",
  "nodes": [
    {
      "id": "618a5654-614f-45a9-87b6-c2d06414129d",
      "name": "Sticky Note",
      "type": "n8n-nodes-base.stickyNote",
