    {
      "id": "9413c04c-b1f9-4614-a86e-7a14c607c167",
      "name": "Link Formatlama",
      "type": "n8n-nodes-base.code",
      "position": [
        5360,
        240
      ],
      "parameters": {
        "jsCode": "// \u00c7\u0131kt\u0131: { url: \"<mp4 linki>\" }\nreturn items.map(item => {\n  const j = item.json;\n\n  // 1) \"resultJson\" varsa onu al, yoksa di\u011fer olas\u0131 alanlar\u0131 dene\n  let raw = j.resultJson ?? j.result_json ?? j.result ?? j.resultUrls ?? j.resultUrl;\n\n  // 2) String ise JSON.parse; iki kez ka\u00e7\u0131\u015fl\u0131ysa iki kez parse dene\n  let obj = raw;\n  if (typeof obj === 'string') {\n    try { obj = JSON.parse(obj); } catch(e) {}\n    if (typeof obj === 'string') {\n      try { obj = JSON.parse(obj); } catch(e2) {}\n    }\n  }\n\n  // 3) Beklenen schema\n  let url = Array.isArray(obj?.resultUrls) ? obj.resultUrls[0] : undefined;\n  if (!url && typeof obj?.resultUrl === 'string') url = obj.resultUrl;\n\n  // 4) H\u00e2l\u00e2 yoksa regex ile mp4 yakala (soldaki t\u00fcm JSON\u2019dan)\n  if (!url) {\n    const haystack = typeof raw === 'string' ? raw : JSON.stringify(j);\n    const m = haystack.match(/https?:\\/\\/[^\\s\"'\\\\]+?\\.mp4\\b/);\n    url = m ? m[0] : undefined;\n  }\n\n  return { json: { url } };\n});\n"
      },
      "typeVersion": 2
    },
    {
      "id": "72edb104-40c8-4bde-b420-1426ccc56c72",
      "name": "Aspect Ratio",
      "type": "n8n-nodes-base.code",
      "position": [
        1936,
        240
      ],
      "parameters": {
        "jsCode": "// T\u00fcm item'lar\u0131 al\nconst items = $input.all();\n\nfor (const item of items) {\n  // Formdaki orientation alan\u0131n\u0131 yakala\n  // Buradaki key'i kendi formundaki key'le birebir ayn\u0131 yap:\n  const rawOrientation =\n    (item.json['Video yatay m\u0131 yoksa dikey mi olsun?'] || item.json.orientation || '')\n      .toString()\n      .toLowerCase()\n      .trim();\n\n  let aspect;\n\n  if (rawOrientation === 'portrait' || rawOrientation === 'dikey' || rawOrientation === 'vertical') {\n    aspect = '9:16';\n  } else if (rawOrientation === 'landscape' || rawOrientation === 'yatay' || rawOrientation === 'horizontal') {\n    aspect = '16:9';\n  } else {\n    // Ne geldi\u011fini anlamazsa varsay\u0131lan ver (istersen de\u011fi\u015ftir)\n    aspect = '9:16';\n  }\n\n  // Kie'ye g\u00f6nderece\u011fin field\n  item.json.aspect_ratio = aspect;\n}\n\nreturn items;\n"
      },
      "typeVersion": 2
    },
