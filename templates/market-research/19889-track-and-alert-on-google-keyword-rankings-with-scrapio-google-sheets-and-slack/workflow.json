    {
      "id": "e133f8af-be9e-45c1-9531-199601b9cef0",
      "name": "Search Google Rankings",
      "type": "n8n-nodes-scrapio.scrapio",
      "position": [
        1296,
        608
      ],
      "parameters": {
        "query": "={{ $json.keyword }}",
