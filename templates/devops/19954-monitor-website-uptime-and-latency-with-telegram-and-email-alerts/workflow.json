    {
      "id": "cleanup-code-001",
      "name": "Calculate Cutoff Date",
      "type": "n8n-nodes-base.code",
      "position": [
        560,
        1360
      ],
      "parameters": {
        "jsCode": "const retentionDays = $input.first().json.retention_days;\nconst cutoffDate = new Date();\nif (!Number.isInteger(retentionDays) || retentionDays < 1) throw new Error(\"retentionDays must be a positive integer\");\ncutoffDate.setUTCDate(cutoffDate.getUTCDate() - retentionDays);\n\nreturn [{\n  json: {\n    cutoff_date: cutoffDate.toISOString(),\n    retention_days: retentionDays,\n    message: `Cleaning history older than ${retentionDays} days (before ${cutoffDate.toISOString()})`\n  }\n}];"
      },
      "notesInFlow": false,
      "typeVersion": 2
    },
    {
      "id": "cleanup-delete-001",
      "name": "Delete Old History",
      "type": "n8n-nodes-base.dataTable",
