{
  "id": "a1e2b3c4-792c823864e6",
  "meta": {
    "description": "A webhook captures form leads, a Data Table blocks duplicates, and DeepSeek scores each lead from 1 to 100. A three-way switch routes high scores to an approval email, mid scores to a fast-track approval, and low scores to a polite decline.",
    "templateName": "Classify form leads with DeepSeek and route priority-based approvals to Sheets",
    "templateDescription": "A webhook captures form leads, a Data Table blocks duplicates, and DeepSeek scores each lead from 1 to 100. A three-way switch routes high scores to an approval email, mid scores to a fast-track approval, and low scores to a polite decline."
