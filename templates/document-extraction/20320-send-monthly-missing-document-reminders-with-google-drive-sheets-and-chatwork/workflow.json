      "type": "n8n-nodes-chatwork.chatwork",
      "position": [
        4176,
        384
      ],
      "parameters": {
        "roomId": {
          "__rl": true,
          "mode": "id",
          "value": "={{ $json.chatwork_room_id }}"
        },
        "message": "={{\n`${$json.client_name}\u69d8\n\n${$json.target_month}\u5206\u306e\u8cc7\u6599\u306b\u3064\u3044\u3066\u3001\n\u4ee5\u4e0b\u306e\u8cc7\u6599\u304c\u307e\u3060\u78ba\u8a8d\u3067\u304d\u3066\u304a\u308a\u307e\u305b\u3093\u3002\n\n${$json.missing_folders.map(x => `\u30fb${x}`).join('\\n')}\n\n\u304a\u624b\u6570\u3067\u3059\u304c\u3001Google Drive\u306e\u5171\u6709\u30d5\u30a9\u30eb\u30c0\u3078\n\u30a2\u30c3\u30d7\u30ed\u30fc\u30c9\u3092\u304a\u9858\u3044\u3044\u305f\u3057\u307e\u3059\u3002`\n}}",
        "resource": "Room",
        "operation": "sendMessage",
        "requestOptions": {}
      },
      "typeVersion": 1
    },
