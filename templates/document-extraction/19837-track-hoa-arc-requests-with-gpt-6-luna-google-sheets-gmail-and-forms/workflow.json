    {
      "id": "9db4d341-c149-4855-b54d-3d648541e0be",
      "name": "Resolve ARC Decision",
      "type": "n8n-nodes-base.code",
      "position": [
        752,
        688
      ],
      "parameters": {
        "jsCode": "const rows = $input.all().map(function (i) { return i.json; });\nconst req = $('Prepare ARC Decision').first().json;\nconst arc_id = req.arc_id;\nlet route = 'bad';\nif (arc_id && req.decision) {\n  route = 'notfound';\n  for (const r of rows) {\n    if (r && String(r.arc_id || '').trim().toUpperCase() === arc_id) { route = 'ok'; break; }\n  }\n}\nconst status = req.decision === 'approved' ? 'approved' : (req.decision === 'conditions' ? 'conditional' : (req.decision === 'denied' ? 'denied' : ''));\nconst letter_head = req.decision === 'approved'\n  ? 'The Architectural Review Committee has approved your request.'\n  : (req.decision === 'conditions'\n     ? 'The Architectural Review Committee approved your request with conditions.'\n     : 'The Architectural Review Committee has denied your request.');\nlet letter_text = letter_head + String.fromCharCode(10) + String.fromCharCode(10);\nif (req.conditions_note) { letter_text += 'Conditions or notes: ' + req.conditions_note + String.fromCharCode(10) + String.fromCharCode(10); }\nletter_text += 'Decision date: ' + req.decision_date + String.fromCharCode(10) + 'Status: ' + status + String.fromCharCode(10) + 'Reference: ' + arc_id;\nlet owner_email = ''; let owner_name = ''; let mod_type = '';\nfor (const r of rows) {\n  if (r && String(r.arc_id || '').trim().toUpperCase() === arc_id) { owner_email = r.owner_email; owner_name = r.owner_name; mod_type = r.mod_type; }\n}\nreturn [{ json: { route: route, arc_id: arc_id, status: status, decision: req.decision,\n  decision_date: req.decision_date, conditions_note: req.conditions_note, letter_text: letter_text,\n  email: owner_email, owner_name: owner_name, mod_type: mod_type } }];"
      },
      "typeVersion": 2
    },
