    {
      "id": "fe167363-85a1-40c9-ac51-533e49359de2",
      "name": "Calculate Authenticity Score",
      "type": "n8n-nodes-base.code",
      "position": [
        704,
        608
      ],
      "parameters": {
        "jsCode": "const real = $json.probabilities?.real ?? 1;\nconst score = Number((1 - real).toFixed(4));\n\nlet status;\nif (score >= 0.7) {\n  status = 'SUSPICIOUS';\n} else if (score >= 0.3) {\n  status = 'REVIEW';\n} else {\n  status = 'LIKELY_AUTHENTIC';\n}\n\nreturn [{\n  json: {\n    ...$json,\n    ai_generated_score: score,\n    authenticity_status: status\n  }\n}];"
      },
      "typeVersion": 2
    },
