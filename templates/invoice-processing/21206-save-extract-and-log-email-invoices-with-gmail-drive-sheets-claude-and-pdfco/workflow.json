    {
      "id": "34030afc-0d3a-4442-a845-236e5c6a005f",
      "name": "Compute accounting month",
      "type": "n8n-nodes-base.code",
      "position": [
        448,
        400
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const received = new Date(Number($json.internalDate) || $json.date || Date.now());\nconst offset = $json.filePreviousMonth === true ? 1 : 0;\nconst d = new Date(received.getFullYear(), received.getMonth() - offset, 1);\nconst yearName = String(d.getFullYear());\nconst monthName = `${yearName}-${String(d.getMonth() + 1).padStart(2, '0')}`;\n\n// For invoices without a PDF attachment: pick the most likely invoice link in the email body\n// (works for Paddle, Stripe, Lemon Squeezy, Shopify, etc.)\nconst html = $json.html || $json.textAsHtml || '';\nconst candidates = [];\nfor (const [, rawHref, inner] of html.matchAll(/<a\\b[^>]*href=[\"']([^\"']+)[\"'][^>]*>([\\s\\S]*?)<\\/a>/gi)) {\n  const href = rawHref.replace(/&amp;/g, '&').trim();\n  if (!/^https?:\\/\\//i.test(href)) continue;\n  const text = inner.replace(/<[^>]+>/g, ' ').replace(/\\s+/g, ' ').trim();\n  const haystack = `${text} ${href}`;\n  if (!/invoice|receipt|factur|bill/i.test(haystack)) continue;\n  if (/unsubscribe|preferences|privacy|terms|support|help|log ?in|sign ?in/i.test(text)) continue;\n  let score = 0;\n  if (/invoice|receipt|factur/i.test(text)) score += 3;\n  if (/download|pdf/i.test(text)) score += 2;\n  if (/\\.pdf(\\?|$)|\\/pdf\\b/i.test(href)) score += 2;\n  if (/view|open|see/i.test(text)) score += 1;\n  candidates.push({ href, score });\n}\ncandidates.sort((a, b) => b.score - a.score);\nconst invoiceUrl = candidates[0]?.href ?? null;\n\nconst senderName = $json.from?.value?.[0]?.name || $json.from?.value?.[0]?.address || 'invoice';\n\nreturn {\n  json: {\n    messageId: $json.id,\n    receivedAt: received.toISOString(),\n    rootFolderId: $json.invoicesFolderId,\n    renderLinkDomains: $json.renderLinkDomains || '',\n    yearName,\n    monthName,\n    invoiceUrl,\n    senderName,\n  },\n  binary: $input.item.binary,\n};"
      },
      "typeVersion": 2
    },
