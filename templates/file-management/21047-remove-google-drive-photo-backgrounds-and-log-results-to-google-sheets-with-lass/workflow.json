    {
      "id": "27ca7ce2-77e3-54e9-bd5f-3ff74cccfd87",
      "name": "Build run summary",
      "type": "n8n-nodes-base.code",
      "position": [
        1240,
        720
      ],
      "parameters": {
        "jsCode": "// One log row per photo comes back from the loop\nconst rows = $input.all().map(item => item.json);\nconst processed = rows.filter(r => r.Status === 'processed');\nconst failed = rows.filter(r => r.Status === 'failed');\nconst creditsUsed = rows.reduce((sum, r) => sum + (Number(r['Credits charged']) || 0), 0);\nconst outOfCredits = failed.some(r => /credit/i.test(r.Error || ''));\n\nconst lines = [\n  `LassoCut run: ${processed.length} photo(s) cut out, ${failed.length} failed, ${creditsUsed} credit(s) used.`,\n  ...failed.map(r => `- ${r['File name']} failed at ${r.Error}`),\n];\nif (outOfCredits) {\n  lines.push('Out of credits: buy a pack at https://www.lassocut.com/pricing/ (credits never expire), then move the files from the failed folder back to the input folder.');\n}\n\nreturn [{\n  json: {\n    processed: processed.length,\n    failed: failed.length,\n    credits_used: creditsUsed,\n    out_of_credits: outOfCredits,\n    failures: failed,\n    message: lines.join('\\n'),\n  },\n}];"
      },
      "typeVersion": 2
    }
  ],
