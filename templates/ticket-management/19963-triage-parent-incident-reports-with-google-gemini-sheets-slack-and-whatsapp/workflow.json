    {
      "id": "18fa186d-47e4-4b48-97cc-9ffb8e245bf3",
      "name": "Prepare Attachment Data",
      "type": "n8n-nodes-base.code",
      "position": [
        2048,
        272
      ],
      "parameters": {
        "jsCode": "// Reference upstream nodes to preserve original form inputs & binary data\nconst ticketData = $('Set Ticket Details').first().json;\nconst studentData = $input.item.json;\n\n// Retrieve the binary object from the initial Form Trigger\nconst triggerBinary = $('When Form Submitted').first().binary || {};\nconst uploaded = triggerBinary['Attachment'];\n\nconst allowedMimeTypes = ['image/jpeg', 'image/png', 'image/jpg'];\nlet hasValidAttachment = false;\nlet attachmentMime = '';\nlet attachmentRejectedReason = '';\n\nif (uploaded) {\n  attachmentMime = uploaded.mimeType || '';\n  if (allowedMimeTypes.includes(attachmentMime.toLowerCase())) {\n    hasValidAttachment = true;\n  } else {\n    attachmentRejectedReason = `Uploaded file type \"${attachmentMime || 'unknown'}\" is not supported - only JPG/PNG images are accepted. File was not analyzed or forwarded.`;\n  }\n}\n\nconst outputBinary = {};\n\nif (hasValidAttachment) {\n  outputBinary.VisionInput = uploaded;\n  outputBinary.Attachment = uploaded;\n} else {\n  // 1x1 transparent PNG fallback for multimodal Gemini LLM Chain\n  const blankPngBase64 = 'iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAQAAAC1HAwCAAAAC0lEQVR42mNk+A8AAQUBAScY42YAAAAASUVORK5CYII=';\n  const buffer = Buffer.from(blankPngBase64, 'base64');\n  outputBinary.VisionInput = await this.helpers.prepareBinaryData(buffer, 'blank.png', 'image/png');\n}\n\nreturn {\n  json: {\n    ...ticketData,\n    ...studentData,\n    has_attachment: hasValidAttachment,\n    attachment_mime: attachmentMime,\n    attachment_rejected_reason: attachmentRejectedReason\n  },\n  binary: outputBinary\n};"
      },
      "typeVersion": 2
    },
