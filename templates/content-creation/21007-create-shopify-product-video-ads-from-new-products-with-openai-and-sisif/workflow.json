        "jsCode": "// Read the staged target Shopify returned and pass the downloaded MP4 through.\n// The next node posts Shopify's parameters in order, then the file last.\nconst res = $('Create Staged Upload').item.json;\nconst target = res.data?.stagedUploadsCreate?.stagedTargets?.[0];\nconst userErrors = res.data?.stagedUploadsCreate?.userErrors || [];\nif (!target || userErrors.length) {\n  return [{ json: { upload_ready: false, error: JSON.stringify(userErrors.length ? userErrors : (res.errors || res.error || res)) } }];\n}\nif (target.parameters.length > 12) {\n  return [{ json: { upload_ready: false, error: `Shopify returned ${target.parameters.length} upload parameters; add slots to Upload to Staged Target` } }];\n}\nreturn [{\n  json: { upload_ready: true, upload_url: target.url, resource_url: target.resourceUrl, params: target.parameters },\n  binary: $input.first().binary,\n}];"
      },
