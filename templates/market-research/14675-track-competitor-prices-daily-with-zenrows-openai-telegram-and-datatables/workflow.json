    {
      "id": "63c4ea30-572a-4825-83e5-c0c85a4e213c",
      "name": "Compare prices",
      "type": "n8n-nodes-base.code",
      "position": [
        1776,
        656
      ],
      "parameters": {
        "jsCode": "const newPrice = parseFloat($('Extract data').item.json.price);\nconst oldPrice = parseFloat($('Set Data in Loop').item.json.Actual_Price);\nconst productName = $('Set Data in Loop').item.json.Product_Name;\nconst productURL = $('Set Data in Loop').item.json.Product_URL;\n\nconst priceChanged = !isNaN(newPrice) && !isNaN(oldPrice) && newPrice !== oldPrice;\n\nlet history = [];\ntry {\n  history = JSON.parse($('Set Data in Loop').item.json.Price_History || '[]');\n} catch { history = []; }\n\nif (!isNaN(newPrice)) {\n  history.push({\n    date: new Date().toISOString().split('T')[0],\n    price: newPrice\n  });\n}\n\nreturn [{\n  json: {\n    price_changed_C: priceChanged,\n    new_actual_price: isNaN(newPrice) ? (isNaN(oldPrice) ? null : oldPrice) : newPrice,\n    updated_price_history: JSON.stringify(history),\n    error_extract: isNaN(newPrice) ? 'Price not found' : null,\n    price_status: isNaN(newPrice) ? 'error' : (priceChanged ? (newPrice > oldPrice ? 'increase' : 'decrease') : 'stable'),\n    Product_Name: productName,\n    Product_URL: productURL,\n    old_price: isNaN(oldPrice) ? null : oldPrice,\n    new_price: isNaN(newPrice) ? null : newPrice\n  }\n}];"
      },
      "typeVersion": 2
    },
    {
      "id": "6c0d4b24-dd23-4b59-b92e-fd68c4a12a29",
      "name": "Extract data",
      "type": "n8n-nodes-base.code",
      "position": [
        1568,
        656
      ],
      "parameters": {
        "jsCode": "const inputData = $input.first().json?.data ?? null;\n\nfunction safeJsonParse(value) {\n  if (typeof value === 'string') {\n    try {\n      return JSON.parse(value);\n    } catch {\n      return null;\n    }\n  }\n  return value;\n}\n\nfunction findProductData(input) {\n  if (!input) return null;\n  if (Array.isArray(input)) {\n    for (const item of input) {\n      const found = findProductData(item);\n      if (found) return found;\n    }\n    return null;\n  }\n  if (typeof input === 'object') {\n    const type = input['@type'];\n    if (type === 'Product' || type === 'ProductGroup') {\n      return input;\n    }\n    for (const key of Object.keys(input)) {\n      const found = findProductData(input[key]);\n      if (found) return found;\n    }\n  }\n  return null;\n}\n\nfunction extractPrice(product) {\n  if (!product) return null;\n  if (product.offers) {\n    const offers = Array.isArray(product.offers) ? product.offers[0] : product.offers;\n    if (offers?.price != null) return offers.price;\n    if (offers?.lowPrice != null) return offers.lowPrice;\n    if (offers?.highPrice != null) return offers.highPrice;\n  }\n  if (product.price != null) return product.price;\n  if (product.lowPrice != null) return product.lowPrice;\n  return null;\n}\n\nconst parsed = safeJsonParse(inputData);\nconst product = parsed ? findProductData(parsed) : null;\nconst price = product ? extractPrice(product) : null;\n\nreturn [{ json: { price } }];"
      },
      "typeVersion": 2
    },
