    {
      "id": "ff5f1c03-2a2c-4f6e-a444-25ae96a3f210",
      "name": "Select Client Folders",
      "type": "n8n-nodes-base.code",
      "position": [
        2992,
        400
      ],
      "parameters": {
        "jsCode": "const client = $('Batch Process Clients').item.json;\n\nconst requiredFolders = client.required_folders\n  .split(',')\n  .map(name => name.trim());\n\nreturn items\n  .filter(item => requiredFolders.includes(item.json.name))\n  .map(item => ({\n    json: {\n      id: item.json.id,\n      name: item.json.name,\n\n      // \u9867\u5ba2\u60c5\u5831\u3092\u3053\u3053\u3067\u4ed8\u4e0e\n      client_name: client.client_name,\n      chatwork_room_id: client.chatwork_room_id\n    }\n  }));"
      },
      "typeVersion": 2
    },
    {
      "id": "973b6e2d-9e6f-4d2c-8d47-576a2cd4c540",
      "name": "Compute Last Month",
      "type": "n8n-nodes-base.code",
      "position": [
        1296,
        400
      ],
      "parameters": {
        "jsCode": "const now = new Date();\n\n// \u524d\u6708\nconst target = new Date(now.getFullYear(), now.getMonth() - 1, 1);\n\nconst year = target.getFullYear();\nconst month = target.getMonth() + 1;\n\n// \u897f\u66a6\u2192\u4ee4\u548c\nconst reiwaYear = year - 2018;\n\nreturn [\n  {\n    json: {\n      target_year: year,\n      target_month_number: month,\n      reiwa_year: reiwaYear,\n      target_month_prefix: `R${reiwaYear}.${month}\u6708`\n    }\n  }\n];"
      },
      "typeVersion": 2
    },
    {
      "id": "a87b855d-73c1-4b5f-ac47-dbd70556f917",
      "name": "Batch Process Clients",
      "type": "n8n-nodes-base.splitInBatches",
      "position": [
        2320,
        384
      ],
      "parameters": {
        "options": {}
      },
      "typeVersion": 3
    },
    {
      "id": "b4ae520e-2f22-41c8-9d4c-041982a6d4de",
      "name": "Monthly Schedule Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "position": [
        1040,
        400
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "months",
              "triggerAtHour": 12,
              "triggerAtDayOfMonth": 10
            }
          ]
        }
      },
      "typeVersion": 1.4
    },
