        "jsonBody": "={{ (() => { const p = $('Read the plan').item.json; const c = p.captions; const media = $json.media.slice().sort((a, b) => a.n - b.n).map(m => ({ url: m.url, type: 'image', alt: m.alt })); return JSON.stringify({ platforms: p.networks, text: c.instagram, media, per_platform: Object.fromEntries(p.networks.map(n => [n, { text: c[n] || c.instagram }])), idempotency_key: ('carousel-' + $('Carousel brief').item.json.submittedAt + '-' + p.topic).slice(0, 200) }); })() }}",
