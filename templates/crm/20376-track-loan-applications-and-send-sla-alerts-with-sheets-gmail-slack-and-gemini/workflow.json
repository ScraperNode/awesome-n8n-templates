      "name": "Applicant Status Emails",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "position": [
        1856,
        800
      ],
      "parameters": {
        "text": "=You are a professional loan officer assistant at a bank. Write a warm, empathetic, and professional status update email to {{ $json.applicant_name }} regarding their {{ $json.loan_type }} loan application {{ $json.application_id }} for {{ $json.loan_amount }}.\n\nThe application status has changed to: {{ $json.current_status }}\n\nTone guidelines by status:\n- submitted: Welcoming and reassuring. Confirm receipt and set expectations.\n- docs_verified: Positive and encouraging. Confirm all documents are in order.\n- under_review: Patient and transparent. Let them know a loan officer is actively reviewing.\n- approved: Celebratory and clear. Congratulate them and mention next steps.\n- declined: Empathetic and constructive. Be respectful, briefly mention they can contact us to discuss alternatives.\n\nKeep the email under 150 words. Return only the email body text, no subject line.",
        "batching": {},
        "promptType": "define"
      },
      "typeVersion": 1.9
    },
