      ],
      "parameters": {
        "resource": "tool",
        "toolName": "messaging_list_recent_messages",
        "operation": "call",
        "toolArguments": "={{ JSON.stringify({ provider: 'whatsapp', after: $now.minus({ hours: $json.lookback_hours }).toUTC().toISO(), chat_type: 'all', max_chats: 25 }) }}"
