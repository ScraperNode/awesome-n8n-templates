    {
      "id": "df5b86ad-8f75-4296-b38d-7cffb193f9cb",
      "name": "Prepare Homework Rows",
      "type": "n8n-nodes-base.code",
      "position": [
        3680,
        288
      ],
      "parameters": {
        "jsCode": "// One tracker row per homework task\nconst r = $('Build Recap & Homework Rows').first().json;\nconst c = $('Match Client to Meeting').first().json;\nreturn r.homework.map(h => ({\n  json: {\n    'Task ID': h.taskId,\n    'Client ID': c.clientId,\n    'Client Name': c.clientName,\n    'Client Email': c.clientEmail,\n    'Session Date': r.sessionDate,\n    'Task': h.task,\n    'Why': h.why,\n    'Due Date': h.dueDate,\n    'Status': 'Not started',\n    'Nudge Count': 0,\n    'Last Nudge Date': '',\n  },\n}));"
      },
      "typeVersion": 2
    },
