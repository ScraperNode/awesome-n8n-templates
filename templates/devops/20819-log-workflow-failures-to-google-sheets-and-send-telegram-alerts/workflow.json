    {
      "id": "ba5334cc-7b51-4d22-b8b7-71cea7d374ac",
      "name": "Create Failure Alert Message",
      "type": "n8n-nodes-base.code",
      "position": [
        720,
        0
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Escape text so Telegram's HTML parse mode shows it literally\nconst h = (v) => String(v ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\n\n// The error record built just before the sheet write\nconst E = $('Prepare Error Record').item.json;\n\n// Alert lines, top to bottom\nconst text = [\n  '\u274c <b>RLE</b> \u00b7 Workflow-level failure at ' + h(E.error_node || E.stage),\n  h(E.summary),\n  'Error: ' + h(E.error_message),\n  'Next: open the execution and fix ' + h(E.error_node || 'the failing node') + '; if the lead never reached its card, delete its Data Table row and re-POST it.',\n  '#rle \u00b7 run <code>' + h(E.correlation_id) + '</code> \u00b7 ' + h(E.execution_url),\n].join('\\n');\n\nreturn { json: { ...$json, text } };"
      },
      "typeVersion": 2
    },
