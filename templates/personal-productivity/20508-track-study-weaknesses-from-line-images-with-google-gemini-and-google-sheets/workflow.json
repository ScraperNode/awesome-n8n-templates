    {
      "id": "a71f160a-2edd-441f-bc21-0f162cc1b89c",
      "name": "Study Result Analysis Agent",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "maxTries": 5,
      "position": [
        -6048,
        -1120
      ],
      "parameters": {
        "text": "You are an AI study support assistant.\n\nAnalyze the attached worksheet or test result image and extract the following information based only on what can be clearly identified from the image.\n\nFields to extract:\n- Subject\n- Topic\n- Score\n- Weak Points\n- Review Advice\n\nLanguage Rules:\n- Keep all field labels exactly in English.\n- Write all field values in Japanese.\n- Preserve subject names, topics, and problem content in the language shown in the image when appropriate.\n- Do not translate text unnecessarily.\n- Do not guess information that cannot be clearly identified from the image.\n\nRules:\n- If the subject cannot be identified, write \"Unknown\".\n- If the topic cannot be identified, write \"Unknown\".\n- If the score cannot be identified, write \"Unreadable\".\n- Identify weak points only when supported by the image.\n- If no clear weak point can be identified, write \"Not identified\".\n- Keep the review advice short and practical.\n- Do not include unnecessary explanations.\n- Always output exactly the following five lines.\n\nOutput format:\nSubject:\nTopic:\nScore:\nWeak Points:\nReview Advice:",
        "options": {},
        "promptType": "define"
      },
      "executeOnce": false,
      "retryOnFail": true,
      "typeVersion": 3.1,
      "waitBetweenTries": 3000
    },
