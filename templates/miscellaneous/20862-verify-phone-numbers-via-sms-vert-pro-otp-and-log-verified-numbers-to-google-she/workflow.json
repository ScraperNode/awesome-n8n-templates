    {
      "id": "435ce5b4-6fc7-48d0-946f-7b393a4daa4f",
      "name": "Read request",
      "type": "n8n-nodes-base.code",
      "position": [
        460,
        0
      ],
      "parameters": {
        "jsCode": "// Reads the request: phone number (any format) and, to check a code, the 6-digit code\nconst s = $input.first().json;\nconst body = s.body || {};\nconst action = $('Check a code').isExecuted ? 'verify' : 'send';\n\nlet phone = String(body.phone || '').replace(/[^0-9+]/g, '');\nif (phone.startsWith('+')) phone = phone.slice(1);\nelse if (phone.startsWith('00')) phone = phone.slice(2);\nelse if (phone.startsWith('0')) phone = String(s.default_country_code) + phone.slice(1);\n\n// Only the countries you serve: protects your credits against SMS pumping on premium numbers\nconst allowed = String(s.allowed_country_codes || '').split(',').map(c => c.trim()).filter(Boolean);\nconst phoneOk = /^[0-9]{10,15}$/.test(phone) && (allowed.length === 0 || allowed.some(c => phone.startsWith(c)));\n\nconst code = String(body.code || '').replace(/\\D/g, '');\nconst codeOk = action === 'send' || /^[0-9]{6}$/.test(code);\n\nreturn [{ json: {\n  action,\n  phone,\n  code,\n  valid: phoneOk && codeOk,\n  error: !phoneOk ? 'INVALID_PHONE' : (!codeOk ? 'INVALID_CODE' : ''),\n} }];"
      },
      "typeVersion": 2
    },
