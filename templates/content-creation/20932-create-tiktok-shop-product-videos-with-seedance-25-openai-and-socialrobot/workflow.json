    {
      "id": "c3339c9a-bd08-435f-84b8-3351625bcb3a",
      "name": "Describe Failure",
      "type": "n8n-nodes-base.code",
      "position": [
        3200,
        928
      ],
      "parameters": {
        "jsCode": "// One readable reason for whatever went wrong. Add an error workflow in the settings to get alerts.\nconst j = $json;\nconst s = $('Set Video Settings').first().json;\nlet message;\nif ($('Cancel Timed Out Job').isExecuted) {\n  message = `Seedance job ${j.id} took longer than ${s.timeout_minutes} minutes and was canceled.`;\n} else if (j.status && j.urls) {\n  message = `Seedance job ${j.id} ${j.status}: ${j.error || 'no reason given'}`;\n} else if (j.error) {\n  const e = typeof j.error === 'string' ? j.error : (j.error.message || JSON.stringify(j.error));\n  message = `SocialRobot could not save the TikTok draft: ${e}`;\n} else if (Array.isArray(j.problems) && j.problems.length) {\n  message = `The video did not pass the checks: ${j.problems.join(' ')}`;\n} else {\n  message = `Unexpected failure: ${JSON.stringify(j).slice(0, 500)}`;\n}\nreturn [{ json: { message, product: $('Product Video Form').first().json['Product Name'] } }];"
      },
      "typeVersion": 2
    },
