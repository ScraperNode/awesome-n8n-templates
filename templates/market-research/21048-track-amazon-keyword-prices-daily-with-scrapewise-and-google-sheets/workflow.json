            {
              "id": "c1",
              "operator": {
                "type": "string",
                "operation": "notEquals"
              },
              "leftValue": "={{ $json.structuredContent ? $json.structuredContent.status : JSON.parse($json.content[0].text).status }}",
              "rightValue": "RUNNING"
            }
          ]
        },
        "looseTypeValidation": true
      },
      "typeVersion": 2.3
    },
