    {
      "id": "fd100e16-1586-486a-8f70-755fc0548258",
      "name": "Count the day",
      "type": "n8n-nodes-base.code",
      "position": [
        1540,
        760
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Counts today's rows. Nothing is estimated: every number comes from the data table.\nconst settings = $('Your settings').first().json;\nconst windowMs = Number(settings.reminderMinutes || 30) * 60000;\nconst time = (v) => (v ? new Date(v).getTime() : NaN);\n// An empty table gives one empty item; keep only real rows.\nconst rows = $input.all().map((i) => i.json).filter((r) => r && r.id);\nconst answered = rows.filter((r) => r.answered_at);\nconst inTime = answered.filter((r) => time(r.answered_at) - time(r.received_at) <= windowMs).length;\nconst reminded = rows.filter((r) => r.reminded_at).length;\nconst open = rows.length - answered.length;\nconst day = $now.setZone(settings.timezone || 'UTC').toFormat('d LLL yyyy');\nconst text = [\n  'Leads received: ' + rows.length,\n  'Marked as answered within ' + settings.reminderMinutes + ' minutes: ' + inTime,\n  'Still open (not marked as answered): ' + open,\n  'Reminders sent: ' + reminded,\n  '',\n  'A lead counts as answered only when someone opened its \"answered\" link.'\n].join('\\n');\nreturn [{ json: { subject: 'Leads on ' + day + ': ' + rows.length + ' received, ' + open + ' still open', text } }];",
        "language": "javaScript"
      },
      "typeVersion": 2
    },
