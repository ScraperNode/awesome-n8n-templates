    {
      "id": "46ca34f8-0ea7-427f-a370-59213676465f",
      "name": "Sticky Note - Section 1",
      "type": "n8n-nodes-base.stickyNote",
      "position": [
        1200,
        208
      ],
      "parameters": {
        "color": 7,
        "width": 908,
        "height": 644,
        "content": "## 1. Receive and check the sender\nThe bot takes any message. One config node holds your Telegram ID, sheet, calendar and timezone. Anyone not on the allow list gets a polite refusal and nothing else runs."
      },
      "typeVersion": 1
    },
    {
      "id": "67e186c0-bd34-47e1-896a-22fa2244e251",
      "name": "Sticky Note - Section 2",
      "type": "n8n-nodes-base.stickyNote",
      "position": [
        2192,
        0
      ],
      "parameters": {
        "color": 7,
        "width": 1208,
        "height": 620,
        "content": "## 2. Get the words\nA voice note is downloaded and transcribed with Whisper. A typed message skips that step. Both paths end up with the same captureText field."
      },
      "typeVersion": 1
    },
    {
      "id": "91bd3ff1-5c68-4886-a85b-2518fb715d80",
      "name": "Sticky Note - Section 3",
      "type": "n8n-nodes-base.stickyNote",
      "position": [
        3440,
        128
      ],
      "parameters": {
        "color": 7,
        "width": 688,
        "height": 604,
        "content": "## 3. Work out what you meant\nThe agent knows today's date, so tomorrow and next Tuesday become real dates. It returns tasks and events separately, and a Code node fills in missing end times."
      },
      "typeVersion": 1
    },
    {
      "id": "2736b620-4e7c-496d-92e8-fca018feb778",
      "name": "Sticky Note - Section 4",
      "type": "n8n-nodes-base.stickyNote",
      "position": [
        4176,
        0
      ],
      "parameters": {
        "color": 7,
        "width": 1188,
        "height": 460,
        "content": "## 4. Save the tasks\nEach task becomes its own row with its due date, priority and where it came from. A note with no tasks skips straight past."
      },
      "typeVersion": 1
    },
    {
      "id": "3a8341de-3909-4f4f-830c-cc36928158a9",
      "name": "Sticky Note - Section 5",
      "type": "n8n-nodes-base.stickyNote",
      "position": [
        5424,
        0
      ],
      "parameters": {
        "color": 7,
        "width": 1188,
