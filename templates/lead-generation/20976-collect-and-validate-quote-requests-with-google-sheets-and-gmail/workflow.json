    {
      "id": "5d8afd9b-a609-4dac-b1c9-79471e31ba13",
      "name": "Check what is missing",
      "type": "n8n-nodes-base.code",
      "position": [
        680,
        300
      ],
      "parameters": {
        "jsCode": "// Business settings live in the \"Settings\" node. This node only reads them.\n// The form answers are read from the trigger, because \"Settings\" only outputs the settings.\nconst s = $('Settings').first().json;\nconst f = $('Quote request form').first().json;\n\nconst clean = v => (v === undefined || v === null) ? '' : String(v).trim();\nconst req = {\n  name: clean(f['Your name']),\n  email: clean(f['Email']).toLowerCase(),\n  phone: clean(f['Phone']),\n  service: clean(f['Service needed']),\n  address: clean(f['Job address']),\n  preferred_date: clean(f['Preferred date']),\n  details: clean(f['Job details (size, rooms, items...)']),\n};\n\n// Which fields are needed before you can quote. Edit the list in \"Settings\".\nconst labels = {\n  phone: 'a phone number',\n  service: 'the service you need',\n  address: 'the job address',\n  preferred_date: 'a preferred date',\n  details: 'details about the job (size, rooms, items...)',\n};\nconst required = String(s.required_fields || '').split(',').map(x => x.trim()).filter(Boolean);\nconst missing = required.filter(k => !req[k]);\n\n// Same person + same service + same address on the same day = same request.\n// This blocks double submits (refresh, double click) from creating two rows.\nconst day = $now.toFormat('yyyy-LL-dd');\nconst key = [req.email, req.service, req.address, day].join('|').toLowerCase();\nlet h = 0;\nfor (let i = 0; i < key.length; i++) { h = ((h << 5) - h + key.charCodeAt(i)) | 0; }\nconst request_id = 'REQ-' + day.replace(/-/g, '') + '-' + Math.abs(h).toString(36).toUpperCase();\n\nreturn [{ json: {\n  ...req,\n  request_id,\n  received_at: $now.toISO(),\n  missing_fields: missing.map(k => labels[k] || k).join('; '),\n  status: missing.length ? 'missing_info' : 'ready_to_quote',\n  business_name: s.business_name,\n  reply_within: s.reply_within,\n}}];"
      },
      "typeVersion": 2
    },
