    {
      "id": "20da659a-8892-4719-8fa9-9f0e8585fcea",
      "name": "Redis - Claim Probe Slot",
      "type": "n8n-nodes-base.redis",
      "position": [
        1200,
        656
      ],
      "parameters": {
        "key": "={{ 'cb:' + $json.serviceName.replace(/[^a-zA-Z0-9_-]/g, '') + ':probe:' + $json.openedAt }}",
        "ttl": "={{ $json.openDurationSeconds * 2 }}",
