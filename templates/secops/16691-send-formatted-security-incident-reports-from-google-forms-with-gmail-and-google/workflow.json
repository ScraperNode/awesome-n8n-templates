        "options": {
          "appendAttribution": false
        },
        "subject": "={{ '[Rapport] ' + $('Prepare Report').item.json.site + ' \u2014 ' + $('Prepare Report').item.json.date + ' \u2014 ' + $('Prepare Report').item.json.agent_nom }}",
        "resource": "message",
        "emailType": "html",
        "operation": "send"
