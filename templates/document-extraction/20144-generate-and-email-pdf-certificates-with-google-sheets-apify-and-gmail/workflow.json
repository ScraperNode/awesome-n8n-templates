        "sendTo": "={{ $('Match emails').item.json.email }}",
        "message": "=<p>Hello {{ $('Match emails').item.json.name }},</p><p>Congratulations! Your certificate is attached.</p><p>Certificate ID: {{ $('Match emails').item.json.certificateId }}</p>",
        "options": {
