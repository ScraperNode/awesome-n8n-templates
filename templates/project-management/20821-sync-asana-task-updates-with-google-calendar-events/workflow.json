                      "type": "string",
                      "operation": "notEquals"
                    },
                    "leftValue": "={{ $json.TaskName }}",
                    "rightValue": "={{ $json.EventTitle }}"
                  }
                ]
              },
              "renameOutput": true
            },
            {
              "outputKey": "Description Updated",
              "conditions": {
                "options": {
                  "version": 3,
                  "leftValue": "",
                  "caseSensitive": true,
                  "typeValidation": "strict"
                },
                "combinator": "and",
                "conditions": [
                  {
                    "id": "f60286a1-4049-42a2-a426-3dfba5c996a8",
                    "operator": {
                      "type": "string",
                      "operation": "notEquals"
                    },
                    "leftValue": "={{ $json.TaskDescription }}",
                    "rightValue": "={{ $json.EventDescription }}"
                  }
                ]
              },
              "renameOutput": true
            },
            {
              "outputKey": "Followers Added",
              "conditions": {
                "options": {
                  "version": 3,
                  "leftValue": "",
                  "caseSensitive": true,
                  "typeValidation": "strict"
                },
                "combinator": "and",
                "conditions": [
                  {
                    "id": "8f95a16f-f025-43b7-a5e1-0ec902a8b47d",
                    "operator": {
                      "type": "boolean",
                      "operation": "true",
                      "singleValue": true
                    },
                    "leftValue": "={{ $json.TaskFollowers.filter(f => f !== $json.TaskAssignee).difference($json.EventCompanyAttendees).length > 0 }}",
                    "rightValue": "={{ $json.EventCompanyAttendees }}"
                  }
                ]
              },
              "renameOutput": true
            },
            {
              "outputKey": "Followers Removed",
              "conditions": {
                "options": {
                  "version": 3,
                  "leftValue": "",
                  "caseSensitive": true,
                  "typeValidation": "strict"
                },
                "combinator": "and",
                "conditions": [
                  {
                    "id": "a6bc70ba-22eb-4d1d-a8fc-d6d7491791ae",
                    "operator": {
                      "type": "boolean",
                      "operation": "true",
                      "singleValue": true
                    },
                    "leftValue": "={{ $json.EventCompanyAttendees.difference($json.TaskFollowers.filter(f => f !== $json.TaskAssignee)).length > 0 }}",
                    "rightValue": "={{ $json.EventCompanyAttendees }}"
                  }
                ]
              },
              "renameOutput": true
            },
            {
              "outputKey": "Date Changed",
              "conditions": {
                "options": {
                  "version": 3,
                  "leftValue": "",
                  "caseSensitive": true,
                  "typeValidation": "strict"
                },
                "combinator": "and",
                "conditions": [
                  {
                    "id": "ada8cf97-fbef-4747-bf76-31ef7cf30b1f",
                    "operator": {
                      "type": "boolean",
                      "operation": "true",
                      "singleValue": true
                    },
                    "leftValue": "={{ $json.TaskStartTime !== $json.EventStartTime || $json.TaskEndTime !== $json.EventEndTime }}",
                    "rightValue": ""
                  }
                ]
              },
              "renameOutput": true
            }
          ]
        },
        "options": {
          "allMatchingOutputs": true
        }
      },
      "typeVersion": 3.4
