        "jsonBody": "={{ JSON.stringify({ prompt: $('Describe the video').item.json.idea, platforms: $('Describe the video').item.json.networks, brand_voice: $('Describe the video').item.json.brand_voice, media_url: $json.media_url }) }}",
        "sendBody": true,
        "specifyBody": "json",
