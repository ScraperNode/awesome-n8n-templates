    {
      "id": "c9b33f7e-3af0-45f7-bce3-9188bb980e39",
      "name": "Extract Ranking Change",
      "type": "n8n-nodes-base.code",
      "position": [
        1600,
        608
      ],
      "parameters": {
        "jsCode": "const items = $input.all();\nconst originals = $('Split Out Keywords').all();\nconst output = [];\nfor (let i = 0; i < items.length; i++) {\n  const searchResult = items[i].json;\n  const original = originals[i].json;\n  const results = (searchResult.result && searchResult.result.results) || [];\n  const position = results.findIndex((r) => r.url && r.url.includes(original.domain));\n  const currentPosition = position === -1 ? null : position + 1;\n  const history = (original.data || []).filter(\n    (row) => row.keyword === original.keyword && row.domain === original.domain\n  );\n  const previous = history.sort((a, b) => new Date(b.checked_at) - new Date(a.checked_at))[0];\n  const previousPosition = previous && previous.position != null ? Number(previous.position) : null;\n  const positionChange = previousPosition != null && currentPosition != null ? previousPosition - currentPosition : null;\n  const droppedOut = previousPosition != null && currentPosition === null;\n  output.push({\n    json: {\n      keyword: original.keyword,\n      domain: original.domain,\n      position: currentPosition,\n      url_found: position === -1 ? null : results[position].url,\n      previous_position: previousPosition,\n      position_change: positionChange,\n      significant_drop: droppedOut || (positionChange !== null && positionChange <= -3),\n      checked_at: new Date().toISOString(),\n    },\n  });\n}\nreturn output;"
      },
      "typeVersion": 2
    },
