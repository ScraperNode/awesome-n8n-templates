    {
      "id": "73f4780c-a9d0-4756-8d5b-cb6e92f2977e",
      "name": "Collect Unique Sources",
      "type": "n8n-nodes-base.code",
      "position": [
        2992,
        1072
      ],
      "parameters": {
        "jsCode": "\n// One item per distinct source document, so Drive is searched once per file\n// instead of once per citation. An answer with no citations still produces a\n// single placeholder item, otherwise this branch would end here with zero\n// items and the caller would never get a response.\nconst out = $json.output || {};\nconst citations = Array.isArray(out.citations) ? out.citations : [];\nconst seen = new Map();\n\nfor (const c of citations) {\n  const name = String((c && c.document) || '').trim();\n  if (!name) continue;\n  const key = name.toLowerCase();\n  if (!seen.has(key)) seen.set(key, name);\n}\n\nif (seen.size === 0) {\n  return [{ json: { document: 'no-source-file', placeholder: true } }];\n}\n\nreturn Array.from(seen.values()).map(function (name) {\n  return { json: { document: name, placeholder: false } };\n});\n"
      },
      "typeVersion": 2
    },
    {
      "id": "cff8e19a-388b-44af-bbf8-440dd9dc3f45",
      "name": "Find File in Drive",
      "type": "n8n-nodes-base.googleDrive",
      "onError": "continueRegularOutput",
      "position": [
        3216,
        1072
      ],
      "parameters": {
        "limit": 1,
        "filter": {
          "whatToSearch": "files"
        },
        "options": {
          "fields": [
            "id",
            "name"
          ]
        },
        "resource": "fileFolder",
        "queryString": "={{ $json.document }}"
      },
      "typeVersion": 3,
      "alwaysOutputData": true
    },
    {
      "id": "6989237e-886d-48e5-8b6f-aff5f39aa1ac",
      "name": "Merge Drive Results",
      "type": "n8n-nodes-base.aggregate",
      "position": [
        3440,
        1072
      ],
      "parameters": {
        "options": {},
        "aggregate": "aggregateAllItemData"
      },
      "typeVersion": 1,
      "alwaysOutputData": true
    },
    {
      "id": "ee5af382-b5c8-46b0-8365-2fc7b88562b2",
      "name": "Build Answer Payload",
      "type": "n8n-nodes-base.code",
      "position": [
        3840,
        1072
      ],
      "parameters": {
        "jsCode": "\n// Assemble the API response: the grounded answer, every citation, and a\n// Drive view plus download link for each source file that was found.\nconst request = $('Capture Request').first().json;\nconst out = $('Document Q&A Agent').first().json.output || {};\nconst asked = $('Collect Unique Sources').all().map(function (i) { return i.json; });\n\nconst found = ($json.data || []).filter(function (r) { return r && r.id; });\n\nfunction normalize(s) {\n  return String(s || '').toLowerCase().replace(/\\.[a-z0-9]+$/, '').replace(/[^a-z0-9]+/g, '');\n}\n\n// Match Drive results back to the citation file names by name, and fall back\n// to position when Drive returned a slightly different title.\nconst byName = new Map();\nfound.forEach(function (r) { byName.set(normalize(r.name), r); });\n\nconst resolved = new Map();\nasked.forEach(function (a, idx) {\n  if (a.placeholder) return;\n  let hit = byName.get(normalize(a.document));\n  if (!hit && found[idx] && normalize(found[idx].name) === normalize(a.document)) hit = found[idx];\n  if (hit) {\n    resolved.set(a.document.toLowerCase(), {\n      fileId: hit.id,\n      fileName: hit.name,\n      viewUrl: 'https://drive.google.com/file/d/' + hit.id + '/view',\n      downloadUrl: 'https://drive.google.com/uc?export=download&id=' + hit.id,\n    });\n  }\n});\n\nconst citations = (Array.isArray(out.citations) ? out.citations : []).map(function (c) {\n  const link = resolved.get(String((c && c.document) || '').toLowerCase()) || null;\n  return {\n    document: (c && c.document) || '',\n    page: (c && c.page) || '',\n    quote: (c && c.quote) || '',\n    viewUrl: link ? link.viewUrl : null,\n    downloadUrl: link ? link.downloadUrl : null,\n    fileFoundInDrive: !!link,\n  };\n});\n\nconst missing = citations\n  .filter(function (c) { return !c.fileFoundInDrive && c.document; })\n  .map(function (c) { return c.document; });\n\nconst started = Number(request.startedAt) || Date.now();\n\nreturn [{\n  json: {\n    answered: true,\n    question: request.question,\n    sessionId: request.sessionId,\n    answer: out.answer || '',\n    confidence: Number(out.confidence) || 0,\n    followUpNeeded: !!out.followUpNeeded,\n    citations: citations,\n    sourceDocuments: Array.from(new Set(citations.map(function (c) { return c.document; }).filter(Boolean))),\n    missingFromDrive: Array.from(new Set(missing)),\n    cached: false,\n    latencyMs: Date.now() - started,\n    cacheKey: request.cacheKey,\n    answeredAt: new Date().toISOString(),\n  },\n}];\n"
      },
      "typeVersion": 2
    },
    {
