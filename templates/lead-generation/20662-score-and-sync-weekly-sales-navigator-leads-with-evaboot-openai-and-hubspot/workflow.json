      "parameters": {
        "resource": "extraction",
        "operation": "createUrl",
        "searchName": "={{ 'Weekly export ' + $now.toFormat('yyyy-LL-dd') }}",
        "linkedinUrl": "={{ $json.salesNavigatorUrl }}"
      },
      "credentials": {
        "evabootApi": {
          "id": "",
          "name": "Evaboot account"
        }
      },
      "typeVersion": 1
    },
