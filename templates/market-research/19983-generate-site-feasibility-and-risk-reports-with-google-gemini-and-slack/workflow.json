    {
      "id": "6cd6fe92-6178-40fa-b6c8-38fdb50ae1a3",
      "name": "Parse Feasibility Schema",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "position": [
        3392,
        864
      ],
      "parameters": {
        "jsonSchema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"risk_score\": {\n      \"type\": \"number\",\n      \"description\": \"integer 0-100, 0=no risk 100=extreme risk\"\n    },\n    \"verdict\": {\n      \"type\": \"string\",\n      \"description\": \"one of: Favorable / Proceed with Caution / Not Recommended\"\n    },\n    \"flood_risk_summary\": {\n      \"type\": \"string\",\n      \"description\": \"1-2 sentences on elevation/flood exposure\"\n    },\n    \"ecological_risk_summary\": {\n      \"type\": \"string\",\n      \"description\": \"1-2 sentences on protected/endangered species findings and construction blocker potential\"\n    },\n    \"demographic_summary\": {\n      \"type\": \"string\",\n      \"description\": \"1-2 sentences on median income, population, and population density context for commercial viability\"\n    },\n    \"recommendation\": {\n      \"type\": \"string\",\n      \"description\": \"2-3 sentence actionable recommendation\"\n    }\n  },\n  \"required\": [\n    \"risk_score\",\n    \"verdict\",\n    \"flood_risk_summary\",\n    \"ecological_risk_summary\",\n    \"demographic_summary\",\n    \"recommendation\"\n  ]\n}"
      },
      "typeVersion": 1
    },
