    {
      "id": "de2215a1-2670-5b6b-ac4f-e4d26c4bb4b5",
      "name": "Keep images under 22 MB",
      "type": "n8n-nodes-base.filter",
      "position": [
        980,
        300
      ],
      "parameters": {
        "options": {},
        "conditions": {
          "options": {
            "version": 2,
            "leftValue": "",
            "caseSensitive": true,
            "typeValidation": "loose"
          },
          "combinator": "and",
          "conditions": [
            {
              "id": "9514e773-d0b4-59c9-a8da-f977cab35d13",
              "operator": {
                "type": "string",
                "operation": "regex"
              },
              "leftValue": "={{ $json.mimeType }}",
              "rightValue": "^image/(jpeg|png|webp)$"
            },
