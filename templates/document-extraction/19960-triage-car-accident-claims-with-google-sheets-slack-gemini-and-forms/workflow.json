      "parameters": {
        "color": 7,
        "width": 864,
        "height": 496,
        "content": "## Claim intake and policy gate\n\nCaptures the claim submission, checks the insurance policy against Google Sheets, branches on validity, alerts Slack for invalid policies, and prepares the image binary for the valid path."
      },
      "typeVersion": 1
