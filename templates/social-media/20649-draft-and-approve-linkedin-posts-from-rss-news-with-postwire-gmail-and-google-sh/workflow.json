      "name": "Write the LinkedIn post",
      "type": "n8n-nodes-postwire.postWire",
      "position": [
        -16,
        600
      ],
      "parameters": {
        "prompt": "={{ 'Write a LinkedIn post that comments on this story. My angle: ' + $('Your feed and angle').first().json.angle + '\\n\\nStory: ' + $json.title + '\\n' + ($json.contentSnippet || '').slice(0, 1200) + '\\nSource: ' + $json.link + '\\n\\nOpen with the concrete fact, give my take and one practical takeaway, end with a question. Put the source link at the end.' }}",
        "options": {
          "brandVoice": "First person, plain-spoken, short paragraphs, no buzzwords, at most 3 hashtags"
        },
        "resource": "post",
        "operation": "generate",
        "platforms": [
          "linkedin"
        ],
        "mediaSource": "none"
      },
      "typeVersion": 2
    },
