        1584,
        1072
      ],
      "parameters": {
        "jsCode": "const outreachEmails = $('Initial Outreach').first().json.data.map(item => item !== null && item.email !== null);\n\nconst filteredLeads = $(\"Initial Leads\").first().json.data.filter(item => !item[\"Person Email\"].includes(outreachEmails));\n\nreturn filteredLeads"
      },
      "typeVersion": 2,
      "alwaysOutputData": true
    },
