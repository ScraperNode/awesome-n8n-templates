    },
    {
      "id": "57f4d89a-18d6-4eb1-9f20-000000000002",
      "name": "Configure Brand and Channels",
      "type": "n8n-nodes-base.set",
      "position": [
        288,
        192
      ],
      "parameters": {
        "mode": "raw",
        "options": {},
        "jsonOutput": "{\n  \"brand_name\": \"Your Brand\",\n  \"brand_voice\": \"clear, warm, specific, and never exaggerated\",\n  \"audience\": \"people interested in our products and services\",\n  \"language\": \"English\",\n  \"instagram_user_id\": \"YOUR_INSTAGRAM_USER_ID\",\n  \"graph_api_version\": \"v23.0\",\n  \"telegram_chat_id\": \"YOUR_TELEGRAM_CHAT_ID\",\n  \"gemini_model\": \"gemini-2.5-flash\",\n  \"minimum_confidence\": 0.75,\n  \"required_hashtags\": [\"YourBrand\", \"YourCity\"],\n  \"fallback_hashtags\": [\"smallbusiness\", \"localbusiness\", \"discovermore\"],\n  \"banned_phrases\": [\"guaranteed\", \"best ever\", \"miracle\", \"risk-free\", \"limited time\"]\n}"
      },
      "typeVersion": 3.4
    },
    {
      "id": "57f4d89a-18d6-4eb1-9f20-000000000003",
      "name": "Validate Submission",
      "type": "n8n-nodes-base.code",
      "position": [
        528,
        192
      ],
      "parameters": {
        "jsCode": "const request = $('Submit Post Request').first().json;\nconst cfg = $('Configure Brand and Channels').first().json;\nconst imageUrl = String(request.image_url || '').trim();\nconst productName = String(request.product_name || '').trim();\nconst facts = String(request.verified_facts || '').trim();\n\nif (!/^https:\\/\\//i.test(imageUrl)) throw new Error('Public image URL must start with https://');\nif (!/\\.(?:jpe?g|png|webp)(?:\\?.*)?$/i.test(imageUrl)) throw new Error('Image URL must point to a JPG, PNG, or WebP file.');\nif (productName.length < 2 || productName.length > 100) throw new Error('Product name must be between 2 and 100 characters.');\nif (facts.length < 10 || facts.length > 1200) throw new Error('Verified facts must be between 10 and 1200 characters.');\n\nreturn [{ json: {\n  image_url: imageUrl,\n  product_name: productName,\n  verified_facts: facts,\n  call_to_action: String(request.call_to_action || '').trim(),\n  requested_at: new Date().toISOString(),\n  brand_name: cfg.brand_name,\n} }];"
      },
      "typeVersion": 2
    },
    {
      "id": "57f4d89a-18d6-4eb1-9f20-000000000004",
      "name": "Download Submitted Image",
      "type": "n8n-nodes-base.httpRequest",
      "maxTries": 2,
      "position": [
        848,
        176
      ],
      "parameters": {
        "url": "={{ $json.image_url }}",
        "options": {
          "timeout": 30000,
          "response": {
            "response": {
              "responseFormat": "file",
              "outputPropertyName": "data"
            }
          }
        }
      },
      "retryOnFail": true,
      "typeVersion": 4.3,
      "waitBetweenTries": 1500
    },
    {
      "id": "57f4d89a-18d6-4eb1-9f20-000000000005",
      "name": "Prepare Guarded AI Prompt",
      "type": "n8n-nodes-base.code",
      "position": [
        1088,
        176
      ],
      "parameters": {
        "jsCode": "const cfg = $('Configure Brand and Channels').first().json;\nconst req = $('Validate Submission').first().json;\nconst prompt = [\n  'You are a careful social media editor for ' + cfg.brand_name + '.',\n  'Analyze the attached image and write one Instagram caption in ' + cfg.language + '.',\n  'Brand voice: ' + cfg.brand_voice + '.',\n  'Audience: ' + cfg.audience + '.',\n  'Product or service name: ' + req.product_name + '.',\n  'These are the only verified facts you may state: ' + req.verified_facts,\n  req.call_to_action ? 'Requested call to action: ' + req.call_to_action : 'Use a gentle, non-salesy call to action.',\n  'Never invent ingredients, prices, discounts, awards, availability, health claims, or visual details.',\n  'Return valid JSON only with this shape:',\n  '{\"caption\":\"80-700 characters, no hashtags\",\"hashtags\":[\"five\",\"relevant\",\"tags\"],\"confidence\":0.0,\"risks\":[]}',\n  'Set confidence below 0.75 or list a risk whenever the image conflicts with the verified facts or is unclear.',\n].join('\\n');\n\nreturn [{ json: { ...req, analysis_prompt: prompt }, binary: $binary }];"
      },
      "typeVersion": 2
    },
    {
      "id": "57f4d89a-18d6-4eb1-9f20-000000000006",
      "name": "Draft Caption with Gemini",
      "type": "@n8n/n8n-nodes-langchain.googleGemini",
      "position": [
        1328,
        176
      ],
      "parameters": {
        "text": "={{ $json.analysis_prompt }}",
        "modelId": {
          "__rl": true,
          "mode": "id",
          "value": "={{ 'models/' + $('Configure Brand and Channels').first().json.gemini_model }}"
        },
        "options": {},
        "resource": "image",
        "inputType": "binary",
        "operation": "analyze"
      },
      "typeVersion": 1.1
    },
    {
      "id": "57f4d89a-18d6-4eb1-9f20-000000000007",
      "name": "Apply Deterministic Quality Gates",
      "type": "n8n-nodes-base.code",
      "position": [
        1648,
        192
      ],
      "parameters": {
        "jsCode": "const cfg = $('Configure Brand and Channels').first().json;\nconst req = $('Validate Submission').first().json;\nconst clean = (value) => String(value || '').replace(/[\\r\\t]+/g, ' ').replace(/ {2,}/g, ' ').trim();\nconst tag = (value) => clean(value).replace(/^#+/, '').replace(/[^\\p{L}\\p{N}_]/gu, '');\nlet raw = '';\ntry { raw = $json.content.parts[0].text || ''; } catch (e) {}\nif (!raw && $json.text) raw = $json.text;\nraw = String(raw).replace(/```(?:json)?/gi, '').trim();\n\nlet draft;\ntry { draft = JSON.parse(raw); } catch (e) {\n  return [{ json: { passed: false, reason: 'Gemini did not return valid JSON.', raw_reply: raw.slice(0, 1000) } }];\n}\n\nconst caption = clean(draft.caption);\nconst confidence = Number(draft.confidence);\nconst risks = Array.isArray(draft.risks) ? draft.risks.map(clean).filter(Boolean) : [];\nconst banned = (cfg.banned_phrases || []).filter((p) => caption.toLocaleLowerCase().includes(String(p).toLocaleLowerCase()));\nconst tags = [];\nfor (const candidate of [...(cfg.required_hashtags || []), ...(draft.hashtags || []), ...(cfg.fallback_hashtags || [])]) {\n  const value = tag(candidate);\n  if (value && !tags.some((existing) => existing.toLocaleLowerCase() === value.toLocaleLowerCase())) tags.push(value);\n  if (tags.length === 5) break;\n}\nconst failures = [];\nif (caption.length < 80 || caption.length > 700) failures.push('caption length is outside 80-700 characters');\nif (!caption.toLocaleLowerCase().includes(req.product_name.toLocaleLowerCase())) failures.push('product name is missing');\nif (!Number.isFinite(confidence) || confidence < Number(cfg.minimum_confidence || 0.75)) failures.push('model confidence is too low');\nif (risks.length) failures.push('model reported: ' + risks.join('; '));\nif (banned.length) failures.push('banned phrase found: ' + banned.join(', '));\nif (tags.length !== 5) failures.push('could not build exactly five unique hashtags');\n\nconst captionFull = caption + '\\n\\n' + tags.map((value) => '#' + value).join(' ');\nconst esc = (value) => clean(value).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/\"/g, '&quot;');\nconst approvalHtml = '<img src=\"' + esc(req.image_url) + '\" alt=\"Draft image\" style=\"max-width:100%;border-radius:12px\">' +\n  '<h3>' + esc(req.product_name) + '</h3><p style=\"white-space:pre-wrap\">' + esc(captionFull) + '</p>' +\n  '<p><strong>AI confidence:</strong> ' + Math.round((Number.isFinite(confidence) ? confidence : 0) * 100) + '%</p>';\n\nreturn [{ json: {\n  passed: failures.length === 0,\n  reason: failures.join('; '),\n  image_url: req.image_url,\n  product_name: req.product_name,\n  caption: captionFull,\n  confidence,\n  approval_html: approvalHtml,\n} }];"
      },
      "typeVersion": 2
    },
