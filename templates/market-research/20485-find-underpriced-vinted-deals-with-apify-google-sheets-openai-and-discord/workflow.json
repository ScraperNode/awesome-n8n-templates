    {
      "id": "llm-redflag",
      "name": "AI red-flag check",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "position": [
        2720,
        200
      ],
      "parameters": {
        "text": "=Listing title: {{ $json.title }}\nListing description: {{ $json.description || '(no description returned)' }}\nSize: {{ $json.size }}\nPrice: {{ $json.priceEur }} EUR",
        "messages": {
          "messageValues": [
            {
              "type": "SystemMessagePromptTemplate",
              "message": "You are a quick pre-purchase red-flag check for second-hand Vinted listings. You look only at the title and description you are given and decide whether the listing itself raises a red flag a buyer should know about before anyone looks closer - not whether it is a good deal.\n\nFlag it (ok: false) when the text itself says or strongly implies any of:\n- it is fake, a replica, \"inspired by\", or explicitly not authentic\n- it is damaged, stained, torn, or sold \"for parts\" / \"for repair\"\n- the size is missing, unreadable, or contradicts the title (e.g. a kids size on an adult-brand title)\n- it is a bundle/lot of several different items being sold as one listing\n\nDo not flag a listing just because it is vague or short - lack of detail is not itself a red flag. When genuinely unsure, prefer ok: true; this check exists to catch clear problems, not to second-guess every listing.\n\nReply with exactly one JSON object and nothing else - no prose, no markdown fence:\n{\"ok\": true, \"reason\": \"\"}\n`reason` is one short sentence - empty string when ok is true."
            }
          ]
        },
        "promptType": "define"
      },
      "typeVersion": 1.9
    },
    {
      "id": "switch-route-score",
      "name": "Route by deal score",
      "type": "n8n-nodes-base.switch",
      "position": [
        2980,
        200
      ],
      "parameters": {
        "mode": "rules",
        "rules": {
          "values": [
            {
              "outputKey": "Flagged by AI",
              "conditions": {
                "options": {
                  "version": 2,
                  "leftValue": "",
                  "caseSensitive": true,
                  "typeValidation": "loose"
                },
                "combinator": "and",
                "conditions": [
                  {
                    "id": "cond-flagged",
                    "operator": {
                      "type": "boolean",
                      "operation": "true",
                      "singleValue": true
                    },
                    "leftValue": "={{ (() => { try { return JSON.parse($json.text).ok === false; } catch (e) { return false; } })() }}",
                    "rightValue": true
                  }
                ]
              }
            },
            {
              "outputKey": "HOT",
              "conditions": {
                "options": {
                  "version": 2,
                  "leftValue": "",
                  "caseSensitive": true,
                  "typeValidation": "loose"
                },
                "combinator": "and",
                "conditions": [
                  {
                    "id": "cond-hot",
                    "operator": {
                      "type": "number",
                      "operation": "gte"
                    },
                    "leftValue": "={{$json.dealScorePct}}",
                    "rightValue": 30
                  }
                ]
              }
            },
            {
              "outputKey": "GOOD",
              "conditions": {
                "options": {
                  "version": 2,
                  "leftValue": "",
                  "caseSensitive": true,
                  "typeValidation": "loose"
                },
                "combinator": "and",
                "conditions": [
                  {
                    "id": "cond-good",
                    "operator": {
                      "type": "number",
                      "operation": "gte"
                    },
                    "leftValue": "={{$json.dealScorePct}}",
                    "rightValue": 10
                  }
                ]
              }
            }
          ]
        },
        "options": {
          "fallbackOutput": "extra"
        }
      },
      "typeVersion": 3.2
    },
