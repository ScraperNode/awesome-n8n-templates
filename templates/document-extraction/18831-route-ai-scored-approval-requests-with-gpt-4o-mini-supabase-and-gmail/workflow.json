    {
      "id": "03fc7bf0-9407-4528-8e41-fd1bef72019d",
      "name": "Approval URLs & Message",
      "type": "n8n-nodes-base.code",
      "position": [
        2592,
        336
      ],
      "parameters": {
        "jsCode": "const item = $input.first().json;\n\nconst requestId = item.request_id;\n// Replace host with your n8n domain before going live\nconst baseUrl = 'http://192.168.101.63:5678/webhook/approve-action';\n\nitem.approve_url = `${baseUrl}?request_id=${encodeURIComponent(requestId)}&action=approved`;\nitem.reject_url = `${baseUrl}?request_id=${encodeURIComponent(requestId)}&action=rejected`;\n\nitem.approval_message = `\nApproval Request\nID: ${item.request_id}\nTitle: ${item.request_title}\nRequester: ${item.requested_by}\nAmount: ${item.amount}\nPriority: ${item.priority}\nAI Summary: ${item.ai_summary}\nApprove: ${item.approve_url}\nReject: ${item.reject_url}\n`;\n\nreturn [{ json: item }];"
      },
      "typeVersion": 2
    },
