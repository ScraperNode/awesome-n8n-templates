        "jsCode": "const d = $('Normalize AI Risk Context').first().json;\nconst message = ['VIX Regime Change','',`Index: ${d.index_name}`,`Current VIX: ${d.current_vix}`,`Previous Regime: ${d.previous_regime}`,`New Regime: ${d.current_regime}`,`Transition: ${d.transition}`,`VIX Change: ${d.change_percent}%`,'','Risk Context',d.regime_summary,'','General Risk Guidance',d.risk_guidance,'','Position Sizing Context',d.position_sizing_context,'',d.disclaimer].join('\\n');\nreturn [{ json: { ...d, slack_message: message } }];"
