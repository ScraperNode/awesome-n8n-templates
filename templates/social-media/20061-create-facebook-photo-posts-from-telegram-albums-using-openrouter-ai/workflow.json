    {
      "id": "e8c1c833-4f90-42c6-bb1e-801dd4abab43",
      "name": "Filter & Parse Photo",
      "type": "n8n-nodes-base.code",
      "position": [
        -288,
        720
      ],
      "parameters": {
        "jsCode": "const msg = $json.message;\nconst bestPhoto = msg.photo[msg.photo.length - 1];\n\nconst mediaGroupKey = msg.media_group_id\n  ? `${msg.chat.id}_${msg.media_group_id}`\n  : `single_${msg.chat.id}_${msg.message_id}`;\n\nreturn [\n  {\n    json: {\n      media_group_id: mediaGroupKey,\n      file_id: bestPhoto.file_id,\n      date: msg.date,\n\n      caption: msg.caption ?? null\n    }\n  }\n];\n"
      },
      "typeVersion": 2
    },
