    {
      "id": "0aabcbb2-5762-4c76-ae9e-383b030b37d2",
      "name": "Format Bookings",
      "type": "n8n-nodes-base.code",
      "position": [
        176,
        880
      ],
      "parameters": {
        "jsCode": "\nconst p = $('Parse Vapi').first().json;\nconst ev = $input.all().map(i => i.json).filter(e => e.id && e.start);\nif (!ev.length) return [{ json: { toolCallId: p.toolCallId, result: 'No upcoming booking found for this phone number.' } }];\nconst lines = ev.map(e => {\n  const d = new Date(e.start.dateTime || e.start.date);\n  const when = d.toLocaleString('en-GB', { timeZone: $now.zoneName, weekday: 'short', day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit', hour12: true });\n  return `event_id=${e.id} | ${when} | ${e.summary}`;\n});\nreturn [{ json: { toolCallId: p.toolCallId, result: 'Upcoming bookings (never read event_id aloud): ' + lines.join(' ;; ') } }];\n"
      },
      "typeVersion": 2
    },
    {
      "id": "27c24c9b-7dec-4268-879b-b7bc7ecea3de",
      "name": "Prep Reschedule",
      "type": "n8n-nodes-base.code",
      "position": [
        -48,
        1200
      ],
      "parameters": {
        "jsCode": "\nconst a = $json.args;\nconst s = new Date(a.new_start);\nif (isNaN(s)) throw new Error('Invalid new_start');\nconst e = new Date(s.getTime() + 30 * 60000);\nconst when = s.toLocaleString('en-GB', { timeZone: $now.zoneName, weekday: 'short', day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit', hour12: true });\nreturn [{ json: { ...$json, startISO: s.toISOString(), endISO: e.toISOString(), when } }];\n"
      },
      "typeVersion": 2
    },
