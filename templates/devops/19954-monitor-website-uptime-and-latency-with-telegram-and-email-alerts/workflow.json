              "keyName": "checked_at",
              "keyValue": "={{ $json.cutoff_date }}",
              "condition": "lt"
            }
          ]
        },
        "operation": "deleteRows",
        "dataTableId": {
          "__rl": true,
          "mode": "name",
          "value": "uptime_history"
        }
      },
      "notesInFlow": false,
