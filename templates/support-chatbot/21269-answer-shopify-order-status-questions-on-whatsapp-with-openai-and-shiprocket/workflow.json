        "jsonBody": "={{ JSON.stringify({ query: 'query($q:String!){ customers(first:1, query:$q){ edges{ node{ firstName email orders(first:5, reverse:true){ edges{ node{ name createdAt email phone displayFinancialStatus displayFulfillmentStatus cancelledAt totalPriceSet{shopMoney{amount}} lineItems(first:5){edges{node{title quantity}}} fulfillments(first:3){ status createdAt deliveredAt estimatedDeliveryAt displayStatus trackingInfo{ number company url } } } } } } } } }', variables: { q: 'phone:' + $('Parse WhatsApp Message').first().json.phone_e164 } }) }}",
        "sendBody": true,
        "specifyBody": "json",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "toolDescription": "Get the last 5 orders of the customer messaging us, found by their WhatsApp phone number. Returns status, items, fulfilment, tracking number/company/url and delivery dates. No input needed."
      },
      "typeVersion": 4.2
    },
    {
      "id": "8ceb6a33-fd77-4a48-8143-a05db86eb90f",
      "name": "WISMO AI Agent",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "onError": "continueRegularOutput",
      "position": [
        3776,
        112
      ],
      "parameters": {
        "text": "=Customer WhatsApp: {{ $('Parse WhatsApp Message').first().json.phone_e164 }} (name on WhatsApp: {{ $('Parse WhatsApp Message').first().json.name || 'unknown' }})\nToday (IST): {{ $now.setZone('Asia/Kolkata').toFormat('cccc dd LLL yyyy, HH:mm') }}\nLast order discussed: {{ $('Decide Bot or Human').first().json.last_order || 'none' }}\nFailed answers in a row: {{ $('Decide Bot or Human').first().json.fails }}\n\nCustomer message:\n{{ $('Parse WhatsApp Message').first().json.text }}",
        "options": {
          "systemMessage": "You are OrderDesk, the WhatsApp support assistant for an Indian online store. You answer questions about order status, delivery dates, tracking and returns using LIVE tools. You never guess.\n\nTools:\n- \"my_recent_orders\": orders linked to the sender's phone. Call it first for \"where is my order\" type questions.\n- \"order_by_number\": when the customer gives an order number. PRIVACY: share details ONLY if the order's phone (last 10 digits) or email matches the sender. If it doesn't match, ask for the email used on the order and do not reveal anything.\n- \"track_shipment\": the live courier status and expected delivery for an AWB (taken from the order's tracking info).\n- \"return_policy\": the official return, exchange and refund rules.\n\nHow to answer:\n- Reply in the customer's language and style (English, Hindi or Hinglish), friendly, max 3 short lines plus any key facts. Use 1 emoji at most.\n- Give concrete facts: the order number, the item, the current status with its date, the courier and AWB, the expected delivery date, and the tracking link when available.\n- Delayed (past the EDD with no delivery): apologise, give the latest scan, and offer to escalate.\n- Returns: explain the rule briefly and share the return link: https://REPLACE-STORE/pages/returns\n- Set needs_human=true when: the customer asks for a human; the item is damaged, missing or wrong; there's a refund or payment dispute; the customer is abusive or makes a legal threat; the order is not found after both lookups; you can't answer confidently; or failed answers in a row \u2265 2.\n- Never promise refunds, compensation or delivery dates that aren't in the data."
        },
        "promptType": "define",
        "hasOutputParser": true
      },
      "typeVersion": 1.7
    },
    {
