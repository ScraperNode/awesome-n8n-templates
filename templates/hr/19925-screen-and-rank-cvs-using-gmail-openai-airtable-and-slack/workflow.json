    {
      "id": "70351402-2878-4e8a-8edb-b532002223c6",
      "name": "LLM Parse CV",
      "type": "@n8n/n8n-nodes-langchain.openAi",
      "position": [
        1472,
        448
      ],
      "parameters": {
        "modelId": {
          "__rl": true,
          "mode": "list",
          "value": "gpt-4o-mini"
        },
        "options": {
          "temperature": 0
        },
        "messages": {
          "values": [
            {
              "role": "system",
              "content": "You extract structured data from resumes/CVs. Return ONLY valid JSON, no prose, no markdown fences. Do not infer or output anything about the candidate's age, gender, nationality, ethnicity, marital status, or photo \u2014 if such data appears in the CV, discard it and do not include it in the output."
            },
            {
              "content": "=Extract the following fields from this CV text as JSON with keys: name, email, phone, years_experience (number), current_role, skills (array of strings), education (array of strings), notable_projects (array of strings).\n\nCV TEXT:\n{{ $json.text }}"
            }
          ]
        },
        "jsonOutput": true
      },
      "typeVersion": 1.5
    },
    {
      "id": "eb341e67-c47b-47cd-9d0e-ccb87882e160",
      "name": "Normalize CV Data",
      "type": "n8n-nodes-base.code",
      "position": [
        1968,
        448
      ],
      "parameters": {
        "jsCode": "const raw = $input.item.json.message?.content ?? $input.item.json.content ?? $input.item.json;\nlet parsed = typeof raw === 'string' ? JSON.parse(raw) : raw;\nif (parsed && typeof parsed === 'object' && !parsed.name && (parsed.text || parsed.data)) {\n  const maybe = parsed.text || parsed.data;\n  if (typeof maybe === 'string') {\n    try { parsed = JSON.parse(maybe); } catch (_) {}\n  } else if (typeof maybe === 'object') {\n    parsed = maybe;\n  }\n}\nconst asArray = (v) => Array.isArray(v) ? v : (v == null || v === '' ? [] : [String(v)]);\nreturn {\n  json: {\n    name: parsed.name || '',\n    email: parsed.email || '',\n    phone: parsed.phone || '',\n    years_experience: Number(parsed.years_experience) || 0,\n    current_role: parsed.current_role || '',\n    skills: asArray(parsed.skills),\n    education: asArray(parsed.education),\n    notable_projects: asArray(parsed.notable_projects),\n    source_email_id: $('Gmail Application Trigger').item.json.id ?? null,\n  },\n};"
      },
      "typeVersion": 2
    },
    {
      "id": "44b5e52c-c65a-4326-af92-fcff23193901",
      "name": "Merge CV with Job Config",
      "type": "n8n-nodes-base.merge",
      "position": [
        2192,
        544
      ],
      "parameters": {
        "mode": "combine",
        "options": {
          "clashHandling": {
            "values": {
              "resolveClash": "preferInput1",
              "overrideEmpty": true
            }
