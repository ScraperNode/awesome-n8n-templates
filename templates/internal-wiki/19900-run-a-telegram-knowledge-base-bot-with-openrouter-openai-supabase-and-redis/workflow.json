    {
      "id": "5067ee8d-356d-5118-801f-4f057c17fc4f",
      "name": "Normalize Telegram Update",
      "type": "n8n-nodes-base.code",
      "position": [
        -1580,
        0
      ],
      "parameters": {
        "jsCode": "// Replace this placeholder before activation.\nconst CONTROL_CHAT_ID = 'REPLACE_WITH_CONTROL_CHAT_ID';\n\nconst update = $json ?? {};\n\nfunction clean(value, max = 100) {\n  return String(value ?? '')\n    .replace(/[\\u0000-\\u001F\\u007F]/g, ' ')\n    .replace(/\\s+/g, ' ')\n    .trim()\n    .slice(0, max);\n}\n\nif (update.callback_query) {\n  const callback = update.callback_query;\n  const parts = String(callback.data ?? '').split('|');\n  const actionMap = { a: 'approved', d: 'denied', b: 'blocked' };\n  const action = parts[0] === 'kb' ? actionMap[parts[1]] : undefined;\n  const targetUserId = Number(parts[2]);\n  const targetChatId = Number(parts[3]);\n  const sourceChatId = callback.message?.chat?.id;\n  const configured = CONTROL_CHAT_ID !== 'REPLACE_WITH_CONTROL_CHAT_ID';\n  const validDecision = Boolean(\n    action &&\n    Number.isSafeInteger(targetUserId) &&\n    Number.isSafeInteger(targetChatId)\n  );\n\n  return [{\n    json: {\n      eventType: 'callback',\n      callbackQueryId: callback.id,\n      callbackMessageId: callback.message?.message_id,\n      callbackActorId: callback.from?.id,\n      sourceChatId,\n      controlChatId: CONTROL_CHAT_ID,\n      isAuthorizedControlChat: configured && String(sourceChatId) === CONTROL_CHAT_ID,\n      isValidDecision: validDecision,\n      decisionStatus: action ?? 'invalid',\n      targetUserId,\n      targetChatId,\n      accessKey: validDecision ? `telegram:knowledge:access:${targetUserId}` : '',\n    },\n  }];\n}\n\nconst message = update.message;\nif (!message || message.chat?.type !== 'private') {\n  return [];\n}\n\nconst text = String(message.text ?? '').trim();\nlet inputType = 'unsupported';\nif (/^\\/(start|help)(@\\w+)?(?:\\s|$)/i.test(text)) {\n  inputType = 'help';\n} else if (message.voice?.file_id) {\n  inputType = 'voice';\n} else if (text) {\n  inputType = 'text';\n}\n\nconst userId = Number(message.from?.id);\nconst chatId = Number(message.chat?.id);\n\nreturn [{\n  json: {\n    eventType: 'message',\n    inputType,\n    userId,\n    chatId,\n    text,\n    voiceFileId: message.voice?.file_id ?? '',\n    username: clean(message.from?.username, 64),\n    firstName: clean(message.from?.first_name, 80),\n    controlChatId: CONTROL_CHAT_ID,\n    accessKey: `telegram:knowledge:access:${userId}`,\n    sessionKey: `telegram:knowledge:memory:${chatId}`,\n  },\n}];"
      },
      "typeVersion": 2
    },
