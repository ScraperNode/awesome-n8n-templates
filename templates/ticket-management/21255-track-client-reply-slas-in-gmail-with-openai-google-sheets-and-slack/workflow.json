    {
      "id": "0d87ec4f-725c-4f2c-9428-61c10eed770d",
      "name": "Find threads waiting on you",
      "type": "n8n-nodes-base.code",
      "position": [
        640,
        80
      ],
      "parameters": {
        "jsCode": "// For each client thread: the newest inbound message, and whether you have replied since.\nconst cfg = $('Configure settings').first().json;\nconst HOUR = 3600000;\nconst list = s => String(s || '').toLowerCase().split(',').map(x => x.trim()).filter(Boolean);\nconst me = String(cfg.my_email).toLowerCase();\nconst internal = list(cfg.internal_domains);\nconst clients = list(cfg.client_domains);\nconst ignore = /(no-?reply|do-?not-?reply|notifications?|mailer-daemon|newsletter|billing|receipts?|calendar-notification)@/i;\nconst addr = s => ((String(s || '').match(/<([^>]+)>/) || [])[1] || String(s || '')).trim().toLowerCase();\nconst domain = a => a.split('@')[1] || '';\n\nconst lastSent = {};\nfor (const { json: m } of $input.all()) {\n  if (m.threadId) lastSent[m.threadId] = Math.max(lastSent[m.threadId] || 0, Number(m.internalDate) || 0);\n}\n\nconst latest = {};\nfor (const { json: m } of $('Get recent inbox emails').all()) {\n  if (!m.threadId) continue;\n  const from = addr(m.From);\n  if (!from || from === me || ignore.test(from) || internal.includes(domain(from))) continue;\n  if (clients.length && !clients.includes(domain(from))) continue;\n  const t = Number(m.internalDate) || 0;\n  if (!latest[m.threadId] || t > latest[m.threadId].t) {\n    latest[m.threadId] = { t, id: m.id, from, subject: m.Subject || '(no subject)', snippet: m.snippet || '' };\n  }\n}\n\nreturn Object.entries(latest).map(([threadId, m]) => {\n  const replyT = (lastSent[threadId] || 0) > m.t ? lastSent[threadId] : null;\n  return { json: {\n    inbound_message_id: m.id,\n    thread_id: threadId,\n    client_email: m.from,\n    client_domain: domain(m.from),\n    subject: m.subject,\n    snippet: m.snippet,\n    received_at: new Date(m.t).toISOString(),\n    hours_waiting: replyT ? 0 : Math.round((Date.now() - m.t) / HOUR * 10) / 10,\n    replied_at: replyT ? new Date(replyT).toISOString() : '',\n    response_hours: replyT ? Math.round((replyT - m.t) / HOUR * 10) / 10 : '',\n  } };\n});"
      },
      "typeVersion": 2
    },
