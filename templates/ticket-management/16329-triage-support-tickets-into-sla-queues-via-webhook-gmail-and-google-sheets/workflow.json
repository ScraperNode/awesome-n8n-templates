    {
      "id": "assign-priority-and-sla",
      "name": "Assign Priority and SLA",
      "type": "n8n-nodes-base.code",
      "position": [
        -560,
        20
      ],
      "parameters": {
        "jsCode": "const subject = String($json.subject || '').trim();\nconst message = String($json.message || '').trim();\nconst text = (subject + ' ' + message).toLowerCase();\n\nconst categoryRules = [\n  ['account_access', ['locked out', 'cannot log in', \"can't log in\", 'password reset', 'two factor', '2fa', 'verification code', 'account disabled']],\n  ['billing', ['invoice', 'billing', 'charged', 'chargeback', 'refund', 'payment', 'receipt', 'subscription', 'renewal']],\n  ['sales', ['pricing', 'quote', 'demo', 'trial', 'upgrade', 'enterprise plan', 'purchase', 'buy']],\n  ['technical', ['error', 'bug', 'broken', 'not working', 'timeout', 'integration', 'api', 'sync', 'upload', 'download']],\n];\n\nlet category = 'general';\nconst categorySignals = [];\nfor (const [candidate, signals] of categoryRules) {\n  const matches = signals.filter((signal) => text.includes(signal));\n  if (matches.length && category === 'general') category = candidate;\n  if (matches.length) categorySignals.push(...matches.map((signal) => candidate + ':' + signal));\n}\n\nconst criticalSignals = ['security breach', 'data loss', 'data leak', 'service down', 'site down', 'outage', 'production down'];\nconst highSignals = ['urgent', 'asap', 'cannot access', \"can't access\", 'payment failed', 'deadline today', 'blocked'];\nconst criticalMatches = criticalSignals.filter((signal) => text.includes(signal));\nconst highMatches = highSignals.filter((signal) => text.includes(signal));\n\nlet priority = 'normal';\nif (criticalMatches.length) priority = 'critical';\nelse if (highMatches.length || $json.customer_tier === 'priority') priority = 'high';\nelse if (category === 'sales' || text.includes('question')) priority = 'low';\n\nconst slaHoursByPriority = { critical: 1, high: 4, normal: 12, low: 24 };\nconst slaHours = slaHoursByPriority[priority];\nconst receivedAt = new Date($json.received_at);\nconst slaDueAt = new Date(receivedAt.getTime() + (slaHours * 60 * 60 * 1000)).toISOString();\nconst queueByCategory = {\n  account_access: 'support-on-call',\n  billing: 'billing-queue',\n  sales: 'sales-queue',\n  technical: 'technical-support',\n  general: 'general-support',\n};\n\nconst fingerprint = [$json.requester_email, $json.account_id, subject, message].join('|').toLowerCase();\nlet hash = 2166136261;\nfor (let index = 0; index < fingerprint.length; index += 1) {\n  hash ^= fingerprint.charCodeAt(index);\n  hash = Math.imul(hash, 16777619);\n}\nconst dedupeKey = 'support-' + (hash >>> 0).toString(16).padStart(8, '0');\nconst generatedTicketId = 'TKT-' + receivedAt.toISOString().replace(/[-:.TZ]/g, '').slice(0, 14) + '-' + dedupeKey.slice(-4).toUpperCase();\nconst matchedSignals = [...new Set([...categorySignals, ...criticalMatches, ...highMatches])];\n\nreturn [{\n  json: {\n    ...$json,\n    ticket_id: $json.ticket_id_input || generatedTicketId,\n    dedupe_key: dedupeKey,\n    category,\n    priority,\n    sla_hours: slaHours,\n    sla_due_at: slaDueAt,\n    owner_queue: queueByCategory[category],\n    matched_signals: matchedSignals,\n    requires_human_review: true,\n  },\n}];"
      },
      "typeVersion": 2
    },
