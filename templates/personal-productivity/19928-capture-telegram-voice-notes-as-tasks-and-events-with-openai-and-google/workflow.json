    {
      "id": "ed62d98b-8522-4920-a2c3-418c9a9bc715",
      "name": "Output Parser - Capture",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "position": [
        3712,
        512
      ],
      "parameters": {
        "jsonSchemaExample": "{\n  \"summary\": \"One short sentence describing the note\",\n  \"tasks\": [\n    {\n      \"title\": \"What needs doing\",\n      \"due_date\": \"YYYY-MM-DD or empty\",\n      \"priority\": \"High, Medium or Low\"\n    }\n  ],\n  \"events\": [\n    {\n      \"title\": \"What is happening\",\n      \"start\": \"YYYY-MM-DDTHH:mm:ss\",\n      \"end\": \"YYYY-MM-DDTHH:mm:ss or empty\",\n      \"location\": \"Where, or empty\"\n    }\n  ]\n}"
      },
      "typeVersion": 1.3
    },
    {
      "id": "98951a5e-485b-4e70-8059-0f5155a06670",
      "name": "Build the capture",
      "type": "n8n-nodes-base.code",
      "position": [
        3856,
        272
      ],
      "parameters": {
        "jsCode": "// Normalise the agent output so the rest of the workflow can rely on it.\nconst out = $input.first().json.output || {};\nconst cfg = $('Set config').first().json;\n\nconst tasks = (out.tasks || []).filter(t => t && t.title);\nconst events = (out.events || []).filter(e => e && e.title && e.start);\n\n// Give every event an end time so the calendar node always has one\nconst defaultMinutes = Number(cfg.defaultEventMinutes) || 30;\nfor (const e of events) {\n  if (!e.end) {\n    const start = new Date(e.start);\n    e.end = new Date(start.getTime() + defaultMinutes * 60000).toISOString().slice(0, 19);\n  }\n  e.location = e.location || '';\n}\nfor (const t of tasks) {\n  t.due_date = t.due_date || '';\n  t.priority = t.priority || 'Medium';\n}\n\n// Plain-text confirmation to send back on Telegram\nconst lines = [out.summary || 'Captured your note.', ''];\nif (tasks.length) {\n  lines.push('Tasks saved:');\n  for (const t of tasks) {\n    lines.push('- ' + t.title + (t.due_date ? ' (due ' + t.due_date + ')' : '') + ' [' + t.priority + ']');\n  }\n  lines.push('');\n}\nif (events.length) {\n  lines.push('Events added to your calendar:');\n  for (const e of events) {\n    lines.push('- ' + e.title + ' on ' + e.start.replace('T', ' at ') + (e.location ? ' - ' + e.location : ''));\n  }\n  lines.push('');\n}\nif (!tasks.length && !events.length) {\n  lines.push('Nothing to save from that one. Try naming a task or a time.');\n}\n\nreturn [{\n  json: {\n    summary: out.summary || '',\n    tasks,\n    events,\n    taskCount: tasks.length,\n    eventCount: events.length,\n    confirmation: lines.join('\\n').trim(),\n    sourceType: $('Pull out tasks and events').first().json.sourceType || '',\n    capturedAt: new Date().toISOString(),\n  }\n}];\n"
      },
      "typeVersion": 2
    },
