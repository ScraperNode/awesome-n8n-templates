    {
      "id": "34b361a4-f957-428b-91c4-7c6d0c6b709b",
      "name": "Write today's Short",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "position": [
        -46,
        524
      ],
      "parameters": {
        "text": "={{ 'Niche: ' + $('Channel settings').first().json.niche + '\\nVisual style: ' + $('Channel settings').first().json.style + '\\nLength: ' + $('Channel settings').first().json.seconds + ' seconds\\nTopics already posted (never repeat or paraphrase them):\\n' + ($json.topic || []).filter(Boolean).slice(-60).join('\\n') }}",
        "messages": {
          "messageValues": [
            {
              "message": "You plan faceless YouTube Shorts. Pick ONE surprising, true, specific topic in the niche that is not in the list. Write a Sora 2 prompt for a single shot that fits the length: subject, action, camera, light, sound (ambient sound or a calm narrator saying one striking sentence). No brands, no real people, no text on screen. Then write a caption idea: the fact in one sentence and why it matters, so a social writer can turn it into captions. The YouTube title is under 70 characters and ends with #Shorts."
            }
          ]
        },
        "promptType": "define",
        "hasOutputParser": true
      },
      "typeVersion": 1.7
    },
