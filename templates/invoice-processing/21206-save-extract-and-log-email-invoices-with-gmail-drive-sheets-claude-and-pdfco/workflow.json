    {
      "id": "3246d9f4-49ae-48c9-bc6d-e9098b7ce59e",
      "name": "Build rows",
      "type": "n8n-nodes-base.code",
      "position": [
        4272,
        304
      ],
      "parameters": {
        "jsCode": "// Combine what Claude read from each invoice with the invoice file itself\nconst files = $('Invoice file').all();\nconst out = [];\n\n$input.all().forEach((item, i) => {\n  const texts = [];\n  const walk = (v) => {\n    if (typeof v === 'string') texts.push(v);\n    else if (v && typeof v === 'object') Object.values(v).forEach(walk);\n  };\n  walk(item.json);\n\n  let data = {};\n  for (const t of texts) {\n    const m = t.match(/\\{[\\s\\S]*\\}/);\n    if (!m) continue;\n    try { data = JSON.parse(m[0]); break; } catch (e) {}\n  }\n\n  const file = files[i] ?? files[0];\n  out.push({\n    json: {\n      fileName: file.json.fileName,\n      folderId: file.json.folderId,\n      messageId: file.json.messageId,\n      supplierName: data.supplier_name ?? '',\n      supplierVat: data.supplier_vat ?? '',\n      issueDate: data.issue_date ?? '',\n      amount: data.amount ?? '',\n      currency: data.currency ?? '',\n    },\n    binary: file.binary,\n  });\n});\n\nreturn out;"
      },
      "typeVersion": 2
    },
