      ],
      "parameters": {
        "jsCode": "const value = Number($json.args?.value ?? $json.value);\n\nif (!Number.isFinite(value)) {\n  throw new Error('Invalid VIX value received');\n}\n\nif (value < 0) {\n  throw new Error('VIX value cannot be negative');\n}\n\nreturn [{ json: { ...$json, vix_value: value, validation_status: 'valid' } }];"
      },
