    {
      "id": "2fe434df-7f99-4362-b30a-83bd9a7a416e",
      "name": "Send Whatsapp Using Kapso",
      "type": "n8n-nodes-base.httpRequest",
      "position": [
        2096,
        1168
      ],
      "parameters": {
        "url": "=https://api.kapso.ai/meta/whatsapp/v24.0/{{ $('Config').item.json.KAPSO_PHONE_NUMBER_ID }}/messages",
        "method": "POST",
        "options": {},
        "jsonBody": "={{(() => {\n  const items = $('Sort & Limit').all();\n\n  const products = items.map((item, index) => {\n    const product = item.json;\n\n    const price = new Intl.NumberFormat('id-ID').format(product.price);\n\n    return `\ud83d\uded2 *${product.name}*\n\ud83d\udd17 ${product.url}\n\ud83d\udcb0 Rp ${price}`;\n  });\n\n  const message = `*Daily Competitive Reports*\n\n  ${products.join('\\n\\n')}`;\n\n  const result = {\n    messaging_product: \"whatsapp\",\n    to: $('Get Shopee Data Alerts').item.json.phoneNumber,\n    type: \"text\",\n    text: {\n      body: message,\n    }\n  }\n\n  return JSON.stringify(result)\n})()}}",
        "sendBody": true,
        "sendHeaders": true,
        "specifyBody": "json",
        "headerParameters": {
          "parameters": [
            {
              "name": "X-API-Key",
              "value": "={{ $('Config').item.json.KAPSO_API_KEY }}"
            }
          ]
        }
      },
      "typeVersion": 4.4
    },
