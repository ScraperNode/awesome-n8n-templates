              "id": "bde03024-4207-4055-8069-c3576cce7beb",
              "name": "total",
              "type": "number",
              "value": "={{ $json.data.length }}"
            },
            {
              "id": "61822267-c045-4c97-a868-2d634cd3e25a",
              "name": "averageRating",
              "type": "string",
              "value": "={{ ($json.data.reduce((sum, item) => sum + Number(item.rating || 0), 0) / ($json.data.length || 1)).toFixed(1) }}"
            },
            {
              "id": "cf803100-c77f-47ad-be5d-eef36dd4e8b9",
              "name": "lowCount",
              "type": "number",
              "value": "={{ $json.data.filter(item => item.rating <= 2).length }}"
            },
            {
              "id": "dc1e5523-b22a-4d96-ab1b-5016be12c500",
              "name": "highCount",
              "type": "number",
              "value": "={{ $json.data.filter(item => item.rating >= 4).length }}"
            },
            {
              "id": "bdf0e2ea-01c7-4fc6-bdd9-4e43afe60fc9",
              "name": "worstReview",
              "type": "string",
              "value": "={{ (() => { const w = $json.data.filter(item => item.rating <= 2).sort((a,b) => a.rating - b.rating)[0]; return w ? '\"' + w.title + '\" (' + w.rating + '\u2605 by ' + w.consumer_name + ')' : 'None'; })() }}"
            }
          ]
        }
      },
      "typeVersion": 3.4
    },
