    {
      "id": "f20c9d74-bf0d-4059-8f37-bb491149fcb0",
      "name": "Check call was missed and caller allowed",
      "type": "n8n-nodes-base.code",
      "position": [
        440,
        0
      ],
      "parameters": {
        "jsCode": "const body = $('Twilio missed-call webhook').first().json.body || {};\nconst status = String(body.DialCallStatus || body.CallStatus || '').toLowerCase();\nconst caller = body.From || '';\nconst sd = $getWorkflowStaticData('global'); sd.optOut = sd.optOut || [];\nreturn [{ json: { caller, status,\n  missed: ['no-answer','busy','failed','canceled'].includes(status),\n  allowed: caller.startsWith('+') && !sd.optOut.includes(caller) } }];"
      },
      "typeVersion": 2
    },
    {
      "id": "e35c22af-32da-4ce4-832d-439ee75a357d",
      "name": "Missed and allowed?",
      "type": "n8n-nodes-base.if",
