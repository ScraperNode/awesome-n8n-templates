    {
      "id": "7e19b2a7-9e41-4bc7-af31-cc0314b0cef3",
      "name": "Parse WhatsApp Message",
      "type": "n8n-nodes-base.code",
      "position": [
        2080,
        112
      ],
      "parameters": {
        "jsCode": "for (const { json: j } of $input.all()) {\n  const v = j.value || j.entry?.[0]?.changes?.[0]?.value || j;\n  const m = (v.messages || [])[0]; if (!m) continue;\n  const text = m.text?.body || m.button?.text || m.interactive?.button_reply?.title || m.interactive?.list_reply?.title || '';\n  const phone = String(m.from).replace(/\\D/g, '');\n  return [{ json: { phone, phone_e164: '+' + phone, name: (v.contacts || [])[0]?.profile?.name || '', type: m.type,\n    text: text.slice(0, 1000), supported: !!text, message_id: m.id, received_at: new Date().toISOString() } }];\n}\nreturn [];"
      },
      "typeVersion": 2
    },
