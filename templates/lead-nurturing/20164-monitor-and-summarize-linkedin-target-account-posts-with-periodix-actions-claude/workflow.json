    {
      "id": "09508b90-6bc2-43a3-ad3a-69672516f96e",
      "name": "Claude: Summarize and Suggest",
      "type": "n8n-nodes-base.httpRequest",
      "onError": "continueRegularOutput",
      "position": [
        3392,
        352
      ],
      "parameters": {
        "url": "https://api.anthropic.com/v1/messages",
        "method": "POST",
        "options": {
          "batching": {
            "batch": {
              "batchSize": 1
            }
          }
        },
        "jsonBody": "={{ JSON.stringify({ model: \"claude-haiku-4-5-20251001\", max_tokens: 400, messages: [{ role: \"user\", content: \"A target account just posted on LinkedIn. Help a seller act on it.\\n\\nWhat we sell: \" + $(\"Monitor Config\").first().json.what_we_sell + \"\\n\\nAccount: \" + $json.account_name + \"\\nPost: \" + $json.text + \"\\n\\nReturn ONLY raw JSON, no markdown: {\\\"summary\\\": \\\"one sentence\\\", \\\"relevance\\\": 7, \\\"why\\\": \\\"one sentence on why it matters for us\\\", \\\"comment_angle\\\": \\\"a genuine, specific comment idea, no pitch\\\", \\\"dm_opener\\\": \\\"one-sentence message opener that references the post\\\"}. relevance is 1 to 10 for how useful this post is as a reason to engage.\" }] }) }}",
        "sendBody": true,
        "sendHeaders": true,
        "specifyBody": "json",
        "authentication": "predefinedCredentialType",
        "headerParameters": {
          "parameters": [
            {
              "name": "anthropic-version",
              "value": "2023-06-01"
            },
            {
              "name": "content-type",
              "value": "application/json"
            }
          ]
        },
        "nodeCredentialType": "anthropicApi"
      },
      "credentials": {
        "anthropicApi": {
          "id": "zZ8eNfLyxGyScmPv",
          "name": "Anthropic account"
        }
      },
      "retryOnFail": true,
      "typeVersion": 4.4
    },
    {
      "id": "e448728f-1fcf-4c3e-a7ef-99c22639ea3f",
      "name": "Parse Insight",
      "type": "n8n-nodes-base.code",
      "position": [
        3616,
        352
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const post = $('Keep New Posts').item.json;\nlet r = { summary: '', relevance: 0, why: 'parse error', comment_angle: '', dm_opener: '' };\ntry {\n  let raw = $json.content?.[0]?.text || '{}';\n  raw = raw.trim().replace(/^```(?:json)?\\s*/i, '').replace(/```\\s*$/i, '').trim();\n  r = { ...r, ...JSON.parse(raw) };\n} catch (e) {}\nconst slack = `*${post.account_name}* posted on LinkedIn (relevance ${r.relevance}/10)\\n${r.summary}\\n_Why it matters:_ ${r.why}\\n_Comment idea:_ ${r.comment_angle}\\n_DM opener:_ ${r.dm_opener}\\n${post.post_url}`;\nreturn { json: { ...post, text: post.text.slice(0, 500), summary: r.summary, relevance: r.relevance, why: r.why, comment_angle: r.comment_angle, dm_opener: r.dm_opener, slack_text: slack, found_at: new Date().toISOString() } };"
      },
      "typeVersion": 2
    },
