      "name": "Prepare Ticket Data",
      "type": "n8n-nodes-base.code",
      "position": [
        1184,
        -416
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const info = $input.item.json;\n\nreturn {\n  json: {\n    ticket_id: 'RPR-' + $now.toFormat('yyyyLLdd-HHmmss'),\n    submitted_at: $now.toISO(),\n    photo_format: info.format || 'unknown',\n    photo_dimensions: info.size ? `${info.size.width}x${info.size.height}` : 'unknown'\n  },\n  binary: $('Rebuild Photo Binary Data').item.binary\n};"
      },
      "typeVersion": 2
    },
