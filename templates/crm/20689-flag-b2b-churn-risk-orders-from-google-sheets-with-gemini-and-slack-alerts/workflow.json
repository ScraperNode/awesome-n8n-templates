    {
      "id": "8bf74a00-40f3-4488-8cb8-2e483fdc280d",
      "name": "Parse Structured Analysis",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "position": [
        -240,
        -848
      ],
      "parameters": {
        "jsonSchemaExample": "{\n  \"risk_tier\": \"HIGH\",\n  \"primary_hypothesis\": \"Dual-sourcing / competitor deflection\",\n  \"buyer_behavior_mode\": \"CORE_SKU_WITHDRAWAL\",\n  \"recommended_playbook\": [\n    \"Ask whether SKU-A demand has shifted to another approved supplier or specification.\",\n    \"Confirm whether the reduced order reflects temporary inventory coverage or a permanent sourcing change.\"\n  ]\n}"
      },
      "typeVersion": 1.2
    },
    {
      "id": "7ffdaf80-79c1-4566-b5a0-98874ba0c5a0",
      "name": "Build Incident Alerts",
      "type": "n8n-nodes-base.code",
      "position": [
        -64,
        -1088
      ],
      "parameters": {
        "jsCode": "// Reference the enriched order data that includes the computed stats\nconst original = $('Check Alert Cooldown').item.json;\nconst ai = $json.output || {};\nconst stats = original.stats || {};\n\n// Fallback handling to protect against missing arrays\nconst missingSkus = Array.isArray(stats.missing_core_skus) ? stats.missing_core_skus : [];\nconst playbook = Array.isArray(ai.recommended_playbook) ? ai.recommended_playbook : [];\n\nconst alertCard = {\n  blocks: [\n    {\n      type: 'header',\n      text: {\n        type: 'plain_text',\n        text: `\ud83d\udea8 Churn Risk Alert: ${original.account_name || 'Unknown Account'} [${ai.risk_tier || 'HIGH'}]`,\n        emoji: true\n      }\n    },\n    {\n      type: 'section',\n      fields: [\n        {\n          type: 'mrkdwn',\n          text: `*Account Tier:* ${original.account_tier || 'N/A'}`\n        },\n        {\n          type: 'mrkdwn',\n          text: `*ARR Exposure:* $${Number(original.arr_usd || 0).toLocaleString()}`\n        },\n        {\n          type: 'mrkdwn',\n          text: `*Volume Shift:* ${stats.actual_units ?? 0} units (Baseline: ${stats.baseline_mean_units ?? 0})`\n        },\n        {\n          type: 'mrkdwn',\n          text: `*Run-Rate Drop:* ${Math.round((1 - (stats.volume_ratio ?? 0)) * 100)}% collapse`\n        }\n      ]\n    },\n    {\n      type: 'section',\n      text: {\n        type: 'mrkdwn',\n        text: `*Diagnostic Hypothesis:*\\n${ai.primary_hypothesis || 'Unexpected divergence from ordering envelope.'}`\n      }\n    },\n    {\n      type: 'section',\n      text: {\n        type: 'mrkdwn',\n        text: `*Behavioral Mode:* \\`${ai.buyer_behavior_mode || 'UNKNOWN'}\\`\\n*Missing Core Lines:* ${missingSkus.length > 0 ? missingSkus.join(', ') : 'None'}`\n      }\n    },\n    {\n      type: 'section',\n      text: {\n        type: 'mrkdwn',\n        text: `*Recommended Tactical Play:*\\n\u2022 ${playbook.length > 0 ? playbook.join('\\n\u2022 ') : 'No playbooks suggested'}`\n      }\n    }\n  ]\n};\n\nreturn {\n  json: {\n    ...original,\n    ai_analysis: ai,\n    slack_payload: alertCard,\n    alert_timestamp: new Date().toISOString()\n  }\n};"
      },
      "typeVersion": 2
    },
