        "text": "=:rotating_light: *Review needs approval* (priority: *{{ $('Build Review Record').first().json.priority }}*)\n*Customer:* {{ $('Build Review Record').first().json.customer_name }}   *Rating:* {{ $('Build Review Record').first().json.rating }}/5   *Sentiment:* {{ $('Build Review Record').first().json.sentiment }}\n*Review:*\n> {{ $('Build Review Record').first().json.review_text }}\n*Why escalated:* {{ $('Build Review Record').first().json.escalation_reason }}\n*Proposed response:*\n{{ $('Build Review Record').first().json.ai_response }}\n\n<{{ $execution.resumeUrl }}?decision=approve|:white_check_mark: Approve and publish>    |    <{{ $execution.resumeUrl }}?decision=reject|:x: Reject>",
        "select": "channel",
        "channelId": {
