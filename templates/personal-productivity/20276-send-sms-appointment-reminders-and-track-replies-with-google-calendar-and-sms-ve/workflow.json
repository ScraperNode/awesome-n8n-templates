    {
      "id": "4147760f-3a3f-45f3-b3e5-a986ab1fb51c",
      "name": "Read the reply",
      "type": "n8n-nodes-base.code",
      "position": [
        1680,
        200
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Reads the client's latest reply (and the delivery status), then decides how to update the appointment\nconst s = $('Settings').first().json;\nconst appointment = $('Sort appointments').item.json;\nconst report = $('Get delivery report').item.json.structuredContent || {};\nconst replies = ($json.structuredContent && $json.structuredContent.responses) || [];\n\nconst clean = (t) => String(t || '').normalize('NFD').replace(/[\u0300-\u036f]/g, '').toUpperCase().replace(/[^A-Z0-9]+/g, ' ').trim();\nconst wordList = (list) => String(list || '').split(',').map(clean).filter(Boolean);\nconst lastDigits = (p) => String(p || '').replace(/\\D/g, '').slice(-9);\n\n// Latest reply sent by the client to this reminder\nconst fromClient = replies\n  .filter(r => !appointment.phone || lastDigits(r.gsm) === lastDigits(appointment.phone))\n  .sort((a, b) => String(a.date).localeCompare(String(b.date)));\nconst last = fromClient[fromClient.length - 1];\n\nlet answer = 'none';\nlet replyText = '';\nlet replyDate = '';\nlet deliveryStatus = '';\nif (last) {\n  replyText = String(last.text || '').replace(/\\s+/g, ' ').trim();\n  replyDate = String(last.date || '').slice(0, 16);\n  const firstWord = clean(replyText).split(' ')[0];\n  if (wordList(s.yes_words).includes(firstWord)) answer = 'confirmed';\n  else if (wordList(s.no_words).includes(firstWord)) answer = 'cancelled';\n  else if (!appointment.description_prefix.includes('[SMS reply ' + replyDate)) answer = 'other';\n} else {\n  // No reply yet: flag the reminders that never reached the client\n  const sms = ((report.campaigns || [])[0] || {}).sms || [];\n  deliveryStatus = sms.length ? String(sms[0].status || '') : '';\n  if (['UNDELIVERABLE', 'EXPIRED', 'REJECTED'].includes(deliveryStatus)) answer = 'not_delivered';\n}\n\nreturn { json: { ...appointment, answer, reply_text: replyText, reply_date: replyDate, delivery_status: deliveryStatus } };"
      },
      "typeVersion": 2
    },
