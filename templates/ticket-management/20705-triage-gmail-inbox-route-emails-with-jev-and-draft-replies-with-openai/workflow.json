        },
        "routes": {
          "route": [
            {
              "name": "Sales",
              "description": "New business: pricing questions, quote requests, demos, purchase intent, upgrades from prospects or customers"
            },
            {
              "name": "Support",
              "description": "An existing customer needs help: bugs, access problems, how-to questions, something not working"
            },
            {
              "name": "Billing",
              "description": "Invoices, payments, refunds, failed charges, receipts, subscription changes or cancellations"
            },
            {
              "name": "Partnerships",
              "description": "Collaboration, sponsorship, affiliate, media, reseller or integration proposals from another company or creator"
            },
            {
              "name": "Newsletters",
              "description": "Newsletters, product updates, automated notifications or digests that nobody needs to answer"
            },
            {
              "name": "Spam",
              "description": "Unsolicited cold outreach, phishing, scams or irrelevant mass mailing"
            }
          ]
        },
        "options": {},
        "operation": "route",
        "stateText": "={{ $('Extract email fields').item.json.email_state }}",
        "routeInstructions": "Which team should handle this email?",
        "confidenceHandling": "separateOutput",
        "confidenceThreshold": "={{ $('Configuration').item.json.route_confidence_threshold }}"
      },
      "credentials": {
        "typeSafeAiApi": {
          "id": "ylPmolioj287ii5y",
          "name": "TypeSafe AI account"
        }
      },
      "retryOnFail": true,
      "typeVersion": 1,
      "waitBetweenTries": 5000
    },
