    {
      "id": "1fb12d74-6798-4f09-9f7b-76ef18ea8413",
      "name": "Match Client to Meeting",
      "type": "n8n-nodes-base.code",
      "position": [
        1456,
        288
      ],
      "parameters": {
        "jsCode": "// Match the meeting to a client and skip sessions already processed\nconst rec = $('Extract Recording Details').first().json;\nconst clients = $('Read Clients').all().map(i => i.json);\nconst logged = new Set($input.all().map(i => String(i.json['Session ID'] || '')));\nif (logged.has(String(rec.meetingUuid))) return [];\n\nconst norm = s => String(s || '').replace(/\\s+/g, '').toLowerCase();\nconst topic = String(rec.topic || '').toLowerCase();\nconst byId = clients.find(c => norm(c['Zoom Meeting ID']) && norm(c['Zoom Meeting ID']) === norm(rec.meetingId));\nconst byName = clients.find(c => c['Client Name'] && topic.includes(String(c['Client Name']).toLowerCase()));\nconst c = byId || byName;\nif (!c) return [];\nif (String(c['Status'] || '').toLowerCase().trim() === 'inactive') return [];\n\nreturn [{\n  json: {\n    ...rec,\n    clientId: c['Client ID'],\n    clientName: c['Client Name'],\n    clientEmail: c['Client Email'],\n    coachEmail: c['Coach Email'] || '',\n    goals: c['Goals'] || 'Not specified',\n    sessionDate: String(rec.startTime).slice(0, 10),\n  },\n}];"
      },
      "typeVersion": 2
    },
