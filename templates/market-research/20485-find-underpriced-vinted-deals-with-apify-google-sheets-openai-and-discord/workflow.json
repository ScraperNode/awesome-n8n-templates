      ],
      "parameters": {
        "jsCode": "const rows = $input.all().map(i => i.json);\nconst yesterday = DateTime.now().minus({ days: 1 });\n\nconst recent = rows.filter(r => r.checkedAt && DateTime.fromISO(r.checkedAt).isValid\n  && DateTime.fromISO(r.checkedAt) >= yesterday);\n\nconst byChannel = {};\nfor (const r of recent) {\n  const key = r.discordWebhook || 'unknown';\n  byChannel[key] = byChannel[key] || [];\n  byChannel[key].push(r);\n}\n\nreturn Object.entries(byChannel).map(([discordWebhook, items]) => {\n  const lines = items.map(r =>\n    `- **${r.title}** - \\u20ac${r.priceEur} (median \\u20ac${r.medianPriceEur}, score ${r.dealScorePct}) ${r.url}`\n  );\n  return {\n    json: {\n      discordWebhook,\n      content: `\\ud83d\\udccb Daily Vinted digest - ${items.length} good deal(s):\\n` + lines.join('\\n')\n    }\n  };\n});"
      },
      "typeVersion": 2
    },
