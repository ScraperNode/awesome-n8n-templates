    {
      "id": "ebab2f1c-7c45-4f68-8665-e401867110e5",
      "name": "ISCP score",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "position": [
        3520,
        560
      ],
      "parameters": {
        "text": "=Based on my offer and the company's report, determine the ISP Score (Ideal Service Profile).\nEvaluate how well my offer aligns with the company's needs, business model, and operations.\nStart your response with one of the following labels: High Match, Medium Match, or Low Match.\nThen provide a short summary explaining why this match level was assigned, based on how well my offer aligns with the company\u2019s needs, business model, and operations.\nKeep the explanation concise and focused.\n\nMy offer:'{{ $json.content }}'\nCompany report:'{{ $('Generate report').item.json.text }}'",
        "batching": {},
        "messages": {
          "messageValues": [
            {
              "message": "You are a professional business analyst specializing in offer-to-company fit evaluation. Your task is to assess how well a provided offer aligns with a company's profile, using a report containing information about the company's needs, business model, and operations.  Use the ISP (Ideal Service Profile) scoring system to evaluate the match. Start every response with one of the following labels (and nothing else before it): High Match, Medium Match, or Low Match.  After the label, provide a short and clear explanation (1\u20133 sentences) justifying your decision. Be objective, concise, and focused only on the business alignment \u2014 do not include any extra commentary, formatting, or disclaimers."
            }
          ]
        },
        "promptType": "define",
        "hasOutputParser": true
      },
      "typeVersion": 1.7
    },
