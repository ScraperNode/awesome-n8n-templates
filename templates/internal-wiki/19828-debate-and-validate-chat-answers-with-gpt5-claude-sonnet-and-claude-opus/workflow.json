    },
    {
      "id": "4d77555b-0bbd-4988-ba14-40424a6817dd",
      "name": "Cycles left?",
      "type": "n8n-nodes-base.if",
      "position": [
        780,
        -200
      ],
      "parameters": {
        "options": {},
        "conditions": {
          "options": {
            "version": 2,
            "leftValue": "",
            "caseSensitive": true,
            "typeValidation": "loose"
          },
          "combinator": "and",
          "conditions": [
            {
              "id": "c4",
              "operator": {
                "type": "number",
                "operation": "lt"
              },
              "leftValue": "={{ $json.cycle }}",
              "rightValue": "={{ $json.maxCycles }}"
            }
          ]
        },
        "looseTypeValidation": true
      },
      "typeVersion": 2.2
    },
    {
      "id": "a71ea0d5-9255-4f79-9844-111e78be27ab",
      "name": "Add judge feedback",
      "type": "n8n-nodes-base.code",
      "position": [
        560,
        -200
      ],
      "parameters": {
        "jsCode": "const s = $input.first().json;\nlet feedback = 'The judge rejected the previous answer. Reason: ' + (s.reason || 'not given');\nif (s.finalAnswer) feedback += '\\nJudge suggestion:\\n' + s.finalAnswer;\n// New cycle: reset the round counter so the reviewer gets a full set of rounds again\nreturn [{ json: { ...s, cycle: s.cycle + 1, round: 1, feedback } }];"
      },
      "typeVersion": 2
    },
    {
      "id": "8c78724c-5f90-477c-abd4-a28edc513949",
      "name": "Reply: approved",
      "type": "n8n-nodes-base.set",
      "position": [
        1040,
        64
      ],
      "parameters": {
        "options": {},
        "assignments": {
          "assignments": [
            {
              "id": "o1",
              "name": "output",
              "type": "string",
              "value": "={{ $json.finalAnswer || $json.debaterAnswer }}\n\n---\nApproved by the judge in round {{ $json.round }} of cycle {{ $json.cycle }}."
            }
          ]
        }
      },
      "typeVersion": 3.4
    },
    {
      "id": "54996550-8edb-4697-a499-d881d7b58dd6",
      "name": "Reply: no consensus",
      "type": "n8n-nodes-base.set",
      "position": [
        1040,
        -200
      ],
      "parameters": {
        "options": {},
        "assignments": {
          "assignments": [
            {
              "id": "o2",
              "name": "output",
              "type": "string",
              "value": "={{ $json.finalAnswer || $json.debaterAnswer }}\n\n---\nNo consensus after {{ $json.cycle }} judge cycles. {{ $json.finalAnswer ? 'Above is the judge\\'s corrected answer.' : 'Above is the last Debater answer.' }}\nJudge note: {{ $json.reason }}"
            }
          ]
        }
      },
      "typeVersion": 3.4
    }
  ],
