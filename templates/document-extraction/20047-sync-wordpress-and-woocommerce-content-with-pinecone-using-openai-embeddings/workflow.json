    {
      "id": "45482502-b356-4bd4-aaae-84f842c68f86",
      "name": "Format Static Content",
      "type": "n8n-nodes-base.code",
      "position": [
        2336,
        4576
      ],
      "parameters": {
        "jsCode": "function stripHtml(html) {\n  if (!html) return '';\n  const cp = (n) => { try { return String.fromCodePoint(n); } catch (e) { return ''; } };\n  return String(html)\n    .replace(/<!--[\\s\\S]*?-->/g, ' ')\n    .replace(/<(script|style)[\\s\\S]*?<\\/\\1>/gi, ' ')\n    .replace(/<br\\s*\\/?>/gi, ' ')\n    .replace(/<\\/?(p|div|li|ul|ol|h[1-6]|tr|td|th|table|blockquote|section|article|figure|figcaption)(\\s[^>]*)?>/gi, ' ')\n    .replace(/<[^>]+>/g, '')\n    .replace(/&nbsp;/g, ' ')\n    .replace(/&lt;/g, '<')\n    .replace(/&gt;/g, '>')\n    .replace(/&quot;/g, '\"')\n    .replace(/&#(\\d+);/g, (m, n) => cp(Number(n)))\n    .replace(/&#x([0-9a-f]+);/gi, (m, h) => cp(parseInt(h, 16)))\n    .replace(/&amp;/g, '&')\n    .replace(/\\s+/g, ' ')\n    .trim();\n}\nconst p = $json;\nconst content = 'Title: ' + (p.title || '') + '\\n' + stripHtml(p.content);\nreturn [{ json: {\n  content: content,\n  title: p.title || '',\n  source: p.link || '',\n  fileId: 'wc_' + p.kind + '_' + p.id,\n  objectId: (p.kind + '_' + p.id),\n  dateModified: p.modified,\n  docType: p.kind,\n  link: p.link || '',\n  entity: 'document',\n  price: '',\n  currency: '',\n  quantity: '',\n  productCode: '',\n  image: ''\n} }];"
      },
      "typeVersion": 2
    },
