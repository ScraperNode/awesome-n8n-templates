    {
      "id": "8bb3aa50-13e4-4e7d-af19-77409f35e7db",
      "name": "Extract Page Text",
      "type": "n8n-nodes-base.code",
      "position": [
        -540,
        200
      ],
      "parameters": {
        "jsCode": "const html = $input.first().json.data || '';\nconst pick = (re) => (html.match(re) || [])[1] || '';\nconst title = pick(/<meta[^>]+property=[\"']og:title[\"'][^>]+content=[\"']([^\"']+)/i) || pick(/<title[^>]*>([^<]*)<\\/title>/i);\nconst description = pick(/<meta[^>]+(?:name|property)=[\"'](?:og:)?description[\"'][^>]+content=[\"']([^\"']+)/i);\nconst image = pick(/<meta[^>]+property=[\"']og:image[\"'][^>]+content=[\"']([^\"']+)/i);\nconst text = html.replace(/<script[\\s\\S]*?<\\/script>|<style[\\s\\S]*?<\\/style>/gi, ' ').replace(/<[^>]+>/g, ' ').replace(/\\s+/g, ' ').trim().slice(0, 6000);\nreturn [{ json: { title, description, image, text, product_url: $('Settings').first().json.product_url } }];"
      },
      "typeVersion": 2
    },
    {
      "id": "997706da-1d9b-4c05-9e5f-9809e929face",
      "name": "Write Hook And Script",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "position": [
        -320,
        200
      ],
      "parameters": {
        "text": "=You are a UGC ad scriptwriter. From the product page below, write a short vertical video ad.\nReturn:\n- hook: a scroll-stopping first line (max 12 words)\n- script: a 3-sentence voiceover-style script in a casual first-person UGC tone\n- caption: an Instagram caption with up to 5 hashtags\n- prompts: exactly 3 different visual prompts (max 60 words each) for a 5 second 9:16 video, each a different angle (unboxing, in-use close-up, lifestyle). No on-screen text.\n\nTitle: {{ $json.title }}\nDescription: {{ $json.description }}\nPage text: {{ $json.text }}",
        "promptType": "define",
        "hasOutputParser": true
      },
      "typeVersion": 1.5
    },
