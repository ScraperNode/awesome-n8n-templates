    {
      "id": "65ea08d6-2533-43ba-976e-6595ea868743",
      "name": "Move it into the month folder",
      "type": "n8n-nodes-base.httpRequest",
      "notes": "A spreadsheet made through the Sheets API lands in My Drive root, so it is moved into the month folder here.\nThis replaces the Apps Script web app the earlier version needed.",
