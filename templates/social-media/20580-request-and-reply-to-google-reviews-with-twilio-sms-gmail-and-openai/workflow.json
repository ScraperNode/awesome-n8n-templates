      },
      "typeVersion": 1
    },
    {
      "id": "b0cc2fae-b0c8-4cad-a413-c820c696efd5",
      "name": "Schedule - Daily 6PM",
      "type": "n8n-nodes-base.scheduleTrigger",
      "position": [
        0,
        420
