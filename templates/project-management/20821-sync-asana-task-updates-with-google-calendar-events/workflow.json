      "parameters": {
        "rules": {
          "values": [
            {
              "outputKey": "Name Updated",
              "conditions": {
                "options": {
                  "version": 3,
                  "leftValue": "",
                  "caseSensitive": true,
                  "typeValidation": "strict"
                },
                "combinator": "and",
                "conditions": [
                  {
                    "id": "ef447678-b090-4538-9758-ae24d8bd0347",
