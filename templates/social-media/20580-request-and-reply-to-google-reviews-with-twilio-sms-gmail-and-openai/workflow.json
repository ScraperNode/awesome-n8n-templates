    {
      "id": "a89b1329-d9e1-43d7-9286-cc6a3170ea2a",
      "name": "Get Last Check - Code",
      "type": "n8n-nodes-base.code",
      "position": [
        260,
        1000
      ],
      "parameters": {
        "jsCode": "// State sheet holds one row per run: { last_check }. Use the newest.\nconst rows = $('Read State - Sheets').all().map(i => i.json);\nconst last = rows.length ? rows[rows.length - 1].last_check : null;\nreturn [{ json: { last_check: last || new Date(0).toISOString() } }];"
      },
      "typeVersion": 2
    },
    {
      "id": "555584a0-a7a7-4004-8b64-0184de3a2f74",
      "name": "Read State - Sheets",
