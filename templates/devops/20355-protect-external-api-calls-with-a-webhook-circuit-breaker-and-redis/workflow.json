    {
      "id": "ccbcb87b-824f-489b-8adf-fe396c2e870f",
      "name": "JS - Build Success Response",
      "type": "n8n-nodes-base.code",
      "position": [
        3216,
        656
      ],
      "parameters": {
        "jsCode": "const ctx = $('JS - Classify Outcome').first().json;\n\nreturn [{\n  json: {\n    success: true,\n    service: ctx.serviceName,\n    circuitState: ctx.wasProbe ? 'CLOSED' : ctx.breakerState,\n    recovered: ctx.wasProbe,\n    upstream: {\n      status: ctx.upstreamStatus,\n      data: ctx.upstreamBody\n    }\n  }\n}];"
      },
      "typeVersion": 2
    },
    {
