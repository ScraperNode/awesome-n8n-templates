    {
      "id": "5dfa0bbd-eedd-4532-bd24-1b5c45f87d91",
      "name": "Restore Image Binary",
      "type": "n8n-nodes-base.code",
      "position": [
        1376,
        640
      ],
      "parameters": {
        "jsCode": "const formBinary = $('Form Trigger: Claim Intake').first().binary;\nconst binaryData = formBinary?.data;\nif (!binaryData) {\n  throw new Error(\"No binary data found under the field 'data' from the intake form.\");\n}\nreturn [{ json: { ...$json }, binary: { data: binaryData } }];"
      },
      "typeVersion": 2
    },
    {
      "id": "43132418-d127-46c0-8ac1-829bb1f3bd2d",
      "name": "Assess Visit with AI",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "position": [
        1600,
        640
      ],
      "parameters": {
        "text": "=Client: {{ $('Set Dispatch Details').item.json.client_name }}\nAccident Location: {{ $('Set Dispatch Details').item.json['Accident Location'] }}\nPolicy Plan: {{$('Set Dispatch Details').item.json.plan_type }}\nReported issue: {{$('Set Dispatch Details').item.json.reported_issue }}\n\nAnalyze the attached image and reported warranty issue to prepare field tech instructions. Keep the policy plan in mind.\n\nRespond strictly in the schema format:\n- requires_visit: true or false\n- priority: 'CRITICAL', 'HIGH', 'MEDIUM', or 'LOW'\n- recommended_specialist: specific trade needed (e.g., Electrician, HVAC Tech, Structural Inspector, Plumber)\n- tools_needed: brief comma-separated list of diagnostic tools/equipment to bring\n- tech_brief: ONE concise sentence summarizing what the technician should inspect on-site",
        "options": {
          "passthroughBinaryPdfs": true
        },
        "promptType": "define",
        "hasOutputParser": true
      },
      "typeVersion": 3.1
    },
    {
      "id": "86f1fe10-ae6c-44a9-9ce3-e80587cb788d",
      "name": "Prepare Dispatch Notification",
      "type": "n8n-nodes-base.code",
      "position": [
        1984,
        640
      ],
      "parameters": {
        "jsCode": "const priority = $json.output.priority;\nconst priEmoji = priority === 'CRITICAL' ? '\ud83d\udea8 CRITICAL'\n  : priority === 'HIGH' ? '\ud83d\udd34 HIGH'\n  : priority === 'MEDIUM' ? '\ud83d\udfe1 MEDIUM'\n  : '\ud83d\udfe2 LOW';\n\nconst dispatchId = $('Set Dispatch Details').item.json.dispatch_id;\nconst clientName =$('Set Dispatch Details').item.json.client_name;\nconst clientPhone = $('Set Dispatch Details').item.json.client_phone;\nconst siteAddress =$('Set Dispatch Details').item.json.site_address;\nconst policyNum = $('Set Dispatch Details').item.json.policy_number;\nconst planType =$('Set Dispatch Details').item.json.plan_type;\nconst specialist = $json.output.recommended_specialist;\nconst tools =$json.output.tools_needed;\nconst brief = $json.output.tech_brief;\nconst authStatus =$('Calculate Authenticity Score').item.json.authenticity_status;\n\nconst dispatchMessage = `\ud83d\ude90 *New Field Visit Requested*\\n\\n*Dispatch ID:* \\`${dispatchId}\\`\\n*Priority:* ${priEmoji}\\n*Policy:* ${policyNum} (${planType})\\n*Client:* ${clientName} (\ud83d\udcde ${clientPhone})\\n*Location:* ${siteAddress}\\n\\n*Required Specialist:* ${specialist}\\n*Suggested Equipment:* ${tools}\\n\\n\ud83d\udccb *Technician Brief:*\\n${brief}\\n\\n*Authenticity Check:* ${authStatus}`;\n\nreturn [{\n  json: {\n    ...$json,\n    pri_emoji: priEmoji,\n    dispatch_message: dispatchMessage\n  }\n}];"
      },
      "typeVersion": 2
    },
