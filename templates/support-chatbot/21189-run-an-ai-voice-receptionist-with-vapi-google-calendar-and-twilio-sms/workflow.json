    {
      "id": "75add38d-bc60-47a6-8dc3-74d36f5d2825",
      "name": "Parse Vapi",
      "type": "n8n-nodes-base.code",
      "position": [
        -656,
        1200
      ],
      "parameters": {
        "jsCode": "// CHANGE ME: country code added when a caller's number starts with a single 0 (e.g. '+44' for UK)\nconst DEFAULT_COUNTRY_CODE = '+1';\nconst body = $input.first().json.body || {};\nconst msg = body.message || {};\nconst tc = (msg.toolCallList || msg.toolCalls || [])[0];\nif (!tc) return [{ json: { toolCallId: '', name: 'none', args: {} } }];\nlet a = tc.arguments || (tc.function && tc.function.arguments) || {};\nif (typeof a === 'string') a = JSON.parse(a);\nconst name = tc.name || (tc.function && tc.function.name);\nlet p = String(a.phone || '').replace(/[\\s\\-()]/g, '');\nif (p.startsWith('00')) p = '+' + p.slice(2);\nelse if (p.startsWith('0')) p = DEFAULT_COUNTRY_CODE + p.slice(1);\nelse if (p && !p.startsWith('+')) p = '+' + p;\na.phone = p;\nreturn [{ json: { toolCallId: tc.id, name, args: a } }];\n"
      },
      "typeVersion": 2
    },
