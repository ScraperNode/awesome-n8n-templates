        "resource": "video",
        "returnAs": "video",
        "operation": "generate"
      },
      "typeVersion": 1.2
    },
    {
      "id": "d2c68efc-f4e5-46a4-aea5-4b014e97b1c4",
      "name": "Post to TikTok, Reels and Shorts",
      "type": "n8n-nodes-postwire.postWire",
      "onError": "continueRegularOutput",
      "position": [
        300,
        552
      ],
      "parameters": {
        "prompt": "={{ (() => { const b = $('Build the brief').item.json; return 'New in the shop: ' + b.product + '. ' + (b.plan.selling_point || '') + (b.price ? ' Price: ' + b.price + '.' : '') + ' ' + b.product_url; })() }}",
        "options": {
          "title": "={{ String($('Build the brief').item.json.product).slice(0, 80) + ' #Shorts' }}",
          "privacy": "public",
          "mediaType": "video",
          "idempotencyKey": "={{ 'shopify-video-' + $('Build the brief').item.json.product_id }}"
        },
        "resource": "post",
        "operation": "publish",
        "platforms": [
          "tiktok",
          "instagram",
          "youtube"
        ],
        "contentMode": "smart",
        "mediaSource": "binary",
        "binaryPropertyName": "data"
      },
      "typeVersion": 2
    },
