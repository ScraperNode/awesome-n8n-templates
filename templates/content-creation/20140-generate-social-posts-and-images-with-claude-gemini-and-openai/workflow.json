    {
      "id": "d80db3a2-96ef-4dd6-afa2-6220a9b5f8d5",
      "name": "Generate Social Content (Claude)",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "onError": "continueErrorOutput",
      "position": [
        1104,
        128
      ],
      "parameters": {
        "text": "=Topic: {{ $json.topic }}\n\nContext:\n{{ $json.context }}\n\nTone: {{ $json.tone }}\nTarget audience: {{ $json.audience }}\nBrand / author: {{ $json.brand }}\nCall to action (optional): {{ $json.cta }}\nLanguage: {{ $json.language }}\n\nGenerate the content for all four platforms.",
        "messages": {
          "messageValues": [
            {
              "message": "You are a senior social media strategist and copywriter. You turn one topic plus supporting context into platform-native posts for LinkedIn, X (Twitter), Facebook and Instagram.\n\nRules:\n- Write natively for each platform; never paste the same text everywhere.\n- LinkedIn: strong 1-2 line hook, short paragraphs, practical insight, clear CTA or question at the end. 150-250 words. 3-5 hashtags.\n- X: one standalone post of max 280 characters AND a 4-7 tweet thread, each tweet max 280 characters, first tweet is the hook. Max 2 hashtags.\n- Facebook: conversational, 60-120 words, ends with an engagement question. 2-3 hashtags.\n- Instagram: caption with a hook in the first line, line breaks, emojis used sparingly, CTA. 8-15 relevant hashtags. Also suggest one image/visual idea.\n- Only use facts from the provided context. Do not invent statistics, names, quotes or links.\n- Hashtags must include the # symbol and contain no spaces.\n- Return ONLY the structured output requested."
            }
          ]
        },
        "promptType": "define",
        "hasOutputParser": true
      },
      "typeVersion": 1.5
    },
