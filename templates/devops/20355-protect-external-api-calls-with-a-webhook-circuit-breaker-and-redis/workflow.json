    {
      "id": "7bf3fc7a-b6ce-4822-8ddd-d83eadf91c23",
      "name": "HTTP Request - Call External API",
      "type": "n8n-nodes-base.httpRequest",
      "position": [
        1872,
        768
      ],
      "parameters": {
        "url": "={{ $json.targetUrl }}",
        "method": "={{ $json.requestMethod }}",
