    {
      "id": "e136e20d-1d58-4272-8ff1-cbd295223493",
      "name": "Collect post links",
      "type": "n8n-nodes-base.code",
      "position": [
        2500,
        230
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Reads both publish results. A post that failed or was rejected marks the listing as failed.\nconst fb = $('Publish to Facebook Page').item.json;\nconst ig = $('Publish to Instagram Reels').item.json;\n\n// The publish step returns { post_id, status, platforms: [{ platform, status, url, error }] },\n// or { error } when the request itself failed. status is published, processing (Instagram\n// finishes a moment later), scheduled, drafted, partial or failed.\nconst first = r => {\n  if (r.error) return { error: r.error.message || r.error };\n  const p = (r.platforms || [])[0] || {};\n  return { status: r.status || p.status, url: p.url, error: p.error };\n};\nconst ok = e => ['published', 'processing', 'scheduled', 'drafted'].includes(String(e.status || '').toLowerCase());\n\nconst f = first(fb), i = first(ig);\nconst errors = [\n  !ok(f) && `Facebook: ${f.error || f.message || 'not published'}`,\n  !ok(i) && `Instagram: ${i.error || i.message || 'not published'}`,\n].filter(Boolean);\n\nreturn {\n  json: {\n    recordId: $('Format listing details').item.json.recordId,\n    agentEmail: $('Format listing details').item.json.agentEmail,\n    address: $('Format listing details').item.json.address,\n    videoUrl: $('Get video link').item.json.video,\n    facebookUrl: f.url || '',\n    instagramUrl: i.url || '',\n    scheduled: [f.status, i.status].includes('scheduled'),\n    failed: errors.length > 0,\n    error: errors.join(' | '),\n  },\n};"
      },
      "typeVersion": 2
    },
