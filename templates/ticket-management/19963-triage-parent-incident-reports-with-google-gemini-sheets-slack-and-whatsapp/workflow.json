      "type": "n8n-nodes-base.stickyNote",
      "position": [
        1120,
        560
      ],
      "parameters": {
        "color": 7,
        "width": 832,
        "height": 304,
        "content": "## Capture and verify report\n\nStarts the parent complaint form, builds the initial ticket fields, looks up the submitted student ID, and branches the workflow based on the lookup result."
      },
      "typeVersion": 1
    },
