    {
      "id": "0022e7d9-63eb-4e41-ab02-fd1725819359",
      "name": "Detect Order Anomalies",
      "type": "n8n-nodes-base.code",
      "position": [
        -1600,
        -1040
      ],
      "parameters": {
        "jsCode": "const items = $input.all();\nconst results = [];\n\nfor (const item of items) {\n  const row = item.json;\n  \n  const actualUnits = Number(row.order_units || 0);\n  const muVolume = Number(row.mu_volume_units || 1);\n  const sigmaVolume = Number(row.sigma_volume_units || 1);\n  \n  const muCadence = Number(row.mu_cadence_days || 30);\n  const sigmaCadence = Number(row.sigma_cadence_days || 5);\n  \n  // 1. Volume Collapse Calculation\n  const volumeRatio = actualUnits / muVolume;\n  const zVolume = (actualUnits - muVolume) / (sigmaVolume === 0 ? 1 : sigmaVolume);\n  const isVolumeAnomaly = volumeRatio <= 0.40 || zVolume <= -2.0;\n  \n  // 2. Cadence Stretch Calculation\n  let daysSinceLast = 0;\n  if (row.last_order_date && row.order_date) {\n    const d1 = new Date(row.last_order_date);\n    const d2 = new Date(row.order_date);\n    daysSinceLast = Math.max(0, Math.floor((d2 - d1) / (1000 * 60 * 60 * 24)));\n  }\n  const zCadence = (daysSinceLast - muCadence) / (sigmaCadence === 0 ? 1 : sigmaCadence);\n  const isCadenceAnomaly = daysSinceLast > (muCadence + (1.8 * sigmaCadence));\n  \n  // 3. Product Mix / Core SKU Differential\n  const baselineCoreSkus = (row.core_skus || '').split(',').map(s => s.trim().toUpperCase()).filter(Boolean);\n  const currentSkus = (row.sku_list || '').split(',').map(s => s.trim().toUpperCase()).filter(Boolean);\n  const missingCoreSkus = baselineCoreSkus.filter(sku => !currentSkus.includes(sku));\n  const isSkuAnomaly = baselineCoreSkus.length > 0 && missingCoreSkus.length > 0;\n  \n  // Deduplication cooldown calculation\n  let daysSinceLastAlert = 999;\n  if (row.last_alert_date) {\n    const alertDate = new Date(row.last_alert_date);\n    const today = new Date(row.order_date || new Date().toISOString().split('T')[0]);\n    daysSinceLastAlert = Math.floor((today - alertDate) / (1000 * 60 * 60 * 24));\n  }\n  \n  const isAnomaly = isVolumeAnomaly || isCadenceAnomaly || isSkuAnomaly;\n  \n  results.push({\n    json: {\n      ...row,\n      stats: {\n        actual_units: actualUnits,\n        baseline_mean_units: muVolume,\n        volume_ratio: Number(volumeRatio.toFixed(2)),\n        volume_z_score: Number(zVolume.toFixed(2)),\n        is_volume_anomaly: isVolumeAnomaly,\n        days_since_last_order: daysSinceLast,\n        baseline_cadence_days: muCadence,\n        cadence_z_score: Number(zCadence.toFixed(2)),\n        is_cadence_anomaly: isCadenceAnomaly,\n        missing_core_skus: missingCoreSkus,\n        is_sku_anomaly: isSkuAnomaly,\n        days_since_last_alert: daysSinceLastAlert,\n        is_overall_anomaly: isAnomaly\n      }\n    }\n  });\n}\n\nreturn results;"
      },
      "typeVersion": 2
    },
