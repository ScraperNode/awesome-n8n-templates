    {
      "id": "360da669-5324-46a2-8f9f-ca772ddecb71",
      "name": "Build Daily Security Digest",
      "type": "n8n-nodes-base.code",
      "position": [
        1136,
        1616
      ],
      "parameters": {
        "jsCode": "const rows=$input.all().map(x=>x.json).filter(x=>x.received_epoch);const real=rows.filter(x=>!x.is_duplicate),dup=rows.filter(x=>x.is_duplicate).length;const counts={critical:0,high:0,medium:0,low:0};for(const r of real)if(counts[r.risk_level]!==undefined)counts[r.risk_level]++;const top=(key)=>{const m={};for(const r of real){const v=r[key];if(v)m[v]=(m[v]||0)+1}return Object.entries(m).sort((a,b)=>b[1]-a[1])[0]||['N/A',0]};const ip=top('src_ip'),host=top('targeted_hosts'),max=real.reduce((m,r)=>Math.max(m,+r.risk_score||0),0);return[{json:{total:rows.length,unique:real.length,suppressed:dup,critical:counts.critical,high:counts.high,medium:counts.medium,low:counts.low,top_ip:ip[0],top_ip_count:ip[1],top_host:host[0],top_host_count:host[1],max_risk:max,generated_at:new Date().toISOString()}}];"
      },
      "typeVersion": 2
    },
