    {
      "id": "a2c52755-9a96-4a63-ac11-f8f21ac955f0",
      "name": "Score email with Jev",
      "type": "@typesafe-ai/n8n-nodes-typesafe-ai.typeSafeAi",
      "notes": "Jev answers 3 typed questions in one call: a score (urgency) and two yes/no probabilities. No text is generated.",
      "maxTries": 3,
      "position": [
        928,
        0
      ],
      "parameters": {
        "model": {
          "__rl": true,
          "mode": "id",
          "value": "={{ $('Configuration').item.json.jev_model }}"
        },
        "options": {},
        "questions": {
          "question": [
            {
              "id": "urgency",
              "type": "score",
              "scoreLevels": {
                "level": [
                  {
                    "level": "Not urgent: informational, can wait a week or be ignored"
                  },
                  {
                    "level": "Normal: should be handled within two business days"
                  },
                  {
                    "level": "Urgent: should be handled today"
                  },
                  {
                    "level": "Critical: a customer is blocked, money is at stake or a deadline is hours away"
                  }
                ]
              },
              "instructions": "How urgent is it for our team to act on this email?"
            },
            {
              "id": "needs_reply",
              "trueMeans": "A real person asks a question, requests something or expects an answer",
              "falseMeans": "Automated, promotional, a newsletter, a notification or no answer expected",
              "instructions": "Does this email need a personal written reply from our team?"
            },
            {
              "id": "upset_customer",
              "trueMeans": "Clear frustration, complaint, anger or churn risk",
              "falseMeans": "Neutral or positive tone",
              "instructions": "Is the sender upset, frustrated or threatening to cancel or leave?"
            }
          ]
        },
        "stateText": "={{ $('Extract email fields').item.json.email_state }}"
      },
      "credentials": {
        "typeSafeAiApi": {
          "id": "ylPmolioj287ii5y",
          "name": "TypeSafe AI account"
        }
      },
      "retryOnFail": true,
      "typeVersion": 1,
      "waitBetweenTries": 5000
    },
    {
      "id": "0be2cd93-8165-4a5d-918c-67d14167af6e",
