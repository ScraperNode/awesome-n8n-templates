          }
        ]
      ]
    },
    "Webhook - Approval Request": {
      "main": [
        [
          {
            "node": "Enrich Request Sub-workflow",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Enrich Request Sub-workflow": {
      "main": [
        [
          {
            "node": "Policy Service Call",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}