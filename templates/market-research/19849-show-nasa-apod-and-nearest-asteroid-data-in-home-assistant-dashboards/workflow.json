          "name": "Home Assistant account"
        }
      },
      "typeVersion": 1
    },
    {
      "id": "679b152d-adcd-40ec-8ae3-49dd88adcc0b",
      "name": "Fetch Asteroid Feed",
      "type": "n8n-nodes-base.httpRequest",
      "maxTries": 3,
      "position": [
        272,
        400
      ],
      "parameters": {
        "url": "https://api.nasa.gov/neo/rest/v1/feed",
        "options": {},
        "sendQuery": true,
        "authentication": "genericCredentialType",
        "genericAuthType": "httpQueryAuth",
        "queryParameters": {
          "parameters": [
            {
              "name": "start_date",
              "value": "={{ $now.toFormat(\"yyyy-MM-dd\") }}"
            },
            {
              "name": "end_date",
              "value": "={{ $now.plus({days: 3}).toFormat(\"yyyy-MM-dd\") }}"
            }
          ]
        }
      },
      "executeOnce": true,
      "retryOnFail": true,
      "typeVersion": 4.4,
      "waitBetweenTries": 5000
    },
    {
      "id": "003316cd-ef3d-4282-9bf7-67a9dae704fe",
      "name": "Set Asteroid Data",
      "type": "n8n-nodes-base.set",
      "position": [
        496,
        400
      ],
      "parameters": {
        "options": {},
        "assignments": {
          "assignments": [
            {
              "id": "asteroid-count",
              "name": "count",
              "type": "number",
              "value": "={{ $json.element_count }}"
            },
            {
              "id": "asteroid-raw",
              "name": "raw_objects",
              "type": "object",
              "value": "={{ $json.near_earth_objects }}"
            }
          ]
        }
      },
      "executeOnce": true,
      "typeVersion": 3.4
    },
    {
      "id": "5193a36e-f15e-446e-be39-de7b45660ef8",
      "name": "Find Nearest Asteroid",
      "type": "n8n-nodes-base.code",
      "position": [
        720,
        400
      ],
      "parameters": {
        "jsCode": "\nconst neoData = $input.first().json.raw_objects;\nconst allAsteroids = [];\n\nfor (const date of Object.keys(neoData)) {\n  for (const asteroid of neoData[date]) {\n    const approach = asteroid.close_approach_data[0];\n    allAsteroids.push({\n      name: asteroid.name.replace(/[()]/g, '').trim(),\n      date: approach.close_approach_date,\n      distance_km: Math.round(parseFloat(approach.miss_distance.kilometers)).toLocaleString(),\n      distance_lunar: parseFloat(approach.miss_distance.lunar).toFixed(1),\n      diameter_m: Math.round((parseFloat(asteroid.estimated_diameter.meters.estimated_diameter_min) + parseFloat(asteroid.estimated_diameter.meters.estimated_diameter_max)) / 2),\n      velocity_kmh: Math.round(parseFloat(approach.relative_velocity.kilometers_per_hour)).toLocaleString(),\n      hazardous: asteroid.is_potentially_hazardous_asteroid,\n      miss_km_raw: parseFloat(approach.miss_distance.kilometers)\n    });\n  }\n}\n\nallAsteroids.sort((a, b) => a.miss_km_raw - b.miss_km_raw);\nconst closest = allAsteroids[0];\n\nreturn [{\n  json: {\n    name: closest.name,\n    date: closest.date,\n    distance_km: closest.distance_km,\n    distance_lunar: closest.distance_lunar,\n    diameter_m: closest.diameter_m,\n    velocity_kmh: closest.velocity_kmh,\n    hazardous: closest.hazardous,\n    total_count: allAsteroids.length\n  }\n}];\n"
      },
      "executeOnce": true,
      "typeVersion": 2
    },
    {
      "id": "181a9128-c209-4adc-9da0-eab5b218ec12",
      "name": "Send Asteroid to Home Assistant",
