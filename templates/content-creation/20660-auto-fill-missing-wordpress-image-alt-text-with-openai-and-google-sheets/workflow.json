    {
      "id": "e5f0c005-0000-4000-8000-000000000004",
      "name": "Skip Processed Media IDs",
      "type": "n8n-nodes-base.code",
      "position": [
        1392,
        304
      ],
      "parameters": {
        "jsCode": "// Skip media IDs that are already in the log sheet\n// (pending review, approved, applied or marked decorative).\nconst logged = new Set(\n  $('Read Processed Log in Sheets').all()\n    .map(item => String(item.json.media_id ?? '').trim())\n    .filter(Boolean)\n);\n\nconst output = [];\n$input.all().forEach((item, index) => {\n  if (!logged.has(String(item.json.id))) {\n    output.push({ json: item.json, pairedItem: { item: index } });\n  }\n});\n\nreturn output;"
      },
      "typeVersion": 2
    },
    {
