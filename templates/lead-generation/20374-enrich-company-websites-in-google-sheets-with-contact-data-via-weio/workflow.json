    {
      "id": "c8f01285-a8af-4f54-af8e-8ea854ff2994",
      "name": "Pick rows due for enrichment",
      "type": "n8n-nodes-base.code",
      "position": [
        940,
        60
      ],
      "parameters": {
        "jsCode": "// Keeps the rows that need a lookup: never enriched, or enriched longer ago than re_enrich_after_days.\n// Every lookup costs one Weio credit, so each website is looked up at most once per run.\nconst s = $('Settings').first().json;\nconst days = Number(s.re_enrich_after_days);\nconst cutoff = Date.now() - (Number.isFinite(days) ? days : 90) * 86400000;\nconst seen = new Set();\nconst due = [];\nfor (const item of $input.all()) {\n  const row = item.json;\n  // the same clean-up the API does: no scheme, path, port or leading www.\n  const domain = String(row.website ?? '').trim().toLowerCase()\n    .replace(/^[a-z][a-z0-9+.-]*:\\/\\//, '')\n    .split(/[\\/?#]/)[0].split(':')[0]\n    .replace(/\\.$/, '').replace(/^www\\./, '');\n  if (!domain || seen.has(domain)) continue;\n  seen.add(domain);\n  const last = Date.parse(String(row.enriched_at ?? '').trim());\n  if (!Number.isNaN(last) && last > cutoff) continue;   // enriched recently: no credit spent\n  due.push({ json: {\n    website: row.website,                          // the exact cell value: the write-back matches on it\n    domain,\n    previous_enriched_at: String(row.enriched_at ?? ''),\n  } });\n}\nreturn due;"
      },
      "typeVersion": 2
    },
    {
      "id": "a4a66a6a-1a41-41b7-bae1-c8a04b8e7374",
      "name": "Cap lookups per run",
      "type": "n8n-nodes-base.limit",
      "position": [
        1160,
