    {
      "id": "f82442f3-b215-57f7-b507-8f2861743767",
      "name": "Summarize video with AI",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "position": [
        1380,
        0
      ],
      "parameters": {
        "text": "=You write short, useful summaries of YouTube videos for a daily digest. You only have the title and the creator's description, not the video itself, so do not invent details that are not supported by them.\n\nChannel: {{ $json.author }}\nTitle: {{ $json.title }}\nDescription:\n{{ ($json['media:group']?.['media:description']?.[0] || 'No description').slice(0, 3000) }}\n\nWrite plain text, no markdown, in this format:\nLine 1: a one-sentence summary of what the video covers.\nLine 2: \"Worth watching if: \" followed by who will get the most from it, in under 15 words.\nIgnore sponsor messages, links, timestamps and social media plugs in the description.",
        "batching": {
          "batchSize": 5,
          "delayBetweenBatches": 15000
        },
        "promptType": "define"
      },
      "typeVersion": 1.9
    },
    {
      "id": "352464ea-44fd-58fe-948c-41d650adb57f",
      "name": "Gemini 3.5 Flash-Lite",
      "type": "@n8n/n8n-nodes-langchain.lmChatGoogleGemini",
      "position": [
        1400,
        240
      ],
      "parameters": {
        "options": {
          "temperature": 0.3
        },
        "modelName": "models/gemini-3.5-flash-lite"
      },
      "credentials": {
        "googlePalmApi": {
          "name": "Google Gemini(PaLM) Api account"
        }
      },
      "typeVersion": 1.2
    },
    {
      "id": "60c10884-8209-56b0-a2b8-ec2433df5834",
      "name": "Section: send",
      "type": "n8n-nodes-base.stickyNote",
      "position": [
        1760,
        -160
      ],
      "parameters": {
        "color": 7,
        "width": 480,
        "height": 400,
        "content": "## 4. Send the digest to Telegram"
      },
      "typeVersion": 1
    },
    {
      "id": "3c4cdc24-f254-5bb7-9559-ae14e0a8b061",
      "name": "Build digest message",
      "type": "n8n-nodes-base.code",
      "position": [
        1820,
        0
      ],
      "parameters": {
        "jsCode": "// Combine every summary into one Telegram digest (HTML), split under Telegram's 4096-char limit\nconst esc = s => String(s ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\nconst chatId = $('Set channels and settings').first().json.telegram_chat_id;\nconst blocks = $input.all().map((item, i) => {\n  const v = $('Skip videos already sent').itemMatching(i).json;\n  return `<b>${esc(v.title)}</b>\\n<i>${esc(v.author)}</i>\\n${esc((item.json.text || '').trim())}\\n${esc(v.link)}`;\n});\nconst header = `<b>\ud83d\udcfa ${blocks.length} new video${blocks.length === 1 ? '' : 's'}</b>\\n\\n`;\nconst messages = [];\nlet current = header;\nfor (const b of blocks) {\n  if ((current + b).length > 3800 && current.length > header.length) { messages.push(current); current = ''; }\n  current += b + '\\n\\n';\n}\nif (current.trim()) messages.push(current);\nreturn messages.map(text => ({ json: { chat_id: chatId, text } }));"
      },
      "typeVersion": 2
    },
    {
      "id": "1d61afe5-38e7-5e80-8041-5af69b76365b",
      "name": "Send digest to Telegram",
      "type": "n8n-nodes-base.telegram",
      "position": [
        2040,
        0
      ],
      "parameters": {
        "text": "={{ $json.text }}",
        "chatId": "={{ $json.chat_id }}",
        "additionalFields": {
          "parse_mode": "HTML",
          "appendAttribution": false,
          "disable_web_page_preview": true
        }
      },
      "credentials": {
        "telegramApi": {
          "name": "Telegram account"
        }
      },
      "typeVersion": 1.2
    }
  ],
