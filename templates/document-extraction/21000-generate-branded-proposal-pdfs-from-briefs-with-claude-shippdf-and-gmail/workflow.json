      "type": "n8n-nodes-base.stickyNote",
      "position": [
        464,
        80
      ],
      "parameters": {
        "color": 7,
        "width": 560,
        "height": 528,
        "content": "## Structure brief with AI\n\nUses the Information Extractor and the nearby Anthropic chat model to convert the submitted brief into structured proposal data."
      },
      "typeVersion": 1
    },
    {
      "id": "02f9e432-c007-4a22-8790-e1ca127a04f8",
      "name": "Section: generate-poll",
      "type": "n8n-nodes-base.stickyNote",
      "position": [
        1040,
        112
      ],
      "parameters": {
        "color": 7,
        "width": 720,
        "height": 420,
        "content": "## Generate and poll for PDF\n\nSends the structured data to ShipPDF, then polls `GET /v1/documents/{id}` every 3s until the PDF is ready. Anything still processing loops back to the wait. No public callback URL needed."
      },
      "typeVersion": 1
    },
    {
      "id": "5017ba67-c47b-4a32-8326-9fcba84502c2",
      "name": "Section: check",
      "type": "n8n-nodes-base.stickyNote",
      "position": [
        1800,
        80
      ],
      "parameters": {
        "color": 7,
        "width": 432,
        "height": 520,
        "content": "## Check generation result\n\nRoutes a completed document to delivery and a failed one to the alert placeholder."
      },
      "typeVersion": 1
    },
    {
      "id": "4212f142-5b7c-43fa-ac63-a8459220324d",
      "name": "Section: deliver",
      "type": "n8n-nodes-base.stickyNote",
      "position": [
        1800,
        -256
      ],
      "parameters": {
        "color": 7,
        "width": 680,
        "height": 304,
        "content": "## Deliver and archive proposal\n\nDownloads the completed PDF, emails it to the recipient, and stores a copy in Google Drive."
      },
      "typeVersion": 1
    },
