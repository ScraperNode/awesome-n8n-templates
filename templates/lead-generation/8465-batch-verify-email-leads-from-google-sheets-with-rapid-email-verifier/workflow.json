      ],
      "parameters": {
        "height": 200,
        "content": "### Step 4:\nThe HTTP Request node sends a POST request of less than 100 emails at once to be verified.\n\nIt returns verification data about the emails sent."
      },
      "typeVersion": 1
    },
    {
      "id": "f1010f90-1810-4095-a6c7-d4f80409570e",
