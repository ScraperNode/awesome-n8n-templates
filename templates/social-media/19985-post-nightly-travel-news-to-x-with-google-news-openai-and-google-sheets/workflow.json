    {
      "id": "bddeac53-bc4c-4700-9b12-8488855490f3",
      "name": "\u6295\u7a3f\u6587\u7d44\u307f\u7acb\u3066(\u591c)",
      "type": "n8n-nodes-base.code",
      "position": [
        1552,
        0
      ],
      "parameters": {
        "jsCode": "const source = $('\u4e0a\u4f4d2\u4ef6\u306b\u7d5e\u308b(\u591c)').item.json;\n\nconst comment =\n  $json.output?.[0]?.content?.[0]?.text ||\n  $json.message?.content ||\n  $json.text ||\n  (typeof $json.output === 'string' ? $json.output : '') ||\n  '';\n\nif (!comment) {\n  throw new Error('OpenAI\u306e\u30b3\u30e1\u30f3\u30c8\u751f\u6210\u7d50\u679c\u304c\u7a7a\u3060\u3063\u305f\u305f\u3081\u3001X\u3078\u306e\u6295\u7a3f\u3092\u4e2d\u6b62\u3057\u307e\u3057\u305f\u3002');\n}\n\nconst BLOG_URL = 'https://tabitechs.com/'; // \u5b9f\u969b\u306e\u30d6\u30ed\u30b0URL\u306b\u7f6e\u304d\u63db\u3048\u3066\u304f\u3060\u3055\u3044\n\nfunction toHashtagWord(s) {\n  return String(s || '')\n    .replace(/[\\s\u3000]/g, '')\n    .replace(/[!-\\/:-@\\[-`{-~]/g, '')\n    .replace(/[\uff01-\uff0f\uff1a-\uff20\uff3b-\uff40\uff5b-\uff5e\u3001\u3002\u300c\u300d\u30fb]/g, '');\n}\n\n// \u5730\u540d\u3092\u62bd\u51fa\u3057\u3066\u52d5\u7684\u30bf\u30b0\u306b\u3059\u308b(\u90fd\u9053\u5e9c\u770c+\u4e3b\u8981\u89b3\u5149\u5730)\nfunction extractAreaTag(title, summary) {\n  const areaList = [\n    '\u5317\u6d77\u9053','\u9752\u68ee','\u5ca9\u624b','\u5bae\u57ce','\u79cb\u7530','\u5c71\u5f62','\u798f\u5cf6',\n    '\u8328\u57ce','\u6803\u6728','\u7fa4\u99ac','\u57fc\u7389','\u5343\u8449','\u6771\u4eac','\u795e\u5948\u5ddd',\n    '\u65b0\u6f5f','\u5bcc\u5c71','\u77f3\u5ddd','\u798f\u4e95','\u5c71\u68a8','\u9577\u91ce','\u5c90\u961c','\u9759\u5ca1','\u611b\u77e5',\n    '\u4e09\u91cd','\u6ecb\u8cc0','\u4eac\u90fd','\u5927\u962a','\u5175\u5eab','\u5948\u826f','\u548c\u6b4c\u5c71',\n    '\u9ce5\u53d6','\u5cf6\u6839','\u5ca1\u5c71','\u5e83\u5cf6','\u5c71\u53e3',\n    '\u5fb3\u5cf6','\u9999\u5ddd','\u611b\u5a9b','\u9ad8\u77e5',\n    '\u798f\u5ca1','\u4f50\u8cc0','\u9577\u5d0e','\u718a\u672c','\u5927\u5206','\u5bae\u5d0e','\u9e7f\u5150\u5cf6','\u6c96\u7e04',\n    '\u672d\u5e4c','\u51fd\u9928','\u4ed9\u53f0','\u6a2a\u6d5c','\u540d\u53e4\u5c4b','\u91d1\u6ca2','\u795e\u6238','\u5e83\u5cf6','\u798f\u5ca1',\n    '\u90a3\u8987','\u6c37\u898b','\u8efd\u4e95\u6ca2','\u7bb1\u6839','\u71b1\u6d77','\u938c\u5009'\n  ];\n  const text = `${title || ''} ${summary || ''}`;\n  const found = areaList.find(a => text.includes(a));\n  return found ? `#${found}\u65c5\u884c` : null;\n}\n\nfunction buildHashtags(title, summary) {\n  const tags = [];\n  const seen = new Set();\n  const push = (t) => {\n    const tag = toHashtagWord(t);\n    if (tag && !seen.has(tag)) {\n      seen.add(tag);\n      tags.push(tag.startsWith('#') ? tag : `#${tag}`);\n    }\n  };\n\n  // \u2460 \u5730\u540d\u30bf\u30b0(\u898b\u3064\u304b\u308c\u3070\u6700\u512a\u5148\u3067\u8ffd\u52a0)\n  const areaTag = extractAreaTag(title, summary);\n  if (areaTag) push(areaTag);\n\n  // \u2461 \u30ab\u30c6\u30b4\u30ea\u30bf\u30b0(1\u3064\u3060\u3051\u3001\u8a72\u5f53\u3059\u308b\u3082\u306e\u306e\u3046\u3061\u6700\u521d\u306b\u30de\u30c3\u30c1\u3057\u305f\u3082\u306e)\n  const text = `${title || ''} ${summary || ''}`;\n  if (/\u304a\u5f97|\u30bb\u30fc\u30eb|\u5272\u5f15|\u30ad\u30e3\u30f3\u30da\u30fc\u30f3/.test(text)) push('\u304a\u5f97\u60c5\u5831');\n  else if (/\u6df7\u96d1|\u904b\u4f11|\u8b66\u5831|\u9045\u5ef6|\u898f\u5236/.test(text)) push('\u65c5\u884c\u901f\u5831');\n  else if (/\u904e\u53bb\u6700\u591a|\u30d6\u30fc\u30e0|\u4eba\u6c17/.test(text)) push('\u65c5\u884c\u30c8\u30ec\u30f3\u30c9');\n  else push('\u65c5\u884c');\n\n  // \u2462 \u6c4e\u7528\u30bf\u30b0\u3067\u67a0\u3092\u57cb\u3081\u308b\n  push('\u56fd\u5185\u65c5\u884c');\n\n  return tags.slice(0, 3).join(' ');\n}\n\nconst hashtags = buildHashtags(source.title, source.summary);\n\nconst blogLines = [\n  '\u2708\ufe0f \u6b21\u306f\u3069\u3053\u884c\u304f?\u65c5\u5148\u9078\u3073\u306e\u30d2\u30f3\u30c8\u306f\u30d6\u30ed\u30b0\u306b\u3082',\n  '\ud83d\udcd6 \u304a\u5f97\u306a\u65c5\u306e\u60c5\u5831\u3001\u30d6\u30ed\u30b0\u3067\u3082\u914d\u4fe1\u4e2d',\n  '\ud83d\uddfa\ufe0f \u4ed6\u306e\u65c5\u5148\u306e\u8a18\u4e8b\u3082\u30d6\u30ed\u30b0\u3067\u30c1\u30a7\u30c3\u30af\u3067\u304d\u307e\u3059',\n  '\u2615 \u65c5\u306e\u6e96\u5099\u4e2d\u306e\u65b9\u306f\u30d6\u30ed\u30b0\u3082\u3069\u3046\u305e'\n];\nconst blogLine = blogLines[Math.floor(Math.random() * blogLines.length)];\n\nconst tweetText =\n  `\u3010\u65c5\u884c\u30cb\u30e5\u30fc\u30b9\u3011\\n` +\n  `${String(comment).trim()}\\n\\n` +\n  `\u8a73\u7d30\u306f\u3053\u3061\u3089\ud83d\udc47\\n` +\n  `${source.link}\\n\\n` +\n  `${blogLine}\ud83d\udc47\\n` +\n  `${BLOG_URL}\\n\\n` +\n  `${hashtags}`;\n\nreturn [{ json: { tweetText, guid: source.guid, title: source.title, link: source.link } }];"
      },
      "typeVersion": 2
    },
